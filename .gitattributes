# Compiled stories: Git tracks a frozen subset of the corpus (the full corpus is published to R2 and
# bound by the publication ledger). Every tracked blob is LF; the directory rule covers new ones too.
web_viewer/public/data/compiled/** text eol=lf linguist-generated=true
web_viewer/public/data/reading/*.json text eol=lf linguist-generated=true

