{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gs-archive.local/schemas/authoritative-story-publications-v1.schema.json",
  "title": "GS Archive authoritative Story Runtime v2 publications",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "role"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^public/data/compiled/(?:episodes/)?[A-Za-z0-9_]+\\.json$"
        },
        "role": {
          "enum": ["aggregate", "episode", "standalone"]
        }
      },
      "additionalProperties": false
    },
    "ownership": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "release_id"],
          "properties": {
            "state": { "const": "ledger-governed" },
            "release_id": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*-\\d{3}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "release_id"],
          "properties": {
            "state": { "const": "pre-ledger" },
            "release_id": { "type": "null" }
          },
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "logical_id",
        "kind",
        "scenario_id",
        "ownership",
        "artifacts",
        "evidence"
      ],
      "properties": {
        "logical_id": {
          "type": "string",
          "pattern": "^story(?:-collection)?:[A-Za-z0-9_]+$"
        },
        "kind": {
          "enum": ["collection", "standalone"]
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "ownership": { "$ref": "#/$defs/ownership" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
