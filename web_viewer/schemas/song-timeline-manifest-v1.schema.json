{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidem.local/schemas/song-timeline-manifest-v1.schema.json",
  "title": "Lightweight song timeline manifest",
  "type": "object",
  "required": ["schemaVersion", "source", "timeUnit", "songCount", "arrangementCount", "unmappedSongs", "songs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["indexSha256", "audioCatalogSha256", "songCatalogSha256"],
      "properties": {
        "indexSha256": { "$ref": "#/$defs/sha256" },
        "audioCatalogSha256": { "$ref": "#/$defs/sha256" },
        "songCatalogSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "timeUnit": { "const": "ms" },
    "songCount": { "type": "integer", "minimum": 0 },
    "arrangementCount": { "type": "integer", "minimum": 0 },
    "unmappedSongs": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+$": {
          "type": "object",
          "required": ["title", "reason"],
          "properties": {
            "title": { "type": "string" },
            "reason": { "const": "no_choreography_entry" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "songs": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "variant", "url", "entrySha256", "lyricCount", "singerCount", "stageKind", "audioResource"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "variant": { "type": "string" },
              "url": { "type": "string", "pattern": "^/data/song_timelines/entries/[a-z0-9_]+\\.json$" },
              "entrySha256": { "$ref": "#/$defs/sha256" },
              "lyricCount": { "type": "integer", "minimum": 0 },
              "singerCount": { "type": "integer", "minimum": 0 },
              "stageKind": { "enum": ["choreography_candidate", "special_single"] },
              "audioResource": { "enum": ["local_present", "not_found"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
