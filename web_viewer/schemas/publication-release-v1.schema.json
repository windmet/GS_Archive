{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gs-archive.local/schemas/publication-release-v1.schema.json",
  "title": "GS Archive Publication Release v1",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "prepared_from_commit",
    "transaction_kind",
    "scope",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "$ref": "#/$defs/releaseId" },
    "created_at": { "type": "string", "format": "date-time" },
    "prepared_from_commit": { "$ref": "#/$defs/gitSha" },
    "transaction_kind": {
      "enum": ["publish", "replace", "rollback", "republish", "backfill", "supersede"]
    },
    "scope": {
      "type": "object",
      "required": ["kind", "ids"],
      "properties": {
        "kind": {
          "enum": ["item", "collection", "matrix", "batch"]
        },
        "ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "releaseId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]+-[0-9]{3}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedArtifact": {
      "type": "object",
      "required": ["path", "url", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^web_viewer/public/(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "logical_id",
        "domain",
        "source",
        "semantic_evidence",
        "transform",
        "published",
        "consumers",
        "comparison",
        "browser_acceptance",
        "previous_state",
        "rollback_evidence"
      ],
      "properties": {
        "logical_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]+$"
        },
        "domain": {
          "enum": ["story", "image", "audio", "movie", "portal", "fixture"]
        },
        "source": {
          "type": "object",
          "required": ["archive_relative_path", "sha256", "objects"],
          "properties": {
            "archive_relative_path": {
              "type": "string",
              "pattern": "^(?:asset|audio|movie)/(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._/-]+$"
            },
            "sha256": { "$ref": "#/$defs/sha256" },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "name", "container_path", "path_id"],
                "properties": {
                  "type": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "container_path": { "type": ["string", "null"] },
                  "path_id": { "type": ["integer", "null"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "semantic_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product", "key", "evidence"],
            "properties": {
              "product": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "transform": {
          "type": "object",
          "required": ["tool", "contract_version"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "contract_version": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "published": {
          "type": "array",
          "items": { "$ref": "#/$defs/publishedArtifact" }
        },
        "consumers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "comparison": {
          "type": "object",
          "required": ["state", "evidence"],
          "properties": {
            "state": { "enum": ["parity-verified", "not-applicable"] },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "browser_acceptance": {
          "type": "object",
          "required": ["state", "tested_url", "tested_at", "evidence"],
          "properties": {
            "state": {
              "enum": ["not-tested", "sample-accepted", "browser-accepted", "not-applicable"]
            },
            "tested_url": { "type": ["string", "null"], "format": "uri" },
            "tested_at": { "type": ["string", "null"], "format": "date-time" },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "previous_state": {
          "type": "object",
          "required": ["release_id", "artifacts"],
          "properties": {
            "release_id": {
              "oneOf": [
                { "$ref": "#/$defs/releaseId" },
                { "type": "null" }
              ]
            },
            "artifacts": {
              "type": "array",
              "items": { "$ref": "#/$defs/publishedArtifact" }
            }
          },
          "additionalProperties": false
        },
        "rollback_evidence": {
          "type": "object",
          "required": [
            "performed",
            "backup_manifest",
            "restored_artifacts",
            "final_republish_verified"
          ],
          "properties": {
            "performed": { "type": "boolean" },
            "backup_manifest": { "type": ["string", "null"] },
            "restored_artifacts": {
              "type": "array",
              "items": { "$ref": "#/$defs/publishedArtifact" }
            },
            "final_republish_verified": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
