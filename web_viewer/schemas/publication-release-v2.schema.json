{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gs-archive.local/schemas/publication-release-v2.schema.json",
  "title": "GS Archive Publication Release v2",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "prepared_from_commit",
    "transaction_kind",
    "scope",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "release_id": { "$ref": "#/$defs/releaseId" },
    "created_at": { "type": "string", "format": "date-time" },
    "prepared_from_commit": { "$ref": "#/$defs/gitSha" },
    "transaction_kind": {
      "enum": ["publish", "replace", "rollback", "republish", "backfill", "supersede"]
    },
    "scope": {
      "type": "object",
      "required": ["kind", "ids"],
      "properties": {
        "kind": { "enum": ["item", "collection", "matrix", "batch"] },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transaction_kind": {
            "enum": ["publish", "replace", "republish", "backfill", "rollback"]
          }
        },
        "required": ["transaction_kind"]
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "published": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transaction_kind": { "const": "rollback" }
        },
        "required": ["transaction_kind"]
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rollback_evidence": {
                  "type": "object",
                  "properties": {
                    "performed": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "releaseId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]+-[0-9]{3}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedArtifact": {
      "type": "object",
      "required": ["path", "url", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^web_viewer/public/(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sourceObject": {
      "type": "object",
      "required": ["type", "name", "container_path", "path_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "container_path": { "type": ["string", "null"] },
        "path_id": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["archive_relative_path", "sha256", "objects"],
      "properties": {
        "archive_relative_path": {
          "type": "string",
          "pattern": "^(?:asset|audio|movie)/(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceObject" }
        }
      },
      "additionalProperties": false
    },
    "semanticEvidence": {
      "type": "object",
      "required": ["product", "key", "evidence"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "acceptedBrowserEnvironment": {
      "type": "object",
      "required": [
        "browser_name",
        "browser_version",
        "operating_system",
        "viewer_mode"
      ],
      "properties": {
        "browser_name": { "type": "string", "minLength": 1 },
        "browser_version": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "viewer_mode": {
          "enum": ["local-dev", "local-preview", "deployed"]
        }
      },
      "additionalProperties": false
    },
    "browserAcceptance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "tested_url",
            "tested_at",
            "tested_commit",
            "environment",
            "evidence"
          ],
          "properties": {
            "state": { "enum": ["not-tested", "not-applicable"] },
            "tested_url": { "type": "null" },
            "tested_at": { "type": "null" },
            "tested_commit": { "type": "null" },
            "environment": { "type": "null" },
            "evidence": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "tested_url",
            "tested_at",
            "tested_commit",
            "environment",
            "evidence"
          ],
          "properties": {
            "state": { "enum": ["sample-accepted", "browser-accepted"] },
            "tested_url": { "type": "string", "format": "uri" },
            "tested_at": { "type": "string", "format": "date-time" },
            "tested_commit": { "$ref": "#/$defs/gitSha" },
            "environment": { "$ref": "#/$defs/acceptedBrowserEnvironment" },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "previousState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "release_id", "artifacts", "evidence"],
          "properties": {
            "kind": { "const": "absent" },
            "release_id": { "type": "null" },
            "artifacts": {
              "type": "array",
              "maxItems": 0
            },
            "evidence": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "release_id", "artifacts", "evidence"],
          "properties": {
            "kind": { "const": "governed-release" },
            "release_id": { "$ref": "#/$defs/releaseId" },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/publishedArtifact" }
            },
            "evidence": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "release_id", "artifacts", "evidence"],
          "properties": {
            "kind": { "const": "unmanaged-existing" },
            "release_id": { "type": "null" },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/publishedArtifact" }
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "backupManifest": {
      "type": "object",
      "required": ["path", "sha256", "format", "version"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^web_viewer/(?!.*(?:^|/)\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "format": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "rollbackEvidence": {
      "type": "object",
      "required": [
        "performed",
        "backup_manifest",
        "restored_artifacts",
        "final_republish_verified"
      ],
      "properties": {
        "performed": { "type": "boolean" },
        "backup_manifest": {
          "oneOf": [
            { "$ref": "#/$defs/backupManifest" },
            { "type": "null" }
          ]
        },
        "restored_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/publishedArtifact" }
        },
        "final_republish_verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "performed": { "const": true }
            },
            "required": ["performed"]
          },
          "then": {
            "properties": {
              "backup_manifest": { "$ref": "#/$defs/backupManifest" },
              "restored_artifacts": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "backup_manifest": { "type": "null" },
              "restored_artifacts": {
                "type": "array",
                "maxItems": 0
              },
              "final_republish_verified": { "const": false }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "logical_id",
        "domain",
        "source",
        "semantic_evidence",
        "transform",
        "published",
        "consumers",
        "comparison",
        "browser_acceptance",
        "previous_state",
        "rollback_evidence"
      ],
      "properties": {
        "logical_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]+$"
        },
        "domain": {
          "enum": ["story", "image", "audio", "movie", "portal", "fixture"]
        },
        "source": { "$ref": "#/$defs/source" },
        "semantic_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semanticEvidence" }
        },
        "transform": {
          "type": "object",
          "required": ["tool", "contract_version"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "contract_version": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "published": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publishedArtifact" }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "comparison": {
          "type": "object",
          "required": ["state", "evidence"],
          "properties": {
            "state": { "enum": ["parity-verified", "not-applicable"] },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "browser_acceptance": { "$ref": "#/$defs/browserAcceptance" },
        "previous_state": { "$ref": "#/$defs/previousState" },
        "rollback_evidence": { "$ref": "#/$defs/rollbackEvidence" }
      },
      "additionalProperties": false
    }
  }
}
