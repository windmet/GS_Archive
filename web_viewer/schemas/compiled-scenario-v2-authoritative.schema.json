{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gs-archive.local/schemas/compiled-scenario-v2-authoritative.schema.json",
  "title": "GS Archive Authoritative Compiled Scenario v2",
  "type": "object",
  "required": [
    "schema_version",
    "compiler_version",
    "runtime_contract",
    "scenario_id",
    "text_catalog_id",
    "text_contract_version",
    "source",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "compiler_version": { "type": "string", "minLength": 1 },
    "runtime_contract": { "const": "story-runtime-v2" },
    "scenario_id": { "$ref": "#/$defs/canonicalToken" },
    "text_catalog_id": { "$ref": "#/$defs/canonicalToken" },
    "text_contract_version": { "const": 1 },
    "source": { "$ref": "#/$defs/sourceEvidence" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resource_manifest": { "type": "object" },
    "episodes": { "type": "array", "items": { "$ref": "#/$defs/episode" } },
    "jump_points": { "type": "array", "items": { "$ref": "#/$defs/jumpPoint" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "canonicalToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceEvidence": {
      "type": "object",
      "required": ["raw_path", "raw_hash"],
      "properties": {
        "raw_path": { "type": "string", "minLength": 1 },
        "raw_hash": { "$ref": "#/$defs/sha256" },
        "masterdata_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "compiled_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "episode": {
      "type": "object",
      "required": ["episode_index", "start_step_id", "end_step_id"],
      "properties": {
        "episode_index": { "type": "integer", "minimum": 0 },
        "source_scenario_id": { "$ref": "#/$defs/canonicalToken" },
        "episode_part": { "type": ["string", "null"] },
        "start_step_id": { "type": "integer", "minimum": 1 },
        "end_step_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "jumpPoint": {
      "type": "object",
      "required": ["jump_id", "target_step_id"],
      "properties": {
        "jump_id": { "type": "string", "minLength": 1 },
        "target_step_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "step_id",
        "type",
        "entry_snapshot",
        "settled_snapshot",
        "snapshot_format",
        "cues",
        "flow",
        "evidence"
      ],
      "properties": {
        "step_id": { "type": "integer", "minimum": 1 },
        "episode_index": { "type": "integer", "minimum": 0 },
        "episode_part": { "type": ["string", "null"] },
        "type": { "type": "string", "minLength": 1 },
        "chara_id": { "type": ["string", "null"] },
        "dialogue": { "$ref": "#/$defs/dialogue" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/choiceOption" } },
        "choice_id": { "type": "string", "minLength": 1 },
        "text_time": { "$ref": "#/$defs/textUnit" },
        "stamp": { "$ref": "#/$defs/stamp" },
        "auto_advance": { "type": "boolean" },
        "duration": { "type": "number", "minimum": 0 },
        "hide_dialogue": { "type": "boolean" },
        "lipSync": { "type": "boolean" },
        "entry_snapshot": { "$ref": "#/$defs/snapshot" },
        "settled_snapshot": { "$ref": "#/$defs/snapshot" },
        "snapshot_format": { "const": "story-snapshot-v2" },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" } },
        "flow": { "$ref": "#/$defs/flow" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "required": ["speaker_identity", "source_text", "text_ref"],
      "properties": {
        "speaker_identity": { "$ref": "#/$defs/speakerIdentity" },
        "speaker_source_text": { "type": "string" },
        "speaker_text_ref": { "$ref": "#/$defs/textRef" },
        "source_text": { "type": "string" },
        "text_ref": { "$ref": "#/$defs/textRef" },
        "voice": { "type": ["string", "null"] },
        "lip": { "type": ["object", "null"] }
      },
      "dependentRequired": {
        "speaker_source_text": ["speaker_text_ref"],
        "speaker_text_ref": ["speaker_source_text"]
      },
      "additionalProperties": false
    },
    "choiceOption": {
      "type": "object",
      "required": ["option_id", "source_text", "text_ref", "target_step_id"],
      "properties": {
        "option_id": { "type": "string", "minLength": 1 },
        "source_text": { "type": "string" },
        "text_ref": { "$ref": "#/$defs/textRef" },
        "detail_source_text": { "type": "string" },
        "detail_text_ref": { "$ref": "#/$defs/textRef" },
        "target_step_id": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "detail_source_text": ["detail_text_ref"],
        "detail_text_ref": ["detail_source_text"]
      },
      "additionalProperties": false
    },
    "textUnit": {
      "type": "object",
      "required": ["source_text", "text_ref"],
      "properties": {
        "source_text": { "type": "string" },
        "text_ref": { "$ref": "#/$defs/textRef" }
      },
      "additionalProperties": false
    },
    "stamp": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "chara_id": { "type": ["string", "null"] },
        "speaker_identity": { "$ref": "#/$defs/speakerIdentity" }
      },
      "additionalProperties": false
    },
    "textSource": {
      "type": "object",
      "required": ["scenario_id", "part_id", "file", "command_index", "field_kind", "field_ordinal"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/canonicalToken" },
        "part_id": { "$ref": "#/$defs/canonicalToken" },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\]+$"
        },
        "command_index": { "type": "integer", "minimum": 0 },
        "field_kind": { "$ref": "#/$defs/fieldKind" },
        "field_ordinal": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "textRef": {
      "type": "object",
      "required": ["unit_id", "source", "source_hash"],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^story-text:v1:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:cmd-[0-9]{6}:[A-Za-z0-9._-]+:[0-9]{3}$"
        },
        "source": { "$ref": "#/$defs/textSource" },
        "source_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "speakerIdentity": {
      "type": "object",
      "required": ["kind", "entity_type", "entity_id", "source_name"],
      "properties": {
        "kind": { "enum": ["idol", "producer", "named", "unknown", "narrator", "none"] },
        "entity_type": { "type": ["string", "null"], "enum": ["idol", "npc", "system", null] },
        "entity_id": { "type": ["string", "null"] },
        "source_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fieldKind": {
      "enum": [
        "dialogue",
        "narration",
        "choice_short",
        "choice_detail",
        "title",
        "synopsis",
        "time_caption",
        "mobile_message",
        "phone_message",
        "scene_icon_label",
        "system_caption"
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "bg": { "type": ["string", "null"] },
        "bg_color": { "type": ["string", "null"] },
        "bg_color_transition": { "type": ["object", "null"] },
        "bg_dof": { "type": ["number", "null"] },
        "bg_dof_transition": { "type": ["object", "null"] },
        "bg_effect": {
          "anyOf": [
            { "type": "object" },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "bg_effects": { "type": "array" },
        "bg_profile": { "type": ["object", "null"] },
        "bg_transition": { "type": ["object", "null"] },
        "bg_view_type": { "type": "string" },
        "bgm": { "type": ["string", "null"] },
        "bgm_stop_fade": { "type": ["number", "null"] },
        "bgm_volume": { "type": "number" },
        "camera_filter": { "type": ["string", "null"] },
        "camera_zoom": { "type": ["object", "null"] },
        "environmental": { "type": ["object", "null"] },
        "environmental_duck_target": { "type": ["number", "null"] },
        "environmental_volume": { "type": ["number", "null"] },
        "image_icon": { "type": ["object", "null"] },
        "phone_mode": { "type": "boolean" },
        "screen_effects": { "type": "array" },
        "screen_fade": { "type": ["object", "null"] },
        "screen_overlay": { "type": ["object", "null"] },
        "screen_slide": { "type": ["object", "null"] },
        "se": { "type": ["object", "null"] },
        "se_events": { "type": "array" },
        "spines": { "type": "array" },
        "talk_mode": { "type": "boolean" },
        "text_disabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cameraPayload": {
      "type": "object",
      "required": ["zoom", "offset_x", "offset_y", "duration"],
      "properties": {
        "zoom": { "type": "number" },
        "offset_x": { "type": "number" },
        "offset_y": { "type": "number" },
        "duration": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "backgroundPayload": {
      "type": "object",
      "required": ["bg", "type", "color"],
      "properties": {
        "bg": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "color": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "sePayload": {
      "type": "object",
      "required": ["cue", "volume"],
      "properties": {
        "cue": { "type": "string", "minLength": 1 },
        "volume": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "directionalWipePayload": {
      "type": "object",
      "required": ["type", "color", "direction"],
      "properties": {
        "type": { "enum": ["in", "out"] },
        "color": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "screenFadePayload": {
      "type": "object",
      "required": ["type", "color", "alpha"],
      "properties": {
        "type": { "enum": ["in", "out"] },
        "color": { "type": "string", "minLength": 1 },
        "alpha": { "type": "number" }
      },
      "additionalProperties": false
    },
    "spineMotionPayload": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "anim_flag": { "type": "string" },
        "blush_flag": { "type": "string" },
        "sweat_flag": { "type": "string" },
        "no_back": { "type": "boolean" },
        "duration": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "spineExpressionPayload": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "anim_flag": { "type": "string" },
        "blush_flag": { "type": "string" },
        "sweat_flag": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "spineStopPayload": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string" },
        "anim_flag": { "type": "string" },
        "blush_flag": { "type": "string" },
        "sweat_flag": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "spineTintPayload": {
      "type": "object",
      "required": ["value", "duration"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "duration": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "required": ["cue_id", "at", "duration", "channel", "action", "payload", "lifecycle", "evidence"],
      "properties": {
        "cue_id": { "type": "string", "minLength": 1 },
        "at": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "channel": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "target": { "type": ["string", "null"] },
        "payload": { "type": "object" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "channel": { "const": "camera" },
            "action": { "const": "camera.transform" },
            "payload": { "$ref": "#/$defs/cameraPayload" }
          }
        },
        {
          "properties": {
            "channel": { "const": "background" },
            "action": { "const": "background.change" },
            "payload": { "$ref": "#/$defs/backgroundPayload" }
          }
        },
        {
          "properties": {
            "channel": { "const": "se" },
            "action": { "const": "se.play" },
            "payload": { "$ref": "#/$defs/sePayload" }
          }
        },
        {
          "properties": {
            "channel": { "const": "screen" },
            "action": { "const": "screen.directional_wipe" },
            "payload": { "$ref": "#/$defs/directionalWipePayload" }
          }
        },
        {
          "properties": {
            "channel": { "const": "screen" },
            "action": { "const": "screen.fade" },
            "payload": { "$ref": "#/$defs/screenFadePayload" }
          }
        },
        {
          "properties": {
            "channel": { "type": "string", "pattern": "^spine:[^:]+:body$" },
            "action": { "const": "spine.body.play" },
            "payload": { "$ref": "#/$defs/spineMotionPayload" }
          }
        },
        {
          "properties": {
            "channel": { "type": "string", "pattern": "^spine:[^:]+:face$" },
            "action": { "const": "spine.face.set" },
            "payload": { "$ref": "#/$defs/spineExpressionPayload" }
          }
        },
        {
          "properties": {
            "channel": { "type": "string", "pattern": "^spine:[^:]+:neck$" },
            "action": { "const": "spine.neck.play" },
            "payload": { "$ref": "#/$defs/spineExpressionPayload" }
          }
        },
        {
          "properties": {
            "channel": { "type": "string", "pattern": "^spine:[^:]+:neck$" },
            "action": { "const": "spine.neck.stop" },
            "payload": { "$ref": "#/$defs/spineStopPayload" }
          }
        },
        {
          "properties": {
            "channel": { "type": "string", "pattern": "^spine:[^:]+:visual:tint$" },
            "action": { "const": "spine.visual.tint" },
            "payload": { "$ref": "#/$defs/spineTintPayload" }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "required": ["persistence", "skippable", "blocks_input", "blocks_auto", "restore_policy"],
      "properties": {
        "persistence": { "enum": ["stateful", "transient", "hold"] },
        "skippable": { "type": "boolean" },
        "blocks_input": { "type": "boolean" },
        "blocks_auto": { "type": "boolean" },
        "restore_policy": { "enum": ["settled", "replay", "suppress", "resume"] }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["advance", "blocks_skip", "choice_id"],
      "properties": {
        "advance": { "enum": ["user", "automatic", "choice", "blocked"] },
        "blocks_skip": { "type": "boolean" },
        "choice_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_file", "source_part_id", "command_start", "command_end", "raw_type", "confidence"],
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "source_part_id": { "$ref": "#/$defs/canonicalToken" },
        "command_index": { "type": "integer", "minimum": 0 },
        "command_start": { "type": "integer", "minimum": 0 },
        "command_end": { "type": "integer", "minimum": 0 },
        "raw_type": { "type": "string", "minLength": 1 },
        "raw_values": { "type": "array" },
        "parser_rule": { "type": "string" },
        "confidence": { "enum": ["exact", "derived", "approximate", "missing"] }
      },
      "additionalProperties": false
    }
  }
}
