[{"key":"metadata:v1:office-voice:text:0408984dd99cd553f1d6ca254a1018f066919fb37e9046a301adbc9234fa89b7","kind":"office-voice","field":"text","source":"いつもお仕事お疲れさまです。\nぼくも頑張ります！","sourceHash":"0408984dd99cd553f1d6ca254a1018f066919fb37e9046a301adbc9234fa89b7","translation":"一直工作辛苦了。\n我也会努力的！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_01_a1003","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:0e4b564b8b49dd7485b73cb94f75e982a70782bc79440a3ff635b273f47030cd","kind":"office-voice","field":"text","source":"明日はこちらになります！","sourceHash":"0e4b564b8b49dd7485b73cb94f75e982a70782bc79440a3ff635b273f47030cd","translation":"明天是这个！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_00_a1001","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:1715d53240ab5acf47ab83befb4c2b9885f559f106ef99c748597d6c3bec1595","kind":"office-voice","field":"text","source":"●●●●プロデューサーさん、\nお仕事頑張ってきてください！","sourceHash":"1715d53240ab5acf47ab83befb4c2b9885f559f106ef99c748597d6c3bec1595","translation":"●●●●プロデューサー，\n工作请加油！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_01_a1002","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:1726d289d5cf256615a7bef077d167b5433518e7c5d092413328b8dc1cd95fa5","kind":"office-voice","field":"text","source":"お疲れさまです！\n今日はメンタルボーナスデーです！","sourceHash":"1726d289d5cf256615a7bef077d167b5433518e7c5d092413328b8dc1cd95fa5","translation":"辛苦了！\n今天是精神加成日！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_02_a1001","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:308350b408147fc85b39963fdddf6f34b7e2f62434c17d1e76aa24f59e0e748a","kind":"office-voice","field":"text","source":"お疲れさまです！\n今日はオールボーナスデーですよ！","sourceHash":"308350b408147fc85b39963fdddf6f34b7e2f62434c17d1e76aa24f59e0e748a","translation":"辛苦了！\n今天是全属性加成日哦！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_02_a1003","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:3597ef589984b7a050dc2c0ed8e26dc01fb819839155c42268d59e3a1994b710","kind":"office-voice","field":"text","source":"お疲れさまです！　今日は\nフィジカルボーナスデーです！","sourceHash":"3597ef589984b7a050dc2c0ed8e26dc01fb819839155c42268d59e3a1994b710","translation":"辛苦了！今天是\n体能加成日！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_02_a1000","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:a4e4588b5b64b4424696057f1e0a781e589ffbc3c74f1d8ead074f44cbeb5f7f","kind":"office-voice","field":"text","source":"何かあればすぐに連絡します。\nお仕事、いってらっしゃい！","sourceHash":"a4e4588b5b64b4424696057f1e0a781e589ffbc3c74f1d8ead074f44cbeb5f7f","translation":"有什么事我会马上联系您。\n工作，路上小心！","status":"draft","batch":"G-card-lines-20261104-005","references":[{"kind":"office-voice","id":"4_1_101_01_a1004","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:b6fbadd850259221cdf91afe4c129611722c0bf4987b78fcdfb19e8603167ac4","kind":"office-voice","field":"text","source":"お仕事のオファーがありました。\nご確認お願いします！","sourceHash":"b6fbadd850259221cdf91afe4c129611722c0bf4987b78fcdfb19e8603167ac4","translation":"有新的工作邀约。\n请您确认！","status":"draft","batch":"G-card-lines-20261104-006","references":[{"kind":"office-voice","id":"4_1_101_01_a1001","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:c4e1e939771a2c12a744a208a45aae90d2603b303ac21213afed96cbe426f374","kind":"office-voice","field":"text","source":"お疲れさまです、\n●●●●プロデューサーさん。\n今日のログインボーナスはこちらです！","sourceHash":"c4e1e939771a2c12a744a208a45aae90d2603b303ac21213afed96cbe426f374","translation":"辛苦了，\n●●●●プロデューサー。\n今天的登录奖励在这里！","status":"draft","batch":"G-card-lines-20261104-006","references":[{"kind":"office-voice","id":"4_1_101_00_a1000","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:db31239a07cc040dcc241539994d746557fd7d109796aa3ba85fac24c1616e75","kind":"office-voice","field":"text","source":"お疲れさまです！\n今日はインテリボーナスデーです！","sourceHash":"db31239a07cc040dcc241539994d746557fd7d109796aa3ba85fac24c1616e75","translation":"辛苦了！\n今天是智慧加成日！","status":"draft","batch":"G-card-lines-20261104-006","references":[{"kind":"office-voice","id":"4_1_101_02_a1002","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"},{"key":"metadata:v1:office-voice:text:ffcbf978300b935b9afdbbb71c8c182da248e5814866548b811239eb33136f19","kind":"office-voice","field":"text","source":"お疲れさまです！\n今日のお仕事はこちらになります。","sourceHash":"ffcbf978300b935b9afdbbb71c8c182da248e5814866548b811239eb33136f19","translation":"辛苦了！\n今天的工作在这里。","status":"draft","batch":"G-card-lines-20261104-006","references":[{"kind":"office-voice","id":"4_1_101_01_a1000","field":"text","speaker":"101ken"}],"notes":[],"translator":"Claude Opus 5.5","decision":"translated"}]
