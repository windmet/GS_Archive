    "5_00_008_23_5_00_008_23": {
      "revision": "sha256:2c23147110c49aab0d22a297fc55b9dced6654a2b00f79238b607ba0cf6faf99",
      "record": {
        "source": "みんなと過ごしたお正月",
        "text": "和大家一起度过的新年",
        "source_hash": "sha256:24604343d5b3c7dc53b906932342cc70b92f6a6363b5c417d6909d24f857da60",
        "unit_id": "story-text:v1:5_00_008_23_5_00_008_23:5_00_008_23:cmd-000000:title:000"
