      "revision": "sha256:67a2515f0b66dd673394cceeefce205b77003b3c87f0caf1b72288596d4eeb20",
      "record": {
        "source": "それぞれのお正月",
        "text": "各自的新年假期",
        "source_hash": "sha256:8fdc7b30c8a37ecc3ac75d0d6a774ec9cb94e0a3744592b2a07e7799a41bf940",
