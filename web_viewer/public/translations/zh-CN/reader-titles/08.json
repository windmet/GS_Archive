      "revision": "sha256:57e7f9f93e821918f5222f139770f0934835b2cbcf7d27eda2bb00e52fddc707",
      "record": {
        "source": "一緒に食べたお雑煮の思い出",
        "text": "一起吃年糕汤的回忆",
        "source_hash": "sha256:91959a8fccc342a7a33fbb01e1744462a949f8e8d5a879ac6464973a3cc89b8e",
