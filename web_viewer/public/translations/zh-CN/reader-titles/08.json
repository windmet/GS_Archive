    "5_00_002_23_5_00_002_23": {
      "revision": "sha256:6a525bf9c2cdf8b5a81d1bb795700ebeadcea7c01729a605d48cf91d1a3e8f6c",
      "record": {
        "source": "3人揃って初詣",
        "text": "三人一同新年参拜",
        "source_hash": "sha256:103bf5f8f6969fba2c7a49163d4733ff158c225c77e5eed1020f27ebfcdb427e",
        "unit_id": "story-text:v1:5_00_002_23_5_00_002_23:5_00_002_23:cmd-000000:title:000"
      }
    },
    "5_00_004_23_5_00_004_23": {
      "revision": "sha256:dbb6b6e382ab53e5c1dc3437b0407655f652a5ff13f3d2b420530b5c3362ca6d",
      "record": {
        "source": "一緒に食べたお雑煮の思い出",
        "text": "一起吃年糕汤的回忆",
        "source_hash": "sha256:91959a8fccc342a7a33fbb01e1744462a949f8e8d5a879ac6464973a3cc89b8e",
        "unit_id": "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000000:title:000"
      }
    },
    "5_00_006_23_5_00_006_23": {
      "revision": "sha256:d34b7c92ce04f3bcbefadc21b58f950048ce4f4734d35620cfae31dd8f7995bc",
      "record": {
        "source": "それぞれのお正月",
        "text": "各自的新年假期",
        "source_hash": "sha256:8fdc7b30c8a37ecc3ac75d0d6a774ec9cb94e0a3744592b2a07e7799a41bf940",
        "unit_id": "story-text:v1:5_00_006_23_5_00_006_23:5_00_006_23:cmd-000000:title:000"
      }
    },
    "5_00_008_23_5_00_008_23": {
      "revision": "sha256:e5250409ce283fe7f63b73c07ddf387f851832874cdc11f35e565796581bdd60",
      "record": {
        "source": "みんなと過ごしたお正月",
        "text": "和大家一起度过的新年",
        "source_hash": "sha256:24604343d5b3c7dc53b906932342cc70b92f6a6363b5c417d6909d24f857da60",
        "unit_id": "story-text:v1:5_00_008_23_5_00_008_23:5_00_008_23:cmd-000000:title:000"
      }
    },
    "5_00_013_23_5_00_013_23": {
      "revision": "sha256:cbb50bd66617fd6ebf12dae77c391763f6c4a05f62b2e2d53eb83d7058bb1ccb",
      "record": {
        "source": "お正月も男道らーめんで",
        "text": "新年也要在男道拉面度过",
        "source_hash": "sha256:18191340b37f86585897ef7c7088e7e9f61edb5c8bebf1bcfe268405a79c0a64",
        "unit_id": "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000000:title:000"
      }
    },
    "5_00_016_23_5_00_016_23": {
      "revision": "sha256:1372c1c8e66f0c9e40089a5a837c478f0b590e5d971230827cdebf5936d292a1",
      "record": {
        "source": "仲間の活躍を見届けて",
        "text": "见证同伴的活跃身影",
        "source_hash": "sha256:e6c991777a4a5a227fb23b66cb5c5ed33aac3c7aac5beebbf92bb3c5abc59325",
        "unit_id": "story-text:v1:5_00_016_23_5_00_016_23:5_00_016_23:cmd-000000:title:000"
      }
    },
    "5_05_001_00_5_05_001_00": {
