      "title": 371
    },
    "5_06_000_22_5_06_000_22": {
      "revision": "sha256:86ba5b7409a814373b03e9f86faad6bd23c961c2c104d6b21a36d5242a7c5e1a",
      "title": 375
    },
    "5_06_005_22_5_06_005_22": {
      "revision": "sha256:979c9b40ffdcf0a0a2decb82fa204256387c1c3e4b9f000349f88ac692458949",
      "record": {
        "source": "心躍る衣装と共に",
        "text": "与令人心动的服装相伴",
        "source_hash": "sha256:cbfa43a354157f743eb295aacb03629add3074b079a0542a9eba3c047a6e2450",
        "unit_id": "story-text:v1:5_06_005_22_5_06_005_22:5_06_005_22:cmd-000000:title:000"
      }
    },
    "5_06_008_22_5_06_008_22": {
      "revision": "sha256:dd478bce243429f787f800cbce7b4d468a2f23115941d7f937ad44884af403e5",
      "record": {
        "source": "みんなで作った曲だから",
        "text": "因为是大家一起写出的歌",
