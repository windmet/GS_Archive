      "revision": "sha256:dc9cdb456b188a7b253a389c94bd11f645ce582b0a070c201921d1013966b7ec",
      "record": {
        "source": "入念なリサーチ",
        "text": "细致的调查",
        "source_hash": "sha256:665c061238dd296de31684642ce4505b15f342fc549b4011d46fff464a51b0fe",
        "unit_id": "metadata:v1:seasonal-title:title:665c061238dd296de31684642ce4505b15f342fc549b4011d46fff464a51b0fe"
      }
    },
    "5_01_015_22_b": {
      "revision": "sha256:f55b1abb359fec49f8ccadf7c4801c6892bcde4e89d5527f15a6e93aab74b87a",
      "record": {
        "source": "最高に幸運な日",
        "text": "最幸运的一天",
        "source_hash": "sha256:557b0613a54bda32322f4c274f4199dd6474e6970be76fcf203790feb71eef31",
        "unit_id": "metadata:v1:seasonal-title:title:557b0613a54bda32322f4c274f4199dd6474e6970be76fcf203790feb71eef31"
      }
    },
    "5_01_025_22_a": {
      "revision": "sha256:559efc530a883a2ad32feef2704f6ce5df85b83871960f035195610514000067",
      "record": {
        "source": "今日もバーニンッ！",
        "text": "今天也燃烧吧！",
        "source_hash": "sha256:aef62c40a2bfd96438495ec05cfdd259377cc2d04a4ac5085409e63b6fc96651",
        "unit_id": "metadata:v1:seasonal-title:title:aef62c40a2bfd96438495ec05cfdd259377cc2d04a4ac5085409e63b6fc96651"
      }
    },
    "5_01_032_22_a": {
      "revision": "sha256:6dd1fa88866effe3033d3694868f36229703b311172799d96304b3367f7ea5bc",
      "record": {
        "source": "いつも以上に",
        "text": "比平时更甚",
        "source_hash": "sha256:eacd93cb5a72e6f1816390068bf4128d5dab6088f6e9dd673529b4b2b897fa64",
        "unit_id": "metadata:v1:seasonal-title:title:eacd93cb5a72e6f1816390068bf4128d5dab6088f6e9dd673529b4b2b897fa64"
      }
    },
    "5_01_043_22_a": {
      "revision": "sha256:6950ccf251fc1938885d3406df4cf94f8980430ddcb21167fd8dc75c06e37a79",
      "record": {
        "source": "チョコに込められている想い",
        "text": "巧克力里蕴含的心意",
        "source_hash": "sha256:92affc35ae1da5c1899bbb68fce12d312c457c88ffa22953eb13908ec4c8bd9f",
        "unit_id": "metadata:v1:seasonal-title:title:92affc35ae1da5c1899bbb68fce12d312c457c88ffa22953eb13908ec4c8bd9f"
      }
    },
    "5_02_009_22_b": {
      "revision": "sha256:8c3d732e23727262a0163484302666335d1b889ff7c44f783abec5bb62cf4327",
      "record": {
        "source": "一番のお返し",
        "text": "最好的回礼",
        "source_hash": "sha256:734151a053a42fbdad5bdcd795113d8a59fc2f96b2ff75332c84d85396cfa6cf",
        "unit_id": "metadata:v1:seasonal-title:title:734151a053a42fbdad5bdcd795113d8a59fc2f96b2ff75332c84d85396cfa6cf"
      }
    },
    "5_02_013_22_a": {
      "revision": "sha256:f3c47869b40824dd2dd3fc01a54ca708624d9334947981bcbf6bedd44ce2f934",
      "record": {
        "source": "ちょっと緊張……",
        "text": "有点紧张……",
        "source_hash": "sha256:11d1a1a9cf7776d7fc76d8cdbf10711b66a2fca21a5ae4539e62db379290d4ac",
        "unit_id": "metadata:v1:seasonal-title:title:11d1a1a9cf7776d7fc76d8cdbf10711b66a2fca21a5ae4539e62db379290d4ac"
      }
    },
    "5_02_026_22_a": {
      "revision": "sha256:e7325ff028dcd5f409dc66b51191857b0228066bdf2f1d73fcf5a28b4894fc86",
      "record": {
        "source": "感謝の気持ちを込めて",
        "text": "倾注感谢的心意",
        "source_hash": "sha256:931a56250d89b658c2036381b51920a7e7dfe65f4f22c4ea64cd38426b30e434",
        "unit_id": "metadata:v1:seasonal-title:title:931a56250d89b658c2036381b51920a7e7dfe65f4f22c4ea64cd38426b30e434"
      }
    },
    "5_02_030_22_b": {
      "revision": "sha256:f432af740b57ba8d3982728ed5559c44740e18a56d0621054f476f2204797d00",
      "record": {
        "source": "一生懸命選んだもの",
        "text": "用心挑选的东西",
        "source_hash": "sha256:22ce292f16619232703a876cd1d87b553dfdcf3b512552a438c6643e1afcd8d8",
        "unit_id": "metadata:v1:seasonal-title:title:22ce292f16619232703a876cd1d87b553dfdcf3b512552a438c6643e1afcd8d8"
      }
    },
    "5_02_039_22_a": {
      "revision": "sha256:7dd6f03e6788841d0cdf4a5dec72dee257cf3b20e79b5dd3d374d8932fe37bd5",
      "record": {
        "source": "師匠のおかげッス！",
        "text": "多亏了师父！",
        "source_hash": "sha256:7667f34e536b13be221c42b40f238acda5a91c0b4ba02f829f12fd74ec4c3984",
        "unit_id": "metadata:v1:seasonal-title:title:7667f34e536b13be221c42b40f238acda5a91c0b4ba02f829f12fd74ec4c3984"
      }
    },
    "5_02_045_22_b": {
      "revision": "sha256:8dbfb2d307dc2553199dfa92655b7e44d10c4104a9b899f14bd98b4c3d6b1697",
      "record": {
        "source": "着飾らない気持ち",
