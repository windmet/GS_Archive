      "record": {
        "source": "勝負の世界に",
        "text": "在胜负的世界里",
        "source_hash": "sha256:8878ee600cbb4ef1fa3790004cc59620284cdb27aa0e24a169a1e8f8fea3af22",
        "unit_id": "metadata:v1:seasonal-title:title:8878ee600cbb4ef1fa3790004cc59620284cdb27aa0e24a169a1e8f8fea3af22"
      }
    },
