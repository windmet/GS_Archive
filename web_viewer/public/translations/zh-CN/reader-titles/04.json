    "5_00_005_23_5_00_005_23": {
      "revision": "sha256:7a2b987fdbeae8e4caefa550bd32924c9170a45d2b893b11dd1359a635c01c84",
      "record": {
        "source": "今年初の必殺技！",
        "text": "今年的首个必杀技！",
        "source_hash": "sha256:838e958b616af6f2fe3c21861e242fb3daf2d57a110e5abdf708c5312815c7dd",
        "unit_id": "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000000:title:000"
      }
    },
    "5_00_007_23_5_00_007_23": {
      "revision": "sha256:f2348becb00c68e527beafc0ef1cc4c3c4f64d244b3de3940fe0ff40dc1f7ea4",
      "record": {
        "source": "挨拶回りはお手の物",
        "text": "拜年问候可是拿手绝活",
        "source_hash": "sha256:f93b925a89a6741431d7a8a5864b571ab61d0c15030bd6986c73b44c69fffa95",
        "unit_id": "story-text:v1:5_00_007_23_5_00_007_23:5_00_007_23:cmd-000000:title:000"
      }
    },
    "5_00_010_23_5_00_010_23": {
      "revision": "sha256:c302002fdec53f5ee56e1d3e14012c930be24b80de149c0c1b8d3b2e46eb68db",
      "record": {
        "source": "お正月スペシャルアフタヌーンティー",
        "text": "新年特别下午茶",
        "source_hash": "sha256:264558b2c07290c70bbc517e4fe78038cb670dfe2848e1760677eb817f17ce06",
        "unit_id": "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000000:title:000"
      }
    },
    "5_00_014_23_5_00_014_23": {
      "revision": "sha256:8f6599251808fac57ddc4b0742d308c7b788a35054f56fd2b9e159281daf29d3",
      "record": {
        "source": "おみくじの結果は",
        "text": "抽签的结果是",
        "source_hash": "sha256:61558dc7eb9035ff3792ef643f86ae1d53c8731328887fcd1848051931aefa91",
        "unit_id": "story-text:v1:5_00_014_23_5_00_014_23:5_00_014_23:cmd-000000:title:000"
      }
    },
    "5_01_000_22_5_01_000_22": {
      "revision": "sha256:e3cac1d89cc23d1d9523f8d22966fa51137a2e8bc064eb2c22250dfe4f5b827f",
      "record": {
        "source": "熱い思いを届けよう！",
        "text": "传递炽热的心意！",
        "source_hash": "sha256:15e4fd1e9366cd6819b30902ea1f4046d1fbb03d95ce904491449d77de8cba2a",
        "unit_id": "metadata:v1:seasonal-title:title:15e4fd1e9366cd6819b30902ea1f4046d1fbb03d95ce904491449d77de8cba2a"
      }
    },
    "5_01_005_23_a": {
      "revision": "sha256:9823e5d5d3cc5d68cca4e71e269beef94d2fdde92789ebccb3a7f4a3524328ea",
      "record": {
        "source": "甘くはない、本音の気持ち",
        "text": "不加糖的真心话",
        "source_hash": "sha256:8a0edd2f467d39abf9a3e15c509d4d591a936b3981593f527011343d4aa9d487",
        "unit_id": "metadata:v1:seasonal-title:title:8a0edd2f467d39abf9a3e15c509d4d591a936b3981593f527011343d4aa9d487"
      }
    },
    "5_01_007_22_b": {
      "revision": "sha256:68964b9fa09f3b5963739ccf564127c4ba37ccfd3f6beb4ab4f93bef4aba34b0",
      "record": {
        "source": "心地のいい音",
        "text": "悦耳的声音",
        "source_hash": "sha256:9986958ad9182c64e2e95a809ed2cb7285f8681a8751e419279a403e5567fcc5",
        "unit_id": "metadata:v1:seasonal-title:title:9986958ad9182c64e2e95a809ed2cb7285f8681a8751e419279a403e5567fcc5"
      }
    },
    "5_01_014_22_b": {
      "revision": "sha256:9c74810c94374abe22a0be88c0d43ceff39ce7a2dae761c9c2927482c1d36e4d",
      "record": {
        "source": "感謝の気持ちは",
        "text": "这份感谢的心意",
        "source_hash": "sha256:62cc0eebdd3b1c00065cf11db862f43e8401e6ac40e086b1f5c040611022964b",
        "unit_id": "metadata:v1:seasonal-title:title:62cc0eebdd3b1c00065cf11db862f43e8401e6ac40e086b1f5c040611022964b"
      }
    },
    "5_01_016_23_a": {
      "revision": "sha256:e2b90b1bdd7941cca72a78d78374537c653390519bb7933eaf190d349f46b1af",
      "record": {
        "source": "タンデムで小休止",
        "text": "双人骑行的小憩",
        "source_hash": "sha256:53cb5d198247a3b6d5d248554ee4c985d09cfc282419522e678bb255c1ebf9aa",
        "unit_id": "metadata:v1:seasonal-title:title:53cb5d198247a3b6d5d248554ee4c985d09cfc282419522e678bb255c1ebf9aa"
      }
    },
    "5_01_024_22_a": {
      "revision": "sha256:1d41ace6342cb2926d27ed339feb9b5d132d324ef76368ad5b8ed0dca1ffb5b4",
      "record": {
        "source": "やる気にさせる天才！",
        "text": "激发干劲的天才！",
        "source_hash": "sha256:21e844129ae690371e58f68e254f95a6751c37d4f549196b8cb58ae841a32e71",
        "unit_id": "metadata:v1:seasonal-title:title:21e844129ae690371e58f68e254f95a6751c37d4f549196b8cb58ae841a32e71"
      }
    },
    "5_01_033_22_a": {
      "revision": "sha256:7d19aea7434613ec79eaeead1d3f6cfdb0791429e6051a982e9bc56b7dde4755",
      "record": {
        "source": "もっとほしい！",
        "text": "还想要更多！",
        "source_hash": "sha256:df6f22819b534b630364a54fc782bcb25ecdf802f319f8760daa9c9067f8d8e9",
        "unit_id": "metadata:v1:seasonal-title:title:df6f22819b534b630364a54fc782bcb25ecdf802f319f8760daa9c9067f8d8e9"
