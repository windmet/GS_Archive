    "1_5_002sht_1_5_002_00_7": {
      "revision": "sha256:67b7d552db7f70a2edc26ede848fa789964190b38d1fa9b35663a45c6f00ea1b",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_002sht_1_5_002_00_7:1_5_002_00_7:cmd-000000:title:000"
      },
      "opening": {
        "source": "昼寝したからすっごく元気！\nこれならレッスン頑張れちゃうかも♪",
        "text": "睡过午觉之后超级有精神！\n这样一来课程说不定能好好加油呢♪",
        "source_hash": "sha256:52cceaf650b50f023dea11db1cdcb2ee531cdc36eb33ee895bfeaceaca20426d",
        "unit_id": "story-text:v1:1_5_002sht_1_5_002_00_7:1_5_002_00_7:cmd-000017:dialogue:000"
      }
    },
    "1_5_003hok_1_5_003_00_6": {
      "revision": "sha256:0a808fe776b14ef1196957220eeb0fd147af6cf73422312b7c0ce2313dca1fc1",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_00_6:1_5_003_00_6:cmd-000000:title:000"
      },
      "opening": {
        "source": "最高のコンディションですよ。\n今日ならどんな仕事でもこなせそうです。",
        "text": "处于绝佳的状态哦。\n要是今天的话，感觉任何工作都能搞定。",
        "source_hash": "sha256:0c8a7f585cba6c15b511647a293c72e76ca1a354f6eeaba00d119f2408489de1",
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_00_6:1_5_003_00_6:cmd-000015:dialogue:000"
      }
    },
    "1_5_003hok_1_5_003_03": {
      "revision": "sha256:2b759d5214531ed7314b2d41ce898c3368e3efc536c6ab86f82f1d42a0383e62",
      "title": 188,
      "opening": {
        "source": "大財閥一家という設定に相応しい\n立派なお屋敷ですね。",
        "text": "真是配得上大财阀世家设定的\n气派豪宅呢。",
        "source_hash": "sha256:ff4bb57f6e49d952e1ff5f0e52d84dbbbcd6f01e81e6ed18dd6437a53af61728",
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000014:dialogue:000"
      }
    },
    "1_5_004ter_1_5_004_04": {
      "revision": "sha256:43e3e7ff86ffa725175aa526c3c7f64bba90cf66dddec0ed06cd3ac64eddaf5e",
      "title": 193,
      "opening": {
        "source": "「君たちなら、なりたいものになれる！」",
        "text": "“你们的话，一定能成为想成为的样子的！”",
        "source_hash": "sha256:3bc8d55b3acccb66853772f81fd5124039254bea3b162b1acc8df31187079e8f",
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000017:dialogue:000"
      }
    },
    "1_5_006tsu_1_5_006_00_2": {
      "revision": "sha256:1edaea32ab46b9ee28e2a1726f27b658d4138a957b8957aadbdf0665de4371c7",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_006tsu_1_5_006_00_2:1_5_006_00_2:cmd-000000:title:000"
      },
      "opening": {
        "source": "いい天気で、まさにロケ日和ですね。\nあ、呼ばれたみたいなので、いってきます！",
        "text": "天气真好，真是适合出外景的好日子呢。\n啊，好像叫我了，我出发啦！",
        "source_hash": "sha256:d79c023d14239cd941e29d24e1dd76a49a770b0296bcdd1e4a775131718d61b5",
        "unit_id": "story-text:v1:1_5_006tsu_1_5_006_00_2:1_5_006_00_2:cmd-000020:dialogue:000"
      }
    },
    "1_5_007kei_1_5_007_02": {
      "revision": "sha256:7d222fddf8ade16f877f9e3a134f50262b0d0ad6ac78ad2a9acdc1293a015211",
      "title": 203,
      "opening": {
        "source": "ミネラルウォーターのCMの撮影だね。",
        "text": "是矿泉水广告的拍摄呢。",
        "source_hash": "sha256:14c42f765b429e0b5a4854a877ba56d61764819c932fa7c79899d872586edcf7",
        "unit_id": "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000016:dialogue:000"
      }
    },
    "1_5_008rei_1_5_008_00_6": {
      "revision": "sha256:9da04f283534264eecdeaaa6c91bec39a93063d95bde59cb8c14321bbfdaf497",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_00_6:1_5_008_00_6:cmd-000000:title:000"
      },
      "opening": {
        "source": "レッスンの前に体をほぐした方がいいだろうか。\n軽く走ってくるとしよう。",
        "text": "课程开始前最好先把身体活动开吗。\n先去稍微跑跑步吧。",
        "source_hash": "sha256:81e41c75006f913cc5c378afe7426928e7ae1715559a790bf049664d5b53e7d7",
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_00_6:1_5_008_00_6:cmd-000017:dialogue:000"
      }
    },
    "1_5_008rei_1_5_008_03": {
      "revision": "sha256:f409816a3de491e06441197beaa157ce2b7e751f34a2fde3b49eb7cbe70469ee",
      "title": 208,
      "opening": {
        "source": "麗さん、何を確認しているんですか？\nああ、今日レポートするメニューですね。",
        "text": "丽先生，您在确认什么呢？\n啊，是今天要做报道的菜单啊。",
        "source_hash": "sha256:d2d15ed14cf0556ae726bd54d006d3f1aaa6c564658ac0161e3991a6a93e93ab",
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000017:dialogue:000"
      }
    },
    "1_5_011min_1_5_011_00_6": {
      "revision": "sha256:1e020189a4185f7c7cec0fc077f1637a58e6a897700163beb41c2d5627c0cde7",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_011min_1_5_011_00_6:1_5_011_00_6:cmd-000000:title:000"
      },
      "opening": {
        "source": "声を出しやすくするために、\nストレッチはきちんとしなきゃね。",
        "text": "为了更容易发声，\n拉伸必须得好好做呢。",
        "source_hash": "sha256:017bfbd43ae1c22106fc536de2e00dd98195cd42e1b974038c886acab3a0bd6f",
        "unit_id": "story-text:v1:1_5_011min_1_5_011_00_6:1_5_011_00_6:cmd-000016:dialogue:000"
      }
    },
    "1_5_011min_1_5_011_03": {
      "revision": "sha256:ad039374b50ec98457d9d4e10db788237b375faed262eb1302e20fb436b0d6ea",
      "title": 220,
      "opening": {
        "source": "「いらっしゃいませ。\n……おや、少し疲れた顔をしていますね」",
        "text": "“欢迎光临。\n……哎呀，脸色看起来有些疲惫呢”",
        "source_hash": "sha256:11f33fb4f6b486549b11a59742b11a96d4856662e88be68995588090cc90d7ff",
        "unit_id": "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000020:dialogue:000"
      }
    },
    "1_5_013kys_1_5_013_00_7": {
      "revision": "sha256:f143ace592fb9517846773ff4fd3982bbda143c02bb1b714ab16f13784d39fa7",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_013kys_1_5_013_00_7:1_5_013_00_7:cmd-000000:title:000"
      },
      "opening": {
        "source": "ケガ予防のためにも体を動かす前も後も、\n柔軟はしっかりやっておかないとな。",
        "text": "为了预防受伤，活动身体前后\n都必须好好做拉伸才行啊。",
        "source_hash": "sha256:c362b509f8c15e7bcd93fb8bb7c5f0b286930413c3e9557528339df3e1133049",
        "unit_id": "story-text:v1:1_5_013kys_1_5_013_00_7:1_5_013_00_7:cmd-000014:dialogue:000"
      }
    },
    "1_5_014hid_1_5_014_00_1": {
      "revision": "sha256:1d7f14c9df5f8e36837ce822369c1a982949ba6e98e982ad75a9ec0aff5acdba",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_00_1:1_5_014_00_1:cmd-000000:title:000"
      },
      "opening": {
        "source": "今日は朝から調子が良いんだ。\nだからサイコーのステージにしてみせるぜ！",
        "text": "今天从早上起状态就很棒。\n所以一定会呈现出最棒的舞台给你看的！",
        "source_hash": "sha256:eeb1ae6ab9bd02c2521bb0a2ce6052fd85f464a766e72569d783350503d81760",
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_00_1:1_5_014_00_1:cmd-000018:dialogue:000"
      }
    },
    "1_5_015ryu_1_5_015_00_2": {
      "revision": "sha256:f8adc49b1b371665939c359eee7f0ef08b0e77619698dabb53c18cd44317379b",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_015ryu_1_5_015_00_2:1_5_015_00_2:cmd-000000:title:000"
      },
      "opening": {
        "source": "さあ、これもアイドルを目指す第一歩だ！\n集中していくぞ！",
        "text": "来吧，这也是迈向偶像目标的第一步！\n集中精神上吧！",
        "source_hash": "sha256:36a7a9d98581196128b42e65535f13ffd2580490fadbd82d75f7dd5e5af078d2",
        "unit_id": "story-text:v1:1_5_015ryu_1_5_015_00_2:1_5_015_00_2:cmd-000016:dialogue:000"
      }
    },
    "1_5_016sei_1_5_016_00_7": {
      "revision": "sha256:b7488c824bd36ed2f91779f1811658d031e5aa1245f247dbf8d2a61332a9f06c",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_016sei_1_5_016_00_7:1_5_016_00_7:cmd-000000:title:000"
      },
      "opening": {
        "source": "太陽の下で体を動かすと気分が良くなるな。\nプロデューサーさんも一緒にどうだ？",
        "text": "在太阳底下活动身体，心情会变好呢。\n制作人也一起来怎么样？",
        "source_hash": "sha256:8a51387918721609aee58347265759a5c74449d4952a204a46674157c17fccbd",
        "unit_id": "story-text:v1:1_5_016sei_1_5_016_00_7:1_5_016_00_7:cmd-000015:dialogue:000"
      }
    },
    "1_5_017kir_1_5_017_00_4": {
      "revision": "sha256:b55d22db5e6a1e0cd1500134e31523e36842098167bfc806402510381d8f15c3",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_017kir_1_5_017_00_4:1_5_017_00_4:cmd-000000:title:000"
      },
      "opening": {
        "source": "きゅぴぴーん！　新作の小噺を思いついたで\nにゃんす。仕事が始まる前に一席どうでにゃんすか？",
        "text": "啾哔哔——！吾辈想到新的小段子\n了喵。工作开始前来上一段如何喵？",
        "source_hash": "sha256:df875d410682010e188b32f1fe74ae306344eb64b8ebc8925cbda16e74810d7d",
        "unit_id": "story-text:v1:1_5_017kir_1_5_017_00_4:1_5_017_00_4:cmd-000021:dialogue:000"
      }
    },
    "1_5_018shm_1_5_018_00_2": {
      "revision": "sha256:547d7bc2533308f560e16cfd879361273c2cb69e249d962e7cf78f711184283d",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_00_2:1_5_018_00_2:cmd-000000:title:000"
      },
      "opening": {
        "source": "●●●●プロデューサーちゃん、お疲れさま。\n次の仕事も頑張っていきましょ。",
        "text": "●●●●プロデューサー酱，辛苦啦。\n接下来的工作也一起加油吧。",
        "source_hash": "sha256:16f197b71e754c7c29c3220d23f5244bdbf3045a5520d7103af1ca39970bfe96",
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_00_2:1_5_018_00_2:cmd-000017:dialogue:000"
      }
    },
    "1_5_020hay_1_5_020_00_4": {
      "revision": "sha256:a45cb82d9b2cedf56c46083e3dba53cc5655692170522a2b29fdcb40c11c25db",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_020hay_1_5_020_00_4:1_5_020_00_4:cmd-000000:title:000"
      },
      "opening": {
        "source": "……あ、カッコイイフレーズが浮かんだ！\n収録までまだ時間あるし……書き留めておこう。",
        "text": "……啊，脑海里浮现出超帅的乐句了！\n离录制还有时间……先记下来吧。",
        "source_hash": "sha256:9e436a1c8214a6c8d3a530cda81f761663f79a9b5f80865718ac2da4b3dc4713",
        "unit_id": "story-text:v1:1_5_020hay_1_5_020_00_4:1_5_020_00_4:cmd-000020:dialogue:000"
      }
    },
    "1_5_022nat_1_5_022_00_1": {
      "revision": "sha256:7ffe86b86868d0fffa61564f4b91fab1ff21c2401daf6662cf6ead3cbefd932e",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_022nat_1_5_022_00_1:1_5_022_00_1:cmd-000000:title:000"
      },
      "opening": {
        "source": "仕事が終わったら……ジュンと一緒に、\n音楽ショップに行くんだ……ふふ、楽しみ……。",
        "text": "等工作结束了……要和旬一起\n去音像店……呵呵，好期待……",
        "source_hash": "sha256:adcb8116a83f7399e66f9e2b9447c44b8636bcf22517a3a5249f8c4f7df1709c",
        "unit_id": "story-text:v1:1_5_022nat_1_5_022_00_1:1_5_022_00_1:cmd-000018:dialogue:000"
      }
    },
    "1_5_024shk_1_5_024_00_6": {
      "revision": "sha256:b1fd65b2c7f899ca456250cdf095239d38b1f5b586423b5ff21b38df50e79dd7",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_024shk_1_5_024_00_6:1_5_024_00_6:cmd-000000:title:000"
      },
      "opening": {
        "source": "はひ……つ、疲れた……。\nもう限界っす……み、水がほしいっす……。",
        "text": "哈嘿……好、好累……\n已经到极限了……好、好想喝水……",
        "source_hash": "sha256:8942cfe4314d0d84f6127b5dc08ee7ca7cb72a694700d4587a78d4cf023086fa",
        "unit_id": "story-text:v1:1_5_024shk_1_5_024_00_6:1_5_024_00_6:cmd-000017:dialogue:000"
      }
    },
    "1_5_024shk_1_5_024_03": {
      "revision": "sha256:bada6b0f31b8c1173e6c086ea2f9636a23a9abf6e7bde78ec62b05794eddb8a4",
      "title": 272,
      "opening": {
        "source": "今日はカラオケバトル番組の収録っすね。\nハイパー燃えるっす！",
        "text": "今天是卡拉OK对决节目的收录呢。\nHyper燃起来啦！",
        "source_hash": "sha256:ebe68993ed8cb4ea181483f6071934494f7468c6d5318cf8dea752e5924887d0",
        "unit_id": "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000017:dialogue:000"
      }
    },
    "1_5_026gen_1_5_026_00_8": {
      "revision": "sha256:be17628aea71a153e87c0b02c17a946fba9a126ebb15c78e94eaa257dbd3b166",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_00_8:1_5_026_00_8:cmd-000000:title:000"
      },
      "opening": {
        "source": "今日は調子がいいが……。\nこういう時こそ、気を抜いちゃいけねぇ。",
        "text": "今天状态虽然不错……\n不过正是在这种时候，才绝不能大意。",
        "source_hash": "sha256:98968c4ad0127beba2e884005571433985b979c8bdee778b1a1156dd4763fe9a",
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_00_8:1_5_026_00_8:cmd-000015:dialogue:000"
      }
    },
    "1_5_026gen_1_5_026_01": {
      "revision": "sha256:437357d5909015acceec4cff99e848c4796f7f573c1996e0e8a36efa9916f09c",
      "title": 278,
      "opening": {
        "source": "玄武さん、リハーサルお疲れさまでした！\n監督もイメージ通りだとおっしゃっていましたよ。",
        "text": "玄武先生，彩排辛苦了！\n导演也说完全符合预期呢。",
        "source_hash": "sha256:f0fb065b85d36bffb5616c666a97cdd874ea8f4dad379189333d1358de46d5fc",
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000014:dialogue:000"
      }
    },
    "1_5_029ass_1_5_029_04": {
      "revision": "sha256:22a223b84493285e825b9e76619ba57691ec301e9e3e65be7ce724272c767a9c",
      "title": 293,
      "opening": {
        "source": "うむ……この口当たりは、\n彼の供物で間違いないだろう……。",
        "text": "嗯……这口感，\n绝对是他奉上的供品没错……",
        "source_hash": "sha256:3163f64700ae1af4f6dba35076120c2c7748243838f3067f6fbb54f8a1a576b4",
        "unit_id": "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000018:dialogue:000"
      }
    },
    "1_5_030mak_1_5_030_02": {
      "revision": "sha256:423c3d36f60149050d7e42d74d9799c7d1f661ab2f53b18b610ec7fac016d3d8",
      "title": 295,
      "opening": {
        "source": "今日は待ちに待ったお仕事、\n雑誌のカフェ特集のリポーターです！",
        "text": "今天是期盼已久的工作，\n担任杂志咖啡馆特辑的记者！",
        "source_hash": "sha256:2990be1d619a18f3890a695d42b3d65a58c21b26b58e7f1d4efb262a682ff25e",
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000016:dialogue:000"
      }
    },
    "1_5_031sak_1_5_031_02": {
      "revision": "sha256:af0cd2f4102c160258925f785d0de75d486e80282fd50b3b1bc7708a072a4214",
      "title": 299,
      "opening": {
        "source": "わあ！　この学校で映画の撮影をするんだね。\n台本もバッチリ覚えてきたよ！",
        "text": "哇！要在这所学校拍电影啊。\n台词我也记得滚瓜烂熟了哦！",
        "source_hash": "sha256:da065d2fcdac989d0117bcdf196c0ec9a92be57dd8df79008733af96e8ca44f5",
        "unit_id": "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000019:dialogue:000"
      }
    },
    "1_5_032nao_1_5_032_00_6": {
      "revision": "sha256:e10345958f7b74d8f028cc203a922ad0355f769100a6cbaacc7565c85afa8c45",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_032nao_1_5_032_00_6:1_5_032_00_6:cmd-000000:title:000"
      },
      "opening": {
        "source": "今日のお仕事、すごく勉強になりました！\n次のお仕事に活かしたいです。",
        "text": "今天的工作，让我学到了好多东西！\n希望能在下次工作中派上用场。",
        "source_hash": "sha256:d52cd80dc37d138a8f07b370147de7ef41b4c1520a6ba4ac0524d09f9273d035",
        "unit_id": "story-text:v1:1_5_032nao_1_5_032_00_6:1_5_032_00_6:cmd-000015:dialogue:000"
      }
    },
    "1_5_032nao_1_5_032_03": {
      "revision": "sha256:6df15f765f0e44b5d6a9ad6d9aec14d2cab4da98603753b23d3378fa78786382",
      "title": 304,
      "opening": {
        "source": "ふふ、どんな作品が見られるんだろう……♪",
        "text": "呵呵，能看到什么样的作品呢……♪",
        "source_hash": "sha256:85b2e2b19c2479983de6017d353292f1667b7a9a5d8ef3d0f072016d0c5b319d",
        "unit_id": "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000016:dialogue:000"
      }
    },
    "1_5_033shr_1_5_033_00_1": {
      "revision": "sha256:969eda01842bd29640533abc5668848875a3d3717418547e8b265fb36f235079",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_033shr_1_5_033_00_1:1_5_033_00_1:cmd-000000:title:000"
      },
      "opening": {
        "source": "うう、腹減った。\nなー、仕事前になんか食いに行こーぜ。",
        "text": "呜呜，肚子饿了。\n我说——，工作前去吃点东西吧——！",
        "source_hash": "sha256:08d059f14d408e5275623d1998a5dea16b8c08e53d66460b128ec82ebbe0c73a",
        "unit_id": "story-text:v1:1_5_033shr_1_5_033_00_1:1_5_033_00_1:cmd-000016:dialogue:000"
      }
    },
    "1_5_036rui_1_5_036_00_0": {
      "revision": "sha256:4a8770aaca76615fbc4030bcc0082ac83f143e5ab774eb01a95e1e2c9de6d548",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_036rui_1_5_036_00_0:1_5_036_00_0:cmd-000000:title:000"
      },
      "opening": {
        "source": "●●●●プロデューサーちゃん、\n今日も一日let's enjoyだよ！",
        "text": "●●●●プロデューサー酱，\n今天一整天也let's enjoy吧！",
        "source_hash": "sha256:ec6af9bccf32e6831f804366bc1663264e250aa73af7082781280d2191474bde",
        "unit_id": "story-text:v1:1_5_036rui_1_5_036_00_0:1_5_036_00_0:cmd-000015:dialogue:000"
      }
    },
    "1_5_037jir_1_5_037_00_7": {
      "revision": "sha256:9dc8971a08951e1521321bdf210c4cf6b6f3b9c7447a17b5f450b28f7054463d",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_037jir_1_5_037_00_7:1_5_037_00_7:cmd-000000:title:000"
      },
      "opening": {
        "source": "お、差し入れくれるの？　気が利くね、\n●●●●プロデューサーちゃん。",
        "text": "哦，带慰劳品来了吗？真体贴呢，\n●●●●プロデューサー酱。",
        "source_hash": "sha256:78478aa96ce93714e8fa2a617ae895fd1feca8aeb1a1aa0722394accf4dd6f13",
        "unit_id": "story-text:v1:1_5_037jir_1_5_037_00_7:1_5_037_00_7:cmd-000016:dialogue:000"
      }
    },
    "1_5_038tak_1_5_038_00_4": {
      "revision": "sha256:b63189ac86b5c43534310c515417118fd64270b391a64b363efb6674ed67471e",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_038tak_1_5_038_00_4:1_5_038_00_4:cmd-000000:title:000"
      },
      "opening": {
        "source": "毎回、全力を出すだけだ。\nそれはアイドルになっても変わらない。",
        "text": "每次都只要全力以赴就行了。\n即使成为了偶像，这点也不会变。",
        "source_hash": "sha256:fcba3ff3c77fe526fc062235dbb35a2d4781f2ee216463b0dd40c33e18df9b99",
        "unit_id": "story-text:v1:1_5_038tak_1_5_038_00_4:1_5_038_00_4:cmd-000014:dialogue:000"
      }
    },
    "1_5_039mcr_1_5_039_00_0": {
      "revision": "sha256:f937ce67fb1a26ade4bff9257ce51697f50a19b2f5c01af887b181d50e5b90d4",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_039mcr_1_5_039_00_0:1_5_039_00_0:cmd-000000:title:000"
      },
      "opening": {
        "source": "それじゃ、●●●●●●●●●●師匠。\n今日も張り切って仕事に行ってくるッス！",
        "text": "那么，●●●●●●●●●●师父。\n今天我也干劲满满地去工作了！",
        "source_hash": "sha256:9596a8ec2fcd368747e96cc10f2041c076b6ad9d751d19da3e98026c755ee513",
        "unit_id": "story-text:v1:1_5_039mcr_1_5_039_00_0:1_5_039_00_0:cmd-000015:dialogue:000"
      }
    },
    "1_5_040ren_1_5_040_00_3": {
      "revision": "sha256:4b9cdb7ad4a59318f8cf6c6c99eb6a446db60a456a70032f74279ab09cf49a27",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_00_3:1_5_040_00_3:cmd-000000:title:000"
      },
      "opening": {
        "source": "くはは！　見たか！\n最強大天才のオレ様に不可能はねーんだよ！",
        "text": "库哈哈！看到了吧！\n最强大天才本大爷手下就没有不可能的事！",
        "source_hash": "sha256:979823580b15d78f0c2e1ef68a18417078e5279bda934e346468d028c0affd92",
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_00_3:1_5_040_00_3:cmd-000016:dialogue:000"
      }
    },
    "1_5_041ryo_1_5_041_00_6": {
      "revision": "sha256:63554fad0da524fb4bb50716f753e3278c262f0740b28ee29e2ff06ba4089d98",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_00_6:1_5_041_00_6:cmd-000000:title:000"
      },
      "opening": {
        "source": "もっと鍛えて、男らしく筋肉をつけたいんです。\nそのためにも、トレーニングはかかせません。",
        "text": "我想再锻炼锻炼，练出男子汉气概的肌肉。\n为此训练也是必不可少的。",
        "source_hash": "sha256:bcd9b520dbd57d0e3d81e0523b0076c10435b20e5153e37acf8eeca011d63325",
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_00_6:1_5_041_00_6:cmd-000016:dialogue:000"
      }
    },
    "1_5_041ryo_1_5_041_03": {
      "revision": "sha256:503e5c9fa499811ebf3d13aab7037d8d5cd16d0035edaa8293dc9a01f84b0e6d",
      "title": 340,
      "opening": {
        "source": "今日のCM撮影に備えて、いただいたサンプルで\nお菓子を作ってみたんです！",
        "text": "为了今天的广告拍摄，我用拿到的样品\n试着做了一下点心！",
        "source_hash": "sha256:d40a237ebe305e3c144344ba754416edc85068fcf5beb04570fcb93e5669ca8d",
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_03:1_5_041_03:cmd-000016:dialogue:000"
      }
    },
    "1_5_043kaz_1_5_043_00_2": {
      "revision": "sha256:c3c4c5dbc38dbedf267b9447df32a3dae7de70ba42d922054f8898f933c44fa3",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_043kaz_1_5_043_00_2:1_5_043_00_2:cmd-000000:title:000"
      },
      "opening": {
        "source": "…アイドルとして仕事が出来ることに幸せを\n感じている。それは紛れもない事実だ。",
        "text": "…能够作为偶像工作，我感到了\n幸福。这是确凿无疑的事实。",
        "source_hash": "sha256:cd3285bd2f76e4a49814cdf28af54b5182bd467bdca4c519e527b06dec84a92f",
        "unit_id": "story-text:v1:1_5_043kaz_1_5_043_00_2:1_5_043_00_2:cmd-000017:dialogue:000"
      }
    },
    "1_5_045sor_1_5_045_00_8": {
      "revision": "sha256:4fdb7594dc98e83740ce60c9175517e8b02b2e726d9910fdfc1a003eb91ab6c7",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_00_8:1_5_045_00_8:cmd-000000:title:000"
      },
      "opening": {
        "source": "疲れた時は甘いものが食べたくなるよねー。\n不思議だなー。",
        "text": "累了的时候就会想吃甜食呢～\n真不可思议啊～",
        "source_hash": "sha256:5d14d586d8fcf91ad351b9f5d1d4522d388a9e8249996a027ad30af9e607ce93",
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_00_8:1_5_045_00_8:cmd-000016:dialogue:000"
      }
    },
    "1_5_045sor_1_5_045_01": {
      "revision": "sha256:3f08608a1cb5fafcc9eeaece22cda0181e35f7d6f8eced5790854ec8a112dc8e",
      "title": 354,
      "opening": {
        "source": "想楽さん、文具メーカーのCMのお仕事が\n決まりました！",
        "text": "想乐先生，文具厂商广告的工作\n定下来了！",
        "source_hash": "sha256:828c5e322e671ccbb8ea8a213deddcd1ee9c4cd1e78ba619fad48ecd97d5fc34",
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000015:dialogue:000"
      }
    },
    "1_5_046chr_1_5_046_00_1": {
      "revision": "sha256:fd33a8932fa45af90beb79977efc2415fe80cdc49361270acbf510c0511775b9",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_00_1:1_5_046_00_1:cmd-000000:title:000"
      },
      "opening": {
        "source": "アイドルと海……。\n未知なるところが似ていると思いませんか？",
        "text": "偶像与大海……\n不觉得两者的未知之处非常相似吗？",
        "source_hash": "sha256:c62a1fe0465e2f41e46895ea282bee60048d45a652f05aa41da6e9086238a9e6",
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_00_1:1_5_046_00_1:cmd-000016:dialogue:000"
      }
    },
    "1_5_047shu_1_5_047_00_2": {
      "revision": "sha256:2c46c7d05ac169fa8abaae25cc0621fcacbf44028c84021060cfd61bc04b65e4",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_00_2:1_5_047_00_2:cmd-000000:title:000"
      },
      "opening": {
        "source": "これくらい成功して当たり前。\n次はもっと凄いの見せるから、楽しみにしてて。",
        "text": "这种程度成功不是理所当然的嘛。\n下次会让你见识更厉害的，好好期待吧。",
        "source_hash": "sha256:ecd6fdae91664cc1796cebacb2d722654c7c55040beee4bde12850b82fed76bb",
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_00_2:1_5_047_00_2:cmd-000017:dialogue:000"
      }
    },
    "1_5_048mom_1_5_048_00_5": {
      "revision": "sha256:d3136a771c26bc8ab2c4dd39aa373c94e13cda0b34fa2e52fa1bba623afe2fdd",
      "record": {
        "source": "お仕事開始",
        "text": "工作开始",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_048mom_1_5_048_00_5:1_5_048_00_5:cmd-000000:title:000"
      },
      "opening": {
        "source": "ねえねえ、●●●●●●●●●●ぴぃちゃん。\n次はどんな仕事をすればいいの？",
        "text": "呐呐，●●●●●●●●●●P酱。\n接下来我去做什么样的工作比较好呢？",
        "source_hash": "sha256:6d3f26905b707c11a398d786953ca691c79e7306acf50b76f648069b2580153b",
        "unit_id": "story-text:v1:1_5_048mom_1_5_048_00_5:1_5_048_00_5:cmd-000015:dialogue:000"
      }
    },
    "1_5_049eis_1_5_049_00_7": {
      "revision": "sha256:4ea9faac9c3d7b8cf359b0c1bb9b5f4862160bd241c5e68cc21398f5e0a5168d",
      "record": {
        "source": "お仕事開始",
        "text": "开始工作",
        "source_hash": "sha256:c9578f41f04512f8dd518c9243e386d3dec69c30c8930a99faa1eaef07ea0ceb",
        "unit_id": "story-text:v1:1_5_049eis_1_5_049_00_7:1_5_049_00_7:cmd-000000:title:000"
      },
      "opening": {
        "source": "今日はボーカルレッスンだ。\nさっそく始めるぞ。",
        "text": "今天是声乐课。\n立刻开始吧。",
        "source_hash": "sha256:53df1e95a73fda95768345dbee790f4a564ebb27541da0c017504e844f859890",
        "unit_id": "story-text:v1:1_5_049eis_1_5_049_00_7:1_5_049_00_7:cmd-000014:dialogue:000"
      }
    },
    "5_01_013_22_a": {
      "revision": "sha256:8641b3288e5ef2a9b1e95e97cec50ad8cffd340ebdf1aec6f4be3138434086d7",
      "record": {
        "source": "やる気出た！",
        "text": "干劲来了！",
        "source_hash": "sha256:a2bf0f2e4b51c164d5fed1fc887ecbd904b011875585f9f34daf1660d1e616db",
        "unit_id": "metadata:v1:seasonal-title:title:a2bf0f2e4b51c164d5fed1fc887ecbd904b011875585f9f34daf1660d1e616db"
      }
    },
    "5_01_025_23_a": {
      "revision": "sha256:2f8d02bdd654c427684ad4b03fdd57e33d4f1ab46b793b239d1efa93c7e9711d",
      "record": {
        "source": "燃えて燃えて燃えまくる！\r",
        "text": "燃烧、燃烧、尽情燃烧！",
        "source_hash": "sha256:bf0d5df0de23561261c2d5388e967a1a4a865a934f06f724a040579ec89c8a6a",
        "unit_id": "metadata:v1:seasonal-title:title:bf0d5df0de23561261c2d5388e967a1a4a865a934f06f724a040579ec89c8a6a"
      }
    },
    "5_01_027_22_b": {
      "revision": "sha256:46a9835e4bce24bef03e677b4b24528f7f8c45471c218fcfa5eeb5d299d06915",
      "record": {
        "source": "素敵な一杯とともに",
        "text": "与美好的一杯相伴",
        "source_hash": "sha256:4ed59e3ad49b6ccec7e5fef0a9f13810b94182adfa5623ef4e499b62c1d91f83",
        "unit_id": "metadata:v1:seasonal-title:title:4ed59e3ad49b6ccec7e5fef0a9f13810b94182adfa5623ef4e499b62c1d91f83"
      }
    },
    "5_01_030_22_b": {
      "revision": "sha256:c1c8993cef82a75a8077fadb3e3963b6d2f2de580e2632dcbeefd1a6a49d4f04",
      "record": {
        "source": "甘い香り",
        "text": "甜蜜的香气",
        "source_hash": "sha256:7a5630122fb269115c3bd5329558e45b80bbf558530cdfa75cb1423e8756a5ec",
        "unit_id": "metadata:v1:seasonal-title:title:7a5630122fb269115c3bd5329558e45b80bbf558530cdfa75cb1423e8756a5ec"
      }
    },
    "5_01_032_23_a": {
      "revision": "sha256:94a36b85deff604abae9071c388a6a4dac6325edfcc06766c2e686e6a27b0290",
      "record": {
        "source": "大切な人たちへ\r",
        "text": "献给重要的人们",
        "source_hash": "sha256:bc516803a0e47392807011a71ad21e3bdf54886e49fb152c4aa1ffcb207096c0",
        "unit_id": "metadata:v1:seasonal-title:title:bc516803a0e47392807011a71ad21e3bdf54886e49fb152c4aa1ffcb207096c0"
      }
    },
    "5_01_041_22_b": {
      "revision": "sha256:383d15564edef749f911a80536a44a2c4678dec0d2ab0a75f52445191fcba9f2",
      "record": {
        "source": "今年のバレンタインは！",
        "text": "今年的情人节！",
        "source_hash": "sha256:0fd8fcd93b823eb0302b54f835e111f86d867c3fbc0be7b4d20ef3606b2924c0",
        "unit_id": "metadata:v1:seasonal-title:title:0fd8fcd93b823eb0302b54f835e111f86d867c3fbc0be7b4d20ef3606b2924c0"
      }
    },
    "5_01_043_23_a": {
      "revision": "sha256:8c11a8a3c00a472f963929f02f3afd0ba9637331150fdd20281bfdb549e0ea49",
      "record": {
        "source": "花に込められた想い",
        "text": "寄托于花中的心意",
        "source_hash": "sha256:0f952a06ea6eea88727df58044104abcfacef0186599588e5b300402fce31159",
        "unit_id": "metadata:v1:seasonal-title:title:0f952a06ea6eea88727df58044104abcfacef0186599588e5b300402fce31159"
      }
    },
    "5_02_002_22_b": {
      "revision": "sha256:4a0476969a49b848db09a6f9051d8f8cc2c0d50ff8f44f5f7d70b6a1be266e13",
      "record": {
        "source": "お返しはもちろん……",
        "text": "回礼当然是……",
        "source_hash": "sha256:9c8ab4f7897008798c2229a0e55859f52d6ad0a9806d6005f5321b7ffb1037f9",
        "unit_id": "metadata:v1:seasonal-title:title:9c8ab4f7897008798c2229a0e55859f52d6ad0a9806d6005f5321b7ffb1037f9"
      }
    },
    "5_02_011_22_b": {
      "revision": "sha256:f4f2b94f9c493921e36fbcfb2515b2abd59100fb139f9af5b31ae28190c49b9a",
      "record": {
        "source": "君の笑顔",
        "text": "你的笑容",
        "source_hash": "sha256:92c0e39653ddf967ed4f846e1ac0e4062328d1d7e1798baba743999e00059e24",
        "unit_id": "metadata:v1:seasonal-title:title:92c0e39653ddf967ed4f846e1ac0e4062328d1d7e1798baba743999e00059e24"
      }
    },
    "5_02_024_22_b": {
      "revision": "sha256:a9bc2bba0d8ca759dd894a9ace350d985ce2c7817b922ed0c7e0fa54a645d867",
      "record": {
        "source": "これしかないっしょ☆",
        "text": "非它莫属嘛☆",
        "source_hash": "sha256:2c3249a7ec2eed9a85e375fc5b8512345233964c59b897ece291c31c7a5da862",
        "unit_id": "metadata:v1:seasonal-title:title:2c3249a7ec2eed9a85e375fc5b8512345233964c59b897ece291c31c7a5da862"
      }
    },
    "5_02_029_22_a": {
      "revision": "sha256:7486aa76f148aba6d946ccec934a983b595d4b1d7f75788ea4e5bd826c6c26ae",
      "record": {
        "source": "純心贈呈祭",
        "text": "纯心赠礼祭",
        "source_hash": "sha256:020db76d52c27ae9550994e09ee5cc2ecd4fbb31b88a4007928558c41e6cd435",
        "unit_id": "metadata:v1:seasonal-title:title:020db76d52c27ae9550994e09ee5cc2ecd4fbb31b88a4007928558c41e6cd435"
      }
    },
    "5_02_036_22_a": {
      "revision": "sha256:ee423aa8fcf46b8b77284504ce628629bfa5efb6f341f34ca584d9776dd4849c",
      "record": {
        "source": "Happyをお届け！",
