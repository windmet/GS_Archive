  "entries": {
    "story-text:v1:1_x_036rui_2_1_8_036_02:1_8_036_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:0abb155c61910fe545bb3501ff1b32b3b084ecd66295c86d27108a0c33842f76",
      "text": "喂喂，●●●●プロデューサー酱？\nHappy birthday！",
      "status": "draft"
    },
    "story-text:v1:1_x_036rui_2_1_8_036_02:1_8_036_02:cmd-000012:choice_short:000": {
      "source_hash": "sha256:593996e864832a756cf4dc0212ac61c5be5158747b59fb9204a64ca32157c86b",
      "text": "太高兴了，\n正好是零点整呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_036rui_2_1_8_036_02:1_8_036_02:cmd-000015:phone_message:000": {
      "source_hash": "sha256:394c5a88116174ffd25ca44529ae6b81e79520e687f156ba53345b266993a192",
      "text": "因为从变成零点的那一瞬间起，birthday就已经\nstart了嘛☆",
      "status": "draft"
    },
    "story-text:v1:1_x_036rui_2_1_8_036_02:1_8_036_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:e8b94531c24c6e41f70a9ced7a27b988a934deab52a4e109a78848d0c0d0eb5c",
      "text": "我希望你能尽可能多享受哪怕一点点这special的一天，\n所以一到零点就马上call你了。",
      "status": "draft"
    },
    "story-text:v1:1_x_036rui_2_1_8_036_02:1_8_036_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:dd27bb3e163978ce78ee35301392feb9304136642060f9615869f05abd303dae",
      "text": "等到了明天，大家一起开party吧！\n那么，good night♪",
      "status": "draft"
    }
  }
