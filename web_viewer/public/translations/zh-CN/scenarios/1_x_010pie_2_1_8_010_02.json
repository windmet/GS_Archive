{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_010pie_2_1_8_010_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_010pie_2_1_8_010_02:1_8_010_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:4cbf2726616012658c509e7e9a9195df438cc6b8fe86a35196b90cebc5ebb98c",
      "text": "●●●●プロデューサー，早上好！\n生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_2_1_8_010_02:1_8_010_02:cmd-000012:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_2_1_8_010_02:1_8_010_02:cmd-000015:phone_message:000": {
      "source_hash": "sha256:7d8e665798590371df30cddd5f1c1a24c464689303e3bf5c53993ecb87800c6d",
      "text": "我早就决定好，起床后要给制作人庆祝了！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_2_1_8_010_02:1_8_010_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:f7a1458dffe8e40c17557c692e61cf32639b2b911711af1266247a11588095d1",
      "text": "早上开开心心，一整天就一定开开心心！\n所以，我醒来马上就打电话了！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_2_1_8_010_02:1_8_010_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:0aff4dd12c485435dbccf9483a41001816d63f84a71a06c97b673742e1b0d7ab",
      "text": "●●●●プロデューサー，\n我们一起度过充满笑容的生日吧！",
      "status": "draft"
    }
  }
}
