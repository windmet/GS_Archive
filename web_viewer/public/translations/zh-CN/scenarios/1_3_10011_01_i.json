{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10011_01_i",
  "source_raw_hash": "sha256:c1329ce8cfaa8a60ed1cba29bd3bd4095c405f67f380a296dc3bea3f812c4402",
  "entries": {
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000018:time_caption:000": {
      "source_hash": "sha256:d754b865bcb97c6ac4d1751a7324118e65611b0ee124791cbf4f7dff6d44926c",
      "text": "几小时后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000024:dialogue:000": {
      "source_hash": "sha256:68fe846c711d147a0d966e3f4f6a685702dc8e157d2086e5092cde1f938f7882",
      "text": "接下来好像轮到那些家伙出场了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000039:dialogue:000": {
      "source_hash": "sha256:abd272d48c343da737c5a7354c92b51aa819f0b657019b28ebf40a080eeff763",
      "text": "……嘿，压倒性的表演呢。\n实力确实相当扎实。",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000045:dialogue:000": {
      "source_hash": "sha256:15fc8cee4ee11ca75cc2d00a80ec89a6300b424b8b040eaccd30a5a38b214a31",
      "text": "观众的气氛也是目前为止的乐队里\n最热烈的吧？",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000054:dialogue:000": {
      "source_hash": "sha256:eb1ea893e40bcb6217e297a66483108eaacf166d2a9208fcb0766dbff5389ff4",
      "text": "说明不只是嘴上功夫啊。\n这样才有打倒的价值！",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000061:dialogue:000": {
      "source_hash": "sha256:4a8ad9ae4d9217f02cb4bb0587eb206bb7e7b9091233b35c4266422dac03f202",
      "text": "Jupiter的各位，请准备候场！",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000067:dialogue:000": {
      "source_hash": "sha256:1fba3df90df05410a9efeb610d187d6cc3bb0dec5489f614154cca4b99cefc7b",
      "text": "好嘞！大干一场吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000091:time_caption:000": {
      "source_hash": "sha256:86b9e8163f0a7f1799efe4fc0bc9d07918211984fffd357330c6947ed4c0f70d",
      "text": "摇滚音乐节舞台",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000102:dialogue:000": {
      "source_hash": "sha256:de8742810eeb7997c33c28bde69cd97d2bd356f176d476468c9458ee0a302058",
      "text": "接下来是……Jupiter？\n哼，偶像来摇滚音乐节啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000116:dialogue:000": {
      "source_hash": "sha256:94fc74c61a7818499582e82eb6f4cbd2c2048840e3cbe1807176f7882e473888",
      "text": "（果然是这种反应呢。\n但是……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000139:dialogue:000": {
      "source_hash": "sha256:6439bffe8fc29e3c84196e21dd5b3e9dd3639edfe0efd14ba633dab47a589e42",
      "text": "大家好，我们是Jupiter！来看看我们的……\n来看看偶像的表演吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000144:dialogue:000": {
      "source_hash": "sha256:481fde3145068f84aadc488e7ff4b46f3603fe4f18ff7ca5ff073e3ab650b2df",
      "text": "（虽然大部分人对我们不感兴趣，\n但这样反而更燃了呢♪）",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000149:dialogue:000": {
      "source_hash": "sha256:87f9340e225ec3b09b09f189288e460f1224cf51ade4f220714a750c553ade1a",
      "text": "（用我们的表演，\n让全场的观众为之倾倒吧！）",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000155:dialogue:000": {
      "source_hash": "sha256:70bc09cbf4e189ef14a0cddeb006fdb278140300748710e9192412c42773802c",
      "text": "嘿，原来偶像这么帅气啊。\n唱歌跳舞都很厉害，挺有两把刷子嘛！",
      "status": "draft"
    },
    "story-text:v1:1_3_10011_01:1_3_10011_01_i:cmd-000157:dialogue:000": {
      "source_hash": "sha256:e4af5c76d70874086e7c4432f1d0fc71c673683513f1c67192cf7070441dfaea",
      "text": "喂喂，怎么了？\n再更大声喊出来啊！",
      "status": "draft"
    }
  }
}
