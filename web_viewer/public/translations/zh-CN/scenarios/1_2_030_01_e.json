{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_030_01_e",
  "source_raw_hash": "sha256:57c49cfb120b730c2f14b3292be00d77c5abf136588fea85ec43d9520ab70f91",
  "entries": {
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000013:dialogue:000": {
      "source_hash": "sha256:ae937320a11004dc80f8ae04183dfc51f54a905adb3f068dcffa5852818283a0",
      "text": "这样啊。能够再次听到卷绪先生过着\n充实的日子，真是太好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000015:dialogue:000": {
      "source_hash": "sha256:943b5404d1bad9509cab1a7cabc2fa662fff86e7a2733c6a87c56275e73b8654",
      "text": "今后也请多多关照了。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000021:dialogue:000": {
      "source_hash": "sha256:8d2f254d4d76043dd03027aeaf79d65588973b62b55b2f486eb8bb68abe644de",
      "text": "好的，我这边才要请您多多关照。今后作为偶像，\n我也会超努力完成很多工作的！",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000026:dialogue:000": {
      "source_hash": "sha256:ba8a5343bf8967fc96fa092bbf525599911539911cea2588b745ec9c26e5d980",
      "text": "工作之后吃到的蛋糕味道格外特别呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000031:dialogue:000": {
      "source_hash": "sha256:c3e097db1637534557809f073ce10a18947430be325041fa031a910ae302e413",
      "text": "这是成为偶像之后才增加的\n享受蛋糕的新方式。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000035:dialogue:000": {
      "source_hash": "sha256:ecd3aa8547e9dae62c39503c533836bb9537d4c323896aa451f6ab15e288fb07",
      "text": "那么下次卷绪先生工作结束后，\n我就去买好吃的蛋糕回来吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000042:dialogue:000": {
      "source_hash": "sha256:1fba022f806e0c6842695264a8e7ad7e0a77fba02d59537ac287454383929b05",
      "text": "谢谢您！\n下次工作结束后，我会好好期待的。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000045:dialogue:000": {
      "source_hash": "sha256:f4a5579095ee5aa71f10321a62ad30be972b86248b037d0d9fa78492820cb0f0",
      "text": "到时候制作人\n也一起吃吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_030mak_01_1_2_030_01:1_2_030_01_e:cmd-000051:dialogue:000": {
      "source_hash": "sha256:3265e93de2e598f2cf5119e6202cf2afb743954528712e6700ae2e51c109f21d",
      "text": "一起努力的●●●●プロデューサー，\n也一定会觉得蛋糕格外美味的！",
      "status": "draft"
    }
  }
}
