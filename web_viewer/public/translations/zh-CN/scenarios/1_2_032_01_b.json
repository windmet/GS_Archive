{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_032_01_b",
  "source_raw_hash": "sha256:ca828b92dabb1442652ef0ca980136c5e030487cfd88d6b9937e39ce4c7d52a7",
  "entries": {
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:9d6d738b6fdffc62c2a50db154a96b478a2ac2847ab77d601546acb502a0891a",
      "text": "那么，用掷驹来决定先手和后手吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000028:dialogue:000": {
      "source_hash": "sha256:14a452f3e0be74a4b126ba6b45f7367df515a83963d0541ebe3a7e30efd7a48e",
      "text": "来来，坐到里面来更方便看吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:360b40b95b2044451ffcfa4470ab87d29a8668901b3e77ed7b8353eb85976d28",
      "text": "谢谢您！\n那我就在里面旁观了。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:c40fe88b8ddb13bbfd1095c2600ed624b8471c7f6ac64f1239991bb71de3832c",
      "text": "●●●●プロデューサー，您怎么会在这里……？\n啊……辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000046:dialogue:000": {
      "source_hash": "sha256:5e669d27b63bbbe427787ca85ecbfa60bb1817e9a2fb4366feaf364c6e864bf7",
      "text": "辛苦了。\n我刚才看到直央君走进了这里。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000049:dialogue:000": {
      "source_hash": "sha256:e2fce4ea69075dc308b4fd977fd52622090877a1c1a8bc4f9ffd07d1926a75e8",
      "text": "哎呀，是直央君的熟人吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:26ba6bcc3b7728564dcb0471cee562536510305b94ca3bf897d55fb458405801",
      "text": "是、是的……！是一直关照我的\n制作人。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:873d1a5de7987912e087da415cdf97d384bfd7614e0c1ac9349463dd9f9857ef",
      "text": "这样啊！那可真是幸会。\n如果不介意的话，要不要看看直央君对局啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000061:dialogue:000": {
      "source_hash": "sha256:dd66592f4d2f7ef9e5390dfc22869cb7c23ee7b7d5775aea4d448a02d9a375fe",
      "text": "谢谢您。那我就恭敬不如从命了。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000070:dialogue:000": {
      "source_hash": "sha256:424b8b7062d499f3a4c8a5e9307585ff556d07c232afda1dadcde35d2df0a116",
      "text": "（被●●●●プロデューサー看着下棋，\n好紧张啊……）",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_b:cmd-000090:dialogue:000": {
      "source_hash": "sha256:7a1ab5d04679be8b073d0fdbb7b7826eb961e17607ab8733a5759057638f8e6e",
      "text": "那个……那么，我们开始吧。\n……请多关照。",
      "status": "draft"
    }
  }
}
