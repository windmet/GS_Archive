{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10003_01_k",
  "source_raw_hash": "sha256:691d1dc0fe4d2c42ec6e91e24121a70c6d5bdd32dc47969ecd2151e578a9f389",
  "entries": {
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000026:time_caption:000": {
      "source_hash": "sha256:d754b865bcb97c6ac4d1751a7324118e65611b0ee124791cbf4f7dff6d44926c",
      "text": "数小时后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000039:dialogue:000": {
      "source_hash": "sha256:bf1552b03f4ac6d055b1958670a08b2b2bb699e882991f24153178438625d95f",
      "text": "超级开心的～！\n还和大家一起看了CM♪",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000052:dialogue:000": {
      "source_hash": "sha256:b3cc2bb7bccee9ffb21542bc56c68f5a43a76d4f6d16a989f8159d703b173ac2",
      "text": "嗯。畅谈追忆之时，\n竟是如此令人愉悦。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000059:dialogue:000": {
      "source_hash": "sha256:ff0d906715caebb88f9f13a07dbe9f1b86851fbb3007a20e3bfc748bcbf3c6cd",
      "text": "不知不觉聊得太投入，\n回去的时间稍微变晚了点呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000072:dialogue:000": {
      "source_hash": "sha256:75a2c205561cbf13a453df4398334f247ebd59dcedfdd23775b4530d4e3b307f",
      "text": "各位在回家的路上请多加小心。\n特别是神谷，可千万别迷路了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000079:dialogue:000": {
      "source_hash": "sha256:4f373a7eb8371a06c0bcb274df3fc323dfc68dc63e576d1364bc6aeb2cbcb2a7",
      "text": "哈哈，东云真是瞎操心啊。\n没事的啦。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000091:dialogue:000": {
      "source_hash": "sha256:c492fc0e799c1ef85efdf5a78e98d8974d31dd0b577bcb99358500299d57172c",
      "text": "那么大家，再见咯。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000112:time_caption:000": {
      "source_hash": "sha256:48463b36e2734c9c53dcdcd7acb97e01bac095c311080e61a527ef3c8c1c874c",
      "text": "阿斯兰的卧室",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000120:dialogue:000": {
      "source_hash": "sha256:8599d1b428e61d8e14eaa618b45f4980750b37592f4009188a4369afc3f057a1",
      "text": "撒旦啊……吾是否也像撒旦一样，\n稍许为光之民赐予了力量呢？",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000131:dialogue:000": {
      "source_hash": "sha256:fc6df7e420ea3553057906b1495dd8c8971c4a1d64cf2be4a5075be913079835",
      "text": "（与同胞团共度的时光赐予了吾安宁……\n今后亦当集结魔力，共行霸道）",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000139:dialogue:000": {
      "source_hash": "sha256:af84f800e2d617fbeb323f37646aa8799f14bd721cc249775eff8162089c24d8",
      "text": "……差不多该就寝了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000160:dialogue:000": {
      "source_hash": "sha256:dd20b8d6741ae8b97eb054966f92f602f61ea650d57237d6c20d076089840586",
      "text": "这都多亏了阿斯兰先生点的那记“赞！”呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000171:dialogue:000": {
      "source_hash": "sha256:287dd353ef12a9f48426c06eaba4dd0348414199bfb3ec0b03fa376a462e9ca9",
      "text": "（是吗，吾也……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_k:cmd-000180:dialogue:000": {
      "source_hash": "sha256:164c5cb184dec869f2398e2859fe9956053179a2056042e337c91d5f49dab94d",
      "text": "呵呵……",
      "status": "draft"
    }
  }
}
