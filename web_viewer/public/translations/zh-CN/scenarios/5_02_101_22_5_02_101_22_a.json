{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_101_22_5_02_101_22_a",
  "source_raw_hash": "sha256:70ec35eb728e98b61401c3eb6e20b945b99f7f0e7606436fb28451346ea698df",
  "entries": {
    "story-text:v1:5_02_101_22_5_02_101_22_a:5_02_101_22_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:c8f612f9aff4ae61dbb0deafc32b70afb629960bccd49c8b929e5ee034efb2f3",
      "text": "辛苦了，制作人！\n我有想交给你的一样东西。",
      "status": "draft"
    },
    "story-text:v1:5_02_101_22_5_02_101_22_a:5_02_101_22_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:322a2a6d44659e5729e204fcc7858a41dd417b5f01376cfb3592cac7ca5c9408",
      "text": "请收下吧！\n这是前几天情人节的回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_101_22_5_02_101_22_a:5_02_101_22_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:15394cd70759db2bcb21bd769dea76ac0ac0e333b0dae291a89e862800f157b3",
      "text": "我照着感觉制作人可能会喜欢的类型，\n用自己的方式挑选了礼物。",
      "status": "draft"
    },
    "story-text:v1:5_02_101_22_5_02_101_22_a:5_02_101_22_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:451066d2670d628cda872bb529b5fa600ddbe1cd215260949fa8fa09f38a0624",
      "text": "里面倾注了满满的心意哦！\n通过这份回礼，如果制作人也能，",
      "status": "draft"
    },
    "story-text:v1:5_02_101_22_5_02_101_22_a:5_02_101_22_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:494d74559094d922a91168381a439baece5678ce6100afec75540c8c25ba0d84",
      "text": "变得像收到巧克力时的我那样充满活力的话，\n我就很开心啦！",
      "status": "draft"
    }
  }
}
