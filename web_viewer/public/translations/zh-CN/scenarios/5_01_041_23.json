{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_041_23",
  "source_raw_hash": "sha256:95db2b0e532c590fe5c4174878b2d30295e008c93a9ffd9a76e35e75179cf93f",
  "entries": {
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:7bf67f1181d2fd9ece4774357810a4b3fbaf8d7ed41c1a1ab2f5bb65a00881d0",
      "text": "●●●●プロデューサー。\n其实……我也有东西想送给你。",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:da6bf33c279ac0edd0bb930c28c1c4cf3d22bf9d711155194762dc0962d4e545",
      "text": "这个，请收下吧！\n是我亲手做的巧克力！",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢你！",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7b23af7ca37cfac9d180b2a9bcf385d31ebce5c39a17e19e9e12bbb24a0756d2",
      "text": "去年能从制作人那里收到巧克力，\n我真的感到非常开心……",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:cc4d2f58cc535f002c2958927df7d36bc6d0d65edb1b8c25e0939b9605ed56a5",
      "text": "我也想着如果能让你开心就好了，\n所以就带过来了。",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:8aa911f26e8f08ef653416dd8fe7f92b13b1074613bdeed8f6f67f38a5e2844f",
      "text": "好高兴。我现在可以尝尝吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:6d215a4cac006fbcb44e72353d7259a7cbdc802192ca031c3cf35f327ee3f663",
      "text": "当然可以，请务必尝尝！",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:94df5b79ba4049416e6ac2dddfddad6f2c79268820784339e706e1ecbd23784d",
      "text": "那么，我就开动啦！\n……嗯！非常好吃！",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000052:dialogue:000": {
      "source_hash": "sha256:6987b34ff8fc76e79879f9eb552dde5eb84bd1a779bcdc4df180d64a360b8f3e",
      "text": "真的吗？太好啦～！",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000057:dialogue:000": {
      "source_hash": "sha256:0eb0af1efa8558ea5f2aa9cbf964d69aac3e854e813b95ea55983ecbce202605",
      "text": "虽然对自己做的挺有信心，但在看到制作人\n的反应之前还是没办法放心呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_041_23:5_01_041_23_a:cmd-000062:dialogue:000": {
      "source_hash": "sha256:b8d72f506d2596769d427edd42556f5e61e778d5a1055d871a03cf204beb0041",
      "text": "为了让你吃到最后都不会觉得腻，我做了好几种类型的巧克力，\n你能乐在其中我就太高兴啦！",
      "status": "draft"
    }
  }
}
