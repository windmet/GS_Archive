{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_042dai_1_8_042_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_042dai_1_8_042_01:1_8_042_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:94881efe8c5145b538a57598cc31c4ebba5ab2af4238666226865a14cf638d31",
      "text": "●●●●●●●●●●Boss，生日快乐！\n哎呀——真是可喜可贺啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_8_042_01:1_8_042_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:af819ddb8ade568a780bf0493434231c8aacd582585c311497209ea0a523dbd7",
      "text": "难得的生日嘛。\n今天俺要盛大地替●●●●●●●●●●Boss庆祝！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_8_042_01:1_8_042_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:70940a65d14514d5ff956d4aff226b54455262681c9753e603a17d9c566247b0",
      "text": "呵呵，非常感谢！\n我很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_8_042_01:1_8_042_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:42eb013c0875b23a4e6aa37e6f04eab7abeacc66e183d2323cef3447cda6bb0d",
      "text": "哦，最棒的满分笑脸啊！\n毕竟生日那天就是要带着笑容度过才是最好的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_8_042_01:1_8_042_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:b5db257c2e8769eac2c3a9f89968b4ab18de5b42ce7f91b23c751caf21c5ebfb",
      "text": "俺一定要让●●●●●●●●●●Boss笑口常开，\n过上永生难忘的一天！",
      "status": "draft"
    }
  }
}
