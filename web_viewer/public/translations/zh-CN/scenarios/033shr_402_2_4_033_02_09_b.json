{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "033shr_402_2_4_033_02_09_b",
  "source_raw_hash": "sha256:485c86c6a962ae99125bd6f4ae88df4bb183083c9db6845cc772dfb169d16158",
  "entries": {
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:baecaec7a6e0c968808f7dbed63011f6c62d79fac0687674d7917871fbe7cded",
      "text": "喂，●●●●プロデューサー？\n听我说听我说！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:ac9cf81502d01c4040142f94b677256a3b0fe15ddd7a3288f3160e71e2db7050",
      "text": "今天我和直央还有花音一起，\n试着做了做冰淇淋的实验。",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:fe3899fbcb70d06994da58ad67699a959bcd01a2a914c32f3e3c1a874715c4c7",
      "text": "照着次郎老师说的方法做，\n居然真的只用盐和冰块就把冰淇淋冻住了哎！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:2439efac7fa772e6ea5d2403b3859ce796cfbe369eecb4640b296801c2ca417b",
      "text": "是什么味道的？",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:bd768473c791dcc24c7ad9cc929a04ee5630c3f1a410e29cd58d4c7db441ebe5",
      "text": "感觉有趣吗？",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:94048106147286cb6f17fff8c936a44529b2ddfea69ee927ea1a81a6a691d27f",
      "text": "虽然只是用鸡蛋、牛奶、砂糖和鲜奶油做的，\n但是甜甜的超好吃！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:cf177e1ab5dc98cb5d9ed5b3c1f5aa4975d18d59e4b174337b4500cea523bbb0",
      "text": "嘿嘿，冰水变得超级\n冰，可好玩了！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:a96abb28807d19762d448c4be6baf9ce10205d1cc6cf6e0f83e7281d8483a85c",
      "text": "啊，他们两个说下次还想尝试做更多口味的冰淇淋，",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:c7fbd0d5bb55ec9601776646155d160c7af75ceb9f5c4a151e6d92f8259cdf5c",
      "text": "到时候，\n制作人也一起来做嘛。",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000028:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "谢谢你们的邀请",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_b:2_4_033_02_09_b:cmd-000031:phone_message:000": {
      "source_hash": "sha256:44dafd94ecba1c138f5bb7f27e00864d586a0fd62b0bf159a9e45bca18cd7a99",
      "text": "好好期待着吧，说好了哦！",
      "status": "draft"
    }
  }
}
