{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_040ren_1_7_040_01",
  "source_raw_hash": "sha256:8b8eceea5a715b3c2d7d0d8d0814b54f3e5544f729b84d62324fef627aea5cf1",
  "entries": {
    "story-text:v1:1_x_040ren_1_7_040_01:1_7_040_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:6e4dbb74bf67d11f90680fedfc9eb79eceea2a07a80524f7d8bca24b4ae8e862",
      "text": "涟先生，祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_7_040_01:1_7_040_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:8cb759086a0da5919c8c4ac979568e0025e86bcc54f11bf6527f668aa1410ee0",
      "text": "哼！你以为跟我说这种话，本大爷就会\n高兴吗……少自作多情了。",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_7_040_01:1_7_040_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:a183768ed5299f6dd54ca8977a7d6ee566c74199dd1be0108de4c2dc4b70f436",
      "text": "既然要庆祝，贡品总该准备好了吧？\n本大爷就勉为其难收下，拿来。",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_7_040_01:1_7_040_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:2f92c0258f7eb500e31a5ad3c29dc64156b6aa27e7e11fca725944046619be39",
      "text": "丑话说在前面，要是准备了什么半吊子的玩意儿，\n本大爷可饶不了你。",
      "status": "draft"
    }
  }
}
