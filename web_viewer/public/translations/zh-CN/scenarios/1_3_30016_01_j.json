{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30016_01_j",
  "source_raw_hash": "sha256:112cc1b404de830899f7e78e3facc3154e6ce9f1195db2f5d04c26e8781019ef",
  "entries": {
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000022:dialogue:000": {
      "source_hash": "sha256:903aa5b95258631d87de3f3bd429b3deae8d823136db8635616e2b3e0881434b",
      "text": "所以说啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000027:dialogue:000": {
      "source_hash": "sha256:63409f703c65ad8308b927313e2906c3b9fc7cd01b37a3b657196a85332dc3d1",
      "text": "刚才朱雀说的那些快乐回忆，\n我早就拥有很多很多了啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000031:dialogue:000": {
      "source_hash": "sha256:98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "text": "……！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000038:dialogue:000": {
      "source_hash": "sha256:c644036acf9bfafd6245099faa92aeb6112cdd46cce581ee4f83823aef186dd7",
      "text": "看，那个也是。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000046:dialogue:000": {
      "source_hash": "sha256:b321d1bf1faf5351f2d11623a5894e238feb0e523a72f955ead782b3a342238d",
      "text": "刚才的草丛……？那种地方居然有花。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000053:dialogue:000": {
      "source_hash": "sha256:68e6d1bf0bcba32155e143ef34f8348607b78ad906cedd0dfdd44549ff7a7e96",
      "text": "啊啊。觉得挺不错的，就想拍下来了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000060:dialogue:000": {
      "source_hash": "sha256:a1d446c3b851e8a8150b3c438b2e32cb19db7f04674d9a2561c25c9a7f14ebff",
      "text": "换作遇见你之前，这种不起眼的小花\n我大概根本不会注意到吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000062:dialogue:000": {
      "source_hash": "sha256:01a9500572c9994ef2871f5fd1c3d9e83099d038c23f557e12522666b0c79f9f",
      "text": "玄武……",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000066:dialogue:000": {
      "source_hash": "sha256:7bec96c7c4c843d0b4e7cce3d4f7cce55cf8633110d2583c40dfb9c497922b2e",
      "text": "……嘿嘿。原来是这样啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000076:dialogue:000": {
      "source_hash": "sha256:dfe54de827dda8a92267b54b45fdb6867a1057e00392700c7a79a2b591410be0",
      "text": "那就让我们两个人去拍超多照片吧！\n把我们所有重要的东西全都拍下来！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000084:dialogue:000": {
      "source_hash": "sha256:f35a36b6de597a08239982808759bf5672a5aad2da9a5700accc1bc45806a388",
      "text": "哈哈，这主意不错。\n不过可能根本拍不完就是了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000103:mobile_message:000": {
      "source_hash": "sha256:da14df0fae1bd2115885d71d6f9fa4a299ee892ffdd72958c8ac01ead0151d79",
      "text": "今天也拍了超多\n照片哦！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000105:mobile_message:000": {
      "source_hash": "sha256:4c284081bebdc448648660a18e98dbb4fb45c2c5133d62250f94b44ae59ff4f5",
      "text": "也和学校的朋友们拍了\n大家笑得都超灿烂的",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000107:mobile_message:000": {
      "source_hash": "sha256:4496822744c50f50e1f7505a271b4256a52b81f3d5985d7d6ae2a8f61bd1b383",
      "text": "稍微看下嘛\n这个相机不用电脑也能\n直接传过去呢",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000109:mobile_message:000": {
      "source_hash": "sha256:b7c4944d068963e009d4644a674f74ef96b0c6ffae4e51cd9c354e86aca0e711",
      "text": "喂喂。\n你打算把所有的照片都发给番长吗？\n数量未免也太多了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000111:mobile_message:000": {
      "source_hash": "sha256:1b35f6f6c9ef99cd22c47028084622faf71e3ce60d7c12b8011252979fb32557",
      "text": "明天还要见面的。\n到那个时候，再慢慢\n请人看就好了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000113:mobile_message:000": {
      "source_hash": "sha256:88fe9c01848c2b50d57386202a46d92840e77f7e2d946d8758ac10595dc64625",
      "text": "噢！我知道了！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000115:mobile_message:000": {
      "source_hash": "sha256:eeda80e7114c83656f636255c35541d2f4a8e61fabdb546140c264e34ec3ab76",
      "text": "话说回来番长，这次拍的\n照片能送给我几张吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000117:mobile_message:000": {
      "source_hash": "sha256:de5900fc9acd156fa481ae908988b250eb7272c193bc9bfadc0740021a114e17",
      "text": "当然，\n保密义务方面我可以保证。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000119:choice_short:000": {
      "source_hash": "sha256:cef598bf36308e9ca7c946678dc8a65a86af87ce8cf9af2434d47fc4b0134063",
      "text": "请稍等片刻",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000119:choice_detail:000": {
      "source_hash": "sha256:6441d0bb60ec3851574fa31298fc13b43d9c8f4efef66de201706cd6a9c8fc48",
      "text": "当然可以！\n请稍等片刻。\n确认好了立刻联系你。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000120:choice_short:000": {
      "source_hash": "sha256:d9162607986cd7f2115775a58aea277be869ebcde33035072f3bedad0deaab3e",
      "text": "我去确认一下",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000120:choice_detail:000": {
      "source_hash": "sha256:2e80e43f43de64618b4e1f7f91909514a90ff43ec511c485664a4925579aa519",
      "text": "明白了！\n我去确认一下，\n不过我想肯定没问题的。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_j:cmd-000124:mobile_message:000": {
      "source_hash": "sha256:7b1769aeeaab69fe258370a9542d0fc4e2fb1cb82fe6bd2914f1adab647c9569",
      "text": "报恩谢德。\n感激不尽，番长。",
      "status": "draft"
    }
  }
}
