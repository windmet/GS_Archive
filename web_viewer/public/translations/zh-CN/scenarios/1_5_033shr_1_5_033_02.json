  "entries": {
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000011:title:001": {
      "source_hash": "sha256:eea013c1ad90e03f3a8638b73199a21123a0d4917d3010c8bb8ece21b1b71443",
      "text": "出演电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:40381fa4a2e907e6fc05e885f1ee4a3797f8ada00d4f2faafbf466fc75e11c37",
      "text": "今天是电视剧的拍摄日！\n好想快点开始拍啊～",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:30d25670287c2861a257e7b149d503d792aa83fa730f15cfdb1e15d2c6dbd761",
      "text": "呵呵，才刚到现场呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:f4145a2a2eba3ecf9d6bd98f9903be5a99880691e2f71453c721a96f99b2efb8",
      "text": "这部剧的主题是“家族羁绊”。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:97b1035ef2af3baf06f8d0ea3e4b1941778dbad2b798ca9787d116828bc7c5c4",
      "text": "志狼君饰演的角色，\n是活力满满的家庭气氛调节剂。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:293efaf83898ccd942512a7c43479c6239bfac6f92b41523602920c23c60253a",
      "text": "简直是为我量身定做的角色嘛。\n那我们去换衣服吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ca4f2a4649d75628c6a83723382d6784b33bdfc6b4651c3f3658aad5beb6b014",
      "text": "在那之前，先去打个招呼吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:587e14cdc2b6019f20f8a44dc84867bd14a35a9e9990cdf553c5ae7e4f32d0ef",
      "text": "对哦！今天还有泰斗？级别的演员在场呢。\n看我去给他们露一手！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000047:dialogue:000": {
      "source_hash": "sha256:4f78c96a263d57d94b8303833de4e58271de6a8d40dc578a2d68204832ef1d9a",
      "text": "好！请拿出精神饱满的问候，\n拜托啦！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000051:dialogue:000": {
      "source_hash": "sha256:4e5765d94e830124cbaef07288cddc7103273774cf923ad2ace96612c3796ea2",
      "text": "哦，包在我身上！那我们走吧，\n●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_02:1_5_033_02:cmd-000069:dialogue:000": {
      "source_hash": "sha256:643f88cab0e7174495fc842864225c6449c57ca76186227e43ff42de0f53ef4b",
      "text": "早上好，我是橘志狼。\n今天的拍摄，请多多关照！",
      "status": "draft"
    }
  }
}
