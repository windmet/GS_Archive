{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_003_23_5_00_003_23",
  "source_raw_hash": "sha256:a3795b2b67e75f297a175b86938ea34ad087c1476b64babae7fe8a190f0d5140",
  "entries": {
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000000:title:000": {
      "source_hash": "sha256:77375f2b029ead0b75cce278a56d4618d9528cb8df62f1425795b7caa3adac67",
      "text": "辞旧迎新的度过方式",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000018:dialogue:000": {
      "source_hash": "sha256:2b2cd09094930b11485f166e30c71a8f671ef1ed14eda639039e2c023c39bfbe",
      "text": "阁下，新年快乐。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000022:dialogue:000": {
      "source_hash": "sha256:21b3e64d7c3d3cb0fde107c883159f3567d3719174515c91521f1fe5eb4af075",
      "text": "新年快乐，制作人。\n今年也请多关照呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3a66d17a3b75418445c2babd279b74e2697ce348e14c894682e1302202f3b5bc",
      "text": "新年快乐。\n两位新年假期过得怎么样？",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000029:dialogue:000": {
      "source_hash": "sha256:8fee5a6f9705c17707f5e91af3dead980ae104379a2a0a19978e34c4d612822a",
      "text": "我现在正在补着做新年的准备。\n家人们终于要从海外回来了。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:f39591d46571b6c3b89b05df07c14137a33a9990d669bdea6f3990436f2667f0",
      "text": "都筑先生做了什么有新年氛围的事吗？",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:9f8b185ae79c7a5ff373beb28277f4466b5f0f11fcd752b8e0d3264c97efc51d",
      "text": "我吃了年糕汤，悠闲地度过了哦。\n也试着吃了年糕。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:3313bdbddab6f36d375c82b67048e3b2e5c6a757feb535dcab1d80ae4fcf968e",
      "text": "……！\n都筑先生，您吃了年糕汤吗？年糕也吃了？",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000047:dialogue:000": {
      "source_hash": "sha256:ce4494584531dfb60aa13a967afb219d8c86d7107f1349f017069d7ad5710bf3",
      "text": "嗯。很好吃呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000051:dialogue:000": {
      "source_hash": "sha256:a9f37cf27f2449c4eea30ce0b2671d71dd79aad09598ae0b211752104ed7b87e",
      "text": "总觉得，有种今年也会成为美好的一年的预感呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_003_23_5_00_003_23:5_00_003_23:cmd-000058:dialogue:000": {
      "source_hash": "sha256:fe4cc386dbbcccb4d2d8fc5dd940fa27c59bd626fdc45a4ff30937d560ea284b",
      "text": "为了让预感成真，我们努力投入工作吧。\n阁下，今年也拜托你了。",
      "status": "draft"
    }
  }
}
