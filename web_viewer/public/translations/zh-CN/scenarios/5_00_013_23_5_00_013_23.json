{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_013_23_5_00_013_23",
  "source_raw_hash": "sha256:7506711feba1e7e80493ee4d7378da98d8ea76a669c8f7b8fb8af9bcc87da968",
  "entries": {
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000000:title:000": {
      "source_hash": "sha256:18191340b37f86585897ef7c7088e7e9f61edb5c8bebf1bcfe268405a79c0a64",
      "text": "新年也要在男道拉面度过",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000014:phone_message:000": {
      "source_hash": "sha256:86d319d4a2fe4a05ca946d1ba8055c124a7dd7122117c371a1b1142d56646760",
      "text": "师父，新年快乐！\n今年也请多多关照。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000016:phone_message:000": {
      "source_hash": "sha256:e753989d352c52b6fb5dbf70b49ae5be08e7e203d4861e981a8d8079f0129c34",
      "text": "现在武和涟都在店里，我换他们接听啊。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000020:phone_message:000": {
      "source_hash": "sha256:50371749e3fcec99979f444ad7fd96d5501f71e63124c3ba3b0b3dae3e233cc3",
      "text": "……喂，是制作人吗？\n新年快乐。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000023:phone_message:000": {
      "source_hash": "sha256:91c76cecf20dec8f8c9a5491aa584ef80f9aeb7e9dc5bbeb9877df26a50b11ed",
      "text": "今年也拜托你了。\n……圆城寺先生，谢谢你把电话给我。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000026:phone_message:000": {
      "source_hash": "sha256:f880ec8299d19556b3e2dfce7c14ae6366a4c0fffd7a53df9b4a3396916e67f6",
      "text": "嗯。\n喂，涟也来。跟师父打个招呼。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000028:phone_message:000": {
      "source_hash": "sha256:ecd0b907580e9d25b6642ace1236c8789405783098dfc3e8b783a73671150cdd",
      "text": "别妨碍本大爷吃饭。大～笨蛋！",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000030:choice_short:000": {
      "source_hash": "sha256:c5ca768ea1b8e87036533f46502cacf41847603c7704e9ba68fb968a9294bfd4",
      "text": "看起来精神很好，\n真是太好了！",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000031:choice_short:000": {
      "source_hash": "sha256:7f303a44255a04bb61a2b7f5944332a897c2f8b6201832d840366d0a9d6f6365",
      "text": "今年也请多多关照",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000035:phone_message:000": {
      "source_hash": "sha256:db32f1be50527ca28424959fffbf644f30ae9020ef953e2f339a560fde14646c",
      "text": "哈哈……不好意思啊。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000037:phone_message:000": {
      "source_hash": "sha256:a079a23a6fb9083129fbb38fdc7bc3ae0904ed8f20953702e6eb0289fe231e19",
      "text": "喂拉面店的！再给本大爷加份面！",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000039:phone_message:000": {
      "source_hash": "sha256:5b369fa3172bbda6ca6304213e75663008e7fc4513e3c06656830c129a502d1a",
      "text": "你这家伙，大过年的就不能吃得稍微安静点吗。",
      "status": "draft"
    },
    "story-text:v1:5_00_013_23_5_00_013_23:5_00_013_23:cmd-000041:phone_message:000": {
      "source_hash": "sha256:40e29fdfc4f9eb77955f2475a66683a9ca42e0ee578847c1706cecf0ae364213",
      "text": "希望师父也再来吃拉面！\n今年我们THE 虎牙道也请您多多关照了。",
      "status": "draft"
    }
  }
}
