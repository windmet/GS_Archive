  "entries": {
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000010:title:001": {
      "source_hash": "sha256:93671c25981db19bb7fe00ae15669da572bdc90d7313000cd40b5e5f84965d9b",
      "text": "美食主题电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:869f6f5104a8461a6b854fc786b40e65f922dc237936db0f95f3b0bc10a1a290",
      "text": "甜美的白之滴，与永恒的褐之滴。\n究竟该选哪一个……",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:7db55b063009a0eccbbc0cf22d69841325bf41f6b01d00bcc1b47e7475654c68",
      "text": "阿斯兰先生，您全神贯注地在写什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:478033c290d7a6c1df39160487030adac81db3061b2c7972c2484a13acd5b0e4",
      "text": "问得好！\n本座正在思索施展于幻影之中的全新精制术。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ce1000fe9d5e603fdf9c5da58ac53fe6f0ed8194d8b10dc414d8d6edce718b60",
      "text": "导演确实提过，希望阿斯兰先生\n能设计一款原创料理呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:abe26eea4cbc533482b921bbd4737a6c0a0bab4fcada7383fff698f47d37d6d1",
      "text": "库库库……为了回应造物主的期待，\n本座将解放力量！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:b265b281627a50703ff5f604c4a1cc25ea6946292823d573d8aa36a587d872c1",
      "text": "那么，吾主啊。\n可愿品尝一番以全新秘术精制之口粮？",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:b9f9050d2f997af9cb832514a5e93088ce090b35dd4e548db62ce04ef53a8fa5",
      "text": "可以吗？\n务必让我试吃一下！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:8028e7335bd099cd31af313edd5ccd0f558ea034ca0703f84c6dcdf629a81196",
      "text": "看吧！这缠绕着被宰杀之羔羊灵魂的口粮……！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000051:dialogue:000": {
      "source_hash": "sha256:c85cfad7ab77775b5f81eab7edf2332493694f08071f99010b1fd9c39707aad6",
      "text": "是棕酱嫩煎羊肉啊。\n……哇，肉质好嫩，真好吃！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_02:1_5_029_02:cmd-000058:dialogue:000": {
      "source_hash": "sha256:f493ee0e116d0bb7814cfd7b522a49e06218cdcb153dfa06ac57629d581c363b",
      "text": "只要本座出手，这等程度轻而易举。\n啊哈哈哈！",
      "status": "draft"
    }
  }
}
