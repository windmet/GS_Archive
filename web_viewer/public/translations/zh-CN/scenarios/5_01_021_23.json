{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_021_23",
  "source_raw_hash": "sha256:c5dd9127f89d2f2c32c301d1851af43a73673ba484738927d3306835fcb4281f",
  "entries": {
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000011:dialogue:000": {
      "source_hash": "sha256:589e0ae75c9ec7566158097dfa0a39c44115fdafbbb6ee6745c7bcff4a7af40b",
      "text": "制作人，能耽误你一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:d19a7319003cb32ce17bd7024651e2cbaed55660848ae6bd818df524833574a1",
      "text": "好的，有什么事呢。\n是关于下一份工作的事吗。",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:d79c8e4b55e5dcfecc8c122aa15f2f7b6a939cb565d747d5c223cdac492eb52d",
      "text": "不，不是的。",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:400b1d4244f857f8ef6d8bec6d5416501036dc7766b4f4b3f269ffcf67a5d045",
      "text": "前些天的情人节巧克力，\n非常感谢你。",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:3098e96ca8965686ee485ecfef6aee6e43e1ca7d3c5b71b57f7fd29ed748acf2",
      "text": "我已经尝过了。\n今年收到的巧克力，也非常好吃。",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000028:choice_short:000": {
      "source_hash": "sha256:2a72d28c672a90e59467845a3eb6725b2420d44ee2ab6a1220bf8cd38400045b",
      "text": "你能喜欢真是太好了",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000029:choice_short:000": {
      "source_hash": "sha256:badc2b8efa6512105409e122d34cd6da1ad95f94fc895f22c8c87a3072d329e5",
      "text": "是希望能成为旬先生的活力才准备的",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ba7af17f3f72aae6713bf3138feb9ee50f47c4114a5283c332a3a53d04aaa8af",
      "text": "感谢你的贴心关照。",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:5066bb9d98b2b9bc83aff3e4b7fec52a148e45706555d90cd1919b16d4c17850",
      "text": "还剩下一些，\n等今天的工作结束后我再吃呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:5aefbc1efa615a48500fc481b17a7674883d130ede21ace54b3f16ff6dd422ae",
      "text": "为了能回应制作人在百忙之中为我准备巧克力\n的这份心意，",
      "status": "draft"
    },
    "story-text:v1:5_01_021_23:5_01_021_23_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:c1a291299b3ef9a39582034d617ea81864f4c4e6fc4089cef95d4ce330016736",
      "text": "首先我要专注于今天的工作。\n接下来的外景拍摄也请多关照了。",
      "status": "draft"
    }
  }
}
