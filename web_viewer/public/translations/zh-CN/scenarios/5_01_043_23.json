{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_043_23",
  "source_raw_hash": "sha256:1c6a4115e9a9f84a53937881714d648db590960d041ed84a4ad3c0552e08e8c4",
  "entries": {
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:2a9d604f15bea0664b0c69fcbdef84f4ca6bcca1f10d15a50214cd834276e253",
      "text": "…●●●●プロデューサー。\n今天谢谢你的情人节巧克力。",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:2da07641b1db7f2b8670be7748e5e9dbe2d78d733120e76a814bbbb674160c09",
      "text": "…这是一盒能切实传达出制作人心意的\n巧克力。",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:258c43868b955280031c0d6a2d6be82c67f625d6743ff25d17dce70217ff81b0",
      "text": "…今年，我也准备了一份礼物。\n你愿意收下吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:fc61c8e070f70390ca3248202a53f51c174de6171897505644726eec245edec5",
      "text": "好的！这是非常漂亮的花呢！\n谢谢你，一希先生。",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7512d263abc57e5411cc932007505735b770d176d5d66060e8674bf7aa5ff2f1",
      "text": "…嗯。",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:79b7bd1fa043805f77e7eb9578196e48c6a6e875a9bb5e079527b752d9a26488",
      "text": "…一边想着送给制作人时的模样一边挑花，\n真的非常开心哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:abf9bf95ca4a0b6c760ffda78f523e76cfe03f8b18135facb2cabda2df88f439",
      "text": "…你能喜欢，我就很高兴了。",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000042:choice_short:000": {
      "source_hash": "sha256:0abd6ea369ec82eec94240a29ae564400e554fd27272753dcb244536f001b93f",
      "text": "我当然非常喜欢，非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000043:choice_short:000": {
      "source_hash": "sha256:04911583360bd00a5ca1d52c0ffd85cba14eab2238f1b0384ba2228b4b862834",
      "text": "你为我准备的心意让我很感动",
      "status": "draft"
    },
    "story-text:v1:5_01_043_23:5_01_043_23_a:cmd-000053:dialogue:000": {
      "source_hash": "sha256:4a198d86503b251da9688f0b6c98e92ad01719b52576df758557397bd1940f37",
      "text": "…这样啊，太好了。在情人节互相交换礼物，\n感觉也很不错呢。",
      "status": "draft"
    }
  }
}
