{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_02_f",
  "source_raw_hash": "sha256:9195939249b631e44050e1ad391c945b80e5a9a6c517d92fdb384cb11a2cfdfe",
  "entries": {
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000011:time_caption:000": {
      "source_hash": "sha256:048557fc73d2b59665f41fa4f9e374ab0f11d3e4550bdf65340a568d03f9cd2a",
      "text": "一周后……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000015:dialogue:000": {
      "source_hash": "sha256:732d3a276898b7077d04fbd5b1472f685e370cba792fd77cd13beef44b918e66",
      "text": "（今天是公司的体检啊。\n虽然是按贤君指定的地点来的，但这家医院真大啊）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000017:dialogue:000": {
      "source_hash": "sha256:3c18b029513034429e45d7797cad49d2ab831a059b25ed5154a2bf5af982a7f1",
      "text": "（啊，有便利店。在去挂号之前\n先去买点东西吧……嗯，在那边的是）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000028:dialogue:000": {
      "source_hash": "sha256:069508ec6cb1fd306e843f5717347c6151c042cbde9790875d21572e98c27d6c",
      "text": "阿姨，你好！\n有新点心上架了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000031:dialogue:000": {
      "source_hash": "sha256:d88f72c9f93fb0041bfbda844397da0529e4944e5291f837d61e4344ce497138",
      "text": "有哦，特意给悠介酱留着呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000035:dialogue:000": {
      "source_hash": "sha256:81e8f01bf782422d4c73c3ec691f490ddd829affe92a40fa2359293dfb7cd7ec",
      "text": "太好啦！谢谢！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000046:dialogue:000": {
      "source_hash": "sha256:4449e2284183a5f753e946f7088622844114c311da9e3c99f107826045f9088b",
      "text": "悠介君。你托我们买的足球杂志到了哦。\n待会儿能来护士站拿一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000050:dialogue:000": {
      "source_hash": "sha256:d42ae2a4a1275831896216b6ae50de37b29bde889bced8be5b0bca2a9d30d7bc",
      "text": "诶，真的吗？太感谢了！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000061:dialogue:000": {
      "source_hash": "sha256:4952a2b91e2d85d21d39499a8a97979c437cc9c474d4b03ccfafc95ad0d94a67",
      "text": "啊，是悠介大哥哥！\n下次再教我踢足球哦！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000065:dialogue:000": {
      "source_hash": "sha256:11a1a7313e536ebc848f880cfec95acbd7ca78494137e8d04915bfa620d8d8d4",
      "text": "没问题，随时都行！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000069:dialogue:000": {
      "source_hash": "sha256:0cab9fee991e8b3f61c10efa15791fc7a83dc10f249ea9dd28603ff08ba839c0",
      "text": "（那个人好厉害。\n每个路过的人都在和他打招呼）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_f:cmd-000072:dialogue:000": {
      "source_hash": "sha256:afdadc4bd47179cc62ef4eb0c12423bcf5723a7abf4c54c5d94e9948075b5fe2",
      "text": "（咦，不过难道说，那个人是……）",
      "status": "draft"
    }
  }
}
