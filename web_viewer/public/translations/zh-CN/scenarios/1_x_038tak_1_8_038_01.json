{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_038tak_1_8_038_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_038tak_1_8_038_01:1_8_038_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:e5d2cf2b3e67fda94f5a2e9671b71d1e8dda51f69c704df151b05278c40b0ad8",
      "text": "●●●●プロデューサー，\n一大早打扰了。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_8_038_01:1_8_038_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:9e34c87735fdc83a306090b8e3175faccfe79d38ed71d9e334b7480e4beba53d",
      "text": "跑步的时候，\n我突然想起来今天是你的生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_8_038_01:1_8_038_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:50d1d5fe92f67d4b7b4a863d7cd9779e32dd64a5d7f4d124bbdea6832640b657",
      "text": "想趁着还没忘的时候\n先告诉你。\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_8_038_01:1_8_038_01:cmd-000015:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_8_038_01:1_8_038_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:beccc416884b1444d874d298e35870eba67afa3f7b8b378001564cb1a3935e5f",
      "text": "嗯。那就，\n事务所见。",
      "status": "draft"
    }
  }
}
