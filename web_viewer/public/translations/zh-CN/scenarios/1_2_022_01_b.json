{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_022_01_b",
  "source_raw_hash": "sha256:eee9e0f18ab772af0d09672992954b574d0f305bad8a9cb07f6e928c44108132",
  "entries": {
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000012:dialogue:000": {
      "source_hash": "sha256:6abd86a96aea711fd0af2efe39ad388e3963c5aca43ac84df93c20e800e84ecc",
      "text": "那么，请听第一个问题。有令你印象深刻的\n情人节回忆吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7e019d867a60083b8879e55fd27ccacd92157ff2a1bedbb3f63b4552521ac5a1",
      "text": "嗯……情人节的，回忆……\n收到过妹妹手工做的巧克力……吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:ac8ab6d8c5d73e4a29d0e418573befeaaed735bd65aba1dbb7d42e13d7797cd2",
      "text": "她在奶奶的，帮忙下……\n送了我带闪闪发光装饰的，巧克力……",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e670a556e52e6d39e330932c2e4e3536c56032f08aca0fb6e03992e52f9f9434",
      "text": "真的，好开心啊……",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:eeefc5dd740aae8f59aad6de4ef6ff6ad6ae0acac5fe02374bfa991b042ad2f1",
      "text": "（……虽然可能跟原本的主旨不太一样，\n但真是个温馨又美好的故事呢）",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:cf92d7912230b76d47385c16b7d3125ce20c73f080b1ec488a9e20974975a07e",
      "text": "那么下一个问题。\n最近有什么让你心跳加速的事吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a22ccc3838012f8e669b0b4bfef305674afd247689b6d9edf83776e121ed4dae",
      "text": "嗯……半夜醒过来的时候，在枕头边上，\n我家的猫正低头看着我……吧……",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:783609e5d2d44bca9de1f25fe1bd15d6caeec22d4f25c612cd3c83656ea7120a",
      "text": "猫、猫……？",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000055:dialogue:000": {
      "source_hash": "sha256:f34fe251cad1bc7a5e038a2c742b11808c6b38eaeaaf972f57c187651c181900",
      "text": "嗯……真的，吓了一跳……",
      "status": "draft"
    },
    "story-text:v1:1_2_022nat_01_1_2_022_01:1_2_022_01_b:cmd-000057:dialogue:000": {
      "source_hash": "sha256:8ae1a0f60df1bad2779b06c2aa1438907379f7b902ad6623ea9fe1323146fd87",
      "text": "确……确实，那种情况心跳会很快呢……！",
      "status": "draft"
    }
  }
}
