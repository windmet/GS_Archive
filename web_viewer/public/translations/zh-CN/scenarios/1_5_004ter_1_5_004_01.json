  "scenario_id": "1_5_004ter_1_5_004_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000011:title:001": {
      "source_hash": "sha256:d1fec0c8a5aac17745ca996acdb3aba3ec005f58ffbf1f608a1fadf6cd1eea1c",
      "text": "速溶咖啡广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:efdf4e89f79d62d00117512db5ddd4c6983ebe485ea4b2a675a2477015563760",
      "text": "这是这次接到邀约的广告里要用的\n速溶咖啡样品。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:b24e2fb505595dfdf235f4385920451b79bc277856e4871ef3d2d8a6cd47e88e",
      "text": "一眨眼就融化在热水里了呢。\n辉先生，请尝尝看吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:ac41790b99a1b66f53848b488ae2804d779692a3d5a456639b7178e28c3ad426",
      "text": "那我就……嗯，口感很清爽很好喝！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:85b9aeac84cc3d9a6774969239189ed40b505e49c75dbe1740c811c5f8d4e93f",
      "text": "不愧是早晨专用的，清爽又\n美好的滋味！开个玩笑。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:934e67e8858f7a74791f2aeab6bc2dbc5df58ef682c71bab1c39d64a6adbb53e",
      "text": "这种东西在早上没什么时间的时候\n真的很合适啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:543531826d84f623d4c706dc3fc83b0476cae79223700e2c3df2c8d071bb70f5",
      "text": "尤其是睡过头的时候，\n根本就抽不出时间来现煮咖啡嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:af0177f476cb8e3d94cf4718a958c030c218171b44aa83b31f7c528ae10a08ee",
      "text": "迅速融进热水里，不仅能喝到好喝的咖啡，\n还能提神醒脑！太棒了吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000053:dialogue:000": {
      "source_hash": "sha256:64cb5c5ea2bce417d78d43d5df048b200fb6e9c921410a24f553a666eaba5009",
      "text": "确实，要是能轻松喝到美味的咖啡，\n从早上开始就能充满干劲呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000058:dialogue:000": {
      "source_hash": "sha256:2c7dd0e111cce87fe34aadcd86c2711a023956ac10deccbba514068901b5a569",
      "text": "嗯！喝完咖啡脑袋也清醒了，\n可以再跟我对一下工作细节吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000061:dialogue:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然可以！",
      "status": "draft"
    }
  }
}
