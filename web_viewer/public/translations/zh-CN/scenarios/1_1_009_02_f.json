{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_02_f",
  "source_raw_hash": "sha256:9499408360e90444446ed2c2c80f162c2cb655e1f049636a4875838b0489639c",
  "entries": {
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000013:time_caption:000": {
      "source_hash": "sha256:a83a569fcbad3dd9306763c25a5b76f15f2b8f84b3c872d8473c1f3986ae97d5",
      "text": "附近的家庭餐厅",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000026:dialogue:000": {
      "source_hash": "sha256:9e91dc886d0c4af107e39ac13411beeebcda4faef9eb62992dc47d08209289ca",
      "text": "……喂、喂，玄武。他说我们当偶像，\n是认真的吗？话说为什么会挑中我们啊？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000030:dialogue:000": {
      "source_hash": "sha256:3486cc82cb8db10ae6863e78d61aa4dd436e24febb5e926ee8d8a9b1a22e19cc",
      "text": "……这种事我怎么可能会知道。\n至少这家伙看起来不像可疑人物就是了……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000049:dialogue:000": {
      "source_hash": "sha256:64fd8f3dfe600745a7488be331fd029d46dd3c973b87e97073bd1a20596005f5",
      "text": "不好意思，占用了二位的时间。\n原本的安排没耽误吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000057:dialogue:000": {
      "source_hash": "sha256:80030d4aea45c59901b1ac15d20ee7d193f9c407554dc6fe12fec478842bc384",
      "text": "啊、啊啊，只是随便逛逛而已。\n不用在意。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000063:dialogue:000": {
      "source_hash": "sha256:b80b8b9f5ce1f5d5b6fc934146b7f6dc19eeac460fbaed792dad5c6f38fb2d9e",
      "text": "话说回来，谢啦！\n帮我们找了家喵子也能进的家庭餐厅。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000067:dialogue:000": {
      "source_hash": "sha256:581ff3ae55bb375f4263be2ed881a4b6a673c188fcd2a1b2c788b937ef4025f0",
      "text": "哪里的话。\n毕竟我也有事要找喵子商量。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000071:dialogue:000": {
      "source_hash": "sha256:284ebe3aa2a3ad3f51a3839a7db775c44f9c03e5451db50e93a7a022c636f469",
      "text": "找喵子也有事？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000073:dialogue:000": {
      "source_hash": "sha256:8913e8d3fa04af118aabb8f6433e6d2425620c936d9c709ec9182db459acee05",
      "text": "喵～？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000077:dialogue:000": {
      "source_hash": "sha256:d87df05737821f6969dd1951f9588edb8c0bb271754bab36da9a349618d8c4ae",
      "text": "刚才我也提到了……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_f:cmd-000081:dialogue:000": {
      "source_hash": "sha256:1b511de20a5eee91c4e0668aff65af14d9d9d8e64078e17c9297b964ba50ddb7",
      "text": "朱雀先生、玄武先生、喵子。\n要不要来参加偶像试镜呢？",
      "status": "draft"
    }
  }
}
