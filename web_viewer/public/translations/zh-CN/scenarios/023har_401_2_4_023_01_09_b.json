{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "023har_401_2_4_023_01_09_b",
  "source_raw_hash": "sha256:0fde9e1eff861b8a76b7a70572125da2a76be015f7ec3f8cd8203fd069f55fdf",
  "entries": {
    "story-text:v1:023har_401_2_4_023_01_09_b:2_4_023_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:0d32086d3d3ccaf140990a02896eaca873c4a7098a225478152308f3d76a1773",
      "text": "……啊，●●●●プロデューサー。\n今天不是展示会的庆功会嘛？",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_b:2_4_023_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:dec1b1ff7055aed99fb1263a1bb260e90dc9289e71752067422f40e14c2e14e0",
      "text": "我本想着去买点甜甜圈当慰劳品，\n结果来店里一看，发现出了新品。",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_b:2_4_023_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:7d56bd0b88b91eda60f2e666baa7330e9f229c90aeb7649e5949770d0e607fd9",
      "text": "●●●●プロデューサー，\n抹茶和草莓你更喜欢哪个？",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_b:2_4_023_01_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:bf32fd4f5bd9725f3a239c18bc763160f4ffabdc25db98f3b5e164ae852dd35f",
      "text": "挺纠结的呢……",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_b:2_4_023_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:bc6406ce8bce2327fc97e6329993488d41aa247f78ef8d9e0504ebf44df49d7e",
      "text": "啊哈哈，两个看起来都很好吃，我懂你的心情。\n那就两种都买吧。",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_b:2_4_023_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:34edb917ba9dc51f87f46294929019fe42422089b9dd20b2aed6c0c15bec0f09",
      "text": "我还会买些别的我推荐的口味。那待会儿见啦！",
      "status": "draft"
    }
  }
}
