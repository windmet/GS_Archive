{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_015leg_01_1_1_015_01",
  "source_raw_hash": "sha256:db06ee4ad501a06e5f4daab51b377b7f7718bdcbf52b5247575d38c3f53c4333",
  "entries": {
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:7aafa21288994e48db480926589b0e59d2aac0f5297c1c3d4eb03341bf5fdd26",
      "text": "展现真实的自我",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:a1dd563019cbbf20b4275b0716c9f654529c207598d183cb5d08b200a207a85e",
      "text": "继续伪装自己扮演好人，还是干脆一个人踏上旅程……怀揣着这样烦恼的想乐，以从哥哥那里听来的话为契机，对将个性作为卖点的偶像工作产生了兴趣。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:7aafa21288994e48db480926589b0e59d2aac0f5297c1c3d4eb03341bf5fdd26",
      "text": "展现真实的自我",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:8c00f13d703955813d285296187d749f6ec8640c5b859d21481cd6f1c1c05e33",
      "text": "谢谢惠顾～\n欢迎下次光临～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:557a4349807c9102e392b3ac58cae21ce1534a84718da362479130470b8af6f6",
      "text": "（……呼。\n客人总算，稍微少了一点吧～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:ec1e4a61b741946e1ba0f451e55d46f68bfec86b9c4b9f18a2ebff43c4762ffa",
      "text": "（那么，趁现在\n来做做新商品的POP吧……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:5340ae50f3c6d3601cdf2dbe31ca3d9256eddbe236eb923e20c3f381ba98673a",
      "text": "辛苦了，北村。\n总算是告一段落了啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:1e80853f1091303894089ddabdcf0c2d85b4f76a41e34c0416821c994615f5be",
      "text": "前辈，辛苦了～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:703fa384319ce581075cd431f251130f4572f4b36fec868c8ec161bb53f2fb65",
      "text": "过了中午之后，客流量真是不错啊。\n托福我们可真是忙得够呛。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:25591d883662d9cde2aec6392ad394625cad3704e3ed4ce40849e4d4a20e851e",
      "text": "呵呵，确实呢。\n我也感觉终于松了口气～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:0174225013fe3a7d2a73b80790f766d821f1077281288a727febe16ef47149b4",
      "text": "真是的，饶了我吧。\n刚才还有客人抱怨……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000060:time_caption:000": {
      "source_hash": "sha256:329b45cb19cd7f6739deff00854fb54bd88a0e9d3535b36296a3b735f599097a",
      "text": "十分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000069:dialogue:000": {
      "source_hash": "sha256:6396967b005664fd5fbcc191dca92fc6ebc2cbcaf82758506b3cf93e96f0c58c",
      "text": "（这个人，真能聊啊～\n说实话，强颜欢笑都有点累了呢～……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000073:dialogue:000": {
      "source_hash": "sha256:6f504961945e39e6266912fd98aa1cc1147ed878d435e4b61e67b1104f2baa9a",
      "text": "（长篇大论，大半全是废话。……开玩笑的～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:c22985e6ab86969190fefb6dd287b88077e6767d191afb0d193687dbcd3dd7fa",
      "text": "然后啊，我当时就说……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:54f3cfdf0a155d3b0e6c4a39b84969a71192f11d3efb8584a9c6e00b24ac95b0",
      "text": "（前辈，还要说到什么时候呢～。……咦）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:48a3ec18d7eb8fafecce3691094472e1a11fe7037497186c21e019520e1de8a1",
      "text": "就是这里，之前向你推荐的店！\n有蛮多罕见的小东西……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:6476d3bfd769e84110a014496c8831ba0de41dbc95fa4930a6c06ea95242e1b4",
      "text": "前辈，好像有客人来了哦～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8039137769f34411893865081d137c73f39d6e84b29d2f67356e9b5e89306289",
      "text": "嗯？啊，还真是。\n那我也差不多该回去干活了。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000044:dialogue:000": {
      "source_hash": "sha256:a74c4759f217c379e38d7968792489570e11fcace90fa451b2be6aaca5f46115",
      "text": "那我继续去做POP了哦～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:329abf6238a81dd934683ccb1b2df61b1a5fe727f1a36ca0a3923c6d0b3c0ac5",
      "text": "欢迎光临，请慢慢挑选～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:4661411445ccdfe68909d991889cd1b71114bcb8ab3f6b0442820a0c8c3e1220",
      "text": "你看，这个POP广告。\n居然是五七五的形式，挺有意思的吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000061:dialogue:000": {
      "source_hash": "sha256:77a20022dc08f2e70f1126a05e59e528871f5a8f8b791a00baa60d81edcfe240",
      "text": "（我的POP，好像被夸奖了呢～\n虽然感到很开心啦～……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_b:cmd-000065:dialogue:000": {
      "source_hash": "sha256:6b6487d5a8978002a137b31238e2c32ec9fab8134194537bd14b8d2efc6ad2d2",
      "text": "（……不行不行。微笑，微笑～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000014:dialogue:000": {
      "source_hash": "sha256:11ff574e9861f80340b60dfd7c9fab74542124bb6372b35874f4552f053f6d48",
      "text": "哇，好有趣！\n真的，净是些没见过的杂货！",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000016:dialogue:000": {
      "source_hash": "sha256:950dd50a1af7d25a012f33c3f0ce6dd65245864a854e25ef3044587a6c874806",
      "text": "这种店，亏你知道呢～\n难道说，你经常来吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000018:dialogue:000": {
      "source_hash": "sha256:2a8a17e5289260bba3a59e21515e17a1651d10a1548b358e2af337563ebbb33b",
      "text": "算是吧。好像我的喜好有点怪呢。\n就喜欢这种有个性的店。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000028:dialogue:000": {
      "source_hash": "sha256:61940f03c4f7d335b97562515c27b9803bfa42463cae0859159228e0deac1428",
      "text": "（……“有点怪”，呢～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:7a521dec96a9cac2f2b3e5c93f1dca72023f0ce8183839d37845476350e949ae",
      "text": "（这种话，是可以自己说出来的吗～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000035:dialogue:000": {
      "source_hash": "sha256:fc7739c0363ba30b9ab96f41f57672b174ae35236a82b3c5dc9dda17ecef4a4b",
      "text": "（肯定是因为自知没有个性，\n才想要表现得与众不同吧～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000038:dialogue:000": {
      "source_hash": "sha256:25757ff2cf9ce56cf849cc49d21f4568c0d2573102b10523d315138be52ac79f",
      "text": "（伪装自己，以保住容身之所或地位。\n那不就说明，是个非常没有个性的人吗～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:d289d7475043fe61d16c57e4029b0c62b9eae0f19d6bf28dcb40de3b6417be66",
      "text": "（虚张声势戴面具，终究不过同路人）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000046:dialogue:000": {
      "source_hash": "sha256:37504d772c9fd3a744ed4df26d957b091fd59f6ab8b3deb4af2cce1c996dc2da",
      "text": "（……嘛，说到戴着面具，\n我好像也没资格说别人呢～……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000016:dialogue:000": {
      "source_hash": "sha256:606e1ca990438378af95d29c211aa3584b19ad08ac25c921e924d3cd3342be1c",
      "text": "……视客无个性，观己亦如是。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000025:dialogue:000": {
      "source_hash": "sha256:360d1ed98283bb89bf5e659abb6e4244c390a037b366ac6b4647cb330210809d",
      "text": "（刚才虽然那样想了……\n但伪装自己的，我也是半斤八两）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000028:dialogue:000": {
      "source_hash": "sha256:7834e6d2accfdf778d4b28f6c1a2825f22546579d82d6c18122cbcffd879be7b",
      "text": "（今天也是，带着虚假的笑容附和着前辈的话）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000031:dialogue:000": {
      "source_hash": "sha256:cd60752b18d2e26566ed5e051ff20883497eed9f37604c5ed0127c28b863865c",
      "text": "（察言观色，装作惊讶、装作悲伤）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d5c4bc0e76eba9da70aac2857af596734ff3b15c226d0fe8bc17b06e6b427c9f",
      "text": "（那说到底，\n不就是没有展现出真实的自己吗……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:fef7d417cb1b6c0b206d929523360ff2c6e484236ca3b626ea69b940ac6357fc",
      "text": "（……是个非常没有个性的人呢～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000045:dialogue:000": {
      "source_hash": "sha256:cf2dc4f7c24cc4c9b83e4e7f6d682c83de6459272064ae5c4d9a93d2421b5ce4",
      "text": "（倒不如说，刚才那位客人，\n还能清楚地说出自己喜欢的东西）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_d:cmd-000055:dialogue:000": {
      "source_hash": "sha256:4eabece44e698171e0ced3e2a4d3a114c7d4feaf9585176ba31dc1c5a78a728d",
      "text": "……比起他，我还要没个性得多呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000018:dialogue:000": {
      "source_hash": "sha256:809c4bc548a4d6436a9691e6297fa6826c5819e108571cfe64fd0438e1fdaf91",
      "text": "（但是，如果我展现出原本的自己的话）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000021:dialogue:000": {
      "source_hash": "sha256:f1d16ebb8638554593592ba7b44846dd7032a97110724fc32d4d89a9e3bcffba",
      "text": "（肯定无法像现在这样，\n顺利地在社会中生活下去吧～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000025:dialogue:000": {
      "source_hash": "sha256:a10089ffa251623bb9df45baf46fd80cf9b819208f291254a6792e1e5c78635f",
      "text": "（毕竟我这个人，有时候会把心里想的事情\n就这么直接说出口呢……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000029:dialogue:000": {
      "source_hash": "sha256:b92a806ec6d585754845d860e13abc9bbc56ea2ed6d1446016c0cb4d423eaa9a",
      "text": "（在社会上，这种人是最先被讨厌的吧～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8fae78ef1362a68b8af6a79108317866d22579599d3562af235f60cbc43b0c5a",
      "text": "（而且，曾经也因此失败过一次……\n甚至和朋友也吵翻了）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000038:dialogue:000": {
      "source_hash": "sha256:af2882c198c7b4f66d65038c9648a233d1b46216c2b7ea62306e1bf04daccde6",
      "text": "（不与周围起冲突，赚取必要的金钱，\n过上平静的生活。为此……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000047:dialogue:000": {
      "source_hash": "sha256:81527c58643c52c7891e7ae75f9ba955de068028200ded5243270f230af3b8c4",
      "text": "……戴上面具伪装着生活，才是最明智的呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000055:dialogue:000": {
      "source_hash": "sha256:0a64827f83b6dd94166923537066e9fd06ca7a93fe9ed1bbdc5711281bde10d3",
      "text": "（今后，大概也交不到朋友吧）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000058:dialogue:000": {
      "source_hash": "sha256:f34f095356338d01668aac71d4aa2ae5914202526307a6073f6ca6f41755a930",
      "text": "（说实话，真的非常拘束）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_e:cmd-000068:dialogue:000": {
      "source_hash": "sha256:917bea71e7d094b3ac2c2ce984feaeb4ee0b5abc1ef1224e04efeef5603a496b",
      "text": "……嘛，也是没办法的事呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000010:time_caption:000": {
      "source_hash": "sha256:9c4e98b6d4831fcd6b9d47455ce034a1e65b984e33f3d0ffce87328550d137f5",
      "text": "想乐的家",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000019:dialogue:000": {
      "source_hash": "sha256:ebd8b2f41ad7ed11d53774bbdb474d5657541d7d97a5bd4c74c7c3d5d8a71794",
      "text": "……呼。\n去喝杯凉水吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000028:dialogue:000": {
      "source_hash": "sha256:1213614e4aa471505f98b0657cfb0893a9aaefc92115c30a5d461bcd6de816d2",
      "text": "（总觉得今天，\n是让人思考了很多的一天呢～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000032:dialogue:000": {
      "source_hash": "sha256:449499da0162a73bbcb575c8f96e26c23543f4bf4a39919d88eb5e119f61d2f8",
      "text": "（我……今后也会一直这样，\n伪装自己生活下去吗～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000037:dialogue:000": {
      "source_hash": "sha256:ec986e7ca39cdfefc5d104dd21c5c2a21ba51b7c6beaf77e6245195391a98863",
      "text": "（大学毕业前的4年……\n不，大学毕业之后也是）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000042:dialogue:000": {
      "source_hash": "sha256:fc754d00943c34302c6b85e8beb1e56855d2af3b8e31a0e1eb334f08e216828c",
      "text": "（为了平稳度日，心之所想、\n情之所感都绝口不提）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000045:dialogue:000": {
      "source_hash": "sha256:8c9ed84be33e1f950f3b8e5204b456f1627993031e518aeb13717972c6375713",
      "text": "（只是一味微笑，假装成一个好人……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000053:dialogue:000": {
      "source_hash": "sha256:379f6033e7cae08a9551da4b013a444c14c11fd9ede4397e0d4115a7dfac4714",
      "text": "己身所行路，此道是否宜，思之自沉吟。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000059:dialogue:000": {
      "source_hash": "sha256:4515c807ca72104b865954ef1f622ea7de1c8ff95d9096f4ea4d6bf2476b7f38",
      "text": "……思考这些，都觉得累了。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000063:dialogue:000": {
      "source_hash": "sha256:7fccd18041e4e165506f102873674e24574b7e98ae2f97a596a1c92ee466ee0f",
      "text": "干脆，一个人去旅行看看吧～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000066:dialogue:000": {
      "source_hash": "sha256:324d14ccbb67e23d07ed27af80910160d12cc35c195b1fb2d8e097f514296014",
      "text": "去了不认识的地方，\n说不定能开辟出新的道路……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_f:cmd-000071:dialogue:000": {
      "source_hash": "sha256:88867857765f58458cde899e8a97ae17a11a1dad910e8ab667e14bf236bd71d7",
      "text": "那样，好像也不坏呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000018:dialogue:000": {
      "source_hash": "sha256:293673e43b2713e5a01799a736b2dede2a02181d0c16a64d494a28ff57131fee",
      "text": "我回来啦～\n哟想乐，好久不见。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000030:dialogue:000": {
      "source_hash": "sha256:1344d929de5b7df32c7fb52a36ecf0b5c14d327faa3324cf884dc8438cd55f7d",
      "text": "咦，哥哥？\n今天没有住公司啊～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:d1d37cd80ec6549e30366da60090b4c0acb97eb406cfdded97ab7c6387dafbfe",
      "text": "嗯，项目总算告一段落了。\n三天来头一次回家啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000037:dialogue:000": {
      "source_hash": "sha256:9e1f26a5340088f71d937f991bf35ac962eb31d6aa374347cb5fb3aafaa87467",
      "text": "嗯～\n工作好像相当辛苦呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000040:dialogue:000": {
      "source_hash": "sha256:01ddbed24d75a3025685c8fbd5aa5266ae419975192722f2bf08055b9d5ee84c",
      "text": "嘛，毕竟这次被委任当了组长嘛。\n忙也是没办法的事啦。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000043:dialogue:000": {
      "source_hash": "sha256:bff59e8837644e29249f2d771f133833ef005f97d2d604db25b391859ab5de17",
      "text": "这样啊，辛苦啦～\n不过，既然如此……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000046:dialogue:000": {
      "source_hash": "sha256:d1bb8e7eaa871e6f885741ca3ebdfd82e3e89c70df0cd0e5d78feb2649de9b6a",
      "text": "总觉得你看起来挺开心的，遇到什么好事了吗～？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000050:dialogue:000": {
      "source_hash": "sha256:f8227eacbf9b06ea580fa08ec3ccf072f9d03557972eceaca797105f023797a2",
      "text": "噢，工作上遇到点事。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000053:dialogue:000": {
      "source_hash": "sha256:b937a70300ea3b1a5845b15bdc466d76e30c76e6262ebf26f536643972a6dcff",
      "text": "今天，我跟一个偶像在同一个现场……\n那孩子，可真是有意思极了。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_g:cmd-000057:dialogue:000": {
      "source_hash": "sha256:eea37ca1a3744eb356e9dac54e9f37e041be52e858430f653f041c9f5b56565b",
      "text": "……偶像～？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000018:dialogue:000": {
      "source_hash": "sha256:1413523225e7b05076e1887a0c6909e079d9be99ecdd2654f54e3b6a302f43a8",
      "text": "为了新产品的宣传，\n办了个小型的脱口秀……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000020:dialogue:000": {
      "source_hash": "sha256:e7549836664c7433a40c96556712522aba3304d6eb4fdbcca232c5a804b4de60",
      "text": "负责的那孩子，特别有个性。\n简直有趣得不行。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000024:dialogue:000": {
      "source_hash": "sha256:18136446bb679ef3554bb454ce14a44bc7c7c74d103c22ae00f9adf0bb349b2f",
      "text": "有个性……\n就是人设很鲜明的那种～？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000027:dialogue:000": {
      "source_hash": "sha256:7f394d90f0ff57b4ef060bf6e6847f049b2924d965c62f9179bfedd1512ee6f7",
      "text": "嗯～是啊，有点天然呆？大概那种感觉吧。\n接话的方式，稍微有点奇特。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000030:dialogue:000": {
      "source_hash": "sha256:ec40b636d68b9ddb58e438a2b281f1fb4a9a372f3aa767c70f61d6959ee109d8",
      "text": "嗯～……比如说呢～？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000034:dialogue:000": {
      "source_hash": "sha256:a5581b6cea524243bb8107e36ad07c87628eb95d7d6e014079c237d016ef43db",
      "text": "比如把重要的商品名念错啦，\n把主持人的玩笑当真啦……嘛，各种各样吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000039:dialogue:000": {
      "source_hash": "sha256:836309edec50caf427d88be7be325266e4d20f702a8e3c6632214d0cd19eccaf",
      "text": "呵呵。偶尔确实会有呢～\n让人想吐槽“这都能搞错？”的人。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000042:dialogue:000": {
      "source_hash": "sha256:b0069264f2938a9d268e742a00bfbf089c213795b80789d2c8b8f26331bf15d0",
      "text": "而且那种人，往往完全意识不到\n自己搞错了呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000045:dialogue:000": {
      "source_hash": "sha256:f4e78e31b4f200f643a8ab8fed2fce40d8cdda671a87bf2cddf59db599b744ac",
      "text": "不过，那样的话，\n脱口秀没出问题吗～？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_h:cmd-000048:dialogue:000": {
      "source_hash": "sha256:8b92dc667f891c2d17b81556da52e2bbbd33635678d87b45c1d2eb5b1908c8c6",
      "text": "我一开始也担心会变成什么样呢。\n出乎意料的是，全场反响热烈得很。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000018:dialogue:000": {
      "source_hash": "sha256:f5452ccc0f4dd5fcdaded67ab0feb38cfc0bd6563b53c102938369c0d39fa5a7",
      "text": "……之后也是，只要那个偶像一回答，\n大家就很开心的样子。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000022:dialogue:000": {
      "source_hash": "sha256:0217c280acfcda20d06660082015f7093ecddb5b4ce63ea0cc22341e148171fe",
      "text": "多亏了这样客户也大喜过望。\n工作可以说是大获成功了。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000027:dialogue:000": {
      "source_hash": "sha256:b33708c17e79050f3bbf136c4c5ba0683b649bea78145c7aa1140e2f82af28d5",
      "text": "哎～……\n我还以为肯定是搞砸了呢～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000030:dialogue:000": {
      "source_hash": "sha256:0f87b1de1f663ecd12b2f4cde001ad7c732b0c01f001244d3e7c41ff0c6e0985",
      "text": "啊，我也一度不知道该怎么办好呢。\n没想到反倒是那种个性完全切合了氛围。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000032:dialogue:000": {
      "source_hash": "sha256:b893e560f3f304d86669ad541f77e7b89ab769f74c54b7e20e3ba3a0a05232d0",
      "text": "挺新鲜挺开心的。\n如果有机会的话，真想再合作一次啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000048:dialogue:000": {
      "source_hash": "sha256:527f9a43f9074625b45424dcfb1182dd930659c74c29b9a7fa9064ea92e62634",
      "text": "（……个性受欢迎，吗～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000051:dialogue:000": {
      "source_hash": "sha256:5d9ea634166fe71b5197e990ff5f48009b40ad82ad7c1be07eb959cbbecf22b0",
      "text": "（竟然还有这种工作，我之前想都没想过呢～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000055:dialogue:000": {
      "source_hash": "sha256:56de8aa5a1be141d9a736bebed8c7256115ff79e323f38fbbb6eb4070dee672f",
      "text": "（不过，确实。偶像的话，\n也有各种各样类型的人在……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_i:cmd-000059:dialogue:000": {
      "source_hash": "sha256:7bc6afcff578c38bbf167b0c240c42f50b32d4b4584319eb356aa0e79641937f",
      "text": "（虽然至今为止从未考虑过，\n原来如此，还有这样一条路啊～……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000015:dialogue:000": {
      "source_hash": "sha256:426b3447f7435fe806ddf41e85751646dbd090fbdfc236c7ae1ffcef10211744",
      "text": "（刚才从哥哥那里听来的话，\n一直萦绕在脑海里……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000019:dialogue:000": {
      "source_hash": "sha256:bbba6275bf3b380d90e7ced78bb3f703c269d9090345d40d4efade483ac21e8b",
      "text": "（如果是偶像的话，真实的自己\n也能被接纳吗～？）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000022:dialogue:000": {
      "source_hash": "sha256:bdd28053983fec62c14cadf32a95e2cfb3c969a612e072c30721f1508abd5be6",
      "text": "（不戴面具，展现真实的自己，自由地……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000024:dialogue:000": {
      "source_hash": "sha256:5da45d79c44f5891b649d6c49ea5e1448cb1070826293085949c9a27d2425c39",
      "text": "（要是能有这种生活方式的话，那就太理想了呢～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000034:dialogue:000": {
      "source_hash": "sha256:a97f9225feeee7ba3acbdb3121f7288a77c700fa8662250d1ab9032f5c6a8a97",
      "text": "那个。\n偶像……试镜……搜一下。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000038:dialogue:000": {
      "source_hash": "sha256:b3c1998ece260649b09cd41091499bcdc6665e6be5e0ea10c5099f673570109e",
      "text": "……315 Production，试镜举办。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000041:dialogue:000": {
      "source_hash": "sha256:d76cd6b04df228b665c741cf7786ef6b18964661ae43ec64ba8e7875fdbd9e77",
      "text": "这家事务所，近期有试镜啊～",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000044:dialogue:000": {
      "source_hash": "sha256:43472f0b533a3963033bfca2268e457bae588138fbfe8c3e09053e968c19ae34",
      "text": "要不要试着，报一次名看看呢～……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000054:dialogue:000": {
      "source_hash": "sha256:e05969b405b5530fd2ea0e2e2bd9bf6df7d72d5cd115010b977b2178c0ca058b",
      "text": "（……啊。好像有了……）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_j:cmd-000064:dialogue:000": {
      "source_hash": "sha256:d30bd7bf8906a88fc6951529f446893535e64e7ca04862491ab32b165ba1a3a4",
      "text": "投身演艺界，顺应己心以立身。\n呵呵，做出来的水平还挺不错的嘛～？",
      "status": "draft"
    }
  }
}
