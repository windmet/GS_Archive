{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_033_23_5_02_033_23",
  "source_raw_hash": "sha256:952462486410fc5bf6027eb10b44ebaa8fb25d718eb228ef6e83a35744346850",
  "entries": {
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b3da042a78cf169ddc2814fa6e3ea4958ef6c59ee3a9dde95834fce3e392b647",
      "text": "●●●●プロデューサー，这个给你。\n这是情人节收到巧克力的回礼！",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:d4dab70710f801580a4009ea6a950e96b1cca3091124170debf3d852d2a9bc70",
      "text": "我买了制作人大概会喜欢的点心哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000036:dialogue:000": {
      "source_hash": "sha256:c8549151cd1fd3c29a29cee58ca5771d13f3176beac1417d28e6253afb2ae559",
      "text": "（哥哥也说过要自己选嘛。\n这就是收到巧克力的男人的担当啦！）",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000045:choice_short:000": {
      "source_hash": "sha256:0aebeae6fffc917444766acc3225e228ff92767b8240748185ed3029fc4f710d",
      "text": "你挑得真准呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000046:choice_short:000": {
      "source_hash": "sha256:482d21d783b621b6c84ffebe383e9ba5cdbb1c8d695f72a0e09a777510479d49",
      "text": "看起来非常美味的点心呢",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000056:dialogue:000": {
      "source_hash": "sha256:1884cf8d7725ecbb96a7f7fa40f510d5c885b3814e2e28d784ee8de2a68759a7",
      "text": "是吧！？\n我也觉得非它莫属了！",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000066:dialogue:000": {
      "source_hash": "sha256:1e3b3deb52ae2b46271ca37264670da42acd28dfa8169c3c34d672cb57c034af",
      "text": "嘿嘿，不客气啦！",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000073:dialogue:000": {
      "source_hash": "sha256:a052e506fb60bb96b609ea1239f43caf75e41ca1802d1e6cfcc5c294fcf00f66",
      "text": "对啦。作为情人节的谢礼，今天\n要不要一起吃我带过来的点心呢？",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000082:dialogue:000": {
      "source_hash": "sha256:ead9ca9172fe97ee144bca0dd9410a571840e1a9f4984a00a857b0a0bd4e671b",
      "text": "诶！？……啊，不过！刚才给你的那些，\n全都是制作人的份哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000086:dialogue:000": {
      "source_hash": "sha256:49ba7ac3a7ee39191c5facd1b5ccd2fcb11703ccd1f5465c229fbef8b0d82b74",
      "text": "嗯。这是我自己带过来的、另外的点心哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_033_23_5_02_033_23:5_02_033_23:cmd-000094:dialogue:000": {
      "source_hash": "sha256:36b2edd4dc82f68e4c8bfe2b6bae9f2d166c767def5450821a1dfaaf6402ac61",
      "text": "那样的话，我就不客气地尝尝啦。\n谢啦，制作人！",
      "status": "draft"
    }
  }
}
