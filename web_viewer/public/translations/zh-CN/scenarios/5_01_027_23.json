{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_027_23",
  "source_raw_hash": "sha256:ab7f07660d80935e7ec047d1b3ec325b3907e2dd48a80b4c3514c206dc686591",
  "entries": {
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:bbdf29fea388d89e1ef08e380631f0968380ecfbaa8832d7044a430f1b8baaaf",
      "text": "今天的商讨就到这里结束了。\n辛苦各位了。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:342714fad987abe99503f1832de8e2ca7def9322ce53eafa98a6bcb4b0d56df3",
      "text": "啊啊，辛苦了。\n谢谢你。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:afeb2a2c8a3d6cc8965ca13150b9321fd804b480b3275ee4d9c229ef1ddd0b8a",
      "text": "……那个，制作人。\n现在能给我一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:5b17af90472f5e5065a0766f163f31be601ca6c1e644a763a96572da7ce9d6d6",
      "text": "好的，完全没问题哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:89ee73763bf952dfe7a9bf3868ca35afedd7673dea0af7f2e2b4424a7d478039",
      "text": "太好了。\n那么，请在这里稍微等我一下。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:5d36d11b236a8f015692716452b0bd871efcd59835352b09cbf938caf0126b2a",
      "text": "总觉得，有一股甜甜的香气……",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000052:dialogue:000": {
      "source_hash": "sha256:24664e0b8f64156f6883232029453ef93576e170fb89833080389cae879cfa00",
      "text": "久等了。结合情人节的气氛，\n我冲泡了巧克力风味的红茶哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:bba9b53fae488561c9c6beaace39a482512dc5137726ddb6f608e1c178880ed8",
      "text": "去年，我们不是约好了\n要请你喝锡兰红茶吗。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000061:dialogue:000": {
      "source_hash": "sha256:44dd323647d1121c325ce45124be059f0fd51899a0f4d11467327ed746481cbb",
      "text": "因为找到了美味的风味茶，\n我就尝试调配成了甜点茶呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_027_23:5_01_027_23_a:cmd-000066:dialogue:000": {
      "source_hash": "sha256:0ce6de2ce5f91c8ea14bd3ced7021dea1e643c29088190a80862abe33310ae86",
      "text": "希望能用这杯红茶让你好好放松一下。\n请慢用吧。",
      "status": "draft"
    }
  }
}
