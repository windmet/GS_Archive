{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "039mcr_401_2_4_039_01_09_b",
  "source_raw_hash": "sha256:5e42e228e1d41a3fbd886cbdd897c7a358507bceab5f9acbb2059683c89e2fbf",
  "entries": {
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:062b45ac5eac268060d8a945d129dd7d38c3ae47333cdd539a64ddc836255a11",
      "text": "师父，辛苦啦！\n昨天的试映会多谢你了。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:72c3537328b28c550991c0aa1edfc9ec8134f27a098e7f93203db374ba919b40",
      "text": "看过之后，当时的拍摄场景就像昨天的事一样\n历历在目！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:1d5827a8cd5a032e625753fa08df6568836dd16d76279ddf87bbe0c4af337acd",
      "text": "不过，那个外景地真是个好地方啊！\n虽说是工作，但能去上一趟太棒了。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:e536b546d31cd87bae95e373ed0c6109a4a9401567dacd3a2300518a2e483610",
      "text": "是个很棒的地方呢！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:78c501113ccc8105d44b2bc7008c5686330a44b383cecb977173580b0afe3438",
      "text": "旅馆和店里的人，大家都很亲切呢。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:73c7ea4d64f2e8fbbd76769e35852c3ddadc1ce2558915eb926d8b1b45c58216",
      "text": "同样身为生意人，\n有很多值得我学习的地方。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:b38e2df8e280b64d3326d714f0d46de610f92ab143935193e25a87635f002c80",
      "text": "下次我想作为游客，去那家旅馆住一晚试试看。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_b:2_4_039_01_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:d6ff708766f4138a54df4dc7c35123e97b44103a794accb63f9e7fbea1e25cd1",
      "text": "节目播出完之后，我打算做做计划。\n那么，再见！",
      "status": "draft"
    }
  }
}
