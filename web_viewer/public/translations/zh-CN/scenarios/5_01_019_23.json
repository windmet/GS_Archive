{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_019_23",
  "source_raw_hash": "sha256:48c62c760096aaf60d4a57527020c148073bdf30e9035b7cb7dae1a30d3d8f13",
  "entries": {
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:323803d429a3b04a8f9d8d9c7c714ba6a960d1262d985cd60731fe406a3b5014",
      "text": "感谢你带我参观街市。\n多亏了你，度过了一段愉快的时光！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:9a35bdc7445b1f61e8482b7ceed4fb7885b7db0b9488e949c1f96e552eeb08a9",
      "text": "彼此彼此。能陪我散步，\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:2650f408c85eb1eed846dd1804dd96ee4cfbb9a37e55b4635b52387861750af5",
      "text": "工作早早结束固然很好，\n但今天能与制作人共度一段意料之外的时光，",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:ba66da9db60871cabff8c93522812fdc6b42ae64ce34f3f2cebde17acb35195e",
      "text": "真是度过了非常美好的一天。\n……制作人，现在还有时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:dc1cb566ab0f7a7f7a8506ca07751ef50cd8a9ffd722027ee3b53cda49d95246",
      "text": "最后我还想带你去一家店。\n要不要去那里稍作歇息呢？",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000040:choice_short:000": {
      "source_hash": "sha256:5c3b132802bb46b5075f123a343b55c77476da4f87c3732813232320b1df883c",
      "text": "时间上完全没问题！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000041:choice_short:000": {
      "source_hash": "sha256:bb7c644ba1859b5b9024beb1f06c807a4d2b65da0a3b1b574e537f3a4d47648f",
      "text": "好的！我们去休息吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000052:dialogue:000": {
      "source_hash": "sha256:53df4caeb78e770ae0552815827639821f0e907226c73e752cc447b75dc5fa4b",
      "text": "那么在那边，有一家我相熟的和式点心店。\n就去那里品尝茶水与和式点心吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000056:dialogue:000": {
      "source_hash": "sha256:c972ba0c755e7a5056bd55eb871d4ce5f387fb495f557e8febaddc4d217470c5",
      "text": "九郎先生相熟的店铺，很期待呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_23:5_01_019_23_a:cmd-000063:dialogue:000": {
      "source_hash": "sha256:d0ca8a15e50099ff3ac6cd0b851e27cc6d95c04fc0a85bdcb098ec0fc499bf4b",
      "text": "那么，请随我来。能与制作人\n一同品尝，我也深感期待。",
      "status": "draft"
    }
  }
}
