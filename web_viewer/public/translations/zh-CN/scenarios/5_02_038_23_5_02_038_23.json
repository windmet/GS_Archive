{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_038_23_5_02_038_23",
  "source_raw_hash": "sha256:b49cb3f885442303e62d9edb3d01ff96c27e9a287c63192ca6e210cd744af96f",
  "entries": {
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:5a08572ba3474ea86063030e497df05a9e58aa0ffa6866c68d3b68d8dfafe1ef",
      "text": "●●●●プロデューサー。\n那个……能占用你一点时间吗。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000023:dialogue:000": {
      "source_hash": "sha256:0625506305e8d94375665e6e9553760750b80087acc587b86dcab69d265eecfd",
      "text": "这个。\n是前阵子情人节的谢礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000026:dialogue:000": {
      "source_hash": "sha256:6f3c5e904acd778247b812522027063b16da20582c743daabbf5e62747d055a8",
      "text": "武先生，非常感谢！\n这个袋子的标志……是体育用品店的吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000030:dialogue:000": {
      "source_hash": "sha256:cf0e9fcee8aa80c0c217a899942f97796fec390ac0de842dca94d4dd3aa3f08e",
      "text": "啊啊。里面装的是运动护腕。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000034:dialogue:000": {
      "source_hash": "sha256:1f888871af802f3231dc47e9330b6b2b2ee0b8829d990a87732115d89826bdbb",
      "text": "挑选这种礼物，\n虽然我不是很习惯……",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000038:dialogue:000": {
      "source_hash": "sha256:b8bb91680f767a641563c24d47d1a11de3fcecc5915ed1cdb0bb7f8c1ca985ff",
      "text": "但我以我自己的方式，考虑到你会使用，\n试着挑了一下。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000043:dialogue:000": {
      "source_hash": "sha256:3170dd4c6a523c257e3953e636e008fb58538c3d101c4f63785d1caf19a5069c",
      "text": "这个厂家的商品，我自己也经常用。\n使用手感我可以打包票。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000047:dialogue:000": {
      "source_hash": "sha256:bd2f4113c384319eaf3ede194beedb5be4269b5de8ce6ce6431410e7568ae219",
      "text": "要是你能喜欢就好了……",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000051:dialogue:000": {
      "source_hash": "sha256:a9dfc6452053474bd3872e3939148f4e9f51c0c319d3769b271806323e1c619f",
      "text": "真高兴！\n我会好好珍惜使用的。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_23_5_02_038_23:5_02_038_23:cmd-000056:dialogue:000": {
      "source_hash": "sha256:8d6267c4a2167b2650a92b542d8f4b9569ce3eb0d6c6edad616e3f4da59843b8",
      "text": "这样啊……太好了。\n要是那东西能帮上你的忙我就很高兴了。",
      "status": "draft"
    }
  }
}
