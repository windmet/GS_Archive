  "entries": {
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:2650cb440a444fbe6cda2986797187971689a43a70dc79bcb9bfacac455beb19",
      "text": "制作人！\n我，皮埃尔！",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:53f7a76992f364978bc8d88324fbcfab8368571829b085221b2aa98de3f6a48f",
      "text": "今天的工作，超级开心！",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6d891ffe7226fc6ca68d1e1b8296c58f96aaaad247ebdd6ff296ea23f6d0dbba",
      "text": "AR，很有趣！",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:091243a7e6f0eca2f436809a633fed7750db72389d161796e8d99c1827f8d2f5",
      "text": "粉丝大家，就像在旁边一样，可以拍照。\n一直在一起！",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:8cabd6356e2aeffcbf53a6ded0d34f0fca1ca82b922c2e4906ce65e39e0553ae",
      "text": "粉丝大家，一定很开心。\n那样的话，我也高兴！",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:9f3173b0c04ce15967a7d1c79f331c555c76e7c0193bd3d0c9938ea18e3050b4",
      "text": "制作人，也再一起，拍照吧！",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000018:choice_short:000": {
      "source_hash": "sha256:3d3d1e7b25bb915d787fd7cb1a86644b36449fb8fa882e4ee5500a838883e60b",
      "text": "一定！\n一起拍吧",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:2d17884653af8dbab9df32ec0f79ef40fd866d31b3be599a86aa0316e9d975a5",
      "text": "当然啦\n大家一起拍吧",
      "status": "draft"
    },
    "story-text:v1:010pie_302_2_3_010_02_09_a:2_3_010_02_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:438a702d516f27e52be7f8a88540f1ca4966ac507fa2dd07981affa904e7983c",
      "text": "哇～♪约好了，哦！",
      "status": "draft"
    }
  }
