{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_000_22_5_02_000_22",
  "source_raw_hash": "sha256:93ac2c8534d8f7fb20f09275b939f755ef399e87f09d6097d316a5204d84ae0f",
  "entries": {
    "story-text:v1:5_02_000_22_5_02_000_22:5_02_000_22:cmd-000014:dialogue:000": {
      "source_hash": "sha256:ad18bb1c4c9547975f838ab499fd111e8d37dd9f908a2ff94f6947518f30d0b6",
      "text": "●●●●プロデューサー，辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:5_02_000_22_5_02_000_22:5_02_000_22:cmd-000016:dialogue:000": {
      "source_hash": "sha256:dd147df08cc7b6a4bcaae26f7ba5945789769f5e679046f1f4ac6be3ce98149d",
      "text": "辛苦了。总觉得你好像很开心呢。\n发生了什么事吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_000_22_5_02_000_22:5_02_000_22:cmd-000020:dialogue:000": {
      "source_hash": "sha256:703aa7152966ee9a819a297b2226b9befdf6db63b080ccc550636efea0bb3f3b",
      "text": "可能是因为从偶像们那里听说了\n关于白色情人节的事吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_22_5_02_000_22:5_02_000_22:cmd-000024:dialogue:000": {
      "source_hash": "sha256:9ff2e984af42318f48386d68521f1fcde330e6126c381807c4faa0b4f5615cb3",
      "text": "他们好像正在为了制作人，\n准备情人节的回礼呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_22_5_02_000_22:5_02_000_22:cmd-000028:dialogue:000": {
      "source_hash": "sha256:9ee0447ae63035a2f814d1ab283fd880069e367332a2f488ff4eefeeb64d1e6e",
      "text": "请度过一个美好的白色情人节哦！",
      "status": "draft"
    }
  }
}
