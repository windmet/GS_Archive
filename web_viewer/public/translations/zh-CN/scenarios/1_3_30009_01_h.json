{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30009_01_h",
  "source_raw_hash": "sha256:0b7f774b23309d281397e2310fb183a676be8651b29082fe6f59cf20259a139f",
  "entries": {
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000012:time_caption:000": {
      "source_hash": "sha256:205b537162a622d6c13223069f400d4e8d55bf55b3cd45c60b78e4ab8e51e99c",
      "text": "拍摄当天……",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000024:dialogue:000": {
      "source_hash": "sha256:108a157ba4354742af647b4922cf9757a2e3d34bf1b731c9b082713216edf4d3",
      "text": "那么，我们差不多该出发了吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000034:dialogue:000": {
      "source_hash": "sha256:748b129d826701ec346ac04881323b0c42f68e2713b43269db6bba91fd2f9af0",
      "text": "哇啊！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000041:dialogue:000": {
      "source_hash": "sha256:dfe54bcf0cb84dbea2677f305a5e7ee38fa0ab32e8be2f0a4e384d776adea45b",
      "text": "（摄影师被台阶绊到了……！\n糟了，得接住他！）",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000065:dialogue:000": {
      "source_hash": "sha256:c2c4540a27586b0a5f27db7407c3bbda99720dab3d3ae57009a10feb4c57d79e",
      "text": "呼……\n您没事吧？有没有撞到哪里……",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000075:dialogue:000": {
      "source_hash": "sha256:698bceb8b2cde22b3e18c7997b79111a01188443db7d58daa8772fe9dfeca06c",
      "text": "哎？",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000078:dialogue:000": {
      "source_hash": "sha256:15dac16de2de1d6247060c486711f1bd148a624e19fcc131b621c35de0a9e608",
      "text": "抱、抱歉……\n刚才那个角度太难得，一时没忍住……啊哈哈。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000084:dialogue:000": {
      "source_hash": "sha256:dc58eb43cc2115e1f7893dd3caac16095c529425ca5d132b031be1015172a00c",
      "text": "我没有受伤，没事的。\n而且，拍到了绝妙的好照片！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000102:dialogue:000": {
      "source_hash": "sha256:92d1d87daf79663f03d96d0a27bef0d6d22a8f5217c9bef3c42beb3ee3a71abf",
      "text": "哈哈，那就好。\n我也很期待照片的效果呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000105:dialogue:000": {
      "source_hash": "sha256:bd8fbfe139a0df6c46832451e40c6d4ab49fa67e7ff3c2973d4ec1528a6cab6b",
      "text": "好的，刚才真不好意思。\n非常感谢您。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_h:cmd-000109:dialogue:000": {
      "source_hash": "sha256:a1a5f40dde307f3fc843a1d83e75cff43bf510715d1cca8eb5c50457e885b745",
      "text": "那么，收拾好心情重新开始吧！",
      "status": "draft"
    }
  }
}
