{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_015_04_b",
  "source_raw_hash": "sha256:e3b6304f56e20142af847b60eb087c50d3a9b8dcc7d4937fc3c49e76b470ed0c",
  "entries": {
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:08188732fa542fe9e68b650f3697a60caace8ef559f4ff6631d69736adef42f8",
      "text": "啊，如果此时此刻能够感受到大海的雄伟，\n想必，我们的紧张感也能平静下来吧……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:45fc96844aa2518551db3b2870e14af1dccd0d548a7bff8f4e138a878f33bb69",
      "text": "您不也是这么认为的吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000037:dialogue:000": {
      "source_hash": "sha256:e60059fc25197f4784f5986c26e910123a533f121c6db5079ae017eb0ee38b76",
      "text": "（说是强敌……不如说，是个怪人吧～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:a5386e6330a4ac69058ab075cd1e2367eddf1241e24952b33a13634dbbdfa859",
      "text": "各位，让你们久等了！\n接下来带大家前往试镜会场。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:607bcad3e58922ab3aafffda38c6c622f45bbd70b5bd891da3699dfa2f0fa8ed",
      "text": "请各位参加者移步。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000077:dialogue:000": {
      "source_hash": "sha256:6a582f96b41ccefbde0d3ac2f23930f735987da8033215894f055b2b1383bdf0",
      "text": "古论克里斯先生、北村想乐先生，对吧。\n今天请多多指教！",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000079:dialogue:000": {
      "source_hash": "sha256:4696e084cc9377e64e3bb4c2f8853757cb6890eed0735e572e8ee231722c420d",
      "text": "那么，首先请做自我介绍。\n请古论克里斯先生先来。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000092:dialogue:000": {
      "source_hash": "sha256:8b433b4db222a1262dc66ded1a473c7d9afcf174995e88791cd01ad215b69884",
      "text": "好的。我叫古论克里斯。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000096:dialogue:000": {
      "source_hash": "sha256:9c857d8b43dacc6dfe3fb94464baef1c9c2fb559cea4bfef205051f9366cddc0",
      "text": "在大学担任海洋学的助理教授，\n一直向学生们传达着所深爱的大海的魅力。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_b:cmd-000100:dialogue:000": {
      "source_hash": "sha256:7acd7e65cd314c99a71ff9e9d65cc85986d1eef86f807de39ac2211c861cbcfa",
      "text": "大海的魅力这种东西，说起来是无穷无尽的。\n但是，如果要重新介绍的话……",
      "status": "draft"
    }
  }
}
