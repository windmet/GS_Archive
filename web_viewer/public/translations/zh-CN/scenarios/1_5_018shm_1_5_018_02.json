  "scenario_id": "1_5_018shm_1_5_018_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000010:title:001": {
      "source_hash": "sha256:1b6643db706ad1d3a0e9ab1d1fabbebcb50042fbd575b97fe9638243b793d729",
      "text": "资讯节目出外景的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:ae54539b5036002bec5a4ba3b70fe7a2fe3a4f37363106264641e2676c506cf7",
      "text": "天气真舒服啊。比平时更能真切地\n感受到太阳的存在呢。毕竟是在海边嘛，这也难怪。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:f1e1c3adb14f69cac27bbba4f0899926727020a3a0bf247df613fa892baf5e75",
      "text": "今天的外景是探访港口小镇的隐秘美食，\n要在这样的大太阳下走很多路……没问题吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:b20cf406159ddbf0d29e5dda901721b606a716e8d82d9cfeb5209272d9476f2c",
      "text": "哎呀，没问题的。虽然我不喜欢大太阳，\n但既然是工作，可就不能挑三拣四了。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:e01fcef8f3a1c932a4ea88bf48cf29465057906225a34aa2c416896ef776e2eb",
      "text": "绝大多数的工作我都能拿下。当初这么说着\n接下这份工作的不就是我自己嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:6a3babad0cc521db2574fbb146a01bf03cede44fd1e0d1d6d9b76eee79ba0edd",
      "text": "所以，别太挂心啦。虽说能站在聚光灯下的\n工作确实更好就是了。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:77150a2f0fe376e4b30961476cf48b6e1bbc20e5bb5c2675cfffe59107c87c9f",
      "text": "好的。聚光灯下的工作，\n我也一定会多多为您争取的！",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:87e0605d74fe6e57ef73c6b4474f838db114a5f6c4780fcc8ea89333e5c7ab7f",
      "text": "就靠你啦，●●●●プロデューサー酱。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:929576e7ae425c7051272c7c887137f805c7b94e1f15f6491831e838d9258f79",
      "text": "好的。请交给我吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000050:dialogue:000": {
      "source_hash": "sha256:32a19844928d905da761dca33e2ade63d2c56a6265f0013b39ef46806efe1153",
      "text": "那么，为了让你更容易接到工作，\n这次的工作我也要去圆满完成了。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000060:dialogue:000": {
      "source_hash": "sha256:865827cf4d27719e52fde39f5e2db5cdd25081390ad49781b0898130c920ab1a",
      "text": "（正如翔真先生所宣言的那样，工作圆满成功，\n节目中介绍的店铺连日生意火爆！）",
      "status": "draft"
    }
  }
}
