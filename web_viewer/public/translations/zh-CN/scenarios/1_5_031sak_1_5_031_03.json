    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000010:title:001": {
      "source_hash": "sha256:2f0d5695761ed18bc99bff6663fd1c319269b847e5ca6da266c1963c2a92689b",
      "text": "出演美妆CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000018:dialogue:000": {
      "source_hash": "sha256:72fefbae38c5611a570f2959576d49b661791d897f4fdb1d2e07beca3bbdccaf",
      "text": "哇……！这瓶新款美妆，\n就是下次CM里要用的东西对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:0ef2844ef9361c97dec5b1ad0525e7cd0e6141575770fb90dc2aab4f1f52050c",
      "text": "是的。和对方碰头开会的时候，\n拿到了样品。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:782bf35f5ddeb408a91ea862b79b3a0788c29cddca5b02e0d59393cf7204eb6e",
      "text": "对方说非常想听听\n咲先生试用之后的感想呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e0e46736292865f7cc8ea8f5f3151c357ebd6bd0eb22702e5d13120a62ac274d",
      "text": "好耶♪马上来试用看看～",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000040:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "数分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:b982a9884eaf36f14ae63d44f461ae610547d3476283ebc3671b4eed3f1a962b",
      "text": "喂喂，●●●●プロデューサー。\n怎么样？可爱吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:33e36332b13c857d391ea72bd6bd4b238d96fe49359a5bf27190f05198eef258",
      "text": "明明只是稍微改动了一下妆容，\n给人的印象就和刚才完全不一样了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000055:dialogue:000": {
      "source_hash": "sha256:a8def3ce56aec0682012375fa6d4b650040ae69eea5b5149d4f672d8fcaf3de8",
      "text": "这个妆容也非常适合你哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000063:dialogue:000": {
      "source_hash": "sha256:3970cca6b5323f34a5959e0ea3f07c8ee83ab7d93dc430b4f256f10735b784c0",
      "text": "诶嘿嘿，谢啦——！\n颜色超级卡哇伊，显色度也超棒的对吧♪",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000075:dialogue:000": {
      "source_hash": "sha256:40107f089f053b1e0caa9dd1b14bd48cfa8241c5111f319723016b63fbdf7899",
      "text": "难得有机会，真想试各种各样的搭配啊～\n好，接下来试试和这个配在一起。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_03:1_5_031_03:cmd-000081:dialogue:000": {
      "source_hash": "sha256:a2ea0f3d4805d81c8e18320cc678b08e7fba0c7fa7101c2a4ecfbc327efc1592",
      "text": "●●●●プロデューサー。\n等化好了，再告诉我感想哦！",
      "status": "draft"
    }
  }
}
