{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "036rui_402_2_4_036_02_09_b",
  "source_raw_hash": "sha256:fc7f47959cf0aaf1b1841c996f5cacea8c4f21e8e085c0ec04368d0e743dca6b",
  "entries": {
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:ce9f792608ed49a70cadf1df7a2a2012dad067fe0d77b191416c183132dd8534",
      "text": "Hi！●●●●プロデューサー酱。\n我现在要去Mr. 山下的家，",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:c4b9d4e2a313eae37423afdaa31b39e730d356ef7956cb1c7e13197934ac3bec",
      "text": "制作人酱觉得草莓蛋糕和\n巧克力蛋糕，哪个比较好？",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:3fd51644f45af0a993bfc49186a57860f7fd0886bc319fa49918b63a1c1b4f89",
      "text": "我觉得草莓蛋糕好",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:f314ca9447fd6d8c272f9c2b2f6082b19d1effc80bd0e3a73464125715d4d2e2",
      "text": "我觉得巧克力蛋糕好",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:369069bc4458e7415c5bb65eb5c3a2c58ba31aa618b101d433f8b3f49061de17",
      "text": "Thanks！那就选那个吧。\n两个看起来都很好吃，我都挑花眼了。",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:d73a280fc76510dc0e9cb9dc722c0c9238797c13fe7b739e7ee82f61beb39930",
      "text": "看起来超级美味，\n真想和制作人酱也一起吃呀。",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:6189891ed0cb1f943d8ec02935dd4abcd652e724a63e8b5c4979e0a15893fc9e",
      "text": "对啦！要是跟制作人酱办火锅party，\n我也买同款带过去哦♪",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:e69a0b7626d6def6e4eabc67c5b04fa413613af970f26b98ac070d3395088638",
      "text": "虽然这次很遗憾，但下次一定要一起办！\n工作加油哦！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000024:choice_short:000": {
      "source_hash": "sha256:df4418f355e041d7a57864420220cabf6a8b994aaeac94f00b5ad4fb9088e0c5",
      "text": "好的！\n我会加油的！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_b:2_4_036_02_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:ec6abbf5650ab017baf49afee0af0ba26bb2d662419c84c3392d306889826340",
      "text": "嗯。等下次日程定下来了我再联络你。\nSee you！",
      "status": "draft"
    }
  }
}
