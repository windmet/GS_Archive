{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_006_01_e",
  "source_raw_hash": "sha256:fcbdd55f454c8ae09e4be78b81d9abc62da371f3f1cf491c3023fc8f62c7f456",
  "entries": {
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000019:dialogue:000": {
      "source_hash": "sha256:848f9a3c4e7a4c217cd03601d81c620ae27221ec9d513dfb1d70149865704cd8",
      "text": "让您久等了！\n请吃吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3d56ce28a1f85d968e574de0399e059e2143b1abc065cc0e18b2d6a3a08851c7",
      "text": "（刚才明明还是一副非常认真的表情，\n现在眼睛却闪闪发光地盯着饼干）",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000031:dialogue:000": {
      "source_hash": "sha256:213a13881cecae7164af64d6c67b9a41a0befa5d03fb55567494c25430ec3efc",
      "text": "谢谢你。\n那我就不客气了。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000039:dialogue:000": {
      "source_hash": "sha256:928b92780a66ee71be04ff8bab928a5aa10960acd7fa6bfb1ef9a37375576040",
      "text": "我也开动了。\n……真好吃！",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000045:dialogue:000": {
      "source_hash": "sha256:45252fcacb3df25eddef16d8522d1c976868ac80b92fcaf64912ebefbe099782",
      "text": "（翼先生吃东西的样子看起来真香啊。\n看着这张笑脸，就想起了初次相遇的那天）",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000068:dialogue:000": {
      "source_hash": "sha256:4c4aeae17119c3a7075ac297aa873a7a38e02f8711393e0a4e2387a0be51deee",
      "text": "（那时候，我也是被翼先生津津有味\n吃东西的样子所吸引的吧）",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000088:dialogue:000": {
      "source_hash": "sha256:2c0f6b8a0092e687ada7e82faf1758497bba58a44c71575897fc8722aec5c601",
      "text": "嚼嚼……咦？",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000092:dialogue:000": {
      "source_hash": "sha256:4d26150155163b4eec203c5215a5d9c699efde36a6b57fd811909f47a5d1f536",
      "text": "怎么了吗，●●●●プロデューサー。\n我脸上沾了什么东西吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000094:dialogue:000": {
      "source_hash": "sha256:c15b0820d844e8284486828a4502a8be8c97df4fda801fac847d54d4e42cc9e8",
      "text": "不，没什么。\n这个饼干真的很好吃呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000099:dialogue:000": {
      "source_hash": "sha256:724a514abdc00ba706ea201d92ef8992adbd233db9dd4f5be1e2d3c30c918bc7",
      "text": "对吧！制作人也\n喜欢真是太好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000106:dialogue:000": {
      "source_hash": "sha256:6bbb086a3c3f4d260df5e7b9bbc6f4f2facec6acc4799ce144a6d21bbaf49daa",
      "text": "还有好多呢尽管吃吧。\n咖啡也可以续杯哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_e:cmd-000111:dialogue:000": {
      "source_hash": "sha256:331d34592ba70dea0dcbe42f1442c7455ca7618b335aa002cfa9f85e25e37efe",
      "text": "这是今天的谢礼，请不要客气哦！",
      "status": "draft"
    }
  }
}
