{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_045_01_d",
  "source_raw_hash": "sha256:b2f1f3f41f4d2eb4461df2eee070c04e87888b366af55f864682e91cd7e0d662",
  "entries": {
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000012:dialogue:000": {
      "source_hash": "sha256:d0e452020e44e6c849890580aa864dc5513a36d8c7847c9c76bd92d69de5b835",
      "text": "借着父母和哥哥的力量，\n大学和偶像工作两手抓，随心所欲……",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000017:dialogue:000": {
      "source_hash": "sha256:72aa2eb23d95078abc7a4ecf4ffca9c878901c2fdbfc0c33e2b2e8e5a286cf8f",
      "text": "真要说的话，我其实是个很不孝的人呢～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000020:dialogue:000": {
      "source_hash": "sha256:ee80a1680e1269881778e499c68f6e6f58fc10a36b555196776884c09e5c1c58",
      "text": "哎……没那回事！",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000023:dialogue:000": {
      "source_hash": "sha256:46de408182263a326f159fcf5d6f4d3ae32008a82e7e0d035a35e402eeeeb572",
      "text": "无论工作多忙，想乐先生不都一直\n兼顾着偶像与学业吗。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000025:dialogue:000": {
      "source_hash": "sha256:f7923af9baffd52ad54ed76875bde09c5b2226873fb7d9f7fdf46a629fd5a415",
      "text": "虽说像这样制定了计划，\n但有时也并不总是能如期进行的……",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000029:dialogue:000": {
      "source_hash": "sha256:2ba4ac197add0b5a88a37cf94edf8d21a052770443ffbe806cccc0a17e859cad",
      "text": "……比如，我明明是个偶像，\n运动能力却比大家都差～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000034:dialogue:000": {
      "source_hash": "sha256:208a4ab7ae15389470efdb2c0df79d5ef357ebd838a51b34ae24e5279cb2fa5b",
      "text": "就像前几天的舞蹈课上，\n只有我一个人被留下来加练的时候那样～？",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000036:dialogue:000": {
      "source_hash": "sha256:b87a4e5326d0a7858188a45c2b37a31a0e5269a8289474ec9be3c56ca32374ac",
      "text": "是、是的。比如，\n就算遇到那样的挫折！",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000040:dialogue:000": {
      "source_hash": "sha256:47fe1e987cdb441bdb26377bf99d7ecdb46d4cc1c73e5a1ff533ad615a35c19f",
      "text": "能够一直兼顾两边，正是因为想乐先生\n在努力让父母安心啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000046:dialogue:000": {
      "source_hash": "sha256:78de4351f27e1828dadcd16cf9a7341d29d8e245cddb906dc43caa018b1ac6ea",
      "text": "……这样啊。我自己倒是没这种自觉呢～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_d:cmd-000054:dialogue:000": {
      "source_hash": "sha256:f6f797b53e22afe366a7cfcbcf65e05bb4b06ed58b7fdb6c3dbac4aebd44371f",
      "text": "（本以为只是做做样子，\n结果不知不觉中真的变成尽孝了吗……？）",
      "status": "draft"
    }
  }
}
