{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_027_02_c",
  "source_raw_hash": "sha256:13c83e2760bd2fd0f5c8bfd1c1f283bcc8e7298975ef132d665915093cdcd4e1",
  "entries": {
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000027:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "几天后……",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000051:dialogue:000": {
      "source_hash": "sha256:03b5f0919a1d7af48acbf858b211915e75e2385e08d536270e7c7aea1849661c",
      "text": "神谷先生，请收下这个！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000065:dialogue:000": {
      "source_hash": "sha256:a2a3355ade552f7d0561f0a8142d996095e38c6ef211439f0a40c1b8687221d0",
      "text": "这是……降临历？",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000080:dialogue:000": {
      "source_hash": "sha256:035d77fbafa2f4e51155f2522f4534c09d90aac15a809b81314b656cd538af89",
      "text": "是的。为了不让神谷先生忘记生日，\n大家一起准备的哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000086:dialogue:000": {
      "source_hash": "sha256:2c5164383f944cbc398f3c9bfe1a1b0374c57a96d5d3142adfcc2be56a94d5a0",
      "text": "本来是用来给圣诞节当天倒计时的东西，\n但我们改造成了生日专用。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000096:dialogue:000": {
      "source_hash": "sha256:aeb9e65044f6aa1e61aeb477a8fbc88682ef1ed900ca3a68f364de826ade334b",
      "text": "不仅是同胞，连吾主也一同炼成的\n至高无上的一品！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000112:dialogue:000": {
      "source_hash": "sha256:4a20434a6efc044a8491ce58092c9634c91443fb1d0dfc18acea68cd81fef51c",
      "text": "特意为我准备了这个吗。\n大家，谢谢你们。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000131:dialogue:000": {
      "source_hash": "sha256:a6f36eb7b9907ddd3756f0faaa65bb8d76a105e2eaaa28365aa3f4713fe7f9fc",
      "text": "像这样，每一天都啪噼地\n进行倒计时的话，绝对就不会忘了吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000138:dialogue:000": {
      "source_hash": "sha256:6444e8de3ab01235e900a7ee300d0fdb02addd92de8052ee21cfb2f382c8a544",
      "text": "到生日前一天为止，\n每天早上都要打开一个哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000153:time_caption:000": {
      "source_hash": "sha256:f0e7dee7459f09cce99ab9493a965de1c45f77d1ae28531c2a551de6cf7ef221",
      "text": "当天夜晚……",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000167:dialogue:000": {
      "source_hash": "sha256:16f9bd269805295658eaa5627976cd61b6eb3a713f6e431de9e60f706b8c618f",
      "text": "……这样就，好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000173:dialogue:000": {
      "source_hash": "sha256:b846fad65cf38490682c286052dc6f2464de4449da13a7b04d1f0a96eba1e5d8",
      "text": "不过话说回来，做得真好啊。\n能充分感受到大家的心意。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_c:cmd-000176:dialogue:000": {
      "source_hash": "sha256:da9d171ad5e59e657cc4a5eaf7446b36511360e2d25ddfaa428f99e1c899e8c8",
      "text": "明天开始，真期待去打开它啊。",
      "status": "draft"
    }
  }
}
