{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_j",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000029:dialogue:000": {
      "source_hash": "sha256:fac20b64025d974115fa636f458781bc61e98fdc803c243b8ee3ecfc881c35d1",
      "text": "……真让人吃惊。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000033:dialogue:000": {
      "source_hash": "sha256:1561770d857830373180d8253a015507381643114b55fb37e035cedfe7136033",
      "text": "烹饪手法固然利落，\n味道居然也达到了这种水准。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000037:dialogue:000": {
      "source_hash": "sha256:95778d75446be98a516130e756565e35c740b81f9a139c6c01e9b8478a438d6d",
      "text": "东云，这已经……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000047:dialogue:000": {
      "source_hash": "sha256:f003eca672cf1e90853d9cc624155ff846f8586f331ccd7c77b547c1c49131e7",
      "text": "（真是的。神谷可能捡到了一个\n不得了的人呢）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000066:dialogue:000": {
      "source_hash": "sha256:d8e553e7da482686506cbfe246ddc772336946ebd42504535b3b1af84a243f0d",
      "text": "阿斯兰先生，你合格了。\n今后就请多关照了。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000070:dialogue:000": {
      "source_hash": "sha256:0e189d5f3b0577c768eb8cac7e7dd2c6ceed901b9da03e3692fd3913c80f1fe2",
      "text": "太好……！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000077:dialogue:000": {
      "source_hash": "sha256:eb9cd056f27e8193822da31509f4b28a4f605baa40d50155f8789f73723866ff",
      "text": "唔、嗯！\n身为暗之眷属的吾，便借汝等一臂之力吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000087:dialogue:000": {
      "source_hash": "sha256:ac8e1e8144efa9de21bd392d38916b69420b1fb2405391b0d07a8ffd7925d72a",
      "text": "我这边今后也拜托你了哦。阿斯兰。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000101:dialogue:000": {
      "source_hash": "sha256:9fbcde8cb75446149506fd949f76a3388f110fcf0d313b5895a8f9e4f55a4b30",
      "text": "然也！\n呵、呵呵呵……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000105:dialogue:000": {
      "source_hash": "sha256:777488f9d482ff42a3133a72fd3793fd0543398c1d5a1180a704f92d0145dc42",
      "text": "啊——哈哈哈哈！撒旦啊！\n自此时此刻起，吾等之霸道将翻开崭新一页……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000116:dialogue:000": {
      "source_hash": "sha256:8498bbbb1b4e6a0a0cb7833a966bca0036cbdfb33be3489984b843bc9292e88b",
      "text": "请安静。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000122:dialogue:000": {
      "source_hash": "sha256:645c3295745fa09dac4d18dff9be8852f50ff95a6346f87c9aac623a9402eb79",
      "text": "料理方面虽然很倚仗你，\n但在客人面前请不要做出这种言行。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000126:dialogue:000": {
      "source_hash": "sha256:d2d9cff622a5d9f83a525d263e1379ccf82d084217d0be197736f8b7eaa7b519",
      "text": "可不能给别人添麻烦哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000130:dialogue:000": {
      "source_hash": "sha256:209197354e9ae668c782a62dd6f4c7e59eeb0c5ddab41e9ddf3b2c0116eaa793",
      "text": "好、好的……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_j:cmd-000141:dialogue:000": {
      "source_hash": "sha256:841bce7b4224b062a5df5c72c87563bc98b6c6db0cc560509fdc7c2addff216f",
      "text": "哈哈！\n看来今后会变得更加热闹了呢。",
      "status": "draft"
    }
  }
}
