{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_012_23_5_02_012_23",
  "source_raw_hash": "sha256:71b195926e82155e8b0884e2878ad9e334930cf2dcec32ca0df4c7f134080c10",
  "entries": {
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:d896430ab21832c533459dc8ddd5d5362b3cbae1df6cfffcb38999ca081eb8ee",
      "text": "啊，找到你啦。●●●●●●●●●●监督！\n今天是白色情人节呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000022:dialogue:000": {
      "source_hash": "sha256:b00e24bff0d612ee300090baef957ce840bfebc56446c7204d306850216f2a45",
      "text": "所以给，这个！是我送你的回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000025:dialogue:000": {
      "source_hash": "sha256:4201f4106470f4320876c86e358cf9726695057e45b96e9d97e4b268cdfee79f",
      "text": "非常感谢！\n信封……？",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000028:dialogue:000": {
      "source_hash": "sha256:2f730ee3f94cd4a65c613b476aa821e1cf283a0d054aa601918d7ac9e1cb10ac",
      "text": "看看里面装的东西吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000033:dialogue:000": {
      "source_hash": "sha256:0e093251fd227cc0cf864bd7a2c51b5bbdea9c906f207b6a8eb7e63fea02c679",
      "text": "……啊，是足球的观赛门票呢！\n这不是现在成为热门话题的那场比赛吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:900536d24cb803ccd03f4462d09dcfc734868bd2210e148d0bb6c6297f7155b4",
      "text": "答对啦！我无论如何都想和监督一起去看，\n费了好大劲才搞到手的！",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:f79a6eaea8f9f00960c28f4df4a6c5dc9a4d030f3edb1d5e95c9d3f6e59af943",
      "text": "要不要一起去？",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:af520d70334fc56ad58ccd86589478f98aa9fbb0ecda443b8427fb2c6ef10ded",
      "text": "好的，请务必让我一起去！",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000053:dialogue:000": {
      "source_hash": "sha256:f6064024483568e08489fc31baad515e5b95794104b1eeee38cac3874d61d620",
      "text": "太棒啦！\n不管是看比赛还是跟你一起出门我都好期待！",
      "status": "draft"
    },
    "story-text:v1:5_02_012_23_5_02_012_23:5_02_012_23:cmd-000058:dialogue:000": {
      "source_hash": "sha256:8bc05f5b57281d4194ba69b84a640be6af7be0a7904a87395725a1af75661f9a",
      "text": "要是有不懂的地方，随时问我哦！\n我会完美地为你解说的！",
      "status": "draft"
    }
  }
}
