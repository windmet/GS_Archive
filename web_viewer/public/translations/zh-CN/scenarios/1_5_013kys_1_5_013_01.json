  "scenario_id": "1_5_013kys_1_5_013_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000010:title:001": {
      "source_hash": "sha256:14fd89b7a19f4b8aa8730e29a8f8b5f08614a7147ee03fa112a265d4142fe800",
      "text": "综艺脱口秀节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:a4d15a998840328096e22f02323ad0fadd92d4e1a79ff1473d310a73419098be",
      "text": "享介先生，节目收录辛苦了。\n聊天环节聊得非常热闹呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:5d93fbd642c87dfeb9816aab04985d446e00992e134ae88abbe58ff1be2c7f18",
      "text": "毕竟聊天主题是“家人的惊人举动”嘛。\n多亏有悠介的压箱底爆料，真是太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:2b9e0280bd55c3fbef9e5dce3e3f40e9d7c7acfbdabe2344c0ba82a5dd348d2d",
      "text": "他明明自己说要看恐怖片，结果看完以后\n不把走廊灯打开都不敢回房间。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:86fc5061d87b7234ed36c6600342cd5b5be57199da6ddd519cdbc9084cc40a16",
      "text": "还说什么房间里太黑了害怕得睡不着，\n结果最后直接蒙着被子呼呼大睡。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:8e7651b9749dbd8e009723477c79c42e66d7aacbc7a9c18077dda7590774eac2",
      "text": "听到他呼噜声的时候我可吃了一惊呢……",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:6fe084a59d827fab43aac804328c5244561e5a0a29a7cc464230b03a1349bbb7",
      "text": "确实很有悠介先生的风格呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:556844b8a993cd3c91c4cbe51e10e7810ea64e70fef0ba37a366ca80948ef55f",
      "text": "不过，怎么会想到要去看恐怖片呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:fca36fd9480721480dbbc3a2161d44a5b5877c491520be6858122052b042d5a1",
      "text": "是因为什么来着……\n我记得好像是聊到了克服弱点之类的话题吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:8d7c781f1f962c7ca9fcf7ad143b3198f79547cdb471bf7332c559e78046e095",
      "text": "本来我也应该吃放了我讨厌的胡萝卜的\n菜肴才对的。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_01:1_5_013_01:cmd-000051:dialogue:000": {
      "source_hash": "sha256:2e9c130029cd1c03d7b5048690713d1e5dc35075f20c4e01405f98a37ca4a45e",
      "text": "只有我不做太不公平了，而且也跟悠介约好\n下次去挑战，我得做好心理准备才行。",
      "status": "draft"
    }
  }
}
