{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "034kan_401_2_4_034_01_09_a",
  "source_raw_hash": "sha256:488bcde86636dac9bb3c0282c410bb33bb741573b7abdadd72850c33dce77868",
  "entries": {
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:52bd925a333ac3582d6eac88bc368a287c1574c153ee8fd683625a6239c286b1",
      "text": "制作人，你看我们的广告了吗？\n刚才电视上播了哦！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1ceaedf2c4a321790c554f4c82afeb6a0c0977d0d4c4c370b494487aca3eca51",
      "text": "比拍摄的时候，\n花音们看起来还要帅气呢！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:21c9cbfec095c7b8013cdd71eee2cc9753f44414b314f085afa115befcc8b580",
      "text": "看了哦！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000011:choice_short:000": {
      "source_hash": "sha256:32980b3eec4b06bc990b97ea923d3e23223556b38d0536703175a780435230c2",
      "text": "非常帅气！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:9dc1321b26b25fe13fd7d41562c46a7418a4f53a1db1c1ba15cebbf487f4bac1",
      "text": "哇——！超～级开心的！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:ff924577a2079575f4a5e068e647e68633858347145f9742aa3efd5d2140dc7f",
      "text": "诶嘿嘿，谢谢你♪",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:cabea7ba975c2eaac6037d9fc56ff0d8a964afaaeb317a59ceea75a9053ee2eb",
      "text": "花音想让看到这份工作的大家，\n都夸花音好帅气。",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:9dde308daa3cbcdb310ee69d5f061958b2a8bfceecb1ad2367adaea33b3c6d7c",
      "text": "所以，我也想给一起努力完成工作的大家打电话，\n告诉他们广告很帅气～。",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000026:choice_short:000": {
      "source_hash": "sha256:db6b7c7567de3de49a8008d42caa77703af92a87e7027f4ca46f1380f3f441ff",
      "text": "真是太棒了！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:bc21c29e894b9a7c2fe8a42c1590d27828a77c985efe2669b75e5849620cfcf3",
      "text": "嗯！\n花音这就去给大家打电话！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:b4343f0f2215d3b6eb316b22f9976bd193d09fc3a87fe8e54e17018e2468c474",
      "text": "制作人工作结束之后，\n也要打电话给大家夸夸很帅气哦。",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_a:2_4_034_01_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:29154d513e580b079e0b489892a43b7ae61b157303fdeec85d7c90b920b2ee0f",
      "text": "大家肯定会像花音一样高兴的！\n那就先这样啦☆",
      "status": "draft"
    }
  }
}
