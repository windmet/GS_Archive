{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_029ass_2_1_8_029_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_029ass_2_1_8_029_02:1_8_029_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:0a3113688f32ef4a657a62a680314aaffd9a60f548906902ff03dd7d763a3d7f",
      "text": "吾主啊，汝可还记得？\n然也！今日乃汝之生诞祭！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_2_1_8_029_02:1_8_029_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:0bbdb0e1ffedd9683b6ac87a9051ce8b78f308cb75a198d9564d08f7f0be711e",
      "text": "吾与撒旦在此为汝奉上贺词。",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_2_1_8_029_02:1_8_029_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:0ed7d7c8b6a02e60f0c37e51cea20f78f890d2ef6688fdd9efe1f1a4ffaa231d",
      "text": "诚如预告，吾已炼化出庆贺生诞之食粮。\n现即刻带往黑暗之据点。",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_2_1_8_029_02:1_8_029_02:cmd-000020:choice_short:000": {
      "source_hash": "sha256:fcad63e2931eea985a7152ff73e321c6ff8368c9b6f73cddc04dd27bbde61f79",
      "text": "很期待阿斯兰先生的\n料理！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_2_1_8_029_02:1_8_029_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:9d436c23bbc2cb8e02fbcf8499c4a5e4d9c3af1f4dcf1dc8f89d278a238fb233",
      "text": "库库库……当赶在灼热之精灵神力消散前送达。\n汝便满怀期待地静候吧！",
      "status": "draft"
    }
  }
}
