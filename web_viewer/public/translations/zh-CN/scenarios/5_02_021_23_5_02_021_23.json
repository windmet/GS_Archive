{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_021_23_5_02_021_23",
  "source_raw_hash": "sha256:d69f0c252823de0b5b1ea0d92e22455f81878d9dfea66ba5af43851033ddbdca",
  "entries": {
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000015:dialogue:000": {
      "source_hash": "sha256:0da958daea55d03d96cd3e92430f2c5b679e9b5d0b8e26463cc9b7eea02ce739",
      "text": "●●●●プロデューサー，辛苦了。\n现在有空吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:ad2fd45ba82d6d10b46dbe1dd0c6e432b4602bf788d92529b3ef5bb1854b6ff4",
      "text": "好的，完全没问题哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000022:dialogue:000": {
      "source_hash": "sha256:d388e59f2c216b6b229b9f13359b104cf49d442c472c38cf227d6e7893bc039b",
      "text": "情人节的时候非常感谢你。\n这是白色情人节的回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000028:dialogue:000": {
      "source_hash": "sha256:3f5d5638d8ed61c7c979b7a55e3dbbd498a0fdc561edd5184580bf0fc9fae495",
      "text": "嗯。因为制作人是成年人，\n送什么合适我稍微有些犹豫……",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000031:dialogue:000": {
      "source_hash": "sha256:82039d2760564eb680a9bdf4e53174e3604da482d709e3f37205ae64c2c85d51",
      "text": "虽然有些平淡无奇，但我还是选了巧克力。\n不嫌弃的话就在休息时吃吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000034:dialogue:000": {
      "source_hash": "sha256:a23be6d77a8a423aeb58cd12b0cb958a659abed7bcdb0afc2f2abcf717dffdfb",
      "text": "非常感谢。\n看起来非常好吃呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000036:dialogue:000": {
      "source_hash": "sha256:435cde8df9cdbd4ab5f5f95c3be6ab10c2837f42be7542b3c0a5554065e90fdc",
      "text": "是吗。\n你能喜欢真是太好了。",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:547eef9ceb0cea56f29f418452446accc86c2940ca05f36a806d1fabba56efdf",
      "text": "平时在工作中一直承蒙制作人的悉心关照。",
      "status": "draft"
    },
    "story-text:v1:5_02_021_23_5_02_021_23:5_02_021_23:cmd-000043:dialogue:000": {
      "source_hash": "sha256:8194b8c70beff2de8dd1902b4043117a78a77c4090169f28fc411012d6e4d5a1",
      "text": "今后为了能做好工作我也会继续努力的，\n请多多关照了。",
      "status": "draft"
    }
  }
}
