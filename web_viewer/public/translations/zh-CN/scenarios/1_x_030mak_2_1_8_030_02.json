{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_030mak_2_1_8_030_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_030mak_2_1_8_030_02:1_8_030_02:cmd-000009:dialogue:000": {
      "source_hash": "sha256:2740a9fbfe2632fdd6ea8222aca8e9c7dd1fe9a7ba345685e6ba452c2a64cc79",
      "text": "语音留言……1条",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_2_1_8_030_02:1_8_030_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:c7b47d1d0de52dc9a0a39e9f8cd4f48576471ae5158893f68fb76625f8be9f40",
      "text": "●●●●プロデューサー，辛苦了。\n祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_2_1_8_030_02:1_8_030_02:cmd-000020:phone_message:000": {
      "source_hash": "sha256:67c0dcf58bd5981548d9bd7ab6723b26b89df8f3e1cf467be8decd0e96388212",
      "text": "其实，前几天跟您聊到的那家推荐蛋糕，\n我刚刚顺利买到了！",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_2_1_8_030_02:1_8_030_02:cmd-000022:phone_message:000": {
      "source_hash": "sha256:ebc04d1f5df4db769a4793cc2bc48d2c8d6d8d9af8588ffaa9a629f889a59de4",
      "text": "我想着要是能在制作人的生日上，和您一起\n品尝就好了……",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_2_1_8_030_02:1_8_030_02:cmd-000024:phone_message:000": {
      "source_hash": "sha256:e0d273fbc8f27aa8570d9a5a0b8c5ddec7aec80de3b625f879a10e77e9388149",
      "text": "我现在就带去事务所！等您有空了，\n能给我回个电话我会很开心的。",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_2_1_8_030_02:1_8_030_02:cmd-000026:phone_message:000": {
      "source_hash": "sha256:aa4d3fb059640279879f9568573d575fa3c604bb49da430de9138d09bffb0afa",
      "text": "那么，待会儿见。",
      "status": "draft"
    }
  }
}
