{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "049eis_402_2_4_049_02_09_a",
  "source_raw_hash": "sha256:5a171871eb1b29cbb5e61540cf89091b73d44dff46cbf9241d300d8c82cd99d3",
  "entries": {
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:564bd93ff18f2fd0eae946bad8783399caad68e25cc713d2a14af15b57b8e475",
      "text": "●●●●プロデューサー。\n前些天活动的事务，我有些话忘了向你传达。",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:fb8f3c3910f7b229fda21815ca6392fcefdcab027a6f61a141ec4076979a8189",
      "text": "这一次多亏了你的调配与建议，\n我才得以充分发挥出自己的实力。",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:5494e8ea662d316d763b30fbd90f50cb396be55dd285a1a4f822ac5def43fc50",
      "text": "……我对你的信任，也由此更深了一层。",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:704a1dfd29678976b924acfb91bc950177da10a35501c908003d263032cb323f",
      "text": "感谢你。今后也请继续协助我。",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:45a5cbb777804ba929615a6a3308aa2831d59b8e4bccb541c0eb44992f5e0762",
      "text": "能帮上忙\n真是太好了",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:1328858b72076382b4434a1d60241e572fa393e0e21d8022ddd6bd6bcd0ca477",
      "text": "包在我身上！",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:09996038afcc4192aac636f44f43ff25bf5925dcaefbeb7c4fbd30e6bc84db5d",
      "text": "……这种时候，你不妨挺起胸膛更加自豪一些。\n因为你确实做到了这般地步。",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:21cae1f5ab7330abfe120f142818924fbc21ae00edd7c72ea2085bb612238823",
      "text": "嗯。今后我也想与你一同，\n摸清自己作为偶像所拥有的潜能。",
      "status": "draft"
    },
    "story-text:v1:049eis_402_2_4_049_02_09_a:2_4_049_02_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:0c92722ca6543a3dc272431b59971278426fc2e758d7816d99e15278f8d69af1",
      "text": "事情就是这些。\n明天再会。",
      "status": "draft"
    }
  }
}
