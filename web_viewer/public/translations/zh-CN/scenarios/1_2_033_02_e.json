{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_033_02_e",
  "source_raw_hash": "sha256:a91018fda61fd58a8010aaea7c027eb6dbaa6181d6d8ad1f72522d33e05c2138",
  "entries": {
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000030:dialogue:000": {
      "source_hash": "sha256:7051346a58028ee7cab68636ce6e160c36bc98b8ba396cdc55f1de7e8d637b9a",
      "text": "好耶，是派对是派对！\n超有精神了，嘿嘿！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000035:dialogue:000": {
      "source_hash": "sha256:57ee7223d1bf85618cec6c9e275d8f4d2c2310f8175f16eb9fcec3692fe99d53",
      "text": "哇，突然变得好有活力。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000045:dialogue:000": {
      "source_hash": "sha256:010ee31e3d6139c6e3d122dc955e61144343ab57fcccdfd3d072f37ba58b526e",
      "text": "太好了。那我们去派对会场吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000060:dialogue:000": {
      "source_hash": "sha256:beceb564c01aca79da3c4a4651b34bec79a42060dfd6b6e107e6234e1852027e",
      "text": "啊，等一下！\n能让我从头到尾再完整跳一遍吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000067:dialogue:000": {
      "source_hash": "sha256:1ef1163af4d851efc1de1d9ea2ddff9343fb4dae7de56d461b3d6a30b588b52a",
      "text": "现在的我，感觉能跳出最棒的舞步！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000091:dialogue:000": {
      "source_hash": "sha256:f36f2442e044cbf9265a867724a2407f6490f29f412e4fceafb30fd7c3969e1d",
      "text": "非常完美，志狼君。\n那么，我们回事务所吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000110:time_caption:000": {
      "source_hash": "sha256:a8ba5f63568d1a2ab1f0cbe6fd89097aadb0c318b65cba044ff7567676625767",
      "text": "之后……",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000126:dialogue:000": {
      "source_hash": "sha256:3905689d617c31cd6f7df41099e85ec777a4d2570d9ed02d95f594da2ebec7fb",
      "text": "祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000136:dialogue:000": {
      "source_hash": "sha256:ab3a1a13b073bb2c0890c4e58bbec01d35806871fe77d3d2d70a48b965dd3660",
      "text": "谢啦！\n我还真以为啥都没有呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000144:dialogue:000": {
      "source_hash": "sha256:759145d4a90caab33e8e8f640505e646f20c903c798b55e3c6e2b037d722a429",
      "text": "肯定会办的呀～♪\n因为，明明好好约定过了嘛。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000157:dialogue:000": {
      "source_hash": "sha256:e336458962a7c8fcb90fbeb1dda06d7dc215590dcc0c457ab409fce243ddb750",
      "text": "让你担心了对不起，志狼君。\n难道今天一直不在状态也是因为……",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000169:dialogue:000": {
      "source_hash": "sha256:b2585324eb60bfe7105d4931b7b7b19d48bd8114b7bd41a4f5be05e12e255a23",
      "text": "才没担心呢！\n不在状态也只是碰巧而已啦。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000178:dialogue:000": {
      "source_hash": "sha256:9a52c25cacf2934836b020646ef7434032d7d36e7c8ea222c39f053fe7231099",
      "text": "呵呵，那就好。\n我们准备的惊喜，有让你开心吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000184:dialogue:000": {
      "source_hash": "sha256:9312eb5647e233af0b84606b6fa4e5e118539495d62bb5246a666caae83c7ee1",
      "text": "嗯！不仅有蛋糕、我最喜欢的美食，\n还有大家送的礼物……",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_02_1_2_033_02:1_2_033_02_e:cmd-000198:dialogue:000": {
      "source_hash": "sha256:52c4184396de3649485f4fb22019ec75b4293032fd579addfc1b98b9ad1905cd",
      "text": "全都让我大吃一惊，而且全都超级开心！\n花音、直央、制作人，谢谢你们啦！",
      "status": "draft"
    }
  }
}
