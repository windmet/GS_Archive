{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_029_23_5_02_029_23",
  "source_raw_hash": "sha256:c23a40371aa66dea453c5859a6524df45cef83501ee1c604c887b1143ead564b",
  "entries": {
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000014:dialogue:000": {
      "source_hash": "sha256:5ded9317166153b3d56692e40f06f995dc3584417c2c0334a5a52b9da73c83a7",
      "text": "吾主啊！我将把这本圣典赐予汝。",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7bd96f47acdf6559ebc21d7e9cf7d6fe1039d529a198f6ba7d8be52da64aaed2",
      "text": "非常感谢！\n这是……亲手制作的食谱集吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000026:dialogue:000": {
      "source_hash": "sha256:24f0753bd18c7223de6841859529f254b968e7d37a52c4c64de1c0e5a590a3ab",
      "text": "……有这么多精妙的菜品！\n真的可以全部给我吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:5ebe792928a1d59ea22013df2dcf92cc4e6bce5d22aac65a877ad2994454f71b",
      "text": "那是自然。此乃作为汝所奉上之甘美黑暗碎片的\n回礼而特意筹备之物。",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:6d13db54e3ba60a52b1693b796544925ea79369dfbd2f8a25e44408a4f8701a9",
      "text": "在纯心赠呈祭到来之前，究竟何物方能助益日理万机之主。\n我曾百般深思。",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:5a4d7e1262e649c743f848c90d7a2363e2579afb42786c667480190fd49fdc2e",
      "text": "而后终获天启！\n那便是这本圣典。",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000051:dialogue:000": {
      "source_hash": "sha256:234b5e7ea48cc92a50790c5a8754c29c669f3cd2b7911648d297bb329ca09c2b",
      "text": "无论何者皆能轻易炼制，且能获得强大力量的\n无上供品！",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000057:dialogue:000": {
      "source_hash": "sha256:8df01bc170607bf30fd0c33241f0ccba5f69334029a3a94e161038bb90210cb0",
      "text": "若有此圣典在手，必定能为汝助一臂之力。",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000065:choice_short:000": {
      "source_hash": "sha256:3e6a547aff94cc6d8741a40279dc1e869e001c7a4db7551dad36f232aef6bcc2",
      "text": "阿斯兰先生的这份心意让我很高兴",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000066:choice_short:000": {
      "source_hash": "sha256:a419266168ac5acf88c529cafe857d0405c49fcfcf9a915d6aeef5a0ee11daff",
      "text": "我会仔细拜读的",
      "status": "draft"
    },
    "story-text:v1:5_02_029_23_5_02_029_23:5_02_029_23:cmd-000075:dialogue:000": {
      "source_hash": "sha256:55367306d20c8bce2d5a54d500bec3656e3a973b4184401b3bd65b5df7efc62a",
      "text": "唔姆。\n那么，后会有期！",
      "status": "draft"
    }
  }
}
