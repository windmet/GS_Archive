  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000010:title:001": {
      "source_hash": "sha256:005c162b2a06974bc95337c508f5a16f40d40ddf2b6273c7af955a93eeed739a",
      "text": "调味料广告拍摄的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:2c9e554568450f12ef77c60c54601834c9a6e532e684c6374a26bd49fb1ef293",
      "text": "●●●●プロデューサー，来得正好！\n我做了广告用的菜。能帮我尝尝味道吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:2e890452cb5e5216111a38066292550c1696093eaf4c9f9f4fea50a4d6f44107",
      "text": "看起来很好吃的汉堡排呢。\n哎，不过这次是烤肉酱的广告对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:64098d7eb9bc877ad5eabcf3545a9320274c5e79dcde7ca92d7b142a6638aef7",
      "text": "除了烤肉以外也有其他用处的。\n总之，你先尝尝看吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:6bf04dca591634b138bf5df39f74d99fd76b121d3eb9efe8c19aa729297bc131",
      "text": "好的！那我就开动了。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:916cf7f23a348476ae84f217c17dde0e1b0b216fddca59664c81ae57749af4a9",
      "text": "……好、好吃！\n味道非常浓郁入味呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:a5e86c32d14cc823eff4e9924af35a89f28009bcd6d282859e9e33fb4959aaf1",
      "text": "哈哈，能得到你这样的评价真是太好了。\n没白做啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:79e3ad7785186392c20e05e8dadb2d587c05db9230d9bc1fd444b19d6ca44af7",
      "text": "其实，我在汉堡排的肉馅里混入了\n这次要宣传的烤肉酱。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000048:dialogue:000": {
      "source_hash": "sha256:13bad5f7f98f5846ac3fa2b017227465db5b084c160449a7bef85f088e862e2f",
      "text": "真是绝妙的点子呢，诚司先生！",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000051:dialogue:000": {
      "source_hash": "sha256:ece9740b46b340aeffb5cf7628588ab478078ca2be7f1b7af3d87ffc066d6958",
      "text": "因为实际在广告里也会播出这份食谱，\n刚才我还稍微有点紧张呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_01:1_5_016_01:cmd-000056:dialogue:000": {
      "source_hash": "sha256:fc753ee130047e87c974d0e9736c0d827ea16869c063189dcffe7bd9f79b5642",
      "text": "不过听了●●●●プロデューサー的话，\n我有了自信！正式拍摄时我也会做出美味料理的。",
      "status": "draft"
    }
  }
}
