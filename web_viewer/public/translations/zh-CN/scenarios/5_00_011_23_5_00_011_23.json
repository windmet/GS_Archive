{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_011_23_5_00_011_23",
  "source_raw_hash": "sha256:aed03b5f0f798eb3cd5aba481578336b70afccb891e3e337fc277a3c85de7bdc",
  "entries": {
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000000:title:000": {
      "source_hash": "sha256:2dcb5116cd3ae13c2630466d200a0a61a2cdf819f996526a2259b191f186913f",
      "text": "压岁钱要怎么花？",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:38b2e356fb05053d79753cbeea09503f207c0ca541881ced3ec14f4211dbfd9c",
      "text": "制作人，新年\n快乐。今年也请多多关照。",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:21836a0ba72ef01c9681cadfe76b6086b8aeffd53b4f9fceab66296aa28444a7",
      "text": "●●●●プロデューサー，\n新年快乐♪",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000041:dialogue:000": {
      "source_hash": "sha256:85ad85ee30d1ea5e08951b9e18d1a285e1e4568b88a0ab67db2ad687191f8c3d",
      "text": "制作人新春快乐～！\n呐呐，给我压岁钱嘛！",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000045:dialogue:000": {
      "source_hash": "sha256:3316f42d26fc179409bac383e07b51f18212d4bdbca832615bfe058c353cc54d",
      "text": "新年快乐。\n压岁钱打算用来买什么呢？",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:419ea6be7595f50acc5406c533de7d58bf27afa31beb283c86b9d84347169e46",
      "text": "游戏还有零食什么的！",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000052:dialogue:000": {
      "source_hash": "sha256:6dfe32d47c37efa0cd66028db1dbb3afea8ce55a32e038ebbabc52a0dd766c10",
      "text": "我……大概是存起来吧。",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000057:dialogue:000": {
      "source_hash": "sha256:12a35ea7f39505e60a3f1dafbdc42563d1ae9a9666d9d48a8ebc5fee05545589",
      "text": "花音要买新衣服！",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000063:dialogue:000": {
      "source_hash": "sha256:2cc2263a2865c335e3f5595777fdf5fe9170f0e0df9b74e262831b21270ea841",
      "text": "啊！制作人。今年也能穿上好多\n可爱的服装，花音好期待哦。",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000071:dialogue:000": {
      "source_hash": "sha256:c88f30b1261e8cdd9ab751cf36c71f9e09b0bc7f3799c2b8c76a4f5812460a4b",
      "text": "是啊。制作人。\n今年もふもふえん也请您多多关照了。",
      "status": "draft"
    },
    "story-text:v1:5_00_011_23_5_00_011_23:5_00_011_23:cmd-000080:dialogue:000": {
      "source_hash": "sha256:dca3ddf2874fe2ebc859f77ecc2843861671446dfafe54fe77503ed82066b636",
      "text": "本大爷今年也会超级大显身手的！\n多关照啦，制作人！",
      "status": "draft"
    }
  }
}
