  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000010:title:001": {
      "source_hash": "sha256:df8c3efb5417c3c29cb6658708c31fc7e8127b1fcc828512fc54453135f4b0a5",
      "text": "交通安全宣传代言人的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000014:dialogue:000": {
      "source_hash": "sha256:4107d77e8fa658f4f8654a305f1637804ccf99fb439b2d70ef80fcce40a4123e",
      "text": "马上就要正式开始了呢。\n看起来您好像有点紧张……没问题吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:490c4a342ccbb73b345342330df08a35afa6262a9fe79e59c96ab51310f8fb59",
      "text": "超级紧张的……但与此同时，\n内心也充满了干劲。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:ef3738091c09ab9a8570b1757cd9a4ce9e53f226bee997a6dcbc5a1ff6c45e45",
      "text": "要是因为我担任交通安全的宣传代言人，\n能让大家的交通安全意识有所改善的话，那就太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:b7ba618d2eadb5b36a88179f86942b87085e2701ad631961a3e07d5b608894d6",
      "text": "点滴的积累是很重要的对吧？\n要是事故能哪怕减少一点也好啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:14d380cef8e276a89ef67e90552f6b611d2bbf1f8eb37448a5f99692a0f16f3e",
      "text": "英雄先生的心意，\n一定能够传达给大家的。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000036:dialogue:000": {
      "source_hash": "sha256:49d08a5df7b2f575e9f37c8c8b0a31f9d948825e023967d1d6513002c826d08b",
      "text": "毕竟您被选为了宣传代言人嘛！\n一定有只有英雄先生才能做到的事。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:97e0817145b76809fea21fd628a49c8ab1cc72b4521cbf9575a2b4bfc58d7628",
      "text": "哈哈，但愿如此吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000049:dialogue:000": {
      "source_hash": "sha256:f076b105100ef2beaa473040c8fdf5d61ff2febe3385e4775ac50164323bbabc",
      "text": "多谢你，●●●●プロデューサー。\n我今天也会全力以赴的。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:8d60df6ca31522999d54eba389f9369e6d38b459d7caf7a378e1c2d3e5e5f609",
      "text": "我会在舞台侧翼为您加油的。\n……啊，好像马上就轮到您出场了。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_03:1_5_014_03:cmd-000056:dialogue:000": {
      "source_hash": "sha256:4280d8a053d466a1c8e55c66ea4948d36e8a97d99615e25665c81750baeaf4d4",
      "text": "好！我上场了！",
      "status": "draft"
    }
  }
}
