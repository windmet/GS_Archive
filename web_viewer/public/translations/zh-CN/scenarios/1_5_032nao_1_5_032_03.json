  "entries": {
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000011:title:001": {
      "source_hash": "sha256:480eefca23fcba55441ff0c98fac4db4ee063ef751c6024a2de2539a201d73d9",
      "text": "拼布节记者的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:85b2e2b19c2479983de6017d353292f1667b7a9a5d8ef3d0f072016d0c5b319d",
      "text": "呵呵，能看到什么样的作品呢……♪",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:36dd50462f968f5aba679adbafaacbc90e0cbc6f65860ff96fc6db81421119b6",
      "text": "我记得直央君说过，\n自己很喜欢编织对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f226062b4099655a01fa2e943670aa8bd88fc696c2011f89c32f1477db385793",
      "text": "是的。所以今天的拼布节\n我超级期待的……！",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:b77163f37d41d01da72fb0742d86be9e952c760f5bfa10a76f856cbc71493d36",
      "text": "能选我当记者，我好高兴。\n啊，但是……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:3114232fe53163e7e865b92ba0e38b3ac3cf77cbb674c33266b3ed0444921893",
      "text": "怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:4f3dd4f4cc25eab8840cf48743ba91bcce5d2888cf6ae26e6046c85009d5a360",
      "text": "拼布的乐趣，\n我能好好传达给大家吗……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:e15004e5d8510c220fa4ff1dbd0660ba6a9b77008f492c2324c4e39a1212494c",
      "text": "不用想得太复杂，只要把开心快乐的心情\n报道出来就很好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:dcb170952011f42453fecd838f0cdd0b48b6344f9b11d40dadaa8e68e0b4070f",
      "text": "看着别人玩得很开心的样子，\n自己不也会跟着产生兴趣吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:f1e97eb4504d2bb704d1a325b265d2bdaf0442691c2b6e47c9c56ed0eb2fa128",
      "text": "啊……对哦，确实是这样呢……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_03:1_5_032_03:cmd-000048:dialogue:000": {
      "source_hash": "sha256:d734281d4c4296d391a3d785545265d2ca66c11b926d7bb4ebb04b0bddb4c9a0",
      "text": "●●●●プロデューサー，\n谢谢您。我会加油的！",
      "status": "draft"
    }
  }
}
