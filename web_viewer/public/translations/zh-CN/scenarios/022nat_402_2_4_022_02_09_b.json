{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "022nat_402_2_4_022_02_09_b",
  "source_raw_hash": "sha256:f9a7e075cd302cdc767a4511b2aaee84702b6b6d5012c80b74eb1d6b91b8dc31",
  "entries": {
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1df32719beeca731d1ea79807618edec3eec24b6275b12ebde19c68fa31add29",
      "text": "●●●●プロデューサー，辛苦了。\n还没写过的短册纸，哪里还有吗……？",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:b49b7f59af4053c2c4d5b51dc13a571fdf3c4de9a074398040fcc850040dbe16",
      "text": "我现在在短册区……短册纸用完了，\n大家……好像都很困扰。",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:58e835fea0552795c0d1aec312e354cc9eadfc94c17c4e01fc88654a81d377e9",
      "text": "附近好像没有工作人员……要是把大家\n扔下不管，我又有点放心不下……",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:2b02051a86986d14c2df145345307715af753254e7170f5c0f8143f608b932bf",
      "text": "我来替您\n找工作人员吧！",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000015:choice_short:000": {
      "source_hash": "sha256:ffe1e17b22549a2268d13f8937e10592eaa4a59c55c51221675d224ef48f23bf",
      "text": "我这里有，\n这就拿过去！",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:069fe122e0500f43745f11f286ad4a8e36c7cd956b6ca6538fc76cae6c53e9eb",
      "text": "……我知道了，谢谢你。我……就在这里一边陪大家\n聊天，一边等着你哦。",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:a8c0d57aa20f12b537a94caa4d7c3edf643fe4e0264af88f32ffc5aac70d66dc",
      "text": "大家好像都很期待写短册……\n所有人都能写上吗……？",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000022:choice_short:000": {
      "source_hash": "sha256:f83f8e650aae16612cc46fcc8053696877c26876650c7e31b3402c9512d58c14",
      "text": "还有很多哦",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:b8ceb7e65de1ab638f85263a766754e1d025be06837d33eb88678973a2ca7a8f",
      "text": "这样啊，太好了……\n那我也……这么告诉大家。",
      "status": "draft"
    },
    "story-text:v1:022nat_402_2_4_022_02_09_b:2_4_022_02_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:47fbdaee4a80cc3b57f5234486270394b3110f28ed3b5c5632bd514fcac3ad4a",
      "text": "那么……我等你哦。",
      "status": "draft"
    }
  }
}
