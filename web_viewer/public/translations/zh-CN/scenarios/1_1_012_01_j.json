{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_012_01_j",
  "source_raw_hash": "sha256:40a84e02825d034610deb52c0330a1cd67b00ec0f2a1829b2c7f2f6e15372c32",
  "entries": {
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000022:dialogue:000": {
      "source_hash": "sha256:a689f62d53c951cd4e0ba546870a0bf7d98fdb2518a2141a6a48680be60b3c20",
      "text": "请务必借给我们一份力量。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000032:dialogue:000": {
      "source_hash": "sha256:de89215431ca5ec04d90e2d8987da9691048c8143e45e5e9a9bc54343c019ea3",
      "text": "……像我这样的人加进去，能帮上什么忙吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000043:dialogue:000": {
      "source_hash": "sha256:70ffe731baf0d38f9885b469efbbe545814eb6d5fa4a5963358637e53f50fe64",
      "text": "当然能啦！我们三个人一起成功，\n然后一起enjoy人生吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000054:dialogue:000": {
      "source_hash": "sha256:300c79387495198e0074ffe69859e3f090940e58ab1cd4b0ee51d02fc46bfa05",
      "text": "……\n享受人生……吗。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000064:dialogue:000": {
      "source_hash": "sha256:603dc404e1abe60ecebb035c8ccf59c1bb8aa69ee9c473bcd77103347c70630d",
      "text": "或许我们的目的各不相同，\n但每个人都一定能获得巨大的收获。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000068:dialogue:000": {
      "source_hash": "sha256:9f053bc5a33eafc16e9375584725ee767443407f0dc77abc36b77e90782c1b8e",
      "text": "意下如何，山下君。\n能不能请你认真考虑一下呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000072:dialogue:000": {
      "source_hash": "sha256:a8caa18a0ca27dd9c260a6f2e114356761dbbdd2f48fa7d4d6f91af2bb22eb86",
      "text": "Mr. 山下！只要是我们，\n绝对会成功的，no problem啦！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000094:dialogue:000": {
      "source_hash": "sha256:207340283a29f3c9852a60badc147f8af24c953a958b0492ec5bfb2771096b77",
      "text": "……哈哈，绝对会成功，吗。\n那还真是桩美事呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000099:dialogue:000": {
      "source_hash": "sha256:1ae382ee44cf7e2cc5a38ab96cd4d9e27426c740dd802ec04dcc04bff94e7059",
      "text": "Mr. 山下！\n这么说来！？",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000103:dialogue:000": {
      "source_hash": "sha256:1b926979af74282f5338a8657a0dc76d3903bf016294b123c7cfffbacf3bd908",
      "text": "那就试试看吧……当偶像。\n虽然不知道能做到什么地步就是了。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_j:cmd-000116:dialogue:000": {
      "source_hash": "sha256:c26b3e5bf4490b138d151b57ab22a176a5a1712f38544206abe44d00f05dfef7",
      "text": "山下君……谢谢你！\n让我们三人一起，向着偶像迈进吧！",
      "status": "draft"
    }
  }
}
