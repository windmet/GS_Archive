{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_03_j",
  "source_raw_hash": "sha256:7d9aabc45b06754084efdfce09f2e175714e72a7fb74922a162bbc24aee0b64f",
  "entries": {
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000019:dialogue:000": {
      "source_hash": "sha256:3a0bbafd57210c11d61d08680d1455cdd64c91645946a59a3aaa160aa9563171",
      "text": "……我到底在干什么啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000030:dialogue:000": {
      "source_hash": "sha256:1401ba9cd2fd62bf98c386f0cacf0fc810787c672dcaf1ccbc80f6aa66e0df5a",
      "text": "（突然大喊大叫的，一点都不冷静。\n可是，这一次……悠介也太自作主张了）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000040:dialogue:000": {
      "source_hash": "sha256:58363413f0dcb49efc401122cd4f6476446ee62686aab7579c0840b3bdb6c3dc",
      "text": "……在我止步不前的时候，\n那家伙却一个劲地往前走……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000049:dialogue:000": {
      "source_hash": "sha256:d469666b965792b74a07b563f6931e189f828761b48f736b01984986ce212e97",
      "text": "（明明没有悠介我什么都做不到。\n那家伙却连看都不看我一眼……）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000054:dialogue:000": {
      "source_hash": "sha256:b5d6ccf252ad3dbf71c135255c39d7bb244af39379541970623760d479de818e",
      "text": "（……不。怪悠介是不对的。\n悠介的人生是他自己的。而且……）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000068:dialogue:000": {
      "source_hash": "sha256:c95dee345240844d3920375742e7122409c60586cdd6ef2222f5ca659d7f6ec0",
      "text": "（我们变成这样，全都是因为……\n全都是害得悠介受了伤的我的错啊）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000072:dialogue:000": {
      "source_hash": "sha256:c0136fcf3b1eb5a80d308268306e829351171e1f33afcff2fbdeb725f8f85429",
      "text": "可是，我……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_j:cmd-000091:dialogue:000": {
      "source_hash": "sha256:28a73f45d423a2650b62f06569f45a1550887d1fe63710e0f4a5eeb550111303",
      "text": "要是不能和悠介在一起……我不要那样啊。",
      "status": "draft"
    }
  }
}
