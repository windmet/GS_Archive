{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_02_e",
  "source_raw_hash": "sha256:9195939249b631e44050e1ad391c945b80e5a9a6c517d92fdb384cb11a2cfdfe",
  "entries": {
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000013:dialogue:000": {
      "source_hash": "sha256:6d5a0f0e1a83d041c1302ef84a412be85d87ef41a7f3dc257ade34eb7eb36af8",
      "text": "难道说，你是苍井享介选手吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000016:dialogue:000": {
      "source_hash": "sha256:fa3339262dfa5b04d42fb8c983bef133eb9fa433f22f137547ed92aef4202f79",
      "text": "是我……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000024:dialogue:000": {
      "source_hash": "sha256:7c94d37cd1700d755a897008abb2de4edd0f2ec54542ac2565de618e089aaad1",
      "text": "诶？真的耶！是真正的苍井选手！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000027:dialogue:000": {
      "source_hash": "sha256:9abd3bd09195f46edaf05df440c47c11f7c77caced2a3cc3418eaff271f85f00",
      "text": "为什么会在这里啊！？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000030:dialogue:000": {
      "source_hash": "sha256:aa677498108fbd5297cbf6e75fdcf4d1373ff872a7183a41e4f1690283019fa5",
      "text": "我一直有看你的比赛！\n最喜欢你和悠介选手的配合了！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000032:dialogue:000": {
      "source_hash": "sha256:cfe301122d9b4e6608c4f1102e752270735083ca4d35c781cb3bf7a2b8d75e91",
      "text": "必杀技超级帅气！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8b22932c1edbee684681675a2f41ebdc8a74e7307209476c74f80b6291c7c363",
      "text": "我们的梦想，就是成为像苍井兄弟那样的\n职业足球选手！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000038:dialogue:000": {
      "source_hash": "sha256:f13cac81205e4c52b1da39700c70205a217eb856d987e0371bbe8fe32217b66e",
      "text": "……谢谢你们。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000047:dialogue:000": {
      "source_hash": "sha256:0fc7bd4113c00fad1f620001150fe6f1ab1bdc40a85e00dcff231ed7558dc9c1",
      "text": "（可是我，根本不配成为被憧憬的对象）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_e:cmd-000053:dialogue:000": {
      "source_hash": "sha256:98eab1a5b36e7fe76435fc46aabf74120ed0c6cdd2d81e8a1ef568a63bb4ab25",
      "text": "（剥夺了悠介的足球……\n甚至，连自己的足球也失去了）",
      "status": "draft"
    }
  }
}
