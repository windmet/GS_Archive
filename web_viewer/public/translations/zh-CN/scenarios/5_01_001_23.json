{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_001_23",
  "source_raw_hash": "sha256:f38190727dc6406e592cf013a22a86f6306a4eee351ffe5a5ff6835c6f68020d",
  "entries": {
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:fd5d68b3038e354bc772a32718fd51adee13290e278627ae203a95b167a39f1a",
      "text": "●●●●プロデューサー！\n情人节巧克力，多谢啦。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:c74164335d7a968cfd4fc39ccae7f63e2e634057898a2d0267eee0d27c079c43",
      "text": "我刚才吃了，超级好吃！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:1221e2358144885c4da93493227329d812fb7ace36bf577030585aaf2a374891",
      "text": "去年的巧克力也超好吃的，\n但今年的比去年的还要更棒啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000031:choice_short:000": {
      "source_hash": "sha256:8d30b9e05ea2a6de2a5e47dc2e9534bd421ee1782afbccd7b07c14db2bd994cb",
      "text": "我把热情加量了！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000032:choice_short:000": {
      "source_hash": "sha256:5030062eeae4643656d26dd7ded9653e5494eb1b41b18feb0199b9439a274e09",
      "text": "因为我非常重视冬马先生！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:70db3a961eda87b16d0bc10e44666566c865a7ec615c5dda77bc551a04e39523",
      "text": "原来如此啊，怪不得那么好吃呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:4d04bb25e049cb2e725ed43af0079ba80c8ee37000be00ac8c91c3c1c1c6bb07",
      "text": "那份巧克力里，\n原来蕴含了这么深厚的心意啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:451b186fecd10ec62b4154d73e1c44c69240dc45a1b98783abd1567960fb8352",
      "text": "……糟糕了。\n早知道听你说了这番话之后再吃就好了。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:f1bfad6b05750391bd7f48781777d3b84ce3caef419b8529d428cf07f07762e7",
      "text": "这是为什么呢？",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:994c52514417157f3531313a9f1103a153d0a67bd24874ad467caa0793c189b1",
      "text": "感觉巧克力的味道又会有所不同嘛。\n听了制作秘闻之类的，",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:1761a89115100cfaf8125eb3158d1393ef3e5f040316c983b4d85bc84dd4ebec",
      "text": "不是经常会觉得吃起来更美味了吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_001_23:5_01_001_23_a:cmd-000065:dialogue:000": {
      "source_hash": "sha256:9e171b369a8b4ad64427fee142b0ee3f3605cc59d8a0000ccdfebe5b7b562c04",
      "text": "今年我已经全部吃光了，\n明年一定要让我再次好好确认一下啊！",
      "status": "draft"
    }
  }
}
