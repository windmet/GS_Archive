  "entries": {
    "story-text:v1:1_x_043kaz_1_8_043_01:1_8_043_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:abd1bea8554541e1b9d844a790627c3d2913ddb5c9660f4e4fab4cae07f4175c",
      "text": "……●●●●プロデューサー。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_8_043_01:1_8_043_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b54887d99bbcc0126e766e1decc612cbced5bb5a34445a8716911f8d93c4452e",
      "text": "……现在方便说话吗？\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_8_043_01:1_8_043_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:263e133b0a58d42dbd65710a5af88277174f51dde97ed8dfb00ae10a7a152e4b",
      "text": "一希先生，非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_8_043_01:1_8_043_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:dc095d2f5d623c6f74132c8b6201b33d687d642f18f100839345f50849dc08c7",
      "text": "……不客气。今后我也肯定会承蒙\n●●●●プロデューサー多方关照吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_8_043_01:1_8_043_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:0eecaca179bec5a7492b138eeef4cba723c2d1e572bffd0aa7b115fb33b222c4",
      "text": "……以后每一年，都请让我为你庆祝。",
      "status": "draft"
    }
  }
}
