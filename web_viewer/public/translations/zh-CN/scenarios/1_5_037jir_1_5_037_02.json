  "entries": {
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000010:title:001": {
      "source_hash": "sha256:74a710c7457ed29b5d1b971f549fb593485294cf147715d142f5ef36fe55247a",
      "text": "出演赛马广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:bbe98da8f922c1a49cc0335ab0fe29133480c4f10fc6f432066aecd5ebedf9b8",
      "text": "次郎先生，出演赛马广告的工作定下来了！",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:82da56fa8e9a90d0a6e6826ae0245a4947c912444683b3e5d83a8637a3764b1b",
      "text": "诶，你说赛马！？",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:a7ae1547544bab84bf0dcb91d17a67ef2533bd28fdb9072f4d8d02e5e25e519c",
      "text": "是的！这是相关资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:fa61069e1876bda0a66dbadfa8445b11204f257a62e82a6a2f6eaf0f4fdf8889",
      "text": "让我看看……\n哦，要在那个赛马场拍摄啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:3563dae920bbd9a422cca1f6125245d4d7b3852b702fe53b48095cbf394c203d",
      "text": "什、这、这是……！\n能跟那匹名马共演是真的吗！？",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:99fcb2159f72faf3c20ba22b8f06ed98d4a5ea94bd98388e4b34bfbdc16099d9",
      "text": "是、是的！是真的！！\n次郎先生将要和那匹赛马一起共演！",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:9cbcf45f6b25d220adcdb4c4ce2619945c5130f6295d2386a665c1a0ffe0bc47",
      "text": "啊……哈哈，抱歉抱歉。\n一提到赛马的事我就忍不住激动起来了。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:452e45af13c88cc5d9946b703c582921bb6cde187d6752d16b4101f4c4a4eb3f",
      "text": "不过大家都在传，说那匹名马的兆头非常好呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:a3cbdd87f6710e9aa90a399975459cb04918f88fe2a11f50d404f6238f087340",
      "text": "要是跟它共演，说不定运气也会找上门，\n让我变成亿万富翁呢……嘿嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_02:1_5_037_02:cmd-000052:dialogue:000": {
      "source_hash": "sha256:42f5fd18a9712303e3af326b414cff0273661055475edae4af89ed79e0f566fd",
      "text": "算了，不管怎样我都会加油的。",
      "status": "draft"
    }
  }
}
