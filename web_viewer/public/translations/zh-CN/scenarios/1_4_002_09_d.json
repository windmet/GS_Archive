{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_09_d",
  "source_raw_hash": "sha256:aaa4280ae5ca9ee3ed0fbdf6ef4cfd52b40e282710f308892cc917d33fa12100",
  "entries": {
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000010:time_caption:000": {
      "source_hash": "sha256:b7ef90919d0bb6a271fce71dc09f8d8f859b9157020620cdd2dc13d6033ae027",
      "text": "当天傍晚……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000024:dialogue:000": {
      "source_hash": "sha256:07d57c5f969095dc39eb7c2c3902182dbea62dea49f803f2279106a20022f27b",
      "text": "根据以往的竞猜节目推测，\n考到这个冷门知识的……可能性……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000030:dialogue:000": {
      "source_hash": "sha256:72ef578ccdfa7926a34e33bfeee98bd8247142c9dd14ba2fbc13d897098938c9",
      "text": "……唔，好困……\n但是，今天之内……要把这道题……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000058:dialogue:000": {
      "source_hash": "sha256:ad31190e069799d8f3016c7d39f58ff069c65a4301557707edf361f0c1289e4b",
      "text": "（这里是……）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000070:dialogue:000": {
      "source_hash": "sha256:b81e7a65dd14dc9ae5e0abbb6eb3179a9a604489b15b97c53d7b7268eed38e05",
      "text": "这个数字，是填在这里的吗……？\n可是，加起来就对不上了……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000075:dialogue:000": {
      "source_hash": "sha256:3b94176c8c3ac188e2bf6fc39ce9b978487a957c1363a6cfc9c9cab2f0c01def",
      "text": "……？是谁？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000077:dialogue:000": {
      "source_hash": "sha256:3b86946fc7503669c5eb4d01334cb0cab5946ef65a1abe941ff3bfb3e39904f8",
      "text": "你是……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000080:dialogue:000": {
      "source_hash": "sha256:fb35bd34d14747f3c0275f8117c28969a7ad937b637b60f987e4cf25a5850c7f",
      "text": "……这样啊。\n是孩提时代的，我啊……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000084:dialogue:000": {
      "source_hash": "sha256:b71ea8191d83fedab18046daf8829b8fa793eca1a0cb25f90a234e087e08d1c8",
      "text": "大哥哥也是和我一样，是我吗？\n……好帅啊。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000086:dialogue:000": {
      "source_hash": "sha256:dd324d13ce2314e8641e8ef7fe098cc86ac5a5237ae8d6ac1baca487de8e6da7",
      "text": "长大后的我，能长这么高啊！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_09:1_4_002_09_d:cmd-000089:dialogue:000": {
      "source_hash": "sha256:ac567b903c3a710d06fa7567c562f9e2186a993b378c9c757b0a4290fd014f46",
      "text": "大哥哥，再多跟我讲讲。\n关于长大后的我的事。",
      "status": "draft"
    }
  }
}
