  "scenario_id": "1_5_009kyj_1_5_009_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000011:title:001": {
      "source_hash": "sha256:8f17b79b4dc40e2e2e43e94b9a48f86aea60fbb365f6093095e8e7ef603eaad6",
      "text": "单元剧电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:7d774033641042cd498dba17719c424bbc1c87d3ce5a81f62d6678b6d5b168cc",
      "text": "“哈啊？你说什么呢。\n不是你让我在这里等着的吗”",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:44df0d9a3b31bb81a044b37c5a44c33f8772b52191ee0395d4c9e122e7ac5b23",
      "text": "“我可是一步都没离开过这里……等等，你怎么了？\n表情都僵住了”",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000031:dialogue:000": {
      "source_hash": "sha256:9c11e640d172fbab85525c4e5197e042b8213fc4f0f9bfc6dd4c240f0b1a4967",
      "text": "“后面？我后面怎么了——，\n哇啊！？”",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000044:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:79189bf6bd5bc672b1901c9bc131af9529f81a2e83fd868ca9aa6a9896867022",
      "text": "恭二先生，辛苦了！\n临场感十足，看得我心惊胆战的。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:4e71ae74b79570d1202971d92ee7952cc74dc99ee66c8775ea4463b9f622def4",
      "text": "导演也说非常棒哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000057:dialogue:000": {
      "source_hash": "sha256:e13054f86c80202d0ec603ec928c60b0778b87d21009dcaf2c1f2e14840a5cde",
      "text": "这样啊，太好了。\n因为是恐怖题材，所以很注重营造气氛。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000060:dialogue:000": {
      "source_hash": "sha256:8b5e1337684021d88c0bf5cb471938f2a22500c7f8722d003bfb19bb15ee587b",
      "text": "让人很期待播出呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:5227bc6ff163810914389dcf0c3ce26987163285ac5f69cc36db53014819acc5",
      "text": "说起来，皮埃尔和实先生\n说想一起看这节目来着。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000068:dialogue:000": {
      "source_hash": "sha256:d9f725e32656625cb2a4f0f32135742a703b97c1714b96f02490d0f363ebc5f8",
      "text": "虽然有点难为情，不过感觉最后还是会拗不过他们俩\n一起看吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_04:1_5_009_04:cmd-000071:dialogue:000": {
      "source_hash": "sha256:2b1b1b508d383ca4671130a3cf840c1001f5cb1c2d0d14ed992710e3b2c48a9d",
      "text": "反正都要看，你也一起看吧。",
      "status": "draft"
    }
  }
}
