  "entries": {
    "story-text:v1:042dai_401_2_4_042_01_09_b:2_4_042_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:3dc73c3f883bd6db0b36f7955465de68c426447a542ac4e5ff34842c72831d07",
      "text": "……哦，●●●●●●●●●●老大。\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_b:2_4_042_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c77e71bf6944815c2768fa3f613c0639d8a9d89d546ee7b95c3e59e9405e00d1",
      "text": "俺跟凉和老师聊了祭典的事，\n结果大家说好要一起去逛逛啦。",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_b:2_4_042_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:94d7f9bb3cf80255f1b5db7147ef77fae50eb9976bc3ec0abcdfa4e6578b8eb5",
      "text": "打算下次休假的时候去，\n●●●●●●●●●●老大要不要也一起来啊？",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_b:2_4_042_01_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:615e7ba8f6737b30ef2563b0e05e2aaa4bb8e40980053518cf95d99d816024ac",
      "text": "请务必让我同行",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_b:2_4_042_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:6d06ff12e23352c1f339409bbd531502454416f06652cf0bf960efd80571bacf",
      "text": "定下来啦！集合地点和时间\n定好了俺就通知你。多关照啦！",
      "status": "draft"
    }
  }
