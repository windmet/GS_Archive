{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_029ass_1_7_029_01",
  "source_raw_hash": "sha256:12fc457868f570add94a80e8a9feaeff18f4f65d26b3c396e652256b2a161626",
  "entries": {
    "story-text:v1:1_x_029ass_1_7_029_01:1_7_029_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:dafe3c70305b4b57385655e2b4d097b186119152a207ec12b2879f20c18bddae",
      "text": "阿斯兰先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_7_029_01:1_7_029_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:949f19f80518d0692c688451e9dc36acf910af43cac60e3e1c6a75b13a613c03",
      "text": "库库库，真不愧是吾主。竟知晓今天乃\n吾之暗之一族的重要之日。",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_7_029_01:1_7_029_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:6cb60ef91b99baab2d0e67da63099dbb095d593bb100c009119db1527665750a",
      "text": "今日乃吾降生于此黑暗之日……\n然也，正是吾之生诞祭！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_7_029_01:1_7_029_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:a9d3ba821f7f354838d948dfb18a61c1277a550b925055676f78ca75aa052ff0",
      "text": "吾主啊，吾对汝之祝福之辞深表感激！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_7_029_01:1_7_029_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:c72a4e6b3fc81184cd2705bd90e9f7502e2b4ab5eec002bd407f547ea2bbf04f",
      "text": "藉由此言灵，吾之暗黑之力将充盈满溢！\n以此神力，将光之民尽数染为黑暗吧！",
      "status": "draft"
    }
  }
}
