{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "031sak_401_2_4_031_01_09_a",
  "source_raw_hash": "sha256:cc02df643495dcb9f93ee536133a48d4eac939bb81493aa9c222a213e3f60ba5",
  "entries": {
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:20c29c2fe08e9f45ed15f2da3f5f9c3e0021412dad8c84a832302fe6c553035e",
      "text": "●●●●プロデューサー！今天发生了一件\n超级Happy的事！快听快听！",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:66f8ab70867c342358ce8366cbfab698317439f327639cc510c973d6bab43679",
      "text": "今天工作现场的化妆师，据说前几天\n去看了我们的节分祭哦♪",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:baaf130984a72edfb197389df7ac7ed1d238006b4dcad4cdf3c65ccf72936b54",
      "text": "然后呢，我们聊着聊着，其他工作人员也\n跑过来说“我看到节分的海报了哦！”。",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:2856e82ba4220d51fed25d104d6a40ed1153ad72a87d863487a872814e4be885",
      "text": "大家把我夸～了好大一通呢☆\n真的太开心啦！",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:497e2c126e0f344d7c8ff81b098273d9170cb9b658419dce1c781b2ce209ea0f",
      "text": "那张海报真的很棒！",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:470cded4b8dcafba14684c934373238e3bc50e92655ad4f63cb8d6702b88db0a",
      "text": "诶嘿嘿，谢～谢☆每次看到照片，\n都会回想起当时开心的情景呢♪",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:c359a1633d2c930d559976fa0990e9b53f078c60e3823abe47757b1fe576a238",
      "text": "恶鬼的装扮，还有在舞台上撒豆子，这两样都\n让客人们尽兴了，大获成功呢！",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:eed7523e9dc3a8ec221e846a3d5ae88c7ca5d86a58bddb462e481af2be6a96b5",
      "text": "●●●●プロデューサー，\n谢谢你让我参与了这么棒的工作！",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000023:choice_short:000": {
      "source_hash": "sha256:b258aaad3a528360ff1b7978d6878decb8f0dc8c3544fed9f26b0367a60396da",
      "text": "我才要谢谢你",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000024:choice_short:000": {
      "source_hash": "sha256:a82f56720ce2fdba872bc62cd6d8e8cf8ea0b5d7b4bfc19f60e483a51fd24bf6",
      "text": "今后也同样期待你的表现",
      "status": "draft"
    },
    "story-text:v1:031sak_401_2_4_031_01_09_a:2_4_031_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:4a0591c7cb1635aaaf4032eee6ff733bb081e65102563192e9047529989c30bb",
      "text": "嗯！今后也请多关照啦☆",
      "status": "draft"
    }
  }
}
