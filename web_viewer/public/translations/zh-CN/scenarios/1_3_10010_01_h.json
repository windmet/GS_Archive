{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10010_01_h",
  "source_raw_hash": "sha256:89d1924816bb84e9e4ae224d590fd9d018b828e7dfc09bf90692e92fc91e983c",
  "entries": {
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000022:dialogue:000": {
      "source_hash": "sha256:a7505f03d36868570d32c3e6ac2900db4a0526e44863ad93eba5eef253d24f3e",
      "text": "“喔啦喔啦喔啦喔啦！！\n跟上来就已经是极限了吧？”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000025:dialogue:000": {
      "source_hash": "sha256:96175cda5ea7a2c2ad7d4272a23c9ba7b98b903ac5cb8e7e5bd4073a84db38b2",
      "text": "“少在那边游刃有余了。\n从现在起一口气超过去给你们看！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8166de3b3931c07da966ad0a1d87d0c9739ba9728aa6662ac385639464961fa4",
      "text": "“什、加速了……怎么会！？”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000045:dialogue:000": {
      "source_hash": "sha256:924d955743888c65f30877126d113f8e7f191f6bdb7fee33a8abc14b809c3e39",
      "text": "“挺有两下子的嘛。但是……上吧兄弟，\n让他见识见识你极限的爆速！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000065:dialogue:000": {
      "source_hash": "sha256:0f2e507c91a64d9841891016ce2ce59ead57ca4ebd5a1dc06ba30e0e2e88c4f5",
      "text": "“噢！！燃起来吧爆炎号！！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000071:dialogue:000": {
      "source_hash": "sha256:51a36e2ca267c9a8eb75b09966b3d8df53223cea34d22fe456051235aafe3978",
      "text": "“兄弟，你也让他见识见识！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000073:dialogue:000": {
      "source_hash": "sha256:000b9f4fd229ae2a1e2cc4f56e84366f58d4ef775e17456944db8404b312ed8e",
      "text": "“喵喵～！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000088:dialogue:000": {
      "source_hash": "sha256:fd59255fa7add69c94d4e0532438950542ae78b40eb25bd154224353befd8d77",
      "text": "“应。贯穿吧，冰点号！！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_h:cmd-000116:dialogue:000": {
      "source_hash": "sha256:2c00cda4054752319d8663a457dbf51f61f9596ec0769fde64161750b12876ff",
      "text": "“跟得上我们兄弟俩吗！？”",
      "status": "draft"
    }
  }
}
