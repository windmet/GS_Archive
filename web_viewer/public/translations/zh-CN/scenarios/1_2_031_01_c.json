{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_031_01_c",
  "source_raw_hash": "sha256:e1781c4ea5b05404605e672473b1c05701a19f977429bdac83c0a1c420c2c40a",
  "entries": {
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000011:time_caption:000": {
      "source_hash": "sha256:5abb7839b6d2aff83fa956453c1c47a9e67d535a97489eeed18f176a4a585348",
      "text": "访谈当天……",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000020:time_caption:000": {
      "source_hash": "sha256:78ab86358eb02ccb4078c3d4db639a1a4d5489962b0852520b8bea3a6de233a3",
      "text": "访谈室",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:1d28cdd508181291d338cfa0d1e9f4facd4f4a01a35433b594122551cbfa994b",
      "text": "（哇哇，从中学生到大学生、\n还有社会人，好多人啊！）",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000039:dialogue:000": {
      "source_hash": "sha256:ed16a38918fb59d25a486a02b499a386e6537197156f9c3913306e7b76a33bdf",
      "text": "（大家都好时尚，超级可爱！……可是，\n在女孩子面前，果然还是好紧张……！）",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000046:dialogue:000": {
      "source_hash": "sha256:17c6fcec12a1f7f6f21bd33ec27e1d71f0c4ac4d85a4d27033471f044e4aca5d",
      "text": "那个……",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000053:dialogue:000": {
      "source_hash": "sha256:32eafa8ed5c6c86d6dd23437d7a07e58c553211a8949fffdb9b3fff0786a422f",
      "text": "（咲先生好像放不开。这时候由我来……）",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000061:dialogue:000": {
      "source_hash": "sha256:017fad64d85dc9cffaa42a24d37e14f886204f25e423dcf97abc28289d5bbec8",
      "text": "那么我们就立刻开始吧。\n首先大家互相做个自我介绍好吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000067:dialogue:000": {
      "source_hash": "sha256:f3424395c9d1309b8d06a8a7b05e1694da8d6be017cb85ed40bfcd332a755101",
      "text": "啊，对哦。太紧张了，都还没自我介绍呢。\n……好！",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000077:dialogue:000": {
      "source_hash": "sha256:d2fa91ae99ee99b9390dc14e42ba6de133ee574c2e82d53675cbf9e7e2970e1f",
      "text": "我是水岛咲。大家叫我咲就可以啦！\n各位，今天请多关照☆",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000084:dialogue:000": {
      "source_hash": "sha256:694d5c01bec6926512318fd806f45ee7c555ab166dfeac5da906149f4c715de1",
      "text": "咲酱……真人、好可爱……！\n请、请多关照！",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000090:dialogue:000": {
      "source_hash": "sha256:96df96b75d7b63834f3ac76fdb596a74624f670682042846eba84f5a2d9d861c",
      "text": "诶嘿嘿……谢谢——！\n超级开心的！",
      "status": "draft"
    },
    "story-text:v1:1_2_031sak_01_1_2_031_01:1_2_031_01_c:cmd-000097:dialogue:000": {
      "source_hash": "sha256:a3ec7c7b02bd65c7f86e79392501a86bc170f024c1f104c994e08c66fb411558",
      "text": "（……太好了。看来稍微进入状态了！）",
      "status": "draft"
    }
  }
}
