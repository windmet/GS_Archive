  "scenario_id": "1_5_002sht_1_5_002_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000010:title:001": {
      "source_hash": "sha256:fe3154d880b63e33278940e72bb6e1c4fceb5af8a44a0476d4ba85cb08d580fe",
      "text": "综艺节目舞蹈企划的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:5fd3a7289e8a1cfad627bae1e09d4cb7265e6db42f1360a9940950cc8c5da9af",
      "text": "终于要正式开始了～。能和之前一直跟拍采访的\n大家一起跳舞，好期待呀～！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:647e086c39e56c0a02bb574e3d2da7582d2609a891f4d549c503299ffa0ef698",
      "text": "这对喜欢舞蹈的翔太先生来说真是再合适不过的企划呢。\n贴身跟拍以舞蹈大赛为目标的高中舞蹈部什么的。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3d0342a13bb193042fda49074e0a2a8be032f986122b38a084cb913ea97d7fac",
      "text": "第一天去采访的时候，大家虽然都很拼命，\n但总觉得缺乏凝聚力呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:f56a5e8bccfc32a65c0605be48c9d21f9c9406a041e8d076f0a1cb3dab20a325",
      "text": "不过，在不断练习的过程中，\n前辈和后辈之间也放下芥蒂开始打成一片了。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:b93f7de7ad7f64ceffbd1b653256c4b91394f00ca25539a3ff1916f44788e80f",
      "text": "大家的表情越来越棒地起舞，\n最后一天跟拍采访的时候超级开心的样子。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:a778114c90eeb7a9ed660c0f44779928282261756759638a096415b0507ce8aa",
      "text": "舞蹈大赛本身是下周举办对吧？\n在那之前先在电视上跳舞，感觉能练出不少胆量呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:1fd2144a6b9c583bdda2140d273cefc979f8ae6bc140e31ece6d2038dbe7bcf4",
      "text": "就是说呀～。希望大家能把今天的演出当作总收尾，\n去挑战正式比赛～！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000045:dialogue:000": {
      "source_hash": "sha256:01f402f9a5e9a2eb1cdeafd34475c8674e0af43af4fd3e50e24634b64fe6084e",
      "text": "啊，不过在电视台的演播厅跳舞，\n对大家来说还是第一次嘛……",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:67e4e760ea3b0b99c50dcf0415c8fb0e0e8dba3bf83d0fff11ed4375ad934a52",
      "text": "嘛，不过有我一起跳，大家肯定也\n能像平时一样发挥的吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000056:dialogue:000": {
      "source_hash": "sha256:a099f9bc17fc6bc29d0cf7751d39ad8d04abf242d22542fbe146d4be171c0dad",
      "text": "和采访中混熟的大家的舞蹈，\n好好期待着吧！",
      "status": "draft"
    }
  }
}
