{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_306_2_3_043_06_09_a",
  "source_raw_hash": "sha256:adbb8872a4369f009ce4dcd74a73947c0ebf902fb313ab480ef859b4e95ac280",
  "entries": {
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:3c9538cd46c099953e00c247b37dee983a4d0a07f1fd5553526f07238522a93b",
      "text": "……辛苦了，●●●●プロデューサー。\n现在有时间吗？",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c2ea06e49395c995f3bd7a8d6d652844c344ac39420c8cd0bcaffe3c590c476b",
      "text": "……我读了大家对我们广告的感想。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:7047b6b961c818c3d8f792d9bd4c73c54a67d8d5c387cc36d9160ae90f2379ff",
      "text": "……信上写着“能看到和平时不一样的氛围，很高兴”。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:37e590e351eba0dea78408764a6a49358314d8954209777dd0dfd4c7f585fe7c",
      "text": "……虽然广告本身的氛围也是一部分原因，\n但能展现出集训的成果，让我觉得很高兴。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:024ad554313276df03e54457f282092b06dbc908c945e0b717d3a621e34f8cab",
      "text": "……因为想和你聊聊这件事，所以才打了电话。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:54f51104c6cf6a023ef95ae5e7a7926246a3831b65737de2a75de7fef17c357f",
      "text": "……成为偶像之后，\n很多事情都在一点一点发生改变。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:1f2765270320a49dd39eeae9596c1af6f67e7da0abb60650f4ddf88bfd92abc5",
      "text": "……不仅是我自己，身边的环境也是。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000020:choice_short:000": {
      "source_hash": "sha256:5be671b45759ca7969c6b578b15f24548c13bbef00432484c1868f810cf76c60",
      "text": "很棒的转变呢！",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:a6f6f0dfc7cca6efb84b748ea6b9f03b12bb7daf9a0e3b8e75ad5d4e30a3817f",
      "text": "继续挑战下去吧！",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:109cfa20b53246fdb62a2a6c4dc197ea92c2bafe75bd640a433c425e5316b271",
      "text": "……嗯。为了能朝着好的方向改变，\n我想在F-LAGS里继续努力。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:7e28a0b343f3a74c6ba998578cc3df6f44ac422a1abe14c67c56f29dad717037",
      "text": "……●●●●プロデューサー也请注视着我们。",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000029:choice_short:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然了！",
      "status": "draft"
    },
    "story-text:v1:043kaz_306_2_3_043_06_09_a:2_3_043_06_09_a:cmd-000032:phone_message:000": {
      "source_hash": "sha256:069ca15d45d96245aa2fe1ef3e7646088fbeb3767065cc166f95adec62b8785c",
      "text": "……谢谢你听我倾诉。\n那么，晚点在事务所见。",
      "status": "draft"
    }
  }
}
