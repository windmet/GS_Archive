{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "020hay_401_2_4_020_01_09_b",
  "source_raw_hash": "sha256:78fc17b32a2919f297b5f205192026bc18f04625c5f889513a29400d16e31b24",
  "entries": {
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:71b7af04d16dd3bee5b4c452220c24c993d19e4ed40fa64786792d69545d503f",
      "text": "喂喂，●●●●プロデューサー。\n演唱会的服装换好啦！",
      "status": "draft"
    },
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:0e69b2071673742cd90c9f5193a5da4cac880713a5ba08f89be753dfdd9fa2f0",
      "text": "啊……窗外太阳渐渐落山了呢。\n接下来气温也会慢慢降下来吧？",
      "status": "draft"
    },
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:281ff7c3264ff9ab50a32d085dcb931ebb7a418b5a84b346ed3479513585765c",
      "text": "会冷吗？",
      "status": "draft"
    },
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:618146161b2fb0381c9170601d4ea181bde8b57b877fee496788844e47d6b149",
      "text": "保暖措施做好了吗？",
      "status": "draft"
    },
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:238e0ad8b20fdc0947cc4769216c95f40a65c9202dbb2d50274049dc4dd6ccaf",
      "text": "没问题的！多亏有了\n毛茸茸的斗篷和大衣，一点都不冷。",
      "status": "draft"
    },
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:31096d64d259ae3ce6ba3bbc00c2f41534e92fb6d75697109950385e3d366714",
      "text": "演唱会中表演也会更加投入，\n说不定反而会觉得热……？",
      "status": "draft"
    },
    "story-text:v1:020hay_401_2_4_020_01_09_b:2_4_020_01_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:2b26201125ac9b0a971a3570dff5e895eb7cfaadb3c47de2a7e6cf31d568a836",
      "text": "我们会用足以融化积雪的火热演唱会，\n把会场的寒气统统吹走的！",
      "status": "draft"
    }
  }
}
