{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10006_01_c",
  "source_raw_hash": "sha256:645450afab3af7403bd72eb47fafd0dbb5f825e4a3c38a56e92b2c76ee568d48",
  "entries": {
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000019:time_caption:000": {
      "source_hash": "sha256:de032b14ad770092a08e64ee0b7359b1bdf150548e5d96e8eacb1487cc8ae481",
      "text": "翌日……",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000023:dialogue:000": {
      "source_hash": "sha256:ac8b3d0b3eb1b955aa95678979e3bff380a7055332c8805f314d25605d85bc08",
      "text": "（好，邮件确认告一段落了。\nもふもふえん的大家在……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000042:dialogue:000": {
      "source_hash": "sha256:d3e635b61c893a749d2f2bbf57b37f51b832f362a27f6b6812935177cdfa77e4",
      "text": "哇，直央君作业已经写完了吗？\n好厉害好厉害～！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000048:dialogue:000": {
      "source_hash": "sha256:5d2689e4f36399d432fb5f0a26342a9de1ec8fe2d8c30844e14dbdeb95665e5f",
      "text": "谢、谢谢。你们两个，\n要是有不会的地方我可以帮忙哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000057:dialogue:000": {
      "source_hash": "sha256:b0e019df6c5eaa48247a26fcb637b667e84c3be0496ba7e38c917bd855d466ea",
      "text": "可以吗？谢谢你！\n花音这里不会做。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000072:dialogue:000": {
      "source_hash": "sha256:7c06e89b2a5dc07b2c7faacee17b50b879f146eb16f4074e7138de1847daf53a",
      "text": "……我就算了。就算不用直央教，\n这种程度对我来说也是小菜一碟！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000085:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "数分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000098:dialogue:000": {
      "source_hash": "sha256:dcade97c8450babae4541908b189ad48886a6bcaa6185090cd12c85cc44151c3",
      "text": "写完了～！\n直央君，谢谢你帮我♪",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000105:dialogue:000": {
      "source_hash": "sha256:2e29e42a72ea447ecb86b6a79bc4ae8421564a69f0121c9ad6572c9b5c9a8294",
      "text": "不客气。\n那个，志狼君呢……",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000119:dialogue:000": {
      "source_hash": "sha256:bed1e6eb6679236135ca2184cb3d63a58c0f9723b98ecba904310d0496c81eab",
      "text": "还没呢……不过就差一点点了。\n休息时间里我绝对能写完！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000135:dialogue:000": {
      "source_hash": "sha256:1329d09ac6df1ef4f8566ca2de9369b758ee29e5a51f1ff542b22a855365ae75",
      "text": "（志狼君，好像写得不是很快的样子）",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000139:dialogue:000": {
      "source_hash": "sha256:16b6959643688334829ec76b4b802d4275aa5442005f732561f4eb46d6898f23",
      "text": "（本来还想着写完作业之后，让志狼君\n教我跳舞的……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_c:cmd-000146:dialogue:000": {
      "source_hash": "sha256:650c834a1257999999530be933d1f339704f1a59955c8b986d5e116c62a6ade8",
      "text": "（……啊，有了）",
      "status": "draft"
    }
  }
}
