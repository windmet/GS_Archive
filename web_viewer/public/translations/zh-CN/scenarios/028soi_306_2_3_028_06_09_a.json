{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "028soi_306_2_3_028_06_09_a",
  "source_raw_hash": "sha256:f8deb68cd9c44a61ad205acdf6aa8f38422fcab1fa7b9d062e753f11bcf3a756",
  "entries": {
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:ecb01c23947947acfff0a00b7177d8293c3d572470c152935bc933e32a43ed77",
      "text": "●●●●プロデューサー。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:17106b44773e91a77e036dbd9c1850be431fb38439a4a605c04bf2f84fda8c2c",
      "text": "关于这次联名合作店铺的事，\n我想再次向您道谢，所以打了电话。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:5d8fa9287e827d13824853306464d738f8cb17f361135e79841d40254a16524f",
      "text": "为我准备了能专心制作蛋糕的环境，\n真的非常感谢。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:8ca90dcd50f50d0e853cafcf2e8f2511276ae35e59e9a35afb4b553745b2343a",
      "text": "前往巴黎，连我自己都觉得\n是个相当大胆的提议。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:e8ccfacd8fa80671bfdb2ce3692f2b8341a964b174ad26e9ad53b6fac3307be8",
      "text": "但多亏如此，我才得以做出了\n令人满意的蛋糕。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:162e03e10486ae2dd86db23d05895b1fc06967e4bc6c03f872fe2023addc0277",
      "text": "是非常精彩的\n蛋糕！",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:f20dfd74366b347b821c028f02847ecee9df6a2d5416f3633c8b705f67a92781",
      "text": "联名店铺大获成功，\n我也很高兴",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:dbae64dc6e8c8961f6112b61a3c5543664e6cd707c8ecb7656339aa5bfc04df8",
      "text": "谢谢您。\n这也是多亏了大家鼎力相助。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:1cec252ef576267114390f4042f27ea2b6b50f241ee90a16c21d600d64467227",
      "text": "是的。对于在我不在的期间推进准备工作的大家，\n我也必须好好感谢呢。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:9baf1628c8f0d134df142f8ead0bf5df5a48671df267e66e00e20ccd2db419f0",
      "text": "我打算重新为大家准备一份谢礼。",
      "status": "draft"
    },
    "story-text:v1:028soi_306_2_3_028_06_09_a:2_3_028_06_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:018fa6135a1051d135928901ca729b8f5f48ee6c36c2ad01094c2a75ccacabe5",
      "text": "届时我也会邀请制作人。\n请务必光临。那么，回见。",
      "status": "draft"
    }
  }
}
