{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_001_01_e",
  "source_raw_hash": "sha256:121e0477e9e7518bd81297dda22d87acd0eddcaa7b3983cb575f847b9e0e6467",
  "entries": {
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000024:dialogue:000": {
      "source_hash": "sha256:36ffcca4795881890fd3075c4a3c6fb15b4a1192e5d96515c661f7e5d06c2828",
      "text": "冬马，昨天恭喜你啦！\n真的拿了优胜，太厉害了吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000030:dialogue:000": {
      "source_hash": "sha256:a5859d307d6df00fc7f21449b7714c4419d5fb3e139a717760d8f0958dc0263f",
      "text": "噢，看到了吧！正如我宣言的那样拿了优胜。\n你也别忘了约定哦？",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:4ef3ff2afa1dca14dac4469ce5d431dd578be019a4cc6800dc4a6c9465fd0259",
      "text": "塑料模型对吧？我记着呢。\n作为优胜庆祝，等下先出去玩吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000040:dialogue:000": {
      "source_hash": "sha256:b703f3e65d57620ca113552db75b12427145b54d69b6402492843dd34b3d8fb6",
      "text": "啊——，抱歉。\n今天稍微有点事……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000043:dialogue:000": {
      "source_hash": "sha256:fd97766d67ea0c4e1ef66e56118d44d84b9849f2e8bb9a7b275c9613170c82d1",
      "text": "啊！难道说马上就要去进行演艺界的工作了？\n冬马，干劲十足嘛！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000048:dialogue:000": {
      "source_hash": "sha256:d2ad3fb9b2a49946055ed6c32cfc70d8d0b9353ff327ca8cb3b6d7305c7ca395",
      "text": "才不是那样呢。\n总之，庆祝优胜等下次吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000061:dialogue:000": {
      "source_hash": "sha256:a7f9dceee82da1aebe56a8681b5e8d2c6f6f1aa99014bb4855346a425d649888",
      "text": "这里就是大叔指定的演播室吗。\n话说回来，这到底是什么演播室啊？",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000066:dialogue:000": {
      "source_hash": "sha256:ab5612f82bc946f0a4f58cd449b358752af796cdd12e5d186e92d11c0e16a7ec",
      "text": "便条上只写了地点而已。\n……总之先进去看看吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000084:dialogue:000": {
      "source_hash": "sha256:f49bf9d6db0409338460c96d0399f55541b10e3cbf6674020955a59994762b59",
      "text": "这里是……摄影棚？\n为什么会在这种地方……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000095:dialogue:000": {
      "source_hash": "sha256:0f3f1ec06cd1799786112dc1df3a0352e5f659c4bba9631b5e43482627eff7c9",
      "text": "哎呀？你是……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000101:dialogue:000": {
      "source_hash": "sha256:1712cef09611ef1bfe4a8a6d79ff384e41fb2634852a8036cce7188712ed7f64",
      "text": "难不成小哥也是被黑酱叫过来的？",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_e:cmd-000111:dialogue:000": {
      "source_hash": "sha256:3a4f4c3a5917c9d5b406b818a61b36e962063be3f3769ebc58dfbed479aedbb8",
      "text": "（什么啊，这几个人……？）",
      "status": "draft"
    }
  }
}
