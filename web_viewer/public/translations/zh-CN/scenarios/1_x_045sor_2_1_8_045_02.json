{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_045sor_2_1_8_045_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_045sor_2_1_8_045_02:1_8_045_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:4f96388b7583e944952210c20dc3fc8c66799b0976a9db19d74dc130d86b1b6f",
      "text": "●●●●プロデューサー，辛苦啦～\n我这边刚才工作刚结束呢～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_2_1_8_045_02:1_8_045_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:281f2368640e93d3af3f4faab2a9a180709797f82cf34e20d44507d67ada1ded",
      "text": "我想着来和制作人聊聊天，\n就顺路来事务所了哦～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_2_1_8_045_02:1_8_045_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e35b55b1f90700a8f465fab4f2d956ff03a84da5384b7da899db3f9e04ab1920",
      "text": "祝你生日快乐～，是今天吧～？\n虽然稍微有点迟了……",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_2_1_8_045_02:1_8_045_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:40b58c0585beef71cf6260ee3b3091d5cccd57281cc4f36b43261b4b6ef576d3",
      "text": "非常感谢。不论何时收到祝福，\n我都非常高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_2_1_8_045_02:1_8_045_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:720c7569ea9e7295c2683b3463649c335b472142cd7c4dbaa5c3126faf4a3449",
      "text": "暮色苍茫里，贺音犹不绝。\n接下来的时间，也能过得开开心心就好啦～",
      "status": "draft"
    }
  }
}
