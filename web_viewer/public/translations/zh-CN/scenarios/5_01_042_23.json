{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_042_23",
  "source_raw_hash": "sha256:1f41ac9ee253b6c1aed981c9c67745c75f2ddf90af5451a542ec3e5625535f67",
  "entries": {
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:71dd99589140e4de78d39e923d1104c40f78d97c018bbe01275343756e97b8de",
      "text": "●●●●●●●●●●Boss！\n今天巧克力多谢啦，超级好吃的！",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:7d6c9c9624a92d6b39d4e29e955e5b45c664b431159d9fca8c984e008e096bce",
      "text": "托你的福，俺现在还精神饱满得不得了呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:eeb2dd6f448d74263319207da36c6863afedc8a43f9ef41ba7094b89db7ce8f6",
      "text": "那真是太好了。\n为了让你元气满满，我倾注了热情哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:05066869582481ffb17105e1135f34a44b14c5d09ba1be72b32d39752ddf9148",
      "text": "原来是这么回事啊！怪不得，\n俺感觉充满活力得还能再干一份大活呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:9d267a0d484b46cf1155a495d6f7d9707e921f4785ea4feb4240853fc27890d9",
      "text": "对啦！今天在来这里的路上，\n俺发现了一家看起来很好吃的甜点店呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000039:dialogue:000": {
      "source_hash": "sha256:d129d50625d850b1687c527b2a19e8857de6d9e1b8a9f9fdfe9f70fb5acee8d4",
      "text": "听说那可是情人节限定的商品呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:5b847550e664c6a45c09dffe25031660477348735d1ef6f17eec5916140b4bb9",
      "text": "如果Boss时间方便的话，现在要不要顺路去逛逛再回去？\n就在这附近的店哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:cd3ef3949f481e8ce13f0e261293f7f7668411f0417e98f97d644552e7f03f0f",
      "text": "时间完全没问题。\n大吾先生发现的那家店，我非常想去呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:bacd742b008611806adc2adafbe2a32555390a053ad694f3fe5174cd920517b3",
      "text": "好嘞，就这么定啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_042_23:5_01_042_23_a:cmd-000062:dialogue:000": {
      "source_hash": "sha256:925bd8e835a3a559fac5483959b55a34c59bf7131b17bd376329d65d3e4ea3fc",
      "text": "带路就包在俺身上吧！\nBoss，这边这边。跟着俺来吧！",
      "status": "draft"
    }
  }
}
