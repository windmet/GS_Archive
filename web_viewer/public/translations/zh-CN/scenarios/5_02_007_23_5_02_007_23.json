{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_007_23_5_02_007_23",
  "source_raw_hash": "sha256:7d5e7f80b4ed3640026eebea088750ac8953298b0cab275e84b95d7dabb24819",
  "entries": {
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000014:dialogue:000": {
      "source_hash": "sha256:bfac803ce2e38a02a94616cf4ca67a01e6dbe54d7e21d2668f0246f9a6643522",
      "text": "欢迎回来，●●●●プロデューサー。\n我一直在等你哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:e72654ccd284fb614f3eb3b4c1790636ad14c8372d6093aaca94b15d949af983",
      "text": "圭先生，辛苦了。\n请问有什么事吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000020:dialogue:000": {
      "source_hash": "sha256:974266261046e9426e0819e959de397805462717ab573af2adddc03ad15de553",
      "text": "嗯。\n我带了白色情人节的礼物过来哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:43f7af6950cc367c103d7559c33e82af4970db858b02e2cc3019076d1cc71d22",
      "text": "情人节的时候谢谢你。\n我送你的回礼，愿意收下吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000026:dialogue:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000030:dialogue:000": {
      "source_hash": "sha256:256c12ad3a36b2bf1de98efea90fd4bd77ed0d96d664c91bedba9ffe0bf4580a",
      "text": "里面是香草茶哦。\n香气非常怡人，能让人放松下来呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000033:dialogue:000": {
      "source_hash": "sha256:5a833523d33eef0bfc65420ce0b89bb024375bea5de10d57441a98559ab6baa0",
      "text": "制作人也试着尝尝看吧。\n我想能睡个好觉的。",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d786231f65b22793ce7f11d71a57300876229b086057a4637c0d0fd1ceff90cc",
      "text": "真高兴。\n今晚我就泡来喝！",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:b03dc24dccdedabe2a7c09ef5a480c291bea1dc186d90f4f2af7ca7d9b0da5d7",
      "text": "嗯。愿制作人\n能做个美梦。",
      "status": "draft"
    },
    "story-text:v1:5_02_007_23_5_02_007_23:5_02_007_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:2babd7cc31316fed96daa9ed34d140b46390d2d9b5f0f519f21daaceb9d020a8",
      "text": "那么，我也差不多该回去了吧。\n待会儿见，制作人。",
      "status": "draft"
    }
  }
}
