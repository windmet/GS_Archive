{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "016sei_402_2_4_016_02_09_b",
  "source_raw_hash": "sha256:fda9637532fc2323060b1fd3943486d05a697ef47d45fad3ae59439fc0f0c6a7",
  "entries": {
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:8a1bbbd0dff5cf49513043ba4f67dd5ac156bba550d491ad3fa927ee69cdc35b",
      "text": "喂，●●●●プロデューサー。\n早上好。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:cca5b6501a04bb9494f094cdbc66ff7a923244c776d7103404751c85338618b8",
      "text": "终于到了今天圣诞集市的特别演唱会了呢。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:9fae7ec556569cb0a99343778e7b6658788403804abfef683a34723fa8f1131a",
      "text": "能成为一场精彩的演唱会\n就好了呢",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:d66f8bb33c70e4e86b8fd66cef0d335dde61602264e0f242bbecbb8df3561f7c",
      "text": "嗯。办一场能够驱散严寒的、\n最棒的演唱会吧。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:fb2051624b8a76289788c9465125b03d057eae503c5ce0640d29af22d2b7e391",
      "text": "为此，也必须展现出不输给那棵大圣诞树的精彩表现才行。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000017:choice_short:000": {
      "source_hash": "sha256:5a2e141c4ebee327e02e53799df9eb5ba58be3a3b86c3c11390a2e026b6e3a56",
      "text": "那可真是责任重大呢",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:6d71466f57945f09c6d0763206953fa0c99191ea5e12d0102e10a8c8d96a73cf",
      "text": "当然，目标一定会达成的。\n那么，差不多该出发了。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_b:2_4_016_02_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:1ea62c957e64bcd27b2196374f77ea8ba4d4310e5d8de901b5757a2c10a49973",
      "text": "待会儿见，制作人。",
      "status": "draft"
    }
  }
}
