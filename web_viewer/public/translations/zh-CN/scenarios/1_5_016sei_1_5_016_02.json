  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000010:title:001": {
      "source_hash": "sha256:ea08fdc5fcffb944a3defef50a32f202493028ac074ae41f62553e5ea2fe63a2",
      "text": "访谈综艺节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:e11f834c8bb528113ff64f58f7c2d5bbba3e0bf822b52c2aca0f23c3d70f0429",
      "text": "诚司先生，准备好了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:b87ea573396d226b03f5712071964d8b20820ca7d7eabd79b4cfde66e6a3483e",
      "text": "嗯，已经在彩排时跟教防身术的讲师\n对过流程了，没问题。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:1c202325ad5ed5e007c9c5132dcb96ba43ad3ddf1eee8aafb2d846951f33750f",
      "text": "稍微切磋了一下，让我想起了自卫官时期的\n训练呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:e9dddbc6797cf5d7973cdc2ec8dfb35e401fb4f5425d8a9d11807ccd3f3213e5",
      "text": "讲师也夸我有天赋。\n告诉他我以前是自卫官之后，他吃了一惊呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:e4352d30755d2bac87f10f53991df6a70bd9a0f474632f2e6ee3683be6ae5486",
      "text": "彩排期间您也一直在活动身体呢。\n看起来玩得很开心的样子。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:fbf28bddf88787edee0661479d63ce734ca080fafe61c019729c0a5db9daa594",
      "text": "是啊！毕竟我本来就喜欢运动身体嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c1b91b8c5e3875c6e9cba1439bd5a0ddc33d5bfbf47b9244f67e90efdb145d17",
      "text": "对方也说了不用客气，久违地\n能彻底放开手脚活动一番了！",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:f27edb47aa92de826d0128baf8baf824efb74479332b8699aa057d302123601a",
      "text": "电视机前的观众们，应该能看到\n很多诚司先生帅气的一面呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:5cd666b3787dc54a17168dfcdbd713ee25797a4cc46dfdc98523e3a370d7d619",
      "text": "为了不负期待，我会竭尽全力的。\n那么，我出发了！",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:40080583766ea198270ffa605fccd42e15b6bbdeb7d1f11b3ac57e1b92a5b2e0",
      "text": "好的，路上顺风！",
      "status": "draft"
    }
  }
}
