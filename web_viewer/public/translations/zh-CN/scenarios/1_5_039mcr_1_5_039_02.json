  "entries": {
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000010:title:001": {
      "source_hash": "sha256:d92dfdeacf1e859cfb9a281e5073763d94d2bb8b7024c4b79349b6d9d4382a50",
      "text": "柔顺剂广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:a20291c662de38984ee01ba1dabe6ac2449eebde6e5a1f0a5fee2a68ced62336",
      "text": "道流先生，柔顺剂广告的工作定下来了！\n这是相关资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b6ade7dd6a3df48f5e52fe49eeecb70ce112e0273f614378e4e3f389f2be68f0",
      "text": "哦，这家厂商的柔顺剂，\n我自己也用过呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:c2119c1701f144262c0624cc42c5633f5a7b01d7d1c2bccc7e2b218023bfeeb6",
      "text": "香味很柔和，洗出来的衣服蓬松松的，\n最棒了。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:c7984b6540826d244e6ad92b7ea345dcc6062c8372b62343bdcbd9d695d0e39a",
      "text": "那个，广告的内容是……",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:e92415c6ef104c714c9d2ea322762065e214dab90a9ebb49db60e9dbc623c58c",
      "text": "在蓝天下晾晒衣物之后，\n扑向晒干的衣服堆……这样。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:c05d62d58dcf15d6b6870390b58808a5168b293992a89f9bf09f3eb1a51cb1dd",
      "text": "那是虽然很想做但平时根本没机会做的事呢！\n啊，这么说来……",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:6223f5439def2d6104b6def248347fccfa558a37e29a1f924c3cec7716f9c7cd",
      "text": "之前在男道拉面二楼，涟曾经直接睡在\n刚收进来的衣物上面过呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:edb569bb3de2b925df6e318ba355d397044b924c4577989e6524660d80ee7f06",
      "text": "当时他睡得实在是太舒服了，\n我还稍微有点羡慕呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:4e9d765ad78281be4bc5f61774801c29ade2208d086d6617246df53cf0c3afca",
      "text": "这次轮到道流先生去做了哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_02:1_5_039_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:c92edc81b2e6f079f5bab5a61d53668d96f9400379d242f5f33d118fcaa1d027",
      "text": "哈哈，说得也是。\n我会尽情往衣服堆上扑过去的！",
      "status": "draft"
    }
  }
}
