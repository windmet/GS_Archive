{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_002_23_5_02_002_23",
  "source_raw_hash": "sha256:cfa74f301a6b8873040b79f7d604333c01d20864f11e34a7e94a2be5f277cc2a",
  "entries": {
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:f3c5fee0af9cbc3da53afa239ac5e54b2a8198564d00619e06e147ae258f064c",
      "text": "早上好——！\n制作人，今天是白色情人节哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000023:dialogue:000": {
      "source_hash": "sha256:24e71a8822dbd884c3d71ac8ff69cfd0fb40611026e3f525a059e0d61282e7d2",
      "text": "当当——！看，这是我的回礼。\n我好好准备过带来了哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:2e8edc9e65ad3d7b837e5b1a3699430107454837564996fd147515d6afc2f5a3",
      "text": "非常感谢！\n连盒子都非常漂亮的巧克力呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000034:dialogue:000": {
      "source_hash": "sha256:c3db7d2998ae3d7036ad492fd177e022b57356902ac096365e89f302df163b47",
      "text": "是吧？为了能让你高兴，\n我可是特别讲究地挑选出来的呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000038:dialogue:000": {
      "source_hash": "sha256:33101ac7b468565a94022d9eda02cb14903c12e16092391f31288fee7acdbe9b",
      "text": "只要在和我的游戏中获胜就奖励给你♪",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000043:dialogue:000": {
      "source_hash": "sha256:da541ef321ca36b15b9ad239f2aa39d9402f41d0d8cd77a8b5d0604f410b0062",
      "text": "让我想想……\n来玩“看这边”猜拳怎么样？",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f16e7bdadad0b3a7fca31363f75ed5e73547d0f594bcfbebb270d8de390f228c",
      "text": "只要制作人赢3次，\n这盒巧克力就作为奖品送给你！",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000052:dialogue:000": {
      "source_hash": "sha256:18bda10132e269867a71448df4f70dcb4c8c0c868457d522f5f496637689c701",
      "text": "那我可绝对不能输呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000056:dialogue:000": {
      "source_hash": "sha256:b8a0c2de182762f2ab06e155874eb796e4594c5555905e12c62750235bbc215f",
      "text": "这可是真剑对决哦！我可不会放水的！",
      "status": "draft"
    },
    "story-text:v1:5_02_002_23_5_02_002_23:5_02_002_23:cmd-000061:dialogue:000": {
      "source_hash": "sha256:72b4723000e5c059e5dd942725655e884de79967a9d42cde2693f02c607db82a",
      "text": "那么要上咯——！\n石头剪刀，布！",
      "status": "draft"
    }
  }
}
