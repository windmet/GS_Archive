{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "019kur_401_2_4_019_01_09_b",
  "source_raw_hash": "sha256:9b1dcb0cb02748e33f1946b052dad840db7d5bcff853d571c05752399ef88245",
  "entries": {
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:405f50b054fc58dee6d59c1488b15dc088da809d1964fa32b16c4f721cc3cd4d",
      "text": "喂，我是清澄。\n刚才试穿演唱会服装回来了。",
      "status": "draft"
    },
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:88ca3bdd094ecf031e3f7340a4f0bd77ea3ab4d4de5ee84db8369c9984ff1b6d",
      "text": "尺寸没有问题。话虽如此，\n这次的服装设计也很讲究呢。",
      "status": "draft"
    },
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6f84b5001122957dfe9a031d0e4b90fe556d6cc9ae495ebc572ac2099013fb3e",
      "text": "虽然是对我而言不太熟悉的气质，\n但我能驾驭得好吗。",
      "status": "draft"
    },
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:9f05f8e11bc01c995a9f1ef6854b0cd30408d61f037bbb133c450f17c7bdb5af",
      "text": "九郎先生一定能\n穿出风采的！",
      "status": "draft"
    },
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:acc1fd4ca985ae25dfd401a046ccb590b7e20457f397144543f4e1c7cc8ab7b7",
      "text": "只要满怀自信去穿\n就没问题的！",
      "status": "draft"
    },
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:5aa3940003205a4030d5d50b858a80f4450290ac23334dc8859b71383bed6c22",
      "text": "谢谢您。\n说得也是。我可能有点过分担忧了。",
      "status": "draft"
    },
    "story-text:v1:019kur_401_2_4_019_01_09_b:2_4_019_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:8e301a0c8bd49abba1deb2a9cec9ae8ad57552db7c45b3d2b6746c6c1c4407c9",
      "text": "当天我会昂首挺胸穿着那身服装登上舞台的。\n敬请期待。",
      "status": "draft"
    }
  }
}
