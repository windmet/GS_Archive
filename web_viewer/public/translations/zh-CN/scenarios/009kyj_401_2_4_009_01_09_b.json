  "entries": {
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:d3dab35789a350cdf26810dac903f0f0843c6843f842e411fed78c421a473edd",
      "text": "喂。\n我这边演出的准备做好了。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:8a29faec716ba137bb0481d8eb41a74affc277131b4200f506f7fa5d0ca4f28c",
      "text": "会累吗？",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000009:choice_short:000": {
      "source_hash": "sha256:a1e7c635987f4c353d0c7f62b7410c1e86d5eba686ae8137cae1797c9f1e6895",
      "text": "稍微休息一下也是\n可以的哦",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:8359ef81f4a9de4ec6a09542152baf7748360bfc08abaf4e394764791ee53f74",
      "text": "虽然出了点汗，但没事。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:20deefe18cf6494bffccc964ccbd4c9763b48ef990ecaf4be916f660496dc239",
      "text": "嗯……？啊，我没事的。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:1179090b61f4fcefc77366a6ca8463b8e8063c0518bf15b5013186fe66d87716",
      "text": "平时的体能训练就是为了应对这种时候\n而努力做的嘛。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_b:2_4_009_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:38b2f6821fd547ad3a60cac58866b40c4de78b66f4a6b8b50df3ca50244a9932",
      "text": "接下来在舞台上，我会全力以赴的。\n敬请期待我们的演出吧。",
      "status": "draft"
    }
  }
