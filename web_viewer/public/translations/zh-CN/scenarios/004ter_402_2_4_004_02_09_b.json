{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "004ter_402_2_4_004_02_09_b",
  "source_raw_hash": "sha256:bc5656780d69bfd9a392f9342d3d4432c0ac7f90ed1999a401e26e172567a021",
  "entries": {
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:623132c2655ef8d375a18301cb59c762d48aaf188cd479f54edb99808151ce36",
      "text": "不好意思，制作人。\n雨突然下大了，我可能会迟到一点。",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:f3d6a982233141bf32356666af70ac99d792c038eca48cf8c2d387e5cbbe462d",
      "text": "已经到事务所附近了，\n应该不会让你等太久，别担心。",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:5d6aa5ce4dd917e202abec6942f1e21bcb578fc231ea810a1765895e8ed65494",
      "text": "要我给你\n送把伞过去吗？",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:3c7c52943cf4d5f491b881a353d57f77304e03d24c3c22743d96857d1c3180de",
      "text": "可以吗？你那边也很忙吧，\n不用太勉强的。",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:26a3322290beb7a98549d3b4d315e576ee1ec367f0b4fff27ef12755680ea83f",
      "text": "就这个距离，实在不行一口气冲过去\n也不会淋得太湿。",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000019:choice_short:000": {
      "source_hash": "sha256:11903bbeabd5af825a3aee3e3d53e0d1b91abb3976796a5c596e229eefa52fd2",
      "text": "可是感冒了的话\n就麻烦了……",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:b5761346f90f480ff2c7b9dc3dcd101cabd2363df1d3f76df23b32569e757e39",
      "text": "我很担心您的身体，\n还是送过去吧！",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:12ed2104d2e0f4a1cf034e415e3b1f925bb828f961c34dc67535283ad58b95d4",
      "text": "哎呀，也是啊。\n接下来还有工作，受凉了确实不太好。",
      "status": "draft"
    },
    "story-text:v1:004ter_402_2_4_004_02_09_b:2_4_004_02_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:07ab00da0cb2c2901ae39de9e1761377d4a190b2b84baceab27ef959bc765b2b",
      "text": "那真不好意思，还是能麻烦你送把伞过来吗？\n我在转角处的大楼前面等你哦。",
      "status": "draft"
    }
  }
}
