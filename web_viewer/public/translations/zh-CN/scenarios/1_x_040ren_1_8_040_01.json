  "entries": {
    "story-text:v1:1_x_040ren_1_8_040_01:1_8_040_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:3acdca8da41d736d613f0e9833706aea01a28b732c9b075cd38f6574df4d152a",
      "text": "喂下仆听说今天是你的生日啊",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_8_040_01:1_8_040_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:f826ed59536f04d7a65241034b8e3ce4a61d1f0e7c48d836c8aa6d6e42b35e06",
      "text": "最强大天才本大爷就勉为其难给你庆祝一下",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_8_040_01:1_8_040_01:cmd-000013:choice_short:000": {
      "source_hash": "sha256:0f1170f22c9e7d89e514a61c7d8707bb90e9f5ef269a17ab9db216c7c76ae46c",
      "text": "太高兴了！",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_8_040_01:1_8_040_01:cmd-000016:mobile_message:000": {
      "source_hash": "sha256:36fd006d411546c03c90c58add69134310cf43c174c210aef1aac1a563a610a4",
      "text": "都是拉面店那家伙吵着要庆祝本大爷才没办法祝的",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_1_8_040_01:1_8_040_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:e5bbb4cc653f465686ad0a5d217df03c1f2a66d98e998256783fa7d4377fdcd3",
      "text": "本大爷特意屈尊给你庆祝了给本大爷感恩戴德吧",
      "status": "draft"
    }
  }
}
