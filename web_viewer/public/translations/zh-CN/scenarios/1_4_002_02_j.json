{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_02_j",
  "source_raw_hash": "sha256:cb39625ac2b518f880f37a765ea40ab99f5bc64258804ec8bd843cb40b241257",
  "entries": {
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000019:time_caption:000": {
      "source_hash": "sha256:5c33739c98c44282714bf00a1901e327fa07cbb3d9bde6fd144cdf48db5571c2",
      "text": "最终决战开始",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000031:dialogue:000": {
      "source_hash": "sha256:b08d528e0e859caccba22e2b0f86294283a59f2812dd0592333b65498a03c6dc",
      "text": "怎么会变成这样啊……没有你\n可不行啊。让我听听你的声音吧！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000033:dialogue:000": {
      "source_hash": "sha256:7c61a4cf8d8ec174c1df7839240d1a74a42c1527d0e4fdd3c5b57e25234d0d85",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000037:dialogue:000": {
      "source_hash": "sha256:76f473fa90b68906d29858122612fc6ee95735cc4133039c464bc9c1bc7882e9",
      "text": "毫无反应啊……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000053:dialogue:000": {
      "source_hash": "sha256:840f3debfba6dee3a587f865f34cdcb0fff41bee5a5313aa07629953c52d66ec",
      "text": "真是个坏孩子呢。差不多该起床了。\n让我再看看你那耀眼的表情吧。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000055:dialogue:000": {
      "source_hash": "sha256:7c61a4cf8d8ec174c1df7839240d1a74a42c1527d0e4fdd3c5b57e25234d0d85",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000060:dialogue:000": {
      "source_hash": "sha256:231d8a1b06dd1e9dc871d2a80317b14b0e9467b322c3756d0a436ae6b9037341",
      "text": "真遗憾……看来我不行呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000072:dialogue:000": {
      "source_hash": "sha256:00c13cfb24beb5bd32a6e0ca633d37fce770b8e3e5ca40c521348cb0b3c852b8",
      "text": "真是的，打算睡到什么时候啊？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000078:dialogue:000": {
      "source_hash": "sha256:d3e737d314909ce9831b41cf1578d5347009da0f6be17cad6a83bec12cde78a8",
      "text": "要是你不起床的话，\n我明天开始也不起床了哦！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000082:dialogue:000": {
      "source_hash": "sha256:20b20d0bdf2c5151ef301ed5292e4affe77541004a6bbd8bf778269db89db872",
      "text": "唰——！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000087:dialogue:000": {
      "source_hash": "sha256:7fd814533353e0cba2666f64b519bd3daee6a2b1e0f0f4acc4da81535362bad2",
      "text": "啊，亮了！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000103:dialogue:000": {
      "source_hash": "sha256:98bcd6ef40e29716a003a99a74681213c173fc6763cbed93ae113fa870449716",
      "text": "也就是说……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000106:dialogue:000": {
      "source_hash": "sha256:11378564b4847451741492f632bf372ffd2707f8099cd6d4f232c9262b9e1508",
      "text": "证明了翔太受万物欢迎呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000111:dialogue:000": {
      "source_hash": "sha256:63817ca6b98b89ca2f866d93433d7785fc133f4a04752b4299af16085bf7c1c9",
      "text": "不愧是深受大家喜爱的国民弟弟偶像。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000115:dialogue:000": {
      "source_hash": "sha256:063e86860f13fd8a99b9f71bafeddc65369bcc8d1fc07337ff5ac451575fcda2",
      "text": "我明明自主练习了那么久的……！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000126:dialogue:000": {
      "source_hash": "sha256:f1cf6545977a08f2c6ed87255f028fbf4800188a07b1a47de793968034508883",
      "text": "诶——……这和练习有关系吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000133:dialogue:000": {
      "source_hash": "sha256:e7dd7237c66909270622dcf775bd3eaf2d82da9681d6c2f1c277c82e35c4944c",
      "text": "不过，运气也是实力的一部分嘛♪\n这次果然还是我赢了！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000147:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "数日后……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000162:mobile_message:000": {
      "source_hash": "sha256:12d002fc93c47471b55afb0c7ba1d61945f14f9c79b35867f8599131b061a57d",
      "text": "那个万物的万人迷，\n我出场的那期是下周啊。\n今天可别看",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000164:mobile_message:000": {
      "source_hash": "sha256:fc63c43c99caa69859e9d64c5540fdaa03eb4118dadea5f4edb88d37ff67ef10",
      "text": "冬马？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000166:mobile_message:000": {
      "source_hash": "sha256:ef6e32999cd54d67eb60a8eb3f07b59f8225408c1fb98daf41d6ee5fdaf9a5f2",
      "text": "不是下周\n是今天哦？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000168:mobile_message:000": {
      "source_hash": "sha256:dc5a4d3d82f7e15792959dc661538ae0e541ce66494516f5c9cfd9cd3308494d",
      "text": "啊",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000170:mobile_message:000": {
      "source_hash": "sha256:49d22b15d4364f9b2866e995f63348e9447d3a49a1670048f339a6128045455c",
      "text": "，刚才",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000172:mobile_message:000": {
      "source_hash": "sha256:bea923529fd84a0472cb6232b11f91ac2cec86d4167652fc49d06460a403c037",
      "text": "啊——我知道了！\n是不小心发错人\n了吧！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000174:mobile_message:000": {
      "source_hash": "sha256:55a03788d49eae9c3dc3b7992dadc545fb664602562c1a95c27ec70ae137e461",
      "text": "对方是学校的朋友吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000176:mobile_message:000": {
      "source_hash": "sha256:a6b8a9121a567a94759eafcc33fda3d332b92ce5ae9554d1b6a145a45b4cd6ca",
      "text": "冬马君真是的，\n因为觉得被看到很害羞\n所以想撒谎！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000178:mobile_message:000": {
      "source_hash": "sha256:f8c128578906daec3c1c2772946e149abcff38bae38f041d7cd339db5b686505",
      "text": "毕竟冬马撩女性的姿态\n很难得一见嘛。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000180:mobile_message:000": {
      "source_hash": "sha256:ffc68f745a7c3c7326b1e48cfc20fcda28c3f3350baa0f5245528b80f7142fc3",
      "text": "站在我的角度，觉得大家看看\n会比较好呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000182:choice_short:000": {
      "source_hash": "sha256:69f7891ea753c193653d4ceb1908982958b7603ab055031cc1cc8b781f48b61f",
      "text": "赞成您的看法",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000182:choice_detail:000": {
      "source_hash": "sha256:b0ff49c78cf313a73536f4768016893c055f4ae934dd89579c108a894b690e0f",
      "text": "我也持相同意见。\n冬马先生努力的样子，\n非常帅气哦！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000183:choice_short:000": {
      "source_hash": "sha256:3b65c4aaac7c75bd18c9807a3e17899d79a3dd9448e8e1f4ea68be3d1b7a1e02",
      "text": "很棒哦！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000183:choice_detail:000": {
      "source_hash": "sha256:33e58c6079251624fc5f52fb20e967195a1e4e606a559e6ec97993cc1ce4e3f3",
      "text": "冬马先生认真的样子，\n真的很棒哦！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000187:mobile_message:000": {
      "source_hash": "sha256:b7f0edd7fb8e18bde8ce30e2d4c9f3ebd63a3a96f8a2182fa36a3416495cde99",
      "text": "就是说嘛！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_02:1_4_002_02_j:cmd-000189:mobile_message:000": {
      "source_hash": "sha256:07b03a101de00bfa7c9aee9195d177022912100bb6940503ef283ee702618a63",
      "text": "冬马君认真的态度\n明明就很帅气<emoji>image_talk_emoji_17</emoji>\n就让他们看看嘛<emoji>image_talk_emoji_17</emoji>",
      "status": "draft"
    }
  }
}
