  "entries": {
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000011:title:001": {
      "source_hash": "sha256:f027635a140857100ead8454548330a485539d2b118e62b1e4ce85f184843fcb",
      "text": "运动饮料广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:c5a9b86aac28c87e7e64af919f5185f75211696faf342cb3e84f18626e542cd1",
      "text": "龙先生，辛苦了。\n广告拍摄还顺利吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:605693844312c34f7c0afcd49e50703de471afefd58c178632a1494eb3d611bf",
      "text": "嗯，目前为止一条NG都没出，\n我觉得进展得很顺利哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:66722b46ac049664a2f85df3fa8fc5e87abfc1bcb21752584e2ebda5b690f4d4",
      "text": "不过话说回来，居然能出演这款运动饮料的广告！\n我平时也经常喝呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:d0419d7c29eb665b5b75ef91c8f5450c6f0f36e9e13331b9e091426d21256643",
      "text": "刚听到这个消息时我超级开心的。\n所以拍摄我也会鼓足干劲好好加油的！",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000035:dialogue:000": {
      "source_hash": "sha256:af78e6406206cae72f88b0c71910dddf6e6af6de7eed6ab2b3a2397e80661f82",
      "text": "好的，那就拜托您了！",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:2cf11007460321da1c0960996fa3ca2f405e8663129d1880d5b122a465de1abe",
      "text": "有●●●●プロデューサー的加油打气，\n感觉能更加努力了！好——嘞！",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:8a532b696bf5ba115f66b92c741170972a5149069fa509ef19ea4ed0f16d0af6",
      "text": "……等等，咦？龙、龙先生！\n脚边掉了个塑料瓶！",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000045:dialogue:000": {
      "source_hash": "sha256:cff474ad475abfecb16bc9cc23d84d45851ec4fefe220cf424d8093c090a42d5",
      "text": "诶……哇、哇啊！？",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a0eba719c816c3da28f79731c29b83255eb9d1185db534ddd4fab3316885a3dc",
      "text": "龙先生！没事吧！？\n有没有哪里受伤？",
      "status": "draft"
    },
    "story-text:v1:1_5_015ryu_1_5_015_04:1_5_015_04:cmd-000061:dialogue:000": {
      "source_hash": "sha256:9c520a880ec874beaa750e9b8153bbdb96e73637247182c3dbd9b59f8e512ff9",
      "text": "没、没事。还好及时做出了受身动作。\n哈哈，剩下的部分我也不能大意，要继续加油啦！",
      "status": "draft"
    }
  }
}
