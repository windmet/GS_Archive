  "scenario_id": "1_5_030mak_1_5_030_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000010:title:001": {
      "source_hash": "sha256:13ca1ca94534c69dbec776a074d7a7746e0c5cf93541f1116b060dba23edd5cc",
      "text": "杂志咖啡馆特辑记者外景的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:2990be1d619a18f3890a695d42b3d65a58c21b26b58e7f1d4efb262a682ff25e",
      "text": "今天是期盼已久的工作，\n担任杂志咖啡馆特辑的记者！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:a2c9346c5732f4987abdc595877d95a8eac1c53f6c15cb4c80fac026ba7b9b5f",
      "text": "这份工作定下来的时候，\n卷绪先生高兴坏了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3c6f40b7dc48b00b2b55f6f05d67c5f6b22d7019dbd59aa1d08689a4742d88ae",
      "text": "毕竟咖啡馆也是能与蛋糕相遇的地方嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:2279e7faa95abc30f0e9385dab631ee9d9e01f1a2913f154a170a2380d7c463b",
      "text": "碰头会时我提了几家推荐的咖啡馆，\n结果决定去那几家取材了。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:045967c70ab67b620b4a8fad64c2ac7650bc041939e4e968a766f59c47ebc13d",
      "text": "听说这次初次到访的店里，\n也有蛋糕格外好吃的店……！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:30ad7c61217d95ad0a9dfaa71bf9aceef9a3302da80614c9aa3347b30c776783",
      "text": "卷绪先生的话，一定能做出很棒的报道的！\n我也非常期待哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:2ca8c59357215d8a6e3fe4e638e2ece582cf13cf5c3aa767b40cddeed317a43f",
      "text": "好的！……啊，好像到达店铺了。\n那么，我去了！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000068:dialogue:000": {
      "source_hash": "sha256:5b79df920d73035ed8874d9db282755dd8d2383b3dacbc303dc1b08bf3daf436",
      "text": "心形的好可爱的小蛋糕呢。……唔～！\n鲜奶油搭配水果的酸味，真是绝配。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000076:dialogue:000": {
      "source_hash": "sha256:a34084bd2e991bc09603dd04b398249f7584bfd4020184b9ac6f4c89b7770735",
      "text": "红茶也是为了搭配蛋糕而特调的，\n非常美味！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_02:1_5_030_02:cmd-000080:dialogue:000": {
      "source_hash": "sha256:49229912b8c55fa1506aab94c9b9fc359348c4e23e28a30f995f6c0e748ca405",
      "text": "（看了杂志特辑的人们纷至沓来，\n连续多日门庭若市！）",
      "status": "draft"
    }
  }
}
