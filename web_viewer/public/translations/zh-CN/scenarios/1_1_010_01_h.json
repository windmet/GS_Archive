{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_h",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000021:dialogue:000": {
      "source_hash": "sha256:05d698424aaaf6ca38cbdda5ebda7b1260b31e82cbdc413e2ae5631d18144f23",
      "text": "原来如此……你想在这里工作。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000026:dialogue:000": {
      "source_hash": "sha256:e91ccf6100edff482251c873b9ad66f3dc34c8ce0f3ccdf5697a5a251584a77e",
      "text": "嗯。\n正是如此。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000033:dialogue:000": {
      "source_hash": "sha256:2a7715d6300372ad0322f2083ba04a18f2c9e03007f074303d4a270e00b132a8",
      "text": "然后，神谷你也想这么做。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000038:dialogue:000": {
      "source_hash": "sha256:c9c33ea73ce35100651e2f37d56422ee4fdf705b6d0034cfa2f5d243631df484",
      "text": "是啊。我们店里没有主厨，\n有他在的话能帮大忙呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a421e6f1f4d8a3af46332e445048ee03645fcb1ce2fdd4dceaa82d4bbe5c705f",
      "text": "……真是的，你真是个大好人呢。\n底细不明的人，哪能这么轻易就雇佣……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000046:dialogue:000": {
      "source_hash": "sha256:9be1c20acb56c6513fd6108d462bde79a4e273a51497eef606f6a9fd836c03f6",
      "text": "话是这么说没错啦。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000052:dialogue:000": {
      "source_hash": "sha256:0baad3219377a11f6d1e098529443fd551ebf42e07fe236c7c93a0f575f7da23",
      "text": "总觉得，他跟我们挺像的呢。\n放不下不管啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000062:dialogue:000": {
      "source_hash": "sha256:7c61a4cf8d8ec174c1df7839240d1a74a42c1527d0e4fdd3c5b57e25234d0d85",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000072:dialogue:000": {
      "source_hash": "sha256:c2a634902891c7797e4fdf7ecfb078f6b71203a06f78cff36a26ff5316e0db6a",
      "text": "（我和神谷原本也是无处容身之人。\n心情我懂，但是）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000076:dialogue:000": {
      "source_hash": "sha256:97abbbb51dd958dacf2ae242d9d804331c06c19176410fa5f7cea31d2167c990",
      "text": "（我也是协助打理这家店的人。\n不能漫不经心地答应）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_h:cmd-000093:dialogue:000": {
      "source_hash": "sha256:5599083bf091aaa6ae549cca53a21989045c81d042016c5d8e9c139927a49830",
      "text": "请问您叫什么名字？",
      "status": "draft"
    }
  }
}
