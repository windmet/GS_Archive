  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000010:title:001": {
      "source_hash": "sha256:6cfda0d9c4905798d4feca9d3c6d458325ff97d07cabfa392c60cdef1d41db11",
      "text": "科幻舞台剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:318a4d61403decb4d500827fe93b0403537dbc21d36f0343a2a91f6c044e1394",
      "text": "“喂、喂……你知道那个生命体到底是什么东西吗！”",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:d2b71c36a867fa699b766cdf26e5e7a673085816cc476e87cfd7f17df57a3375",
      "text": "“冷静点。要是把那种东西放到这艘小小的宇宙飞船里，\n会变成什么样你应该很清楚吧？”",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:c2c73e2ae59797cb2b7a0e379d55651cdc1e1000d94a850416d40664a31d2b24",
      "text": "“把它放回原处……我再说一遍。\n把它放回原处去！”",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000042:dialogue:000": {
      "source_hash": "sha256:29727a355d081d999ab2600626735c4e751e550e0f916e1332717f81d2045b75",
      "text": "●●●●●●●●●●监督，我的演技怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000046:dialogue:000": {
      "source_hash": "sha256:7a3b143e8fc4349b27f6b8891df186444062c311bffbf303fe02a144c3c807dd",
      "text": "非常入戏呢。\n我不由自主地看入迷了。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:d427c52e5883e981e1f176294de8ed0792f33cf279ecd180ad9dafa9660414f1",
      "text": "嘿嘿，谢谢。能得到●●●●●●●●●●监督的夸奖，\n我超级开心的！",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000057:dialogue:000": {
      "source_hash": "sha256:f870e93baa0c71077e63732ae716050aa240bd61548fd4537ba3e1ca6bb57696",
      "text": "周围有很多著名的演员，\n所以在对台词的时候，我向他们请教了好多塑造角色的事情。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000060:dialogue:000": {
      "source_hash": "sha256:f0dce701654d4344927a9303d3380c63d2912712aa9aa5d07dfbcabfc0b8592e",
      "text": "大家人都特别亲切，\n让我听到了很多很有参考价值的经验之谈呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000064:dialogue:000": {
      "source_hash": "sha256:8dce4dd8280d96a0b248b1cc036ca563eae3d751f4a246045a6178f3f8e072c9",
      "text": "下次就要开始排练走位了，在那之前\n我得更加深入地理解这个角色才行。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_03:1_5_013_03:cmd-000068:dialogue:000": {
      "source_hash": "sha256:1d54fa97625a4c4a41fbb4932581155a6128575a2aa6bd8383e4be717c9be49c",
      "text": "请加油哦，享介先生！",
      "status": "draft"
    }
  }
}
