{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_032_01_c",
  "source_raw_hash": "sha256:ca828b92dabb1442652ef0ca980136c5e030487cfd88d6b9937e39ce4c7d52a7",
  "entries": {
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000016:dialogue:000": {
      "source_hash": "sha256:4ae79d1cd69137180328e0fcbc1686701893bfe049aa0288e9759633f827b906",
      "text": "………………",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f84bd67196c16faabebe5b4423ad0a737772f93422c945911352b1604cd3b3f1",
      "text": "（在事务所很少能看到这种表情呢）",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000044:dialogue:000": {
      "source_hash": "sha256:9a16281e85754960b8d4275baf69e47e57993ad6d5b0edc041cc2eb2ed2b1e95",
      "text": "（……好强。\n如果继续用现在的防守方式，会被将死的……）",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a550d69da9577127b57e22b0c37e13dcdceb7463675ffbc8363698ed29be0c6c",
      "text": "（但是，有●●●●プロデューサー在看着，\n这场胜负我不想输……！）",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000065:dialogue:000": {
      "source_hash": "sha256:43f542e6c6e7ef42ce971915f9e411c6a9713952a43de14cb01794717a37c028",
      "text": "（……！\n直央君的气场变了……！）",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000074:dialogue:000": {
      "source_hash": "sha256:a4c8dfeb4102cc9772298f75f8930a57ca9e0ca51d5b8bddac7454910e5694bf",
      "text": "……好，主动出击吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000078:dialogue:000": {
      "source_hash": "sha256:6a305dbe48fdbaa85f61a36d41fa229bd7ea2a16174fdc3a1df1e11fd41ded3c",
      "text": "嗯——这一步棋，\n直央君打算怎么应对呢……？",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000084:dialogue:000": {
      "source_hash": "sha256:fdcee4d849a7f970b887076984ef9dc05ffcc65cbe83012ee7f58acace92d7d3",
      "text": "（直央君……\n请加油……！）",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000095:dialogue:000": {
      "source_hash": "sha256:284569f8f0135dac344d748832aa542e363ba0ae48eab1d9282c8846782fca2c",
      "text": "……来了！\n这局是我拿下了。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_c:cmd-000105:dialogue:000": {
      "source_hash": "sha256:9b9c7bb8421533efe96959d89e48fd536f38f1dd42801c979bc012f6ffebb3af",
      "text": "（刚才那张充满自信的脸庞……\n下将棋的直央君，好帅气啊……！）",
      "status": "draft"
    }
  }
}
