  "entries": {
    "story-text:v1:1_x_026gen_1_8_026_01:1_8_026_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:a91837173a479de297475dc2c4ae32a6a2c5f6993ed5a6cf3d44d32d0e589f80",
      "text": "●●●●●●●●●●番长，\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_8_026_01:1_8_026_01:cmd-000015:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_8_026_01:1_8_026_01:cmd-000017:mobile_message:000": {
      "source_hash": "sha256:a595776e0aad278d6ddd45e0be92d83cd6c04db0625e426e5876337c6e672d65",
      "text": "本想当面跟你说，\n但之后还有工作。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_8_026_01:1_8_026_01:cmd-000019:mobile_message:000": {
      "source_hash": "sha256:4f4fc73581ae054a6204601248f6f81a40e387c1d5bc0b7ba867bf8a22f9a30b",
      "text": "平日多承蒙●●●●●●●●●●番长\n关照，所以很想好好\n向你传达这份心意。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_8_026_01:1_8_026_01:cmd-000021:mobile_message:000": {
      "source_hash": "sha256:1da9a5389838e46a4284965706f8cb16babfe2abadfe5128c2c98586cd0888a3",
      "text": "无病息灾，\n请务必多保重身体。",
      "status": "draft"
    }
  }
}
