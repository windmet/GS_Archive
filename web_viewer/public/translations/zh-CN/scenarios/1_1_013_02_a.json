{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_013_02_a",
  "source_raw_hash": "sha256:50865bef2db0194cb85b616d1de5fe00fa40d2dc80fce31c56704942506d3cd2",
  "entries": {
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:2da76e833bf3616fab23ed4b0730ca1de6c3c0875d2b8966269a88c922936584",
      "text": "迈向全新战斗的舞台",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:80e043af133bffc29289529d08e5100a651b1242139070bcbc59a2f38e37e874",
      "text": "尾随武等人的脚步来到事务所的涟。\n在那里虽然被询问要不要成为偶像，\n涟还是转身离开了。\n另一边，对于陪武前来听取说明的\n道流，制作人提出了一个惊人的提议。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000019:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000019:title:001": {
      "source_hash": "sha256:2da76e833bf3616fab23ed4b0730ca1de6c3c0875d2b8966269a88c922936584",
      "text": "迈向全新战斗的舞台",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:f132b92030555b6315c888f1705e9b668095e1f866f3a90ecfa1a29a34d1fb46",
      "text": "小不点他们，进到这栋大楼里了吧……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:49279c87bf706aa703cceadad74ccb21d4b9b37ac2d04481634246d32691271a",
      "text": "这里面到底有什么啊？",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:fcfcb5c4fea3b6b7673d8caa44905ab797068df168f847bf7b78e209faa4661d",
      "text": "可恶，从这里根本看不清里面……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000080:dialogue:000": {
      "source_hash": "sha256:5bc32f85477cb9083e1e621c2b022dfde3aacce3de3f6ccadff2a29d58da70ae",
      "text": "（都走到这里了再回去也太不甘心了。\n能走到哪就走到哪吧）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000113:dialogue:000": {
      "source_hash": "sha256:5783741c5abefcdf1f3fe865d22acba6bf67407dda66c95f82dad3bbabf9bbd7",
      "text": "那些家伙，到底去哪了……是这间房间吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000118:dialogue:000": {
      "source_hash": "sha256:4dbf48964d1fb2c00eb8eb8c52c70782606aa233f04cc3e1821c6b6c1cd3aa4e",
      "text": "嗯？什么啊这是。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000136:dialogue:000": {
      "source_hash": "sha256:da7e07adb7c2ffe0886ffc9cde13c39a424667fb9dc9391887b727aa749827cf",
      "text": "三一五Production……？",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000139:dialogue:000": {
      "source_hash": "sha256:7f13f1640b7ff203ac9f300a8f226ab8a8678530cab6bb87317f34ff83f0487b",
      "text": "念作“最高（315）”Production哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000146:dialogue:000": {
      "source_hash": "sha256:a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000158:dialogue:000": {
      "source_hash": "sha256:c690abf39413177269125fb7e481636ab9005567f4e4dc9fe46f593a0145c283",
      "text": "（切，杂鱼跑来搭话了。\n感觉气息很弱，本大爷才无视的）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000163:dialogue:000": {
      "source_hash": "sha256:73f6cf50e2da3ef3db3860aa3da9ee533dd97c3119fc767aa3ca222eeb1db95a",
      "text": "（在惹上麻烦事之前，\n赶紧开溜吧……）",
      "status": "draft"
    }
  }
}
