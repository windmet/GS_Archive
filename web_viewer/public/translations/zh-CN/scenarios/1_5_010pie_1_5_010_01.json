    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000010:title:001": {
      "source_hash": "sha256:eb426bf53cbbe65226566689850f6c8bfd8177c33aec97d51af594148b363965",
      "text": "玩具制造商广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:29833bb1343761491f9c8a0b755b703d63188112bedcf0100f1c689d890e7112",
      "text": "哇！这个玩具，好可爱。\n这个玩具，好像很有趣！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:663da578f32434983945bc6957dd419f8a159a0a4e70212d803ce1cac028d484",
      "text": "皮埃尔先生，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:03c92acd778bad3a5caf94fff5476b2d2cdb09abe13aed88b89c6aa1007cbb60",
      "text": "啊，●●●●プロデューサー。\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:4aa445b778793ad95d7ca7751dcfd4532c73883e1e69d5496ca0a9340678de6b",
      "text": "皮埃尔先生在看的是……\n玩具目录，对吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:f55f8ef8b049fa68aa7e6bddfb37d44072dd3fedfe51642c2039b1c2091cfaaa",
      "text": "嗯！下次，要拍玩具制造商的广告。\n在看都有什么玩具。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:c30cc70c96be842eee8468fc85c4d92834f75df537b73d13367f3b05df270fdc",
      "text": "积木、小汽车、洋娃娃。\n还有其他，好多好多玩具。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:0653fa85b6fb6fedc2b42716263a31c0f6f961c39e080b45be844afb355e4494",
      "text": "看起来很有趣的玩具，有好多好多！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:eadbd8a6a8f99baf603439e6170b04bd5f041db17696a432087b16c087fbff02",
      "text": "我，想和●●●●プロデューサー，\n一起玩！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:3e1272338c441b196da034bc7dc16fc3f6ec8fbd24fd7d919078715847116863",
      "text": "其实刚才玩具样品送过来了哦。\n不介意的话，现在要一起玩吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_01:1_5_010_01:cmd-000057:dialogue:000": {
      "source_hash": "sha256:c21d004e8ec06fc4a9c03a859ae2e2831057194a00182d61d15162e3680441e5",
      "text": "真的？要和●●●●プロデューサー，\n一起玩！呀呼～！",
      "status": "draft"
    }
  }
}
