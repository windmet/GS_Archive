{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_024shk_1_7_024_01",
  "source_raw_hash": "sha256:58b01916579188d33200801f8d5bd13c85bd7c292464751895366cf039d18019",
  "entries": {
    "story-text:v1:1_x_024shk_1_7_024_01:1_7_024_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:35e8a4380945aba4312f03816c5ef146e8e95c1938bb764fbe1da32767d19c7d",
      "text": "四季先生，今天也是您的生日呢！\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_1_7_024_01:1_7_024_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:4637f464c9ff59fd34ab014985a9b2191f1478a72736d6dd80573c298ec58f4f",
      "text": "诶诶，●●●●プロデューサー酱，\n你还记得我的生日吗！？",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_1_7_024_01:1_7_024_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:7cb793e67f204979aea65f8b448d778b2413d5a94fd3dbc0968cca8f44005212",
      "text": "咕——！超绝开心！\n真Mega感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_1_7_024_01:1_7_024_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:0778b20cd517aa75ef81e7d5cde5d8bdffa42a21f70fb28900969951f9fd41ca",
      "text": "能让●●●●プロデューサー酱\n为我庆祝，我真是超级幸运儿呢☆",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_1_7_024_01:1_7_024_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:6b159fc2046a108122ba2d97d98b33ce5e8cee8970d6ee3ad2da7bbde1452f78",
      "text": "以后我也要在工作上大干一场，\n好好期待我的活跃表现吧！",
      "status": "draft"
    }
  }
}
