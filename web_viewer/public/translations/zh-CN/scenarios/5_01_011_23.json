{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_011_23",
  "source_raw_hash": "sha256:7081ecd5ccc69037b3cbc598b2c66d6af5df624ff386b660cd136253a9d8310b",
  "entries": {
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:cd157430dadc2eaa1b21467559b13d7587bd2fe6a43f80a9ca22206e00bdfaea",
      "text": "久等了，制作人。\n差不多该前往下一个现场了呢。我们出发吧？",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:f4777faf43bc66cd7cab9d9334a921c23edd48bea5c5c50dcc429aaf6baa6ca8",
      "text": "好的，这就走。我去结一下账，\n请先到外面等我吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:01cbe459c32c389a0cf8745ecae9c34661f47836632a8b11c0cf677cee5fd295",
      "text": "账我已经结过了，没关系的哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:9100546d55182bbbbc6f3934ef27b655ce732bbe0b2c439b0ffc5942b0d4f5a3",
      "text": "账单不见了。什么时候结的……！\n是多少钱呢？这里由我来付。",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8195a44877ffd2989d7f152900cab3400f537a44d2753b3d027239d088f7213f",
      "text": "不，没事的。这一次，就让我来请客吧。\n偶尔一次也可以吧？",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000039:dialogue:000": {
      "source_hash": "sha256:832c897b68864e1a202267304d6af096a9da66e1af1831fcc3580a9c70c914cc",
      "text": "不不，这怎么好意思……！",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:1fb12178b913a40680bd78a9e1e495714fd5fd73a3e8661e1f0ef877fd5b7363",
      "text": "这是前些天收到美味巧克力的谢礼哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:f6aee0a21772f7af0a9514e9d56544cc280cb7c552923fca1bb15f63cfde0964",
      "text": "而且平时也一直受到制作人的照顾，\n至少这种程度的事请让我为你做吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:7cf07fb2fe345a4924ac2df656815393f3ab685ca40474b846cd658ab6401b62",
      "text": "实在不好意思……那我就恭敬不如从命了。\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_011_23:5_01_011_23_a:cmd-000061:dialogue:000": {
      "source_hash": "sha256:3f3b301e54c13dd63438266fd98f9ae0a4407f72a25a7d8030765a052e391c63",
      "text": "不客气。\n接下来的工作，我们也要一起加油哦！",
      "status": "draft"
    }
  }
}
