  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_021jun_1_8_021_01:1_8_021_01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:69a7d82a96433418980f7358fb8bc90c6b0d299094bfe69c28bd7f716815f0bb",
      "text": "喂喂，●●●●プロデューサー？\n辛苦了，我是冬美。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_8_021_01:1_8_021_01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:72634f4fb920d6ae4c01aa4cb773e410bcb6d9c0b6afdde4e02db21a40379350",
      "text": "我听说今天是\n●●●●プロデューサー的生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_8_021_01:1_8_021_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:fbbe754348f6b046fee4d3a8bae77a8fcddc8b1d152ac9027601f33e0651ef03",
      "text": "祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_8_021_01:1_8_021_01:cmd-000016:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_8_021_01:1_8_021_01:cmd-000019:phone_message:000": {
      "source_hash": "sha256:ae57ffacc11d47c7da7db5eb2c38a34547b63a63d6f6f628046fe4388fc79c31",
      "text": "祝您今天度过美好的一天。\n那么，我先失陪了。",
      "status": "draft"
    }
  }
}
