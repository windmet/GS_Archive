  "scenario_id": "1_5_011min_1_5_011_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000010:title:001": {
      "source_hash": "sha256:46e25158f0088cf128a2a148fb83b0559ad89445706814115ba7138e130465b0",
      "text": "止汗除臭产品广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:24d26062178f391c12a1e2a68ee481c3bc689854fdfb1c26090e5e70b1b2d259",
      "text": "对方发来止汗剂的广告邀约，\n说务必请实先生来出演。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:56414210e1762ec2542c7137d387c5d1c1dce010d17e02b3e3d0205815c2972d",
      "text": "这份是产品样品，以及\n广告的资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:bb0d9d94bab9aa94dd0b9190f2c62a04792ebe8a27ee921c77621d06930d67fe",
      "text": "谢谢。……嘿，是根据止汗剂不同的香味\n改变所饰演角色设定的广告啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:29c6a7b36ea641eb1f4472ff18b648eb5e293afcf9a1222ea5203e3b9bbe4829",
      "text": "让人很有种我一个人分饰各种各样偶像的\n画面感呢。是因为服装很有那个感觉吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8fdc9fe7a870c094dc3fbeaf56fb11a108ca4b010b4d73ed1c94b2267ad5021c",
      "text": "比如这个，薄荷系的话就是酷酷的偶像感觉，\n香皂味的话就是清爽偶像之类的。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:d0262b1c707a8e7c74e092188ef653a82930c7108aa53046fce8e3961bf6612e",
      "text": "尤其是这次的主打款酸甜水果味，\n完全就是可爱的偶像嘛！",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:f471a8c4a90bc4ec038d0a731b719bb3e046ae64b0c00b68c488ee8f66432325",
      "text": "啊抱歉，不知不觉就兴奋起来了。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:1f0f33c2360d2df9521dd012b28cb70867964e41dfdd3856ec306cf7811ea16f",
      "text": "能对自己喜欢的事物充满热情是很棒的！\n我们先照着这个方向去和对方商量看看吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000050:dialogue:000": {
      "source_hash": "sha256:6a451dae0a6d8a69b72d41cc58d186ccb518527d8f91f42d6b768427ab34029e",
      "text": "啊哈哈，谢谢你。\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000054:dialogue:000": {
      "source_hash": "sha256:c9f92627ddc9cb93ef6b2369b66b1beb8e3ddbf5ab717148ed3d1cc10ad19042",
      "text": "为了能让更多人了解这款商品，\n我也去把想法再整理整理。",
      "status": "draft"
    }
  }
}
