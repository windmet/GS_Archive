{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_004ter_1_7_004_01",
  "source_raw_hash": "sha256:4a27f619e37c539bf56ba6b98037934f48d90f6b4ed245c3f5c9d22b54380c90",
  "entries": {
    "story-text:v1:1_x_004ter_1_7_004_01:1_7_004_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:d821641d9bc5785dd5c366b79c8fba4121282f4c5c334e994e51cfb2949035f3",
      "text": "今天是辉先生的生日呢。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_7_004_01:1_7_004_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:ed6d4d273a535ffbe8aed893b6e9bdea1704cab7d71141c9b050fd02d35b716f",
      "text": "生日……？……啊，说起来\n今天是我生日啊！",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_7_004_01:1_7_004_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:9c05739699938a772cddcb67784634f2176b06267bac87ac1d12f084b9134993",
      "text": "哎呀——完全忘光了。\n多谢你啦，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_7_004_01:1_7_004_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:89ddff4fe7a0814fb16b12047d70e4cc77d08d32b76008f475b9d2a34b747efb",
      "text": "嘿嘿，能被人庆祝生日，\n感觉真好啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_7_004_01:1_7_004_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:65decd1fdffa3dd82def203f5ba4d6eb26fc348fab8469dc715b86010960cc90",
      "text": "啊，虽然我把自己的生日忘了，\n但你的生日我可是记得清清楚楚的哦！",
      "status": "draft"
    }
  }
}
