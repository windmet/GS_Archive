{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "015ryu_403_2_4_015_03_09_a",
  "source_raw_hash": "sha256:9700d5c4903af24b195404bd3aa60786e2acadb1ec07f201b28baa2da45132c5",
  "entries": {
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:164e9ee04414634184afb3f1b0679bffdcf839365354a2ec9ab4806a446e5450",
      "text": "●●●●プロデューサー，辛苦啦！\n嘿嘿，听我说啊。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:8372ee7b80e4b1e12c78ce25cd27c4261309ce28b1fa9f73cb1437762962a894",
      "text": "接下来我要和英雄先生还有诚司先生\n一起去吃松饼了。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:b61cea2db7c3f023ad19558be63be082f14373d91061fa577899cb2b2c16e892",
      "text": "听说是情人节时节的限定菜单\n什么的。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:7925cdcb95df0f2f66cd324ce16b34514ecff9d04e1406675db2339918598bed",
      "text": "前阵子工作结束的时候，英雄先生提议说\n要不要代替庆功宴去吃一次。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:525ca5f5e2fca00c436ad252a60d5c33faf42309e7050fa9f81f22c7b0ed6dac",
      "text": "辛苦了！",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:00f3a13ea12f98630daf4d19b5cbe815a0f4b68ad3a24009f25f318b2c6d60aa",
      "text": "路上小心！",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:32b3c284728e332ac2651fb2ce8409fe642bff192d4801231cc16bdb28de5f8c",
      "text": "谢谢。制作人也辛苦了。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:b4e1eb13e2f2dc8884b3fcf243131a47239da35c3424af53af921141ff83d089",
      "text": "谢谢。我走啦。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:78e077b27b21dac8e573aaeccdaf110fa8dcb47b68ddfd772c18920d80afd48f",
      "text": "CM也顺利完成了，真是松了一口气。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_a:2_4_015_03_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:77338a26953a6d24ac6f7a1a3ee3d8d819ad403f9901850df062415e96f15afc",
      "text": "下次也要和大家一起办庆功宴哦。\n先这样啦！",
      "status": "draft"
    }
  }
}
