{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_01_g",
  "source_raw_hash": "sha256:e77e78ad0eda18408ca5286f31d91a808cbab74285b29c574425f1d48ceedac5",
  "entries": {
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000010:dialogue:000": {
      "source_hash": "sha256:100fa4eb035277b4a1ca1def93ad83a95e2595c444cb4b5cf7f0888a38ec6369",
      "text": "享介，你在听吗。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b7ce10988d155d9a51139b91a88a53401c4af77ca6205d2e6f90467a1112d271",
      "text": "诶？啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000020:dialogue:000": {
      "source_hash": "sha256:96ab7d031473a1863bfd590a783bc4a2d8a3009514eb79d713cd20642cf5c404",
      "text": "悠介的事我也觉得很遗憾。\n但你必须为自己的前途考虑。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3dd825951824082e889b19d0f4f6103ad0abde1aff43e7bfc0be42dae16593a8",
      "text": "如果是享介，一个人也能走下去。\n我现在依然这么认为。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000029:dialogue:000": {
      "source_hash": "sha256:528b77f21d551afb93cc77d05e5af49181435caa9867a2dc1ab9366e45868780",
      "text": "怎么会，我……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000032:dialogue:000": {
      "source_hash": "sha256:ef5e2d9ab1367722f1e3d29b750ad945103633664afdfa5fd4c39f9dfdb45464",
      "text": "后天，俱乐部会正式宣布\n悠介暂时缺席比赛的消息。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000035:dialogue:000": {
      "source_hash": "sha256:631157c15452e8cefd925437a26f1d016b1a5d7575f9234fd0bf7aff0369e63d",
      "text": "！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000039:dialogue:000": {
      "source_hash": "sha256:2e32928d29fd826f86dbf9d42d1c24840efa669fa576522760f065f772c1e4dd",
      "text": "以他现在的状态，短时间内无法重返球场。\n我现在就去把这件事告诉悠介。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000043:dialogue:000": {
      "source_hash": "sha256:bac0d696c023b745a7958e23629f82edf4009621126dab7c15516f04abb335d4",
      "text": "你也好好考虑一下，\n自己今后该怎么做吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_g:cmd-000050:dialogue:000": {
      "source_hash": "sha256:ffb5c9522bdfa6270abe17ceebeb959d057d5173230c7b5c4715589af477da78",
      "text": "（我到底，该怎么办……）",
      "status": "draft"
    }
  }
}
