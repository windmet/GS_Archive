{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_019kur_1_5_019_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000011:title:001": {
      "source_hash": "sha256:3866d7e187e85418e7e2cbd470abb7b566cb815d64011c293f31a0a2f5cf76ee",
      "text": "资讯杂志和果子特辑的探店报道工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:8e22a516fcc2262981c906ffa6faf17fa866d12157c02ad01048076f7535abb2",
      "text": "这是一家截至今年已有80年历史的\n老字号和果子店。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:6cb2a3ba588171701d102f4558fe92b8817f8043122a40597416198391bb21e7",
      "text": "其中尤为受欢迎的是练切，\n我也曾将其作为茶点品尝过。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:d6327e103d945773b06a8c73bf7b62d0c3e349a0fdeda291515a4ca60a658642",
      "text": "今天我想要为大家\n报道一下这款新推出的练切。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:e716757740d52702b4ba457c66b30d8e2530f80cdab0f7ff6dc245ef694af6d8",
      "text": "九郎先生，辛苦了。\n是非常引人入胜的报道呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:0302dd2e034597e55722ce06e563251bac3d1d47da432cc197096119ec99359e",
      "text": "能得到●●●●プロデューサー这样的评价，\n我就放心了。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:b4a99fc532a5889ae2641065dc05afda7fa5490ff5505a847705b6bc4567953c",
      "text": "我很期待自己述说的内容，\n最终会被整理成怎样的文字。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:a13e590d132d26e1e74a6d911738f2f2e8af85bc6732e4ab4711a8caff6400b0",
      "text": "今天的工作到这里就结束了。\n我们回事务所吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:dc7e62ddd59e9fb8a6a6ae2f9ebf7a18fc16f96fbf2ed5d245c7bcfb0d046413",
      "text": "啊，不好意思。\n能否稍微占用您一点时间呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:3dca63a7c0765e7b624989eb7435d248fa058df00c859a1ca68c02c419eaf0c3",
      "text": "我十分想让事务所的各位也品尝一下\n这里的练切。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000054:dialogue:000": {
      "source_hash": "sha256:57e54a2abc0a641fb76fb4b389492c79cd7da7a10f69bf3b36e8115d9fb1f51a",
      "text": "太好了！那么我们就买些伴手礼\n带回去吧。",
      "status": "draft"
    }
  }
}
