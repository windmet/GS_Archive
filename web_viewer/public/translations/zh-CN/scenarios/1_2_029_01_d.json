{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_029_01_d",
  "source_raw_hash": "sha256:c2b2ed07bce59189edc8a5818f30ec742f6b6fba499b07b87c0d893138e7e18c",
  "entries": {
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000014:dialogue:000": {
      "source_hash": "sha256:628d07b19dae14947041f3979b829bbdb9e9dcb3b06fb69769c45147e849a7da",
      "text": "！？……否、否也。撒旦与吾乃不可分割之命运。\n无法交托于汝。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000016:dialogue:000": {
      "source_hash": "sha256:7e52f54a1be4a0d685d6c8fbb6b72355bc1eb771829986410651aa8b542ba9f0",
      "text": "这样啊……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000021:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000025:dialogue:000": {
      "source_hash": "sha256:e70ac81ceea24bfd34e3ec1e0e7d82ec7b26e98174919b2c1218bdc48040f162",
      "text": "然……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000032:dialogue:000": {
      "source_hash": "sha256:aa51ec84439a2d7c0d7a2ba06beab8ea2896d4394506bdc92821dd05fe12dbbb",
      "text": "幼小之人啊，且在此稍候片刻。\n吾主，此地便托付于汝了。有劳照看此人。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000037:dialogue:000": {
      "source_hash": "sha256:554474fd0bcf2bfe062fc8966c856638d191d6e42e5346541d56a279e7d8ced6",
      "text": "好的，我知道了！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000043:time_caption:000": {
      "source_hash": "sha256:c9ff128eaeb9b853fea0eaaf5d109eb344c71c2a3b448492234190a8300d3b1b",
      "text": "过了一会儿……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000053:dialogue:000": {
      "source_hash": "sha256:96adb27f2922eda86f3db4a4d44693b0f2df731873e9af50b8e6b94be975ad49",
      "text": "……久等了，幼小之人啊。\n此食粮，赐予汝。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000056:dialogue:000": {
      "source_hash": "sha256:1759513157b720b63cc28cdd7325dc0d1df3e36c679b2b74ae16d3106e20cb15",
      "text": "哇，是咖喱饭！\n这个难不成是撒旦的形状？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000059:dialogue:000": {
      "source_hash": "sha256:fefdca1ee4115aa5a92eb0e1310ddb4569be67fd66f02412f5fc11fae538ea2e",
      "text": "正是。虽不可将撒旦交予汝，\n但且将此食粮纳于腹中，心满意足吧！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_d:cmd-000062:dialogue:000": {
      "source_hash": "sha256:95ac832dc97d88cd4ce402578bca6ab5cde734db85807fd1959c28bde725b94d",
      "text": "嗯……！谢谢大哥哥！",
      "status": "draft"
    }
  }
}
