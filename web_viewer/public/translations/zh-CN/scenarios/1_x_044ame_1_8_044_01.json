{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_044ame_1_8_044_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_044ame_1_8_044_01:1_8_044_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:9be1edd9d74b794723b1bc24a8241e4e3c8f02fc33807bee39bfe73ab07513c6",
      "text": "●●●●プロデューサー，方便耽误一会儿吗？\n没什么，不会耽搁你太久的。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_8_044_01:1_8_044_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:71e49d968c49974d12068902185f3e5de503a008f50ee7a04dbc2f0cfec8289d",
      "text": "祝你生日快乐。我和●●●●プロデューサー\n大概会交往很长一段时间吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_8_044_01:1_8_044_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:30d1e71c6b0832258e0f4fae0ab52f994c37e7362049bcedccb2eb49ba3b0780",
      "text": "往后的日子里，也希望能与你构筑良好的关系呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_8_044_01:1_8_044_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:0e6c5a7554c8f15ebbf4197913fd1c9bcbea8a83d7b8e75d3dad9779a8b71cae",
      "text": "呵呵，非常感谢！\n我才要请您多多关照！",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_8_044_01:1_8_044_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:d33ba0546e9e785a0485ca1775c5792ab90e47f56a5741da9b0422fd8cfe0114",
      "text": "嗯。打扰你真不好意思。\n祝你度过一个愉快的生日。",
      "status": "draft"
    }
  }
}
