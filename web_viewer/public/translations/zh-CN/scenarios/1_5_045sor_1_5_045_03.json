  "entries": {
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000010:title:001": {
      "source_hash": "sha256:fb40d7fffdef0ca0300120c97b42118acb0048a995b37a16182d78a16436559f",
      "text": "客串连续悬疑电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:3b0bbe2c31a8ea61c97e50a73a4bfd3644b43c5fc04962f2fabdaa8df26aa10f",
      "text": "“哎？就凭这种理由怀疑我啊”",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:708147ec751814a458365f4e1fd11736d08aaa899ec30c27adc741ed088e50b3",
      "text": "“啊哈哈！真是浅薄的推理。\n你真的好意思自称侦探吗？”",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:5b5cfd8dc6923b1f5e0cde34779c4d95f0eb6eda894c2aead38b7cdc7ca0f61e",
      "text": "“多动动脑子吧。\n……不然的话，可触碰不到真相哦”",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:f555a0bd791a0648c0417d03e10249eed6f33a18e330904d79b3414f32bc3bc3",
      "text": "呼，●●●●プロデューサー，\n刚才表现得怎么样～？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:3d5c39e7e54a73c6d3f94ef4a7291d5e9fbc9140aa4ecc05819560631212f9b1",
      "text": "非常棒！\n情感非常投入，看得人手心冒汗。",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000046:dialogue:000": {
      "source_hash": "sha256:78e3a6bbfacb3c9e0eeb03e82f6be84069a896041769a1d243b884161f9212d3",
      "text": "太好啦～。我演的角色是故事的关键人物。\n不得不努力呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000048:dialogue:000": {
      "source_hash": "sha256:3013ae5601148f98126a508eb0a9ad7714c018b9303e7ecf7cc39142e9ff6018",
      "text": "还要再练习一会儿吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000052:dialogue:000": {
      "source_hash": "sha256:184e5bf2ac690c1c991660b7d784fe0693f259ea3343c388d9d00ece8d514a25",
      "text": "嗯。●●●●プロデューサー\n待会儿有什么安排吗～？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000054:dialogue:000": {
      "source_hash": "sha256:0498a54a0949d5aea72b214f59dc63c1ee83ce10ca860585a5f9668eb71c54b5",
      "text": "没什么特别的安排，\n我会奉陪想乐先生到底的！",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_03:1_5_045_03:cmd-000060:dialogue:000": {
      "source_hash": "sha256:8aef7b66c3701c735f2fbefde904a1dd7ab52921c8b52e64f3daec11ea44be59",
      "text": "●●●●プロデューサー，\n谢谢你～。那就拜托你了哦～",
      "status": "draft"
    }
  }
}
