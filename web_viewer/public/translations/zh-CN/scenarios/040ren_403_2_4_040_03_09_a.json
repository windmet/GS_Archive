{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_403_2_4_040_03_09_a",
  "source_raw_hash": "sha256:4b89f85f4c13a936a18f5146f264c49fb98a2d0cfbd7bbd514a1f970d2eaddea",
  "entries": {
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:e2eef5de2002b16fe4df97dd22d2fd8d950e337032a5f9498282b8843dd6f2f6",
      "text": "喂，结束了。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:8a8813bb28ac031ae8396ad2b8451fe9dd87f391c51caa9acd5a4483f97ed742",
      "text": "辛苦了！\n我这就去接您",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000009:choice_short:000": {
      "source_hash": "sha256:b79ab8007b83f763aac25b7cd6d0f13239242735426f6c88bee492126f70ae6c",
      "text": "辛苦了。\n我马上过去",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:ceb52348604f0c7a16835548ae10850d0b6f4162759787fb5f8b140d5df9eb2b",
      "text": "啊？还没到吗。\n你这家伙动作还是一如既往地慢啊。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:c993e0921e3a9cefb77b3557777c03fb29163d178bdd4cd0fdabfd1a6ad7c5ed",
      "text": "哈啊？\n在本大爷开口前就该滚过来了吧。大笨蛋！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:948ac5aaad7ec29c37322d3d33b6c96186de77e4ef259526063db9d9ff8fa0ae",
      "text": "哈欠……啊……\n好困，肚子饿了……",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:6a2cf56438864fd503a58d1814bf74da21b408064b7dba278517d012ed24dbd8",
      "text": "再让我多等，我可不轻饶你。\n听懂了就赶紧滚过来！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:df6630e876cb14ad2f245e2faac1bd8666c62b5d0728b11b548a2c057f445e49",
      "text": "给你30秒。\n多一秒我都不会等，听明白了没有！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000027:choice_short:000": {
      "source_hash": "sha256:f7b5e09312d00b187fdeec72daa16a1ded5ece67f3788de67a6feb58fd881b98",
      "text": "这未免也太……",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000028:choice_short:000": {
      "source_hash": "sha256:59c55d4b878df63d50ff372587f8319ae3821c1cf3fe8c6bce31cf184b4a7c34",
      "text": "明白了！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:a943200c6d1d70f32ed47e9866ca8d85dbd7068155b4817ef71190887b4a3bae",
      "text": "1、2、3、4、5、6……",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000035:phone_message:000": {
      "source_hash": "sha256:3df293d4759a75a3a932c47c521ff209171c4c575f8225577133deb71c6e36c8",
      "text": "喂赶紧的。\n一秒我都不会给你放水。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_a:2_4_040_03_09_a:cmd-000039:phone_message:000": {
      "source_hash": "sha256:e96dd84ef20b9322191902c70bf457373655751f723324fff77e19c8505a926c",
      "text": "哼。给我拼命跑过来吧。",
      "status": "draft"
    }
  }
}
