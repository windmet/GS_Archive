{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_025_23",
  "source_raw_hash": "sha256:124c97d2ce70307b7fdd6171721448a31cf2bf7995750af1f49c0e36a5b15923",
  "entries": {
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:87d3406cc737059bac85617db4d73481af319908de4deaec31343404673d127a",
      "text": "今年也能收到巧克力，太令人高兴了。\n多谢啦，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:1ef0ccdc9caa0db906d0d8bb36a66ced571ca19de27216473530e08ac8e9ef47",
      "text": "这次我也倾注了满满的热情哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:a4738472158b0945ee7e20252f50d390f57ccc8b510dd094fd3b9627378e0232",
      "text": "里面装满了比去年还要多的热情！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:0744d5d87338b1dc50e40f68b4732e4001fbb236ab41742331d760f3d9365ca0",
      "text": "是这样吗！？\n怪不得我的内心如此熊熊燃烧啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:b99eaf8981fad4fae8d35466e4d921da926dd516e7d83f7db8e6cd085ac569dd",
      "text": "太棒啦！这盒巧克力里蕴含的气概，\n我切实地感受到了！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:8d9ab47bff6385f39f4e12801e7a0ec7e2124f87ed50d5a0d2d1182b2dd9cbd7",
      "text": "这样一来不管什么工作感觉都能全力以赴了！\n呜哦哦哦哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:be74d09a73ec8d66d8d3a0579995074b0b445e7ea0961a7254f94397c7cb57ab",
      "text": "喵喵！喵——！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000053:dialogue:000": {
      "source_hash": "sha256:b559ed4974b60f079683755de0570e5092cec269d1703590edec48f7ecae6dd0",
      "text": "哎呀，别那么生气嘛！",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:c8ff8d98ffe05b33f8f386974e22cebbbd521d42d9c99c2dfe1e6a56bb4f1849",
      "text": "……嘿嘿。闹得太欢，\n被喵子给训斥了。",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000060:dialogue:000": {
      "source_hash": "sha256:3fbd364a493bffb84841aa5b160462502f4e2a113a7a5ca9f84860086dbbe7aa",
      "text": "能让你这么开心，\n我也很高兴。",
      "status": "draft"
    },
    "story-text:v1:5_01_025_23:5_01_025_23_a:cmd-000066:dialogue:000": {
      "source_hash": "sha256:aa20b9f36f75c5fff6635595304e64f269af9b12f4220dd085bd28dd7ab2685b",
      "text": "那当然开心啦！明年我也很期待\n能从制作人那里收到哦。",
      "status": "draft"
    }
  }
}
