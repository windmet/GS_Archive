{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "029ass_302_2_3_029_02_09_a",
  "source_raw_hash": "sha256:98eb4a58d9930df916b7703d1ba0bfc3ddf5d3243e3ebdb94f127f6696ec0d6e",
  "entries": {
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:37817964023468d6298e0292c22158926086ed2e0aee58df27e2fba564cfa6ec",
      "text": "哦哦，是吾主吗？\n可否容我占用片刻时光。",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:6675d6089c919cb09cc4d8d696a0193186f7cc82b9b1af0f491acfdc10f69909",
      "text": "嗯，没问题",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000009:choice_short:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然可以！",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:df89107ec74d24ff09fedf029800743d30986f332079cc5e22da4b7cbf48afbd",
      "text": "嗯。\n此番试炼，辛苦了！",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f49b537abc4289628e14447595dc812318cd3d64c6175d47e4ca1df271ff9c13",
      "text": "我等之所以能平安通过试炼，\n多亏了吾主的竭力奔走……",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:41143b868ad8c6a6ad182b12b1510bb7f6ca12beee2ddd3e4fc6492c14c31856",
      "text": "以及北斗与圭、一希的鼎力相助。\n仅凭我一人是无法达成的。",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:a7669bc8be9a7677d6f19ad79b859661bce208b3151832f087de41ef6dd971d2",
      "text": "撒旦也对那些人的襄助深感\n感激呢。",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:59fcebbac5e59f84a88ef9d5067669109b27ce28ddf31b6f581d4d5f9584a7d0",
      "text": "不愧是吾主所相中的人。\n必须向那些人重新致谢才行。",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:a299cf5743523c2f6a1372d0511b587b92cd1c2807e5f7988331501465404b1f",
      "text": "当然，对吾主也是感激不尽。",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:a1f1b61ad6ba1558aa0dcec62bcdf09553573187a5a9c5a9f09f667c6d41ac76",
      "text": "为了回报吾主等人，\n我也立誓必将奋勇向前！",
      "status": "draft"
    },
    "story-text:v1:029ass_302_2_3_029_02_09_a:2_3_029_02_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:7714eae9b287acce3dc1a5f99342d16aadf35353fe262f49495b2d9c6ce2a3bf",
      "text": "那么就先告辞了。\n吾主啊，愿你得享安眠！",
      "status": "draft"
    }
  }
}
