  "entries": {
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000010:title:001": {
      "source_hash": "sha256:81f7dd721aa5a27e44d97fcbe3468b9f5c83ef48237618157d259a7d77ff58a6",
      "text": "眼镜CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:f0fb065b85d36bffb5616c666a97cdd874ea8f4dad379189333d1358de46d5fc",
      "text": "玄武先生，彩排辛苦了！\n导演也说完全符合预期呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:890e6dffcf078f39516ead5845dc11edabfd97a24fce4eb469fe59d779afae7f",
      "text": "那就太好了。\nCM最重要的莫过于给人留下的印象了。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:6bfbdcf271c76f93481f43df790455123b1aca279d669c819a1d06f82b229ccc",
      "text": "况且还是知名品牌的CM，绝容不得半点失误。\n紧绷心弦，直到最后都要打起十二分精神！",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:0978bc78f68a7531851904ebb24bfd4acfee5e3e2632425f24a2563ee7070bb6",
      "text": "好的！拍摄中会换戴各种款式的眼镜，\n玄武先生有中意的款式吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:e5de51f9fc10a2a0d59194d9ca0edd6533f2215559c11d0b28a47011bcba2cfd",
      "text": "嗯，每一副都很不错，不过……\n这副眼镜我格外中意。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:16369d74e55002ec3170c1163cc682fd773b0be9206d3f39ca29483cc42b164d",
      "text": "镜架很轻，佩戴感非常舒适。\n形状也和我平时戴的差不多。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:22c75daeeb653fdfe1d6335d705b5ab7f55ffe9046c7b24d240b3bdfcf8d9206",
      "text": "虽然每一副都很适合您，\n但那个款式的眼镜也格外衬您哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:fe130def6414e320e2c5dccd3840a40d298ebf11eba22d013dd4d6d7c27b7b09",
      "text": "哈哈，是吗。可能也是看习惯了吧，\n不过听你这么说，感觉倒也不坏。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:46036fa6bc6a75070fe40a9b3f478662c11b764933c31f9c3e0f100ed473e31e",
      "text": "……嗯？好像快要正式开拍了。\n那么，我去了！",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000055:dialogue:000": {
      "source_hash": "sha256:f704322fb2f84d47f32d935d953336caf4036f802a7c3e31c16d3ab0e18da919",
      "text": "路上小心。请加油哦！",
      "status": "draft"
    }
  }
}
