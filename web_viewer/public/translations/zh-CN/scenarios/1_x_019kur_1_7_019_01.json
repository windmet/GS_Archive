{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_019kur_1_7_019_01",
  "source_raw_hash": "sha256:1bc3c382ee54e00cbf538a004abb7389ac0130540afa5b529de4010222ae0236",
  "entries": {
    "story-text:v1:1_x_019kur_1_7_019_01:1_7_019_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:c8b92c1641869014cad23e576946be770499bf2da7cfa8332e9c477b8a964b2a",
      "text": "九郎先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_7_019_01:1_7_019_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:6093aed2c4990d95b2323ed79e68b58d1243998523870cc76303d68e431e3c9d",
      "text": "哎呀……\n抱歉，我稍微有些吃惊。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_7_019_01:1_7_019_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:d34289e250fc9f51437b86963e5629b77da4e451c601a5710e2f82d7109c5347",
      "text": "没想到能承蒙●●●●プロデューサー\n为我庆生。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_7_019_01:1_7_019_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:c59c1071c2f8f6df510273f4112ef796385839a5904376a6ef7a39be4d414529",
      "text": "承蒙您一直记在心上，非常感谢。\n在下深感欣喜。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_7_019_01:1_7_019_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:1bed42d95546e6ad126354bf2812608cad9cfb21375d4f241ae162c8dcbf3bfd",
      "text": "作为偶像在下仍是才疏学浅的后辈，\n今后还请多多指教。",
      "status": "draft"
    }
  }
}
