{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_013_02_f",
  "source_raw_hash": "sha256:50865bef2db0194cb85b616d1de5fe00fa40d2dc80fce31c56704942506d3cd2",
  "entries": {
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000014:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "数日后……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000020:dialogue:000": {
      "source_hash": "sha256:c49d65cbbb6ecb1ad27e90f321ea48332ea44534e2f38113207022a7f433fe39",
      "text": "喵～",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000030:dialogue:000": {
      "source_hash": "sha256:65ddd5224cffa8492fde2d6f473b3415416abadcd7ee27736ac8261189cab0cb",
      "text": "来，冠军，这是小鱼干。\n好好嚼碎了再吃。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000041:dialogue:000": {
      "source_hash": "sha256:f07b1e650fe0d7073bf1a0551ebbdb8096f4ea3525d07c3d7934dc0a19978435",
      "text": "冠军？这家伙的名字叫霸王。\n本大爷都说多少遍了！",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000053:dialogue:000": {
      "source_hash": "sha256:a6bfa65c83d5e93c0bdbe43bda6052275e39cb4cc5a292cbcb1b14a62b9790c0",
      "text": "来，霸王。比起那个小不点的饲料，\n本大爷的饲料更好吃哦。吃吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000065:dialogue:000": {
      "source_hash": "sha256:c1b6bd59a5a3fab2fb4aba791321f08ea18db378ac60b9c5820f1b463f922698",
      "text": "库哈哈！看吧！\n正狼吞虎咽地吃本大爷给的呢！",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000080:dialogue:000": {
      "source_hash": "sha256:663a053f727d1c0461d48e1dad588073efb70acb1890a657e08f5e615be8e1dd",
      "text": "（……今天居然没像平时那样找茬啊。\n嘛，安静点也挺好的）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000091:dialogue:000": {
      "source_hash": "sha256:a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000101:dialogue:000": {
      "source_hash": "sha256:a2b9fb7a6e8b995d9295a98844a0dfdc1389acafa96d49ddca37b022a34fc48a",
      "text": "（干什么？这次又死盯着我看。\n……又想挑起决斗吗？）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000115:dialogue:000": {
      "source_hash": "sha256:1a3a7bc0871654f3ea616746b03d51b7638d8e16d7de59ad696f97f0f1388ae9",
      "text": "……喂，偶像到底是什么？",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000120:dialogue:000": {
      "source_hash": "sha256:998ae0176332896f2d591e274fd4002d4a01756c60644184f87208d9779af506",
      "text": "……嗯？",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_f:cmd-000130:dialogue:000": {
      "source_hash": "sha256:200555714b782e090fa729f96719258e545800551a5cfa73a802edbc1d9da5ba",
      "text": "本大爷问你偶像到底是什么啊！",
      "status": "draft"
    }
  }
}
