{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "002sht_305_2_3_002_05_09_a",
  "source_raw_hash": "sha256:bc0c2b371b6cdf5f8dbde455f7237f669a8d41166e11eec48663aef95329669f",
  "entries": {
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:a1b58b727ddde5c819d2204ea4a18b82447cabc472d055c79e18e9a8823e5427",
      "text": "●●●●プロデューサー，辛苦啦。\n现在方便聊两句吗？",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:2e1dbd2dd166cb7b9760d2c80216d8e645a8f0a3154ebcababe2f9a6bb72aec1",
      "text": "刚才电视正开着，刚好播到了\n前几天的音乐节呢～",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:8a0103b9d5571ac67361e86876c9e2a6d13c9559d12f9f577d55ea8fcac11319",
      "text": "说是“偶像Jupiter展现的\n全场折服的摇滚舞台！”呢！",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:47b1ad269b10c627afda4830513b93b46777657105ab27a3b9ce55e75409f54e",
      "text": "里面也有观众的采访，\n果然大部分人都是第一次看Jupiter呢。",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:29651e103260f54669d530e34b9d5257d9d0979a5bd5ef3363709d77e6747f11",
      "text": "还有人说“已经成了粉丝，今后会一直\n支持的”哦。",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:53491594479929c5943c37c4c282493f7536e317f5eb3dbc2bb713d47066b70d",
      "text": "真是令人高兴的反馈呢",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:de28d5e1a9bba3e59172312da882c3715ed21502b7221f98557d1a81a508f830",
      "text": "对吧～。嘛，看了我的舞蹈之后\n大家都会着迷也是理所当然的啦。",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:6df797de9cd2c224a668f07942767eb3f2ed07941145b9a97225153885ad2f6c",
      "text": "不过呢，还没看过Jupiter演出的人\n还有很多很多吧。",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:73262c26fda40608e94145a692a353e120df2e4997d4861ef1879b667cd94892",
      "text": "能传达给那些人的大工作，\n今后也要继续帮我们争取哦。",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000025:choice_short:000": {
      "source_hash": "sha256:ce668c40f253d10781168301572643428e336fa5787539b1a44cdadbef25cec7",
      "text": "我会加油的！",
      "status": "draft"
    },
    "story-text:v1:002sht_305_2_3_002_05_09_a:2_3_002_05_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:583825ebf218f0577ece9e2499be46b18a0fe9e8ba127b24aec3dc5e438c74a6",
      "text": "谢谢你，●●●●プロデューサー！\n就全指望你啦。",
      "status": "draft"
    }
  }
}
