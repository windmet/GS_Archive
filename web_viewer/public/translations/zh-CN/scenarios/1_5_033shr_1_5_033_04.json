  "scenario_id": "1_5_033shr_1_5_033_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000010:title:001": {
      "source_hash": "sha256:814f5e3c973caaaf6f2c82d1789fdd64722367150efe87956b65d3fcd162bbfc",
      "text": "战队系列电影客串出演的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:54a01c4ac4690de97097ddfcad4bfd9f5e3af57bd3835b6a8fcab59f99998cfe",
      "text": "“等等！不能往那边走！\n那是那个家伙的陷阱！”",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:cfab363c413947c141b6360d806f2eb5b1082dce53a83a8ce195e20d273ad349",
      "text": "“哎……问我为什么会知道……\n因为，那家伙是我的……唔”",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:93e27f0e9b6597c13f6d81446340de89e4cfb37d4ed946c5040e01fd20332bf9",
      "text": "“总、总之，现在最好别穷追不舍。\n拜托了，相信我吧！”",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000039:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:fc2b37257ecbe14c648e49b0c08a779012534d5cb67b9cce3d69660b7119f93f",
      "text": "志狼君，辛苦了！\n刚才演得非常投入呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:857ba557946ee866344ecae9187702121d8cffb98069fead9fa08595c0d11bab",
      "text": "导演也夸奖说演得很棒哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000051:dialogue:000": {
      "source_hash": "sha256:b26322322e1f3f17e4c00aa484a4a85a94f1c26b85cc4cd1fe3e6431b114bc14",
      "text": "嘿嘿，那不是理所当然的嘛？",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000058:dialogue:000": {
      "source_hash": "sha256:bd1a3e5854ef2768277d67e9674860bf90d0bc93e7746fd0da3054f67d700fd3",
      "text": "我演的角色可是解开故事谜团的关键人物呢。\n为了今天，我做了好多练习。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000063:dialogue:000": {
      "source_hash": "sha256:2fab8c3ec1b7c8c88f42980713db3e3b36c88aea499e71c6e18ee2780642c458",
      "text": "能出演最喜欢的战队系列，\n超级高兴的！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000068:dialogue:000": {
      "source_hash": "sha256:c4d28472e36c4b880babd111dfa565fca540861612e5c95492e40524f3319b8c",
      "text": "虽然这次只是客串，\n但下次再演就要当战队系列的常驻角色了！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_04:1_5_033_04:cmd-000076:dialogue:000": {
      "source_hash": "sha256:c38bb933b07a6037197ea802bd00cfcf68571135a796b2e372179f4336eee514",
      "text": "好！为了有朝一日能成为常驻，\n一起加油吧。",
      "status": "draft"
    }
  }
}
