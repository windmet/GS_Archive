{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_01_e",
  "source_raw_hash": "sha256:2c369236be1af07d28e847ee252657c5321b4ec37bdfc39f2001f8fb0916c776",
  "entries": {
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000027:dialogue:000": {
      "source_hash": "sha256:5a6cefb13c6325534f78de30488dce9f82a2c169e78e3c16ea5d1fe3d7867aa9",
      "text": "这里就是游乐园……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000030:dialogue:000": {
      "source_hash": "sha256:c149c1504aa276c1bdd958711fda2bff0fcaa1115b910c4111cf17e7a36e6c3b",
      "text": "呀——！！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000033:dialogue:000": {
      "source_hash": "sha256:2a81ed2443dbe206d83a734e47b146bcd9b918f3b299e02728934e6e405a028b",
      "text": "什、什么！？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000044:dialogue:000": {
      "source_hash": "sha256:a3f2102e802d09d83e8642020d6d5de992b9172c23e08ac6d2379f73660b3c59",
      "text": "那叫做过山车，\n是乘坐高速矿车体验刺激的项目。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000048:dialogue:000": {
      "source_hash": "sha256:e21175e81b7deba1b5b3834261fb03970ee104b5310d3494c292101eae42c747",
      "text": "叫得那么大声，\n出来的人们却全都在笑呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000052:dialogue:000": {
      "source_hash": "sha256:fb60de6b768673c94196e217125c045c89b92bfc2bf8cd7fc497986e7e15730b",
      "text": "呐，我想坐那个！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000060:dialogue:000": {
      "source_hash": "sha256:d20dd97cc3b6ad0cd0be61a9b6e3ee02298cf3001fd9a42c99c53c287043258f",
      "text": "皮、皮埃尔大人要去坐那个……！？\n非常抱歉，属下无法准许。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000064:dialogue:000": {
      "source_hash": "sha256:26bbd3275e40dccee1a7966b4c680758f0204029bdfe434e641de26312b352c5",
      "text": "诶诶，为什么？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000067:dialogue:000": {
      "source_hash": "sha256:590bdae7279ebb6280f614ada5a5490e8aab8e95a268adbe7e25ca27150405be",
      "text": "因为一旦发生万一，\n很难确保皮埃尔大人的安全。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000071:dialogue:000": {
      "source_hash": "sha256:9f5e0168dd3d9d2afa143a2a02e6f9a754e92a2630e565fd890bd660957ecfe3",
      "text": "怎么这样……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_e:cmd-000076:dialogue:000": {
      "source_hash": "sha256:e1501030dd4f24a2e792214e3042c09db4415ae0a755a0285f61f32024853e87",
      "text": "唔……我知道了。\n那我们去找看起来比较安全的东西吧！",
      "status": "draft"
    }
  }
}
