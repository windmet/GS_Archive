{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "044ame_401_2_4_044_01_09_b",
  "source_raw_hash": "sha256:935e2e03b18b9ddf1ae039f872e878d5ae592d8742cb76fc2d04e951d424be22",
  "entries": {
    "story-text:v1:044ame_401_2_4_044_01_09_b:2_4_044_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:eae638d393efbe15f123ad060575d2b5c15097e0ba18cc64dfa2845b3a57d680",
      "text": "●●●●プロデューサー？今天在音乐节上，\n遇到认识的工作人员了。",
      "status": "draft"
    },
    "story-text:v1:044ame_401_2_4_044_01_09_b:2_4_044_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:ebc7854a16bf81caef8946c4e07dfaf48e7a45ed33222751b312103181b4aa33",
      "text": "对方说当时的每一个舞台都很棒，\n到现在都还经常回想起来呢。",
      "status": "draft"
    },
    "story-text:v1:044ame_401_2_4_044_01_09_b:2_4_044_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:77ccf6b4f3c9c47490f3aa59625269bdfed89f2c4040b9a0e7203f8cf202f86d",
      "text": "还特意嘱咐我，\n要替他向●●●●プロデューサー问声好呢。",
      "status": "draft"
    },
    "story-text:v1:044ame_401_2_4_044_01_09_b:2_4_044_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:044ame_401_2_4_044_01_09_b:2_4_044_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:160781a4feddcbbcbeb67f4320fe9ee9c53c86e812b88a4c23e2550498118003",
      "text": "嗯。像这样结下的缘分，\n可得好好珍惜才是。挂了啊。",
      "status": "draft"
    }
  }
}
