  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_06_018_22_5_06_018_22",
  "source_raw_hash": "sha256:64a75c935b25a9db9a3a2e1c846cc6b3d4688731e0bdf8e195634aa3bb3322d5",
  "entries": {
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000000:title:000": {
      "source_hash": "sha256:c8b5c806c01ba2a8c90acd87cc0fd6f3cabe7450822ea538bd370af01c98230c",
      "text": "演唱会结束后",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000000:synopsis:000": {
      "source_hash": "sha256:128b3bb9304447098f1b4bbc1bb56cf707060803dc9a098e2b19247715e7282b",
      "text": "为庆祝315 Production的纪念日，\n决定举办特别演唱会。\n为了打造充满PASSION的最棒舞台，\n偶像们齐心协力制作新曲、服装以及舞台演出。",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000006:time_caption:000": {
      "source_hash": "sha256:7341169a14aad90ef3fd47ff2ce36ccc767a31e739d7ce18656b8fc90e2db0de",
      "text": "演唱会结束后",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000016:mobile_message:000": {
      "source_hash": "sha256:50cd7490fe1eca3517f3625dbc66b9821b4d3132ed333e3585dbabb4bcbbf421",
      "text": "演唱会辛苦了，\n●●●●プロデューサー！\n我刚刚到达休息室了。",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:0e1c043e83a0d24479d094e7975fc96d1bf0b8ce6905500bb2acff583f64734b",
      "text": "大家刚一结束就聊得火热，\n在热烈分享感言和开反省会呢！\n另外……",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000020:mobile_message:000": {
      "source_hash": "sha256:760b213a6b70b8f2f0da558ff35e3e3e1ab9123d130b2dd5fb673dfa1723d58b",
      "text": "还有偶像为了争夺剩下的外景便当，\n说要用舞蹈决胜负，\n然后跑去练习区了！",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000022:mobile_message:000": {
      "source_hash": "sha256:88122a7678d12ddfcf89f91c71a9fb10a8b52dedf724933438b437850e1989c4",
      "text": "明明演唱会才刚结束，\n却还是精力充沛。",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000024:mobile_message:000": {
      "source_hash": "sha256:12de173fdb483229eb807b2c4014869ad2e8ec95497db41e16767205b173922b",
      "text": "还有，制作人\n提议设置的按摩室，\n也大受好评哦！",
      "status": "draft"
    },
    "story-text:v1:5_06_018_22_5_06_018_22:5_06_018_22:cmd-000026:mobile_message:000": {
      "source_hash": "sha256:1eeb41d0309bb0fd5d219cb4139ee9f6c73e9576ce6b6ba407371ec65894e34f",
      "text": "休息室的情况大致就是这样！\n连续几天的演唱会，\n真的辛苦您了！",
      "status": "draft"
    }
  }
}
