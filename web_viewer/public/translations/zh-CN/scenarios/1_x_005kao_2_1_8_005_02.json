{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_005kao_2_1_8_005_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_005kao_2_1_8_005_02:1_8_005_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:e85c197cebb135e69f39d8e5ac4aea8ce570e6347c5b82338fea6d2229258143",
      "text": "●●●●プロデューサー，原来你在这里啊。\n正好，我有话跟你说。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_2_1_8_005_02:1_8_005_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b01d622971e25b694094de1b1a4a931ece7b2b61cfba729d5fd482c9035c5897",
      "text": "祝你生日快乐。是今天吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_2_1_8_005_02:1_8_005_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:60290581b478f2a94ff54dcd4bbc632dcb30e1d7a2441b3e68a1b9d7755378f5",
      "text": "非常感谢……！\n我还以为是找我商量工作的呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_2_1_8_005_02:1_8_005_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:30544b9878b14c01e4046811aa744436d545bb06371ce1af7e90041422de1f32",
      "text": "我想在今天之内告诉你。\n我想着趁工作的间隙，肯定能逮到你。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_2_1_8_005_02:1_8_005_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:f1bd15acaa2c4becd426612b8ad2334e5788e6cb50b8e1ebbe8a1e412a86a072",
      "text": "毕竟平日承蒙你关照了。\n那么，我差不多该回岗位工作了。",
      "status": "draft"
    }
  }
}
