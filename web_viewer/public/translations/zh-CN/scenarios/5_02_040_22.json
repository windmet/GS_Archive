{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_040_22",
  "source_raw_hash": "sha256:ffe783cfea4c5cbfa7b092a37004e34f2f9a2873f8c46bd3e00ef65fe9390483",
  "entries": {
    "story-text:v1:5_02_040_22:5_02_040_22_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:9db1a4cb978883e2b3d3eab0cde2603afd9c7d0d534727732aef00182cfc1a99",
      "text": "你原来在这儿啊。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:95365bee427e612ed4e6fc164b65c9d43fb6e7b935b51aff70924ba26eeb81d0",
      "text": "呐。这个赏你了。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:3e54f47ac998ce496dfb23c58a1d8624706766f49048d2a0bf4842c181611990",
      "text": "白色情人节什么的怎样都无所谓，\n但拉面店那家伙烦死人了。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:794a3399caab248a4cd0ab888dcdac6d111d3264f5e043a3db3efe6866f20dfd",
      "text": "是没办法才给的，没办法！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:c4071b087ea9db9566c5046d350b44fa4dda03f938c48e5b7c88b1448e78cd54",
      "text": "听好了，下仆。本大爷都特意做到这地步了，\n哭着感恩戴德吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000013:dialogue:000": {
      "source_hash": "sha256:67a2c77bedcabed86a4dd491558be891622a51cf3e2bd11537128e90889f9175",
      "text": "喂，下仆，到这边来！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3c51b3b4f5ac077700df15f71875f7bf7654804e86d020f3a5cfa610915da922",
      "text": "偶尔也赏你一点施舍。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000030:dialogue:000": {
      "source_hash": "sha256:536f40d094cac4dd40dab453862ec96338e06f5af7120d1451fd62e13ae08ec0",
      "text": "这可是本大爷特意为你\n挑出来的。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:42f13f4114eac735339997647716b00e77a79fdeb43629ffb002133dc9415ef3",
      "text": "喂！哭着感恩戴德吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000038:choice_short:000": {
      "source_hash": "sha256:0f1170f22c9e7d89e514a61c7d8707bb90e9f5ef269a17ab9db216c7c76ae46c",
      "text": "好开心！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000039:choice_short:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000045:dialogue:000": {
      "source_hash": "sha256:49fcc81e2475963a3ce5ae0113ca8eaa68fdd40bb9fbeb0a66a0085316ed1115",
      "text": "哈，这种小事不过是小菜一碟。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:4800d418bd0889b4ed8e145cccaaab08321374c6f9fe72de7e94beb09543e7cc",
      "text": "听好了啊？可别因为拿到了施舍\n就得意忘形了。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_22:5_02_040_22_b:cmd-000066:dialogue:000": {
      "source_hash": "sha256:82c341837ef859678c0c35e4223bc4b5c5f2a310148b1ad4d4e165e6de0bda25",
      "text": "今后我也照样会把你使唤个够。\n库哈哈！",
      "status": "draft"
    }
  }
}
