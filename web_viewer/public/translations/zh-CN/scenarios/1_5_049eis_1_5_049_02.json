  "entries": {
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000010:title:001": {
      "source_hash": "sha256:e056afb9d97a90f454915212f9335a832fdd8aab4b7bf75fe5116c52a64570d4",
      "text": "商业设施活动主持人的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:383fdee893aac9878ecb181a74f74d3743afcb38ed1c84f9d2512890a860f639",
      "text": "原来如此，是从2楼也能看到舞台的构造啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:5b0c1e319f5e74bf18de427e13fb1b66de5b659f555570c50f5d5e8943f78997",
      "text": "毕竟是在商业设施内的舞台，\n活动会是在嘈杂的环境中进行。",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:36d86726de5429fa9719669cd4ef708306a9317725c5cd4a9c00cf39b3d888e5",
      "text": "虽然希望能让尽可能多的人驻足，\n但想必没那么容易吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:992ab78fbc94b44f196d3a090ec48be3322644f29c1985a6350dc9fd90206b84",
      "text": "是的呢。当然，\n也有期待着活动的客人，不过……",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:c4d9c5130e34679fba62817602cbe76e87ec1e9432dc3ad165c9568cfabe4ca5",
      "text": "碰巧经过这里的客人也很多。\n关键在于能吸引那些人多少兴趣。",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:74ea5b07acea8ff3e1c1b8d49231c383c42595144681c97a4cd114dea11ee1ee",
      "text": "不过，完全不用担心。\n我一定会做出成果的。",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:f9a27ca8735070e0c6d4ee6ef11f9674d081a17aaf22ce8c497ba07d02409ba1",
      "text": "是的，如果是锐心先生的话，一定能让活动\n大获成功的！",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:daeb948196e40ad94f6fc972bc3da9f89a99684904e43838d735747ae58694cf",
      "text": "我也会去招揽客人的，一起加油吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000058:time_caption:000": {
      "source_hash": "sha256:78b2075ea7fcb7e80e823e34810cc079fa038cbedfd5a29fe03c134c5b18549e",
      "text": "活动开始",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000070:dialogue:000": {
      "source_hash": "sha256:24224f52e84e70378125bda5d02e5719d34478169bd8d22fce120b539f1f1105",
      "text": "大家好，我是C.FIRST的眉见锐心。\n今天请多关照。",
      "status": "draft"
    },
    "story-text:v1:1_5_049eis_1_5_049_02:1_5_049_02:cmd-000074:dialogue:000": {
      "source_hash": "sha256:879a95700fff87ecb7ffc1d05be2846577c6b19b6931454123dfdba983f3b9e4",
      "text": "（锐心先生的谈吐让许多人驻足聆听，\n活动气氛热烈，取得了巨大成功！）",
      "status": "draft"
    }
  }
}
