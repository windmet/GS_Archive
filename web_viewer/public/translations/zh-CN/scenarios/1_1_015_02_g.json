{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_015_02_g",
  "source_raw_hash": "sha256:1323f1ce4bf72484ae348d12823a4f1156f7601ac42d40f28f203bdb24d9042f",
  "entries": {
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000011:dialogue:000": {
      "source_hash": "sha256:334e2665190c5b6d32ce28486c4b79f6e040cdda9903f0c226cc78195eac4462",
      "text": "是、是的。\n按理说，是这样的呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000013:dialogue:000": {
      "source_hash": "sha256:df9f373a5e306631facf2e58ba2618b15c439106f111d25d512f9e83a940dcb0",
      "text": "好厉害！那您，\n见过偶像和真君吗！？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000015:dialogue:000": {
      "source_hash": "sha256:9d64b4f0ac786f9014d84200431425f7ba1ecacc333a32c87db4bd730f2e0a30",
      "text": "之前在工作现场偶遇过……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000017:dialogue:000": {
      "source_hash": "sha256:41e63f7e58fcce9d5352a3bcd484d6b1bfcdec869ac38cee994e9f5f3845d73a",
      "text": "诶，好羡慕！我是他的粉丝啊！\n那前阵子出道的莎拉酱之类的呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000026:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "数分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000030:dialogue:000": {
      "source_hash": "sha256:a2ee5f8c6077194f868bb40d1c12587939d4e841ea067a59815f736e1407fed1",
      "text": "终、终于被放行了。\n不好意思，刚才明明话说到一半……",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:1d650dd7e5f06265fe40934389a4a3c699b5c6b675aceba30ab9d4694578b50a",
      "text": "……太棒了。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000036:dialogue:000": {
      "source_hash": "sha256:58b0e970a7154805b730c7b8b8c1de11e8ba344e7e958f428d8b770162b6c66a",
      "text": "诶？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000042:dialogue:000": {
      "source_hash": "sha256:6b29f0f2fad3d7922ea3f365e101aeb3e9025e5bd77f272fd27049bb546e384b",
      "text": "学生们，竟然会那么热切地\n想要打听消息……真的，太棒了！",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_g:cmd-000046:dialogue:000": {
      "source_hash": "sha256:68447efcc9a7db4d9746588384ee672a35a68affc680961ead2348f4704ff4e1",
      "text": "偶像这种存在，竟然能如此\n吸引人们的兴趣吗……！",
      "status": "draft"
    }
  }
}
