  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000010:title:001": {
      "source_hash": "sha256:c2ab4a7a3b8f39c0fb60654862c05406bdc65f7470908e484a63a66e2f95209d",
      "text": "出演时代剧电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:899f31d3268b951d729d5069c5740a851493797b3ad46486b5e70eaeb8d7baed",
      "text": "俺很喜欢时代剧。因为描绘人情冷暖的故事\n很多嘛～！这本剧本也是这样。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:ad081d1871b8c3f90fd7059b21a594995a2bfcc14284bbd395604222f82d37b3",
      "text": "我也拜读过了，是一部带有幽默元素的\n人情时代剧，感觉非常有趣呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:63c2412cee4922ed612d312314e8d829b18fe568eb11c05d660d700cfce85183",
      "text": "对吧？这部电影绝对会大获成功的！\n为了这个俺也必须努力才行。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:4628dd8572d77883e71a799754a2d3b195283111599ad2e4f8f216f822d2e401",
      "text": "俺演的角色是商人的儿子，\n是个串联起各个登场人物的关键角色。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:ad433e92482f823d62baea87c1d3ef63e5e23a1342d3802513d1d1a1c91fce8c",
      "text": "没了俺这个故事就转不动！\n俺就是抱着这种程度的干劲去挑战的。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:74fa46e7ef485e934a122221eebf6d49813768b433173f08e8bfd83f1b03ed79",
      "text": "Boss，俺读了剧本之后有些感想。\n心里正想着要把它好好表现出来呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:9ce24241ecac3d7b45813dc0c373be7ac512939a18b85d94c4af95834efaa0b0",
      "text": "您想到了什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000047:dialogue:000": {
      "source_hash": "sha256:ef6986211d42846926e5e1745d1c68fb4d7dcf6f53f4749d8f8a95ba4ad85cc7",
      "text": "是心与心的羁绊。不被金钱和权力所束缚的、\n心与心的羁绊。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:be668a742af2105e23c4fb0880140d740c5f4e6e200bf7389aa68f90544b991b",
      "text": "俺想把它好好表现出来！\n要是看的人也能感受到，那就太让人高兴了。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:785a5bd6e879098fbf2fb93c6b4ce55cfa9e653c903d2e9529b21dfe3a4e2b25",
      "text": "一定能传达到的。大吾先生的这份心意。\n好啦，拍摄差不多要开始了，我们走吧。",
      "status": "draft"
    }
  }
}
