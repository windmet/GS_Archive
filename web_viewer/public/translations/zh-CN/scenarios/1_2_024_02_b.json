{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_024_02_b",
  "source_raw_hash": "sha256:d5ee7553645398b805f13e0c2b88121ea6844e21964f4325495d8d7289aa80ef",
  "entries": {
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000022:time_caption:000": {
      "source_hash": "sha256:de032b14ad770092a08e64ee0b7359b1bdf150548e5d96e8eacb1487cc8ae481",
      "text": "次日……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000030:dialogue:000": {
      "source_hash": "sha256:e2dd92a9379bfcbf035bf1132f0b437c93d5bde6ff305989bdab4560fff4d4c6",
      "text": "话虽说是要搞得Mega华丽……\n但我们对那种东西根本一窍不通啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000035:dialogue:000": {
      "source_hash": "sha256:1ea8408a883419e48ef2c3ea36c9965acb8320bf0f2cfa72a2548577e11ef6c9",
      "text": "是啊。虽然隼人昨天\n发来了各种各样的图片……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:5510f586a28d80d836bfd6064576809dec4b05769c5e3866289b4c28cef6a0e8",
      "text": "但想把那些还原出来也很难吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000055:dialogue:000": {
      "source_hash": "sha256:9085ed456bf4336d63a30bb2fee6b101dac42980837dcfd2b97dc8415f247a6e",
      "text": "霓虹灯招牌……还有满是彩灯闪闪发光的店……\n看起来，好耀眼……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000058:dialogue:000": {
      "source_hash": "sha256:c6e43d684bd8c003f6193c6cf4d54cf6fd4edf1607a2057ebf72f0687cdc25c7",
      "text": "啊哈哈……那么大规模的\n果然还是做不来啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000072:dialogue:000": {
      "source_hash": "sha256:678e1f7ac9309e41e99d3dd957b31f546f4e56b662d5a6d801bd2c58727d0bf1",
      "text": "圣诞节装饰程度的话感觉还能想想办法，\n但要说华不华丽总觉得不太对劲……啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000076:dialogue:000": {
      "source_hash": "sha256:5faedadc5beece92730c93c6f30df8ae6daff280dbf07f4b4d043e5314988e17",
      "text": "喂，这个怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000091:dialogue:000": {
      "source_hash": "sha256:9348bda9f323635c0fdcbe43d6ab3767701c041472d341e9ee90a25463ea7b75",
      "text": "……镜面球？",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000094:dialogue:000": {
      "source_hash": "sha256:c52a71ab0d623426930afbe2b9170d57d03063fa10c87b32fee62216fedf6c92",
      "text": "没那么贵，而且放地上的那种既简单，\n又纯粹很华丽吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000108:dialogue:000": {
      "source_hash": "sha256:f9ef5e552134b99b21ac20e2ff72ed77244e56d0049dbe5f41802390d7bbf2bc",
      "text": "嗯，感觉挺不错的！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_02_1_2_024_02:1_2_024_02_b:cmd-000113:dialogue:000": {
      "source_hash": "sha256:d7f76ab9fc391c5f35a96af79abcaa314edc182edd00cc3bd53dc06e66245541",
      "text": "那就这么定了。\n那么，蛋糕该怎么办呢？",
      "status": "draft"
    }
  }
}
