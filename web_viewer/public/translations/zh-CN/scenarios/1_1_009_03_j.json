{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_03_j",
  "source_raw_hash": "sha256:58e91dcdcec6ba4f758d31b67e7b46ff975d47d9b34a7bd0284319e4c5c42c0c",
  "entries": {
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000015:dialogue:000": {
      "source_hash": "sha256:456733f3dcbfa8f3883d40773e60f2661e37226fbae9af87f3f6fca4025f23fa",
      "text": "……想起了怀念的事啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000029:dialogue:000": {
      "source_hash": "sha256:9896b3e6fda8f4b002b4c0c7885c25facce40a832cc780eedc9b11eda9de6a0b",
      "text": "（好了，稍微休息一下，再看一遍演唱会吧。\n这次要重点看唱歌和舞蹈……）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000043:dialogue:000": {
      "source_hash": "sha256:1e703c52b6f2654c34abdca947c4b4261d1e819ad62fac6865a0eb31b7e85612",
      "text": "LINK？是朱雀来的啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000051:dialogue:000": {
      "source_hash": "sha256:947fabae7c8a714c5f8526b4f145819f49fd15556374795255e186e7f3766b12",
      "text": "……看来那家伙也看完了。\n打个电话过去吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000062:dialogue:000": {
      "source_hash": "sha256:b4b08d41cbff1347c43ecb5a61eebf70ded0d0910336a79853d7ca0c0669953c",
      "text": "噢，玄武！你看LINK了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000067:dialogue:000": {
      "source_hash": "sha256:6578b15244cd360c42983ecc3bc70c00e05569275e5c0f2575936e6277f62ba8",
      "text": "嗯，所以才打过来的。我也刚好把演唱会和\n特典都看完了。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000070:dialogue:000": {
      "source_hash": "sha256:4867b678d295f2ff348869b192fa39343965b77837aeb6bcd1e3c36ac19fc3e7",
      "text": "那现在能见个面吗？\n我有好多话想跟你说啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000074:dialogue:000": {
      "source_hash": "sha256:dc7755c4fcd1a185464fe5e02017fee3ede8f289ef706229ff8ed5388b3024d0",
      "text": "也想听听玄武的感想啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000078:dialogue:000": {
      "source_hash": "sha256:838992796f20f4c854fcd361ab399e4df855501b12164e1c888a29ce453f733c",
      "text": "呵，好啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000083:dialogue:000": {
      "source_hash": "sha256:db478b6f63511bf98f8ca15b25133a3e37b942af2d98e88455b1f1dcd15e61ae",
      "text": "太好啦！那在哪碰头？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000088:dialogue:000": {
      "source_hash": "sha256:921b69446562ecc303bf08b86af017407d474c164a3103eeb935950f5ebfcd75",
      "text": "这个嘛……\n就去我们第一次见面的那个公园吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000090:dialogue:000": {
      "source_hash": "sha256:722b03682699608fbfe9a12e8cfe7f4699727e1fb8fc6d020e1da5cc4876f0f2",
      "text": "那里啊，知道了！我现在就骑车过去！\n到了再联络！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_j:cmd-000094:dialogue:000": {
      "source_hash": "sha256:328a707952c9659f4bddc62001630ad2a7a882c968b31966f6f4ed526717d4eb",
      "text": "知道了。我也马上过去。\n待会儿见。",
      "status": "draft"
    }
  }
}
