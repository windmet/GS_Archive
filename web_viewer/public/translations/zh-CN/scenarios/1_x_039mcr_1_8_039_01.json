{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_039mcr_1_8_039_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_039mcr_1_8_039_01:1_8_039_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:b3a74a800c680f114da2dae6d87dd558efd1ef1842038065a134672e8c5d6b72",
      "text": "●●●●●●●●●●师父，\n今天一天也辛苦了！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_8_039_01:1_8_039_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:11fcbc09e6f40a2496d105a7c3b30d849ed1bce268ba6633074977763b742444",
      "text": "还有……祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_8_039_01:1_8_039_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:e4d5cd964f9dfd81d4f9bd01218202c52982eef6e009e0b354068589c357903c",
      "text": "作为生日贺礼，\n请让我请您吃我们店里的拉面。",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_8_039_01:1_8_039_01:cmd-000015:mobile_message:000": {
      "source_hash": "sha256:d4d43cf4df8b72ae9f064484ecbe126f9b52982fa9f5a083b594a3a97df23171",
      "text": "今天要是能顺路过来的话\n请联系我。\n我随时候着您！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_8_039_01:1_8_039_01:cmd-000017:choice_short:000": {
      "source_hash": "sha256:2d5d7e94510ead8570df198a8efac156405143f31b34bca9441b3943fd07219b",
      "text": "我一定去！",
      "status": "draft"
    }
  }
}
