{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_01_b",
  "source_raw_hash": "sha256:f2be0535de1ec587c69cf08e2d2a165420b861591c1041f8621ca48f6995946e",
  "entries": {
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:f970b4b578c6bbbeaae511d71182cd4e2a25fc4858ccceb45a5dd73c38514641",
      "text": "其实吾辈比起那个角色，\n更好奇饰演那个角色的演员喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7fe2ea2e7b51949dc08b58f306ee3a64c590038b2853779111dfbb18bc90639f",
      "text": "如同蝴蝶一般翩翩起舞……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:6435a273d56af15df103bc3130ae714efe2005736ee2ac014ac04e9c611a28ea",
      "text": "飘飘然～……根本移不开眼喵～。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000031:dialogue:000": {
      "source_hash": "sha256:8655a554b0ffdb736de0d54de56eed17fe05abacf0785dc31c7f53c5e815b8ef",
      "text": "既能衬托主角，\n又能在自己的高光处大放异彩！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:72173858c0d77c22df41cf4a35b9909f747a723a9e9231e1fcbd25748f74a918",
      "text": "实在是太值得观察了喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000041:dialogue:000": {
      "source_hash": "sha256:935a5f5218eb0ae0ffe27e9036c451b1ae290ef58ce5c0317d66f3cfa2bae98c",
      "text": "那个演员的名字我记得好像是……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:986671bb118475273a2a57f3444d1e565ea71beb7b04a95658fd43a24e02ba27",
      "text": "咦喵？\n想不起来了喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000053:dialogue:000": {
      "source_hash": "sha256:734f64c8caaab20d5f355f342115dd3923c0eefb54cc6da17ada92a7902764b5",
      "text": "光顾着沉迷于戏目，\n完全忘了去确认名字喵～！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:9ec1e1808690f587230d5c433411371d171b347dab6ba95c58cdc447628953eb",
      "text": "呜喵……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000064:dialogue:000": {
      "source_hash": "sha256:669c5c4a0a2caf5de3cc8166cce34405df35f1409d35f96453a2d4e9a7cd5dc7",
      "text": "喵喵？猫君，你打哈欠了喵？\n再听吾辈多讲讲喵～！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000069:dialogue:000": {
      "source_hash": "sha256:73d8082bed66e18219cde52bd387b4a3adc3ab7e775a2f6c1b78d25cb2a01e1f",
      "text": "总之，是个非常好的观察对象……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000075:dialogue:000": {
      "source_hash": "sha256:fd5473cb97c2b9a4da7128215433217208dc7ec598cf4ec0a0888faeeabb1167",
      "text": "唔唔……！？叮——！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_b:cmd-000081:dialogue:000": {
      "source_hash": "sha256:4575c1e3fb988fa902e865dfd06c206da2c3a1b8695c78c68a48c8cb7da96f2c",
      "text": "吾辈的灵感降临了喵～！",
      "status": "draft"
    }
  }
}
