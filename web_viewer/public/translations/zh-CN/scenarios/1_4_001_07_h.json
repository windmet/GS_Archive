{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_07_h",
  "source_raw_hash": "sha256:b19ab8d3da300ebacee47b3a61898377c939a862df73c671d6366b594aa904b0",
  "entries": {
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000042:dialogue:000": {
      "source_hash": "sha256:729b0fc41d3c59770a71fb44484496e452cf683357b13058565d1b06506bedcc",
      "text": "不好意思。\n请问这位偶像的CD摆在哪里呢？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000046:dialogue:000": {
      "source_hash": "sha256:d76dc95dae108852c6e3115bd2ff1db1c87e33c7d2b7f92585b8bbb5f86a24a4",
      "text": "卖场在这一边。\n我来带您过去吧。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000051:dialogue:000": {
      "source_hash": "sha256:4d609c298f36263e1bc843b561678eb113aa784de72d90101248ce121308279b",
      "text": "那位偶像很棒呢。\n我也去过演唱会，现场超级棒的！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000070:dialogue:000": {
      "source_hash": "sha256:a4a23fbd9997ccd5f71a1602cda7b26ace1b9dcd1fd42cbc68a9663061d7a1ca",
      "text": "……嗯。这里的货架空了啊。\n去仓库补点货过来吧。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000091:dialogue:000": {
      "source_hash": "sha256:8f2ce76573ebe02fbca172e2f1ffb56cfb89738568713602cd6286d9e701a0af",
      "text": "呃，名字是“A”开头的。\n所以是在这个展区吧？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000099:dialogue:000": {
      "source_hash": "sha256:1f436a5cedc7e5dc929df9b1cda2e53fcc9f5314315ec6363a835379b0e01f47",
      "text": "……啊，找到了！\n客人，请走这边！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000102:dialogue:000": {
      "source_hash": "sha256:b429202103fb29e7fa355b4287358f34c6c60203e260cab3880575e6dc2ade61",
      "text": "总觉得他们虽然是艺人，\n却一点架子都没有……很有亲近感呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000106:dialogue:000": {
      "source_hash": "sha256:0abd5d8b13643ad16569eecfe9da001612e3c39cea5dddf1c18f71af02e98c17",
      "text": "那个！我以前虽然不知道Beit，\n但买了各位的CD！今后会为你们应援的！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000113:dialogue:000": {
      "source_hash": "sha256:932c29c60a2f8154279586f22c576781f90f55fe2d7cd365f4af2843c6324a7d",
      "text": "非常感谢您！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000132:dialogue:000": {
      "source_hash": "sha256:95b6fefe15183e5b56c2b045e9da712e5c1d2855836e1e770b5cdb65b66fcd39",
      "text": "实、恭二！有各种各样的人\n认识我们了……！好开心啊！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000137:dialogue:000": {
      "source_hash": "sha256:3ea2f09652bf7b3a07b2a341e114e84d48acc929a1fcf447f2d338e57b749ccd",
      "text": "嗯。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_h:cmd-000141:dialogue:000": {
      "source_hash": "sha256:3edd8b50eb75b55f4e2e82b9f015fdc2d65eed3572ff6a9fa0dd0330ab2d3883",
      "text": "呵呵，是啊。",
      "status": "draft"
    }
  }
}
