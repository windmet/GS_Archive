{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_024_01_e",
  "source_raw_hash": "sha256:82cdf61b8e2bf68657cd5822477fdeca568559c2d6d6db12975f4ea1b1f4c0b7",
  "entries": {
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000010:time_caption:000": {
      "source_hash": "sha256:d754b865bcb97c6ac4d1751a7324118e65611b0ee124791cbf4f7dff6d44926c",
      "text": "几小时后……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000018:dialogue:000": {
      "source_hash": "sha256:798d1ea127f4c3bbf76d684501ed53f3f28a717e76cf0ed69a76eb1e8dc18bb4",
      "text": "哈～不仅给前辈们买了一堆伴手礼，\n这次的工作也Mega开心啊～♪",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000023:dialogue:000": {
      "source_hash": "sha256:f9177af476c69fe64e0492da26d8297ceadddf9c838a18fb4ff6e14dbb1bca96",
      "text": "会场的大家也都很享受四季先生的脱口秀和Live！\n大获成功呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000027:dialogue:000": {
      "source_hash": "sha256:f8d12e4662cd41002eac38195737241fd5a543ed1343120d4db0bd7b8e412c89",
      "text": "客户那边也大受好评。\n还说务必希望你再去呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000032:dialogue:000": {
      "source_hash": "sha256:72ef1e713d7d2717ea9cc250321b1685a8b0436d16194ecb05a3f2f6e8333eb4",
      "text": "真的假的！？去去去！\n绝对还要再去演出！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ab4f7cb80a1c2f5a96a833888dd445ed9a1d13cc5c407e83c82c5d1caad9a621",
      "text": "就像四季先生的祖母说的那样，\n我们下次再去衣锦还乡吧！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000041:dialogue:000": {
      "source_hash": "sha256:e915a4070eebff0df93155001b7964d48e71a408747a5ae451af72ddcc01b94e",
      "text": "锦衣……对啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a6022b101600afa8e4182249321cabac73a57cc274fd7afcc2d5852ddea19759",
      "text": "我……不对，我们还要变得更大牌，\n然后举办单独的全国巡演！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000058:dialogue:000": {
      "source_hash": "sha256:2938e28de1f51df0182f90f3a70c68ba6deff311f9728881c1e0be6ff83905e8",
      "text": "到了那时候，要带着Mega Mega大的锦衣\n回来荣归故里！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000066:dialogue:000": {
      "source_hash": "sha256:24fa8abc2c92f4eb00c70bb4c22163400d257d447ae6a6a84c5547108aa831c2",
      "text": "为此●●●●プロデューサー酱！\n今后的制作工作也拜托了☆",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_e:cmd-000072:dialogue:000": {
      "source_hash": "sha256:dc38cf7847c4e3be25c1a33e32c22261c6bbf3b787c1e1ebde61d8350832eed7",
      "text": "好的！让我们一起织就\n更加华丽的锦衣吧！",
      "status": "draft"
    }
  }
}
