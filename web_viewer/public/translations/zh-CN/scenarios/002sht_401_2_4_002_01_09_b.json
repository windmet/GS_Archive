  "entries": {
    "story-text:v1:002sht_401_2_4_002_01_09_b:2_4_002_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c5391b1545216e2b389ed5ade1a5d01e2e77a2af1c0081b77df5bd394302aed8",
      "text": "啊，●●●●プロデューサー？\n是我哦。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_b:2_4_002_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:9d6568fb1f66b9f884a877a70a7f19b370bde6ceb5a2651108da41f63fb7fcca",
      "text": "工作提早结束了。离下一个预定日程\n还有相当长一段时间，我先回一趟事务所哦。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_b:2_4_002_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:8332943a3157b273c68e161cd2f2186d8aebd337de8bf3fc0932b7a77f81153a",
      "text": "啊，说起来……差不多是见面派送会时收到的\n粉丝信送达的时候了吧？",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_b:2_4_002_01_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:e00e39555e39397f008420f60d8b16a4be9e932b850e19939b5c4378ac2eb9cd",
      "text": "是的，\n已经送到了哦",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_b:2_4_002_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:8e6813051c1be10c33619fc28fedd6ef1fd5893282f72bd9b7309e16cf0a7139",
      "text": "太棒了！我一直都很期待呢♪",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_b:2_4_002_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:48361d93fb9e330b2d5b3b44ba643941ded7f52fc2518e47eaf4a86958c8f538",
      "text": "我一到那边就马上读，先帮我放着哦。\n那就拜托啦！",
      "status": "draft"
    }
  }
