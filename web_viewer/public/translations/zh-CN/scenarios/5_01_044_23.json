{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_044_23",
  "source_raw_hash": "sha256:8a81ee732a5af1caf3fe678cfd06c73e262990891499f11c5ba94d8035348836",
  "entries": {
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:81226a5371d9a50806b5bb7c088f99a4aa1363a51498300b151d05f8880cd747",
      "text": "今天的录制到这里就全结束了吧。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:643c920be1ff5cdc1cbf2eec1628df7157a8f876fc95cb9b2bac584d6263a120",
      "text": "●●●●プロデューサー。\n今天的情人节巧克力，谢啦。",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:fc057514336e89933c31b5a2f9c348347dc6d30bb5b168dc3b677ff91d683b02",
      "text": "录制能进行得如此顺利，搞不好也多亏了你送我的\n那盒巧克力呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:9eca5c4011770b52cecb25111cc62d1b4ec21365e6703e7844c57f5e4fc0c3c5",
      "text": "……我记得去年你好像说过，\n里面倾注了热情来着。",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:c8b9747b062ed1d4ad31bc28a41b009fda576cbe8ced03968ad789e19167e7e9",
      "text": "这次的巧克力里，你又为我倾注了\n怎样的心意在里面呢？",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000035:choice_short:000": {
      "source_hash": "sha256:8bfc20ccc38dcd3719a55cfbd155b3d71f2998da0d9c394ca37b171ee1fe009d",
      "text": "是更加厉害的热情！",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000036:choice_short:000": {
      "source_hash": "sha256:267176141a186a2f9695ae0af0dc83a07f680e0f33d091fa8a9d3aeed14b63ff",
      "text": "是不可思议的超大热情！",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000037:choice_short:000": {
      "source_hash": "sha256:79ce28ff768daf3e96e74ae743a344a273dec70b7f1e40addb48bfb0d66b5805",
      "text": "是特别的热情！",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:327441390099d8acc0c322bd483d763b289de67b05e14a2d92aa7e3b38d8b584",
      "text": "哈哈，原来如此啊。\n那可真让人期待品尝了。",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:6327a10a2059f25fbd8342f188e519d3cf1b7240a555b926a74ed2ad80a565c5",
      "text": "好啦，差不多也该从这儿出发了。",
      "status": "draft"
    },
    "story-text:v1:5_01_044_23:5_01_044_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:d003575a5dfce32b6911ae4ca46f6ff0ce3864842f54a04e18ffeb8509c1abf2",
      "text": "早点回到家，好好品味一番你送我的巧克力吧。",
      "status": "draft"
    }
  }
}
