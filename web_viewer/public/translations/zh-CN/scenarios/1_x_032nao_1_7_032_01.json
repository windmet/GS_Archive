{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_032nao_1_7_032_01",
  "source_raw_hash": "sha256:ee6c7b6aa14d4e901206b0ebba499373f105d5766c854e7312ecf80ca5d70571",
  "entries": {
    "story-text:v1:1_x_032nao_1_7_032_01:1_7_032_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:d250611e147a78bd2dff174d4435631091474758bec7a82d5478d1f176f2d8ca",
      "text": "直央君，\n祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_1_7_032_01:1_7_032_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:262a327d9cfc10a492987553f366a5066003e229204cf7ad50ae3753e750971f",
      "text": "哇哇哇，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_1_7_032_01:1_7_032_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:d2d3e2b5a5838da659209fc79492da54776ed0d628e3d253049e73e522459c4a",
      "text": "啊，对不起……我有点吓了一跳。\n非常感谢您！",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_1_7_032_01:1_7_032_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:a70e1f77329e500ffc3250f680bc89e0b3aff8bd9f5e340223a42f4b4f0c5a8f",
      "text": "能被您记住生日，\n我真的好高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_1_7_032_01:1_7_032_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:19e1a56e40ca5ca9cc2178893b370113866cf115e3310ef005858a4acb6420da",
      "text": "今天收到了祝福，\n我一辈子都不会忘记的！",
      "status": "draft"
    }
  }
}
