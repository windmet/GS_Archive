{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "022nat_401_2_4_022_01_09_b",
  "source_raw_hash": "sha256:40902ad21bddf226d9f1293b91fa841573893c4d31f3001c4b9e86c5c3b59108",
  "entries": {
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:e5a3fc4620b7c46d010185780b2c522a3b9e6e7c00ed5739269d1baa4113243f",
      "text": "●●●●プロデューサー，\n彩排……结束了哦。",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:f5af419b02678aebbd34e0aaa110a610b0be10836aede3d1bd31903834c6fd38",
      "text": "大家的氛围和刚才在游乐园玩的时候\n完全不一样，好帅气……",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:bf17057adca04eb6a7ebd666d3464031059866739c9ea4c0287c34d9a81b661b",
      "text": "我也和大家一起练习过了……\n所以觉得……应该做得挺好的……",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:dfdc071f9b2898dc63dfe50c1b7818797a3ea562054837443ea69ef769ffdff5",
      "text": "正式演出也会……加油的。",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:24f9f6122aeaa3b33d3b01ff219b880494c47a91a029a6679888905e401f01ed",
      "text": "请加油！\n我也会为您应援的",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000015:choice_short:000": {
      "source_hash": "sha256:99a7cd4d7bccf959ce752193cd4153fd39a66959c1e2511026581f5696d7186e",
      "text": "很期待夏来先生的\n暗黑王子形象！",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:f489054774003e0e85e4971f6e043bb39d751fe07bf4555905d727a743ae9426",
      "text": "嗯，谢谢你……\n●●●●プロデューサー的应援，让我很高兴……",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:536cd443ea062d65fb7a210d78f5554a0a97bd25f908e7eb3a7d507bf62d4abd",
      "text": "呵呵，谢谢你……\n我会发挥出……练习的成果的。",
      "status": "draft"
    },
    "story-text:v1:022nat_401_2_4_022_01_09_b:2_4_022_01_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:8899626fe6b3b07cc6d4a0a4986f50fdbe9ec00224eee38072d29dd9feee0747",
      "text": "我会和大家一起，带来最棒的舞台的。\n那就待会儿见哦……",
      "status": "draft"
    }
  }
}
