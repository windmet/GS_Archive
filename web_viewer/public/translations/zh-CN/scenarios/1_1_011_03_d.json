{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_011_03_d",
  "source_raw_hash": "sha256:4246d48205b4aa8745c5feb48fb335b7fc14c430a56944412377b374ef336f64",
  "entries": {
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000019:dialogue:000": {
      "source_hash": "sha256:3818efb0e2c1c7b672feed839aef3dd48374dbbefe618ab35b2865814e1efe41",
      "text": "偶像……？\n嗝，为什么找花音？",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000022:dialogue:000": {
      "source_hash": "sha256:8a2f52698df4da1d7863cf59af46f3f78ce063e1c3728c84287bdd555a4b83de",
      "text": "说是看到了花音当模特的表现。非常热心地\n希望你能参加试镜呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000025:dialogue:000": {
      "source_hash": "sha256:f845377c93b48e2935719446fee64acb28c42d13814a9aea904025a2bae0f3b2",
      "text": "要是不介意的话，哪怕只是去听听看呢？",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000035:dialogue:000": {
      "source_hash": "sha256:0ccca2e355da52842bc13537045e37e1ac075d4a33be0417dceef21a8ce532e0",
      "text": "（……虽然花音不太懂偶像是什么，\n但有人很看重花音呢）",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000043:dialogue:000": {
      "source_hash": "sha256:c8ee7cefc219e02612530d59112ea2850e2423167631a8ba5096c7ad0f2f3bd9",
      "text": "嗯……我知道了。\n花音去听听看。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000059:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "数日后……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000080:dialogue:000": {
      "source_hash": "sha256:0f199b2bf828378b9f2601606db7b29caf92f9ab5146929784da92ea775d2f12",
      "text": "好啦，到了。\n这里就是315 Production了。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000085:dialogue:000": {
      "source_hash": "sha256:afc8ea9e36014c69a396472c83a97eeed6314b9bb34fdfe2b1067e4c5cfd5990",
      "text": "这里就是偶像的事务所吗……？\n呜呜，破破烂烂又阴暗，一点也不可爱～。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000088:dialogue:000": {
      "source_hash": "sha256:1325c2ad47b1db593d7fb21fc9f7e9428a12eb951ebf709ad90fe2243b8e7a5c",
      "text": "喂，不能这么说话。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000098:dialogue:000": {
      "source_hash": "sha256:ea901ae5e360610f0cad698b650ad52de4b77e69ae8c339b32922b7aae1541fb",
      "text": "我是今天预约过的姬野。\n请多多关照。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000105:dialogue:000": {
      "source_hash": "sha256:747fd7d8a6a7594922874666bb95c8685242312d779a940bfdf1035b2d47fe09",
      "text": "您好。\n非常感谢二位的光临！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000107:dialogue:000": {
      "source_hash": "sha256:de0769863fa370c67c4e10566be6453482a2a66422af8c660127be0bccaa59a3",
      "text": "今天请多多关照。\n那么，请往这边走。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_d:cmd-000110:dialogue:000": {
      "source_hash": "sha256:f45d7ffa6c147b3598ad14b10a7e34ad20a6bdfb0139c448e065cc8112c13fd1",
      "text": "请多多关照。",
      "status": "draft"
    }
  }
}
