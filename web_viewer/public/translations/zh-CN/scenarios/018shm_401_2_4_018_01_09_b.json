{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "018shm_401_2_4_018_01_09_b",
  "source_raw_hash": "sha256:231e07f2d2f7f7c6a0a37ee9cca7d10e73a81441506fd183145d6ae84af160c1",
  "entries": {
    "story-text:v1:018shm_401_2_4_018_01_09_b:2_4_018_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:43de8dedff04f11cbf07b77c79f954832f4bf6349af58fe1b45fc5c18a0e11b6",
      "text": "……啊，●●●●プロデューサー酱？\n我稍微有点事想拜托你呢。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_b:2_4_018_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:052781ac9ef5aa23c8f856321c326db6f2d9b4bc63f30fc22cbbdf3979d1aa6f",
      "text": "我和小伙子们聊音乐节聊得可起劲了。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_b:2_4_018_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:01fc3cb47eb297291869aa95bf03aea798fb29040ee1dd3d14f1a6eecb32db11",
      "text": "于是大家就说，在练习前先把音乐节上\n表演过的曲子稍微跳上一跳。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_b:2_4_018_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:56eb7430333f2af9b3c0394ffebab04668c53ac11d63d38f52adfa16f6249a7b",
      "text": "但手头没有音源呢。\n方便的话能发我一份吗？",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_b:2_4_018_01_09_b:cmd-000016:choice_short:000": {
      "source_hash": "sha256:f8d4f6d24c62f66b745c7292022a8f3cf2efa3fb40d53e2d5d2e1cdd0f8e1c8c",
      "text": "我马上发给您！",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_b:2_4_018_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:2601edf3c1ca0ea7183284cf2d7da63ef35a42d9dd09d74920ca69b35a9e9f69",
      "text": "谢谢你呀。那就拜托你啦。",
      "status": "draft"
    }
  }
}
