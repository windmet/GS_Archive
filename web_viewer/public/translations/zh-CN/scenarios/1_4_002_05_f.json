{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_05_f",
  "source_raw_hash": "sha256:7aca20e4c92e073da30af3ae569c891010727b9e384cdcaae49bac06a06a2216",
  "entries": {
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000019:time_caption:000": {
      "source_hash": "sha256:c43fe4333999fca8f30d947959012e7845c256c03f344be66669fd1841445174",
      "text": "图书馆",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e28761e02323a7342728a07cbb3f363825701be59bccc7fef54e2ebeca3140df",
      "text": "喵呵呵……\n这家图书馆，到处都是宝藏喵♪",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000043:dialogue:000": {
      "source_hash": "sha256:b75290025aed88b1aa99a3b2cd7c722904c65d63c9f99dc42b23dbdddbf1e631",
      "text": "嗖的一下！\n在下先去各处转转看看了喵～。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000060:dialogue:000": {
      "source_hash": "sha256:9030b6c80d48f2d6a0a46e26a9807066b91335b334532f27815a4f2de2529f93",
      "text": "我去向图书管理员打听一下\n有没有关于镰仓的推荐书籍。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000064:dialogue:000": {
      "source_hash": "sha256:fe3a24b2b0eab73826fba938cfc90710bc911837e9cf987aac7cd7202dd6341f",
      "text": "人家挑选了几本，\n去那边翻翻看啰。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000073:dialogue:000": {
      "source_hash": "sha256:0a4def73fd0a0194024c6768fe777315a88010b3077d0cc3ecb763fd0be9f0d1",
      "text": "●●●●プロデューサー酱，\n有什么事随时叫我哦。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000094:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000105:dialogue:000": {
      "source_hash": "sha256:f93237388ae067fe4a2554549944bf213f65cf8ee4901adbfc0a035149e739bf",
      "text": "（总觉得好怀念啊。\n那是初中参加完社会实践课之后的事了）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000109:dialogue:000": {
      "source_hash": "sha256:f4569e2cca9201a1e6a899780ac7017fc78272ef36a564c0e43d5432e64f76b9",
      "text": "（被第一次看到的歌舞伎勾走了魂，也是像这样，\n一个人泡在学校的图书馆里来着……）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000146:dialogue:000": {
      "source_hash": "sha256:7e0553d694051a0251c56e2d9d7054587439cc40b383cac07fc8c4fd38cecef8",
      "text": "（歌舞伎的世界竟然如此深奥。\n而且，是多么璀璨夺目啊……！）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000156:dialogue:000": {
      "source_hash": "sha256:26620a3309cce290c1594b7bcd8cb820ab05ac96c2c30a9c228d622d7a1b72df",
      "text": "这不是华村吗。\n又在看歌舞伎的书啊？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_05:1_4_002_05_f:cmd-000158:dialogue:000": {
      "source_hash": "sha256:646fd19becb20885b9661efa625ed0dbbe693693d80d984ccfcf0b800d4cc972",
      "text": "老师，正巧。\n我有件事想拜托您……",
      "status": "draft"
    }
  }
}
