  "entries": {
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000011:title:001": {
      "source_hash": "sha256:6f2469f662591055092d0f0633847c5a6e15ffa39c6434455675e620b46f5f46",
      "text": "杂志美食报道的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:d2d15ed14cf0556ae726bd54d006d3f1aaa6c564658ac0161e3991a6a93e93ab",
      "text": "丽先生，您在确认什么呢？\n啊，是今天要做报道的菜单啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:4c8c4ed77a3529393a21dd7aba5487b8bc19cd8e24c217b155679485860974e0",
      "text": "嗯，我想事先确认一下会吃到怎样的料理。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:ca09928203f32320add2c1552f212602d03b580541be7edc584ec4b8c979d62a",
      "text": "每一道看起来都很美味。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:36884642460ab5a101b812e86560d0138a532becbcabfe138d24e5e4891736a6",
      "text": "哇，真的呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:1c9277c5728276b23ccb898343e42e9ac791388d411274edf651d667d7396c31",
      "text": "说起来，我并没有什么做美食报道的经验，\n能做好吗。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:f32ab5e272c77648afa2a9847faf3842cfc2e92487051435460a57dc0b44263e",
      "text": "虽然也试着练习过了，\n但不知能否做出记者期望的反应……",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:ca6e2ef4843e3e41f6c7f684179e125226949aea443b2af51597b3fe5de62cd5",
      "text": "只要将品尝后真实的感想如实传达出来就没问题了哦。\n丽先生请尽情享受美食吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000042:dialogue:000": {
      "source_hash": "sha256:0ddd59e21963ff6432d653875b3995e161019d3dfda21909a6c685b4ee13c734",
      "text": "享受美食……明白了。我试一试。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:20a93fa010dce8947a80fb1dc853306c5ecdc06773cc403c7a9bf54005238c13",
      "text": "好的！很期待丽先生的美食报道哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000049:dialogue:000": {
      "source_hash": "sha256:5d836b6354f2930a88cbbfb6b71dd9a54cab23055cea3654ea17a2888eb6dfa7",
      "text": "嗯。\n……拍摄似乎准备好了。我去了。",
      "status": "draft"
    }
  }
}
