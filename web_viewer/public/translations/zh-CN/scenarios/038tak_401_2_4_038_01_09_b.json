  "entries": {
    "story-text:v1:038tak_401_2_4_038_01_09_b:2_4_038_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:9aa80f90e32f92ce7c61cc6f956a76d6fdd2ea8d3be3d09b78257419ba2e709c",
      "text": "喂，●●●●プロデューサー。\n碰头会辛苦了。",
      "status": "draft"
    },
    "story-text:v1:038tak_401_2_4_038_01_09_b:2_4_038_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:11537e8d051f6701d698fc3e62ac28e34b01e1885e416337236ea6c6f8fd4d90",
      "text": "除了315 Pro以外，还会有很多其他艺人登场吧……",
      "status": "draft"
    },
    "story-text:v1:038tak_401_2_4_038_01_09_b:2_4_038_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:3ae563d401510c89e64ef36e736fa333ed63c370ef668eb12d0e60ea4630db61",
      "text": "怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:038tak_401_2_4_038_01_09_b:2_4_038_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:4c2c39f6f235a88b7f8ec2516fe0eecbb45025896930e94804b8a7568db183de",
      "text": "我只是在想，会有很多观众\n在电视上看我们的表演吧。",
      "status": "draft"
    },
    "story-text:v1:038tak_401_2_4_038_01_09_b:2_4_038_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:c0018b264afe51ff5d6ba2e21c74cbae2cdf575ce04eb2d891035edcc928da16",
      "text": "你拜托我们定的发言人选，定好了之后\n我和圆城寺先生会联络你的。先这样。",
      "status": "draft"
    }
  }
}
