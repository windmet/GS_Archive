{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_009_02_a",
  "source_raw_hash": "sha256:f435f79d45fb121d4f2b3c59b7f3b6a63d411b729de489ed768ad74b2ff7cbe1",
  "entries": {
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:2fe2fddfa99cdfc49cb16e647f6d93caab1a8771329dacb04dd3577161988514",
      "text": "身为派对主角的自觉",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:37cdbdefe8e2604dde8471a146b65aedda691eadfe6a4c77680121c067116d65",
      "text": "对自己的生日并不怎么上心的恭二。\n恭二以两人工作繁忙为由想要推掉派对，\n实和皮埃尔努力劝说他，\n并抽空在工作间隙筹备派对，然而……",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000020:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000020:title:001": {
      "source_hash": "sha256:2fe2fddfa99cdfc49cb16e647f6d93caab1a8771329dacb04dd3577161988514",
      "text": "身为派对主角的自觉",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:fb7e60929f671fd13b276e3a72845ca5285cc631c2569d08e90798621b07a3c5",
      "text": "恭二。你应该知道的吧，\n2月2日一定要空出来哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:dbca09505fe64f952bbf109da598196519e6022180f7e4dc801323930965e4eb",
      "text": "2月2日……是我的生日啊。\n有什么安排吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000052:dialogue:000": {
      "source_hash": "sha256:1034b9bf8d9b45d286b860e97bd78b62993b1367410abd2ba9ecdfa9da5dbfd0",
      "text": "当然是恭二的生日派对啦。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000057:dialogue:000": {
      "source_hash": "sha256:65d948be0b29f1e3a37480ea2259b39bd44c15571ad47c39fc5c30f47d0fe948",
      "text": "大家一起庆祝！",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000063:dialogue:000": {
      "source_hash": "sha256:ef05085cb215aa07a9f5b2f6b6da23a74e863a7ca5b0e58790f59ca3f6baf48b",
      "text": "派对？\n算了吧。你们两个也挺忙的……",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000069:dialogue:000": {
      "source_hash": "sha256:4b5be1be82f0677e1ebcf23a432b687f12f6e7b2ac26e75396b4177f5336da1c",
      "text": "不许说这种话。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000080:dialogue:000": {
      "source_hash": "sha256:25f571135ee9a3691340060b9435a976a266400c8baf77606d3e6b2d2723966b",
      "text": "生日，一年只有一次……是特别的日子。\n我今年也想为恭二庆祝！",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000084:dialogue:000": {
      "source_hash": "sha256:d26832ab776b524dad5ba32abcf71b1b37450b7c4e6d48050173b38493218d83",
      "text": "准备，我会加油的。\n恭二，求你了。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000091:dialogue:000": {
      "source_hash": "sha256:69a66b57b3b58c0220da6c162a64d4d0771899fae360faf92acc50cf973a8b96",
      "text": "哈哈，这都搞不清到底谁才是被庆祝的一方了。\n那就拜托你们了。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_02_1_2_009_02:1_2_009_02_a:cmd-000098:dialogue:000": {
      "source_hash": "sha256:495e251ab4db04d53411bfb1a573047053a2a845f081694356625a3e4afa2ee9",
      "text": "呀呼——！\n要办开心的派对。好好期待着吧！",
      "status": "draft"
    }
  }
}
