{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_034kan_1_8_034_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_034kan_1_8_034_01:1_8_034_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:86f7bddf260cf5caecbed3aaff8491dc3580892abf2a1ea942d2d379808b93e5",
      "text": "这是花音出的小测验哦～！\n请问今天是什么日子呢？",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_8_034_01:1_8_034_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:f9f07994339ca14dfed539f4058e8839079136737bc0fbd84099767ee72a7590",
      "text": "正确答案是～……●●●●プロデューサー的\n生日！",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_8_034_01:1_8_034_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:50d5c60551d6afabaab31ccf0bb5cb652c6f8e18455613e6b1f0569893f1d704",
      "text": "原来你一直记着呀。\n谢谢你，花音君！",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_8_034_01:1_8_034_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:2fbbee0a7edba4fe46972050f0adf1468a7c3cfa24f5bb51fa7b3e39c003c773",
      "text": "诶嘿嘿，因为是最～喜欢的●●●●プロデューサー的\n生日，所以人家好好记着呢♪",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_8_034_01:1_8_034_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:3f1eceaa2f115a1a07a7254a8facd6b9644ceea105e0b5074215cee20101b794",
      "text": "●●●●プロデューサー，\n祝你生日快乐！",
      "status": "draft"
    }
  }
}
