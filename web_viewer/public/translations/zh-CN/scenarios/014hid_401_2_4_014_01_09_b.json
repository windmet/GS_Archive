{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "014hid_401_2_4_014_01_09_b",
  "source_raw_hash": "sha256:b4a5c71fe361d90efdb456a5d6cc256aa05dc1437b204209de53417b87de32ab",
  "entries": {
    "story-text:v1:014hid_401_2_4_014_01_09_b:2_4_014_01_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:270e7e851705af314667957fd9a6954dd76e001348ecddf41155db478258b449",
      "text": "啊，喂喂。●●●●プロデューサー？\n我是握野。突然联系你真不好意思。",
      "status": "draft"
    },
    "story-text:v1:014hid_401_2_4_014_01_09_b:2_4_014_01_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:e13795e4cccda327f4065ec98726bd5a2d7ffe403fa459743e86b025fdb8c733",
      "text": "可能是因为刚才还在舞台上的缘故吧。\n演唱会的热度久久不退，忍不住就联系你了。",
      "status": "draft"
    },
    "story-text:v1:014hid_401_2_4_014_01_09_b:2_4_014_01_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:be61e8551e663b460827f9b51965dbff648aee15d923f88669014cd013cd5768",
      "text": "今天辛苦了。本以为已经习惯了，\n但上台前果然还是会紧张啊。",
      "status": "draft"
    },
    "story-text:v1:014hid_401_2_4_014_01_09_b:2_4_014_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:668b82fe454f3608ce5652166707d4a34fed1bceedb93c57f6fa69ff7dc74598",
      "text": "正因为有●●●●プロデューサー在，\n演唱会才能顺利落幕啊。",
      "status": "draft"
    },
    "story-text:v1:014hid_401_2_4_014_01_09_b:2_4_014_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:2a2d80f73f0b38873d5dd0e568fa5922f49520da9b0983897117c8134c691db9",
      "text": "再次谢谢你啦。\n下次我也会加油的，就拜托你啦！",
      "status": "draft"
    },
    "story-text:v1:014hid_401_2_4_014_01_09_b:2_4_014_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:cf0b71eb79ef73a73ca40a5d3b69b9a613eeb9aa4106a429f5b51b03bf7bb868",
      "text": "……谢谢你听我说话。\n那就在事务所再见吧。",
      "status": "draft"
    }
  }
}
