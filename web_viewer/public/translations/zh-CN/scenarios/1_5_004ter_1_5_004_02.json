  "scenario_id": "1_5_004ter_1_5_004_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000011:title:001": {
      "source_hash": "sha256:ac760517278f7c39b7b1d46f3d46aaa7ab842a878e3562edccc8e62a252e4ce9",
      "text": "原创动画电影声优的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:c28e2c83db5e906926fcd7f52c1177ae3fe9b75943a228c8fe555b7f28531ea8",
      "text": "今天是面向媒体的公开录音呢。\n辉先生……紧张了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:c161b8bd7776d6c397062763f9cbcf3254cf8f51dac5dfa829259c8466aaab15",
      "text": "才、才没有！\n这叫按捺不住的兴奋！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:c64da9ce8256d70148aaad3976feaa1d17847426745ec183f534b301dbdc9ae7",
      "text": "在音乐节目收录时明明早就习惯镜头了，\n为什么会这样呢……",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:79e49273592537f09bede9054876dca480ee28f7f1ff82efa2b40c896dea9c25",
      "text": "不过，收录声音的光景平时可不怎么能见到，\n是个好机会呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:97d833eefb1db306622116b4f6eab4c1bd24e5a80d4234aaac6505a00426c5d0",
      "text": "要展示的片段也是情绪高涨的场面呢。\n我也很期待！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:5349afc71ef73e7a48b8f992bc7d74a921e2d3149ced38981c2e2105397f1801",
      "text": "差不多该前往录音棚了，\n没问题吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:76f37761bae8e98f5b2123a7cb56cec7098ea91707f757b867cb04afa13bba51",
      "text": "好，干劲满满地上吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:28866f5c42510e52d9aa7eb5a4e5ff22825c4121dc542dc314d282e71062de83",
      "text": "多亏了和●●●●プロデューサー聊了聊，\n发抖好像也停下来了！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:50dc7d37718e76c722be8a01fe4e4b95d0d5dd42245213763a0be3d86c48f519",
      "text": "那真是太好了！请加油哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_02:1_5_004_02:cmd-000061:dialogue:000": {
      "source_hash": "sha256:367920880bfd3d49881ce5c860c26d7cf3a433253b74ca190c676a79b30f5081",
      "text": "哦！为了嗓子我也带了水，这样上台前就\n不会慌乱抓水喝了！开个玩笑。",
      "status": "draft"
    }
  }
}
