{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10015_01_c",
  "source_raw_hash": "sha256:6c352bfc21e534421702afbb63c82c161ba41174e8536a1d699ae28a656ccba4",
  "entries": {
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000023:dialogue:000": {
      "source_hash": "sha256:da36e0256085d1ea08851eee1ab8a18039af16af91e5deedf19d331f3b31160f",
      "text": "本次的产品非常注重高级感。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e3219280de5f7f28eb770af7143e39b50076eb9a307b965471abe6d2433ef214",
      "text": "配合广告的主题，我们构思了以冬日高贵王子为形象的\n剧情短片。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:bc9f3bcb3800808d78a9ffec6a70dcd51f1ae6720031306a4e739e4cafe89ec5",
      "text": "因此，我们非常希望能够拜托Beit的各位，\n才提出了这份委托。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000035:dialogue:000": {
      "source_hash": "sha256:54d25e23b1fc81fa0ebd8f8878d904a941f40aee6dfa7962ee51cd7e5b87a286",
      "text": "王子啊……",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:4d4cb91fc0bec016b34562e014f34b632f468d237116471dd0f4cee6ff5ac954",
      "text": "呵呵。恭二，感到为难了吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000044:dialogue:000": {
      "source_hash": "sha256:25945ac9dc19d3ce211ad54bbe62d5ea2539cfb060056dc2d18d63692fb44204",
      "text": "没、没有这回事。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000052:dialogue:000": {
      "source_hash": "sha256:f8e2654bfb20516dc156e685695ee90cfa369c19eb84c17539f3803e647c385c",
      "text": "剧本还在准备中。如果各位心中已经有了画面，\n按照你们的想法来进行也是可以的。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000058:dialogue:000": {
      "source_hash": "sha256:9002e33c8200212f98acfe7b26dd242f9586193072f2320f5859fc5e2c323aa7",
      "text": "请务必让我们自己来准备！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000062:dialogue:000": {
      "source_hash": "sha256:5774059c4c6bde3924e091bcdc1ed06b515462b7163bcc7e5385caff7bd95c80",
      "text": "诶？我可写不来剧本啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000066:dialogue:000": {
      "source_hash": "sha256:0acf0ae69639c045ebba3c274b4f6d6ecf072c0f7bff48bb7eca3625a0b18dfb",
      "text": "剧本……\n我，也能写吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000076:dialogue:000": {
      "source_hash": "sha256:5275ab46aad2f43f113f4f1b9dd1f4f61e63088135b6baa207c940b35f842fd2",
      "text": "没关系！包在我身上。\n我一定会把你们两个打造成最棒的王子的！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000082:dialogue:000": {
      "source_hash": "sha256:199d2990f8143b844c3cf9f33f113b1e2d2cc928f1080882b21e9e70ad17b705",
      "text": "喔——实，干劲满满呢。\n我，非常期待。加油！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000098:time_caption:000": {
      "source_hash": "sha256:c06bec2d17ca298ddc78047d1048113a76b39007f0d0346335dc0372e75a243c",
      "text": "商讨结束后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000106:mobile_message:000": {
      "source_hash": "sha256:b3fa31b3101120dcacc4cbdcf4055a834f4f25f237589a2620e94d606a084066",
      "text": "商讨辛苦啦<emoji>image_talk_emoji_16</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000108:mobile_message:000": {
      "source_hash": "sha256:c315f2b406166d37d283b4a21e5f34c9de38d68006aab549c9e0303c91066f58",
      "text": "给我们试饮的新产品，\n很好喝呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000110:mobile_message:000": {
      "source_hash": "sha256:e218fc473eb65f3ea4327648b36186caeaaca9932191e27e0004b05924ea828c",
      "text": "在便利店就能轻松买到\n也是它的魅力所在呢",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000112:mobile_message:000": {
      "source_hash": "sha256:b25c1f75df838a3843b37e56eaf968377ba46a0f7054530d54f1a021d895c0b4",
      "text": "甜甜的，很好喝！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000114:mobile_message:000": {
      "source_hash": "sha256:2678908980f13040fa716b4aef21123642fe6a98df8c35e208f5b3b4f47c7e9a",
      "text": "我\n在店里看到了就要买！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000116:choice_short:000": {
      "source_hash": "sha256:81a625f105158a423073d74546e1478d4f18340b32053caa16f955c4576063ee",
      "text": "恭二先生也\n喝得很香呢",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000116:choice_detail:000": {
      "source_hash": "sha256:78a22e553f22752c8989111679f7c7a834fd191e5ee121c61bac2061b9208351",
      "text": "恭二先生喝的时候\n看起来也觉得很好喝呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000117:choice_short:000": {
      "source_hash": "sha256:8ab791be3dc484b1b66fe38f680a56d8f86fe3d5f455b2700c473c94b8b24f21",
      "text": "恭二先生觉得\n怎么样呢？",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000117:choice_detail:000": {
      "source_hash": "sha256:98185f460ca8fce1515f1615ed1e65fbff962618dfe116618d81e7495db73b4c",
      "text": "恭二先生尝了新产品后\n觉得怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000121:mobile_message:000": {
      "source_hash": "sha256:9f8bcb5819ff20ddd8bc4f571a5eaf367843fb887923b173f0d12693825d6aad",
      "text": "本来还担心自己\n能不能尝出味道的差别，\n但一下子就喝出来了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000123:mobile_message:000": {
      "source_hash": "sha256:0648b4bd339aa12427fa270eaa2d67f1ae113dd01ef631bf646f89e0a5fa8799",
      "text": "呵呵，是啊。\n为了把产品的魅力传达给大家，\n一起加油吧<emoji>image_talk_emoji_37</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_c:cmd-000125:mobile_message:000": {
      "source_hash": "sha256:0522f5feb089c6d0ce8700a3a14d006211d88ef37bf2eed6509b13d9b6b2b377",
      "text": "喔——！",
      "status": "draft"
    }
  }
}
