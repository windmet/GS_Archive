{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_023har_1_7_023_01",
  "source_raw_hash": "sha256:90f07ec29de625abc97efb7e7455846059175f535ef240017c23a9492b5772b9",
  "entries": {
    "story-text:v1:1_x_023har_1_7_023_01:1_7_023_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:116c24add120789d62f42a498d749a3e4d8f8aa03c42202caebbdff9c678e5a9",
      "text": "春名先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_7_023_01:1_7_023_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:f9e01145e018d949f19fd0da098afd2e98f62bcc70e4069f558cc8ada1c2031b",
      "text": "噢，你还记着啊。\n谢啦，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_7_023_01:1_7_023_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:cf1b1aa4b1d047782b822370f01c81f0efb0877508cae4e438a2a65d8b4da6b3",
      "text": "能被庆祝，超开心的。\n今天就用甜甜圈来庆祝吧！",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_7_023_01:1_7_023_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:8c2fa31bb899f1030b306ce37d854c48bc1788505bf244af1898a3daaa943781",
      "text": "嗯？说到庆祝肯定就是甜甜圈了吧？\n生日那天吃的格外好吃呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_7_023_01:1_7_023_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:27c3c4071b8db0fb2315e419d5d7744085d263ab3b3045947a6cb75950bbc1ad",
      "text": "我买了一大堆回来，\n●●●●プロデューサー也一起吃吧！",
      "status": "draft"
    }
  }
}
