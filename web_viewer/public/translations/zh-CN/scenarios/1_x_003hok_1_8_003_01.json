  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_003hok_1_8_003_01:1_8_003_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:dbe417f6ee374adc75dd08e841c47c38df31ec62ffba74006c9c23d4d585d0a3",
      "text": "喂喂？辛苦了。\n现在方便说话吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_8_003_01:1_8_003_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:0d2f577759dfd5794b00fbff3f6c73374f4b35a19320cdf8375a689b716dff2a",
      "text": "谢谢。\n那么，●●●●プロデューサー……",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_8_003_01:1_8_003_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:6c57b8e2758d1984926aad3cb7edd2306038b0b8751300c12fd334decddeedbf",
      "text": "祝你生日快乐。\n愿今天能成为属于你的美好一天。",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_8_003_01:1_8_003_01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:1749b2e403ed486913e24bcd3490de927c37efc3a5846c0788bb31b203465499",
      "text": "非常感谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_8_003_01:1_8_003_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:ce0a9fe626c709b2cdfbe149536bad5ab9138bd1b937955ebf0d7b2afd2a07ea",
      "text": "呵呵，待会儿请让我再正式为你庆祝一次吧。\n那我马上要开始工作了，先失陪了。",
      "status": "draft"
    }
  }
}
