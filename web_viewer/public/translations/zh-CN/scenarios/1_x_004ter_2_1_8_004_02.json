{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_004ter_2_1_8_004_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_004ter_2_1_8_004_02:1_8_004_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:9344eb64ec5908d2fbde73568970b3f5648219da2ff839212f5fd0da57614f09",
      "text": "●●●●プロデューサー，辛苦啦！\n这么晚打扰你真不好意思。",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_2_1_8_004_02:1_8_004_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:d995315f72dde98268aa2360b3d909ca1dd5eb5e9d8a542b55e870b98ae7173b",
      "text": "今天是你生日吧？祝你生日快乐！\n我就想着先打电话跟你说一声。",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_2_1_8_004_02:1_8_004_02:cmd-000014:choice_short:000": {
      "source_hash": "sha256:c755ec82c9dca8f45c90449b65a835de76238c322530e911ff0c346c600319e4",
      "text": "这么早就送来祝福，\n非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_2_1_8_004_02:1_8_004_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:59255f200a8d83fca07e117e09edc8a044c08d58281ea21041db9ea622588533",
      "text": "毕竟是一年一度的生日嘛，我早就决定好\n一到零点就马上联系你了。",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_2_1_8_004_02:1_8_004_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:b2e0171f5695863364ff20cf8fe6650d6621c1d3baf6ec872e1b9a3a2ca53168",
      "text": "等工作结束了，再让我当面为你庆祝吧！\n那就晚安啦。",
      "status": "draft"
    }
  }
}
