{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_009kyj_2_1_8_009_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_009kyj_2_1_8_009_02:1_8_009_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:e1ea56915d47891a1229d00e075ba1220c9d4faef258bc3d05772c2e1e035784",
      "text": "辛苦了，●●●●プロデューサー。\n离集合……好像还有点时间。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_2_1_8_009_02:1_8_009_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:23f9ab68a9fa7c4fce0a5188a368a685fda0fe6f206ed4dc82a92c68a8228c37",
      "text": "太好了。在碰头会开始之前，\n我有些话想先跟你说。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_2_1_8_009_02:1_8_009_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:31dd2c7f01b4b902b2da2d21237e64eacbd361def34990d16f1df291a73c7574",
      "text": "生日快乐。\n……是今天没错吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_2_1_8_009_02:1_8_009_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:e017b8be514dcf1639cd37af1125da6459957ca9b1eda2cbbd62d158fd889172",
      "text": "是的，谢谢您一直记在心上。\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_2_1_8_009_02:1_8_009_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:70f7b9cc5906a8b3da2d0dc857b6c5e4b67e24ba8b37a01141be86009dddf0a4",
      "text": "不客气。\n希望你的新岁也能顺遂顺心。",
      "status": "draft"
    }
  }
}
