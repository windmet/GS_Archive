  "entries": {
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000011:title:001": {
      "source_hash": "sha256:1d8fead3d009fd8f9c71131b7e885ef017e1e9df8fb74bcf6a7da7f55cfde548",
      "text": "出席主题乐园活动的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:72b6cbf104d38586da973cc59e5e0ac0dcc3b493db4a252ddb93887bd1367cd1",
      "text": "今天的工作，是以儿童主题乐园的大使身份\n出席活动。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:67446a8e2ddd5cf801f29e7cb29a028aaaf72b29978d96c587cadda90e35ed0d",
      "text": "是那个可以体验各种职业的主题乐园吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:ff5acb51588d8553d9efd49d1d528d7c3649f547d04587ef392ed1b2ec352a5c",
      "text": "是的。志狼君实际上也需要体验几项呢。\n有想尝试的职业吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:c5a2bcc9afd9f9bcd0343759c993b1ae6aaf1a43639625fc080e185ce2a93339",
      "text": "果然还是想尽情活动身体的那种！\n老实待着的多无聊啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:d1a092df7c910c632e8cc99715834d47d194bdedc77b0ae7282146ec8338a5a1",
      "text": "还有，帅气的……呼啊啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8b9d42ff3c860f996fadd30588a32c8bb2a6923cd6e927372de6880ded0fd688",
      "text": "看起来很困呢……",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:e75f4db6a0f09ef42c7431c61c07b11b2d41444fc83f151d9fc80960689155c1",
      "text": "因为太期待活动了，\n昨天都没怎么睡着。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:a3ca6412e2f66db93f88538bfde6f36b23af6908807325cd28ffc58a50944573",
      "text": "离到达还有一段时间，\n你可以先睡一觉哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000045:dialogue:000": {
      "source_hash": "sha256:dbab320ddd0c407024e65a8c82258678445fb40a186fca2deb2a4e98484b94c0",
      "text": "嗯——那我就睡会儿……\n工作的时候总不能挂着一张犯困的脸嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:0e17c133f5d4666a524cd2a9eb4cd12ecefce583e72eb3a91e66ef47b397a4cf",
      "text": "那我睡啦——……\n……呼…………",
      "status": "draft"
    }
  }
}
