  "source_raw_hash": "sha256:9626da6f43ee1f0ab2a895e9153e54b79d814bb4382ae8956a5c0606fcaf8545",
  "entries": {
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000013:dialogue:000": {
      "source_hash": "sha256:de817e84bc8cf327037dd87afd9b51f1070a44fd831d929fe780d251edc18675",
      "text": "工作辛苦了，\n●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000015:dialogue:000": {
      "source_hash": "sha256:dc0667e167f3ce47343e4888de0096ba99a2a9297f3f13b6d50b5ff603092f10",
      "text": "辛苦了！",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000020:dialogue:000": {
      "source_hash": "sha256:f1c5f21334a4576f995e4282a0c18372917f8ab5f30ef4683dc22896cdb42ecc",
      "text": "偶像们刚才\n一直在找制作人哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000028:choice_short:000": {
      "source_hash": "sha256:8c8ab65d5bf59e73715eb445fdbfc0d1c4c92ce08eaee4d0df08cfe69e65ce88",
      "text": "是有什么事吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000029:choice_short:000": {
      "source_hash": "sha256:2eb5136c0d14b6d86eccbdd950ee0853801aa46f02396fd5736d234dd35b9edc",
      "text": "啊，今天是白色情人节呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000035:dialogue:000": {
      "source_hash": "sha256:08620a1fb4041f85126fe1fce0a6097bcce5f22ed3480092510fb14c1f92367c",
      "text": "今天是白色情人节哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:ad5f8b188417cc97561bb8ea45c7ee850739b9fa6e61109a83edbb87adb108e4",
      "text": "大家似乎都想送上对上个月的回礼呢。剩下的\n工作由我来处理，请快去见他们吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:ad5f8b188417cc97561bb8ea45c7ee850739b9fa6e61109a83edbb87adb108e4",
      "text": "大家似乎都想送上对上个月的回礼呢。剩下的\n工作由我来处理，请快去见他们吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000056:dialogue:000": {
      "source_hash": "sha256:3da51eaa617ea1eb4f80f504d8ed65fa1b2550fe399080e088ad5f9b808fefe2",
      "text": "原来是这样啊。\n那么我就恭敬不如从命，去见他们啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_000_23_5_02_000_23:5_02_000_23:cmd-000061:dialogue:000": {
      "source_hash": "sha256:a8cdb6122ec097037a168f47535cb009632479eff038eba59565fe8ba8425e5c",
      "text": "好的。希望今年对制作人来说，\n也是美好的一天！",
      "status": "draft"
    }
  }
}
