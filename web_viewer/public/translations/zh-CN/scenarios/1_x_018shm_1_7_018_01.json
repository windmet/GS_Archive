{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_018shm_1_7_018_01",
  "source_raw_hash": "sha256:98cd69554cc4cc3a6ad06f0f81973b3f29a45ca5e45b6b7e1cc6ffee4170580c",
  "entries": {
    "story-text:v1:1_x_018shm_1_7_018_01:1_7_018_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:9e989e84754f022b3f0234a452a38fd3674f9359b1282ec552108e56d4ad1d1c",
      "text": "翔真先生，辛苦了。\n还有，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_7_018_01:1_7_018_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b0c3da77d9c08b3c6ea3bff8ce31853dd433cf2a63b7f7057027934d1f1bcae7",
      "text": "哎呀，你还记得我的生日呀？\n谢谢你啦，●●●●プロデューサー酱♪",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_7_018_01:1_7_018_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:2125cc57d07aae3ef5dad3ba9cdaf17594cdcee78685c33b08126369840c1b80",
      "text": "能被别人庆祝生日，心里确实很舒坦呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_7_018_01:1_7_018_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ae659cddaf55342c835cc0bdf2842b43d54711b583edc24ef900c25e03afee1e",
      "text": "为了以后每年都能让你为我庆祝，\n我也得多加把劲才行呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_7_018_01:1_7_018_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:69eb4acddcb876f8b5d5bfade4011aa65e95e9d5e41a679f529e2c7556cff442",
      "text": "呵呵，长长久久地拜托你啦，\n●●●●プロデューサー酱♪",
      "status": "draft"
    }
  }
}
