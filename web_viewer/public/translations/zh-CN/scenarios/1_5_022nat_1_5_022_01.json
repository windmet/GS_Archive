  "scenario_id": "1_5_022nat_1_5_022_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000011:title:001": {
      "source_hash": "sha256:e9eb0f28284bc7c06fa8e4f7012b47d6a3f487109df53bb2295367bb5f7bf360",
      "text": "校园爱情喜剧电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:bda82182fc87655bc18c31f2d14b3a4dfa6ff2c2a278fd4399f89732ad001780",
      "text": "“怎么了？虽然表面装作若无其事，\n但整个人都散发着‘我很没精神’的气场哦”",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:16cd66f8b1b79c9b26051f9b8122ea59c064d298b82daa85f64fa0d7f4b03829",
      "text": "“难受的时候别勉强自己。\n只要你不介意，我随时都可以听你倾诉”",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:a37bb92a980f3ebb357a2bb43cb92a0046dbdd5be62b5bfbfb4f998496c8949a",
      "text": "“所以别客气，尽管依靠我吧。好吗？”",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000041:time_caption:000": {
      "source_hash": "sha256:822a371c3ef7bd6c616b1b5558f0a0d29fdee7efbc3e9f78dc730e75d2a64edb",
      "text": "拍摄间隙……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:1182af576ee75c0569c1e0485291983c3f12f1832058059d0e95de4a5ea1bf84",
      "text": "夏来先生，辛苦了。\n刚才的表演，非常出色！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:12e4640726ed4b35e611b35bce35737568af28d6342d8bf67f17d71c73ffda4a",
      "text": "导演也夸赞说这个冷酷的角色非常适合夏来先生，\n完成度极高呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:46ffa4a9404b125dc154e16f031c2f88e12bbab7bbc907f442c210a91f8246a0",
      "text": "……这样啊，太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000058:dialogue:000": {
      "source_hash": "sha256:3e95470759b1a6565daf2027c59bb89a9be2ce48aaaea9a3db1bfc3731e70a9e",
      "text": "角色塑造虽然很不容易……但High×Joker的\n大家，都陪我练习了……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000062:dialogue:000": {
      "source_hash": "sha256:5b391776e744355b749c4984858654dc3f2ecab490f0c5e6fb0a50fbc5c964d2",
      "text": "●●●●プロデューサー……\n也陪我练了，对吧……谢谢你……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000065:dialogue:000": {
      "source_hash": "sha256:1578dfd421fb6162a5083f8ca1b6dbe5e9a4a7ea154aab7b68e613dfe08bbdad",
      "text": "呵呵，不客气。\n接下来拍摄还会继续，一起加油吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_01:1_5_022_01:cmd-000071:dialogue:000": {
      "source_hash": "sha256:e5241c39c8fb3f7aa91350f4cb7c5c113afb876b249957be11344020a3f943b5",
      "text": "嗯……啊，工作人员在叫我了。\n那，我过去了……",
      "status": "draft"
    }
  }
}
