{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "025suz_402_2_4_025_02_09_b",
  "source_raw_hash": "sha256:82d68e4bcda7ab0af1bf306f3104c8ffcf2b9755c9ee328a17ebfedc4e3084f9",
  "entries": {
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:5832bbf94443eade4a2f30bf184f7bafa35b6a7cc585fa1bd0ee8d1f9c6bf65a",
      "text": "●●●●プロデューサー！\n事发突然不好意思，想拜托你个事！",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:48796cfead198c2634ba0c92fa73c844e20bf1a754dd0d29beb3ceb50290f88a",
      "text": "听说海滩某处有家能租泳圈的店，\n你知道在哪儿吗？",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:3ae563d401510c89e64ef36e736fa333ed63c370ef668eb12d0e60ea4630db61",
      "text": "出什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:32630e121e8710c62d39224242663a44970676b39e1a99f0ccea33a9f83684dc",
      "text": "在拍摄开始前，我本来在海边玩来着。\n结果有个小孩子泳圈破了，正哭呢。",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:531ab680b8cce0208d39f06825f9c52a7477324e23fd3bb3469446e51a22458c",
      "text": "听说在那家店里，\n好像能租到新的！",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:25b2e892bce8db53f8043a8ed0692e57091e9b491093dc73658a2d9689c978a9",
      "text": "孩子没事所以你放心！\n因为是在下海之前发生的，赶上了真是太好了！",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:747c857a8a60bf11d6a68722e65dd75952fada29a827b15d5bf475e0875bdc2f",
      "text": "我这就带您\n去那家店！",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000021:choice_short:000": {
      "source_hash": "sha256:b06cf1ca1b9810a6089c298286631aa1c61e0b98bf138de9833503f465aaea62",
      "text": "我带新的泳圈\n过去！",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:a52677bcdca7f5508923a21693862ec2baef7462b6e8caa35395f63763bfa928",
      "text": "帮大忙了！……喂。马上就会把新泳圈\n拿过来了，已经不用哭啦！",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:b99df2df1c2ddb6a96d8990b4b05f83ca094537f1426d0d180e8ecbd95cab012",
      "text": "哪里比较适合碰头呢……哦！\n那棵树形状挺少见的，不正好嘛。",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000028:phone_message:000": {
      "source_hash": "sha256:3b10434854688ef140746fe92d15ab9865ca9f1049fe23fb1e61f50a32a55322",
      "text": "制作人！沙滩正中间附近，\n能看到一棵长得像猫脑袋的树吧。",
      "status": "draft"
    },
    "story-text:v1:025suz_402_2_4_025_02_09_b:2_4_025_02_09_b:cmd-000030:phone_message:000": {
      "source_hash": "sha256:f8c5aeeec75782e7f5a29e69fd5f78ab6ccd1e0ea299d3242df7e550302c6b3c",
      "text": "就在那棵树下碰头吧。\n我们现在也赶过去！",
      "status": "draft"
    }
  }
}
