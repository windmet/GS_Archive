{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30016_01_h",
  "source_raw_hash": "sha256:112cc1b404de830899f7e78e3facc3154e6ce9f1195db2f5d04c26e8781019ef",
  "entries": {
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000019:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000030:dialogue:000": {
      "source_hash": "sha256:70a5178f30db7d9bb50d2380f90df5087b48dc3fdbddfd8a1d8e180e10ffbadf",
      "text": "对、对不起！突然问你这种事。\n那个，要是不想说的话不说也没关系！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000047:dialogue:000": {
      "source_hash": "sha256:940ba2e9a46b7d923034f0823ba8cc085e9a89189724678d9d2e608c4c5bd91a",
      "text": "……只是因为平时几乎没怎么听你提起过，\n而且你又说拍照很难，我就有点在意了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000050:dialogue:000": {
      "source_hash": "sha256:b86914d7ae57a8d3983d08358bcb8f2ae172ba1865f29392a943b88c4c5be387",
      "text": "以前住的地方那么远，肯定没办法轻易回去吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000054:dialogue:000": {
      "source_hash": "sha256:b4916a8ba76b1167a083f502af444ad570d3c8611c436540825c823570008217",
      "text": "而且现在照顾你的人在海外，\n这你之前也说过吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000060:dialogue:000": {
      "source_hash": "sha256:e44a5934f01a616baa1fd2994a8f487e30af05d24861de9e1edcfbe5afb46227",
      "text": "所以拍什么家庭回忆的照片，可能根本做不到。\n但是，就算不是家人的照片……",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000068:dialogue:000": {
      "source_hash": "sha256:f9e4420ee04c1eae3db46b09170e9c3a3c7c55acb7c28b6064d4f324cafd45cf",
      "text": "不是，虽然家人也很重要，\n虽然我表达不太好，但哪怕从现在开始……",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000075:dialogue:000": {
      "source_hash": "sha256:094a554183a8f87874aeac89d493e8373992d51092c6b5c3f8458aeb1ef97729",
      "text": "和我一起，去拍超多快乐的回忆吧！！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000085:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000093:dialogue:000": {
      "source_hash": "sha256:1889616b96148f09e7998def1ec60b8be19c0d92c2e1944bf51b4318568d2b96",
      "text": "……玄、玄武？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000108:dialogue:000": {
      "source_hash": "sha256:71d44981b77c6f9f7f24fe96c0d29178f3ebf32d5fa6dd1d2bbdb2b9efadd07c",
      "text": "哇啊！干嘛突然拍照啊！？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000112:dialogue:000": {
      "source_hash": "sha256:6d83e7d860bd5fe99ac09fe3f297225035e05832f0f6f92f4507330ca1368923",
      "text": "因为除了我们以外没别人在啊。\n我觉得是个好机会。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000117:dialogue:000": {
      "source_hash": "sha256:d1f36b7d5c6fe550cdc33f0492bb8f1726a2a554909a56ceb692c494a12642be",
      "text": "哎？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000122:dialogue:000": {
      "source_hash": "sha256:2567662d689b29a7ce7685038072048525fddc94290c9758ed1ff5e0fcbfab09",
      "text": "朱雀，来看看这个。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_h:cmd-000135:dialogue:000": {
      "source_hash": "sha256:4dac2c69e91300fced769e9e33bd498f02128a4f90132025a5cee7b1f997eb2b",
      "text": "你拍的照片？\n这是……",
      "status": "draft"
    }
  }
}
