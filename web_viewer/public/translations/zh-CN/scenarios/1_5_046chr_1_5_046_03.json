  "entries": {
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000010:title:001": {
      "source_hash": "sha256:9e13ccec737e5423b1ef2ef55b95995297dd3a792356ada68d3d44d421dd3d07",
      "text": "时尚品牌走秀的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000013:dialogue:000": {
      "source_hash": "sha256:45d9a476a52356baaef1cec18ad27418c379ba496fe17f7a60fd5984d53e7e9c",
      "text": "（那个，克里斯先生……找到了！明明还有\n很多其他模特在，但他却格外显眼呢）",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000018:dialogue:000": {
      "source_hash": "sha256:e6e4db65d21600f7a7156e49448a4e2acbbefbc2e43a8d13ffffb411d105393d",
      "text": "哎呀？●●●●プロデューサー，\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:6f70a1ce775d61149cb837f6d4f3630f96bbfc9f6843a45de2a410a17b239650",
      "text": "辛苦了。\n克里斯先生，刚才的彩排表现得很好哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:d87c22ec4103b4df4b60ab8e70056eeaaac7a5675e991b995855fcb567506e43",
      "text": "堂堂正正走在T台上的英姿非常棒，\n工作人员们都看克里斯先生看得入迷了。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:a664dcea38ad776acd0357dc143df02830e8792d7bb391343c427ab11e9be673",
      "text": "是、是这样吗……",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:6255bebfbcdde863019be61c9f3f8265a4bce671ac6d369b92f08d123275bcb7",
      "text": "虽然有些不好意思，\n但听您这么说我也安心了。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:829f7b98ef04a983eac6cc230c6973d64d7df7d04bf79aa30a43916972b1b7a9",
      "text": "明天终于要正式登台了呢。\n我想把训练的成果全部发挥出来。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:ab20a6bc2ea35e32cc89c099b9179ffc13cf42f81ecb16c995d444b7007630dd",
      "text": "是的，克里斯先生的话绝对没问题！\n请加油哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000045:dialogue:000": {
      "source_hash": "sha256:56b9a6e2681cae0c32060ff6df97b76ac4c08f64c9ab7b0a64ce1e1f70069c0f",
      "text": "绝对没问题……呵呵，说得也是呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_03:1_5_046_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:05d7826e20fadf92b977e7d2d3aad5cfd6f5549843cc0238b064e69e06929466",
      "text": "怀揣着●●●●プロデューサー\n强有力的话语，我会去好好挑战的。",
      "status": "draft"
    }
  }
}
