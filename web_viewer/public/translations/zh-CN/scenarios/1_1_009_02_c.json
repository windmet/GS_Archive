{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_02_c",
  "source_raw_hash": "sha256:9499408360e90444446ed2c2c80f162c2cb655e1f049636a4875838b0489639c",
  "entries": {
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000021:dialogue:000": {
      "source_hash": "sha256:42d026b7160921c49f896795074b3917071974b0d3e04953428958f35d3df802",
      "text": "不对，老是我一个人定太不公平了，\n接下来去玄武想去的地方吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000026:dialogue:000": {
      "source_hash": "sha256:fab811cab6585337ab9950e647d24549928e9dfa76a142d90cddc565e4b6cbe3",
      "text": "你喜欢博物馆对吧？\n去那里怎么样！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:f5ef66b54180ebdd67bef7c240c1b4c67a56634371afdcf85d6d49aac2d205ef",
      "text": "……不了。等有朱雀可能喜欢的展览时，\n我再约你吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000035:dialogue:000": {
      "source_hash": "sha256:8acefce69f5c71bd3765f8bccf2859d20a2caf089d6a879f9004d28eb267870a",
      "text": "现在的展览，好像是禁止携带动物的。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000037:dialogue:000": {
      "source_hash": "sha256:8913e8d3fa04af118aabb8f6433e6d2425620c936d9c709ec9182db459acee05",
      "text": "喵～？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000042:dialogue:000": {
      "source_hash": "sha256:86786df33dd77ee32627fa0e591dbb5f9ee037ed3be52d809ef82ade10d65ed2",
      "text": "……嘿嘿，原来是在为喵子考虑啊。\n谢啦，玄武！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000047:dialogue:000": {
      "source_hash": "sha256:db27e340c1ac34d331f784ca22a0ab186143e175b1dbdf450269c71f43f12580",
      "text": "是相棒的重要朋友，理所当然的吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000051:dialogue:000": {
      "source_hash": "sha256:6f0f299d0926879c2c9b3fe0402f2e450f58ee2cc6a2910a6a058af5b099bbaa",
      "text": "喵～",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000055:dialogue:000": {
      "source_hash": "sha256:4a0aa9241d8a20a0eb3293d7e6b8acd388b4388461e76655f6481fe98e3ff56b",
      "text": "哈哈！\n喵子也说谢谢你呢！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_c:cmd-000059:dialogue:000": {
      "source_hash": "sha256:75cfa1821d0b0d18b3514bc3e02770f1eb813f4748d1fc60f2065e1d9ea9883d",
      "text": "那待会儿就去看衣服吧。\n像平时一样帮我挑挑衣服吧！",
      "status": "draft"
    }
  }
}
