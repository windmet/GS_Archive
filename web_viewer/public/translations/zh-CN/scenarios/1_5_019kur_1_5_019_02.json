  "scenario_id": "1_5_019kur_1_5_019_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000010:title:001": {
      "source_hash": "sha256:82aa544b2eb2db7a494cd64fbe106b0311d45f412e9e107a3a20d9835404856d",
      "text": "资讯综艺节目出外景的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:8a43988a90448ef4a581e2d0bcb7959f9518de26d2c02c42b5da3a46dd910d11",
      "text": "今天的工作，是资讯综艺节目的\n收录。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:77fcd4daeb4d6402678bed724622ad2f47f82002118e31b19acab269e787f32b",
      "text": "九郎先生需要前往外景地，为大家介绍日本的美景与\n温泉。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:c4253a692f9e8c335fe760215df616e0fee45fd4c9fca239bee48d3649f6d9d9",
      "text": "我明白了。今天所要介绍的地点，\n是一处鲜为人知的绝景名胜。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3c9cc25bb26aa83f9d551adf1dba42134a60475d5c28ebbac13d509e066c64ab",
      "text": "夕阳沉入湖中的景象唯有壮观二字可以形容，\n美得令人移不开视线……",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:ff90745ef836ed0b6d8f4f7555efc8d93c15005301470558120eab553672600e",
      "text": "至于温泉，泉源不仅具有诸多功效，\n且地处自然环境优美之所。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:cd9b5c3c9d9498614e224cb1ded2ab74a32cef75701b60e2cdb97f10bf0d69e5",
      "text": "真可谓是疗养调理的绝佳温泉呢。\n……方才的解说，感觉如何？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:96fa8f54f4ad5fb4801277e257214a5178050ee93c22f231a3772475096f7740",
      "text": "非常通俗易懂，棒极了！\n是让人听了就想亲自去看看的介绍呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:84721b179ded058df76dd9c4397ffff4af073003e949685d2c790b792d1e7da6",
      "text": "呵呵，太好了。正式拍摄时，\n我也想融入自己在现场的真实感受来进行传达。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:97154548ce6fec391083fad5fb866ead3297afd954bbd378321ded0c4a302e8e",
      "text": "好的，我会为您加油的！",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000051:dialogue:000": {
      "source_hash": "sha256:9c8048b1f5634e5bc5eead34d8cad104739ac776c5a784ec31e92566df4cc8be",
      "text": "……看来已经到达外景地了。\n那么，我便出发了。",
      "status": "draft"
    }
  }
}
