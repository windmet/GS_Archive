{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_044_23_5_02_044_23",
  "source_raw_hash": "sha256:3c732d552a2df0688836437129ff1e4cec4f4935333f48da8bb5f8b3a83b6e63",
  "entries": {
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:2afcf414d28622bc04844cd4d71adf204ae572285c77050071c0aa2acbf27287",
      "text": "辛苦了。送给平日里总是很努力的你，\n我有样东西想交给你。就是这个。收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:1d3cebec7cb1ee504c583097fe445dbd1006a6c60ba74c47358e8e4d959365c6",
      "text": "非常感谢，雨彦先生。\n这是琥珀糖吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:4454ebc375802649f6c484d955cf67cda8a56196a977bf670b315a220005899f",
      "text": "啊啊。兼作情人节的回礼，以及平日承蒙照顾的感谢。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:7a2a6e34edfd94eb90ed1f5e747b329be175a7901117d47e4407035836e0f971",
      "text": "而且白色情人节送点心似乎也是惯例嘛。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2552845a28523a97ac2bd4d85dad6963b2bf402d04ff5bc8b36b21eb04ab7c28",
      "text": "那样的话，选个光是看着就能赏心悦目的东西应该正好吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000035:dialogue:000": {
      "source_hash": "sha256:82389860a254a7369726a97d19cb9c03e8632fe488dea98b1c9d7d754b24766f",
      "text": "味道方面，也是挑了你大概会喜欢的口味哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:d5ced7bbd5208aef5ef753d80e6b6e649d7d8b33f818f79c6356a8a5459f66ff",
      "text": "感到疲惫的时候，就尝尝看吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:45c5bc7680668f7c708fa217f6eefae6d00fb9cd024ff8ee8e82109a1e6cd288",
      "text": "光是看着感觉就充满活力了！\n我会好好珍视品尝的。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:1f077d1a48ea0afd3b81c5e590a62decd7660c219f02cd97e7e273febcf6c11e",
      "text": "能成为你的活力源泉就再好不过啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_044_23_5_02_044_23:5_02_044_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:00c3789fb9b0e578ede77804317560d0a9f83e105a93e32feebed35e0185f864",
      "text": "珍惜固然是件好事，可别在光顾着端详的时候错过了赏味期哦。",
      "status": "draft"
    }
  }
}
