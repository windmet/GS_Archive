{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "034kan_305_2_3_034_05_09_a",
  "source_raw_hash": "sha256:206829e639c91ab7a15f589d6f5bad0496e1c4ae9bd2b121c42d3556e787a52f",
  "entries": {
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:30cf3e1de136e26de902b6573f10364f5173fb222576411f3f7cdafe43f86e2a",
      "text": "●●●●プロデューサー，\n那个，快听我说！",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:6c89d79c69be4a7f51e105a3505352f7ddb9a91838c7679b60a4ee12f3f7ca7e",
      "text": "前阵子在电视上跳的舞，\n大家好像都在模仿呢！",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:eeebf602a2e4c4af569580b516d33fa142ae5032e255eb08cbbd9b9f35817048",
      "text": "妹妹告诉我，\n她的小伙伴也都在跳哦♪",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:03d3b2ace8adbca43435a9212eb0db30c4ea8f6e7ba1db60dc30bd6c9e49b114",
      "text": "花音们拼命练习了，所以……",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:89f240dab2bf5c8d8c32b3a8c851ff2ed95ee6eb5286f0e04ac3404f016b1eff",
      "text": "真的超级开心！\n努力了真好♪",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:11c2d5fa28f06cd91d5e212d97b6b0a8588d1f8af5c89ff5251225dbdeee2e74",
      "text": "太好了呢！",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:d9797c8372c10d40c19198835912ecc2c6cc7c0934d29d668f74deb9697ecee9",
      "text": "真令人开心呢！",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:0d24f9a722cc8cfdf3c4b5a63887b254487459a9253412fed00e6a5c9d2e6443",
      "text": "嗯♪",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:f8328886d05bdf18d491b4568c6704f83ba235e02c127ddc5339c93ff628e02e",
      "text": "救援战队的工作超级开心，\n而且……",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:74f1123c06c47a77a762267f897cbc81eadc0830af4c0a6c6223160f4e6fa980",
      "text": "能三个人一起唱歌跳舞，\n真的太高兴了！",
      "status": "draft"
    },
    "story-text:v1:034kan_305_2_3_034_05_09_a:2_3_034_05_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:f38497e73e5244956dc23e7716af4c37c009d2110fd16861890aab50ad411517",
      "text": "所以●●●●プロデューサー！\n下一次的工作，我也很期待哦♪",
      "status": "draft"
    }
  }
}
