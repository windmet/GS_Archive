{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_012_02_d",
  "source_raw_hash": "sha256:9a4e58a243ac4c84fb59727008682f423a71b14965d920ef9daa9c9da2279255",
  "entries": {
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000021:dialogue:000": {
      "source_hash": "sha256:59b4629220f33a4e5893c373cb165015a58dc2608e141ce3fac424135e6be6e8",
      "text": "连我自己都觉得，目前在做的事\n相当乱来呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000026:dialogue:000": {
      "source_hash": "sha256:a06e9a0ff2236f7a4382f4dc6000ca11c7b0e89f6d9e871ac44d230f86e30b40",
      "text": "像这样每天跑试镜，\n就已经累得精疲力尽了。哈哈……",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000033:dialogue:000": {
      "source_hash": "sha256:f5574c0ea1c9fa75ab1015355bd4558949892a673eb2218bb66cefd990676c23",
      "text": "山下君……",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000043:dialogue:000": {
      "source_hash": "sha256:c9a00c3c71953452310f2356af3d041b53e97d0038962e80f5d16c677c59f200",
      "text": "只是……那个啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000052:dialogue:000": {
      "source_hash": "sha256:5ce7108742c622753df4c2abccf71df92c4ac2fb53b2566a10d84f2fac3802f9",
      "text": "我们是打算认认真真去做的。\n我、类，当然还有硲先生都是。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000054:dialogue:000": {
      "source_hash": "sha256:eda7effe5c660a85bb587a449422a36ae7cc767152bf35f5e98dc84177acec74",
      "text": "特别是硲先生说的那份热情，\n给浑浑噩噩过日子的我也树立了目标。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000057:dialogue:000": {
      "source_hash": "sha256:44bf3e08555810f1130e2465f5f7ec7600f66795cee3838ae849173c6a372a26",
      "text": "这个人的话，绝不仅仅是浮于表面。\n我认为是蕴含着改变某种事物的力量的。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000061:dialogue:000": {
      "source_hash": "sha256:8d52141166f90a537fdfad2b3feeb1347249d9d40e32d1c9493fe2637c845a26",
      "text": "单论心情的话，我们可不会输给年轻人哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000082:dialogue:000": {
      "source_hash": "sha256:916f5bd6766c63c35f4d457a60ff77c9c525a4927e38eb966dca425877f3a442",
      "text": "Mr. 山下……very cool！\n就是说啊！我们可不会输给任何人！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000092:dialogue:000": {
      "source_hash": "sha256:91ee29e53541fc5b68ef3d10776fa9de19958dd1e7dd83cefb4a28cdbae7128e",
      "text": "嘛，太大的话我也说不出口就是了。\n大致就是这样，请多关照啦！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_d:cmd-000094:dialogue:000": {
      "source_hash": "sha256:d8efe76df738efc386ac661e9b214e0ef32baade029f59230235f936920951d2",
      "text": "原来如此……非常感谢。\n结果我们稍后会再行联络。",
      "status": "draft"
    }
  }
}
