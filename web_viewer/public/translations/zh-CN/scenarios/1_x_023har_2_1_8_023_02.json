{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_023har_2_1_8_023_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:27a53f49e641f557d3091f050c5ecf1cdde0127ba8e445a0cb22bd98bb7a2e9e",
      "text": "喂喂？●●●●プロデューサー？\n太好了，你还醒着啊！",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:5c4b636e692782454e5589577d8217df698c269c2d6b9028ca2ded530b3db05a",
      "text": "生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:2e39584723bd07ef6f61722ab1956a38b59d4a17c3dfda58710e738065c3c414",
      "text": "去年因为打工太晚\n没能做到嘛。",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:618cfe80f65c96e9612ecd123ce0229dd47415f03d4c3c5e2687d9c911dc2c84",
      "text": "所以今年我一直在等，想着零点一到\n一定要打电话给你送上祝福。",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000018:choice_short:000": {
      "source_hash": "sha256:39910fa1def712f282417e56fa8341aa72d88f2e2e44038d96915373c95d676c",
      "text": "非常感谢，\n春名先生",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000021:phone_message:000": {
      "source_hash": "sha256:0bc130c31805a67cb1a7bcd6ab4a0ec1e6bafdb82f10a32994dcf1e05cf39410",
      "text": "我才要谢谢你，一直以来都这么\n照顾我们呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_2_1_8_023_02:1_8_023_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:dff677e6006bc860df47b665d9849181158039007127761dc25bd3a67d3b6cff",
      "text": "为了回应●●●●プロデューサー的心意，\n我今后也会吃着甜甜圈继续加油的！",
      "status": "draft"
    }
  }
}
