{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "015ryu_401_2_4_015_01_09_b",
  "source_raw_hash": "sha256:b791e2abfeda8fd53e7c99d328acb2829a0f3023a73874643c3e44bf2b48c571",
  "entries": {
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:186dc61463f8b63aafa96b109692aa3d6aebc1bfe12a4974420855a5d624ad6b",
      "text": "喂喂！头发和脸上的颜料好好洗干净\n了哦。已经换好衣服……哇哇！？",
      "status": "draft"
    },
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:e7cf792a1dea12c9a840c907c7996e355a6541cd559ec32ab876e912808763d3",
      "text": "……哎呀，抱歉抱歉。\n突然吓到你了吧，制作人。",
      "status": "draft"
    },
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:3a3735823c6723085637b040bd6d906e8099f8917054446ab3937c268667197a",
      "text": "差点摔倒，不过总算稳住了。\n嗯……戏服好像哪里都没弄脏。",
      "status": "draft"
    },
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:06d2d1443656f471a12e85792bf2cd2300fb68e8fb99502b9509d01fd9c13ed9",
      "text": "龙先生也没事，\n太好了！",
      "status": "draft"
    },
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:c35ffd110d156dfbef849e2cadabf253b2307e0b27a80d9ecb12ca401a340720",
      "text": "龙先生和服装都\n平安无事我就放心了",
      "status": "draft"
    },
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:a70c5a4ac7e7647cc53e35a41b93a012d9a249d66e6a8e29a59f759da4ae345b",
      "text": "谢谢你担心我。\n我没事！",
      "status": "draft"
    },
    "story-text:v1:015ryu_401_2_4_015_01_09_b:2_4_015_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:d56dba0b331ec8b182ff6b80fb7b509071c14bbcbf58139eff97abd554f5324e",
      "text": "啊，我差不多该回休息室准备待命了。\n制作人，待会儿见！",
      "status": "draft"
    }
  }
}
