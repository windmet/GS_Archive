  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000010:title:001": {
      "source_hash": "sha256:69829042099d74b904675029dda05d806a11673db424e82b2496aa47299da9c9",
      "text": "流浪汉小说舞台剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:faace0525c1c401c2688d1d545cce5480bc0b7153ea442671e4cff9f59b9e354",
      "text": "●●●●プロデューサー，辛苦了。\n原来您在这儿啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:1cdb74059df558bafd7fff04a146a5e44ed9c98279d712291cea267bb1653675",
      "text": "是的。因为明天是首演，\n我想着再来看一眼舞台。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:dea0e8a56f793cfcf5bfa7123d07d5066e0176bf4af2fb9c50607a76c7f1b9af",
      "text": "呵呵，真巧呢。\n我也是出于同样的理由才过来的。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:33b9b5f2c129fcdd7871a8d88d8ec856b90ed9d7337e0f3a416411f274381c6e",
      "text": "这一出剧目是以16世纪的西班牙为背景，\n改编自一部流浪汉小说。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:941753e831bd2a5426e4c5b680879d5fcd138bb72f4c7a3894f05dbc16d04e6a",
      "text": "就是那种将主角描写成恶棍的故事呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000043:dialogue:000": {
      "source_hash": "sha256:21a566cec3236c3578f282a73d1d0fd13ee6325473afe4ffdc3d16ad07d460d9",
      "text": "确定出演后我读了原著，\n仅仅读了开头，就被深深吸引进去了。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:1ba5ea3e30338a4ec49a9f339ea89eb54c3931b63007f8bb62d6a0df84763b80",
      "text": "是一部耐人寻味、极具魅力的作品。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:d6dc9779a2053924525a8d782fb5d07665109d6809f5cc89adf30e35f98c877a",
      "text": "而且我饰演的是故事的关键人物。\n正因为角色难度大，才更有演绎的价值。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000055:dialogue:000": {
      "source_hash": "sha256:09bc22170917982251d228c93391b7703755a19fab67f00241bd0d31861e66e4",
      "text": "为了能让庄一郎先生顺利演到最终场，\n我也全力协助您！",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_03:1_5_028_03:cmd-000062:dialogue:000": {
      "source_hash": "sha256:2ce0de464879ebd6badc4b544380326e85c5173056dc829569897076428201d7",
      "text": "呵呵，谢谢你。\n●●●●プロデューサー真是靠得住呢。",
      "status": "draft"
    }
  }
}
