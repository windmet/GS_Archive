  "entries": {
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000011:title:001": {
      "source_hash": "sha256:99abbb8f396dcd7c1de7b32b892b60ab5887798f948c8b247499943cce6c05d4",
      "text": "纯文学小说电视广告旁白的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000019:dialogue:000": {
      "source_hash": "sha256:0037e6f443df15a9d4ba2d06d21daaddf532d771a09155d902bf29001425f6d9",
      "text": "（旬先生正在专心致志地看书。\n似乎还没注意到我进到了事务所里呢）",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:47c39c7707f08b7dff30f00f292ef105e9fa49a850a5f87d9347f55b1e0dd465",
      "text": "呼……咦，●●●●プロデューサー？\n您什么时候来的？",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000028:dialogue:000": {
      "source_hash": "sha256:7a08a3ebe71268a3f801a078093f8b6f0330ed51f755b4bd8400d816a781940b",
      "text": "刚来一会儿。看您那么专注，\n觉得还是不要打扰比较好。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:5d50fdd5b8d78f06fd8af9d784a574bd61bd090c3f2fc2f5f106c911dc049772",
      "text": "原来是这样。\n不好意思，让您费心了。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:163678045dfdc67f6d4a2c1db4ff9d1daa4cda681908e922005a4493db9531ee",
      "text": "没关系的。\n话说回来，您在看什么书呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:36928a9052035d7eaae8f68926e5cbbd62746f063476ed40e870fdf197ae37a3",
      "text": "我在读那本要负责广告旁白的\n纯文学小说。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:f2105a39b607799ab052cf40ee106de6baa76f08e1234b422ef2646aca7a48c3",
      "text": "虽说一开始是被简介吸引了，\n但这确实是一部发人深省、内涵深厚的作品。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:226eeb6f2ce3c7c2f14297111d3f7b8569ebccd71889f6422f47405927ccadd3",
      "text": "我也拜读过了，\n确实是一部非常棒的作品呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_04:1_5_021_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:4b4581aa535e306278055ad10962242c1b09edf434a17c0501ce44197aa6c515",
      "text": "是啊。我会努力把读完时的感动融入声音，\n传达给所有聆听的人。",
      "status": "draft"
    }
  }
}
