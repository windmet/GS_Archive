{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_02_g",
  "source_raw_hash": "sha256:9195939249b631e44050e1ad391c945b80e5a9a6c517d92fdb384cb11a2cfdfe",
  "entries": {
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000015:dialogue:000": {
      "source_hash": "sha256:ce5b872d02d8fbfc2f036033f07a3174346e57bfca949f19cac5de065fc74c1c",
      "text": "（果然没错。\n是苍井兄弟里的哥哥，苍井悠介先生！）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000020:dialogue:000": {
      "source_hash": "sha256:b883d31a9b39da61261b736f28ac7a8a943992197d50cfc4120a24b12c545c65",
      "text": "（听说他因为受伤正在住院，\n原来就是在这家医院吗）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ece0f3e943ec31e73b428d9ca836a5b1c36742d91191b79dde6c9a5cd3e8bc33",
      "text": "好嘞，待会儿享介来了，\n大家一起踢足球吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000033:dialogue:000": {
      "source_hash": "sha256:46d84d2ca206aed809a0cb86f16110af32e18e07107b93d51af99ecea84fd3aa",
      "text": "就算第一次踢也没关系。\n我会教你诀窍的！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ae656aa468a4d9a0a42627d1fc99fbb94f0fd973f5110653a6976c2dbf8993b1",
      "text": "（好厉害，比在电视和杂志上看到的还要耀眼）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000041:dialogue:000": {
      "source_hash": "sha256:4bec23e0abbb0a5e3317a8973bd9b5a9dc21b9013785620f79ab5782d950abf4",
      "text": "（很久以前就觉得他是一位非常有魅力的人，\n果然，好想邀请他来当偶像！）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000045:dialogue:000": {
      "source_hash": "sha256:be879ada85ca461eb84878c2d6a2888734963bbb8b5c5c36a81bca0212c26db8",
      "text": "那我差不多该去准备康复训练了。\n待会儿见啦。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000054:dialogue:000": {
      "source_hash": "sha256:6c0587106ea9288868d7ce5af296b5343e4a84c327ba910b8ec4915dcbc0ef35",
      "text": "（……好，至少先把名片\n交给他吧！）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000061:dialogue:000": {
      "source_hash": "sha256:037f11eda0cac90b6ef7a765ae5539f70103bcc9fbfed5a6cc42c44e2eb32467",
      "text": "那个，不好意思打扰一下。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000066:dialogue:000": {
      "source_hash": "sha256:8e709e021d7237a319fac6b64252e79120d39b016f2b1d14b6e744f09572fb3f",
      "text": "怎么了？嗯，在叫我吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_g:cmd-000068:dialogue:000": {
      "source_hash": "sha256:8f7abecd9c7654dc362c680e40650387b1e37684bf6462487d1491c9b84ef802",
      "text": "是的。您是苍井悠介先生对吧？",
      "status": "draft"
    }
  }
}
