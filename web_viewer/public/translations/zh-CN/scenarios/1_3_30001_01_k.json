{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30001_01_k",
  "source_raw_hash": "sha256:e398adf12581c9f63fddc6e6f679290fad998927871bdc2b7c153d679ebb7172",
  "entries": {
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000022:dialogue:000": {
      "source_hash": "sha256:003ec6157f76869dea2f150ad108bbbdc9e8093cf2005e4a8a7b03a7cbc69362",
      "text": "我想把和AR并肩拍的照片发给那家伙。\n能麻烦你帮我拍一张吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000024:dialogue:000": {
      "source_hash": "sha256:bcabd38bc8bbbd428f3d984c35e80772617cbb4fde85254fbe95e164bc1ab0fc",
      "text": "是给新郎先生的呢。那么，\n请站在那边……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000033:dialogue:000": {
      "source_hash": "sha256:aabfab7b9dbe11b7f17044d95f1cb35af5b5ba4003917125ecbab02dc0c2e09a",
      "text": "好，拍好了！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000049:dialogue:000": {
      "source_hash": "sha256:ff402735b76f881ae323df749ce62217dc264cb2470ede10cee4e34adb6dc9d5",
      "text": "我也想一起拍！\n啊……对了，三个人一起拍吧！恭二也来！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000060:dialogue:000": {
      "source_hash": "sha256:878bdb4ba3744e8d85d2c70e71cc6b18e13fa8282e76a042c2eaa72755d6e11e",
      "text": "那么我要拍了哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000071:dialogue:000": {
      "source_hash": "sha256:970d085733eb5b001a6315745865ab27679325b69ca6db11ab312c878754080b",
      "text": "……好，拍好了！\n三个人，不对，六个人都拍得非常完美哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000076:dialogue:000": {
      "source_hash": "sha256:38a94f8254db13f48293eb467220ef725d564d9002ba8fcf7cb42fe4b2b9f95f",
      "text": "和自己合影这种事……\n感觉有点不可思议啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000082:dialogue:000": {
      "source_hash": "sha256:ee972b3c0b0d0ad1105eea73a63775a44b1c196406c90e74252bd53f2cdf3252",
      "text": "呵呵，好有趣！\n有两个实，两个恭二，还有两个我！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000089:dialogue:000": {
      "source_hash": "sha256:dff26664c52112fece9ee848c4da945a744238f33ec0748a76ea5e55aef889d5",
      "text": "对了！\n●●●●プロデューサー，也一起来拍吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000094:dialogue:000": {
      "source_hash": "sha256:571653289778d4d4c68f6496f1e4f8399abadbe87e32d9303de36c03b453440f",
      "text": "这主意不错。\n贤君，能麻烦你帮我们按一下快门吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000114:dialogue:000": {
      "source_hash": "sha256:fbefc3861850ecc6c15c4c114844b7947687a0222a0a6a44bffe6ad809da040d",
      "text": "拍好了吗？给我看看给我看看！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000116:dialogue:000": {
      "source_hash": "sha256:f334753835ec73ccdbe0ed6eabed9465e04cd84b233f4dc9a9de631bc9a61119",
      "text": "果然还是有点害羞啊……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_k:cmd-000119:dialogue:000": {
      "source_hash": "sha256:e25867689ce08d74842a30fbc6157121b9f6b78e60b798eb98c89474bc6cf4a7",
      "text": "呵呵。不过，拍得非常漂亮哦！",
      "status": "draft"
    }
  }
}
