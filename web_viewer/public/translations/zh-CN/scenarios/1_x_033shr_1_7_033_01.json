{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_033shr_1_7_033_01",
  "source_raw_hash": "sha256:92c9c40a4bb9fa16172349700a976c38bbe859bd556213783b2120fac5fea5fd",
  "entries": {
    "story-text:v1:1_x_033shr_1_7_033_01:1_7_033_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:d388187bf38eaf01b7e12f38798e42aa6da01aa9fe63e16ca4a6013d2d6964b2",
      "text": "呐呐，●●●●プロデューサー！\n你知道今天4月22日是什么日子吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_7_033_01:1_7_033_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:acfc643fc8a747d74d19276161b95258b931493d90b331c95e94b7e08c5815df",
      "text": "当然知道了！志狼君，\n祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_7_033_01:1_7_033_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:aa56d8d2c740c4a492b33ef0706b53d92373456165ee135cdf38c74b494a6d91",
      "text": "嘛，既然是本大爷的●●●●プロデューサー，\n记住生日也是理所当然的啦♪",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_7_033_01:1_7_033_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:e65e49b57b40ea92c5129d214caec106f45cd1f07fb48e2df1e46322fa07bc57",
      "text": "今天会盛大地替我庆祝吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_7_033_01:1_7_033_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:87602a4bc99d12eebb15da9d5f0e25c08a051b5420083efc61837787cc561abe",
      "text": "我要大口大口吃下大蛋糕填饱肚子，\n还要收好多～好多礼物♪",
      "status": "draft"
    }
  }
}
