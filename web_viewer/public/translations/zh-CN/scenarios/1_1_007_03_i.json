{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_03_i",
  "source_raw_hash": "sha256:7d735317fc074598b4036684fdd9a2a0484908f4e2028dee4d886916839bb30c",
  "entries": {
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000026:dialogue:000": {
      "source_hash": "sha256:d4df6d6071a067a320ba92d78f21932add808740e832b90573baf9f232935703",
      "text": "欢迎来到315 Production！\n……哎呀，你是？找我们有什么事吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000039:dialogue:000": {
      "source_hash": "sha256:34bca8e1b445ecac3cadf7ff1b7cc142496d541955c856fcebb1958d94e6f385",
      "text": "吾辈是来问问，\n怎样才能成为偶像喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000048:dialogue:000": {
      "source_hash": "sha256:57e06ec25eb937ab9d108e899b5c6d8cd391cf0bf6466a9b30d3a56693cc695e",
      "text": "想成为偶像吗！\n既然如此，那就听听你的……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000062:dialogue:000": {
      "source_hash": "sha256:28317f1e78703be97f0300459ba0ef1046f26e8495c968e68d3408cc0767d008",
      "text": "让您久等了……哎，社长！？\n接待客人的话就换我来吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000070:dialogue:000": {
      "source_hash": "sha256:eae79a2ca1ebb972ada27d0122c15896e6de4dcdae75956688bbe9c6f103f943",
      "text": "嗯，交给你了。\n你，请进吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000092:dialogue:000": {
      "source_hash": "sha256:91f58d92401784326fbfb396e1a37abf899c5433f260a4dcb30c7723773e0e41",
      "text": "（竟然是社长！？那肯定见过很多很多\n偶像了喵！）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000125:dialogue:000": {
      "source_hash": "sha256:3ff9a9c58ee3e464383972dd013d066e9b58edec6d1d1ffc16d395a6ce8f9372",
      "text": "社长，吾辈有事想请教喵。\n怎样的人才能成为偶像喵？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000134:dialogue:000": {
      "source_hash": "sha256:713a71f56b3f39c2ff227614d17a710ab1a3f8d00e270cfad56a57f204075ff6",
      "text": "是被●●●●プロデューサー君\n发掘出偶像光芒的人。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000148:dialogue:000": {
      "source_hash": "sha256:5aef854aac710c9e3569255bae07a32c0da7fe578ceee250b7b49132a8710880",
      "text": "嚯嚯……！那个制作人君，\n吾辈真想见一见喵！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000152:dialogue:000": {
      "source_hash": "sha256:17fee52d176dde3f4a2dc084b34603400a276039718dc21c4cea0e2a5ce70dd5",
      "text": "今天他在吗喵？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000170:dialogue:000": {
      "source_hash": "sha256:a9839db2a316961b4215b2c4a950a86c4c19ff5eaac1f38c8a541f02d15dd25d",
      "text": "制作人的话，\n就在那边的会议室哦。不过……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_i:cmd-000182:dialogue:000": {
      "source_hash": "sha256:ebf7b92ef7aa9dcdac8cca9348cfdbeaa376149d8fcf2c91e66b9d3ac0c7c880",
      "text": "会议室！\n那么，吾辈这就去打个招呼喵！",
      "status": "draft"
    }
  }
}
