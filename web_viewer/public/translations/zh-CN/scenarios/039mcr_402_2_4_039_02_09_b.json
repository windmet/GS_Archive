{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "039mcr_402_2_4_039_02_09_b",
  "source_raw_hash": "sha256:49f131deace66160d4bd45b8531e42ec479ab366aee9d11e39d632cc6aecc51c",
  "entries": {
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:318cb512c91b7a7b5fa5e7c964070feedfc1cd9486644c328ceff31c63433922",
      "text": "师父，游击突袭演出辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:4f3bbff1718db88bdfb8ba0084b6eb93d00e9b6b4f9b3f688ffa43f67f8de224",
      "text": "感觉演出的余热\n依然留在身体里呢。",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:ee5b25aea00656f2eeb824dcda9c5b13e79d416da75a525521753546b5c8b81c",
      "text": "演出棒极了呢",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:d940e8543c5e96edcf3897c2059c733f12ab5803649a4a999657b9ea04ba518d",
      "text": "今天请早点休息哦",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:b3dd542462c8063188c9958c3ac8ba9009594af909922af76cd91c8905db966f",
      "text": "是啊，那阵欢呼声，实在让人难忘！",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:ab995ef7b1936bc2f7cc2da38f206699a2768793816b371202498226f25fe4d4",
      "text": "说的也是呢。\n谢谢你，师父！",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:0b4d1bf21c8113de1973948f6da1280020ec382167968a6cbe65862cff0656f8",
      "text": "我打算简单拉伸一下，\n然后去冲个澡。",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:57b22d5b8305db3f501e8e0bcebe2f5e221138cc8f49e02bd78fa83a1f54214a",
      "text": "师父今晚也要好好睡一觉哦。\n毕竟师父也和我们一样累了。",
      "status": "draft"
    },
    "story-text:v1:039mcr_402_2_4_039_02_09_b:2_4_039_02_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:74a6c1b885bd428829d3086cae6aea28ee1c70979f5db4ce645b950f831e5419",
      "text": "那么，晚安啦，师父！",
      "status": "draft"
    }
  }
}
