{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10003_01_i",
  "source_raw_hash": "sha256:691d1dc0fe4d2c42ec6e91e24121a70c6d5bdd32dc47969ecd2151e578a9f389",
  "entries": {
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000030:dialogue:000": {
      "source_hash": "sha256:119765bfd565894dca31ccc6e3a2d4c9caeafdb21df286c10628234192b8d3da",
      "text": "刚才那是……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000039:dialogue:000": {
      "source_hash": "sha256:8ebe794e34af659cafb5711ebfbbaaddb41a2edd71caace1e655ce4c3d2ed949",
      "text": "（哈！？糟、糟糕了……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000055:dialogue:000": {
      "source_hash": "sha256:541c9dd875ef75d99fb8667be670c2c9dcc713b95a5bd99fc4aef7295c36c583",
      "text": "那个……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000061:dialogue:000": {
      "source_hash": "sha256:a53d65768dc5d1cd53279ec01550e396c481ec0ebb938d043bd776e5b307dc2c",
      "text": "如果有感到悲伤或寂寞的人，\n希望能通过这枚戒指赋予他们力量与勇气。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000064:dialogue:000": {
      "source_hash": "sha256:a66da5b226e164e2ac9f85f56641672c3d08b41f40888323c6583156fd1b7ab0",
      "text": "……他是这个意思！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000071:dialogue:000": {
      "source_hash": "sha256:414e2ffe172520ad7a18be99a83c77daa60138fb07d7ac1dd8b7cdea0dac3736",
      "text": "原来如此！这不是挺好的嘛！！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000073:dialogue:000": {
      "source_hash": "sha256:b425392ca9b8681b1bf8d557db6e915287d2de441107a0bcbd4ed1ad777fafe2",
      "text": "是的！非常棒呢。\n请务必把刚才这句台词也采用进去。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000089:dialogue:000": {
      "source_hash": "sha256:502949ebdbde5dd5ffce65a3122638c9586bba07e3e8c990d092052e38d0af26",
      "text": "太厉害了！太好了呢，阿斯兰♪\n人家也被刚才那句台词深深打动了！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000096:dialogue:000": {
      "source_hash": "sha256:2b0d553674581fc57543a2bfbe943261defee2e46df84cee057c52c952186093",
      "text": "是的。而且，我们心中所蕴含的想法\n也与阿斯兰先生是一样的。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000102:dialogue:000": {
      "source_hash": "sha256:58a1f0507e08afb632ec6679b73d407ad3830bb73429c7931a36aa786c32460d",
      "text": "啊啊。谢谢你带来了这么美妙的台词。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000107:dialogue:000": {
      "source_hash": "sha256:2726796b8edfd61c7b755cd4d1680e3af64133340758dc6705ab0dd09e780794",
      "text": "真不愧是阿斯兰先生！\n真期待CM的成片呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000122:dialogue:000": {
      "source_hash": "sha256:18bcf117ecd5b43e4fc333e3d76bfda5c8af7567e90fd321281c138debd7a281",
      "text": "！是吗……\n向汝致谢，卷绪。多亏了汝啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_i:cmd-000126:dialogue:000": {
      "source_hash": "sha256:007111bacd495c5e52ca5a2cc83635f1eeed236f5319cd5545e182c715ce198c",
      "text": "不用客气，阿斯兰先生！",
      "status": "draft"
    }
  }
}
