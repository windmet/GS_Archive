  "entries": {
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000011:title:001": {
      "source_hash": "sha256:227b5a188cdec256b19e03023471eca8e3e7003496c93b5a5bdaeb667fb289f6",
      "text": "儿童少儿英语教室CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:5a86a6b3c87eba1adc15b675ceefe042b7f0c055e53889402d236bc75d0848fd",
      "text": "“不用想得那么难，\nNo problem！和我来talk吧”",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e18bca7f18492e8a024d417a11270fd3d6d59701cc9e74f56d27542492b300cc",
      "text": "“只要开开心心地talk，\n自然而然就能can speak了哦”",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:d4b533ca53df92fefac7cf8f65c2d4ffe75913e73ddee88c0addd430c0806c6c",
      "text": "“我会support你的，一起加油吧”",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000042:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000050:dialogue:000": {
      "source_hash": "sha256:acf197b2de5205f41210cbcbbb97a3a127871ce52575acef84583202b7aa8aad",
      "text": "辛苦啦！\nCM拍摄，very fun哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000054:dialogue:000": {
      "source_hash": "sha256:e11e975ba230add39c0687c4b7f75d2b9a153a9b9dc276ad2d2578936f047f3f",
      "text": "辛苦了。\n现场拍摄的气氛也非常融洽呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000056:dialogue:000": {
      "source_hash": "sha256:3f5452a09d2e5cee965ab4348b48b61371751a6a7c684323a39747709509d07d",
      "text": "没想到类先生不知不觉就和共演的小朋友们\n打成一片了，真是让我吃了一惊。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000059:dialogue:000": {
      "source_hash": "sha256:a8dc9d71f0f4a4ef87f8415fac439fb3d76a283fa1c2d643c9c39b6b8bfe1c4b",
      "text": "孩子们可是要一起工作的\ncomrade呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000065:dialogue:000": {
      "source_hash": "sha256:7f034095820f6650c9a71f9d513bea573cf85f627e08c48ef41fc63b021b5af6",
      "text": "而且拍摄过程当然是越开心越好嘛，对不对？",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000069:dialogue:000": {
      "source_hash": "sha256:06c4dfebe94ac43c699a5c065b38e97fb2d7655f0ca192e6064323dcc00a6e41",
      "text": "呵呵，确实是呢。\n正如类先生所说。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_01:1_5_036_01:cmd-000075:dialogue:000": {
      "source_hash": "sha256:25f7c86f984b8b3950173693bf406cc46f8deba1de65916876ce8f338d975e2b",
      "text": "对了，刚才我和工作人员约好了一起吃lunch。\n你也一起来吧！",
      "status": "draft"
    }
  }
}
