{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "038tak_403_2_4_038_03_09_b",
  "source_raw_hash": "sha256:3265caf78521840cf4592e9293a4ad8fbcc7d99fd23afa3a22756d4c42d8db77",
  "entries": {
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:effc31ee53821b6d302639d3affad811a2a52fc8f13eba239055d72bc4391f07",
      "text": "喂，是●●●●プロデューサー吗。",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6e73ce800f0876146889e370453707831f01e03d6df9057ba60d0a5ac0f28c74",
      "text": "这么突然不好意思。你知道有什么店\n能吃到巧克力火锅吗？",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:0d5287d352094f4ff6c4cdd7a0ae6c9dd96997aa2d8062830ef3a0201936b29b",
      "text": "下次的情人节宣传活动，主题不是巧克力和\n水果吗。",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:94a210ad8f865dcdab2684e0d5312560539a941310427d947ca0d69cc70a05b1",
      "text": "大家聊着聊着，就说如果要提前做功课，\n不如干脆一起去吃巧克力火锅。",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:ceafc72b7c1a119a8fb66c99bb3f53c88c85152daa25cdc5bb1e2bfda5c62927",
      "text": "现在大家正在分头查找……\n不过我对这方面不太了解。",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000018:choice_short:000": {
      "source_hash": "sha256:d18f8739870304d9b5c46c784209540262c242326cf329596c5d8257ddf6ad83",
      "text": "我去联系一下我知道的店铺",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000019:choice_short:000": {
      "source_hash": "sha256:7d5498dbd8359fa5ecb8ad9790728b5baff44ec93691af85f6d27c5a4f57aaf6",
      "text": "我也来帮忙找找看！",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:e6626c905c883957987e4031f2a44d552e57f852c75f35d15fa34e504e9ff86a",
      "text": "帮大忙了。制作人愿意帮忙的事，\n我也会转告大家的。",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:1d263fbeb257bc7e6c138c51edb72af0705be5670b5de81562b917f751e1cc47",
      "text": "等店定下来了，我们一起去吃巧克力火锅吧。\n大家肯定也会赞成的。",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000027:choice_short:000": {
      "source_hash": "sha256:2748f98b581d6a0e55e73e8a9f986d33f92b9547a36b5f0595cb7904318639b3",
      "text": "非常期待",
      "status": "draft"
    },
    "story-text:v1:038tak_403_2_4_038_03_09_b:2_4_038_03_09_b:cmd-000030:phone_message:000": {
      "source_hash": "sha256:03ad6fcab3b93b492da3c5a5962481fd767b4a80ca5d92a880915ef0c968a531",
      "text": "嗯。那么，回头见。",
      "status": "draft"
    }
  }
}
