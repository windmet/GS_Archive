{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_03_a",
  "source_raw_hash": "sha256:7d735317fc074598b4036684fdd9a2a0484908f4e2028dee4d886916839bb30c",
  "entries": {
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000000:title:000": {
      "source_hash": "sha256:b73c518a7a6f663bc41898fdca0e9be253f34f8ea86ee4af0737414a73734fc7",
      "text": "目标所在的前方",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:30866507365f9e71caa99cd953a8abd9de330a344ba35ac764e33b908cd2f360",
      "text": "翔真与九郎参加了315 Pro的试镜。\n意料之外的人物登场，\n两人虽感紧张，但依然迎接面试挑战。\n与此同时，桐生也为了成为偶像而拜访了事务所……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000012:title:000": {
      "source_hash": "sha256:b3a0c7f8f83c9759bf38e90e810580beff52236c88683724b5c13d354d17d97d",
      "text": "第3话",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000012:title:001": {
      "source_hash": "sha256:b73c518a7a6f663bc41898fdca0e9be253f34f8ea86ee4af0737414a73734fc7",
      "text": "目标所在的前方",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:fd23065e1691726599ca46cc1ac12ad804f32ce46c92ba33a38205a0cc894340",
      "text": "●●●●プロデューサー君、贤，我回来了！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:7aa1ebdccb067cabeba5fe10133e82922b7dcfd22799bedb98ad0fea0aa3f5d5",
      "text": "欢迎回来，社长！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:589d804748164c5241bbb6bb62dcfd62917736d775f572af86e0d3901e3fb23c",
      "text": "远行辛苦了！\n话说回来，这次回国还真突然呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:484d8fcbd96c955cbe050134c9cdd957bf2679dd015650e11cdac8d8ddcf2c75",
      "text": "工作比预定提前结束了。因为很挂心这边的情况\n就赶回来了。进展如何了？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000059:dialogue:000": {
      "source_hash": "sha256:407fc406e592c0c15d12a01bd0b20445ae8412cf48f4872c0637883ace52df0f",
      "text": "是！招募偶像的海报制作、在杂志上刊登试镜\n举办信息等，都在顺利进行中。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000063:dialogue:000": {
      "source_hash": "sha256:18aaf967d60ec63e1164a20f1df471a0f69653d13dd8e7d81fdec1ac61fd6043",
      "text": "我这边也很顺利。正在向具有偶像光芒的人们\n搭话，并收到了答复。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000065:dialogue:000": {
      "source_hash": "sha256:4c759ae50a202cd9368c4b59ebda1333a303235cfa86b33a4d50f9067dee6788",
      "text": "今天，事务所里正好有那些候选人的试镜。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000074:dialogue:000": {
      "source_hash": "sha256:a9af66865c356f0a503e7c9a7da4b5ac476baf62e71e98be127e690e6c7ff53c",
      "text": "要进行试镜吗。\n……唔。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000076:dialogue:000": {
      "source_hash": "sha256:39d98c9d80f51d72e5e2809996fd9c0881dc1c549e5ee7683683b353eed34d51",
      "text": "制作人君发掘的偶像候选人，\n究竟是怎样的人物，真想见一见啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000078:dialogue:000": {
      "source_hash": "sha256:ff19c9c5c00e0e8cde6872457c1255435b058c294b2ab012c14572e6382fa330",
      "text": "能让我也参加试镜吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000080:dialogue:000": {
      "source_hash": "sha256:ab4be9e2b03e5e348434baa443953be926c9a55e36ee9af45c9f43551d0ecf46",
      "text": "务必拜托您了！我也很希望社长能看看\n那些候选人的光芒！",
      "status": "draft"
    }
  }
}
