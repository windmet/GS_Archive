{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "004ter_401_2_4_004_01_09_b",
  "source_raw_hash": "sha256:242cd3bc371a5eb4c0d6c494a623af2ea111176351a83f851b35dcdb6dc4f524",
  "entries": {
    "story-text:v1:004ter_401_2_4_004_01_09_b:2_4_004_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:2ae82b15d2ee3d8080ba3659c0e2235edf2afb5fedaaa9f1581e330381f4fca0",
      "text": "……啊。喂喂？●●●●プロデューサー？\n现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:004ter_401_2_4_004_01_09_b:2_4_004_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:fd67b8cc3dc787cf13ab5582bdac65e75586bc713ea0fd4fdbed7306ee0e0718",
      "text": "噢，方便啊。太好了。\n想着想再跟你聊聊，就打电话过来了。",
      "status": "draft"
    },
    "story-text:v1:004ter_401_2_4_004_01_09_b:2_4_004_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:6526ec7ca054d6e3cedebc4705d4d811d16a93e7a633984cf3baa8b15edd6251",
      "text": "演唱会辛苦啦。\n观众们超级热情呢！",
      "status": "draft"
    },
    "story-text:v1:004ter_401_2_4_004_01_09_b:2_4_004_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:a28b824aeacc8dc715ca1d3a8e94842819b59a6137986c355fdb4587317dff5e",
      "text": "荧光棒的光芒超级漂亮，\n简直就像置身于星海之中一样。",
      "status": "draft"
    },
    "story-text:v1:004ter_401_2_4_004_01_09_b:2_4_004_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:6ff06eeb6e3eff0bc4e9e2e92245637331ac1342efa4ebaafe9166ba46fb72b5",
      "text": "下次想办我们自己的演唱会啊！……哎呀，\n电车好像来了。明明是我打过来的，抱歉啊。",
      "status": "draft"
    },
    "story-text:v1:004ter_401_2_4_004_01_09_b:2_4_004_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:34e13fd3cb7e7de22c57f34ddd99666275b1853b40d1747926f94394b85157b7",
      "text": "●●●●プロデューサー今天也累了吧？\n要好好休息哦。那就回聊！",
      "status": "draft"
    }
  }
}
