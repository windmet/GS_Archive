{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_03_b",
  "source_raw_hash": "sha256:e17c8c924b4c6899c1ab8bbdde4cd84fcf8a4d3773006a672496946ef68fea68",
  "entries": {
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:5a4d4375f6ae961c0b3b7487bd5f514230d5fa3ce72e17f2c08702099349e3d9",
      "text": "喔，差不多该集合了吧？\n走吧，享介！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:2f3e4e556891f23b1a8bc6d75fb1f2253516c68fa0cb13ff9bf215af238efcf9",
      "text": "啊，你先过去吧。\n我还有话想跟●●●●●●●●●●监督说。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:26e083116e910310c05a9d23cf3fc119b7a06315b09eab09106e6ad38bcca9a2",
      "text": "知道了。那我先过去了！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:aa93fed7e9036183f6d3b58818369085403d645d1545ba7a08283df2a297f392",
      "text": "那个。是关于悠介脚上的伤……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000050:dialogue:000": {
      "source_hash": "sha256:01bfef626dd47a74f275452ec80813e7addd9e9b9985595310bb866a8aa7daa0",
      "text": "有什么担心的事吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:770e33d9065a887f42ee6bd455318f6dd3d4808428a67d9a30d0e28db8aa3650",
      "text": "没，他本人是说没问题啦。\n还说我总是瞎操心。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000061:dialogue:000": {
      "source_hash": "sha256:3c2e2ba3bd37ce6e92f3e98d39dc7ae00c86bb59ed06f815def58c3c6574816f",
      "text": "虽说直到今天进行了各种特训，确实也\n什么事都没发生。但悠介那家伙的性格你也知道。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000065:dialogue:000": {
      "source_hash": "sha256:32622e80aeabc8680fd58fe1af18cff03642248b1210a1ed3ed96d7ce7372f39",
      "text": "我担心他在正赛里会不会勉强自己……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000068:dialogue:000": {
      "source_hash": "sha256:3a9d76d01154bcc6646e03c5ade3578e75d96f4bf2d357e81fca64ac50e6cada",
      "text": "要是真变成那样，我也会去阻止他的。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000073:dialogue:000": {
      "source_hash": "sha256:3c445f6f0e5ab194e07fa210c95c5635e6fe60e9bf2ab5f10231d81961b0bef8",
      "text": "这样啊……谢啦，监督。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000076:dialogue:000": {
      "source_hash": "sha256:2658c051467a59333d54a876f92b2211d0db105763ad6ba4b7c76c08d5bba7d2",
      "text": "是悠介自己说“想参加”的。\n我想尊重那家伙的意愿。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_b:cmd-000081:dialogue:000": {
      "source_hash": "sha256:c2678b52d866788a0a465978caee9a21dab63939decb7b01e7826cb900c9958d",
      "text": "明明都决定好了。明明都已经到当天了。\n我真是不中用啊……",
      "status": "draft"
    }
  }
}
