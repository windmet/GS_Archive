{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_006tsu_2_1_8_006_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_006tsu_2_1_8_006_02:1_8_006_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:8034945e8e7fe3c0705424c070444b1d0c8e5e269706db3740afac3496734e3d",
      "text": "啊！●●●●プロデューサー，\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_2_1_8_006_02:1_8_006_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:d245b71ecc18405fdb0073d498f1e7e8dfc3198c3fd39ff0481276b9a1b2dd22",
      "text": "太好了，您还在事务所。\n祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_2_1_8_006_02:1_8_006_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:4db790129d6e1247a2418ca4ea1de1bde304e9392e22fd482df2cb8700444a7d",
      "text": "非常感谢。您是特地为了这件事\n顺道来事务所的吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_2_1_8_006_02:1_8_006_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:746c637e7351a6f3f39f6fbeadfee3518d8e3e3c4771bd02f71bee8e86686dda",
      "text": "是的。我想着这个时间应该能碰上您……\n能当面送上祝福，顺路过来一趟真是来对了。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_2_1_8_006_02:1_8_006_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:6f68ccfbc525da61808230105c72ed7375d56fa71b7cf481b6401c4b8fe85983",
      "text": "那我也差不多该去工作了。\n祝您度过美好的一天！",
      "status": "draft"
    }
  }
}
