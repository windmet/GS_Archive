{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10003_01_a",
  "source_raw_hash": "sha256:691d1dc0fe4d2c42ec6e91e24121a70c6d5bdd32dc47969ecd2151e578a9f389",
  "entries": {
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:617e785fdbabd2d084607f482671d8367594ec5f3d8e75f93318b585131bcca7",
      "text": "圆环指引的前方",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:7d3c1712a52bf53a6d4b2505a9729261c443c92a7586511dcb4f1d73f486388d",
      "text": "看到新晋新锐珠宝设计师制作的\nCafe Parade同人作品，众人兴奋不已。\n以阿斯兰点了一个“赞！”为契机，\n饰品决定正式发售……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:6bd711a0c587f0c078d13f61396e0634340adf4afbcabad0ac20aea8f2b2a191",
      "text": "序章",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:617e785fdbabd2d084607f482671d8367594ec5f3d8e75f93318b585131bcca7",
      "text": "圆环指引的前方",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:6ccb65aec10bbcd2b68973e48248630cdc45c44491d76c196b08f0c3a7873ccf",
      "text": "非常感谢您的光临。\n欢迎再次光顾。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:e75fa17e17621ca465c4d45fdf51cc88a8b3180f876bbff019987d108d6d7182",
      "text": "嗯，那么吾便告辞了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:dce7b6bf2e8921abb2b106252d3105e5a9a1dc04627f2ca7eb12522bcaef81d8",
      "text": "库库库……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:09f98e94c3bbec1e2e55f81c2c1492bd0c5457317cea4d32025a932326745f3b",
      "text": "（在圆桌会议开始前的时间里，\n偶遇踏入的神秘魔石店……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8f35ff0e0229ed597500eadd43d1629a5e75b303df063f51467a3f3cfdc0b929",
      "text": "没曾想竟能与如此美妙的圆环\n邂逅……！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:cd9a88da1928ad980b9f7d51827043469346ff0b6da6079ce3748c8f75cc0238",
      "text": "今日真是良辰吉日！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000049:dialogue:000": {
      "source_hash": "sha256:f02e639d9e6bde92c9e81f5cf02546410830260358657d87ef6749b2e9db228f",
      "text": "唔？怎么了，撒旦。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000057:dialogue:000": {
      "source_hash": "sha256:e1047de220979e698b1f52c3b38c24b33932d9b78a70aaec055fb9a5fb562ad3",
      "text": "原来如此。是这圆环与撒旦产生共鸣了吗。\n看来吾之审美眼光并未有差池。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:47eed994723d9191e62098a6732f4953e6b772247984fc1ab0fd3258449b964f",
      "text": "速速将此圆环佩戴于身，以增幅吾之力量！\n啊——哈哈哈哈！",
      "status": "draft"
    }
  }
}
