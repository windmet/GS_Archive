{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_002_23",
  "source_raw_hash": "sha256:4109c0f0093340e4d7375199840532480bc48a1bc477fbf99577629c9b142f17",
  "entries": {
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:85863c1dc3e01fafaa194c3cbdd39056cd039ff6945a73de7326679db0e141c8",
      "text": "看啊看啊，制作人！\n好壮观的彩灯啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:e8182d1dadf89b47d9bf37506152ee0b66358d029ceb72c8328be98948579d2a",
      "text": "难得有这个机会，我们边看边回去吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:dcc17b24b71eca661fbf71c736251155fec5ded99ea99fb148c0318ee9efa6f1",
      "text": "今天真是开心呢～。工作上大展身手很顺利，\n彩灯也这么漂亮。",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:371f8b5acef5b52dc792850d679e5e8fd02c72b5cf00500b070b8b7dc1f9446d",
      "text": "最重要的是，还从制作人那里\n收到了巧克力呢♪",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:dff499bd26a4a0903d417db8a4b26dd6d9e7f591e3ba011dc56d11973ff8f83b",
      "text": "你一直没送我，\n我还一直在想什么时候才能拿到呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:76679e44f4ee28ac71968e55b14654c855b513b60cfb9cf04721f86622fb2a06",
      "text": "因为去年的巧克力很好吃，\n所以我今年也一直很期待能吃到呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000054:choice_short:000": {
      "source_hash": "sha256:9bc8d64179b1ce0f33694dd324432ce1161a8d362cfb772fcfc779aa698b35f7",
      "text": "我挑选了最棒的巧克力",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000055:choice_short:000": {
      "source_hash": "sha256:0db143120c4b07e2ef72028c816384550b0f67a7a457f76f270bd696617fa3e8",
      "text": "倾注了满满的热情哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000063:dialogue:000": {
      "source_hash": "sha256:951ccc441fe81a102298e699ee42a064d9f29aacf264f6e8258ed334f7c5ce9e",
      "text": "既然是制作人拿出了十足干劲\n挑选出来的，那就肯定不会错啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:eb1a1349edf73b83815ba3c0f7c08e067f5fff493d3e2531bcd21a22a5523a0f",
      "text": "嘿嘿。聊着聊着，我就变得更期待吃了！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_23:5_01_002_23_a:cmd-000074:dialogue:000": {
      "source_hash": "sha256:593949767ca2ffa7b7771ecd6caf5bc29302ddd8e2faee74d03f6a22b167eb1d",
      "text": "等回到家之后，我立刻就拆开尝尝♪",
      "status": "draft"
    }
  }
}
