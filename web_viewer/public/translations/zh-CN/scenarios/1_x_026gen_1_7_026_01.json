{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_026gen_1_7_026_01",
  "source_raw_hash": "sha256:ad1fb33045e2995059a0841fccd92c68af44a6b2da9c53a16e4758277f00b93a",
  "entries": {
    "story-text:v1:1_x_026gen_1_7_026_01:1_7_026_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:a3e4693f1b91da828bb9d5fb411d4f85df57c8c9d5b5756eb455e996424b07e5",
      "text": "今天也是玄武先生的生日呢。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_7_026_01:1_7_026_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:2b6f3ec892ed0adda7632c553ad32cb0efb0869244c18a312d135ef3d0680c49",
      "text": "●●●●●●●●●●番长……\n谢了。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_7_026_01:1_7_026_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:8ebab3fab1ee2ef40f09abea4aa07f096adb5cc411dbb131fcb98f128f6e1c92",
      "text": "没什么，只是有点吃惊。\n……因为没想到你还会为我庆祝。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_7_026_01:1_7_026_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:0b8156e88288ca4c3c0a12f5c9078c28b994e93d35ebe57ae0a343c780092d17",
      "text": "真是感动得都要热泪盈眶了。\n就是这么高兴啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_1_7_026_01:1_7_026_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:56898345235fbd2b277a104a7f4ff5e5e8c6a2cf1cd5b41ba327e1240b068d89",
      "text": "为了替我庆生的番长，\n我也会秉持百折不挠的精神向顶尖偶像迈进的！",
      "status": "draft"
    }
  }
}
