{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_023har_1_5_023_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000010:title:001": {
      "source_hash": "sha256:3f2353b76e4eca175f641418fdfce29fc1ed7716f1cf5e0145074db3579a5a81",
      "text": "青少年向杂志写真拍摄的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:fadab94666fc30736ece39d46b0cb79ad1ba033abdbac6d83a338653f86f89c8",
      "text": "诶，是这样啊。\n那这种情况下该怎么做才好呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:28678713dc4d94dbd0b7e9427d3a0acab53cb802c5dff7bf8b3b3e93e431215b",
      "text": "（虽然拍摄结束了……\n但春名先生正和发型师聊得热火朝天呢）",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:1ce23a272f1e8c1e5c95443e31638a876b5197863a88de347bfa24152f3e56de",
      "text": "（先去向其他工作人员打个招呼，\n然后再去叫春名先生他们吧）",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000044:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "数分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:605095b55c556f287406263bf29cc3a3533fdf6ad404df699a30f67835ed2e33",
      "text": "●●●●プロデューサー，抱歉啊。\n不小心聊入迷了。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000054:dialogue:000": {
      "source_hash": "sha256:4a85f2288b6544f4fc4e39a062ac46bcdf702c5217df1dd8fac2e43c7ee64340",
      "text": "没事的。\n不过，你们聊得真起劲呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000059:dialogue:000": {
      "source_hash": "sha256:b08ad68cb88e707768ab32632c4607c3dbdaf86eae00143b66e4df20fa16e335",
      "text": "发型师教了我好多东西呢。\n比如现在正流行的发型之类的。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000063:dialogue:000": {
      "source_hash": "sha256:9ea14d9a91ad42666e3689933346b2badcf0cfa784b71f32490148a415685a78",
      "text": "我以前也尝试弄过，\n但总觉得弄不太好。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000067:dialogue:000": {
      "source_hash": "sha256:3c01e42f79da7a0990511a8d9d682db36a2aea381d6ce660e2b9b38554d74ef6",
      "text": "去请教了一下，他就把诀窍教给我了。\n我马上就去试一下！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000073:dialogue:000": {
      "source_hash": "sha256:1b9b813d9f90cf85b62f8816355f36f464ec27c9cd971d07554b80d5add9c285",
      "text": "要是弄得好看，\n●●●●プロデューサー也要看看哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_03:1_5_023_03:cmd-000076:dialogue:000": {
      "source_hash": "sha256:1461be5a793f1dfe90462521934d5c7010a6a68abdbc2a6a135fc511e4d549a5",
      "text": "好的，我很期待哦！",
      "status": "draft"
    }
  }
}
