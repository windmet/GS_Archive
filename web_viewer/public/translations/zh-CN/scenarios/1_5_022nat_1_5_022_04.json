  "entries": {
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000010:title:001": {
      "source_hash": "sha256:d64fee80c57d704a560b92af539338cdc5f54f7cad101dbc2196c11bff1fb000",
      "text": "时尚杂志模特的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:e2b1babd08c817012b79351565bc8af7359ce6a52dc9fa90094a83dc092cef14",
      "text": "夏来先生，拍摄辛苦了！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7dd45cc13ac060b09953558182d085a914f8ee4e08f392180d402c1257a7504a",
      "text": "…………辛苦了。\n摄影师……帮我拍了好多照片呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:478ebbd54e4312023fe7d4c0acffcd7bbb9021a7e646ff04bddcb4042ce12847",
      "text": "摄影师也是干劲满满呢。\n夸赞说拍出了不少好照片哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000024:dialogue:000": {
      "source_hash": "sha256:c35248ed80d89148af8d7327f37d941824c349271b971f7f5198ed8cb168a3a1",
      "text": "因为夏来先生非常有魅力，\n把摄影师的职业热情都给点燃了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000029:dialogue:000": {
      "source_hash": "sha256:292533dd044d51e218d0851ff263c61bce0d00c97dce6d76e3f5a7d566500a2b",
      "text": "说起来……摄影师，\n在拍摄的时候夸了我好多次……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000035:dialogue:000": {
      "source_hash": "sha256:b4cc740f1dabbbfea0280e3b4d0c81d684a527d5001ca2b14fd95804cb8cb29a",
      "text": "摆了好多姿势，\n虽然累，但是……很开心……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:483d40b5377d0d9e6928915c130658a998d153ea21e7478618767a51de6041be",
      "text": "服装也是……因为概念是成人约会风，\n有很多偏沉稳风格的衣服……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:5ba1b9a30f34abde669b918268b81797e722ae5c441e7b3fd03d83950151035f",
      "text": "里面也有平时不怎么穿的类型，\n很新鲜……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:2670b8fae6e510a068d4354966c5b7541ea572eeea39938755be59e8df830522",
      "text": "真期待杂志发售的那天呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_04:1_5_022_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:5f72f89abbc2c796cf66af380e675c648d3e50d9172728b86f9864c0c311ffca",
      "text": "……嗯。我也，很期待。",
      "status": "draft"
    }
  }
}
