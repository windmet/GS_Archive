  "scenario_id": "1_5_003hok_1_5_003_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000010:title:001": {
      "source_hash": "sha256:996ab82de97c51960fa9b5da076b3eee0ad69fbe52dbe06775535df4ef32485f",
      "text": "出演访谈节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:6693d4ed69168710a5dd6ee226dcaa16fe24b8dbd5327050894852f166432cd4",
      "text": "访谈主题居然是“致过去的自己”，\n真有意思呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:a5cd98e4364c19bbda14444a3e67ecfbb63c1e0c56badf384a216b22249a78c7",
      "text": "好像还会放出做模特时期的照片\n以及刚出道时的照片呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:bc74a9b388cb89188e0f05af686516410470503ff7151818d08475817d58e931",
      "text": "现在已经很难见到了，\n非常珍贵呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:e3949ba52ee6c904754071463011a0c65f974f588101b05aadce9d34d42ac9da",
      "text": "倒也不是刻意藏着掖着就是了。\n只是没什么公开的机会。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:91ed87902b5c16431da4f0ec6495938cb450239e16111c815d166d4d1dfeb50c",
      "text": "我想，肯定会有在这个节目里第一次见到的天使酱吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:be5651a49e2015ea3517e16c54e9ac856fcf6c12f30c92b7160e39a549c1106b",
      "text": "不光是照片，了解到我过去的天使酱们的\n反应我也很期待呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:af8e60bfdb3ae79a27e0b20344d522a3fbebe284f8e4f2c7a5402a0618cfbff2",
      "text": "节目里要聊的内容\n已经定好了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:433dd190c170a269cabc0cae732fcbb2f2dd952e8257650b4dd6b3560cc7f0d9",
      "text": "差不多吧。准备了几个\n当时的趣事哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:bc1031e4bcedb3efb0fe489a1c0dccb3252707a09fe0373fccbe13d60c66a00b",
      "text": "观看的天使酱们肯定也能看得很开心的。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000053:dialogue:000": {
      "source_hash": "sha256:4a2dc0ec934bd6fe2121f1ead4e627b8b77af682a680bfc95ae1fad8e76226e0",
      "text": "那么，时间也差不多了，\n我这就去录制了。",
      "status": "draft"
    }
  }
}
