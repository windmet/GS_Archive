{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "003hok_401_2_4_003_01_09_a",
  "source_raw_hash": "sha256:16c3bb970ec6253808db717efc9eefa79c2d1311c9fb3b0b91709f0852e3367e",
  "entries": {
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:a584eaa152ac568d926e947deea1b7824bfa10d2c56d6a9b0f56dd620485220f",
      "text": "喂，制作人。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:57dd25c4e1723ac41faa9e7f46a4ce1b83b647a3230dba3654f811f14501547c",
      "text": "差不多到了要公布那部电视剧\n信息的时期了呢。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:4d02f7ce8d2ed43264d050a5dcff5e6fa06ee818142748e9ddcc1c0b900983f6",
      "text": "很期待观众的反应。\n毕竟是在这个时节播出与秋天相关的电视剧。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:939914830d1deb67063ad5991a4f4f5508d6d3d2f873c8da7d75f8137fdea7e8",
      "text": "应该会很容易给人留下深刻印象吧。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:696aa35683bd2e8d1abfac09e5aa6d745a2ad9681b05a63ef19e9770502214fa",
      "text": "感觉会成为话题呢",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:68e16517baa70eac2a313f921e0acfc3a1ea9ac2b63931e0853725fb089e5d31",
      "text": "希望能让很多观众\n看到！",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:ee7b339e94093377751025574c51ba4f13746f0ce18ceab832c0e04fd46b11a7",
      "text": "嗯，我也是这么想的。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:dc166d96deee3c4288c5939d11515da5a374eac3ab3775f98de225e4d160c227",
      "text": "这么聊着聊着，\n又让人想去那座温泉街了呢。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:a9f5c39e22414939dc528d7d6ce8ea12aa7fe09d540a521a4b0f6c24ebba62d2",
      "text": "要不要在电视剧播出前去一趟呢？",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:a341597a23a66303455a91e95804dd7de2dd1fd1af8c6074aa5aaa3adff3f1d8",
      "text": "红叶固然很美，\n不过我也一直想着在其他季节造访看看。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_a:2_4_003_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:6d3cd0e289fb13f44885993af743d47ac14bf7a78f5cdfcb1c9f831439ceca05",
      "text": "刚好下周有一段连休的休假呢。\n去了的话我会买特产回来的。那就先这样。",
      "status": "draft"
    }
  }
}
