{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_044_01_e",
  "source_raw_hash": "sha256:45fe81751ba1547592204ef5aac029e92698000aecae25e79de04318734ab068",
  "entries": {
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000011:time_caption:000": {
      "source_hash": "sha256:2cf299b9db82240fc03c5e3aeca137dae387b6b9aadfc396c17215c632e680b3",
      "text": "数十分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000023:dialogue:000": {
      "source_hash": "sha256:4b7cdcd21b8be083ba139412a9e9159cc5802f0dd88a7e38437c416466e8ee3a",
      "text": "……好，这样就算告一段落了吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000026:dialogue:000": {
      "source_hash": "sha256:4f022dbb9bd776e481b0fcb4f251184588c827625f78ffb1e0ad911547dc6125",
      "text": "事务所的里里外外都变干净了呢。\n想乐先生和克里斯先生肯定也会大吃一惊吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000030:dialogue:000": {
      "source_hash": "sha256:072a036c5dd093e751c251cd181a7f97b4fe6915b82e425892105a14cfba3eb3",
      "text": "期待他们两个的反应啊。一边喝着山村泡的\n茶，一边悠闲地等他们吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000033:dialogue:000": {
      "source_hash": "sha256:a125be62052909b12f8842da5982556a440b4aabed2082074a395202e2edf8d1",
      "text": "嗯，好呀。\n……雨彦先生，今天非常感谢您。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000037:dialogue:000": {
      "source_hash": "sha256:72d487d20f32e45fe57976b482a6511e0aa82d94ac69337105937c7841cb0a2a",
      "text": "我今天也很感谢你哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000039:dialogue:000": {
      "source_hash": "sha256:58b0e970a7154805b730c7b8b8c1de11e8ba344e7e958f428d8b770162b6c66a",
      "text": "哎？",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000044:dialogue:000": {
      "source_hash": "sha256:11ababb52b042f599adfb45db8b5f27b3280ee2e8f45b5c08854db371adc585d",
      "text": "你不是帮我一起打扫了吗。\n多亏了你，比平时快了好多就搞定了。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000048:dialogue:000": {
      "source_hash": "sha256:4a486effd654597f78344e4445f2c4f38195548c976d84c1d41e9e77d4b71bba",
      "text": "能帮上一点小忙就太好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000052:dialogue:000": {
      "source_hash": "sha256:c9e599294e41e34b019b04f571e43f2decac9006093ad2b069b56b5f2b6923b4",
      "text": "比我预想的时间还要早结束呢。\n可不仅是一点小忙的程度哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_01_1_2_044_01:1_2_044_01_e:cmd-000058:dialogue:000": {
      "source_hash": "sha256:d68d716b9bbd9ba6db6d1fec74a51c9f5aea8669948027a6666bea158a643fed",
      "text": "下次要是你有空的话，我再叫你。\n到时候也拜托啦。",
      "status": "draft"
    }
  }
}
