  "entries": {
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000010:title:001": {
      "source_hash": "sha256:97d1afdd48470d13319f0b696a2ed4128f8a486ac920bd2145759395bf7ae649",
      "text": "时尚专业杂志的写真拍摄工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:dafd0a0417e9159eae0b72e2757c44da72c97acb71f72546f410f46d2d16d7bb",
      "text": "今天拍摄用的服装，\n总觉得是设计很不可思议的衣服呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:8c9738d03120dd2678c272fd8c863902cde4910304bfcf36041c76bb03d7afdc",
      "text": "现在流行这种衣服吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:86943e2a5b4adece6c619f43369d16c3fa83eab8984bc0fc346413101d0b774f",
      "text": "商谈时给我们看的参考形象\n也十分独特呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:9b5129581088ea454562be2b28a120fc39862bbf16607c6052f682ef8c473f25",
      "text": "是啊。即使看到实物，\n我也很难想象出自己穿上它的样子呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000030:dialogue:000": {
      "source_hash": "sha256:620a99c7fa6815816f760812b77fb5052700d66e06aa3a48ba76784f42845b4f",
      "text": "由我来穿真的没问题吗……",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:f0186978bcd9aab6128cade9a18ce1bd22aee80d850bca5c520c05f31b2503bf",
      "text": "圭先生的话绝对没问题的！\n请拿出自信来。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:73c50551be988ce5b338b7da93b148819a745e62c0603f55ebf81c03025d77ec",
      "text": "……既然你都这么说了，我会按自己的步调努力试试看的。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:b2a25f91dafabbc67a956d37401220dcbb8fe67c6e189d311356a5e5cb8ee7ff",
      "text": "差不多要开始拍摄了呢。\n那我去了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_03:1_5_007_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:c1987d13a85073a3fbc91d73207e8661bc88bd417f6bb7da860db6b687216086",
      "text": "（拍摄大获成功，\n圭先生的照片因极具氛围感而广受好评！）",
      "status": "draft"
    }
  }
}
