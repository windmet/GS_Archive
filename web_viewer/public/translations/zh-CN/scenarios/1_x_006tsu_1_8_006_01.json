  "entries": {
    "story-text:v1:1_x_006tsu_1_8_006_01:1_8_006_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:d28fe984c34fff75e110ddd86dd90723565113e721acc386c1156205dfa02db5",
      "text": "辛苦了。今天对\n●●●●プロデューサー来说，\n是个重要的日子呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_8_006_01:1_8_006_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:b99f1140ab5ad2f82fd535a606beaa1829d7fd0be38e062952fa9cb211386d4e",
      "text": "祝您\n生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_8_006_01:1_8_006_01:cmd-000013:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_8_006_01:1_8_006_01:cmd-000016:mobile_message:000": {
      "source_hash": "sha256:c8c9a740191048c525af1a20193699db913f9f732ee6db77a94d5c7dccfe3e44",
      "text": "呵呵，我也很高兴能为\n●●●●プロデューサー\n庆祝生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_8_006_01:1_8_006_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:24e6da1128c42ae1147145ac7f46e69507d32a30d9bdff57ef13b3980a8725bf",
      "text": "祝您度过一个\n开心的生日。",
      "status": "draft"
    }
  }
}
