{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10003_01_b",
  "source_raw_hash": "sha256:691d1dc0fe4d2c42ec6e91e24121a70c6d5bdd32dc47969ecd2151e578a9f389",
  "entries": {
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000026:time_caption:000": {
      "source_hash": "sha256:d97839694a88d3dbaae2835aa42718463b83dd8670118274c73ca9eac5ddd44c",
      "text": "事务所",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000037:dialogue:000": {
      "source_hash": "sha256:e954a5120cd62d1edb1ddcc4426e468b4ac5d76b71e565fbb566525486f98447",
      "text": "吾之同胞团啊，全员齐聚了啊！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:09c3ffe22cfa9424aca3956516561354e238bd6c8fe62ccf65063cd22f9ff3b9",
      "text": "是阿斯兰！呀吼——！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000062:dialogue:000": {
      "source_hash": "sha256:e978640b1b615641e2901bb60e937ca79cb068e112bb194ab3005af00fe7ab24",
      "text": "唔？未见主之身影啊……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000067:dialogue:000": {
      "source_hash": "sha256:dc99adbb270b96980c9d8e83fb709f6f41b86b7e63912a1b6cb819ae72002165",
      "text": "听说前面的工作结束了，正在往这边赶。\n刚才来消息说会在约定时间前赶到哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000083:dialogue:000": {
      "source_hash": "sha256:9773ea07eb7db15645fcdb51aa2289a6d04174d28b896f375451af61d05104c7",
      "text": "阿斯兰先生，看起来心情很不错呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000090:dialogue:000": {
      "source_hash": "sha256:d3fd3998e5c2b79ba9778a6913774a284cf9a04aa475dca79e07b06d91f73d97",
      "text": "哎，那个购物袋……\n买了什么东西吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000111:dialogue:000": {
      "source_hash": "sha256:c5ef1a52d6a43b3ceea3567c5d526398444dfc6589a7a77223b25548f18e2e9c",
      "text": "库库……吾得到了全新的圆环。\n缠绕着不祥的魔气，与吾极其相衬的极品！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000126:dialogue:000": {
      "source_hash": "sha256:4f5b2a1b3f19f5254962405437a99f5bfb727176c0906b5585bca058bddfa4dd",
      "text": "是那么棒的戒指啊。\n买到了好东西呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000141:dialogue:000": {
      "source_hash": "sha256:5a9350de150ebdb8655cc1abbd9399c3fade583e893b572488b21c7abf9e192d",
      "text": "诶——是什么样的？好在意啊～！\n呐，阿斯兰快给我看看嘛♪",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000156:dialogue:000": {
      "source_hash": "sha256:82ac7862cd14792bc0c9f5acb7eac98be4db8693dd2ed153a27c78cb55a1abe3",
      "text": "且慢。\n待吾开启彼店的电子启示。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000168:dialogue:000": {
      "source_hash": "sha256:a7ead6007e2d3dd32e303c8bd73f2f98d96a27a4adbde6e9153b5feb60932575",
      "text": "吾之同胞团啊，拭目以待吧！\n此乃吾所入手之圆环！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000183:dialogue:000": {
      "source_hash": "sha256:03d9beb8070022b6f9e82484f43ae28c2ac89318da38988569d57e35b7f39b89",
      "text": "哇，设计好帅气啊♪\n跟阿斯兰好配哦～！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_b:cmd-000195:dialogue:000": {
      "source_hash": "sha256:d6f7e49d4164b65b6bdcde2787d335edffec41e5ab79fc155424b98599f388cf",
      "text": "……咦？",
      "status": "draft"
    }
  }
}
