  "entries": {
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000010:title:001": {
      "source_hash": "sha256:a93c5b3ecd7bb95e3c69a36f0b61aa950a1727bb2a35832bdbe2dbe4a5204af6",
      "text": "冰淇淋广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:6d47188efaf39b25f6fb5cd07851eb6e5ca4c47ed9b38574126a9075b178dfd3",
      "text": "夏来先生，马上就要开始拍摄了，\n准备好了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f335c67b8b881492f0c2186540cfe34dd76f24c458998f7d022b333b3055e636",
      "text": "……嗯。台词，好好记住了。\n准备也做好了……不过……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:0274ad9f8c2725023c51fce9617439f5467d3b8b5a4e49da70caa9554804836e",
      "text": "吃冰淇淋的时候，能不能做出好的反应呢……\n必须得……露出很好吃的表情才行吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:83d3be3e9e04e83972f42f75ec5df3703412ccfd3e0a03410fb3f3116acddcd9",
      "text": "是这样呢。不过，刚才试吃的时候，\n我看您吃得挺香的哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:6abc2116e0b21be513e0714ce34521633e4fc4da09fbf3bcfb24f0382e17db8d",
      "text": "不用刻意做反应，\n只要表现出夏来先生最真实的心情就可以了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:4187f5ae5118e7d960e0a4186a12f8a04f16676c5a25880ef9ea2a4db932e0e2",
      "text": "我最真实的，心情……明白了。\n我试试看。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000048:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000054:dialogue:000": {
      "source_hash": "sha256:3b9590e570346762c8127cc443829f2b2610c840145a536a6f4e4c0f614ab256",
      "text": "呼……●●●●プロデューサー，\n感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000057:dialogue:000": {
      "source_hash": "sha256:fc0f3b829b001a7c47a8221d913bdcfcee2ad20348b41ff02f8642e0dcc4897b",
      "text": "看起来吃得非常美味呢。\n夏来先生的心情好好地传达出来了哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000062:dialogue:000": {
      "source_hash": "sha256:7ade94f9daccbd0cfc584598d5cdbd26f0789aa305bae95eede47638b6b67d41",
      "text": "这样啊……太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000067:dialogue:000": {
      "source_hash": "sha256:18946c9a5fdf697bda9ab3584e62035318f0659843ee06617106ac51b8ae64ba",
      "text": "多亏了●●●●プロデューサー的\n建议呢……谢谢你。",
      "status": "draft"
    }
  }
}
