{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_02_a",
  "source_raw_hash": "sha256:9499408360e90444446ed2c2c80f162c2cb655e1f049636a4875838b0489639c",
  "entries": {
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:4da4aea3735c213df11b476365135b12a9651038d8060d48d716a04d110d8557",
      "text": "我们是偶像！？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:e6c1167735aa7c72020846d1558c16a1c8208d3202ad578b23b36654d5900b38",
      "text": "出现在朱雀与玄武面前的，是前几天救助过的\n人物，同时也是偶像事务所的制作人。\n被对方提出“希望你们能参加成为偶像的\n试镜”后，朱雀与玄武给出的答案是……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000014:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000014:title:001": {
      "source_hash": "sha256:4da4aea3735c213df11b476365135b12a9651038d8060d48d716a04d110d8557",
      "text": "我们是偶像！？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:0f58d770a877612f38f64f25769bb4f93d48521c706d76fef99998bbf664ca6c",
      "text": "新出的松饼超——好吃的啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:4b588e682ea9bee87d8789d9b57ca58a684c19e8d5f5e38cd4abcc3cd70e5821",
      "text": "嘿嘿，玄武，\n今天能陪我来，谢啦！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:6e9886c576b3abd93038b7969ad3684176bc328773d776fa068e9c5d8170e9c5",
      "text": "偶尔来一次也不错。不过还挺意外的。\n那帮家伙居然会知道那种店。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:c4baedb70811368b2ca25174ee789c2beb3508e6b31e165b7a913dec1cade5bb",
      "text": "是啊，被找茬的时候，\n我还以为会变成什么样呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:7aa9d9ef78c35e61c4497fd434523cb922bcb5ae01552ca91bfddccf2c55a3e2",
      "text": "真没想到他们居然是那么好心肠的家伙！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:66dce47fd87e7d15423ae05dd3be641e79ab0a2f377b669a5cadc8447647fb37",
      "text": "虽然嘴上说着助人为乐很无聊，\n但半路开始就主动上前搭话了嘛。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f8c0de221a8eb24b5680e835cca8e32201b4a74fce67375ff321f95d5a027dbe",
      "text": "而且后来聊起松饼的话题还挺投缘……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000052:dialogue:000": {
      "source_hash": "sha256:ff080c1a9e2d924ddfbe1b6c4e95a9be279c31243bdad08428eb50abae61ca57",
      "text": "没打成架，\n就像画里一样圆满收场了呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:6cfda1b82912495b3b0778c4e1827deecb606f05603c3a247acb9df21a14e040",
      "text": "大汤圆？\n虽然搞不太懂，但真的是太好啦！",
      "status": "draft"
    }
  }
}
