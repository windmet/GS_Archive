{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_08_i",
  "source_raw_hash": "sha256:2d6ef78177ee9491c50846307bd95393888dd4e7e64de98ddbf62cbb4a0bab31",
  "entries": {
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000020:time_caption:000": {
      "source_hash": "sha256:e3f592b7f0f3798aafdd8ead76a3b834cda6c08a1cfb38b55273a1ec2a16d1ca",
      "text": "“力量微笑LIVE”开始……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000038:dialogue:000": {
      "source_hash": "sha256:0d677f746216d99609e9650834829a3491d7c7e9bcd8a53b2f558d351301727b",
      "text": "感谢大家今天来到\n“力量微笑LIVE”现场！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000050:dialogue:000": {
      "source_hash": "sha256:7b9ade739255139b12a9e768410f18c5fe822250923f4871149238ccc5a3abc4",
      "text": "跟上我们的力量吧！\n然后，展现出你们最棒的笑容！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000061:dialogue:000": {
      "source_hash": "sha256:fe121938462c3ccf12b75de99f3fecbf9233c87b42b429a80550ad3860e66b03",
      "text": "来吧，嗨起来！\n全场的大家也一起喊出声来吧！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000087:time_caption:000": {
      "source_hash": "sha256:00f0e92f217f01dba89d0ea4719b7028cb261b452bfd173bc21008220bdd6c26",
      "text": "LIVE结束后……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000103:dialogue:000": {
      "source_hash": "sha256:aa89160c150346fc4bc879a3e81350f3ea91316435f79a68264ac01751e24e05",
      "text": "LIVE辛苦了！每个组合都是\n充满力量的热烈舞台啊！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000109:dialogue:000": {
      "source_hash": "sha256:2db5545777f47fc2afe5e82f67c1783a9fae432cc623f6fa78109c669f5f7282",
      "text": "多亏了FRAME提议哪怕只办舞台演出也好，\n才有了现在的成果。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000120:dialogue:000": {
      "source_hash": "sha256:47cb04d65a41863bb05d8aef23e0443b06bd06058cb37dfd56670c0d786f9c19",
      "text": "哈哈，LIVE能成功，\n是因为有大家的力量在，对吧？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000128:dialogue:000": {
      "source_hash": "sha256:b4509ba1ae399ba845344686216ece33c27f79afa23dff33b95da46c15f03a84",
      "text": "不如说，如果不是这批成员，\n恐怕会很难办到呢……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000137:dialogue:000": {
      "source_hash": "sha256:d42d98eacd5a91419c5815098982279532ae39ca5b2025d1176ca1be08f28ba4",
      "text": "是啊，大家的力量和坚韧真让人佩服。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000144:dialogue:000": {
      "source_hash": "sha256:7067f4c383616a9c948b8e00556eedabd809d85d066731b72506f878556d83db",
      "text": "搭建舞台的时候，看着大家，\n我心里好几次冒出了“不能认输！”的念头呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000149:dialogue:000": {
      "source_hash": "sha256:a14c4f8946b08e0ba2d9a759766bdf74f1db40d5bad20a2989b00ab734472366",
      "text": "明明是在演出之后，\n收拾整理也是转眼间就搞定了……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000158:dialogue:000": {
      "source_hash": "sha256:4bc1f897d4740cbc55c1e9264c990f3a0b77abe68ea47a6bd952f1967a243392",
      "text": "我们这边对FRAME也是这么想的哦！\n你们三个人，身心都太坚韧了！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000163:dialogue:000": {
      "source_hash": "sha256:bcf0a240cdb3e7ed6e60e48e0a9a97894154f15e5ecaeb87eb0846e128dee682",
      "text": "哎呀，谢谢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000168:dialogue:000": {
      "source_hash": "sha256:bd73f8ce0ebd9e85ad2f86cece73856b2fcb22292af010d65f604b0623ee428f",
      "text": "感觉，有点不好意思啊……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000171:dialogue:000": {
      "source_hash": "sha256:b8033b6a1126eafdb99f29cb114d218e75bd268309dd29d698758be8d9f7cb09",
      "text": "就是呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000186:dialogue:000": {
      "source_hash": "sha256:b8d5af4d2c328f54c00fb87192a8cf2670318823dbb6a7394539b73ccdcf269b",
      "text": "哈哈哈……！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000200:time_caption:000": {
      "source_hash": "sha256:de032b14ad770092a08e64ee0b7359b1bdf150548e5d96e8eacb1487cc8ae481",
      "text": "翌日……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000207:mobile_message:000": {
      "source_hash": "sha256:e29224e1791fa4180f1530c448278ea1ff66f7202fd77ace16fd7d0672c231f5",
      "text": "英雄先生，\n迟迟没有过来呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000209:mobile_message:000": {
      "source_hash": "sha256:f201dcf1837804acc615e2019a601b7e4e2ab5a4cdb0405c238a2b2b9cf5102a",
      "text": "虽然距离回去的大巴发车\n还有时间",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000211:mobile_message:000": {
      "source_hash": "sha256:0f3c80cc61554018e20fde978f1fa70ae9624ef8a16d05df72036747c138976a",
      "text": "英雄，你现在在哪里？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000213:mobile_message:000": {
      "source_hash": "sha256:6cf4345820bf30f518693523cfa07d4bcd74ae32ef7394dbba159dc7f1de6abd",
      "text": "在酒店的走廊。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000215:mobile_message:000": {
      "source_hash": "sha256:77dbba3bd4f57da6c2cfd572058f1835e8e5d69630cf8d1e478910dc0d1db918",
      "text": "肌肉酸痛得动作比平时\n慢了3倍啊。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000217:mobile_message:000": {
      "source_hash": "sha256:7f700e20a5c41984b1ea33a616423882a04314dddb359fec362a7d565f13ca58",
      "text": "马上就到大巴了\n等我一下。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000219:choice_short:000": {
      "source_hash": "sha256:628b01ab78ba45bed1d98de1bed34a8d0af64929385fda65e0de17eae9c4ecc9",
      "text": "要去接您吗",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000219:choice_detail:000": {
      "source_hash": "sha256:233ae98cde4954a8c75b665ff8c50450faf79ddbe7f41d6177e1afa9fe849d59",
      "text": "要去接您吗。\n在几楼的走廊呢？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000220:choice_short:000": {
      "source_hash": "sha256:fdd0681426b89d55a5500d272d6a4bff3c7a46548c99c3d5b550611557f7b343",
      "text": "有那么严重吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000220:choice_detail:000": {
      "source_hash": "sha256:8e41a70f0b6da6b44cf584edef5dcb8be5fe91a2ff1274ea1ea0d40506dca781",
      "text": "有那么严重吗？\n直到收拾完之前\n看着都还挺好的。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000224:mobile_message:000": {
      "source_hash": "sha256:9f1d8b1cb516c73b4aa3b867ff00ccd87533868f25e67efcfe63f4e879b53056",
      "text": "没想到居然严重到\n动弹不得的地步啊。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000226:mobile_message:000": {
      "source_hash": "sha256:ce18308c8d6850ae38adbeb65b3f197514c86a6674fd09c5b7a9be7d16d06eea",
      "text": "制作人\n在车里等着就好。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000228:mobile_message:000": {
      "source_hash": "sha256:893f5fc2dd3af737eaa49f879eee533dc3ea7428632271775970935aef38d4f8",
      "text": "我们去把英雄先生\n接回来！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_08:1_4_002_08_i:cmd-000230:mobile_message:000": {
      "source_hash": "sha256:a3feceda89828aa25433e58b120e190325e0f10e3523edc3f65f6dfa5d36b47b",
      "text": "现在去回收你。\n英雄你在那里\n待命吧。",
      "status": "draft"
    }
  }
}
