{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_016sei_1_5_016_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000010:title:001": {
      "source_hash": "sha256:b41b5031d5bf69b37916ebdac45a53b48285c65bbcf422502d14ce1e88456a1b",
      "text": "洗衣液广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:b524a52acd89228ab4b86a2efa35ca7582aa5b7e859cded62d0e7b0c0532ec9c",
      "text": "广告拍摄，真让人期待啊。\n这款洗衣液我自己平时也在用呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:939888b78b3ee0ea1b294fd164e1f0c0482f9af6a971003d60e6742933b518ce",
      "text": "刚才开会的时候您也是这么说的呢。\n真是吓了一跳！",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:31f4d1a320f56154bd45a1452534c6f704fad388f048f3951611ac8787c853ef",
      "text": "我接到这个工作的时候也吃了一惊。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:7ba3a8a4e3b5b49515f9b776d49e9a7fa85085192be8349a9e5fe8b7465ec568",
      "text": "我本来对用的东西没什么讲究，\n是雨音觉得适合我，帮我挑的。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000031:dialogue:000": {
      "source_hash": "sha256:3e16ee90d5c9af52138ef34f26a8d3bf12cbef6bd993474593d871b229f627f0",
      "text": "试着用了一下发现挺中意的，从那之后就一直\n在用了。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:926b725ffedda4030cf9a369b2afb5d34d4aa1b0e30bfc351f1760ea7ca4f40d",
      "text": "正因为平时就在用，所以很清楚它的优点，\n我想努力在广告里把这些优点传达出去。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:3002b008451e2b5e537825e073474a8eb6cb7e9699e10dc3029298a1564a686c",
      "text": "为了帮我带来这份工作的●●●●プロデューサー，\n也得交出一份优秀的作品才行。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:1b3aa05d75cc858bda74c4139761d3054482ba2ce4986b76a24165defcc9b959",
      "text": "我一定会回应你的期待，好好期待着吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000043:dialogue:000": {
      "source_hash": "sha256:af78e6406206cae72f88b0c71910dddf6e6af6de7eed6ab2b3a2397e80661f82",
      "text": "好的，那就拜托您了！",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_04:1_5_016_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:ff45cdfb721aeb958373809907f296b9822fc0f3574d5012915a5605510e3b02",
      "text": "（诚司先生出演的广告反响热烈，\n该商品的销量大幅上涨！）",
      "status": "draft"
    }
  }
}
