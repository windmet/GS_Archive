{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "001tom_402_2_4_001_02_09_b",
  "source_raw_hash": "sha256:bd400566d59d7a41b039a6067ed2aa0b19ce8728c17d4f9ba2c09dddb154dd15",
  "entries": {
    "story-text:v1:001tom_402_2_4_001_02_09_b:2_4_001_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:c54c2b8118478d7e6783fa2709cf37aa64ab1ccb700da9c3dee742f6fb851107",
      "text": "制作人，\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:001tom_402_2_4_001_02_09_b:2_4_001_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:712dd8c30bbe3fbe784ba1a196a14383027f367b73c2d3fd9b4cd5b462fdd984",
      "text": "走在T台上的我，很有型吧？\n目不转睛地看着我了吗？",
      "status": "draft"
    },
    "story-text:v1:001tom_402_2_4_001_02_09_b:2_4_001_02_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:5a7b8b55a17b70caecaaca3b8d757fb46c1777eb75b4488472d4b967f2d448c7",
      "text": "是的！\n非常帅气！",
      "status": "draft"
    },
    "story-text:v1:001tom_402_2_4_001_02_09_b:2_4_001_02_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:b5becb0c54119348ebf4b59fc4942963afcef5b083f19688bfd2d899a70ce8e0",
      "text": "是吧？努力练习台步总算没有\n白费。也得感谢北斗和翔太啊。",
      "status": "draft"
    },
    "story-text:v1:001tom_402_2_4_001_02_09_b:2_4_001_02_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:7f5462f79b7c52d0b11916ac7aec4dcc82e5bc9314e00ece4aa68a2d444fa77b",
      "text": "下一个工作现场我也会让你看到很多我的\n优点，你就好好期待吧。",
      "status": "draft"
    },
    "story-text:v1:001tom_402_2_4_001_02_09_b:2_4_001_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:08ce0b6ae0acaf0d2119b3cb5f6edd29e997472c9dbc4d0b606cdbee3778719e",
      "text": "那就待会儿见啦。\n工作可别太勉强自己哦！",
      "status": "draft"
    }
  }
}
