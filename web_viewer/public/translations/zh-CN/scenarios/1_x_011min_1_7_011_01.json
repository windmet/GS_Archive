{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_011min_1_7_011_01",
  "source_raw_hash": "sha256:cc15efa2c6313f41433d3751bc291f1d6e4fa9fe9c821a2fc52cf9cdeae3ff14",
  "entries": {
    "story-text:v1:1_x_011min_1_7_011_01:1_7_011_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:fd6ea1dd8aef317f44608780c0f1176294f7a9a73cdb941ab73278e36f1dfa7a",
      "text": "实先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_011min_1_7_011_01:1_7_011_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:46846c64267fbddff3e0928d90603fb265dc0e9c9975921f8f613680cd47e11a",
      "text": "谢谢你，●●●●プロデューサー。\n原来你还记着啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_011min_1_7_011_01:1_7_011_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:f8c1777f9fb570e63afedf89c24136a1b592985caf1fe186cfa67c53c70c6afb",
      "text": "呵呵，能得到●●●●プロデューサー的祝福，\n真让人开心呀。",
      "status": "draft"
    },
    "story-text:v1:1_x_011min_1_7_011_01:1_7_011_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:97f1a4f6bc33645f64d6d05abea01b4dc6af841f058dbb266b219703c870e743",
      "text": "今后作为偶像，\n我也想继续带给大家幸福呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_011min_1_7_011_01:1_7_011_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:bfdebcf9bcd53a0dc23b2f554e68013ced4971cbc81e106e57c11de36e5ca196",
      "text": "为此，今天的生日练习\n我也要好好加油才行。",
      "status": "draft"
    }
  }
}
