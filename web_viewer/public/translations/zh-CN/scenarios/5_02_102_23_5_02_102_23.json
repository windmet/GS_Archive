{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_102_23_5_02_102_23",
  "source_raw_hash": "sha256:5f2585f3e7fdcdf069814294b51f724e8124fd3eac7e93f7c7b1edc7868e6b1e",
  "entries": {
    "story-text:v1:5_02_102_23_5_02_102_23:5_02_102_23:cmd-000008:dialogue:000": {
      "source_hash": "sha256:f4e5ec7fbc0896557daf4f301989615bf46811fffc33b46574f224ffb437fb43",
      "text": "●●●●プロデューサー君！我也为你，\n准备了白色情人节的礼物。",
      "status": "draft"
    },
    "story-text:v1:5_02_102_23_5_02_102_23:5_02_102_23:cmd-000011:dialogue:000": {
      "source_hash": "sha256:d2f8af4f272ba1e0e3e4bf68bcf9f0d0acde83ceddffc9c941a50897f4dfc26b",
      "text": "这是回应你在情人节奉上的热情的\n绝妙一品。给我收下吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_102_23_5_02_102_23:5_02_102_23:cmd-000013:dialogue:000": {
      "source_hash": "sha256:efe4aa600a050a24b8e428feaa0b065bf057c7ec65b14bf9b7ed313d7fd57102",
      "text": "对于制作人君的辛勤付出，\n我时刻都满怀感激哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_102_23_5_02_102_23:5_02_102_23:cmd-000015:dialogue:000": {
      "source_hash": "sha256:cfc703756aad90113f312542010ae752a67cef2428f1f044114362f2716fee02",
      "text": "托你的福，这一年里，315 Production得以\n进一步向前迈进！",
      "status": "draft"
    },
    "story-text:v1:5_02_102_23_5_02_102_23:5_02_102_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:4e666386f5ccfecd26a75fb16a51f6ece8d86842468f59cdb8bad5d7290f2e9b",
      "text": "今后也为了能让他们燃尽热情璀璨闪耀，\n好好加油干吧！",
      "status": "draft"
    }
  }
}
