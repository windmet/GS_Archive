{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_401_2_4_043_01_09_a",
  "source_raw_hash": "sha256:18414ab97ddfaecc52e181366b3e8c611f67bb04ebc9fd107f268cd7d4b6fa84",
  "entries": {
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:89cbee43838840ff0ec6b081d5668f17399ce459758038b1724ac504d7acd2e2",
      "text": "……●●●●プロデューサー，\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:8b895cc39a1b471e99dd809b9fcd3e807008d557afa92797bc65a92d5288bcfc",
      "text": "……苹果派博览会\n能顺利成功，真是太好了。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:2709a60c8fc7a7a34832db5e296539eb112e8caf4722b523ec832527219537ea",
      "text": "……我们是否也算\n锦上添花了呢。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然了！",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:32d42bdb0c21f3a88fb9936c175a039f4916cd2d61e868fa3e55d7295494bc56",
      "text": "能够成功多亏了一希先生你们哦",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:183ce8315cf5ac8738457cb8bcf2ab4f5bf092e66cc589ae20b18b5f16357e17",
      "text": "……谢谢。\n……听你这么说，我就安心了。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:0af1652c04eecebfa4254d491c1fe09647a900ebef76e3aa1b285856fd351e1f",
      "text": "……●●●●プロデューサー，\n也谢谢你一直给予我们帮助。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:0cd1739165b41a61d443ff877643c7c5df5e2d40067a7bf0006f92943271403c",
      "text": "……如果说这次活动的成功\n有我们的功劳，",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:549e7f19e0847c6518c2036b20f1f17540c781ebd91b6481963139d29a88b9da",
      "text": "……那么促成这一切的最大助力，毫无疑问\n就是制作人你。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:202126f1d044b050905cebdcf9cc34dfe2729702deaa348f59abfc7f7543f0dd",
      "text": "……我很感谢你。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_a:2_4_043_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:786414837dfe4156adef1020e236e8db9adcc812da6769ae0550089712715f54",
      "text": "……那么，我很期待明天\n在事务所和你相见。",
      "status": "draft"
    }
  }
}
