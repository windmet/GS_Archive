  "entries": {
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000011:title:001": {
      "source_hash": "sha256:169614defba9b1840428cb683e7d2e4ed3cf7348bcbb1a4389c52d2799638bc0",
      "text": "出演儿童童话朗读剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:11c02f605d4ea60c97e1a69fbdba6875c75ae9012ab5d608b50a48b6b0fb7cf3",
      "text": "直央君，前几天提到的朗读剧台本\n送过来了。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:79d7d75cd3371ef3640ee99f0f28976c15def642530e5c5bf0264e1ee3b38290",
      "text": "谢谢您，我来看看。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:edad8240a423e8d052e7d1a0faa3d54f8583e87848294e8ace2388461d117ac7",
      "text": "呼。●●●●プロデューサー，\n让您久等了。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8718de1925865ef2d0c6e74d45f7368ace602f8b42d72be735ce6db835bd3326",
      "text": "改编了著名的童话，\n非常有意思。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000044:dialogue:000": {
      "source_hash": "sha256:f417f78e969e358d8490056471edeb3a9e9fb0fcc3ea979b3b5e95bd50a19c69",
      "text": "接下来要在好多观众面前\n表演这个故事啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:322923fb17c18309f72bfe9ef11c33f21fb272caab0c1d1ec4dfc63141a37a0f",
      "text": "感到紧张了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:3eeb2dbfc187e982ae6350b342cf6cae671f44920ff4efaeeee913fd0acfd7b9",
      "text": "是……这样的呢。\n要是说不紧张那就是在撒谎了。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000055:dialogue:000": {
      "source_hash": "sha256:f58e36defac18869a5529f3dcedf6358d71450d9fc596a0981ddf217b1fbbdc5",
      "text": "不过期待的心情更多一些。\n那个，我想马上开始练习……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000058:dialogue:000": {
      "source_hash": "sha256:c1698fd25bb950b7f72d689b2f072b9f23e68c49820437d245826db74b838c57",
      "text": "可以用这个房间哦。如果需要\n有人陪你对词，别客气，尽管开口。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_01:1_5_032_01:cmd-000063:dialogue:000": {
      "source_hash": "sha256:6593d98e0422ff222d6fa6f76afe331c9b863c4c7faa56b4a68232f7721ec990",
      "text": "好的！非常感谢。",
      "status": "draft"
    }
  }
}
