{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_040_23_5_02_040_23",
  "source_raw_hash": "sha256:cef152022909c9cffb5c25e4cb6273a7f2e043cdba328f1ec16c21b04aec1335",
  "entries": {
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000023:dialogue:000": {
      "source_hash": "sha256:9e328074e7fcd40657ce4be4208feee503094ef299eff7fc74d8e0d47d06dbd1",
      "text": "啧……太慢了。\n你跑哪儿去了！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:4cea0d70c8ab3f7dec4aaf3dd89f60d3c83d6c9e18d00bf3f47ef423d426c022",
      "text": "因为工作在外面稍微处理了一下……\n难道是有什么事吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000033:dialogue:000": {
      "source_hash": "sha256:4f413832743973364bd071724a23180a7b30a6e46c4c538b34f6c721f608580c",
      "text": "哈啊？\n怎么可能有啊，大白痴！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:f6b520ce563d532cdb5d54e85eb04325c079347764d09804997db62421423b38",
      "text": "没办法，\n我也只是办事时顺路过来罢了。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000045:dialogue:000": {
      "source_hash": "sha256:7857b2211150bf7dfefddc06628fdb585320968dffe268c2beb50aae225d8412",
      "text": "拿去，快点收下。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000050:dialogue:000": {
      "source_hash": "sha256:d5133b71cbf015a97aaf90f58ebbb0bd8b7c5cb51beae763cd1ad0cc034c209a",
      "text": "（这是……皱巴巴的纸……？）",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:a133c85571e0457e2bd1307f7996907379227aa92b3c80ed4bf28c2e53b9b809",
      "text": "什么白色情人节不情人节的，我才不知道。\n还不是拉面店那家伙老在嚷嚷着回礼，烦死了。",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000062:dialogue:000": {
      "source_hash": "sha256:26b26b1105432c578b107c80cc049addc0c350d9d59cc0ff7380f1306c5b7a12",
      "text": "这可是本大爷特意准备的。\n给我感恩戴德吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000064:dialogue:000": {
      "source_hash": "sha256:0ab9e42c6ff4f19e0ada4a502c0067153791d76bca60b51af2a4559208cfb15c",
      "text": "特意为我准备实在不好意思。\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_040_23_5_02_040_23:5_02_040_23:cmd-000069:dialogue:000": {
      "source_hash": "sha256:7522aef52d45ef1f3690156a95079ccfda93502121b894813a2fe87a63bb1b91",
      "text": "哼。",
      "status": "draft"
    }
  }
}
