  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_013kys_1_8_013_01:1_8_013_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:0a935e77ad7847a94c4e6bb14564635eca63d5935c75fc6c2c1b5a7af88a0ae6",
      "text": "●●●●●●●●●●监督，\n祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_8_013_01:1_8_013_01:cmd-000015:choice_short:000": {
      "source_hash": "sha256:fcddcb69aab69828a355b283610d3f2d9618250647eabc4c9b222b1a9b1252e3",
      "text": "和悠介先生同一时间\n发来的呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_8_013_01:1_8_013_01:cmd-000017:mobile_message:000": {
      "source_hash": "sha256:0fb1943e08d32b06cb1cbe44b5501fc17e70060279bee182c76db6a17540ecbd",
      "text": "嘿嘿，吓了一跳吧？\n我和悠介商量好\n要同一时间发出来的♪",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_8_013_01:1_8_013_01:cmd-000019:mobile_message:000": {
      "source_hash": "sha256:734090d0e36e0b3120307a1eec74067ccfbd5f66f05dc5251b8767f34de2691a",
      "text": "虽然打电话也行，\n但没法同时通话嘛。",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_8_013_01:1_8_013_01:cmd-000021:mobile_message:000": {
      "source_hash": "sha256:5a24b9220b27f7d65911fec2e6584c86c8f4b679cec710dbd0428675011a2b0c",
      "text": "等到了事务所再好好给你庆祝。\n那就回见啦！",
      "status": "draft"
    }
  }
}
