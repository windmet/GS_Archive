  "scenario_id": "1_5_029ass_1_5_029_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000010:title:001": {
      "source_hash": "sha256:1ca3a49258dd49a71b1b370fb9273db6066b57242966cc3c63b1e6eb4fcc9454",
      "text": "单集电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:d0cce9937a5a895a4c26129a5507dbc5b2b818dc4a29b9023aea5e4ba5bd3774",
      "text": "“……啊，在暴风雨平息、小船驶来之前，\n我们都没法离开这里”",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:d0c3ffe3ec9a4afff450db9d454a31e52cd34e6b61f676a4666214917b3f74eb",
      "text": "“照这样下去，在只剩下最后一个人之前，\n杀戮恐怕还会继续吧”",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:a455b8de383e2370f62cfb465c6439f024e790a2321857a7c5192ec431d26e90",
      "text": "“不过放心吧，我一定会找出凶手的。\n毕竟这世上就没有我破不了的案件”",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:be92db2d4f137e5edb1bc6c9bdc6f2d4748591584e24c24e4f678d7ddc7da30b",
      "text": "阿斯兰先生，辛苦了。\n感情非常充沛，演得太好了！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:9b31a682ffe5f57d9808fdbb79629727621f34faa43b62daa031bc950b24db20",
      "text": "我都不由自主地看入迷了。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000043:dialogue:000": {
      "source_hash": "sha256:73e318a3503f386e121a516b6a2177137569da7f55a0e7ba48673a5ff08ff2b7",
      "text": "库库库，对本座而言这乃是理所当然之事。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000049:dialogue:000": {
      "source_hash": "sha256:cf94623f1301eec41d19a12effa3bd9505c780b023e2ea092459659e024e1ccc",
      "text": "不过，若是由本座来，在时机成熟之前，\n还能获得更为强大的力量。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000053:dialogue:000": {
      "source_hash": "sha256:219f4630323608f1c4e721e1c9d68a8b342617fe06a9fc3d1495f79aad64156b",
      "text": "吾主啊。\n可愿陪本座修炼一番？",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000058:dialogue:000": {
      "source_hash": "sha256:202fc6e86b11fd1818676f6d94dc40eb89fd64dc52592f445e2e050edf14745b",
      "text": "当然可以！\n一起加油吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_03:1_5_029_03:cmd-000063:dialogue:000": {
      "source_hash": "sha256:7533943ec4198cfe18228f2c4659cfed5012738a7f7cf636be0fb9f1259e8e0f",
      "text": "善！当吾等之力交汇之时，\n必将虚构之世染上一片漆黑！",
      "status": "draft"
    }
  }
}
