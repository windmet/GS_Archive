{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_043kaz_2_1_8_043_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_043kaz_2_1_8_043_02:1_8_043_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:5d608e4413e7c6ad854fbd7f03e8dade4647895c7c32edcb6c3adca12eb3a824",
      "text": "……●●●●プロデューサー，辛苦了。\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_2_1_8_043_02:1_8_043_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:5a3888dcf902cd0e7d4f1fc9c4bc4b0937453863f8d8fe47a2db4d8237b30858",
      "text": "……其实，我稍微想了一阵子\n究竟该对你说些什么话才好……",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_2_1_8_043_02:1_8_043_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:246c640f5a52dc13ddfcadfa2f99a3658e32fa13b7d736f111a0880514b5eda3",
      "text": "……但我想，还是直率坦诚的话语\n更能传达我的心情吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_2_1_8_043_02:1_8_043_02:cmd-000020:choice_short:000": {
      "source_hash": "sha256:bd2b043d52434c5ec3e1b053ea9b2ecf4fd7da60dd20e0c0ec4976559bb42445",
      "text": "好好地\n传达到了",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_2_1_8_043_02:1_8_043_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:248fc50348b7cd790f666f95c5bce13f56fac75f06fca2c595874d9fddcf9255",
      "text": "……传达到了就好。愿你度过幸福的一天。",
      "status": "draft"
    }
  }
}
