{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_031sak_2_1_8_031_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_031sak_2_1_8_031_02:1_8_031_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:b5b8238d7fe1942fc19efa5373b73e6429beefd56852196c0f0b99f15838ab9f",
      "text": "啊，在这呢！●●●●プロデューサー！\n祝你生日快～乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_2_1_8_031_02:1_8_031_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:173ea88ecd5673ecdf399f152c78158c765d99156b95d1a46b7bb6224c3e9d7d",
      "text": "非常感谢！能收到充满活力的祝福，\n感觉整个人都打起精神了！",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_2_1_8_031_02:1_8_031_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:6b8ed887f9e4dfef7bc2f208fa254ebba5d7b633940ba98f8cee8467c80c9335",
      "text": "诶嘿嘿，看到制作人开心的笑脸，\n我自己才变得更加有精神了呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_2_1_8_031_02:1_8_031_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:d5d23dd9d9493c8fc8e877b9df316e5ba931f54fcf99c1abb58923541dcdf832",
      "text": "好——嘞，既然收到了满满的元气，接下来的工作\n我也要带着笑容全力加油啦！",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_2_1_8_031_02:1_8_031_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:ab0e2c160c9869aa60570bc3a2c6ead216d2c98d1a787c36795133b859fa18e4",
      "text": "等工作结束了，大家会准备好多节目\n好好招待你的，敬请期待吧！",
      "status": "draft"
    }
  }
}
