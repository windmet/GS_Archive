    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000010:title:001": {
      "source_hash": "sha256:94444c56327ff6250188b8c45ebccae6b2e0952fb5375a4c1bd518051f33f65f",
      "text": "音乐剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:50848647cd0716050baf97a24d9b23c66f1f4dddc26c9e651fa776995fb25a2d",
      "text": "Hmm……",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:2e924ad53ca563a8b410fc400ab333928b06d6de82f26e4c1ba9e500cbc793ab",
      "text": "类先生，辛苦了。\n那本是……下次要出演的音乐剧台本吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:47780bde9244841bb447714868cd92ea72f1eeab95899ac62a1d665d2172cfb6",
      "text": "Of course！",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:ee39fa79baf1236d1833c69fcfa85851281a112387669cd641e402be7b8f0c4b",
      "text": "致敬了著名作品，\n是个很有趣的story呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:1aa6725750165e6d4831b49e928edfdf40847a183ae5b71329a8c3cd36f0e64f",
      "text": "是的，我也读过台本了。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:12852b21295af28bdfaac9b09fffbad57acb3beae52d8cf7b83ddf38f45d810a",
      "text": "担任了一群难缠小鬼的家庭教师，\n非常有个性的主角。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:ff02eed926981c7e834bf252756e50296d54eb36752d847071b21600b521c3b7",
      "text": "讲述了这样的主角和孩子们一起生活，\n并教会他们宝贵道理的故事呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:1ffdd9cd54a65eb9e9a451c2c6e92bced4bad6ae3deaa75b64dcec9d55020c37",
      "text": "Original虽然带着一丝感伤，不过这次的\n音乐剧是一部heartful comedy呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000047:dialogue:000": {
      "source_hash": "sha256:beba094dd06830767c9374bef3cc3667c09e215523c92443e8c18ca02544faa6",
      "text": "好想快点演演看啊！\n呐，练习室现在空着吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_036rui_1_5_036_02:1_5_036_02:cmd-000051:dialogue:000": {
      "source_hash": "sha256:4d1aefbbf32fda0d84ce02e163e8f11390cc86c4e56e7490be28a33a187048e2",
      "text": "我记得应该是空着的……\n我这就去确认一下！",
      "status": "draft"
    }
  }
}
