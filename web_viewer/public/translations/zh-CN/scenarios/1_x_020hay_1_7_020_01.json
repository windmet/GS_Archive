{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_020hay_1_7_020_01",
  "source_raw_hash": "sha256:0b898764db2924555daf9f4770b770872b089062ced1b2173e43d229179fd89e",
  "entries": {
    "story-text:v1:1_x_020hay_1_7_020_01:1_7_020_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:e228b863c30392547874100fdd623f9346827a0abfefd947bdfc6a16c025e26b",
      "text": "●●●●プロデューサー不知道还记不记得……\n不，但是人那么多，可能记不得了吧……",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_7_020_01:1_7_020_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:728b88cae6f330a7e32427b8c8942b4d90c7c20894f04ed8247db5a20a17ca76",
      "text": "隼人先生，辛苦了。\n今天也是您的生日吧？祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_7_020_01:1_7_020_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:58cb874dd4fb593c069f18d1fee98681ea441ff44f674dcb8f60ab5ccaa0d165",
      "text": "哎！？谢、谢谢你！\n●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_7_020_01:1_7_020_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:01c3271f364494e71224880f317cad3a7ec7cb24def9baf01faafdaa7d5da40e",
      "text": "你还记得我的生日啊。\n太开心啦……！",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_7_020_01:1_7_020_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:6c6ffe450a0720edf7357c9ba111577c26cc820c590b1e46ed3892b981d08d9f",
      "text": "●●●●プロデューサー，真的太感谢你了！\n我今后也会继续全力加油的！",
      "status": "draft"
    }
  }
}
