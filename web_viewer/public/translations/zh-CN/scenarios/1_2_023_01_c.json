{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_023_01_c",
  "source_raw_hash": "sha256:8d3527ac83386f643d6e2c1774a18a354abea5da343e3b888c5674e26959bff3",
  "entries": {
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000010:time_caption:000": {
      "source_hash": "sha256:329b45cb19cd7f6739deff00854fb54bd88a0e9d3535b36296a3b735f599097a",
      "text": "十分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000019:dialogue:000": {
      "source_hash": "sha256:ee7d2c456472f5c1507b0508d45a162f37183bee4273984a9467eea832dd921e",
      "text": "太好了呢，春名先生。\n买到了慰劳品甜甜圈。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000025:dialogue:000": {
      "source_hash": "sha256:7beab32821ec8d90021abd8ee32231267a095961e4b4bf6998ca40f3529db89f",
      "text": "是啊！连新品甜甜圈也买到了，\n我也想早点吃到啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000033:dialogue:000": {
      "source_hash": "sha256:70e2eefea4f3409f0c2a6fc6bb917a29467cc05a231f5029ca7d438d3233f18c",
      "text": "嘿嘿，那边的两位！",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000037:dialogue:000": {
      "source_hash": "sha256:b936c17716900ca05e9fff1010b13ce365dc3dc0a9b8bc25e71adf0d6d38d009",
      "text": "手里拿着看起来挺好吃的玩意儿嘛。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000039:dialogue:000": {
      "source_hash": "sha256:78c89097f2d1760807ce8174345f87986c09535346825e5e1ac0c23765829ff9",
      "text": "那个……请问你们是哪位？",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:d47343b7007ce6f5fe41d27f4e7892276ec06d07946ef8f0a58102c8cbe065ef",
      "text": "管他是谁呢！比起这个，那盒子里装的东西，\n让给我们怎么样啊？可以吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000047:dialogue:000": {
      "source_hash": "sha256:9546c308b958fea8dcc9af9e29cb0d1ff6090a5cded98ed3cf01aefe734d6fbc",
      "text": "（这种时候……作为制作人\n我必须保护好春名先生！）",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000055:dialogue:000": {
      "source_hash": "sha256:95a45f0c80ef6cd6fc159bb6cdea3c1cfc6d613e754e2fa98dfe02720af81063",
      "text": "不好意思。\n我们有点赶时间……",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000066:dialogue:000": {
      "source_hash": "sha256:c6c506ba784b8383e4a1c4e9fa0f038a4a0aa246556bec66f43de5e0e74fa5a7",
      "text": "……退后，●●●●プロデューサー。\n我来当他们的对手。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000071:dialogue:000": {
      "source_hash": "sha256:da9ab45ff58aee40308112c57b7ec0f6b9fe427cd2c5d0b500b2cd183de8c002",
      "text": "不行的！\n春名先生要是受伤了就糟了。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000075:dialogue:000": {
      "source_hash": "sha256:97c6970f80da982c8a0da266615002cda23191929df01cc7ef9a16a7f58452fc",
      "text": "谢谢你担心我。\n不过，我没事的。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000078:dialogue:000": {
      "source_hash": "sha256:ba1bc766ff178da5b1431c1391769457237c1b41de37b77915448b5bf0fdc5a9",
      "text": "切，还在那逞强。\n说大话可是会让你后悔的！",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_c:cmd-000082:dialogue:000": {
      "source_hash": "sha256:8a2e2485521df05b4b114e7346037e6831deb2ce66bc6299da8d5c08bdbb55f5",
      "text": "这句话，原封不动奉还给你们！",
      "status": "draft"
    }
  }
}
