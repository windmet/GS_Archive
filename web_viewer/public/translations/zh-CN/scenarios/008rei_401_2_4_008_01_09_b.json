{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "008rei_401_2_4_008_01_09_b",
  "source_raw_hash": "sha256:5ed41faeba58ac3f1a05bdcfc0b820926f9d287eb49f0112e808010ab812522d",
  "entries": {
    "story-text:v1:008rei_401_2_4_008_01_09_b:2_4_008_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:4ae1cc3d54007627e005d46f1cda28a031defa3fb156c8ec0af64f8217a81d69",
      "text": "……喂喂？啊，是我。\n请问都筑先生在事务所吗？",
      "status": "draft"
    },
    "story-text:v1:008rei_401_2_4_008_01_09_b:2_4_008_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:b710489239cb1419efe41f3e18ade7f10644563350f05cce4d89da5dfac41d8e",
      "text": "本来约好了要聊聊庙会的事，但联系不上他。\n我想大概是手机没电了吧。",
      "status": "draft"
    },
    "story-text:v1:008rei_401_2_4_008_01_09_b:2_4_008_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:eae07fd7b955c7dd0d4e9ff53d17818a83862a7acc73fd4fb262cb1ca130a6dc",
      "text": "嗯，他在事务所哦",
      "status": "draft"
    },
    "story-text:v1:008rei_401_2_4_008_01_09_b:2_4_008_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:f52353356f304fd60dcf19a01e442081ef7fb5b68f019adb8b61ef8f125bf5b2",
      "text": "这样啊，谢谢。\n我马上过去。",
      "status": "draft"
    },
    "story-text:v1:008rei_401_2_4_008_01_09_b:2_4_008_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:c5b8389d3327bfe7bce3864763d2dcb157f2ef1b7ec5eea6303bea2c78a836f2",
      "text": "请帮我转告都筑先生我会按原定计划到达。\n那么，失陪了。",
      "status": "draft"
    }
  }
}
