  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000010:title:001": {
      "source_hash": "sha256:0498dae71c1f155ffc71cb6c090cb1c992e7de93461073625ef45fbff36265fd",
      "text": "报道主题公园的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:dc75037930e72aa95a3b90984cac8fbbc33b251022d9a67b8e058765e2bb954d",
      "text": "游乐园真的会让人超级兴奋呢。\n我要报道的就是那个游乐设施吗？看起来真好玩！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:69dd4cfc269e9adc397fb52507818d8abdf612a81d5198a4b4180cd095043855",
      "text": "……啊，不好意思。明明是来工作的我却玩得太嗨了。\n必须冷静下来才行呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:9100984fc3a3512e61ba2dcd74a71df65105f91e3fe58ae74e236cc23dcf7741",
      "text": "保持这样就可以了哦。这次的报道工作，\n需要的正是平时的凉先生呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:9ce78acdc815173d22c8e68fd49cbdabc4f2a29cea412acf53414838d2c0acd3",
      "text": "我明白了！为了能通过报道把这个游乐园的\n乐趣传达给大家，我会加油的！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:0aef54bb6a493b3b211b44a483da9bfec9c46247d97abbccc033639f9c0c0fec",
      "text": "请多关照。那我们马上动身，去拍\n刊登在节目网站上的花絮照吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:cf1065a6d29439994c6704fad291ec298e7e18c88dcfea145b8e74ddbdaa706f",
      "text": "好的。我特意去查了很帅气的姿势，\n就在入口处的纪念雕塑前摆……啊！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:38a1db4bde43332c1b6a6b5cd06079f04386451010f438ea294e15fa5a6d13bc",
      "text": "●●●●プロデューサー，\n有游乐园的吉祥物在那里哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:8382f1f80fd8cc0409c23adcc335fcdaf233c6efa8f8efa8b5260106a21d7b12",
      "text": "好可爱啊。……对了！\n第1张就选跟那个吉祥物合影吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000054:dialogue:000": {
      "source_hash": "sha256:1ec50e7d3635ab2e6b51086de1e1f5a394b0287f4d67984ffb916505824e40d8",
      "text": "不错呢。我们去拜托对方合影吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000060:dialogue:000": {
      "source_hash": "sha256:bf8f6dc32eb61ca45c7ab5737d2cde15e175cebed92d1b0621379741303ab87a",
      "text": "好的。那拍照的事就拜托你了哦，\n●●●●プロデューサー！",
      "status": "draft"
    }
  }
}
