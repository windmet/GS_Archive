  "entries": {
    "story-text:v1:1_x_017kir_1_7_017_01:1_7_017_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:6ee41b2570c12888a90ce7337d565a347f7522bb0799336a8053a55b82c12b56",
      "text": "祝吾辈生～日快乐！\n今天是个大吉大利的大好日子喵！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_7_017_01:1_7_017_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:3268abcc63fcd42cc7a2ed4396b67e36ee27516bd87e4c934863ccc2a5da6e55",
      "text": "是啊！再次祝桐生先生，\n生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_7_017_01:1_7_017_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:27b3d793fca3df22de3875543b73fca8626626b18fa858ef3599193a4bbeea69",
      "text": "能得到●●●●プロデューサー君的祝福，\n真是开心喵～！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_7_017_01:1_7_017_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:936b57c6932c230437a995fe47eb5acd99ce7aa28d37da29345ce1a39b948f72",
      "text": "今天注定会是\n极其快乐的一天喵。",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_7_017_01:1_7_017_01:cmd-000040:dialogue:000": {
      "source_hash": "sha256:6240bd5cb29d4c8626231b11d66ae9561bc4016db6eeaf2fb2a9702fde2aaea2",
      "text": "喵呼呼……多谢多谢喵，\n●●●●プロデューサー君♪",
      "status": "draft"
    }
  }
