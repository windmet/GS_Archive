  "scenario_id": "1_5_029ass_1_5_029_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000010:title:001": {
      "source_hash": "sha256:cbfd9b61b1c4afa580f75f4e754a28c22f74f4d29c0d7121cf00837ba57a3113",
      "text": "资讯综艺问答环节的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:3163f64700ae1af4f6dba35076120c2c7748243838f3067f6fbb54f8a1a576b4",
      "text": "嗯……这口感，\n绝对是他奉上的供品没错……",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:936b357442cdd8de53ec7e2b613a3a789aa93ef08d5b7052c600a8c33eb75041",
      "text": "此口粮想必就是身披泪水结晶、\n裹覆暗之衣的叹息之块吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:6b6503958235ee76b342e1d4dc1f17e76cfeaa2b1388edba6d7b5c79800095c5",
      "text": "库库库……如何？\n这世上就没有本座识不出的供品！啊哈哈哈！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000043:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000051:dialogue:000": {
      "source_hash": "sha256:1eb339c066036c7ea9a8e16159b496bb798330d2ecccf36bf6e4ff4db964678e",
      "text": "阿斯兰先生，录制辛苦了。\n恭喜您获得优胜！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000054:dialogue:000": {
      "source_hash": "sha256:457887ed1692dd45e5dbe312b95b7b6b1d23b6f38f0e635f5b100c62797fa12b",
      "text": "全都答对了呢。\n光靠吃就能猜出菜名，太厉害了！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000061:dialogue:000": {
      "source_hash": "sha256:18dc78ef676764b151b32bd9ed2bff4dd5183de48773cffa887b63faf2ad7645",
      "text": "虽然终焉的一问颇有难度……\n但本座不是说过了吗？没有本座答不出的供品！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:07875d8b680bda4956d7605a9fe5bd0289418a515f2a5ea80bcb4668485e63df",
      "text": "是的，不愧是阿斯兰先生！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000069:dialogue:000": {
      "source_hash": "sha256:57bb42e64fa72d61da0bbb4a48febc9583272f5ea5f3717518a2fd6e2fa89be7",
      "text": "嗯！方才的午宴让本座得到了启示。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000073:dialogue:000": {
      "source_hash": "sha256:e37d505629253c27a8c03321c59058b2abdcdc0bedba98593741d725f374ac9b",
      "text": "且回吾等之城，精制暗之供品吧！\n当然，本座也会款待吾主。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_04:1_5_029_04:cmd-000077:dialogue:000": {
      "source_hash": "sha256:7494238575970d08ffc1f3ac244aec70e36d0c0517e70100cb62b3c09e16f4de",
      "text": "谢谢您。\n阿斯兰先生做的料理，我很期待哦。",
      "status": "draft"
    }
  }
}
