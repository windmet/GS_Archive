{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_025suz_1_8_025_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_025suz_1_8_025_01:1_8_025_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:8516672174c5596e0c8f9655d96cadc5eb1469775d1060c123446427b3ab7e14",
      "text": "●●●●プロデューサー，\n祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_8_025_01:1_8_025_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:337a0e34b49e727420f21bb1474097f0aff920b153e5d8a846f2646d02223a79",
      "text": "……哦，怎么啦？喵子也想\n给●●●●プロデューサー庆祝吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_8_025_01:1_8_025_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:ffa4adb5970a8c89d95cc3fb9a4df15f993ff7e45b9f5422b8788bde180253d3",
      "text": "喵啊～！\n喵喵喵，喵啊～！",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_8_025_01:1_8_025_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:fbf6d46c07de2d33a38e3bc965ec37be86d037d92029ed5320cd1db3ad828b7f",
      "text": "朱雀先生，喵子，谢谢你们！",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_8_025_01:1_8_025_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:df53270a91d3cb8cf12c32b88a4e3539c237a44c88e9a5562c2a8843574cf01d",
      "text": "噢！哎呀，真是可喜可贺啊。\n今天老子一定会全力为你庆祝的！Burning！",
      "status": "draft"
    }
  }
}
