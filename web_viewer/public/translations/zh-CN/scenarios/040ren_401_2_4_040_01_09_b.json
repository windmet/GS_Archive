{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_401_2_4_040_01_09_b",
  "source_raw_hash": "sha256:a4eb78c151615e09e53585c375af01e82b7a450ae04ab402435c9b86dcb93cee",
  "entries": {
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:06b3b73f532d832db665772175e70171bb9b384b4f1c2b2e1dab3b5bc03ffcb2",
      "text": "喂下仆。听说只要演那个“帅气的怪盗”，\n就能吃到更多巧克力啊。",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:76db9691fec2399d9771f501f7c91f3d108cda83f17e7a577336adcf05124b8e",
      "text": "有试吃会哦！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000009:choice_short:000": {
      "source_hash": "sha256:7283503132b8d17d7ed0bf6c87957fa90f92923f72c470015d71e8a1227ae2e9",
      "text": "听说能拿到很多巧克力哦！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:df257045bbe4eebce98fba6b82db2fd2ce23dad1348d84d75d8bc8fa45d5032d",
      "text": "你拿来的工作我就接了。只要演最厉害、\n最强的怪盗就行了吧？",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f38bce3b161c43645521c46b7616f1a979d694af29e4888290bd4fe97c95ff67",
      "text": "拍摄什么的，分分钟搞定。\n一拳击倒！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:e3cedb6a91c6dbbf0bb76911d61ba1eb66e3549ba2a5eb19eaaa9928c7f79cb7",
      "text": "咕哈哈！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000018:choice_short:000": {
      "source_hash": "sha256:5f18a05b4c635d7d023bbe977a80b2baa7a19e9b455c23a71257c240dbea2d17",
      "text": "很期待哦！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:c607908361560ac62e6c898ee53bc204e4189d26f922adc574987968f8487b5a",
      "text": "哼。听明白了的话，你这家伙就\n给我准备大量的巧克力吧！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_b:2_4_040_01_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:955f78805ea330f179f2d3787d84b4b31d5186fce34c4a59c5e0816015ce62e5",
      "text": "拍摄完了之后本大爷要全部扫光。\n给我看好了，下仆！",
      "status": "draft"
    }
  }
}
