{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_007kei_1_7_007_01",
  "source_raw_hash": "sha256:94fb03c6b2cdbaeea91f35c97c7bc2914b5674324a0e81c06f00648343d236e5",
  "entries": {
    "story-text:v1:1_x_007kei_1_7_007_01:1_7_007_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:a8145a2b42897d602b441f809f938d600457715688b0854504d07a64be57ba55",
      "text": "●●●●プロデューサー，你今天看起来比平时\n更开心呢，发生什么好事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_7_007_01:1_7_007_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:fab200ec9eba1ab98468bfb4fd3c6e190ecefbbf3674e8d1a33cb2d9169196e9",
      "text": "要说发生什么……今天是圭先生的生日呀！\n祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_7_007_01:1_7_007_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:1f5a59659e961051ccce2f607a471a6573ae5a23311805cc2aee62f107680bcb",
      "text": "生日？……啊，说起来今天确实\n是我的生日呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_7_007_01:1_7_007_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:cbc3ff8727a14787b7702646b933cda7165c7fec2108edabe1cda0c7bcf0f0e3",
      "text": "●●●●プロデューサー，谢谢你。\n你能为我庆祝，我很高兴哦。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_7_007_01:1_7_007_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:1429c30f37d7c21a2baf1ee52cea95be0568e11ea957f77e8c1df69fc8243c7c",
      "text": "我虽然很不擅长记别人的生日，\n不过你的生日我会努力记住的。",
      "status": "draft"
    }
  }
}
