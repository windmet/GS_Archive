{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_g",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000024:dialogue:000": {
      "source_hash": "sha256:4d4d9993235c3bd5b31412ada53874d05760c227bd61dea85587b3a92f099550",
      "text": "……此店，可已与主厨缔结契约？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000030:dialogue:000": {
      "source_hash": "sha256:5fef37168141bb26e4d40235b755c1c71664424f0ad28f4bdfdcd1fd9ec7891d",
      "text": "主厨……吗？没有，现在只有兼任店主与\n侍者的我和一名西点师而已。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000041:dialogue:000": {
      "source_hash": "sha256:e5815c90c9e4b87e1f35647691ce2e1beedd628fafb28e6d62beb07851828873",
      "text": "（何等侥幸！）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000059:dialogue:000": {
      "source_hash": "sha256:59ce1a1519ed568d9117fdbdae16334f422861ad851d6a6d8fdc04227398a954",
      "text": "啊——哈哈哈哈！\n吾名为阿斯兰·别西卜II世！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000063:dialogue:000": {
      "source_hash": "sha256:15d5142cfeebe62ee2cce32362b06794a7bc1f9f24bf1419ca149d46d60525ca",
      "text": "乃堕天使撒旦之仆从，\n精制世间至深罪孽之供品之人！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000074:dialogue:000": {
      "source_hash": "sha256:104fb03ddcfaf9838693a522a89616b6a0f45bdf470447e75eb3af2980b24127",
      "text": "精制……？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000078:dialogue:000": {
      "source_hash": "sha256:0bdab959e8435e25ea7e3674db027d1c15be5d7bcadad0b3fce8a319a42c321a",
      "text": "名为神谷是吧。\n吾，欲与汝结契！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000081:dialogue:000": {
      "source_hash": "sha256:7c61a4cf8d8ec174c1df7839240d1a74a42c1527d0e4fdd3c5b57e25234d0d85",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000085:dialogue:000": {
      "source_hash": "sha256:6e18da7d53c9f002bc105128fcb04cae78ac36a12719e0fd4380a2fa9f2a0490",
      "text": "契约……呃，\n难道是想让我们雇佣你的意思吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000089:dialogue:000": {
      "source_hash": "sha256:796406bd6c01e252c3f95093add9b850ed7fcb318dc4ff312a7ac7e0bc74d6e9",
      "text": "然也！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000094:dialogue:000": {
      "source_hash": "sha256:e3fc125751d643c0fffc5440ad8084c80bd5b4d0e36f231d59e1ae11c7078397",
      "text": "这样啊。那……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_g:cmd-000107:dialogue:000": {
      "source_hash": "sha256:c983c969ea2747df19751d22266a6f83b22162e12d7d6c1f4d883d3077f84c84",
      "text": "神谷，到底发生什么事了？",
      "status": "draft"
    }
  }
}
