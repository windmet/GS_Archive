{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_025suz_1_5_025_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000010:title:001": {
      "source_hash": "sha256:bf022b5515c50c14359757a62a65b866a43c60cea4dfdf638176a0859d749748",
      "text": "广播客串出演的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:26c71645260be8dd63bbd234acdcf8b6ad3b516457943b958db71aaed7b01faf",
      "text": "广播录制辛苦了。\n这次是客串出演，感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:93332203b08f5fdef496268697280c01ddfc293a650488a8622748a8da2d5a9a",
      "text": "超级开心的！\n主持人人很随和，聊了好多事情呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:132cd19e6f610d96790c592aecda4dea3b9bb1f8c7f24340e14366e56da060dd",
      "text": "朱雀先生当时非常有活力呢。\n能感受到您是发自内心地乐在其中！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:575f011f96184b8b7700f4a58d2d7e673647e4eb8b0a8d04b3898526249149a3",
      "text": "有什么印象深刻的环节吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:ba9f3cd42753bc5307d2c863f6c24f63113cac203c113021114b0d89db037c5e",
      "text": "哪个环节都挺开心的，\n不过果然还是烦恼咨询环节吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:abd1bc982c44851322a0de34b68e43d10f15e366b82e19de90537e3120d4301e",
      "text": "虽然是给我同龄的听众答疑解惑，\n但大家烦恼的事情还真不少啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:d61ccc013136790aef1a8492e8939ba0e3f30e14c78863f0f25e71dcba987114",
      "text": "话虽如此，收到恋爱咨询的时候我还是慌了神。\n我实在是不擅长应付那种话题啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:068144a0490383646cc88a3774a2cba0c96c6fe5e96e5136ea2348030b4de73f",
      "text": "虽说勉强回答了，但那样真的行吗……？",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000052:dialogue:000": {
      "source_hash": "sha256:7b5123e2988058787210f3d0035b042c87282f32a12d062ebe418a96227bdc35",
      "text": "那是很真诚的回答，体现了朱雀先生的人品哦。\n工作人员也夸赞说非常好呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_02:1_5_025_02:cmd-000058:dialogue:000": {
      "source_hash": "sha256:2c7dcdedfc76dd1546b9416228012feac151628feffe88023eee1df1cffdbb4a",
      "text": "真、真的吗！？\n嘿嘿，能帮到有困难的家伙真是太好啦！",
      "status": "draft"
    }
  }
}
