{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_049eis_1_7_049_01",
  "source_raw_hash": "sha256:97807102aebc5a2abf6d529279a25fdbcd520bb60ca29abdf2b2eeec97ec1f8a",
  "entries": {
    "story-text:v1:1_x_049eis_1_7_049_01:1_7_049_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:7a27884a0fe1de5f31943f0ab3f9bf295c237bd8caf38384f78c3cd09979d7f2",
      "text": "锐心先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_7_049_01:1_7_049_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:f611277d7779d43630ce154a905deb72b6c172abf2284a99ab8d624ceecd5fee",
      "text": "嗯，致以谢意。●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_7_049_01:1_7_049_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:5a4a9c83df7b08bd12e2700aa83df3363696dfac760b45b4f01dd1eeb3518155",
      "text": "……借此良机。\n接下来这一年的抱负，我也向你传达一下吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_7_049_01:1_7_049_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:27860816e982787655d6eb20a938d9c203c0b37167f6d800e95986fa7d764e8f",
      "text": "今后，你所交付予我的工作，我绝不会\n虚掷一件。定将全数化作自身的力量。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_7_049_01:1_7_049_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:94e8380ee9d70336547596e259ec33f97402f36c65b24ab9753648b94fd0fc33",
      "text": "虽然常有人说我不苟言笑、难以捉摸……\n但我由衷感谢你至今以来的支持。谢谢。",
      "status": "draft"
    }
  }
}
