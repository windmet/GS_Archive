{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10002_01_g",
  "source_raw_hash": "sha256:336ababac562bd4e41dda46491265cd4b5bbe341b8e5e830d4e0ea45ab17b045",
  "entries": {
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000020:dialogue:000": {
      "source_hash": "sha256:e43759ff8cccbee7922449efe78d6a499cecb626f72e01d8f3014a92bff48357",
      "text": "这是……\n作为小孩子承受的烦恼来说，未免太沉重了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000027:dialogue:000": {
      "source_hash": "sha256:99355da503ec8b658fe2ae21d0f0f9a882a80a7cd171e808be7ba905189bfd16",
      "text": "（光是向我咨询这件事，肯定就需要极大的勇气吧）",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000031:dialogue:000": {
      "source_hash": "sha256:0e5127102f9a40e7d73e79e5ec424762b1e9e2ec64bda75b4036f970dacf8d85",
      "text": "（现在或许也正独自一人饱受煎熬。\n我想成为这个孩子的支柱）",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:474ea2a5a05a8458120d8f7785ac3eb05512c9c5e071c75981ac5d265512ab21",
      "text": "（我想握住这只鼓起勇气伸出的手！）",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000046:dialogue:000": {
      "source_hash": "sha256:4d1e7ccb0dee29457c9ac234e931a0c686f5d7559420fc3ca1efba261a30d6ae",
      "text": "英雄先生……",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000050:dialogue:000": {
      "source_hash": "sha256:09faaed172ee30f7943545ca5a3d615a74fd6d02db1dd5162e28460ef7faf2ed",
      "text": "看来你已经决定好要回答哪位的咨询了啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000061:dialogue:000": {
      "source_hash": "sha256:a6b223dcf2f7c19c501466d6ca489ba5c0ed28458e0f1f924a7166ffd7b12d8b",
      "text": "……啊啊。\n●●●●プロデューサー，就决定是这个问题了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000066:dialogue:000": {
      "source_hash": "sha256:899cb8a5786aa7584e2c28efbc56ffd3a42676bc062ed986e88abb563042ee39",
      "text": "我想把这句话传达给这个孩子。\n“没事的，你不是一个人”！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_g:cmd-000070:dialogue:000": {
      "source_hash": "sha256:35bf8b90312dfff35f4586502c7f95f05b16ffad0b7dbe606302f90f68135c4f",
      "text": "毕竟我就是为了这个，才成为偶像的啊。",
      "status": "draft"
    }
  }
}
