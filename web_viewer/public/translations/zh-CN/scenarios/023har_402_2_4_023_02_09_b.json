{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "023har_402_2_4_023_02_09_b",
  "source_raw_hash": "sha256:aadfaa899c13bb29865a3736416f6f01951263e0699d65ce69c5b19da383a116",
  "entries": {
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:26279a9eef0238496b15fef0f5772a1ca94fcc4efdb4feea1c31c7c533185108",
      "text": "●●●●プロデューサー？\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:10b2d82d3c9624e8e0cb4faeaf02c7ec3d22b503d5a9e79ea8558b10d1ab402f",
      "text": "今天中途离开了现场，\n真是不好意思",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:cb4b53b698f7961b71d822a837c723fb48922fffa45f0d64b3330ab0d6ea0b51",
      "text": "没事没事。\n你那么忙还特地过来，谢啦！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:40093304be662e10c8883e52ae2fbb79e52bbbb4225861553f3a0387d2f4721c",
      "text": "后来拍摄\n进行得怎么样了？",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:c00058f0c888e4b4ef5ce5469b5917f5035d93e2aa820d52c5edf392b42454e1",
      "text": "完美！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:ac0f71777ef68e9162149b7b1b5d630866f28053d2b51f318ed204c3f5098227",
      "text": "雨彦先生和涟那边也顺顺利利地结束了。\n我们3个人开会讨论果然没白费工夫啊。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000019:choice_short:000": {
      "source_hash": "sha256:6f7b9ae5e64e059bacc7111e8cf872b54f53667af053ac22a9b412040c991e9e",
      "text": "那真是太好了！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:f00b0fd80a90eb7457c3c3bf067ee09e777bf08f5c3fadced0b88675d136247e",
      "text": "真不愧是大家！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:0dea04cb382769533a071971bb991749d57281ed4fe0e78dd569b0b42e40297c",
      "text": "谢啦。我这就回去了，\n●●●●プロデューサー还要继续工作吗？",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_b:2_4_023_02_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:fadcccba15b28592f8a3ae1b17b634e0282139bb659f78989bd16511217e5db0",
      "text": "可别太勉强自己哦。累了的话推荐吃幸运单品甜甜圈！先挂啦！",
      "status": "draft"
    }
  }
}
