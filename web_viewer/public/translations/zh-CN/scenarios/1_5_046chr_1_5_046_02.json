  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000010:title:001": {
      "source_hash": "sha256:2361a6acb3471062e95c5a371610c2af618cc8f6b8581210906305f7de7a54d4",
      "text": "潜水杂志的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:a9e2b48255e3aa477ee9c602838827862dc53cab74d18a774094fd17a3591f02",
      "text": "请看这片辽阔的大海，\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:58ac50a4f830a7c81726cdc493dfce57aebc9ac242ff036677c97fec776cc7c9",
      "text": "能够接到潜水写真和访谈的工作，\n真是太荣幸了！",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:d0efacc918118935f91a4e180a8e8899559665ddd654d9981273016165dfda8f",
      "text": "呵呵，克里斯先生就是为了传达大海的魅力\n才成为偶像的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:d5d7dca9d1f23c68fd3fbac1c46b2d62b2df528d4e138f779c524704b9b53c2f",
      "text": "是的！我想让更多的人\n了解大海的魅力所在。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:26b1a7ac79fdbfa95e53b586b24ba55d878ef9d1a7c39770a33325dd199d0155",
      "text": "听说访谈也能分到不少页数，\n我把这个准备好了！",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:48744c7fcbb6b35132144965c7fe7427d5ff886a58e1cefc91175f3cff741d77",
      "text": "这、这堆成小山一样的纸稿是……！？",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:da424cdafdca83154bd9c8c37533151a22fa6686296ab036f18d76adc666e9ce",
      "text": "结合这次访谈的主题，\n我整理了这份大海的资料！",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:ba2a6ba46930239bf969232caeff5ead296c74d27fe8b17519346b61057520f5",
      "text": "用这个来接受访谈的话，\n一定能更好地向大家传达大海的魅力吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000052:dialogue:000": {
      "source_hash": "sha256:ce978fc0610a21f46af5c656b7a4ace7ea5e49b256cb1c89dba27d4cfc937aff",
      "text": "原来如此。克里斯先生想传达自己喜爱之物的\n心情，我觉得非常棒。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000055:dialogue:000": {
      "source_hash": "sha256:5be32a18b7876d4ad68a6204de221ad999d27da1c1d57b2256ac899b4b9cb353",
      "text": "访谈安排在写真拍摄之后，\n首先把拍摄加油完成吧！",
      "status": "draft"
    }
  }
}
