  "scenario_id": "1_5_006tsu_1_5_006_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000011:title:001": {
      "source_hash": "sha256:804e80c32ba6a9a00aa5cc022a803944d9ac5567c164ed56a12d936bfc2b8e62",
      "text": "B级美食节报道的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:03e59fbdb75b2ea7ee845c3332310d27284160ad4513ba12665930256f7ccb95",
      "text": "请大家看，这么厚的肉居然只要\n一枚硬币……我马上尝尝看。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:b39cfc72087b12a02e9095f81465c05d4ebb222d8bced056356010f8a37737ed",
      "text": "越嚼肉汁的鲜美就越是在口中\n蔓延开来……感觉超下饭！",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:c034635619da08dcd01dd312d443dc91c13e0e6507d76f7992588aff118eeb3e",
      "text": "大家也请务必亲自来走一趟！\n那么，把镜头交还给演播室。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000055:dialogue:000": {
      "source_hash": "sha256:eff58f782c57802af1437916fab660d6f3a05e250b4a8a34e60c2c43654c7d7e",
      "text": "辛苦了，翼先生。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000061:dialogue:000": {
      "source_hash": "sha256:bcaeb20a9f84ca0bca7542edb762d9e858cfbf7d0ec7207156738dd686f3688c",
      "text": "●●●●プロデューサー，\n我的报道感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000063:dialogue:000": {
      "source_hash": "sha256:7d2e41a2c75d9e0fdec79f29cc0f60a9395d037907e3f3e80ae2ee2a9000a216",
      "text": "非常让人食指大动的报道哦！\n而且你看。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000069:dialogue:000": {
      "source_hash": "sha256:d8c7fe94e5d8115e074492c07519f7ef6b938e67388ba01617a5b0c120e62e67",
      "text": "翼先生报道过的那家店，\n好像人越聚越多，已经排起长队了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000078:dialogue:000": {
      "source_hash": "sha256:a93361f5e17d911185b358b8b2f9de6f7d9ea63e54ea56e5f1fc486febbe9d83",
      "text": "哇，真的……！太、太好了。\n我也很想再吃一次，不过得忍耐一下了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000082:dialogue:000": {
      "source_hash": "sha256:6e2cb20a43c969e768fdd11cce60dc747908b2e3f7be84988db2178f97c9b550",
      "text": "呵呵，我猜你就会这么说，所以已经准备好了。\n如果不介意的话请吃吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_03:1_5_006_03:cmd-000090:dialogue:000": {
      "source_hash": "sha256:d403617c8dd4edeb2efb8713159569a4781b2af3f5f4e59f72f4f4ab39c5cb68",
      "text": "哇，谢、谢谢你……！对了，\n●●●●プロデューサー如果不嫌弃的话也一起吃吧！",
      "status": "draft"
    }
  }
}
