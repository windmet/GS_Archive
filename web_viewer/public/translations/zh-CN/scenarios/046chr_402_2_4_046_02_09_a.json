{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "046chr_402_2_4_046_02_09_a",
  "source_raw_hash": "sha256:4173ae13535197947a802d92cd89bb7df14d09f2837cf890fc566d3509713608",
  "entries": {
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:6ed2335d036a817df54852b66f2dcc813d59b48b1608915984602a991c9d893a",
      "text": "辛苦了，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:a6e28f811884dddc25697ea638160a92280f09de72497ca51457385892278072",
      "text": "冒昧问一句，\n您听过海豚的叫声吗？",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:d1a5098826e811b6cffed20d947fc8933b4aaf176e68b400c91f479931ae75b1",
      "text": "听过",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000011:choice_short:000": {
      "source_hash": "sha256:0945732b1904298f73f66dfb7f6baae28e99a2b2a922eaa3ef27c0aacafee5e3",
      "text": "没听过",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f0bdfd2496c4001a39b9bbe2c55fc2aa3d9221355c1ad3008c6ed7dac3c7e4b8",
      "text": "原来您听过啊……！那是非常神秘而又可爱的叫声对吧。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:04c574feff557ac27db1c0574a579ba616c109ddf231eb06b0c914145d06038f",
      "text": "那您一定要听听看。其实，正好有一个绝佳的机会。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:71d184acfa17cc7bdd0bb96983ab3ce58f0992f7ab2730ca998c31e986fc6787",
      "text": "一位说看到了我海报的熟人，\n发来了海豚表演的情报。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:8c943acce035d93e0750610550d269782c44787f8411037d050dfbf9ce8514f3",
      "text": "听说登台表演的，正是在拍摄中与我一同畅游的宽吻海豚。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:865d5ee64dd2370a743d1ce7f1218c497ff157e028d0292d11436e83a01bd242",
      "text": "据说在表演的编排中，也有能听到那动听叫声的环节。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:27dc6827d87417ece7294ead9b17fcf4ad3f58451288780907f5c743c33dabfc",
      "text": "如果时间合适的话，制作人\n要不要也一同前去呢？",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000030:choice_short:000": {
      "source_hash": "sha256:b6acba17d0f7da3a8d46f547d9d8991901bc74ccc27ad1cce3dae81c8c0850ac",
      "text": "我想去！",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:98954bf15cbbc14cb69a3a3b5b82d9772354a5e662bc1a498c7c11ea7fa0bc97",
      "text": "那么，我稍后将日程发送给您。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000035:phone_message:000": {
      "source_hash": "sha256:5b9ef85c47edaf3b6472c9ea47e11081de8c5f781559dfbfa021f9d4e5fbb5e9",
      "text": "无论是对粉丝，还是对制作人以及事务所的各位，乃至更多的人。",
      "status": "draft"
    },
    "story-text:v1:046chr_402_2_4_046_02_09_a:2_4_046_02_09_a:cmd-000037:phone_message:000": {
      "source_hash": "sha256:58e683520624bba1973aa2418359fad55c31a2f4c9ce93e9661c043dfd67630a",
      "text": "为了今后也能将大海的美妙传递给世人，\n我定当竭尽全力投身于工作之中。",
      "status": "draft"
    }
  }
}
