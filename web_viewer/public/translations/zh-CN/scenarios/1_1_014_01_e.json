{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_014_01_e",
  "source_raw_hash": "sha256:80a5ba49b1a90b0aa25f0e70ceb447990d45bf635636cd8e444c673ec4ffe6ce",
  "entries": {
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000021:dialogue:000": {
      "source_hash": "sha256:6444c321a6d372f2f83f1a5886a883687c2dbf70811a722ebf3409a49c27324f",
      "text": "（哎呀，不好。班会结束之后\n就一直在发呆。得准备回家了……）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000029:dialogue:000": {
      "source_hash": "sha256:9ae93e1448f80cb32bb9bbcc892e87e95269c24d6c22325878dc2102cc662b1f",
      "text": "喂——兜。接你的人又来了哦。\n今天的约定没问题吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000033:dialogue:000": {
      "source_hash": "sha256:401db8ca43daa87a2216273a403291388d6d9358cd72f2fbaf25247bddfebe36",
      "text": "嗯？接我？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000035:dialogue:000": {
      "source_hash": "sha256:436ec7dcff435b7e7fde0c67c6f3c5fd13cc86b4e7af7e08848c38a9649bde50",
      "text": "对啊，校门附近停了辆黑色的车。\n还有穿黑衣服的人在，是你家里人吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000040:dialogue:000": {
      "source_hash": "sha256:148f9b5161081711d41bcfbdc5c1b32dd4fe4e620912d72f84b37d381a309c40",
      "text": "真是的。那些家伙，又来了！",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000048:dialogue:000": {
      "source_hash": "sha256:489b3e960256c4a4d499fd845fc3198f697d50431ac03cf787df68fc640dd674",
      "text": "（今天也是来接送俺的吗）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000052:dialogue:000": {
      "source_hash": "sha256:c2e6bb1c590d60c1c17b1ef1d4e7abc6d5a1431170cb532be85b76c8fe4d2368",
      "text": "（俺明明都已经让出继承权了。\n都说了不需要像以前那样的护卫了）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000057:dialogue:000": {
      "source_hash": "sha256:cbe127b26a20d71a940a6720161fe5decaf4682437c3551f8cc8231ce90b3071",
      "text": "（不过，这也是为了俺好，\n俺也没法说重话。真没办法啊～）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000067:dialogue:000": {
      "source_hash": "sha256:499ed7098c02ea8100390c3b41a69f6829e2557e383b27c2211185163ffc350f",
      "text": "俺去稍微交涉一下。\n不好意思，你们先去店里吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_e:cmd-000070:dialogue:000": {
      "source_hash": "sha256:8aaadfa816601eb6ef72121d178f5f6567f381601d027a5b24d2acbe1aef199e",
      "text": "知道了，快点来哦——",
      "status": "draft"
    }
  }
}
