{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_030_23_5_02_030_23",
  "source_raw_hash": "sha256:fc0639835abf9d1163e96cab13ad9632b5193b16c6cfa9fbf05cab95c58cdeff",
  "entries": {
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000014:dialogue:000": {
      "source_hash": "sha256:59aaacfdaab994ac181172b2b9bf8dfea36be7b53244ed20d438d286344a2d19",
      "text": "啊，制作人！\n还在休息中吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:4d4502b14c5ab42d19c4f592e33288ce2c222e1d4630ed43d3ffcbf9d097084c",
      "text": "是的哦。\n有什么事吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000021:dialogue:000": {
      "source_hash": "sha256:1f18a3ebd13614276b578d216146bf0922c6361e34d772a5de2445a4cf9272b6",
      "text": "太好啦……",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:32a49221c46f175acbb02303287c85e4482324f8b7d6169e9eb48d37cbec7c52",
      "text": "因为今天是白色情人节，我买了蛋糕作为回礼哦。\n这是对情人节的感谢。",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:89b160de884288f196eddc9033e9743b78c84b9927a52f4a55150358ead11fe4",
      "text": "是一家超有人气的店铺的限定商品，\n每天都在大排长龙呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:2276db3af9a1c3f3ddf66845e9eefb1dcabb91685c70835acada16b77d5a15bc",
      "text": "我买了两个过来，不介意的话我们一起吃吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000041:dialogue:000": {
      "source_hash": "sha256:da94125d4786f2511b002bbd7fcfcd380716604fee7095ab19a61e4660591d5d",
      "text": "非常感谢。\n那我去泡点茶过来吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000046:dialogue:000": {
      "source_hash": "sha256:8e035d29de9a8ecfa27110dab9807a3560f0f587ba73a205eda10d8a60c668bb",
      "text": "啊！今天由我来泡。\n制作人坐着就好啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:9209d4db3a72b52286988d7a0c9f6da2bffcdc66034d9d204a52ddc2082e50fe",
      "text": "真的可以吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_030_23_5_02_030_23:5_02_030_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:1fc7bacc988bbfc7630491ffb64283bb723aaca848c8be71557782e92d69ad83",
      "text": "可以的。上个月也是制作人泡给我喝的嘛！\n请稍等我一下哦。",
      "status": "draft"
    }
  }
}
