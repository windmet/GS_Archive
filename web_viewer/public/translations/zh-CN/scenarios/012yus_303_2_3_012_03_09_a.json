{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "012yus_303_2_3_012_03_09_a",
  "source_raw_hash": "sha256:bb3b7d01af64c0f038165861622f519c1df45c37e26e1a7d2174f39075d9fc91",
  "entries": {
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:adfbbaace5a309a6eaf24aa862a0030978f1d59472319e75731a5552883a14f4",
      "text": "……啊，●●●●●●●●●●监督？\n是我啦，悠介。",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:053d46678ebcc7cfdf781e79015a42d6f4c7b488935830d2172c8fc333b60811",
      "text": "听我说啊，●●●●●●●●●●监督！\n今天遇到了超级开心的事！",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:042a4e4f3ebd4f06237490e1f5c7db3835e53b8f5b769dfd89874dc2fa726e62",
      "text": "我去附近的公园散步的时候，\n看到有小孩子们在踢足球。",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:437055366ab80f4d7494cc1c334bd3d426105905fea87d71a9a8ec8f76d50ade",
      "text": "结果你猜怎么着！\n那些孩子们居然在哼唱《明日转》的主题曲！",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:ad290281e0efbfc55b4d6ea5244250076f90d555e9a1b427aae2b31a3492b511",
      "text": "唱的可是我们的歌哦！？\n你不觉得这超级厉害吗？",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:c926ae517efc36109c9bc62e037bab68bf035cbdf0da3f0f80e3545bb2a873b5",
      "text": "他们看了动画呢",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:609ae291d42d30a8429b09d7f907d81d8508a6e396428f7bedbd6a08eddc5b59",
      "text": "一定是这样没错！\n因为我还听到了《明日转》主角的名字呢！",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:7a46d7458a8e78d5926448559fd1d2ef266e70cdcba97c4b1c7b793e15627a53",
      "text": "……我啊，一看到、听到这种事情，\n就会再次涌现出切身的真实感。",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:5a34130882d41f30d48f89c644d8a5821691f863325a9b6c71416693b017fd82",
      "text": "动画真的播出了，\n而且大家都在看啊——……这种感觉！",
      "status": "draft"
    },
    "story-text:v1:012yus_303_2_3_012_03_09_a:2_3_012_03_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:beeb9ce9d352dc4608aafb1fc20d27017ad5d9625a86b9f6001dced2b93e4c67",
      "text": "我还想去挑战更多更多的新工作。\n●●●●●●●●●●监督，今后也多关照啦！",
      "status": "draft"
    }
  }
}
