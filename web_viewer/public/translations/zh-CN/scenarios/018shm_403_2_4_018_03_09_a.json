{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "018shm_403_2_4_018_03_09_a",
  "source_raw_hash": "sha256:6da13b5f3098def158d2c6f846663beb88096869269fdfc964253716015e66c6",
  "entries": {
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:36b4c54d8db5ced7715ef2637a2b03dcd6895e96bea39679d0f97211c3b800b5",
      "text": "●●●●プロデューサー酱，辛苦啦。\n有点事想找你商量商量。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:9f414001313ab870cc41a6caba372c23f8314a662f6bc9ec290bc1323a8fe78d",
      "text": "我有两张芭蕾舞演出的票，\n要一起去吗？当然得是你日程有空才行。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:ff24205da2e5567d9d35b2a5916978991c1f7ce688c6b65c5ef10b40a326a830",
      "text": "前阵子拍摄的时候跳了芭蕾，\n搞得我都想去现场看了呢。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:786dc7556441a49a0366660ca82b92ecc5d08f6a5b0cd4c160ccaf08cfadf7f2",
      "text": "刚好听说有国外的芭蕾舞团来日本演出，\n我就订了票。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:2898d868afeb385940e2ac91902d8711a999e1d51cbb16b6c7d10f3c2904127b",
      "text": "我想去看！",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:0e1e01cd10d67f37a9173db2b03337992981df8432a754bb82b906b802a1a15a",
      "text": "那就这么定啦。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:2380f235fed3055a06d2238c0b66e129e07cb2f5e21398a4fbe55bdaf2a462d3",
      "text": "演出结束后，我们俩一起去喝杯茶怎么样？\n我想听听你的感想呢。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:9bea64931604892e30a6b12298b5195e97bbe29fe7188cf1fcee216ecafe5f19",
      "text": "请务必让我\n一起去",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:85bb85bafd2fa3b03c37c32bdb599047bafc59f7e696116eedb99172fa0c0a11",
      "text": "我也想听翔真先生\n聊聊！",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:86bdb3a42e46d18c13e118c675be18fb764f9f8b6b7da9460fd98b0e0280e20d",
      "text": "呵呵，我越来越期待当天了呢♪",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:1f4760033a8c9e909301b32d97834bde1ff96d9d5c0570f86de60a84a8a5bfe7",
      "text": "哎呀。那这天我可要\n让你奉陪到底啰。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_a:2_4_018_03_09_a:cmd-000034:phone_message:000": {
      "source_hash": "sha256:d142008677e41e392ba8951e12d8428e0261411766644e6d88e98f77f9bc714b",
      "text": "该穿什么去好呢。制作人酱也\n要好好打扮一番再来哦。那就敬请期待吧。",
      "status": "draft"
    }
  }
}
