{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_042_01_a",
  "source_raw_hash": "sha256:6138ad75f7b33c97d3ffa0be4ad63ba19c4ec1418830577f29943523923fa76a",
  "entries": {
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:e397ebfc929a7eb1c58bd999f9bca61a2782da70b76c3d5e7211489cc40f5b62",
      "text": "老鼠招来的宝物",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:ed669dc25efd998e1d687417ec636410c6fddc235278b7a81ccf16a5e974e3b8",
      "text": "大吾接到了骨董品鉴定节目的工作，去仓库寻找宝物。\n告知工作内容后，大吾表现出了反常的反应。\n察觉到异样的制作人为了询问缘由，\n决定换个地方慢慢聊。",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:e397ebfc929a7eb1c58bd999f9bca61a2782da70b76c3d5e7211489cc40f5b62",
      "text": "老鼠招来的宝物",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:1680fc1fe52d1dc76f42e889e5cc8322b788134ec21326a1f630c3af40b14d46",
      "text": "辛苦啦，Boss！俺来听工作的具体情况了！",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:903ce882c0119a3512368787ab32898619945e25ff33fb41af5d55d0ecf31561",
      "text": "辛苦了！久等了。\n事不宜迟，我这就说明这次的工作内容！",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:73d5f6e2497e2edb593930d1a2f05326877c7d656e998424a3e3e392e025962e",
      "text": "是一档骨董品鉴定节目，\n担任在仓库里寻找沉睡宝物的外景记者。",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:37da461e53167d988731f717f5a164be95c4005e058dc001f5b5ccaf73798ae8",
      "text": "在仓库……？",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:375a8f16bc054f7d2bcccfa89d8c260e1cd56dccf24f8b9400e6e9aa744656da",
      "text": "（既然是仓库的话，\n那家伙可能会在啊……）",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:1f6cb4e83f532f39a68a8c504d0ca00042d44fa83a6f4e995cde8ccbf1e7c86b",
      "text": "大吾先生，怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:2d68b9c316011ee886dad6998c9cb0a4d90d7ea18026c654cf9065047fff2626",
      "text": "没、那个……没、没事的！",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000057:dialogue:000": {
      "source_hash": "sha256:e37945c521a2a35e7b2bcdd02cc5ebc8992dc5394de72503937072b9f499ac0c",
      "text": "（和平时的样子不太一样。\n说不定是有什么难言之隐）",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000065:dialogue:000": {
      "source_hash": "sha256:3796d4fcff10c175f36c7f3c7d3712eded67ea663de7b39f8f7a695ada2523b0",
      "text": "大吾先生，方便的话请去会议室吧。\n在那里听您慢慢说。",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_a:cmd-000069:dialogue:000": {
      "source_hash": "sha256:484b6a1a77232322f83e9d347916e11ee9712dab20649dbfc154f2d5306920eb",
      "text": "哎！？没、其实也没到那个地步啦……！",
      "status": "draft"
    }
  }
}
