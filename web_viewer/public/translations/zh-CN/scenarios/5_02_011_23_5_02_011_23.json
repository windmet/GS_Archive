{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_011_23_5_02_011_23",
  "source_raw_hash": "sha256:699c5286d930f9f4ed4b8713405e26637ce53650cfea95998a3e8f8c8d9015b9",
  "entries": {
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000015:dialogue:000": {
      "source_hash": "sha256:23e5f60f8b92dbaaf1b9f76d1fbf2cd48efc4be93c10050dfc2b2a2ff0a654c5",
      "text": "辛苦啦。现在能稍微聊聊吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:212340a4ec817f33b9f4b709c7144d15628144d19cfa16989ac1cd4265875f77",
      "text": "好的。正打算稍微休息一下呢，\n完全没问题哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000025:dialogue:000": {
      "source_hash": "sha256:37b3c68426b0f96d91ba255ece644b1517d17f728ad2491c7e2ccae005438073",
      "text": "太好了！\n给，这个。送给制作人的礼物。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000028:dialogue:000": {
      "source_hash": "sha256:874ad0a53e76502a25b282c2a9785ffa7812f9d34854c495d83e85bc56ebd74e",
      "text": "好漂亮的插花艺术啊！\n是有什么值得庆祝的事吗……？",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000033:dialogue:000": {
      "source_hash": "sha256:fd920d1994e7557185ee51f0f0157014cd6c095830d45fd274ad35f832869c27",
      "text": "呵呵，不对不对。\n是白色情人节的回礼哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:e9f5e59358aea1adc9774e838a6e1a3f57ac410334043fc5d89eeaf4aa208073",
      "text": "想着如果能给制作人的生活增添一抹华丽的色彩就好了，\n我就尝试做了一下呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:a08abba3d8a3acfbe03611f03a9abf6d8c4058d36351dd1c4e25d0b5b0a4a1ca",
      "text": "明明之前还请我喝了咖啡，\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:c4e5ff7b6aae0749192ac1a854663c3d3d221baae512a2d3adee3f9bdbeea3f5",
      "text": "啊哈哈！\n我可没打算只用那个就当作回礼结束了哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:0a304a7c52043d078e7783e3c2f245ac5bef2e4e9d9bdba2f4fcaf04e9ec4089",
      "text": "加上按照制作人的形象创作的花艺，\n才是今年的完整回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_23_5_02_011_23:5_02_011_23:cmd-000059:dialogue:000": {
      "source_hash": "sha256:7af6b2bd77c6cfa89dd7aeb84266d6699967b87ec6d1daab999cc74572ac9ebd",
      "text": "情人节巧克力，谢谢你。\n我真的非常开心哦。",
      "status": "draft"
    }
  }
}
