{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30007_01_c",
  "source_raw_hash": "sha256:30a7abd437fc900438e512dd8572c822503e88a9f530bbc5baabcedab4967bf7",
  "entries": {
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000026:dialogue:000": {
      "source_hash": "sha256:8fe2c0b646ed3c441b581e636dde97c299bdca172243c9f640538a4537c026a0",
      "text": "那么，红井先提问吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000040:dialogue:000": {
      "source_hash": "sha256:97f8d19a51b277386363576b521e24474682f459b82ee1e467fb301c068755ee",
      "text": "哦！我想提问的是实先生！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000046:dialogue:000": {
      "source_hash": "sha256:867ae5099564a76e31fe9acf446649f46d6044774c94c439df6100622c832800",
      "text": "好啊，问什么都可以哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000053:dialogue:000": {
      "source_hash": "sha256:f9c4b06faa10eaba731f159e1a4ed667d95f62ac35af84401d501b63c56545bd",
      "text": "有件事我一直很在意啊……\n我们很久以前是不是在什么地方见过啊？",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000060:dialogue:000": {
      "source_hash": "sha256:c5a3fcfdf49a042ee33b1406392560447e16386a751fc38c6e5dc0b966f3e4f6",
      "text": "和朱雀君吗？……唔，是这样吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000071:dialogue:000": {
      "source_hash": "sha256:ced490995614b7f532b6e98974dce5e425cda747420b91fbeabdc6e0a44b13c0",
      "text": "这么说来，可能是我多心了吧。\n多谢啦，实先生！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000086:dialogue:000": {
      "source_hash": "sha256:db5f4ef8460ea261a88216635220e352baded9c6a225d0c25c0b137892b89d7d",
      "text": "也是会有这种事的呢。那下一个，\n由我向朱雀提问！我一直很好奇……",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000091:dialogue:000": {
      "source_hash": "sha256:29e2d4f0401bbc1bd83be92a24964658a3b8dbf073ac874bd680155dfeb3b3a3",
      "text": "你的发型一直固定得很帅气呢。\n用的是哪家的发蜡啊？",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000096:dialogue:000": {
      "source_hash": "sha256:14de2382669497c14d87d304514a67587b4788635cb3a6e1755b7c49f0dfd3ee",
      "text": "嘿嘿，谢啦！你问的是我用的发蜡吧。\n等录完了之后拿给你看。",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_c:cmd-000105:dialogue:000": {
      "source_hash": "sha256:1a6e333b502dcc35b624aaeb3c49f92850e7f6201f7f7974ba16d80789332622",
      "text": "真的吗！谢谢！\n那么下一位请提问吧！",
      "status": "draft"
    }
  }
}
