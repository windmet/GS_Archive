{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_02_f",
  "source_raw_hash": "sha256:0a01e1e69b2c8f3966b51f839965420d6f35e4188108cc492ddc8ec26f6dceec",
  "entries": {
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000015:dialogue:000": {
      "source_hash": "sha256:1a868612a5e8cf56f0e03db7a979faa9b8d9791f11001db2ef9761300187b4a4",
      "text": "嗯～……古典落语固然不错，\n但拿手的宇宙落语也难以割舍……！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000021:dialogue:000": {
      "source_hash": "sha256:07207516fa9e8108fd4248a817bd47cdafbab4748f60fb93548e660821837fcd",
      "text": "话虽如此，最近沉迷于写新作\n喵～……哈！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000029:dialogue:000": {
      "source_hash": "sha256:39260e56bbaa47c9a70392f5147edb945927897a3bd6fdc1cb6081d62ec6ee3e",
      "text": "没错喵！今天就给猫君你，\n表演热乎乎的新作落语喵！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000037:dialogue:000": {
      "source_hash": "sha256:53ea72e3354dec7296fefc9c62f1800385b25ccace3b278fdd23d1fac6d6fc1e",
      "text": "那么就请听上一段♪\n咚咚锵锵哩个咙咚锵♪",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000049:dialogue:000": {
      "source_hash": "sha256:ecfaed31d936ae2e74c59b26f5401efb1d790eb3cab97a4a0d0a62e1b3e21cd1",
      "text": "喵呼呼～♪觉得怎么样喵？\n吾辈的新作落语！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000053:dialogue:000": {
      "source_hash": "sha256:587e2024ecee3d3314b894167d5752b095b66bfea408652f88acd4801d598d7d",
      "text": "真是太棒太不可思议了喵！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000056:dialogue:000": {
      "source_hash": "sha256:7b7e23a49dd37bafbd36e7cf7ccfc9f2837f745bf7e95d93be9721903594989b",
      "text": "喵——……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000060:dialogue:000": {
      "source_hash": "sha256:7a50e8cdfacb49cd62b241594372947d77431811c90b9cecc4a05787e17aa575",
      "text": "喵呜！？\n想要更新颖的段子喵！？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000066:dialogue:000": {
      "source_hash": "sha256:2ab269e01d37db898e497d367a144d9c7b8911f93e5d85bb4ce238b4f8ee6bc6",
      "text": "唔唔——……其实吾辈也\n刚好在这么想喵……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_f:cmd-000074:dialogue:000": {
      "source_hash": "sha256:00ba83d867fc3c61b3862cbe05ca77f7295411ac9eca26029005d1f2e4085c58",
      "text": "让人眼前一亮的特别段子，\n到底掉在哪里了喵～……",
      "status": "draft"
    }
  }
}
