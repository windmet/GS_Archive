{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_01_a",
  "source_raw_hash": "sha256:f2be0535de1ec587c69cf08e2d2a165420b861591c1041f8621ca48f6995946e",
  "entries": {
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:dae069f5408db1881b617a8719e91608c60e74070cf37e26b0724a2d7d122d66",
      "text": "各自的开端",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:d6ea179924b110a125f4535fe6c425aa824e902cd6b4220e420841a3a8088f10",
      "text": "观看歌舞伎演出后，桐生被翔真夺去了心魄。\n另一边，参与电视外景拍摄的翔真\n为自己未能出演主角而感到不甘。\n九郎听闻了新锐落语家桐生的传闻，\n开始重新思考自己该走的路。各自的开端。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:dae069f5408db1881b617a8719e91608c60e74070cf37e26b0724a2d7d122d66",
      "text": "各自的开端",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:a94500cbc1876afc5a90fdf25e8eec85b711a786802edad1c631dd27a8c9cfc9",
      "text": "哎呀，真不错喵～。\n歌舞伎《弁天小僧》！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:5df4a313233a7d7f9213ea69ef4e52c5fb77c113e5453f41f98663b57ec2fde9",
      "text": "喵！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3710ef0a7bc61f8b63da33b216b76992ecfb8f47ca7cde2a84ad355920c10fac",
      "text": "虽然早就知道剧目喵，\n但亲眼目睹又是不一样的妙趣喵！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:53ec45cd19ff3622ee02c68a2e5bbad0a1b8ead570fec84dd0c15451f05b6d78",
      "text": "感谢送戏票的老主顾喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:4e93860dd9d9878025b934cda96099af23e65ea3c8e5c2b28756cc60bd68949e",
      "text": "“要是不知便讲与你听”",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:eb237942bcc3a1dbc9880fd97f50aaafc1558ff90c9fc88350504de243c3f21f",
      "text": "“弁天小僧菊之助正是老子我”",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:f81c2e1d6884efcc5b16cc95b2f6ae15338b37bc6bda84e231211d54ef29a964",
      "text": "接着，演员在这里摆开亮相架势！\n真是让人欲罢不能喵～。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000053:dialogue:000": {
      "source_hash": "sha256:12790ddbc0567d4cfd528ac85e7ffa9018faf7852bcfd7232c9595d7d377ffc0",
      "text": "吾辈到现在还兴奋不已喵。\n喵喵～……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:c5f0a3598822aa444305a6ab67cb366486c4b22d7842bdf1f75ed13f98339676",
      "text": "对了喵！\n今天还有意外的收获喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000061:dialogue:000": {
      "source_hash": "sha256:9ec1e1808690f587230d5c433411371d171b347dab6ba95c58cdc447628953eb",
      "text": "呜喵……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000067:dialogue:000": {
      "source_hash": "sha256:6a54eafdc46e0a73493eb5167fe60344b0e75de331852c371d69ba7a0f7ac76c",
      "text": "主角的弁天小僧自不必说，\n还有另一个角色也让人很在意喵。",
      "status": "draft"
    }
  }
}
