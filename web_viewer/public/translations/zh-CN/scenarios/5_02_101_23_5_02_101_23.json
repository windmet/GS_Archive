{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_101_23_5_02_101_23",
  "source_raw_hash": "sha256:a1a79cf16ff237bfc3ebd9191fb7821efebf043b78bf76eb98fb823265dca6ec",
  "entries": {
    "story-text:v1:5_02_101_23_5_02_101_23:5_02_101_23:cmd-000012:dialogue:000": {
      "source_hash": "sha256:d3dcfedb7b207ad9246268e32fff6d3094afa7db42cf5b8850429716539abd79",
      "text": "啊，●●●●プロデューサー！\n能耽误你稍微一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_101_23_5_02_101_23:5_02_101_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:4a40a6ed8fa5feeea1ebe298cf27db2c4e1aebfc186692d73c62bac9c8ab7433",
      "text": "情人节时倾注了热情的\n精美巧克力，非常感谢你！",
      "status": "draft"
    },
    "story-text:v1:5_02_101_23_5_02_101_23:5_02_101_23:cmd-000021:dialogue:000": {
      "source_hash": "sha256:4c651e9a2067792b8683ff407ee98f0135929b28576ec891757af507a4a14a3e",
      "text": "这个，是我给你的白色情人节回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_101_23_5_02_101_23:5_02_101_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:ce9f8e962eea3e70a6cf2d0057398538300cbdbb4d53a94d244f33ba0108992a",
      "text": "今年也是全心全意挑选出来的。",
      "status": "draft"
    },
    "story-text:v1:5_02_101_23_5_02_101_23:5_02_101_23:cmd-000029:dialogue:000": {
      "source_hash": "sha256:1d8497f8593a9c912a516679af212e59ea2ad2242f5b45e2071683f19569d5ba",
      "text": "要是能合你的心意我就很高兴了。今后也\n拜托你多多关照了呢，制作人。",
      "status": "draft"
    }
  }
}
