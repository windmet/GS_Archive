  "scenario_id": "1_5_040ren_1_5_040_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000010:title:001": {
      "source_hash": "sha256:12691fd7706fe13351861e747d6f7de7a7999f4eff33bf0f7adb7a7443ffee54",
      "text": "报道拓展运动项目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000015:dialogue:000": {
      "source_hash": "sha256:1718a8beba7a9353eabdf693dff6742b5289d25970904d6506d58d54507ff1df",
      "text": "凭什么本大爷非得被带到\n这种深山老林里来啊？",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:6c775b50c654c058cfd2b01fe2c472b8547b0e16373e417cb8dad80a3cbf5b6d",
      "text": "这次的工作，是要报道户外拓展运动\n主题公园。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:b4d9bab88c61f733a4f00b80506939055a57bb70db44c3f98197e395ad4f6313",
      "text": "哈啊？拓展运动什么的，不都是小鬼玩的把戏吗。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:c271eaa5a6ca7838f326b74724833d4d3798cbee1bcbdfd3139db7066f2f2ce1",
      "text": "拓展项目分好几个难度等级，据说最高难度\n就连大人也很难通关呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000028:dialogue:000": {
      "source_hash": "sha256:b8cf6e8964b9ff36a3763fb83c4af4c465029065ce2ae6f54b56d3de5f5bab33",
      "text": "听说实际上能通关的\n也就只有几个人而已。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:c1fb17c70c57fdaae3a7c516ea301e1bb8adee2215e874d29b87ae1ce9264171",
      "text": "哼，管它什么最高不高难度的，\n本大爷怎么可能会通不过？",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:941c9326ea9d24db3b2b1ab018395daa17f507d022f6bcf3d068edbffab1dcba",
      "text": "本大爷分分钟就通给你看！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000052:dialogue:000": {
      "source_hash": "sha256:2d073234d4cfdd51fcbe1fd1ed12c3413391a6c1ce725f653da6183d478e4059",
      "text": "嘿咻……",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000057:dialogue:000": {
      "source_hash": "sha256:b5f603fd95b2b2e02025aadf26b13eab70be0a6e1db7785914d338989e24b142",
      "text": "库哈哈！只要本大爷一出手，\n这点程度根本不在话下！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_03:1_5_040_03:cmd-000061:dialogue:000": {
      "source_hash": "sha256:1ddb5fcfadd2e310c8e305feb007ddbd57fab1c32aaa974650f54576c3c70130",
      "text": "轻松通关确实厉害，但是……\n涟先生！也别忘了还要做报道啊——！",
      "status": "draft"
    }
  }
}
