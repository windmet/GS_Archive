{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_029ass_1_8_029_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_029ass_1_8_029_01:1_8_029_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:75d2414b2943133cd071721c81e75bf134dccf5dfea59decf24d11ede1196158",
      "text": "库库库……今日乃吾主降生于世之\n值得纪念的大喜之日！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_8_029_01:1_8_029_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:679d20bc610e6c6edc88d7ba25af742622736bb76d6808ecc7fd806ebf25fdbe",
      "text": "并非仅有吾一人。\n堕天使撒旦亦在恭贺主之降生！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_8_029_01:1_8_029_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:8769582cdc65033ce759d39030e020bdced9bb787d8e3d583bdec4115f0a4cec",
      "text": "阿斯兰先生，撒旦先生，\n非常感谢你们！",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_8_029_01:1_8_029_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:9b5fcd62c2dcf65b3cd900ca03543c232b222a4e831fe477a4df9f9724930936",
      "text": "然也！吾等乃生死与共之同胞。",
      "status": "draft"
    },
    "story-text:v1:1_x_029ass_1_8_029_01:1_8_029_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:506763505bce823fa10e7191db0174ae8b04ef9a0a1c75f08ab751c1f6f7906e",
      "text": "今后亦当聚众生之力，将光之民之灵魂\n染尽为漆黑之暗！哈——哈哈哈！",
      "status": "draft"
    }
  }
}
