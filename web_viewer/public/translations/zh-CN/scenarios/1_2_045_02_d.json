{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_045_02_d",
  "source_raw_hash": "sha256:00fc334c2f677ca87504f83b3bfa2f65d4e44806b0dc7e1a14e4f92d46f2757d",
  "entries": {
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000018:time_caption:000": {
      "source_hash": "sha256:4f2779204452ccebfa174c8b5fc5391ea2dad8ac3c25f4b332dde71c393d55e1",
      "text": "大学停车位",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000029:dialogue:000": {
      "source_hash": "sha256:0136aa6bd64c6174d6e625afbeb3de97359f68827d29467272a2ff9df72a3b44",
      "text": "哦，来了啊。辛苦啦。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000032:dialogue:000": {
      "source_hash": "sha256:652ef00d49d844542e36ef53f2b31fe50816ec74794eb1d6470378d5d0d76736",
      "text": "辛苦了。\n想乐，等您好久了！",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000048:dialogue:000": {
      "source_hash": "sha256:279ab6e4b45cb806123c3545493ab449cdab2074d992320e4f1ba0d1a5dc3afe",
      "text": "为什么你们两位会在大学……？",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000052:dialogue:000": {
      "source_hash": "sha256:5ed63df2a47d5afb1c01e44951ae7a78c4a7ce426bee9bf198a07ff3fa8789ce",
      "text": "刚才不是才刚在LINK上发过，\n说在事务所等我吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000059:dialogue:000": {
      "source_hash": "sha256:74be76ea39ab3175fea7a599f6446f608082ea83c3465b004566e689d23ad8df",
      "text": "吓了一跳吗？我想着在特别的日子里搞个惊喜\n也是挺不错的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000063:dialogue:000": {
      "source_hash": "sha256:b4dfa59a9957cd9f6359cbfe809768f3471c0916c46ea79c372a761432ee2699",
      "text": "刚好想起来古论今天说过\n要开车去事务所来着。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000067:dialogue:000": {
      "source_hash": "sha256:53a15beca8991853f022dffb2c728ed318c953c083faddd9e51c36976ba0d993",
      "text": "于是我就提议说，\n那干脆去接北村怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000076:dialogue:000": {
      "source_hash": "sha256:47820c840762efc030c1c28914c64e2a4e7ad0c1b294f538a722a98945805c97",
      "text": "（……这个。雨彦先生肯定是顺着克里斯先生的\n提议借题发挥了吧～）",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000081:dialogue:000": {
      "source_hash": "sha256:f2a58b27a9dddaff4ebdfc5c84404c9d90552151b26270fb5933c022ef1e2c13",
      "text": "（真是个狡猾的大叔呢～。\n不过克里斯先生纯粹是一片好意就是了～）",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000095:dialogue:000": {
      "source_hash": "sha256:6d1d1df7c03ea7832b54bd12eb11d54e13899e45ac112c16b43d109f6b52384c",
      "text": "嗯。真的吓了一大跳哦～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000101:dialogue:000": {
      "source_hash": "sha256:7e86ae8a174bbf74a1a7c463d5c9ca4601d8ab0ed5e569ad8761770a5bb17abf",
      "text": "再次祝您生日快乐，想乐。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000106:dialogue:000": {
      "source_hash": "sha256:0c2c056260797a94efea705668f956c11bf0f997c93112d0bf204a01de543624",
      "text": "生日快乐啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_02_1_2_045_02:1_2_045_02_d:cmd-000110:dialogue:000": {
      "source_hash": "sha256:dd8d077e9ebd198bd4c10bb969a47e0549c70467b847b03187324bf1f45ed28e",
      "text": "谢谢你们两位～！",
      "status": "draft"
    }
  }
}
