{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_025_01_d",
  "source_raw_hash": "sha256:546d69223253edede373a6f7e8d3ed7f92554e5bfe548674023e6ba53aa95bbb",
  "entries": {
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000015:dialogue:000": {
      "source_hash": "sha256:7d64be082552a40f9a18dc523ff76d43bff3346e3002657b60c9f2c0f9adafe7",
      "text": "除了打倒恶徒之外，我也常觉得\n坚持训练真是太好了呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000018:dialogue:000": {
      "source_hash": "sha256:91e50db24d8dfabce096317bf863f510ed1dffca9d608681db908bd0a7d0dc45",
      "text": "因为在偶像的工作里，\n这份力量经常能派上用场啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000023:dialogue:000": {
      "source_hash": "sha256:875abf63d968721f0df9148aa49bc9d2d1aba843ab0ad04140119490bcc11326",
      "text": "今天这份工作能拿到邀约，也是因为这个吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000027:dialogue:000": {
      "source_hash": "sha256:37df1445d2240651c18ed331699ae66cb44de0e4219718f46e290c8e38e8cf68",
      "text": "是的，一点也没错！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000031:dialogue:000": {
      "source_hash": "sha256:7e7bd82c50b6ddb89885648c8e4364f292652d99ca0d4276a64f87959234ce23",
      "text": "是看到了朱雀先生发挥体力和力量的表现后才发来的邀约呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000036:dialogue:000": {
      "source_hash": "sha256:2337a7a65919a8248600d588c72b6010bc2de4cc9f994d15612a9f43270c960d",
      "text": "自己之前做过的事能引向下一份工作，\n真是一件值得开心的事啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000040:dialogue:000": {
      "source_hash": "sha256:5d605b3af54da0c0fba39bcf03928183778934630d272d561a5ec3829e687b72",
      "text": "嘿嘿，今天的工作也要像那时一样\n绝对要大获成功！！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000044:dialogue:000": {
      "source_hash": "sha256:033f7be18e9b9ff324ace80a37fa8967638f1712dc09a7bd36147111ac821d43",
      "text": "就拜托您了！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000049:dialogue:000": {
      "source_hash": "sha256:35e8a5c214395024b2fb29cbb9fd61c71d7ae32a96d983a97e2b1e99cde24d1b",
      "text": "今后每天早上的训练我也会继续下去！\n毕竟训练之后的早饭还是最香的啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000053:dialogue:000": {
      "source_hash": "sha256:6091933e438cb1e56cc04673779cb0b68581015041bef6f6748eafe7a5506bc7",
      "text": "喵——！",
      "status": "draft"
    },
    "story-text:v1:1_2_025suz_01_1_2_025_01:1_2_025_01_d:cmd-000056:dialogue:000": {
      "source_hash": "sha256:67448ba35916180764330a3a2fb2302de0f204b51b4d42062c50da1407a8e668",
      "text": "哇哇！？",
      "status": "draft"
    }
  }
}
