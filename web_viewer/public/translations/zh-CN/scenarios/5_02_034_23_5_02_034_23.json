{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_034_23_5_02_034_23",
  "source_raw_hash": "sha256:2791e6ad043ba3651ef3ef2bfd0479131b8fe69de5ef4e1c9fc9c8b6d8107fd9",
  "entries": {
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000013:dialogue:000": {
      "source_hash": "sha256:871e3f99de9cc0d36fdb1a1cdb3cac2293357c6b12d874fa4b60768796d7a45d",
      "text": "制作人，情人节谢谢你！",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:460d4981463357c4e21a7d898f48fb53a4c0f4af810cf98ab3c21699f91e73a9",
      "text": "今天作为回礼，由花音来为制作人的衣服\n做穿搭搭配哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:b8b0182dd191a5c739b945eb341abbbedc3a577ef916a72651778988638f705d",
      "text": "非常感谢。会有怎样的穿搭呢，\n我一直都很期待哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000031:dialogue:000": {
      "source_hash": "sha256:21354eeafa1354f1c9dbc09097ed760b298c1a3c6242ed4cf7a0ca8fa0afb191",
      "text": "真的吗？\n能听你这么说我好高兴呀。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c2b92989c6903008a3c3823c491f8b5818f2ea2ad359ba7cb6b71898cc2b3a1c",
      "text": "花音前几天特意来提前踩点踩过线了哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000041:dialogue:000": {
      "source_hash": "sha256:88b32d3c593d3cef5f1d679791f7691832315b9ff2816f37050f239ed069791e",
      "text": "感觉适合制作人的服装店，\n我也挑好了好几家呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:96314ef1761f6e53b27827a949c5da92cd6edb350abd6e433a889fe033e1019a",
      "text": "给。这是楼层地图！\n首先看这边的店，然后去那边……",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000061:dialogue:000": {
      "source_hash": "sha256:39a512e3b9f12eaa58b72471643f145710210dc3ebea5014c8f14387f5e44be7",
      "text": "这边的店铺隔壁就有咖啡厅哦。\n途中也想顺便喝喝下午茶呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000066:dialogue:000": {
      "source_hash": "sha256:0e53de0458978a53305161f6d28c6fda043ee307762a63dc643eb699784a9821",
      "text": "当然可以。",
      "status": "draft"
    },
    "story-text:v1:5_02_034_23_5_02_034_23:5_02_034_23:cmd-000074:dialogue:000": {
      "source_hash": "sha256:3fb097d4ae2a7357e30484b54c5182563780d2579ac17e031f8b4c5daafa27a2",
      "text": "诶嘿嘿，太棒啦♪\n那我们出发吧，制作人！",
      "status": "draft"
    }
  }
}
