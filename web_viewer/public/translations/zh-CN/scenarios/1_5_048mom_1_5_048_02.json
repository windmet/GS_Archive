  "entries": {
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000010:title:001": {
      "source_hash": "sha256:2769a77042f815b4614084bc0112bece25e05668cbb8cf2febfb9d270627f35a",
      "text": "在杂志采访中宣传歌曲的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:98a5bdccbff2292ffa5e46910d7873367d1012467a70f59a668854845d62ccfe",
      "text": "百百人先生，今天是要接受杂志的采访。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:c9e1c70e21fac8164986b1cdad6acd8b6d9983379da81026be404a65c46cc920",
      "text": "是要宣传我们的歌曲对吧。\n聊些什么好呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:1240153b19639ea18618f8f2791a6327fbaa5b9225161e3e820dcc07d4169916",
      "text": "顺便聊聊组合的事情，\n你觉得怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:a656242a3888c7a29ac3be4089d651c6c420f95ba0695dbee01c3f97d317d664",
      "text": "聊聊他们两个啊～嗯，或许也不错呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:02227b1aa27b9c56479fcc3a59ed1332980e73fb319fb9096ca90c5ed8c38b34",
      "text": "两个人都在学校担任学生会职务的同时\n还做着偶像，真的很厉害呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:cadb0eac3b25061b0fcf5d4fac4a6a11fdfb7634dd472659f55320f94ccac886",
      "text": "要这么说的话，百百人先生也是一样的。\n我觉得你非常了不起！",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:42f604b155390f438fb91e6ec6c147e02bd885f059325dbd53a6461b6ce3fd97",
      "text": "……嗯，谢谢你。呵呵，\n要是采访顺利的话，你能抱抱我我会很高兴的～",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000053:time_caption:000": {
      "source_hash": "sha256:9f5959c5aa3af249affc0cf7840ec055c68bafe577366933094869c837f9989d",
      "text": "采访中",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000057:dialogue:000": {
      "source_hash": "sha256:0937e4022c02a2ebc2d79dcad3a5af9a4a7468b242548d89b5cb35eea5244507",
      "text": "虽然也有遇到困难的地方，\n但最终做出了让大家都能认可的作品。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000063:dialogue:000": {
      "source_hash": "sha256:439669ba3c8065093281775b556e7ab8a63b67b7a7fb92d266420a82212a64c3",
      "text": "所以，希望各种各样的人都能听一听。\n如果可以的话，也希望能告诉我听后的感想呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_02:1_5_048_02:cmd-000067:dialogue:000": {
      "source_hash": "sha256:65cfbefec9b0c45fcce5f51c32b4d033d78241caea1e8ab2104b12b59c26182e",
      "text": "（百百人先生的采访大获成功！\n访谈公开后，在社交平台上引发了热烈讨论）",
      "status": "draft"
    }
  }
}
