{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_402_2_4_043_02_09_b",
  "source_raw_hash": "sha256:f07a2473905de16863d14c2f4957af13462d937b8700a0be44c0640efea8a84a",
  "entries": {
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:378d2e06fd863f2204aacd2a569e5c15f77a34a6d6f218f2dc91cf084bc6b8e3",
      "text": "……●●●●プロデューサー，辛苦了。\n在鬼屋吓到了你，真不好意思。",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:d67bf85736fd7316a3438f53efcfc1ad1200065ee285ebcb97dcbb5e0973a98a",
      "text": "……虽说算不上赔礼，但我弄到了一种特别的茶，\n你能收下吗？",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:c946d8498a67acddc488ffa23169c32e1290f1eca5324c3c8d79b69e47c1c6f9",
      "text": "特别的茶？",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:7f5d8e5ec196c0fe8a29b68e571157c39410691c6091d0fd837b821a30a6e20f",
      "text": "……嗯。想着能给拍摄作参考，\n去附设的商店时发现的。",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:6a9765668a237f70d826ada09e5fba684dfe6b662e654fddebf98a5f52d98fd3",
      "text": "……配合这个鬼屋的意象，\n注入热水后好像会变成诡异的颜色。",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:039421d86622421d12c15a78aa49e68a2a72de31e75d8fbec4e242f68ce6b93c",
      "text": "……当然，说明上写着内容物只是普通的好喝茶叶。",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:5b2f04663fb418f75ce532fdf1bfeb38d937e6815c0d3e20a97bbbf24bb0b559",
      "text": "很好奇会是什么颜色",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000021:choice_short:000": {
      "source_hash": "sha256:93234b1f454a989ba7f7002999f8552b9157aaca70ea49a88a8a916062b9fff2",
      "text": "请务必让我尝尝",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:8d787be73d2df733dce5ca3aab21fa232fff6bb7c96a61981626bf0c63fbca8e",
      "text": "……回头我会放在事务所，你想喝的时候\n就尝尝看吧。",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:cfc1ea962f0fb3298d411b52b67b4ff92b75a49535238b85f1415ad1fa921d46",
      "text": "……今天的工作结束之后，\n我也打算试试。",
      "status": "draft"
    },
    "story-text:v1:043kaz_402_2_4_043_02_09_b:2_4_043_02_09_b:cmd-000029:phone_message:000": {
      "source_hash": "sha256:2657396e100aecbb9851f343a025fe32cf07dd143eba8ef221794de0d009833d",
      "text": "……那我回工作岗位了。方便的话，\n请务必让我听听制作人的感想。",
      "status": "draft"
    }
  }
}
