    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000011:title:001": {
      "source_hash": "sha256:f93f73182b2acc49be4c3ad759895a9a9f618cfe495c65b620815369e8632e6f",
      "text": "游乐园新活动报道的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:e8387cace3e5411fc93bf71fd16ed8f53bd8b97fe464173b64d070ba661a2209",
      "text": "花音君定下来要负责\n报道游乐园的新活动了。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:5187a55806551185e51995c70648c2d5e4c7f540ebf943ba3a364abab1cb36fc",
      "text": "这是游乐园的宣传册。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e1cf9970108cb40aa56117570f6e6182c3f4ce519b1a5d70666392bfc29c0be2",
      "text": "哇！花音最～喜欢这家游乐园了！",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:49b3d790fc50965cb3d094d4a053f429f786a2efccb7a1490d77a5b0ac18fcdf",
      "text": "游乐设施超级好玩，\n还有好多好多可爱的吉祥物呢♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:42db6464a6fd5db778e07af15b155d784739bc9f7cff6c8585850f79c194b8ba",
      "text": "每个吉祥物都很有人气呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:56ff5cd1e9dac4edcd61bb7565c522482790e47714a8b0187f2365d375149fd0",
      "text": "呐，●●●●プロデューサー。\n是什么样的活动呀？",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:67741d93a186f63b8fdfa8f810c0c9b64ec69b73e92867e3a2b71a31de92a916",
      "text": "是游客参与型的活动，\n可以和吉祥物互动。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:a0b29c4b9c774d19b31898c84509a2ac86e84cc05c88c77db25ce50e5487b357",
      "text": "对方说在工作前，\n请务必先亲自体验一次看看。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:d54c667923ca4fca9d682d7fdf95134211d2a465c056613aeed1379c3e4522cf",
      "text": "花音也能参加活动呀！\n好耶——，好耶——♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_01:1_5_034_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:8dffd73c896c7f9712e52744d9c87c377c5d44ca87a16814091ed912c2a4d5d7",
      "text": "好期待呀～\n花音会努力工作的哦！",
      "status": "draft"
    }
  }
}
