{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_040_01_b",
  "source_raw_hash": "sha256:6bd246d806eb5d311765e241f9e7d438bf5cdd6818c57f79d3bab017a8dbcdde",
  "entries": {
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000012:dialogue:000": {
      "source_hash": "sha256:70a0e4f1d143edff19d8616e57227701f6af6905369a0658a05112d45dfe66dd",
      "text": "涟先生，我来帮你整理睡翘的头发。\n还有，衣服上的褶皱也得弄平才行。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000016:dialogue:000": {
      "source_hash": "sha256:27dda92dde14c5f9fe3a3c02a6b9f2194e7ccf73670cde61cfdbb0b3357b5475",
      "text": "怎样都无所谓吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000019:dialogue:000": {
      "source_hash": "sha256:a812ad6f0ec9bce3a54ce0bbebab2baa858ad681e845b07755ffe4edc2a16e03",
      "text": "毕竟是偶像，\n仪表容貌还是要好好打理的。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:20ea0d1503fa357bf9cbf39fac516a2a99a3a0cf4a269b9d02bb0455517ee52d",
      "text": "那种事跟本大爷没关系。\n走开啦，大笨蛋。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:408fec870ae376caa176864d1b8155e573a2d5e5269fd844d28dee14b9235e85",
      "text": "比起那个……肚子饿了。\n喂，你，去弄点吃的来。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000037:dialogue:000": {
      "source_hash": "sha256:322b092e6857e0d68e222affd4971dee74223210351496202696d5c4ab1b9668",
      "text": "早餐吗。该怎么办呢？\n平时都是怎么解决的呢？",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000045:dialogue:000": {
      "source_hash": "sha256:23e76e6d31a5b0497a112da8f7bf6d0ddfe51eb35afc9a881e27115185cef36c",
      "text": "啧，真是啰里八嗦的……\n嗯？好像有食物的香味传过来。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000053:dialogue:000": {
      "source_hash": "sha256:77f09b0bb2eb6e6726c81d3b47f5052516cb1c091f8eb32617e9e4dbc83f75c6",
      "text": "嗅嗅……这边吗？不对，是那边。",
      "status": "draft"
    },
    "story-text:v1:1_2_040ren_01_1_2_040_01:1_2_040_01_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:570bda8242db4e5908fd4142f5aaee7e5827b746efc8307b7db3aea587b63250",
      "text": "啊！涟先生，等等！",
      "status": "draft"
    }
  }
}
