{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_040ren_2_1_8_040_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_040ren_2_1_8_040_02:1_8_040_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:c1b6cf97ade9fc7a67a99da5aaae9278dd9d04c62424dc64c907934176095320",
      "text": "喂，今天有什么事吗？拉面店和小不点\n从大清早开始就为你的事吵吵嚷嚷烦死人了。",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_2_1_8_040_02:1_8_040_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:46aff7cfe7cd40c693e697fe404a15246714360b5869bc94efae7dd6b2ef5121",
      "text": "关于我的事吗？\n大概是因为今天是我的生日吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_2_1_8_040_02:1_8_040_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:96b71042821eab409ae7b16ceb4db74908beea20afed161ac12aa24bd7b1bfcb",
      "text": "哼——",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_2_1_8_040_02:1_8_040_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:44a2a007a157cede0b080a4a75485abd501e218d83e0c976e0fde11b8e3b0aa4",
      "text": "也就是说有好吃的了？\n给本大爷的那份也准备好。要大蛋糕啊！",
      "status": "draft"
    },
    "story-text:v1:1_x_040ren_2_1_8_040_02:1_8_040_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:1feed32692bc9e7f178c626ca4918de183fceaf6b2156382c33ecb3013efaeac",
      "text": "准备好了的话，本大爷顺便给你庆祝一下也\n不是不行。喂，还不快去买！",
      "status": "draft"
    }
  }
}
