  "entries": {
    "story-text:v1:1_x_045sor_1_8_045_01:1_8_045_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f40fe1479a54a3abab7400b3a2e0709c4a6b4adf8399c6e0db02c43f5c8d1d07",
      "text": "●●●●プロデューサー，辛苦啦～\n嗯，是我哦～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_8_045_01:1_8_045_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:1eafe00130b7b659162a41d3ea64812a36ab7a29239461ee5bac3182b711f3a1",
      "text": "佳期祝辰至，盈盈笑语间。\n祝你生日快乐～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_8_045_01:1_8_045_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:f2567c500e36660c30445e1d14f812ec87063094b61560c72ff5f32b826e59b6",
      "text": "今天我去事务所大概会比较晚，\n所以就先给你打电话啦～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_8_045_01:1_8_045_01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_8_045_01:1_8_045_01:cmd-000022:phone_message:000": {
      "source_hash": "sha256:29f23ae692823f1d4d6be78b0334f47ad496d07d1d3de7af21d1610ed396dcff",
      "text": "不客气～\n那就待会儿见咯～",
      "status": "draft"
    }
  }
}
