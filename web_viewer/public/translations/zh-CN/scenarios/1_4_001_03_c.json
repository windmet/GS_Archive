{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_03_c",
  "source_raw_hash": "sha256:a60ea95d7d4b088efe580061107ee57a5e2b772c94100a57d962e87d23e25d93",
  "entries": {
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000019:dialogue:000": {
      "source_hash": "sha256:ea780998177a50503000d5bcb2d4c5147ebd8e04e7673d722068345b412a980f",
      "text": "那么……大家，我们上！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000037:dialogue:000": {
      "source_hash": "sha256:1270544d3ddd7d0286e5d28003ce0321fce660e90ba84d6c25e15da46940593a",
      "text": "……哇哦！秋山的吉他太厉害了吧！\n会场的大家都兴奋得不行了。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000043:dialogue:000": {
      "source_hash": "sha256:980349f839b2c6673e1c6b6ad154d975a609a4f0d2d7f7ff9a6564d33dbe1706",
      "text": "刚才那段演唱会视频，在我们官方频道\n开设纪念视频中，也是关注度最为火爆的。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000050:dialogue:000": {
      "source_hash": "sha256:b73515440156c6dbcacd7f765101cfb09443cdc8adc3a1329c36e204073f2602",
      "text": "演奏技巧固然不必说，\n隼人那闪闪发光的笑容更是让人心头一颤啊。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000057:dialogue:000": {
      "source_hash": "sha256:28b3990790c74b9c7126af7c32967d7f31f6acecd3c805a05ed7bc7cd10c6973",
      "text": "嗯。这种对自己所爱之物的纯粹直率，\n一定也传达到了观看视频的人心中吧。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000066:dialogue:000": {
      "source_hash": "sha256:89d336efd568d1f5f648ccf79f1ccf431b50d9971d152c3124079029657a8f64",
      "text": "这么说的话，前几天上传的健身视频里\n诚司先生也毫不逊色呢！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000074:dialogue:000": {
      "source_hash": "sha256:c53b86cfb59cace78d61341696cf803d7db3409468289344cac28d03593590a8",
      "text": "我只是按照要求，\n把平时的训练情景拍下来了而已……",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000079:dialogue:000": {
      "source_hash": "sha256:f21952481a44f5380cabd8ca3d4160ac73c93bdb75650b2447a78729ef1ed725",
      "text": "那份闪闪发光的笑容，可一点不输给隼人哦。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000085:dialogue:000": {
      "source_hash": "sha256:ba031271c19c74d7d85ec2f4cf0a0ef2cbb47ddaab5855dbbcd0568eadec9160",
      "text": "是、是吗。稍微有点不好意思啊……",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_03:1_4_001_03_c:cmd-000091:dialogue:000": {
      "source_hash": "sha256:9e586ba1cd5550f54db26a91d83135cd011569037ba6e6c8350a5ff3a38ee182",
      "text": "每一支视频一开始都只有1000次左右的播放量，\n但通过口碑传播都在逐步增长呢。",
      "status": "reviewed"
    }
  }
}
