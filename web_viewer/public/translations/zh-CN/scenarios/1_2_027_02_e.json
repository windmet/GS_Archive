  "scenario_id": "1_2_027_02_e",
  "source_raw_hash": "sha256:13c83e2760bd2fd0f5c8bfd1c1f283bcc8e7298975ef132d665915093cdcd4e1",
  "entries": {
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000028:time_caption:000": {
      "source_hash": "sha256:14aa353862a559339235870196d26ff1414421474374eb95b50ffdb5c34a87be",
      "text": "生日前夜……",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:7c61a4cf8d8ec174c1df7839240d1a74a42c1527d0e4fdd3c5b57e25234d0d85",
      "text": "……",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000044:dialogue:000": {
      "source_hash": "sha256:da2f7c5f97591b40db40c8f4eba82ec2599b051c930e00e9fe105ec591b32c1f",
      "text": "（……好，过零点了。\n来打开今天的降临历吧）",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000051:dialogue:000": {
      "source_hash": "sha256:1e11fc6baaeadb70c8007d01b74d50dfc0ce45fcf39958f077d4b735b345038e",
      "text": "（我记得他们说过，在生日前一天为止，\n都要在早晨打开来着……）",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000062:dialogue:000": {
      "source_hash": "sha256:aa7db56299da3be060826b8be7186dcd71dc910a7be2ab395f9dfcd6862fe19f",
      "text": "哈哈，被看穿我的行动了啊。\n那么，今天的是什么呢……",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000067:dialogue:000": {
      "source_hash": "sha256:84a18fe130b180e85ce5e0c1be2ec32dd33acfc96d7cb79ed850147987c3556f",
      "text": "留言是“生日快乐！”吗。\n大家，谢谢你们。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000074:dialogue:000": {
      "source_hash": "sha256:a0b1b180e95eed7d06d3f67acd25ab6864a603f711307a6a3e4e80d5283f5ebe",
      "text": "嗯？这个二维码是……让我扫码访问的意思吗。\n我看看。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000106:dialogue:000": {
      "source_hash": "sha256:da456d601f399002a61941d5e3bb05a6517b5fbbc92d54932f477e408f66b47e",
      "text": "生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000122:choice_short:000": {
      "source_hash": "sha256:da456d601f399002a61941d5e3bb05a6517b5fbbc92d54932f477e408f66b47e",
      "text": "生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000122:choice_detail:000": {
      "source_hash": "sha256:da7e2d4b40b63f98e9fc566d7b5145da923c16c638a22c9f1885bf030e4dc72a",
      "text": "appeal",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000130:dialogue:000": {
      "source_hash": "sha256:eabfb945b7eb4794b25ece07f2536f5aa2d9a6dcb5dc838f1dc63a9c798607e0",
      "text": "大家，还有\n●●●●プロデューサー也是……！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000145:dialogue:000": {
      "source_hash": "sha256:78c4d9239f6febc7699e91cdab7732347a360874696d5735afb3abd7cbbc683f",
      "text": "我和神谷认识也很久了呢。\n祝愿今年也会是硕果累累的一年。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000159:dialogue:000": {
      "source_hash": "sha256:b708eb5254c575ba87f00abf99b8995e85d45eadb02051041565a2df1bd2c99f",
      "text": "要度过Happy Pappy的一年哦！\n一起把每一天都过得笑脸满～满吧☆",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000173:dialogue:000": {
      "source_hash": "sha256:f39ef088a91785bdd84092b6f6cb1cb66b7e5be302e18a1aea68da842ce92f3e",
      "text": "愿接下来的这一年，\n对神谷先生而言会是美好的每一天！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000190:dialogue:000": {
      "source_hash": "sha256:51e0f427bf05ef82b53567bf93d2e531ce06cfb7b24c4fdeaf5d251874a808a0",
      "text": "愿汝之霸道光辉灿烂！\n想必诸多光之子民亦在如此祈祷吧！",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000210:dialogue:000": {
      "source_hash": "sha256:1cb3611f85a5a840f1ed3d88f7181d62d31a553707ac939e9340d45b70ea7734",
      "text": "今后也请让我继续支持幸广先生，\n希望您能有更多的活跃表现。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000221:dialogue:000": {
      "source_hash": "sha256:d3065277b5c90a79f31859481875f534c32895d3b530861be0d66f1d78d94dd4",
      "text": "今天下午会在Cafe Parade举办生日派对。\n请务必光临。我们恭候您的大驾。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000243:dialogue:000": {
      "source_hash": "sha256:a04bd34701d7299e6f6caccff95fdacedaafd8cd273dc04c0ddfcfead62b17bc",
      "text": "……真让人开心。",
      "status": "draft"
    },
    "story-text:v1:1_2_027yuk_02_1_2_027_02:1_2_027_02_e:cmd-000251:dialogue:000": {
      "source_hash": "sha256:e95ca5e21366940d3a77c0f709de4ada1ab321d67427297832ecd8935cd7da5b",
      "text": "多亏了大家，\n今天似乎会成为非常美好的一天。",
      "status": "draft"
    }
  }
}
