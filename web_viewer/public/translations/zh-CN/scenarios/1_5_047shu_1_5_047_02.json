  "scenario_id": "1_5_047shu_1_5_047_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000011:title:001": {
      "source_hash": "sha256:eb596a2d9c387fe6d2e9d1bbc69e153d43456896ab24ca385a155e6420cacfb6",
      "text": "在广播节目中宣传歌曲的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:6fa0f310c4cf2ecef1bfa71a6722c5ad5bf0c3be065aeb4069b68b2402a7d275",
      "text": "歌曲的亮点是哪里，对吧？\n那当然是，“全部”了吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:f7dfef58db893fb2996e9b248cbcf4cefb5325c6844604003bb1c02558c006e8",
      "text": "曲调也好、歌词也好、歌声也好，全都无可挑剔，\n听过一次不可能不上头。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:518a8c742df12d625f1ebabc61ef55d32edf2c67e20ffdb00a9af3a967453041",
      "text": "就是这么一首令人充满自信的歌曲，\n请务必听听看。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000037:time_caption:000": {
      "source_hash": "sha256:4f10f377623d30a2f8e6eef9924c2cd8b7962dcbd80ad5f1e46aca35a570d7f4",
      "text": "录制后……",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:4ccb0c00afd25e379286f7020e27cf225eeb7f782efdff4ba1b7103e24793d77",
      "text": "辛苦了，秀先生！",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:120260fcbfe85c735452ed48765ef6dcd0b2143826cfae3447f13b4c807522e7",
      "text": "辛苦啦。\n●●●●プロデューサー，感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:f17c0e0fa3ad683e0c1f134998098cf84447732194cf8b81645a2e6f45e5df12",
      "text": "表现得非常棒哦！工作人员里有人\n听了秀先生的宣传后对歌曲产生了兴趣……",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:5f8965c349bcbda68a39f8e19a68b1f9d498f621d54a485157e0166320bf29ff",
      "text": "说待会儿就要去购买呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:22db0f5ba8a7f16febcb7596b5cdb95d4536869a73656df60afe8c3a664b0f1f",
      "text": "哼——。听了那首歌之后，\n肯定也会想来C.FIRST的演唱会了吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:b94077688f7288402564b155eac95eb811c6186d0dd44808a2dcd337b6f1028a",
      "text": "对我们的舞台表现\n肯定也会产生兴趣的。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_02:1_5_047_02:cmd-000061:dialogue:000": {
      "source_hash": "sha256:4b943b2f47b674765cfd91a40a500d94c8b81655815b87f31dcadf182a6c1496",
      "text": "是的！保持这个势头，\n继续多吸引些粉丝吧！",
      "status": "draft"
    }
  }
}
