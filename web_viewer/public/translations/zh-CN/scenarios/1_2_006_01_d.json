{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_006_01_d",
  "source_raw_hash": "sha256:fcbdd55f454c8ae09e4be78b81d9abc62da371f3f1cf491c3023fc8f62c7f456",
  "entries": {
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000012:dialogue:000": {
      "source_hash": "sha256:84def67e766530b90ef1ae8e5aa17cfb222f848c8a596345131d016d6d127db6",
      "text": "您觉得如何？如果觉得有困难的话\n也可以回绝……",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000018:dialogue:000": {
      "source_hash": "sha256:1433b3b72f8f30d8681f4aa1ed2d20bdaaa5d59f178c5fd4548637f664d21e49",
      "text": "……不用，这种程度的英译完全没问题！\n译好之后我会发给您的。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000022:dialogue:000": {
      "source_hash": "sha256:eab2396fd042259357bc04b7c6b4b5b0eaa12ae744a0d87f4f3a8522c859e132",
      "text": "那就拜托您了。如果有什么问题，\n随时都可以跟我商量。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000027:dialogue:000": {
      "source_hash": "sha256:a40e7f54b7a8f9e1ce205fcff5c75e722808dd86345ea7446aa97e366020a66a",
      "text": "拜托了。\n然后，关于今后的日程安排……",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000035:time_caption:000": {
      "source_hash": "sha256:16216436c5b82da4dd0de41754414e2d7a9993afd63ae3cac590ed427f10856e",
      "text": "一小时后……",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000040:dialogue:000": {
      "source_hash": "sha256:92a1559717a75eb3fa0d3d8701abd5e5fb1b7239b81e0abe6b5422290dffe117",
      "text": "今天的碰头会就到这里了。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000048:dialogue:000": {
      "source_hash": "sha256:087c12676d59ee8325d2a957467d3f546a0a5cd5e840e8d439a239e5e33f440a",
      "text": "辛苦了！\n唔……啊，已经这个时间了啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000057:dialogue:000": {
      "source_hash": "sha256:f2ef0fd9af3744d5f2e1d60c2b73646adb724e541c47701b4fa1bc1df4440933",
      "text": "哥哥，肚子饿了。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000064:dialogue:000": {
      "source_hash": "sha256:3ebcca4dd8b52e86dec3bb751737077db1b7e6728b8fc1716409a5f4a626b297",
      "text": "乖乖，吃点点心吧……啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000070:dialogue:000": {
      "source_hash": "sha256:a6577a9caf2e839b8eac9d0719827c9f1bdfe2546ede68e5947d627921d57513",
      "text": "（肚子发出了好大一声咕噜声……）",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000078:dialogue:000": {
      "source_hash": "sha256:259714cc2383fc0f4c5ef2f34b1d708574ff7554f8ba29819b527253c4414bb5",
      "text": "啊哈哈……对不起。\n我也肚子饿了。",
      "status": "draft"
    },
    "story-text:v1:1_2_006tsu_01_1_2_006_01:1_2_006_01_d:cmd-000085:dialogue:000": {
      "source_hash": "sha256:e3a3f0c23fc4ad4c0544d60f19936d5bd76042ac09ff9cb2452ddd3982114b16",
      "text": "不介意的话制作人也一起吃点\n点心好吗？有很好吃的饼干哦。",
      "status": "draft"
    }
  }
}
