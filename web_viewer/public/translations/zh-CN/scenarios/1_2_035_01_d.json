{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_035_01_d",
  "source_raw_hash": "sha256:ff5b4d47c8b4897e3354858d13c91a63fe527c7ccccfdd18a8b02c8e1796c6c6",
  "entries": {
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000012:dialogue:000": {
      "source_hash": "sha256:17fb9fc84ebf29c970b47165f45f49e7369dce0b132d19aab756bef8d4b1636f",
      "text": "接下来就是视频的标题了！\n您有什么想法吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000016:dialogue:000": {
      "source_hash": "sha256:2536d4ce90eb9a7508ab9ca25f00327a80f8076b64d73d7ac0f8bf65061aaf69",
      "text": "嗯。关于那个我已经想好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000021:dialogue:000": {
      "source_hash": "sha256:c0a4141cb1d39fad50bd0ed4922e9f31c8c8d6e3212645acea839b283bdf7e9f",
      "text": "叫《硲道夫的SIF！》。",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000023:dialogue:000": {
      "source_hash": "sha256:2a7f846d023a0c87e95575c17f16adfc9ac1cec5cc1a35b1ca32eb6e866f43b6",
      "text": "“SIF”……\n这是取了什么的首字母吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000028:dialogue:000": {
      "source_hash": "sha256:377f557eadf26038f0103987a1c0ae1d0bd4fba54851d6c71c80fb6cac7baeac",
      "text": "是数学 is fun。这样一来光看标题，\n应该就能让人感受到数学是一件有趣的事了。",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e56f0459189b1ea31293365ac23218793fa83449eee4331cd434934cb6c4554b",
      "text": "真不错！为了方便在社交网络上分享，\n把它做成话题标签怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:4a9a0a5c97b5f12bff57709cf95616b1a903c7ade3c4cd180117a0b34049130b",
      "text": "话题标签。有了那个，带相同标签的人\n之间就更容易找到彼此……好提案。",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000044:dialogue:000": {
      "source_hash": "sha256:2948596754e952ba18f161606c075df4f6b9c99f91e00574079b9f5ea161e41d",
      "text": "……总结一下，\n视频的标题就定这个了吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000053:dialogue:000": {
      "source_hash": "sha256:722a1a29c1c859fba1bfb52512e05f1bec8220dcb1625bd9ea6c715d71372732",
      "text": "【#SIF】硲道夫的SIF！【315ch】",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000058:dialogue:000": {
      "source_hash": "sha256:c6e6df1a95f0833de7c94b6fc9efc1acd6a5296754b1466e7c93702343317204",
      "text": "喔……！变成了一个很棒的标题呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_035mco_01_1_2_035_01:1_2_035_01_d:cmd-000062:dialogue:000": {
      "source_hash": "sha256:8355b8fde179d226feed51fd58bf9af4441d28db57f4d8b87daf577ba5f1c8be",
      "text": "是啊。多亏了你，显得时髦多了。\n这样一来，想必年轻人也能产生兴趣吧。",
      "status": "draft"
    }
  }
}
