{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_022_23_5_02_022_23",
  "source_raw_hash": "sha256:5b26bb4bd2aea620c39eceaadb8278578095b468667ed7e8d88f0609bd39a2d0",
  "entries": {
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000014:dialogue:000": {
      "source_hash": "sha256:113f9effb54f92a74cdb5ae7969681e999b59f97b3eb079b7d30f3807c57b2ea",
      "text": "制作人……今天，\n是白色情人节，对吧……",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b31a5d3a67e1d04c9e92fc0a82a10b628c4c184a559016e7a0e466941478d00c",
      "text": "情人节的时候……\n好吃的巧克力……谢谢你。",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:66511a590d4dff0e517ba6960a61cc158d5696acc7e94b79e3dc2785eb29791f",
      "text": "作为回礼，这个……我也送给\n制作人巧克力……收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000029:choice_short:000": {
      "source_hash": "sha256:e34cd602481290314c37a2d7e09ac03899c53eddcec0c18bf984aaf5c09591d2",
      "text": "非常感谢，真开心！",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000030:choice_short:000": {
      "source_hash": "sha256:05ddea67410fafc5a826eb0816824ca2bfce6cea0304c84673cff434d146b88a",
      "text": "好棒的巧克力呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:63b70737d63ee5a7e6b1eda4c02e7e1f633b999f084b1ea5b72229f3f26b2603",
      "text": "呵呵。你能喜欢，总觉得……\n松了一口气。",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000043:dialogue:000": {
      "source_hash": "sha256:6d512a7d14856b298299fa0c9fcb9d96a9e47fb1356aba51e28c753100fc2fde",
      "text": "如果制作人能露出笑容的话……\n我也、会很高兴……",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:c5768bb6dbdc98fd40d9bcc75579c2533a787e04ddf23aa445bc19e6ae767445",
      "text": "我……能和●●●●プロデューサー一起工作，\n真的……超级开心的。",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:13bef2341c42fbaa347de15d19a2210998e028527e79ff1b3d7e6b9ffcfdb0d7",
      "text": "所以，今后我也会……好好努力的。",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000057:dialogue:000": {
      "source_hash": "sha256:14a986a749493d70447ecf29b99e4cc728773e81e01d07c2a3137dfbb59e7ffb",
      "text": "好的。\n我们一起加油吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_022_23_5_02_022_23:5_02_022_23:cmd-000061:dialogue:000": {
      "source_hash": "sha256:6da4271a0557fddbb9532c46f626447ebbfb54fba46d2f77a2013c90fcb96ee2",
      "text": "嗯……请多关照了，\n●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
