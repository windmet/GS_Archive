{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "032nao_402_2_4_032_02_09_b",
  "source_raw_hash": "sha256:fefae547d0b78f22b34b346cf784a38ed38cd1307ae4799658435075fdedcdd9",
  "entries": {
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:8b1f4d16dab47146b5cf877a22c32ef857d84776e7e4a00bbd6cb9707f29ea2f",
      "text": "●●●●プロデューサー，辛苦了。\n明天您会在事务所吗？",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:ab32208050c2f51e87a10b554f30f2c7c1d653e2d2232d90645ce74185a7f2bd",
      "text": "在的，会在",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:21132d0f0939bc0a839f1430308a23c967031b3123495ecd7bb0f3544c3c26cd",
      "text": "最近我和大家一起坐着宣传车\n去了各种各样的地方，",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:e0407aadcb9678a5e9dd0dca0535ae54126d887ec66bfe139485e93614aa81b2",
      "text": "一起逛特产专区\n已经成了惯例呢。",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:2fb4abc210c064f72027859c5c041b3c72936336628d410a5d7b5abb87bd49e9",
      "text": "我买了想送给制作人的点心。",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:faa5406bce43cdd5220175d2e02311afe5cdf08254626ff132a93f92dd167f2d",
      "text": "今天见面的时候不小心忘了给您，\n明天去事务所的时候我带过去。",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000019:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "谢谢你",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:00ef4a691179f1bf0a19a508b4763f7725c837bfead4fe3832a2df6beda56433",
      "text": "我们也尝过了，非常美味，\n敬请期待哦。",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:be7fdd991f3264821728739166d1f96ccd8fb3d754b48ba1a62e18260c5aa4d0",
      "text": "移动的时候因为和大家在一起，\n所以特别开心。",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:630471d7aa9c9f7a00610654d0dac38b91c7fbc3cdce43fcee07012d8aff3f1f",
      "text": "如果再发现其他有趣的特产，\n我也会带给制作人的。",
      "status": "draft"
    },
    "story-text:v1:032nao_402_2_4_032_02_09_b:2_4_032_02_09_b:cmd-000028:phone_message:000": {
      "source_hash": "sha256:0a202b0e58d26cf868df31cd4140773f14df830164dafa6c10b70da4365e0cb0",
      "text": "那么，晚安。",
      "status": "draft"
    }
  }
}
