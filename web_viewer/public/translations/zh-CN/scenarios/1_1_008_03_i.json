{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_008_03_i",
  "source_raw_hash": "sha256:8d16fd07c45f3250a779fa1c07845eb79a27c06491e4fb222e41e1312c0fcfb5",
  "entries": {
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000020:dialogue:000": {
      "source_hash": "sha256:4eda983020b829e7d5db7d9307a98e4dc14e7928ebd13efacd54c3a23d0679fe",
      "text": "咦？旬，你不是回去了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000022:dialogue:000": {
      "source_hash": "sha256:a8a46cae3685319f4d6ec73f8eae48f20c212f0f59825aed9c35437c5a7b3696",
      "text": "只是来拿一下落下的东西。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000027:dialogue:000": {
      "source_hash": "sha256:b6512789ed6959f2b08585c5a20526d51e9036dcbf9c8d6ea1f7db766be59607",
      "text": "这样啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000054:dialogue:000": {
      "source_hash": "sha256:a8ab32991677ad6b2b5b1b5a4bcb7e3edc1439b246660fd50e3678b0aab6d1e1",
      "text": "这里按这种感觉来过渡……\n要是这样的话……这么改？不对不对……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000077:dialogue:000": {
      "source_hash": "sha256:9990737adff62758ed0a8ccf1cc12d51d22d07394279c46c5115cd208747b189",
      "text": "（啊，果然落在这里了。\n手机也找到了，快点回去吧）",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000099:dialogue:000": {
      "source_hash": "sha256:0721d17890fd12ece88b9abccf8344c1e46c1c882f50e20bdaaf9de38a84b1f5",
      "text": "这样？但要是这样的话，这里该怎么办？",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000108:dialogue:000": {
      "source_hash": "sha256:4175ec09841eb0369c72cf6b74381eae7166a26f1c39777773c10a0bad8643ad",
      "text": "唔——……这后面该怎么办啊……\n不行了，陷进死胡同了——……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000131:dialogue:000": {
      "source_hash": "sha256:52209f571553054842d9cbb1b079382425b825236da7dd02d0d0185016565334",
      "text": "隼人，能打扰一下吗？\n……比如，这样改如何？",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000147:dialogue:000": {
      "source_hash": "sha256:15c494c3290e25a765e5c98e80984ee75c0bc1df21b73df45f654a6af61cf01a",
      "text": "咦？啊，对哦！\n那后面就这样接着……嗯，好像挺不错的！",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000165:dialogue:000": {
      "source_hash": "sha256:3fefc76630d190cd2e661c8d52e45c8eeb07e1dd2287abfa3c4a2651ad408fba",
      "text": "谢谢你，旬！\n我一直在这段C段上犯愁呢，帮大忙了！",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000170:dialogue:000": {
      "source_hash": "sha256:0e65c66851b788ed9e014ecdfcbaf5c29d7898939048776a9061143a376bd5e8",
      "text": "没什么，举手之劳而已。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000179:dialogue:000": {
      "source_hash": "sha256:c76bbde96dde32b3094be6ecc29692a8ded87dbbee6acb69060affc74c2f8353",
      "text": "真的帮了大忙啦！真不愧是旬！\n就照这个势头一口气努力到最后吧——！",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_i:cmd-000191:dialogue:000": {
      "source_hash": "sha256:f60b8592a67aba9a226b5bd19fdfa42a968bb7717c52bb1fd949692caa4a0f65",
      "text": "……\n……我才要谢谢你。",
      "status": "draft"
    }
  }
}
