{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_014_02_a",
  "source_raw_hash": "sha256:66fec0f76dc7413574aeed9e8f48245ec24ccf0d1c9c8f592f2e9d4ab4c73319",
  "entries": {
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:bc8cee7f329649f8133b674104e20416b4245af745f445a297a462da6dc7e60a",
      "text": "3月7日的“特别工作”",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:68247e4b0a01e9fc0f9fe4ee3cd7717dafb20845c17ae2c66b61f3117dd6584f",
      "text": "英雄接到了在生日当天的单独工作委托。受到龙和诚司的鼓励，他怀着万全的状态迎来了当天，但在现场等待着英雄的，却是意想不到的特别工作……",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000018:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000018:title:001": {
      "source_hash": "sha256:bc8cee7f329649f8133b674104e20416b4245af745f445a297a462da6dc7e60a",
      "text": "3月7日的“特别工作”",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:4c807919d84799ecb511846c14574726d8c75981ccce31874e5b3d4f45bdf284",
      "text": "辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:1429ad4f63bd808d44b947b715b2a85ef8f8aa3eab133fad130f5f4a2f70a471",
      "text": "……我、我是最后一个吗？\n你们两个真早啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:fe1ecdcee94f6eaba2445e06acad26da929dec5e6a273b0d007a30b13451c348",
      "text": "是的，因为有点事。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:735130a89e86e8db9344f2155bb5d3842eb9847471334660eadc6b69139a141f",
      "text": "因为有些话想和制作人聊聊。\n我和龙来得稍微早了点。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000070:dialogue:000": {
      "source_hash": "sha256:6eac396bacbd66e5e0065c5336882e2e21b7253c75218bd948a72ee4a6450032",
      "text": "不管怎么说，大家都到齐了。\n赶快开始碰头会吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:4f0feee042273493e648a6ebc703bfe9fff4eda8588d913c6ae0a6c8a5c3d134",
      "text": "好的，今天主要是确认各自的日程安排，\n以及说明新工作。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000082:dialogue:000": {
      "source_hash": "sha256:05fd3472371306893a166d8f64263170b505a0c73892d38ab31fb8a4ce1ae233",
      "text": "我把资料复印件传过去！\n给，英雄先生这份。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000090:dialogue:000": {
      "source_hash": "sha256:0c7460e397ba67c07a2599a18e35ef62b8b8b0e6b53af152db70301bd1b1c27a",
      "text": "噢，多谢。\n……嗯？也有我的个人工作啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000106:dialogue:000": {
      "source_hash": "sha256:6fd43cc7870739dd3ec460cba6e093c286a8209d188bde1b7a23c8da6d5b365e",
      "text": "内容是繁华街的美食探店啊。拍摄日期是……\n3月7日……这天也安排了工作啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_02_1_2_014_02:1_2_014_02_a:cmd-000109:dialogue:000": {
      "source_hash": "sha256:94a322b069cb16f00323709b596b5593cfd425fd8f9a1e138f1c0fab96219c5a",
      "text": "哎！\n在英雄先生的生日当天！？",
      "status": "draft"
    }
  }
}
