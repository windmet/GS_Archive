{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_032_23_5_02_032_23",
  "source_raw_hash": "sha256:a5a8e299da34464447cbb1a0c3e206db8876b0760220ed43855245825f12f0d3",
  "entries": {
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000012:dialogue:000": {
      "source_hash": "sha256:4fffaf1c359c38c33aa91b8e0e066f6e8b15f18857e9e52444584035916ccfcb",
      "text": "●●●●プロデューサー，\n情人节的时候非常感谢你。",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:a3ce7d782f9832dbae371719abd3c6098b79fc9fc763b4e3a52ca8ccb31b9bac",
      "text": "不仅送了我巧克力，\n还陪我一起去买了东西……",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000022:dialogue:000": {
      "source_hash": "sha256:009c2a233f0277adf674f102cbe8a6573bc3abacf3e2d17ebc99626a4343caba",
      "text": "白色情人节的回礼选什么好，\n我想了好多好多，",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:67be22d4d00297689e702b0947f52010ae0c0880bf0d3465aded235ae410387a",
      "text": "但觉得如果是纯手工制作的，\n应该更能把我的心意传达给你吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000036:dialogue:000": {
      "source_hash": "sha256:0bc716fc2fe93de9f3fd9e6705273bf05c1bdc3c8d1c4e9cffdf17f349250033",
      "text": "所以这个，请收下吧。\n是用毛线织的笔筒。",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000040:dialogue:000": {
      "source_hash": "sha256:3f861a7fedc196c53a838bcdcf6a32ba9032569d9a2bd3d5a2397209fcec88ce",
      "text": "每天在放学和工作之后一点点织出来的。\n能赶上真是太好了……",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000045:dialogue:000": {
      "source_hash": "sha256:bcb2c3ea0bb036c6fbd235c6b8409ed71bdf715c8cccd243b817840a33e20077",
      "text": "超级精美呢！\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a95c45d3344ecab1469d9ae575a53a997bb3e7263198e448bae05b6efd87e397",
      "text": "真的吗？\n诶嘿嘿……真高兴。",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:da2c3b790bc833f649d2602819d8b431104bf8c35c398b47d10039b6c296d482",
      "text": "我会好好珍惜使用的。",
      "status": "draft"
    },
    "story-text:v1:5_02_032_23_5_02_032_23:5_02_032_23:cmd-000061:dialogue:000": {
      "source_hash": "sha256:f4340868bc8c9ca07f0dcad08730fdfe408e7692b51eca5fcfecb905c6e6d526",
      "text": "好的。要是这个笔筒能在工作上\n帮到制作人的话，我就很满足了。",
      "status": "draft"
    }
  }
}
