{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_001_01_g",
  "source_raw_hash": "sha256:121e0477e9e7518bd81297dda22d87acd0eddcaa7b3983cb575f847b9e0e6467",
  "entries": {
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000026:dialogue:000": {
      "source_hash": "sha256:4777a15814acd27ca6b17a06ecac769204bdace058117b09b2590b04fe0d4fe4",
      "text": "嗯——。那么说来，你唱歌很厉害咯？",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000028:dialogue:000": {
      "source_hash": "sha256:f7b95289b13de5da129fe361c151c93f81642ab158466cebfa871247a8dd58fb",
      "text": "还好吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000033:dialogue:000": {
      "source_hash": "sha256:d651922f2cf3f235710e659d4decd68729a10238f353e2cf1f92199df0ffd7f4",
      "text": "嘿——……不过，要是跳舞的话，\n肯定是我更厉害哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000038:dialogue:000": {
      "source_hash": "sha256:cf784dc8488275797d57732539b88ede2514867c53e9f09c9da31fe5111a0ae5",
      "text": "啊？",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000058:dialogue:000": {
      "source_hash": "sha256:fed2c820e802bec6eb52a6e27df9f44a69b0e94e631b8477dfe5a9009dd8e988",
      "text": "啊哈哈，我是御手洗翔太。\n那个……冬马君、北斗君。请多指教啦♪",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000062:dialogue:000": {
      "source_hash": "sha256:9fa22902a81855efeb0140c831b50cc39bba1c6176c0bd17f48f841f497c1acf",
      "text": "啊啊，请多指教……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000074:dialogue:000": {
      "source_hash": "sha256:77bc7c1c8853c13c36cce60d6dbfa282b80b1e2111039ff9a89af787ab0d235f",
      "text": "哼，都到齐了啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000082:dialogue:000": {
      "source_hash": "sha256:e6c082314007837132c77e05f00013d30f4b5ff702505792f8f62aeed54a5769",
      "text": "大……黑井社长！\n把我们叫到这种地方来，到底要干什么啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000087:dialogue:000": {
      "source_hash": "sha256:7f375d1ce5801bfb3a5147c297be92a2cc64666db9da9d6dbb991063b33fc4d5",
      "text": "把你们召集起来没有别的原因。\n天濑冬马、御手洗翔太、伊集院北斗……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000089:dialogue:000": {
      "source_hash": "sha256:438cc758ed45bf854ef46c0004948f18980d0b87e62fdeb72f573ba81a8606af",
      "text": "我现在就要让你们组成“Jupiter”\n出道，并君临偶像界的顶峰！",
      "status": "draft"
    }
  }
}
