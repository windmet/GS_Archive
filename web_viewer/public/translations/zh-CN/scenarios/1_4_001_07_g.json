{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_07_g",
  "source_raw_hash": "sha256:b19ab8d3da300ebacee47b3a61898377c939a862df73c671d6366b594aa904b0",
  "entries": {
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000017:time_caption:000": {
      "source_hash": "sha256:8d6903fc720dce3f035864ae78cabbd584b180f4a1c4d1a8f1df51c5e1d3110b",
      "text": "活动当天……",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000023:dialogue:000": {
      "source_hash": "sha256:74dac6c059d81fe9933ec830b1c3ea4ae7555a76379acf7cf3d5582a2610fa38",
      "text": "终于到了一日店长的日子了呢。\n招待客人这种事实在好久没做过了。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000027:dialogue:000": {
      "source_hash": "sha256:c822c627ecdc05a74ff29e9427f8fe0d32794ced98680e416f7862d13cff53f1",
      "text": "必须带着笑容努力才行呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000039:dialogue:000": {
      "source_hash": "sha256:195067e55da229d2a5c9028b8617f37e07e4c5d9d2ae68e953161ef27d0fcdd1",
      "text": "（笑容吗……打工的时候，\n客人经常说我脸上没有笑容来着）",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000062:dialogue:000": {
      "source_hash": "sha256:947077be6296d186c1a6924a194e79a8cda813f1c2184425992c0fb46e53f4a2",
      "text": "恭二，你在紧张吗？\n没关系的，有我们在呢！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000067:dialogue:000": {
      "source_hash": "sha256:1d8f4954d51910ad0c851dce114c3c9b57c48b7d87bf2ed6c7d9d8dd1e2c23f3",
      "text": "不是一个人，大家一起加油！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000074:dialogue:000": {
      "source_hash": "sha256:3c5f5d2b0bb6b1320c8f1a1b961fdf59bc4c82e8a426320db8d1b0ba56b87db8",
      "text": "皮埃尔……谢了。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000080:dialogue:000": {
      "source_hash": "sha256:ec0647008d7f2a54012db3684db182b934815af43d9a942e598c1f013f2f64fa",
      "text": "不用客气！\n这是你教我汉字的谢礼！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000085:dialogue:000": {
      "source_hash": "sha256:9c2dcd67940542c5837d943c357bb2cff28645b462ea61b8e03db3881094d997",
      "text": "好—。趁现在，\n大家一起来重新鼓鼓劲吧！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000091:dialogue:000": {
      "source_hash": "sha256:8b9e61640e6b01c416a2128f60157420bb40bc97eaf8f617c87c6abe3076cec2",
      "text": "鼓劲……要怎么做？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000100:dialogue:000": {
      "source_hash": "sha256:54e1fd9fccc3909583dd198b35b1388fbf668a6fc5e89419bf06d597ccc2af4b",
      "text": "比如把手叠在一起，或者围成一圈……\n对了！喊“嘿——嘿——，哦——！”怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000109:dialogue:000": {
      "source_hash": "sha256:3c6d508cf9f2384b320972a47d1d24be9af582d27b04e2db92f89a3b76b4deba",
      "text": "嘿——嘿——，哦——！嘿——嘿——，哦——！……\n呵呵。感觉是很有意思的话呢！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000114:dialogue:000": {
      "source_hash": "sha256:7424d238ba5e270ab0246dc6726bd00787ce3dec83cd1917e0dc77462b6bbc78",
      "text": "对吧？\n皮埃尔，能由你来领口号吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000122:dialogue:000": {
      "source_hash": "sha256:80bcd3d9bc243de8abeecb8bc7e4e740f58a021f5825b4d6a8dd664a0a2b5e2f",
      "text": "明白了！\nBeit！嘿——嘿——，哦——！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_g:cmd-000130:dialogue:000": {
      "source_hash": "sha256:0522f5feb089c6d0ce8700a3a14d006211d88ef37bf2eed6509b13d9b6b2b377",
      "text": "哦——！",
      "status": "draft"
    }
  }
}
