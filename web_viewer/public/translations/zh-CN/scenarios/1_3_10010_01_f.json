{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10010_01_f",
  "source_raw_hash": "sha256:89d1924816bb84e9e4ae224d590fd9d018b828e7dfc09bf90692e92fc91e983c",
  "entries": {
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000016:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "几天后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000031:dialogue:000": {
      "source_hash": "sha256:99d20d91dbf78d20033e5d42655676449255ec78e2e53e5e61003602f290b024",
      "text": "●●●●プロデューサー。\n追加的工作是什么啊？",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000037:dialogue:000": {
      "source_hash": "sha256:b1809baa4fc3db35d402cb6ece6497dc81667c369c1b2d35db0f3ab4d496873b",
      "text": "居然……收到了目前正在制作中的\n摩托车电影的出演邀请！",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000040:dialogue:000": {
      "source_hash": "sha256:73fce51623337f34fb4fdd1370cfa34e97d5d38407ab55a1f21cb27722ffff30",
      "text": "…………哈？",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000045:dialogue:000": {
      "source_hash": "sha256:d0e2b10992ffdc1a96f3b04eb80b42dee84437b78b3a1960a24ba6bc01e6f711",
      "text": "什——么！！？？\n真的假的！！",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000049:dialogue:000": {
      "source_hash": "sha256:f15b3b132e24489a78c0039849dd049848e125144d5e0f1eaadf88611df8160e",
      "text": "这可真是厉害啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000053:dialogue:000": {
      "source_hash": "sha256:c765e851889541515d02a3b6ea5b242550f436fcef39ea46a53239fc0845cf82",
      "text": "前几天的活动，杂志总编和\n摩托车制造商的人也到场了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000059:dialogue:000": {
      "source_hash": "sha256:7b4fcf0ee4f264105da6e69d2291a4195fddf37384b16196fb06a3290c530019",
      "text": "说是非常看中神速一魂，一定要给你们邀约。\n这是资料。",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000067:dialogue:000": {
      "source_hash": "sha256:454527d6fff88b54a93edc67ee6f908875545b2225f9623e3760772fab2fece5",
      "text": "嚯……这不是个好角色嘛。\n真是不胜感激。",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000072:dialogue:000": {
      "source_hash": "sha256:732a387a6ef5c38175f31817b74a32fb797c6ea433567629ad8b0174e19f96b9",
      "text": "真的假的……",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000076:dialogue:000": {
      "source_hash": "sha256:b4d8d7bb844deda2e32ac95dbf2f04e2ac71cecd89ba0a08c08130334a0a65c0",
      "text": "我想对两位来说也一定会是一次宝贵的经验。\n这项工作，接下吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000082:dialogue:000": {
      "source_hash": "sha256:eea1a0439a31e1dec91eaa27a7d8cc9617f0e831ec2029480d47d4e85e82ef08",
      "text": "那还用问吗？\n当然是……",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_f:cmd-000090:dialogue:000": {
      "source_hash": "sha256:c46b0573d4b68c8715f26e81d0dc70c15079bcc9be62a6b8af02f35bd3c91e4c",
      "text": "大干一场啦！",
      "status": "draft"
    }
  }
}
