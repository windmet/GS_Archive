{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_006_01_d",
  "source_raw_hash": "sha256:924d676ec58126f8305ad9abe1d4fadf20e5e6a4e18e219b2c419178777561f7",
  "entries": {
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000015:dialogue:000": {
      "source_hash": "sha256:01c583f427778175703f176aeba2656b70bc66f2bf3e7bf6782ce118028fcac1",
      "text": "守护笑容，吗……",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000024:dialogue:000": {
      "source_hash": "sha256:5848861695ab03b68f794c29c3867193a81ad5c7ac11c5509794db16148bd0a9",
      "text": "（聊到那个话题的时候，我记得\n也是像今天一样晴朗的日子吧）",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:6017bfb8f6f2f8479468d99a5cc88c1169b9489cf8a5947e74cde2e02e577ff6",
      "text": "守护和平那是理所当然的前提，绝对是！\n在那之外，我还有想守护的东西。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000041:dialogue:000": {
      "source_hash": "sha256:1ffde7d1981730afead681ff5ad8beb300ed49f213946328ed1681612a497fc9",
      "text": "在那之外？",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000043:dialogue:000": {
      "source_hash": "sha256:d751d410e057696534e8d962a81b4b60867b34e9f8078c5b9c989a3033976ad8",
      "text": "就是笑容啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000045:dialogue:000": {
      "source_hash": "sha256:dd23e3dbff56ec486d6b1b94c68e11f06aae25de13fa4cd7082e42cdb8773eeb",
      "text": "我想要守护全世界的笑容。\n无论是谁，都需要一个能开怀大笑的地方吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000047:dialogue:000": {
      "source_hash": "sha256:18c9560735a136c220d1bc4914979fec820c7ccc4233076e60242a4c448a1193",
      "text": "哈哈，原来如此！\n这不是很像你的作风嘛！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a585dab00ae2868cbcedd75adf913de3f44e262a379aa733296b9a8c995cc750",
      "text": "这种想法，我可不讨厌！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000066:dialogue:000": {
      "source_hash": "sha256:ec8bf10ba1a0b37abb3ae1702b5f678b1dcf60033527acb66597c356dc70e158",
      "text": "天音的笑容，正被这位偶像守护着啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000077:dialogue:000": {
      "source_hash": "sha256:7a8616f3e606d3648d1a485e6e0f8185dae226356820e4312abf65386c1c7748",
      "text": "这也就是说，只要成为偶像……\n就能守护某人的笑容，守护全世界的笑容了吗……",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_d:cmd-000084:dialogue:000": {
      "source_hash": "sha256:c1d873c481ff7044018d6848a6afdc337c43af1b33a4f6e83b81297df00f6cb0",
      "text": "……我知道了！",
      "status": "draft"
    }
  }
}
