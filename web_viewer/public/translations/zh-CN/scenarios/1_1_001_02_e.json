{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_001_02_e",
  "source_raw_hash": "sha256:576f377fce860e295ff106c07a591e78bdc6cc57daeb5d2a32911e7083453f30",
  "entries": {
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000015:time_caption:000": {
      "source_hash": "sha256:102ff1b7cb481553c8396dd6799d204aec96a73e1cc2997e6e2f0c58b93abf00",
      "text": "翔太的房间",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000020:dialogue:000": {
      "source_hash": "sha256:37eba61e31da664d28451c69cbe12a000261c27dfb693766cd4c728622b05107",
      "text": "呼……呼…………",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ed887e9cd2e0fd51f2022f3e2e7ab6fb28c360c8cd48db80362f5427b5f348ab",
      "text": "翔太，今天不是有工作吗？\n快起床！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000037:dialogue:000": {
      "source_hash": "sha256:b77ec88362b15332e14e37f3af84d1055ee7af87b6a7942147f89825f1a9ddd5",
      "text": "好——……唔嗯……呼……呼……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000042:dialogue:000": {
      "source_hash": "sha256:507133ec25182c177720698f23d2da003b7dfb6737f7d536207ddae9afeda6ed",
      "text": "喂——！不准钻回被窝里！\n快点起床去吃早饭——！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000051:time_caption:000": {
      "source_hash": "sha256:2cf299b9db82240fc03c5e3aeca137dae387b6b9aadfc396c17215c632e680b3",
      "text": "数十分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000057:dialogue:000": {
      "source_hash": "sha256:0f64b622cb4d3914f85f1feb3b52adab22b8cb7e591fc8c195ddd41f086b0aa7",
      "text": "呐——……再给我一杯牛奶……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000066:dialogue:000": {
      "source_hash": "sha256:67ad5179c9582608657efe2041728d4e9ced1da52ddbc50a82a0b06d5099d544",
      "text": "诶？啊……真的，扣子扣错了……\n……嗯，谢谢姐姐。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000072:dialogue:000": {
      "source_hash": "sha256:28a5e3a499cae296c79bfa4c00e4783e8ef87f3f49d2889a04898944dd69ac80",
      "text": "没事的……我和冬马君还有北斗君，\n相处得挺好的……呼啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000074:dialogue:000": {
      "source_hash": "sha256:7ac422d9dfd50adff64e45ec6113e2c94242dff02ada9b82436c8788f65ad758",
      "text": "翔太，接你的人来咯！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000080:dialogue:000": {
      "source_hash": "sha256:4d0b4e416aa48705ccab4c230ab11835a67f9372c42ce06e85f57b6b69bc889d",
      "text": "好——的，我走啦——……\n啊，忘拿包了……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000093:dialogue:000": {
      "source_hash": "sha256:1d7aa073ba8a3a63c87a2e2b8eccb95f818223296fdcc4de38faa96d3f0f5692",
      "text": "真是的，你在干嘛啊。\n好啦，我送你到巴士那里。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000095:dialogue:000": {
      "source_hash": "sha256:128612388782630c9b6dd9a381ad575f7dc446a2c1d1d17b381d8b3860e56640",
      "text": "走咯，翔太！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000099:dialogue:000": {
      "source_hash": "sha256:77c12c9a8bc8801e43d2aa59bcf9130a1eb3a6af7d7cdb937eb6f73b3e010470",
      "text": "唔——……",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_e:cmd-000109:dialogue:000": {
      "source_hash": "sha256:2b9421116c6f4558edb72cd11f309f0a654922656de48efe33a651d89b940e29",
      "text": "真是的……\n那孩子，这样真的没问题吗？",
      "status": "draft"
    }
  }
}
