{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_027yuk_2_1_8_027_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_027yuk_2_1_8_027_02:1_8_027_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:977c888a9d7c8b778af9d2ad1e7f9a984e81565a6e553efdb371ec28a1e784a4",
      "text": "啊，●●●●プロデューサー！这边这边。\n谢谢你特地来接我。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_8_027_02:1_8_027_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:ed17edb4bd2b5ef24c39f080733e9f8094deef4e156d2f58062683058f2b1488",
      "text": "本以为今天终于拐对了路口呢……\n给你添麻烦了，真是不好意思。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_8_027_02:1_8_027_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:b6ff68450b6248529c5a9cc819a9ba1aaa2768b991bc577e610e120f1341bfe0",
      "text": "不过，托你的福能提前告诉你了。\n制作人，生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_8_027_02:1_8_027_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:11bab7e7dda273df6b26feab8e3baee38118a715fc359efd59c6bd17ff5dfce0",
      "text": "来接您这点事请别放在心上。\n更重要的是，能收到您的祝福我很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_8_027_02:1_8_027_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:0086cd6483911285b6612c54c661bb2c1a7172eefc2e85d4b8fb1beef47d8307",
      "text": "等到了事务所，请让我再重新好好为你庆祝\n一番吧。那么，我们走吧。",
      "status": "draft"
    }
  }
}
