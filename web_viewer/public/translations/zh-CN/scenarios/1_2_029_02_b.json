{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_029_02_b",
  "source_raw_hash": "sha256:0c33f7a726cb39a6bbaf40692c1fa0a3d36edb35e4cb3f3a551d319422ebb871",
  "entries": {
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000026:time_caption:000": {
      "source_hash": "sha256:48463b36e2734c9c53dcdcd7acb97e01bac095c311080e61a527ef3c8c1c874c",
      "text": "阿斯兰的卧室",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000035:dialogue:000": {
      "source_hash": "sha256:f6c684b1e011100703b8c248d92fbca85aba61834cac7ee7b6168ec99b33163b",
      "text": "……此刻，究竟是……太阳似已高悬于天际，\n然而……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000044:dialogue:000": {
      "source_hash": "sha256:2aee1952fd1b02dda10ac8d5cecdd9930284490ac3a9bece3f4178fc9eeec194",
      "text": "（看来，是不慎陷入了沉眠……\n是因为昨夜在思考之海中徘徊的缘故么）",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000055:dialogue:000": {
      "source_hash": "sha256:75ac89df9fdd848bc982bdc771273e1da493a82291fd8160be6e368c83fa5137",
      "text": "撒旦啊。此等迷茫，究竟是吾之杞人忧天么。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000066:dialogue:000": {
      "source_hash": "sha256:e770002d8fc5ca410f66615da08594faf371f1fcba62f6fdcce57f65e2cc3d6c",
      "text": "（近日，暗之同胞团行动诡谲）",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000084:dialogue:000": {
      "source_hash": "sha256:e01affec0b2e4154f69795a83bf150f63c7587fdc03b1360d92988e39a783457",
      "text": "（伴随吾之现身便草草结束交谈的，\n庄一郎与卷绪）",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000102:dialogue:000": {
      "source_hash": "sha256:43bfbd1b3446d6fb1cfdadecfb7c9acf3bd9bad8eaab2f023dbd8ea16eb28036",
      "text": "（感知到吾之魔力后，便将刻有谜样纹样的书册\n藏起的咲，将念话机扣下的神谷）",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000117:dialogue:000": {
      "source_hash": "sha256:56f2e3dfacd5a71530e5bb8f7bf3fa3515eff62ba2559fe1458d3a9a00944d73",
      "text": "（同胞们似乎皆隐匿着什么。\n不，抑或是……）",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000125:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_b:cmd-000129:dialogue:000": {
      "source_hash": "sha256:cc9552c760f4a379fa3e26b0f93e3bf3a4528845e590b0b07e6ed937ddb68943",
      "text": "事已至此，唯有向主寻求指引了……",
      "status": "draft"
    }
  }
}
