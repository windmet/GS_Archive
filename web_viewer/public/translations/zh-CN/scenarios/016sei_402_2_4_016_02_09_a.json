{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "016sei_402_2_4_016_02_09_a",
  "source_raw_hash": "sha256:fda9637532fc2323060b1fd3943486d05a697ef47d45fad3ae59439fc0f0c6a7",
  "entries": {
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:e741d32c7de4dde4be921d7d9f43323163fb835a746bb5a82e1bf10cf085d0f7",
      "text": "制作人。\n太好了，打通了。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:42b173df33aadecac782aedb672e318d70dfa0b321eaab6a9508fa9220a0ea47",
      "text": "果然还在事务所啊，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:26d3a2acd94f0309f72d705d9b659f598c07e603be66675ed5d26a4c0999fa1b",
      "text": "圣诞集市的特别演唱会也顺利结束了呢。\n多亏了制作人的支援。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:3cff718defc396b9ddf850867c0755df95f4daf95a9c82f21fad3bd76159ee24",
      "text": "任务圆满完成呢",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:b9efa6141204e160674532652c0e39f14801e620b5e7bf230aa87d6c3075504b",
      "text": "是因为大家都很努力",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:c2240e5728be8554a399e988d596ce9980ff7018d33aea233ded4056de0ed67f",
      "text": "嗯，达成目标了。\n非常感谢你有力的支持。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:4c10f85170d388f42a945546e397f557ea431922b2181c86ceafb161f34b834f",
      "text": "说得对。\n这是大家团结一致赢得的成果。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:c2c6dba6d70e1667100ec8f1763f938caff0becbfc081759ecdbb82f3a35399c",
      "text": "我想我们为观众呈现了一个\n配得上神圣之夜的璀璨舞台。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:f15c649c72c3e940d632642fac472f60671f8460c08c4a7444f8f491d7586ff6",
      "text": "这次，轮到我们把笑容带给制作人了。",
      "status": "draft"
    },
    "story-text:v1:016sei_402_2_4_016_02_09_a:2_4_016_02_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:cb9209938d307e0f79a89de7baf49051986e2a7635f8e4e3d4801bbbd20a344d",
      "text": "今后也以更进一步的成长为目标，全力以赴吧。\n敬请期待。",
      "status": "draft"
    }
  }
}
