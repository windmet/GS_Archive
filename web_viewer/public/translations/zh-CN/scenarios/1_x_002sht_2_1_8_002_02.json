{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_002sht_2_1_8_002_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_002sht_2_1_8_002_02:1_8_002_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:a406f3cd9b3e664b6f64fc3c5ffce26ba421e759af11ba862aac9b10f1e668c5",
      "text": "●●●●プロデューサー，辛苦啦！\n呐呐，现在是午休时间吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_2_1_8_002_02:1_8_002_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:b96202acea20eb2bbfccf4b2fbdf973abf45e74e8e228e673aaddc527d98915e",
      "text": "我想着要是你在休息，稍微独占你一下下\n也没关系吧～",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_2_1_8_002_02:1_8_002_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:e6e183676c112c08e4ab21c419558cf33d834010b89347368b939a74217105a7",
      "text": "制作人，祝你生日快乐！\n我就是想先把这句话说出口！",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_2_1_8_002_02:1_8_002_02:cmd-000016:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_2_1_8_002_02:1_8_002_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:4997a497d7b5ec88c1dd50ee68cd927be44d9623255f9e9ea763c012dd04805b",
      "text": "等回了事务所，我还打算再给你庆祝一番呢，\n好好期待着吧！那待会儿见啦！",
      "status": "draft"
    }
  }
}
