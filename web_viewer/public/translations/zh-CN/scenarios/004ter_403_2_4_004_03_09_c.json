{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "004ter_403_2_4_004_03_09_c",
  "source_raw_hash": "sha256:c696388fcba68defa85c27aa951d8c6bc93538c37320713952d979fcd187bb6c",
  "entries": {
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000008:phone_message:000": {
      "source_hash": "sha256:ede1de20b38c0ab9ff6c4da7e5c6380dd7205bd016a1ac4a8f86b5e194fb2f32",
      "text": "●●●●プロデューサー，辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000010:phone_message:000": {
      "source_hash": "sha256:da8401f25f58edf2b2bc278bd3265e804abf6e810d77a69498e53091da5e3bae",
      "text": "和北斗、类关于演唱会的商量已经结束了。\n现在我在北斗的车里。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000012:phone_message:000": {
      "source_hash": "sha256:bf491dcd4a22bcffd7958c133fe4deb3f8933bb3c8a52c7f65cc7a3206e34c80",
      "text": "光是商量的时间完全不够用，聊得可起劲了。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000014:phone_message:000": {
      "source_hash": "sha256:8e0e11a7b4972a444aeb97e217da7582c801c3169116eefb890b77a2ae50c4da",
      "text": "涌出了好多想直接\n跟制作人说的事情。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000016:phone_message:000": {
      "source_hash": "sha256:0aa185ab0b0e0d7ef5b00ce3bde07481a64f7dc2cf3ae67afe4b6703070663ee",
      "text": "虽然有点突然很不好意思，明天能在哪里聊聊吗？",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000019:choice_short:000": {
      "source_hash": "sha256:59c55d4b878df63d50ff372587f8319ae3821c1cf3fe8c6bce31cf184b4a7c34",
      "text": "明白了！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000020:choice_short:000": {
      "source_hash": "sha256:50bf4091d3fb43e05cebf1697acc31b06f7f53923d50cbdc0b86b7aeec8365ec",
      "text": "好的，没问题！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000024:phone_message:000": {
      "source_hash": "sha256:4584dc18640ee49a3b194db924dd15e078dee1d9d4c3217b1fae4ec9efd52f5f",
      "text": "谢谢！回头把你空闲的时间告诉我们吧。\n到时我们会去事务所的。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000026:phone_message:000": {
      "source_hash": "sha256:0941b84389696a848f3e9320b31bdca5b4dd32f13b6216341aa5335ac81a2d17",
      "text": "拜托你啦！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000028:phone_message:000": {
      "source_hash": "sha256:5eb83be230d0430a4f427019f2b6fff652b219150ecbe26542bfd16f67dcf6ee",
      "text": "明天我会带很多连制作人都会觉得有意思的\n点子过去的。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_c:2_4_004_03_09_c:cmd-000030:phone_message:000": {
      "source_hash": "sha256:342982c1ccf38191df1f8b3048d47cf412d34f915db8bd9b5c638ab8ecc17585",
      "text": "敬请期待吧！\n那就明天见啦！",
      "status": "draft"
    }
  }
}
