  "scenario_id": "036rui_401_2_4_036_01_09_b",
  "source_raw_hash": "sha256:89381fbbd1cb7da6ff1e1fde718e8b16b77ffb0bc44a1b1b863685e0453b4c37",
  "entries": {
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:b9f315de7bd0147776cbb816636e7aeb0e1671bc454928a9b1e112cfd402d3e4",
      "text": "Hey，制作人酱！\nMuseum的参观超级开心哦！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:87ffbed187cc50c7891b34c10bd3fb56c933da66bd6abd8469dfaaec166f927c",
      "text": "当Student的时候，我也曾因为校外研学\n去过美术馆呢。",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:38cad483c37e7af18089af30066bce385c2d69c0b50011fa475d97f1dd116385",
      "text": "开心的回忆一下子全复苏了，\nvery exciting哦☆",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:b9500e623499041e8d2241153fef06c71ce52d775275fc32b5cd0bc6a3801e3e",
      "text": "是因为大家在一起吗？",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:3a4024af2a454fa3163ef0f7e595df4c7f2271dad96c83594788a7031fd411c0",
      "text": "Yes，of course！\n大家热热闹闹地一起看，最棒啦☆",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:6231d3a8ce120c0afbe19b842e9850cd64b0e78f5edaa52035139b089d1caed1",
      "text": "现在心情超级好，顺着这股劲把live也\n办成功吧。好好看着我哦！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_b:2_4_036_01_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:76c2c5f24a1f1a130e3d3df5d9b5d7d921370e30946c5998be5bc47a5d983549",
      "text": "……啊，工作人员在叫我了。晚点再\ncall你！制作人酱，bye☆",
      "status": "draft"
    }
  }
}
