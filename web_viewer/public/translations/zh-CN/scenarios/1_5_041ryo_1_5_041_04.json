{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_041ryo_1_5_041_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000010:title:001": {
      "source_hash": "sha256:5cc5da11d09b3a1f71bb523cc7ee19dbd1535af9bf726beb39ea14fc86f07a0c",
      "text": "奇幻音乐剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:689c24a7b3c25e90662560cee84aa368fc5426df4db40d1025158d7de228ab62",
      "text": "●●●●プロデューサー，\n奇幻音乐剧终于要开演了！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:31f34c411a2a781380a73a50caf83b83fbde8ec528f7905cb241b2acbb05a8c8",
      "text": "再过几个小时，凉先生就要站上舞台了呢。\n我想您一定有些紧张，请加油！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:b7957e3d3259d1971155466125f84433159c60776e4a13bc3c07970d2cae06a6",
      "text": "好的。虽然很紧张，\n但心里也有点跃跃欲试呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:31c3149921e0a7773f35e3dc0a7552976b201dd8e2c49be0116ebdaf0b831ec8",
      "text": "总想着快点把观众们\n带进那个美妙的魔法世界里去。诶嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:f2a8425f7accfe44a73d5ade7c04fb9199396fc39b3029b0e761516d569eb340",
      "text": "从读剧本的时候开始，我就一直这么想了。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:4c78c25e7b652563fa02607fb0434928ddcf93c1d17fd3a72dc1190f7a764b0c",
      "text": "真是出色的心气呢。这份想法，\n一定也能传达给观众们的。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:49e291b0c26d978f3428f4d7f01c2753c6fee411e043917549987204e01c6113",
      "text": "谢谢你，\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000045:dialogue:000": {
      "source_hash": "sha256:66685f033d8883ab2c1d673cf811be87dede2b24dae48b18525788bce7a04bbb",
      "text": "轻飘飘、闪闪发光、令人心潮澎湃，\n宛如梦境一般的音乐剧……",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000051:dialogue:000": {
      "source_hash": "sha256:6098579c6b62ec7a284a81ea438195aa92dd33a847aebfb4aa4d4b56fed19940",
      "text": "为了能让在场的所有观众都感到满足，\n我会全力去演好的。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_04:1_5_041_04:cmd-000059:dialogue:000": {
      "source_hash": "sha256:d11f9e465df131ba2a074fd2cd3e7cfa8bc12e6d36c916647637e34503ca426b",
      "text": "好！干劲也上来了，我去换戏服了！\n首日演出，我会加油的！",
      "status": "draft"
    }
  }
}
