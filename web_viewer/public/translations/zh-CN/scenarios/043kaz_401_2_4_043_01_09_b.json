{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_401_2_4_043_01_09_b",
  "source_raw_hash": "sha256:18414ab97ddfaecc52e181366b3e8c611f67bb04ebc9fd107f268cd7d4b6fa84",
  "entries": {
    "story-text:v1:043kaz_401_2_4_043_01_09_b:2_4_043_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:ce30043322d77d844e25f3856b1e5a91d48b63c78abee886146325691f8bb8e4",
      "text": "……喂，●●●●プロデューサー。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_b:2_4_043_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:b897481c4798e82793b561387afd3b6c6bdf9442902e9cd13efbc7545a6282dc",
      "text": "……关于在苹果派博览会上的演出，\n一直以来谢谢你耐心听我商量。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_b:2_4_043_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:b2bafab5ef2002cdf1bba1e31dfe4845e931927ff8e254f03c066108d80c9935",
      "text": "……为了能交出一份满意的答卷，\n我会去全力拼搏的。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_b:2_4_043_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:eb1d5429decad57ec1559ae2815df4702a27d777957519485d637cf0f31943e6",
      "text": "……希望你能在最近的地方，\n注视着我的表演。",
      "status": "draft"
    },
    "story-text:v1:043kaz_401_2_4_043_01_09_b:2_4_043_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:a055e833227ff1a0a3762c450c5a89d74ac289e017aa4036b8654205852c490f",
      "text": "……突然对你说这些，抱歉了。\n……那么，再见。",
      "status": "draft"
    }
  }
}
