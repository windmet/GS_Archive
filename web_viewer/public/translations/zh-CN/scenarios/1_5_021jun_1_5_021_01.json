  "entries": {
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000010:title:001": {
      "source_hash": "sha256:bbff417ce36df45412f161bbea9c4950c8456a8009f90c0ca0a47ba2225a0a14",
      "text": "杯汤广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:263d1911beff5253db5f37b4f6097596e88e9f4b9b0531af4f8317a3a4a3865e",
      "text": "辛苦了。\n哎呀？这是……杯汤吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:8de91a8971e67925f764c6d032bbd22cd703eebcb4d647843ff6dc5b6a6faef0",
      "text": "旬先生，早上好。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:96c0e66f4a718f76a650c60ce4ea8142b5fa6be2a34974957b90203bfa39be83",
      "text": "那份杯汤，是请旬先生出演的\n广告样品。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:c011bbe72e9e31155f5fc75d0c93796b30328f08476075dd75f5f94f2b2dee6b",
      "text": "啊，是前阵子从●●●●プロデューサー那里\n听说的那个广告工作的样品啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:d8780304bbde5f8c52135e876b3ea8d1004321f198b8a2f6f6eb2508dae841b0",
      "text": "要尝尝看吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d5f12c031451b84ffd9f8f22874ac1a67fed415683c737ac36db832181cb0ad0",
      "text": "也是呢……既然要出演广告，\n最好还是先试吃一下比较好。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:faeb1644b10457d6483caefdb10560e91556ca0970d56cac4325e51f56655bbc",
      "text": "让您久等了。\n很烫，请小心慢用哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000053:dialogue:000": {
      "source_hash": "sha256:6e54a4d55d6ba20c6f54491b1be6ecc44a74bacc3df9b060cdd4bb62e1becc39",
      "text": "谢谢。\n好香的味道啊。那么……我开动了。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000060:dialogue:000": {
      "source_hash": "sha256:947c0993d80e209952ba9269794856b156dc6bc259d914ddede5fbdca4ae8d25",
      "text": "这个……味道很棒呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_021jun_1_5_021_01:1_5_021_01:cmd-000064:dialogue:000": {
      "source_hash": "sha256:ff8cc0eddbe14da486b180bfb296712a20c9717235806ed897d4551a7d9c2c1f",
      "text": "必须得好好将这份美味\n传达给看到广告的观众们才行呢。",
      "status": "draft"
    }
  }
}
