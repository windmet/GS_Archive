{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_003hok_1_7_003_01",
  "source_raw_hash": "sha256:acb2e4d5d0efaca472be70c6f3b659f47625c76276d077ecbd26abc58ad89b36",
  "entries": {
    "story-text:v1:1_x_003hok_1_7_003_01:1_7_003_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:c62235148c4e6f725e7f74a8a49dd53bc98ad236adaed6a5de95d24d40d72470",
      "text": "北斗先生，今天也是您的生日呢。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_7_003_01:1_7_003_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:1148bb635145043612f39c98d90029899346f7076e0f1817e20f6c7c851b1f14",
      "text": "谢谢你。\n原来你一直记着我的生日啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_7_003_01:1_7_003_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:3d5313e55715b13f69457c91f018e87e54f293ac5b7b957f0db5b32c33cc503b",
      "text": "没想到能得到你当面的祝福……\n呵呵，真开心。",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_7_003_01:1_7_003_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:466737c5e1475d7801890857d9d953abebb5d83ddcf0b3254af303c699f1ab26",
      "text": "能得到你的祝福，\n让今天变得更加特别了呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_1_7_003_01:1_7_003_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:f50642f29aa0bfc645e91a03de0946614c01a83e0d720285d5266d031316d246",
      "text": "今后也请多多关照了，\n●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
