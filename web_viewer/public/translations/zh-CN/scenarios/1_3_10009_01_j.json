{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10009_01_j",
  "source_raw_hash": "sha256:a9ccb675c531f47db4c9adbf4afd6148c60f75efc998167350f55c3cee338648",
  "entries": {
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000019:time_caption:000": {
      "source_hash": "sha256:10f1249e31736768c6f28012395038244604c1b0c281343a3af4a592b2fc7c14",
      "text": "CM试映会当天……",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000025:dialogue:000": {
      "source_hash": "sha256:7360535414970f4362c3e20f53cd0cc22cf503b02c53e26d13cfbd7dcd0395d0",
      "text": "……试映会马上就要开始了呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e9dab09c321fa9b556280d56661b3bc948941bc2370de7fee174ff8ad91d889a",
      "text": "会剪辑成什么样呢？",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000033:dialogue:000": {
      "source_hash": "sha256:1ac66809f431b734a9794488d729ed58460c78574565a0e3f3ca2b3268de17b2",
      "text": "距离拍摄那天过了挺久啦。\n好期待看到成品影像啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ad3bef55ab3aebcb9f91f8cff096935602a9ac3c79b55cc81b0535ff8cc9728c",
      "text": "各位，人好像都到齐了。要开始了哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000196:dialogue:000": {
      "source_hash": "sha256:48f94e444197c736fe25a15f4c801e475d9685d854ee0e183848bbe88483892c",
      "text": "效果太棒了！\n完全配得上作为新品牌起步的CM！",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000200:dialogue:000": {
      "source_hash": "sha256:15a48f2d0552fc03c65c859d32f2166c0108d45fe7638002b99575c14ea3eaec",
      "text": "制作人、F-LAGS的各位。这次真的\n非常感谢大家能接受我们的邀约。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000205:dialogue:000": {
      "source_hash": "sha256:a7edb821e9ddb8681aaa9de4f4e588e51bcb8e10b819c099ba1a741ebe6b057d",
      "text": "遇到困难互相帮衬嘛。以后要是还有事，\n再联络●●●●●●●●●●Boss哈。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_j:cmd-000209:dialogue:000": {
      "source_hash": "sha256:68eabaf2d2dfec75b78efc64d6181388d19963bc7771171adfd9b44a83cf253b",
      "text": "肯定会像这次一样听你们倾诉的！",
      "status": "draft"
    }
  }
}
