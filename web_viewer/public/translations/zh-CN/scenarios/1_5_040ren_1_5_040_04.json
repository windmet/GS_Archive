  "scenario_id": "1_5_040ren_1_5_040_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000010:title:001": {
      "source_hash": "sha256:ddab745e9c56660f84d3aad4b529afd14507dcb8d898bfd245359c6c9aeae66e",
      "text": "以徒手格斗为核心的舞台剧工作",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000014:dialogue:000": {
      "source_hash": "sha256:3bd7da6f146d89dff8c5ed2b4f76c9b65ee5114423bbc4452765bf2be811d01a",
      "text": "嗯——……唔嗯……\n吵死了……少废话，来决胜负啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:756b3194a3fd7eef54308ae80b416eed430b14f8ca05f5c1488674d7883ed345",
      "text": "涟先生，差不多该起床啦——\n该去个人训练课程了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:2df75b948fba97f7444b67f5bc4e6a4002353823217700ba0394dd04e3b8dc93",
      "text": "啊……？麻烦死了……\n本大爷才不需要什么练习呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000028:dialogue:000": {
      "source_hash": "sha256:586af1572ecbeca4942eda5bdf143e9933f692c4f2952e9602c941ba0dc6067c",
      "text": "这部舞台剧有很多打斗场面，不认真训练\n可不行。万一受伤了就麻烦了。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:d796e9281250c7c3977a0848509d2f2cbb2e34055d0366e30833977d5a5cf0d2",
      "text": "少操那种没用的心。\n本大爷怎么可能会受伤啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:2bc8980fb0fb28d6acbdea204da25b5863c3d3ba291ac83fc68be213281208bb",
      "text": "上了！哈啊……！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000062:dialogue:000": {
      "source_hash": "sha256:789f99877880f79b0eb8814e8bbd500a15d597caabef825d9069c94df171161a",
      "text": "好、好厉害……！动作简直无可挑剔！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000067:dialogue:000": {
      "source_hash": "sha256:8a997ef389db624d935a4409e2a4fd67eee6afe1f1c4af1829741cc4d7d21821",
      "text": "库哈哈！都说了这种程度对本大爷来说不在话下。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000069:dialogue:000": {
      "source_hash": "sha256:a24165edae5c70ed070b8d9eece119fa5d27a48175f97ffe01174de4aaed3d81",
      "text": "保持这个势头，我们再来进行演技训练吧。\n我想看涟先生展现出最强的演技！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_04:1_5_040_04:cmd-000075:dialogue:000": {
      "source_hash": "sha256:8b222232ebf119c01c10c74541c03de31057e3f108fe35e945065c875c4426ba",
      "text": "哼，好啊。\n把眼睛瞪大了，好好看着本大爷的英姿！",
      "status": "draft"
    }
  }
}
