{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_045_01_b",
  "source_raw_hash": "sha256:b2f1f3f41f4d2eb4461df2eee070c04e87888b366af55f864682e91cd7e0d662",
  "entries": {
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:4e7178462acca9c56baad8716d634ec33a3fdbc6671d76ab09e63417f9f7e173",
      "text": "这是新的日程安排。\n您觉得如何，接下来可能会稍微有些忙碌。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000019:dialogue:000": {
      "source_hash": "sha256:aa647b8a419ca5889249b33db75a874a5b1227d7de0f89f5b0701f16aeb7c4d6",
      "text": "……嗯，没问题。这样完全应付得来哦～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000026:dialogue:000": {
      "source_hash": "sha256:077c76d20e1d869ba8cfd14ca89cf7c43c34ac19bc83818beb8dad6ff52ae082",
      "text": "最近之所以忙起来，是因为偶像的工作\n在一点点增加嘛……呼呼，真开心呀～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000030:dialogue:000": {
      "source_hash": "sha256:7ba0c637792e8efc949c1b8d8596dc7170a1d52090991e65d903c379d1f7d241",
      "text": "不过……",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:78aede83d14c010c7ff34fa7fd7181ad1e25927aefdcaeb17afa50d0204e942c",
      "text": "毕竟学费是父母出的，今后\n大学的学分和出勤率也还是得多注意呢～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:7d4774be340934c9994e5b6911898be9a550ce1d9a3cce1f8ae5fb00e1d70369",
      "text": "偶像和学业两边都顺顺利利的，\n才能让那两个人放心嘛～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000041:dialogue:000": {
      "source_hash": "sha256:4022fe23004031ff2e81ce035b2f2fa0b996c4479ab284e9cfc97b66a10eeb03",
      "text": "想乐先生……\n您真的很重视父母呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000046:dialogue:000": {
      "source_hash": "sha256:91a669e0f96c97cfd6a706bebec1ed2c20f6fdce1125cdd4c218064423aeb9e4",
      "text": "哎？呼呼，谁知道呢～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000055:dialogue:000": {
      "source_hash": "sha256:5a0993ec37b88127ffe9dfc472d8ca23949654ccf75d53992aa5a9eff10220f4",
      "text": "（这样啊，听起来像是在孝顺父母吗～）",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_b:cmd-000061:dialogue:000": {
      "source_hash": "sha256:29fb15c4af46f45056770b6648b0c5b1e54032f0ce2ee22ebb0808c9d3d6a68a",
      "text": "（……嘛，被人看成好人也没什么坏处。\n真实想法，还是别说出来比较好吧～）",
      "status": "draft"
    }
  }
}
