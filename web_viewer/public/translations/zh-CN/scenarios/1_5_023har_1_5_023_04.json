{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_023har_1_5_023_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000010:title:001": {
      "source_hash": "sha256:9e7830fab2677063f707d511e9ff7399d6fcbfb868d97744b2b22587a7b058cf",
      "text": "闯关游乐综艺节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:f82341c0df465709583c4b9323466eb4fa28e70f632b00b1f2c0002c8bd1be81",
      "text": "春名先生，马上就要开始节目录制了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:fe2560e3566c7ef8d4831962eaef528106ff4e02d724afb3c5c1108f5c8eec38",
      "text": "噢！挑战各种游乐设施来\n赢取奖品，听起来就超有意思的啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:336c8af238eb27e8e6d5e4a3250e38de5a9ffd93224ae054e415e3f4a02a04f5",
      "text": "因为是靠抽签决定的，不到最后一刻都不知道\n要挑战什么项目，这点也很有趣呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:5811e7ac69db3c8ed2e1e7f2ad300e224da6ba3563ff1f143b3d23f0d6b69955",
      "text": "这次的奖品好像是根据春名先生事先回答的\n调查问卷来决定的呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000029:dialogue:000": {
      "source_hash": "sha256:d2a0b540673120886b4de79690d4e39564b7cc5fc20d7c5a2de0ce457a2a471a",
      "text": "以拿下奖品为目标，请好好加油哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:f8eea59f587a8d2a1d8e4598e7ff4bdddcc24fe6a48ee661da8ffa1af79f7e3e",
      "text": "好嘞！不管来什么项目，\n我都一定会通关给你看的。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000045:time_caption:000": {
      "source_hash": "sha256:4f10f377623d30a2f8e6eef9924c2cd8b7962dcbd80ad5f1e46aca35a570d7f4",
      "text": "录制后……",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000055:dialogue:000": {
      "source_hash": "sha256:91d15bcc6c8de589d67e8124874e0984b3ba3ed1834dd61d435ba4fcc961783c",
      "text": "啊——太可惜了！\n明明就差一点点就能拿到奖品了啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000057:dialogue:000": {
      "source_hash": "sha256:a8aea66f8ed56af87dde7ab7dabe17b7ca809eb30a85b6bb4032da3d49f13cdd",
      "text": "最后一关的时候，眼看就要过关了，\n结果时间用完了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000062:dialogue:000": {
      "source_hash": "sha256:26b7d8044c3d54ab4b1fdccb0714129465311759835205bd435c10c4dd1b3918",
      "text": "是啊，太可惜了～\n不过，每个项目都超级好玩的！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_04:1_5_023_04:cmd-000066:dialogue:000": {
      "source_hash": "sha256:d79cac97cc786acf6729995f6c9120cc80209db07009b6b83c9f81b7e505a8a9",
      "text": "要是还有机会的话，真想再去挑战一次啊～",
      "status": "draft"
    }
  }
}
