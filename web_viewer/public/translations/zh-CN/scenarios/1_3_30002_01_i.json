{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30002_01_i",
  "source_raw_hash": "sha256:501c06e0562cb25a4ec3ea8949a28be610e2dc319ec950700948d258f2fa26e3",
  "entries": {
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000021:time_caption:000": {
      "source_hash": "sha256:a6609af65db2587d70f89eb587463686af3bdd42385789ee63adaad32e78f904",
      "text": "《涂鸦老师》",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000027:dialogue:000": {
      "source_hash": "sha256:6e1327bd1ead656a69c43f45a4488f4b66bf0bcc20d8804c0c1a53e58a54e3b3",
      "text": "……大家，变回涂鸦的时刻终于到了啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000040:dialogue:000": {
      "source_hash": "sha256:3b858422868e1fd502d086edda6a076dc9e01941d597bf6245c8a22953bc3574",
      "text": "是啊。但是，换作现在的你已经没问题了。\n成为了巨星的你，应该已经注意到了吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000044:dialogue:000": {
      "source_hash": "sha256:e4315ac51527045b91ca862d4e3a18801fa0362ce8451ace8d542231948e2319",
      "text": "梦想，会给自己的整个人生施加魔法。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000057:dialogue:000": {
      "source_hash": "sha256:6a51d15afde7b039d3395eea55f188097fe509ac8d43e90cc02cc058299c35bb",
      "text": "对眼中所见的一切事物，都——感到兴奋雀跃。\n对无论什么事情，都会萌生想要了解的兴趣。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000064:dialogue:000": {
      "source_hash": "sha256:50e1ecc08ee617dc1a8f8745f2d31bc25e622ea9c959c1d6f0c7d31429c6c84e",
      "text": "梦想，能让你每天都全身心投入！",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000076:dialogue:000": {
      "source_hash": "sha256:9f23f1d0176dad4eaf7392d6ba624df0717495e20a986435cb058d1d97c5c415",
      "text": "你想起了梦想的可贵。\n所以我们，才能放心地变回原样。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000079:dialogue:000": {
      "source_hash": "sha256:b0bda5feeaf889411e02bf890e857ee3434d50ee39d973f0fd87754f70278449",
      "text": "但是，若是迷失了方向，\n只要再次呼唤我们即可。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000091:dialogue:000": {
      "source_hash": "sha256:662664e6b59808f8cec3089c698305e0696afb05c6328997f063066013ffed35",
      "text": "我们，不论何时都在守护着你！",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000101:dialogue:000": {
      "source_hash": "sha256:8171047f91d3bc75cd9a70f7c3f3e181a67e4e9029459e48e8e69728fc0b7c8c",
      "text": "……大家，谢谢你们。",
      "status": "draft"
    },
    "story-text:v1:1_3_30002_01:1_3_30002_01_i:cmd-000103:dialogue:000": {
      "source_hash": "sha256:92e0758c18fe218a3635bd97ab0cc01a0bdb81b575aa73b9c1d71e2539ba2354",
      "text": "你们教会我的东西，我绝对不会忘记的！",
      "status": "draft"
    }
  }
}
