{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "025suz_307_2_3_025_07_09_a",
  "source_raw_hash": "sha256:1a37329ca033f5497a0ee37b68a6e9d3c4e49d4c63c0da21c109acb7763c4b5f",
  "entries": {
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:93c8e08706df0e9bd948f0eededf729b70e86c2fa68f213b8ec5bfb942f2eb3e",
      "text": "●●●●プロデューサー，\n玄武的事，谢谢你听我商量啊！",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c9ff46c1fdfe01d29cc332fe8d534d3824d913f9d1e1bdaf4258c85658c7ef09",
      "text": "我能鼓起勇气找他谈，\n全靠制作人在背后推了我一把！",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:73a7a4f6243bc50781b57418bf422373d6f40aa143e3a06b7fc98697e3c76f34",
      "text": "感觉是我想太多了，\n还给制作人添了麻烦，真不好意思啊。",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:52feb593afdef4521bc8477798ddef4b8b329c7cd47257e33ff5120793fdf1bc",
      "text": "应该从一开始就去问问玄武才对的。",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:71407f8b96e8d6280e0db3c8d59f2b9f5e7408f80c29afee59ed75b7dc3920ce",
      "text": "毕竟是玄武，肯定会好好跟我说的嘛。",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:e4dd575a31a0f82be1478d7d939dd8a856c334d46a1d00781c444addbbf04483",
      "text": "从今往后\n应该就没问题了吧！",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:9a0206e56560e0280261a4287a8ccc131e23f4eba1512dcf0c0ab7de47f57e98",
      "text": "能好好谈开\n真是太好了！",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:765ccf1b79495567363b820a39a0bc7964aa4c112a54e508c9113c898306a356",
      "text": "嗯！再次谢谢你啦！",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:79a080ddca75044b52167c7220bfc3781749357cbae3c22fb369f0fc01844624",
      "text": "我和玄武约好了，以后也要一起创造\n更多快乐的回忆……",
      "status": "draft"
    },
    "story-text:v1:025suz_307_2_3_025_07_09_a:2_3_025_07_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:e359bd12981d42fc1e341d90ada870cb4aaf41de80c43831200b7552513d5384",
      "text": "制作人！我们神速一魂，\n今后也拜托你了！！",
      "status": "draft"
    }
  }
}
