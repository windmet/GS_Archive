{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "012yus_401_2_4_012_01_09_b",
  "source_raw_hash": "sha256:48dfe26cf8739904a1f8d4aae714e792af2a5622aec739b32749ac04b062c083",
  "entries": {
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:ee1c8cfcfffae5737e071223b796516ff4dcab0453159f2cb02b5634159b8829",
      "text": "迟到了对不起监督！特产店那边\n相当挤。集合时间我一定能赶上的！",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:0f7dacd1c3976a65e9f9771f092b10113178b0dc873ac4182d327730f87bc72b",
      "text": "……天色变挺暗了呢～。到处都亮起了彩灯，\n终于有正式开始的气氛了！",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:bd5712ebb1d6a9555e8dd1b05680b6b9d005a888ae3b03846f199224d3317373",
      "text": "去看舞台了\n吗？",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:30de3425df6966d4b90c9b66b731c846efa5b6e2e92eefbf28d8546826b5d467",
      "text": "去看游乐设施\n了吗？",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:c318ab69e260ff0961301c64e80af0c50ea57fb291688471b831e058f77fbcea",
      "text": "嗯！不是那种耀眼炫目的感觉，\n而是带着奇妙神秘的氛围，好帅！",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:1ef8a8e7d9bb189e2972951d677dd2e7eead3f9cf90765d52a7a2b1289c60bb6",
      "text": "啊，看了看了！过山车装饰的那条龙，\n眼睛会发光，太帅啦！",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:2b779f07af2f23cb6ea0e15ee9be72263241016987ff031b4ff5af0e5b0b0b88",
      "text": "整个游乐园都呈现出和白天不一样的氛围，\n总觉得好让人兴奋！",
      "status": "draft"
    },
    "story-text:v1:012yus_401_2_4_012_01_09_b:2_4_012_01_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:814f22da7cbf6bcc797c65050ecbb2193b4fcc4ac101a673a5cc88eff7712946",
      "text": "为了能让客人们玩得尽兴，\n我们也得全力以赴才行呢！",
      "status": "draft"
    }
  }
}
