{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_011min_1_5_011_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000010:title:001": {
      "source_hash": "sha256:25a96208a58e53415a308e8f50e32987d05ebe519a83e7dfd7aaf20b169eab85",
      "text": "入浴剂广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:25cd149c0af5c63fc3a75218c95d251c4774e77082cb216ea6d4ec1497fc6515",
      "text": "●●●●プロデューサー，\n你在这里啊。让你久等了抱歉。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:ff65b5bee689e309d409efc30d16637e1f3ac084b6f3468ac9f2e0353debc4c6",
      "text": "啊，实先生。\n我刚才去打招呼了，没事的哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000024:dialogue:000": {
      "source_hash": "sha256:9dbc3d67952a39254ad3ddbb5b2c0289fcead00a5cd12c40aac27188068e602a",
      "text": "广告拍摄辛苦了！\n录制结束后您和工作人员聊得很投机呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:87b952f36f08cd2b0afe97af0bc1a4e736503c9fcf079e4e75d87e18fd1842e4",
      "text": "因为这次广告的入浴剂，\n有着很好闻的花香嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000031:dialogue:000": {
      "source_hash": "sha256:7541983d967ed8528f3c9eb2d2780bc825ce32935ba7f46b159031fd9317eee0",
      "text": "放松用的洋甘菊和薰衣草，\n还有散发着甜美香气的抚子花。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000035:dialogue:000": {
      "source_hash": "sha256:8b02b5dd54f5fa46b003b025a7a18127101f821c9ab2ed87af58c475c1a22ef6",
      "text": "我和工作人员聊到了哪种最好闻，还有要是再出\n新种类的话什么花比较好，聊得可开心了。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:ed9260f0722a9c8cbe82789a485bf4357e826063dea593d0ae1a4fa9b059044b",
      "text": "啊对了。我拿到了今天拍摄中没用到的\n备用入浴剂。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:a1054360d8f760313b569e7502dc9312fe5d311f07579b6bda7a4b4c39b20049",
      "text": "不嫌弃的话，\n●●●●プロデューサー也拿去用吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:5f5ba2ea17b074f947e5c9991c082473dd3fd8afe7603ea196fd3e4dc4cc9ea6",
      "text": "你平时工作总那么忙，\n加了入浴剂泡个热水澡好好放松一下吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:fb8a4e3fc2f34829f9b48967488a69d13dc7cc5f20645a84d1841d9171d1b969",
      "text": "呵呵，谢谢你。\n那我就心怀感激地收下使用了。",
      "status": "draft"
    }
  }
}
