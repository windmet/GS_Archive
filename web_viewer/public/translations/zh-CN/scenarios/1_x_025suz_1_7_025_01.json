{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_025suz_1_7_025_01",
  "source_raw_hash": "sha256:67e835082e13eab0fe9612f9389504955f959e7cd6af425e300b0a59e81dfd6c",
  "entries": {
    "story-text:v1:1_x_025suz_1_7_025_01:1_7_025_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:cecd8262d976a17c5dda580357e465b2b1759893771f1e959de04a3493a71910",
      "text": "朱雀先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_7_025_01:1_7_025_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:851915710cd8405a2bc85a88355cf9ced8adfd0e228a74ec57859ce20cf04021",
      "text": "哇噢！？●●●●プロデューサー，\n你还记着我的生日吗！？",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_7_025_01:1_7_025_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:600a8a91f954a20ed3ccb456ba64ac1e92c23eb527de3bebe7651368c4c8848e",
      "text": "没想到还能被庆祝啊。\n老子这是还在做梦吗！？",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_7_025_01:1_7_025_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:0bc61f35c8deb8509a807453d800b1e119a579a0aaed375af532e3a7d5eda95c",
      "text": "眼前●●●●プロデューサー的身影，\n都变得模糊起来了。",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_1_7_025_01:1_7_025_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:23ceeaee12bb921ddfad7f36ea22be25f6897d60a8c35c54927e9fe403b6cc70",
      "text": "老子才没哭呢！\n只是感动了而已。谢啦！",
      "status": "draft"
    }
  }
}
