{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_029_02_e",
  "source_raw_hash": "sha256:0c33f7a726cb39a6bbaf40692c1fa0a3d36edb35e4cb3f3a551d319422ebb871",
  "entries": {
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000051:dialogue:000": {
      "source_hash": "sha256:ea72727ece30a1d035e1d3ab246ecf8a4daa2c8b7099707ab5553f439dd35bda",
      "text": "阿斯兰，生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000071:dialogue:000": {
      "source_hash": "sha256:9f955ffb59d5fdad7af1c4408c44a138db60f104705ce2671340d0c2729351f2",
      "text": "这究竟是……？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000084:dialogue:000": {
      "source_hash": "sha256:cc6cc097253fed748223aca5f7858175832075a3eabb402fdd3e5d84076390fe",
      "text": "欢迎来到Cafe Parade。\n今天是为了阿斯兰而包场的哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000090:dialogue:000": {
      "source_hash": "sha256:4440829175867aa52bced7d99854d289ea0cda6323bf2867765112755f04a7d4",
      "text": "仅限今夜的特别菜单，\n请尽情享用到心满意足为止吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000094:dialogue:000": {
      "source_hash": "sha256:97eae0f15ab73d670401c2e63e5ac8198a2de26497bb167bf3e4d344a5fee30a",
      "text": "我们还准备了\n特制的生日蛋糕。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000110:dialogue:000": {
      "source_hash": "sha256:780a9518a0951b217ef4a8e7f91c66ee52dc70c2b81ed7dd28e763e2581a515b",
      "text": "吾、主……主难道早已知晓\n此项计划……！？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000116:dialogue:000": {
      "source_hash": "sha256:050043f82b2d996068a613b2437e41e4b9108eb1a20ed6625d23540fe15ad4f4",
      "text": "嗯，制作人也帮忙协助了哦！\n因为想让阿斯兰高兴，大家一起想出来的！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000131:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000144:dialogue:000": {
      "source_hash": "sha256:4412da09d3fec84916fd23497988355e22d34efe64b0de847fdd23065804746c",
      "text": "哎、咦？阿斯兰先生，您没事吧！？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000153:dialogue:000": {
      "source_hash": "sha256:adb69e809b2735fc12a6729a6b886362950ff79b0c940b626468fe8cf02dae3c",
      "text": "唔……切莫惊慌。不过是过于震撼，\n言语一时遭到了封印罢了……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000168:dialogue:000": {
      "source_hash": "sha256:4c37ece00365e4515b9eee9ff4e8dbb0923a24ff69e5b951eddda87bc6cfd65c",
      "text": "库库……哈哈哈哈！\n正如主所言，不过是无谓的迷茫罢了……！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_02_1_2_029_02:1_2_029_02_e:cmd-000198:dialogue:000": {
      "source_hash": "sha256:3510b5baaffe194c4934a70c7f0d392e33927ec0c0b96281130760effa115a9a",
      "text": "同胞们啊！吾感谢汝等之辛劳！\n便与吾同享这永夜之盛宴吧！",
      "status": "draft"
    }
  }
}
