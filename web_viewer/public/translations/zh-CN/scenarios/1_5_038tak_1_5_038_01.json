  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000010:title:001": {
      "source_hash": "sha256:e990085f5d4e1af6948d31eb28818277fb00d0cd6864e3efccf825ccbdf1eec8",
      "text": "水壶广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:85063771093ba5b2f9668dba764682944de29eac81ec6223f9b264cd786931cb",
      "text": "好漂亮的海啊。\n今天是要在这里拍广告吗。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:35a2e3be5e9841c63c0e86908fd097daa39987bd9e17013a2e926706edea98ca",
      "text": "是的。这次的拍摄在室外进行，\n能放晴真是太好了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:1ade56fb88c3d2834957564bd0e6e7d081d0bf3e2b1ba060b4fb1c85e11fd437",
      "text": "嗯。拍摄内容是在沙滩上慢跑之后，\n用水壶补充水分对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:91c91b96f2c1d50029dbce06019f625bfa7b7f7d2a84f78f75db2a23339767a6",
      "text": "是的。因为要拍好几个镜头，\n可能要跑好几次，您身体没问题吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:1fa1db1fb1d3e9be96db6a3071ddd02e49f62c6fc242a511ffb6c546a31c74fe",
      "text": "我没问题。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2b7f045fac9b0be6c48eff0e5bee5da70b1cc17ef0489d45bc07936c47ebb928",
      "text": "喂，●●●●プロデューサー。\n在拍摄开始前，我能先去慢跑热个身吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:149316d78061be4c61466ece3eeb889e7cd5c471bdc86b3b67cd4709b93a39cd",
      "text": "是无所谓，不过体力方面吃得消吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:7b20e77574ad939541e1ce26602516d85d49e8f2f13446185c5a94b9bd4b651a",
      "text": "权当热身运动，我想让身体先活动开来。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:5ed00ade15adeba8b9e25a6851d68a72c2e83492e51f9b8491064b1373c1eecf",
      "text": "既然是这样的话……\n我知道了，请在预定时间前回来哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:3bebefd68578bff08a0b3e76e3ac9ca746966c7be2049cfdddb6b56045f3b258",
      "text": "嗯。那我去了。",
      "status": "draft"
    }
  }
}
