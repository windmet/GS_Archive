{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "001tom_312_2_3_001_12_09_a",
  "source_raw_hash": "sha256:b1dcb9bd5c80f0eeb26f9f9895385a80d145b91c3b34683b23371440007f2c8c",
  "entries": {
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000007:phone_message:000": {
      "source_hash": "sha256:932e0ac58be7dde4fcf68e7ef4901b3c48c214f6fdeff8d00553f3e37976bf32",
      "text": "辛苦了，●●●●プロデューサー！\n拍摄结束了。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000009:phone_message:000": {
      "source_hash": "sha256:95e3a04cf5c121e285b252f10345021f8b374690db038666eaf82f7e09bb8787",
      "text": "虽然爱情故事不是我的强项，\n但直到最后一刻大家都在一起讨论。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000011:phone_message:000": {
      "source_hash": "sha256:575aa158ea59535ccd478c4d64cdcff14b217efa399dc3d74d025c71bcc3e29f",
      "text": "多亏能反复尝试镜头调度，\n拍出了令人满意的镜头。你就好好期待吧。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:7064f115962f4796ca8d4d129916438a5d7ac8799b7e268b7ac1f803d684c6d0",
      "text": "迫不及待想看\n播出了",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:eca2833551ca987a822563bd6c5dd117c405bb0b8d87b2964dac21a9f91b68e0",
      "text": "嗯！真的啊。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:698ed732452eb6fd599a66a80531a66c23067331a86acbce82cd7adcb02948b8",
      "text": "还有，收到了好多巧克力当特产。\n分量多到够事务所的所有人分了。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:1718deef9d2c04446f3a3d8641e5796dc7c39b54b514985cb801c1f9e52c8198",
      "text": "下次去你那边的时候带过去。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:39dc3e25b8492e759ebc5d2e84e590ced52c52b78626d22cf8483756dcd6b8cc",
      "text": "大家一定会很高兴的",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000023:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:a73da754e55b0142b4ede6c1dd2842a28a94713a17714fb1c2823aabb7fca0d1",
      "text": "你也吃点吧。\n工作之后，甜食也是必不可少的吧。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:831d806405980488cb480e66482ed4048bb54aec1bb219f5912930f9723bf202",
      "text": "啊，得跟翔太说一声让他别吃太多。\n那家伙，之前也因为收到的特产尝到了甜头。",
      "status": "draft"
    },
    "story-text:v1:001tom_312_2_3_001_12_09_a:2_3_001_12_09_a:cmd-000030:phone_message:000": {
      "source_hash": "sha256:7bc90ffeaa1c723ede665388a1851bb6b9d5ffb883dea278017f77d69bf5ac06",
      "text": "那就这样啦，制作人！",
      "status": "draft"
    }
  }
}
