{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_045sor_1_5_045_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000011:title:001": {
      "source_hash": "sha256:ef36764420c010870fa8a3c84935d23e22143ce00ccca392b477353aa400c6f4",
      "text": "电视节目中介绍新书的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:d2e20f0c53bc1c89780f0394e86433c8bf11e66c9869cff0f47469ef30a1f8c2",
      "text": "我用排行榜的形式，\n为大家介绍了新书哦～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:55dfaedf22a0a3e5015a4d8120e751454458959207f0bd81cd2d4a0d125ffd64",
      "text": "拿到第1名的冒险小说我也读过了，\n最后的剧情反转只能用令人震惊来形容呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3d51bf8fad53644469650345bbf0c01daf7f670e3e1de2848e7dede8a096ea8b",
      "text": "不太习惯看书的人也很容易读进去，\n请大家务必读读看哦～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000040:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:0ac94a321664d42d96702b809b25bbb027e9cce170295790d12383a4a8eea0f6",
      "text": "辛苦了。您的介绍非常清晰易懂，\n成功勾起了我的兴趣！",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000050:dialogue:000": {
      "source_hash": "sha256:68e132697b0e91464d8a7bd77196bf0e2bfcc8b896ff40f139f8c80fac7371cf",
      "text": "引起●●●●プロデューサー\n兴趣的是哪一本呢～？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000052:dialogue:000": {
      "source_hash": "sha256:09de5ddd89704b8100dcaf76fc8c588c949fc589467b9eb18e6dda07c4903895",
      "text": "果然还是第1名的冒险小说吧。\n等工作结束我就去买来看看。",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000057:dialogue:000": {
      "source_hash": "sha256:d47857f8ce81ca4cf79a0cdb0a96ec25bd52e764756e08371659acb0cf83d492",
      "text": "这么说来，刚才忘记介绍了呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000062:dialogue:000": {
      "source_hash": "sha256:76bb70ca3ea886ae3642985b535acf191634e635e318661ec2093947aec73944",
      "text": "与结尾的秘密相连的重大情报，\n其实藏在某个地方，那里竟然是……",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000065:dialogue:000": {
      "source_hash": "sha256:fa36dbb15b376e005cc949109e44c2e28ca80d84a7111066b1f726541bd5cb6e",
      "text": "哇啊啊！想、想乐先生，不可以剧透啦～！",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_02:1_5_045_02:cmd-000071:dialogue:000": {
      "source_hash": "sha256:7e1b7b56780afeccc1a8fc7009094a07cc156f3f5e8b1b01808daa7c70b5ad36",
      "text": "呵呵，开玩笑的啦～\n我很期待听你的读后感哦～",
      "status": "draft"
    }
  }
}
