{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "009kyj_402_2_4_009_02_09_a",
  "source_raw_hash": "sha256:5695857f6d97aefaf3d53e3b46846a6b5052b85c2ab563536c94d2e06ac8603c",
  "entries": {
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:41be738c6a6259b186055ea7fc0321dce1da44d2749a7490de3d3e59d43a621a",
      "text": "啊……突然打电话真不好意思。\n虽然不是什么要紧事……",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:458100ed8ed7f8424e459db51d53cc88c4470228936ada73ddf1ede3fcb24f4b",
      "text": "拍摄期间，我好几次都\n想起了你。",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:81a54a642dfa0c0164648c9557021922fad779ceb92d73c954cb5cac43c47be2",
      "text": "把我们的事放在第一位去考虑，\n在细节上也关照得无微不至……",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:2fc7c00a58ee792a15fbbf27ab4ad6872db037fda044ce4308591867fbdc401f",
      "text": "感觉就像执事一样。真的，\n一直以来谢谢你的支持。",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:8f2b24f7fa9a135ab1e0ec4d5d2785e06bd1f6799e0e6572415cb0a44666447e",
      "text": "您能高兴\n我很开心",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:be7e1f4dc143ea85464e56119e80076190d923501c2984aee4c0cf7cec4bf3b9",
      "text": "这都是我自愿\n去做的啦",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:6bf2c586b84ffc01b98cb7828e24c4d027c31f5fbb1ee6b677d190993ffe83d3",
      "text": "我就知道你会这么说。",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:494ca19f0e6ee2f71cbca79fff49f2a4ee797d4dbf7c2937b82b6fc41748bb1b",
      "text": "……你就是这一点真的很……",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000023:choice_short:000": {
      "source_hash": "sha256:974480219c4ea99bd87df9a65ea032537a111764b2a7e3fec4602de7cbdafe3e",
      "text": "恭二先生？",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000024:choice_short:000": {
      "source_hash": "sha256:bedc39a7b44843c85501b866d2010a614306a1e237171d433fd6243049de042a",
      "text": "怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:4d8f7807e6b8e554dfb5191f92fc5f75bcaf8f5b5690d92b8b3bc0cef66c4b9a",
      "text": "啊，没、没什么。",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000030:phone_message:000": {
      "source_hash": "sha256:86eea0467944dbac7b5cce2ea4c0aaca999ae5bfcee35e833a18fb6f4deb37b0",
      "text": "那个……今后也继续拜托你了。",
      "status": "draft"
    },
    "story-text:v1:009kyj_402_2_4_009_02_09_a:2_4_009_02_09_a:cmd-000032:phone_message:000": {
      "source_hash": "sha256:2992b539dffb6dbbe39131aa51584a7ae8ac717cd7dda2ef16057f430af8f54c",
      "text": "我就想说这个。\n……挂了啊。",
      "status": "draft"
    }
  }
}
