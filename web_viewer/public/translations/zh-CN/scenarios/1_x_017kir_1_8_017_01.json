  "entries": {
    "story-text:v1:1_x_017kir_1_8_017_01:1_8_017_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:d55517c23b3f00ed949dcc8eba365dd0956656f7d879ab489bce54a26107af3d",
      "text": "噼里啪啦嘭！今天是●●●●プロデューサー君\n诞生的大喜之日喵。",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_8_017_01:1_8_017_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:727d30eaa6b16aac2b339ac562c62a454eb3191d12e4608571967951e128ab72",
      "text": "●●●●プロデューサー君，\n祝你生日快乐喵！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_8_017_01:1_8_017_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:b0c9243658d4d2693f15fb647de520893cfd112c6fb714f84609e466049fa0f9",
      "text": "今天我要为了●●●●プロデューサー君，\n奉上一段全新创作的滑稽小品喵。",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_8_017_01:1_8_017_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:6f165df6db816a7b98d61c8ec3676e60f37a5277c38338280f550202e788dbdb",
      "text": "非常感谢！\n我很期待会是什么样的小品！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_1_8_017_01:1_8_017_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:3ce972e174689473cf45836b19ff0745a7ef671c8024555f0a7903eb724ab942",
      "text": "呼呼呼……那么事不宜迟，\n请赏光一听喵♪",
      "status": "draft"
    }
  }
}
