{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "020hay_402_2_4_020_02_09_a",
  "source_raw_hash": "sha256:24fcf959dba8f474b2eac8e3416ddc6c794cd78861c4c9d15acbdf7ab3b14fcd",
  "entries": {
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:e4f7a949bd11d2d756b30ee37269945e9ce510930b22c91b13c5c3b448e62f4e",
      "text": "辛苦啦，●●●●プロデューサー！\n拍摄结束了，我现在正准备回去。",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:b49405e74e1ad4770e48b5d61198911e0478097bb08dec5e83de5ad6dc6860c5",
      "text": "辛苦了",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:3433b2ff7bb8171806f35fbf783c1b045c613923a921ca735d56fa18c0bb90a7",
      "text": "明天的日程我刚才看邮件确认过了。\n时间没问题，就拜托你啦！",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:33c0f13fec1e12bd5ad83f8ddfb4b26821918ff3ad6a1ab9e420d89b4b3678dc",
      "text": "……诶嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:3114232fe53163e7e865b92ba0e38b3ac3cf77cbb674c33266b3ed0444921893",
      "text": "怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:d262892ee49250df883293aef08d5046b04be9e36ad2f27679b7af365d897949",
      "text": "我只是觉得，果然还是和●●●●プロデューサー\n这样说话最习惯啊。",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:d1790198b02b7952b30c2b8b24605e9dc7455b96eb67aa87a290d24fe76255be",
      "text": "前阵子我不是一直都在用敬语说话嘛？",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:bdf7d911271119024eec0f24a32830ba4d2dbb09564ab186359fd12ef5291aa1",
      "text": "每次一想要好好注意措辞，\n一开口就紧张得不行……",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:303af9c77f4f42661246a7acf133ba10d4a30bcdd89ef3740662c580cff31bfb",
      "text": "能像平时那样说话，感觉轻松多了，真好啊。",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:1be3fb2a0962d5ac8ba5c08fe227ac69bd64d62f95f177e954f9a062aff70f6f",
      "text": "啊哈哈，抱歉说了些奇怪的话！\n大概是杀青之后，稍微有点松懈了吧。",
      "status": "draft"
    },
    "story-text:v1:020hay_402_2_4_020_02_09_a:2_4_020_02_09_a:cmd-000030:phone_message:000": {
      "source_hash": "sha256:76de00c216ef2b8d44651f4c592e324da4b71e206d615ff644f788c6a89a29ae",
      "text": "那么，明天事务所见！\n工作可不能忙到太晚哦？",
      "status": "draft"
    }
  }
}
