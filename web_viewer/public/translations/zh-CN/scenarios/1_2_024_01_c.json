{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_024_01_c",
  "source_raw_hash": "sha256:82cdf61b8e2bf68657cd5822477fdeca568559c2d6d6db12975f4ea1b1f4c0b7",
  "entries": {
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000013:dialogue:000": {
      "source_hash": "sha256:12fcbae49d7e91f6ca69dc3e8ed7655a92a1fd6aa00ecd033f63d86782d28d31",
      "text": "孙子的大日子怎么能不来呢。\n这是衣锦还乡了呀。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000018:dialogue:000": {
      "source_hash": "sha256:9d6ba34f85e596dd90782625de793d303b88df8e6ac9529cbbf640c83bef4e70",
      "text": "谢谢你！我这就去好好表现！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000023:dialogue:000": {
      "source_hash": "sha256:02a74305037e3a7fb8f309b6fed4b4e7abcafcacc0990aecc2fb56266df2fb7d",
      "text": "是嘛。\n加油啊四季酱。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e5914c897ae781d443c1895b3d9076f0580f0cc9f8ce36e657074145e6c040e9",
      "text": "初次见面。我是负责四季先生制作工作的……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ffa17b115c8160cb39f1a151669b5882f99e1dab5206f53494da9537951f2aea",
      "text": "●●●●プロデューサー酱！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000040:dialogue:000": {
      "source_hash": "sha256:6821baa40cec0f2e720f88d01e447d095c389129f5ec6d8de1b40aca9a1c1489",
      "text": "四季酱承蒙您照顾了。\n我总听孙子提起您呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000045:dialogue:000": {
      "source_hash": "sha256:004487199f68ae0e17af20ce167a7b96faec525a9702a0dc0b713aba5fdc9448",
      "text": "每次都讲得可开心了……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000050:dialogue:000": {
      "source_hash": "sha256:2db76e5a112e874b4c6d8e087eb85e27c4f1ea6727e898549e592e1e11b99b66",
      "text": "差、差不多该去休息室了，\n●●●●プロデューサー酱！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000055:dialogue:000": {
      "source_hash": "sha256:b72a87a3e4ac9ef776f78a9e4e23661970b2ffb60c0cc54d0198f7296477f0d6",
      "text": "必须去跟客户打个招呼才行！\n还要开会呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_c:cmd-000061:dialogue:000": {
      "source_hash": "sha256:865f4fa690605fa69c28aaad80d17cb0cc5afed9f5d5f38c757b7b18a6cdbba8",
      "text": "奶奶等着我哦！\n我会让你看到我超帅的一面的！",
      "status": "draft"
    }
  }
}
