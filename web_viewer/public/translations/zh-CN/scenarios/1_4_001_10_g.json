{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_10_g",
  "source_raw_hash": "sha256:acd9bdebd0b67d2ca39a3ffe0b4d38a41f02323688a0578b452d159916f2f27a",
  "entries": {
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000099:dialogue:000": {
      "source_hash": "sha256:12c87a737d9995c8deabd084e9dbf03998a2c217ee19b1a23185208c2617098a",
      "text": "我们是打头阵的315 Production！\n大家请多关照啦——！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000106:dialogue:000": {
      "source_hash": "sha256:8414669922daffc32e0c556b3bec010ba34e278b3cb4e97189a674f9db4ce9d0",
      "text": "…我们要用我们的力量，打动大家的心。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000113:dialogue:000": {
      "source_hash": "sha256:5d4b1492965a02567ec7bfd84ced34b46330557f7b732d1aed52a90c0249ed78",
      "text": "我们要全速冲刺了，大家可要跟上哦——！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000121:dialogue:000": {
      "source_hash": "sha256:bd7af496c836b888f942e929fda0c5430132d6d396ec75c59f905b1f1f2f7a64",
      "text": "……咦？还挺不错的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000123:dialogue:000": {
      "source_hash": "sha256:dc44ef06792f71e31bc51452d6a1bc964209ba222f33fd62f3ec383b7ad1c1c4",
      "text": "感觉，是我挺喜欢的音乐风格呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000137:dialogue:000": {
      "source_hash": "sha256:bbd0dda832a80872a61c11d83782c098745c3214471e5e8b4c6de0fd01438617",
      "text": "涟君——！加油啊——！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000144:dialogue:000": {
      "source_hash": "sha256:4aaa2105868fba017b560ef573bae5c8c4e46423ec35ac6bbc75bebd6cdc4de9",
      "text": "啊啊！？你谁啊你！\n少对本大爷指手画脚！！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000149:dialogue:000": {
      "source_hash": "sha256:73608467405a21022bc43e547b961db8ec27fb0b60bf838bdc058977c23223f5",
      "text": "喂、喂，涟！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000158:dialogue:000": {
      "source_hash": "sha256:cf497efde89c78b54e4bc8a8f4a4c6c97226df4d55e87c394d6bd0705139992a",
      "text": "别向观众找茬。那个人是在为\n你这种家伙加油啊。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000176:dialogue:000": {
      "source_hash": "sha256:cd93bc8c4a929b248835c30fd28ddce57471c7ae151d53a44bbae689b68471a4",
      "text": "本大爷才不需要那种东西。\n杂鱼就给我像个杂鱼一样，老老实实赞美本大爷！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000182:dialogue:000": {
      "source_hash": "sha256:8230eb3876b80e725cb1b4ee2d4a805b31eca1cf277295656db67777fd991e72",
      "text": "要是敢说多余的话，\n本大爷记住你的脸一拳揍飞你！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_g:cmd-000193:dialogue:000": {
      "source_hash": "sha256:00de710de9f2ca610cfddf3d6e1f1895ea543c8557da465b6af4cc17d2410d0f",
      "text": "啊哈哈……这是他独特的粉丝福利，\n各位客人还请见谅！",
      "status": "draft"
    }
  }
}
