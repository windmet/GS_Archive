{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "016sei_401_2_4_016_01_09_b",
  "source_raw_hash": "sha256:fe2e8bf5a8ffdad488316dc3ba47536251e4d3bf10adbe614f202550568224e0",
  "entries": {
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:dd08e16f602d4da107c6eca3b2c4330e364a5a60cde625a4d206114703a24e7f",
      "text": "●●●●プロデューサー。\n我可以去参加一下神社的活动吗？",
      "status": "draft"
    },
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:71a96ca4498a69d0dfb4ed41f536aed8c82e0f48edea3b4a165c494d7d539138",
      "text": "我在各个摊位间逛的时候，\n有人问我要不要体验一下打年糕。",
      "status": "draft"
    },
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:86a20655fe43323273a890a8bd8b74fc91f610fdca2ec4bd98681d3901511e8c",
      "text": "没问题哦！\n我这就去您那边",
      "status": "draft"
    },
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:0f426815f9263bb88de9928a52ccd6c7b7a0f9a383046617dd3800083a5d95b8",
      "text": "听起来很有意思呢！\n我也去看",
      "status": "draft"
    },
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:385c18f41ab408b52c7f609cc4ea962f40d365e9c9568b10180a3481febb07ad",
      "text": "哈哈，太好了。如果有制作人在旁边看着，\n我感觉自己会更加干劲十足。",
      "status": "draft"
    },
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:85e0867dd0e4a38d81fb74cd374d0193650c2c391c908fa837e27bc2541769c6",
      "text": "哈哈，谢谢。木杵看起来挺沉的，\n正好能发挥锻炼的成果，我很期待。",
      "status": "draft"
    },
    "story-text:v1:016sei_401_2_4_016_01_09_b:2_4_016_01_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:c3736d53fd5c98790d94c4b2529fda5a63c09fc31d1e6f4fbd4d3a74139f5f7b",
      "text": "我会打出最美味的年糕给你看的，\n敬请期待吧，制作人！",
      "status": "draft"
    }
  }
}
