{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "036rui_402_2_4_036_02_09_a",
  "source_raw_hash": "sha256:fc7f47959cf0aaf1b1841c996f5cacea8c4f21e8e085c0ec04368d0e743dca6b",
  "entries": {
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:a2db4127d535f98afd2bcf6f069689c8197c35f93c4e4dd80935e4b49eb1b500",
      "text": "●●●●プロデューサー酱，辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:b5240b6b353f74cfeb6bbf3a002a935c21316015d778a1078edc9c49c2b6666c",
      "text": "刚才在Live上看到的景色实在太难忘，\n忍不住就call你啦！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c1adaf8da208e5a24b69736eebd82a94abb01a9060ada337a73a3728cb87840c",
      "text": "我们各自组合代表色的应援灯\n亮起了好多，你看到了吗？太Beautiful了！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:c8437da922b05a66a006272ae646cc70f57e96453c9e5b620e3abbd8e90368f7",
      "text": "是的！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:0daaae0157006980e1da6f71b35b902f2e4b6b808c3f75a3cdfa34296c8c97a5",
      "text": "能被那么多的粉丝和客人支持，\n我们真是happy person呢☆",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:95bc43da13db1cb78b7a2a4d21db0628cfeeca8842070dd2be6ae59b6a2fbdc4",
      "text": "嗯，真的！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000020:choice_short:000": {
      "source_hash": "sha256:b312d57d90b4806b31091ffeeec862217ca240c4ca4578230ae619ecc9fd3f82",
      "text": "今后也一起加油吧！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:b2dbc7630561265216916667a93b2f61aaaa778f34f4888cf64195480f5bd6e6",
      "text": "Of course！我相信肯定也有人在看完我们的舞台后\n变成了粉丝。",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:0daa429301886977cd0aff6e0edb1caea2831528d061941f62a0a18609800aea",
      "text": "今后大家也一起让粉丝越来越多吧——！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_a:2_4_036_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:b731cac81b4d4d3cf253abcb9543820ba98ea76c0a172ea0123b9647c69a2087",
      "text": "为此，今天就先好好休息。Good night，制作人酱☆",
      "status": "draft"
    }
  }
}
