{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_401_2_4_040_01_09_a",
  "source_raw_hash": "sha256:a4eb78c151615e09e53585c375af01e82b7a450ae04ab402435c9b86dcb93cee",
  "entries": {
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:b9c38baf87aeacdb974e2657bd2d67a58357f7516544632f68501915d4367665",
      "text": "喂！放在事务所的巧克力，\n到底是怎么回事啊！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1dfbfbb5b7ed60643ac41accdf2d335079f1b302f62602cc039b0962fe1680ac",
      "text": "嘴里又热又辣……！\n搞什么啊，别把这种鬼东西放那儿啊！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:34348de0b0632f6b9114bf327eba5c2b874bc5ae388ae2a702c366574ae0feeb",
      "text": "是加了辣椒的巧克力",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:66856d88f0c55b709f830b4990b697c026645b609bcc90bdd9e3168df6147977",
      "text": "哈啊？",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:a1b0ce5d80d9a4bcffbbcb413f7279979ffab23edc22d278a5a814191087f45f",
      "text": "凭什么在巧克力里加辣椒啊。\n莫名其妙。",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:0ce35739441e47b0e1d75a366416cf0b09c0020fb5ee935c7bc744d733a6a1c4",
      "text": "是吃不惯的味道吗？",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000018:choice_short:000": {
      "source_hash": "sha256:a947456cf9b06b954f793d70d04ed070b5ab4c8e0aa8ffbe94c5810a80450d4b",
      "text": "非常对不起！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:42a0d805f2fe67a8739748a62acd0e1547880f56b552d38dbbf0fd895e2b83a3",
      "text": "大笨蛋，\n本大爷怎么可能会有吃不惯的东西啊。",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:85cc497f07b0278ead3e418ebf4e9f8153a0f3ee62074a959be0069027f6d4bb",
      "text": "哼，这次就饶了你。",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:412f81b8445f4b015843814504dcef581aecb309418399f93a055cc417baeeac",
      "text": "居然能吓本大爷一跳，这巧克力挺有两下子的嘛。",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:d5da33615affb97158dfb6ee3b66fec9d365bdf59073ea8b8a321dd3809217e6",
      "text": "反正换成你肯定太辣吃不下去吧！\n对最强绝世大天才的本大爷来说，这根本小菜一碟！",
      "status": "draft"
    },
    "story-text:v1:040ren_401_2_4_040_01_09_a:2_4_040_01_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:33ede8b8b2ed84c1cc9bc99bdae46265ef7e5e0f557c8c3ab9bfc1b5f5684fb8",
      "text": "咕哈哈！\n给我准备更多巧克力来！",
      "status": "draft"
    }
  }
}
