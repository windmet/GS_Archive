{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_014_01_a",
  "source_raw_hash": "sha256:19fa9482794bcad9f9e9b58a94e0f579e3a4587671bd2e6cec274cc435125060",
  "entries": {
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:885ff181bf8db5bc2d96257322847ccef0e8a1e4bc9e28f6c16922070cd095f2",
      "text": "淋上满满的枫糖浆",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:ef3be77f2ddc950b6ef1147e68125f0965befa259a2d7a15a0c5a6a0f2884b6f",
      "text": "工作结束回家的路上，英雄和制作人发现了一家排着长队的店铺。那里正是英雄之前关注过的、最近大热的松饼店。机会难得，两人决定去吃松饼。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:885ff181bf8db5bc2d96257322847ccef0e8a1e4bc9e28f6c16922070cd095f2",
      "text": "淋上满满的枫糖浆",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:f1b9c458491485c9ac992b65e9dbc27cfbeb541cd9594ef785b0024fcc2599d5",
      "text": "录制辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:ecfc1718370edf1a107a57465018f1d5cf75cb5a3b3f22cb5617a07cb76808a0",
      "text": "啊啊，辛苦了。\n今天的录制也很顺利，真是太好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:0b691d5e28af9645ace1ff2c386779baa1fda81aeb01869f02b9ed1fbc4d75c6",
      "text": "是啊。很期待播出……",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:d6ab583deae619e2a7ff81f8dea8b1e80de4aed8f5871668f74193898769d283",
      "text": "怎么了吗，制作人？",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:e68d9ae6e12ae099e4f2412574a0f48ad45697027aa5d2cce840c9898b4e5ec9",
      "text": "啊，不好意思。因为看到那边排着长队，\n不由得……一定是很出名的店吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:75e991213aa9f08423c16450b62d6ecd548446e64269b01ab18e1479f0a62f21",
      "text": "嗯？……啊啊，那里啊。\n是最近电视上很有人气的松饼店呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000052:dialogue:000": {
      "source_hash": "sha256:5d69808538a270be012ec25401177a52163ecf9390ffd57c41782dbba1ae69f3",
      "text": "我之前也在杂志上看到过，留意了一下。\n这样啊，原来是在这附近啊……",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000054:dialogue:000": {
      "source_hash": "sha256:fa931b2f4bb440bf0a771d4ffb19c06f45d8ca19c9b8c1af6c3ded9cbd2ebb92",
      "text": "今天的工作已经结束了，\n机会难得，要顺道去看看吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_a:cmd-000060:dialogue:000": {
      "source_hash": "sha256:cebc3920ef0e59ed34fd60b64cf74d5e55ff1283ba894031faa17b3531b983c8",
      "text": "可以吗？那我们去吃吧！",
      "status": "draft"
    }
  }
}
