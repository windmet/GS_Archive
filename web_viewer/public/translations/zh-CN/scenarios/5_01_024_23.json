{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_024_23",
  "source_raw_hash": "sha256:fcb6a7776289d0ae19549452873b8b191c7578135a241672aa19c3df7bce75f3",
  "entries": {
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:39af31e89a0faeaf80ea618bec8b91d3cd68071801599cc27df13b5cbd8c1155",
      "text": "制作人酱，辛苦啦！\n现在稍微方便占用你一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:24a8149d2a0cd7bd58056658a8804b2dc0f19acfafca030b466552776917af51",
      "text": "四季先生，辛苦了。\n好的，当然没问题哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:b8b64c58fe0cde6503ff1c2cd919618826b8c211f7baae597bbd8a22acd3af98",
      "text": "谢啦！那么……\n来！Happy Valentine！",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:6f2530cb8fed82c74e02d0a6c428ee19eb55bd036ff3e76db66440a876997bc9",
      "text": "这是我的一点心意！\n希望能收下！",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:3cd7565eb6201a4c4c54b17917ec302231423000356e1ba3e1372cb492d9a239",
      "text": "这是，巧克力吗？\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:7b05dc39067b197ee412fcd11e1444e0d22dd0419c1bc30025be9cd5acb7f189",
      "text": "对呀！苹果干上淋满了\n厚厚的巧克力哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:50b405a6fbfa6e7dead697cb944b1fcd1b355d5cef9168c9cb0c34f13a292ee8",
      "text": "这个，超级好吃的！\n小时候我经常吃呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:287f34f83f9f8c16ffd44d0aa4ac03fc0f0287c367d1e3b51077fa7b036c4790",
      "text": "因为也想让制作人酱尝尝，\n所以我特意拜托奶奶寄过来的！",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000054:dialogue:000": {
      "source_hash": "sha256:64171c6946522284fc9f4ce00f835baf852f941e70ebae400d41b4d095372d3e",
      "text": "原来是这样啊。\n我会怀着对你们两人的感谢慢慢品尝的。",
      "status": "draft"
    },
    "story-text:v1:5_01_024_23:5_01_024_23_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:0ef4740d437e77b47a9cce7cbfe4e92b0b4c8e5ebac14caca6ae68aecc50e570",
      "text": "请吃请吃！\n要是喜欢的话请一定要告诉我哦！",
      "status": "draft"
    }
  }
}
