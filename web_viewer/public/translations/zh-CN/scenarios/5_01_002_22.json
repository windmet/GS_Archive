{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_002_22",
  "source_raw_hash": "sha256:16be4ab8846bc26e3856caead9802057935f4b79ec0a7c8edf441113ad17cb21",
  "entries": {
    "story-text:v1:5_01_002_22:5_01_002_22_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:138586009c8a8318f68d2049f88d5fa8583ad03ce2c1144d9e1ea51821eedcbb",
      "text": "这是情人节巧克力吗？ 谢谢♪",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:306f7c05d03b242f21e724fd5a5402068cfa20afa3ced2825eddb1be102ea584",
      "text": "嘿嘿，我就知道●●●●プロデューサー 一定会送我的！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:d091032d8522f0576b5b87d4670b4f9fa26c360d9d002796b5b333c4f61a44ab",
      "text": "离正式上场还有点时间对吧。 我现在可以稍微吃一点吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:e9e0ab21f359cf02bbf40ba2bdd7d6b5460952b996e7ce465887830df7ac8434",
      "text": "啊，不过还是等工作结束之后再吃比较好吧…… 嗯……",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:939c917dcecb991db58d6abf469f076f53ba83c2e28ac1958a7b47003cba8cf1",
      "text": "果然还是吃掉吧！我开动啦♪",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_a:cmd-000049:dialogue:000": {
      "source_hash": "sha256:bb0ff6e8c80b99a1b3ba46305b53c527371eb2f4cc1e8bfaabf69ed6e59876c9",
      "text": "这样就充电完毕了！ 敬请期待我在正式演出上的表现吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000013:dialogue:000": {
      "source_hash": "sha256:a6cabdef65f145b4ae8854fd7428602745e8aa103ec9b4c09bfbc7c7e93a2112",
      "text": "谢谢你的情人节巧克力！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:d8c5af78d51dcdb26b5d5420036c9b58bb4cdc6b094add35ba31180b885ec2bf",
      "text": "我就觉得能收到●●●●プロデューサー 送的巧克力呢～♪",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000022:dialogue:000": {
      "source_hash": "sha256:e207021cd2231251f9b74ce2a65cd2c0131494c46c89bff897275348c1319195",
      "text": "呐呐，我可以打开吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000024:choice_short:000": {
      "source_hash": "sha256:b9c7cfea9a2ad0ac08b8369a7ed6e7ac871d90458209843244d225bd617ae0e1",
      "text": "当然，请吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000025:choice_short:000": {
      "source_hash": "sha256:26b214d42512ffa4bcf883c3eb43da797bb13ccc2fd3612c6088505dc79d91d5",
      "text": "请务必打开看看！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:3e3e568d1c05a3ceb2ea19ed02fbde35379feb8698ab5a9b7124dc9fe61a1762",
      "text": "谢谢！那我就不客气马上……哇啊！ 看起来好好吃♪",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:ff8e54aea9b537eb54a38bba58bb0e4bef639eaa2b06ed186513532e23db0ee6",
      "text": "那我就不客气了…… 哇啊♪看起来好好吃！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000051:dialogue:000": {
      "source_hash": "sha256:365d0a54fba92b9a90251f07c40cd118c85d18ee0406cc4a34688e36057bfdeb",
      "text": "这款巧克力，我之前听工作人员提起过， 一直很感兴趣呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:433331af8b42d658ff21be75174d57a171a74b9001ab31f595528defbd888ad3",
      "text": "意思是已经提前调查过了？ 不愧是我的制作人！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000060:dialogue:000": {
      "source_hash": "sha256:9b2aba29f6febe59da68945d7f20d9a525c7eaac6b5b0d61993ad8fb13cb31f0",
      "text": "嘿嘿，我会好好品尝的！",
      "status": "draft"
    },
    "story-text:v1:5_01_002_22:5_01_002_22_b:cmd-000066:dialogue:000": {
      "source_hash": "sha256:ef12caf605cb84b6522c6686dc3006bd9054dcd6c2721c23c8390a8689bef1c3",
      "text": "白色情人节，你可以好好期待一下哦☆",
      "status": "draft"
    }
  }
}
