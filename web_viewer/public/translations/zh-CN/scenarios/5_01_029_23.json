{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_029_23",
  "source_raw_hash": "sha256:d1f367e5d3bf3644a5258148ccb12b2dcf149461ec416e664ad767dd59342480",
  "entries": {
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:19345841424e11194c0803cd364d807b23aa6367984b54aa8d4bc941c3f103f8",
      "text": "这次也同样为撒旦准备了供品吗。\n吾主啊，我深表感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:15df11aee915c4f726cc8f4b2232fcb92dfe07c0426aa51af8978b0c7b4c4af0",
      "text": "光之民也送来了许多供品。",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:e595531efd520ef7e20418bc74c4e0b7c3e850ad4bbce72841914c89e1dbb793",
      "text": "从附带的密函中，能感受到大家对撒旦的\n忠诚之心。库库……实乃至妙。",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000034:choice_short:000": {
      "source_hash": "sha256:402abb62f17c97a5d025415d02104ac0a6f3dcfd9199973725557616863a5770",
      "text": "每一样礼物都很棒呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000035:choice_short:000": {
      "source_hash": "sha256:b0a9ccf72f6e603af6d81114ecd100cf4ff20b56b1d0872e0d2e17c61cd0f5a5",
      "text": "饱含了来自粉丝们的爱呢",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a9d638cd6f09bce03c57ae35eaf43db39f7305a0ea70f41c07434ff0170ac355",
      "text": "唔姆。\n撒旦看起来，亦是满心愉悦。",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000049:dialogue:000": {
      "source_hash": "sha256:2147b6bd9b5f1dec69bf4e21eb3754bf1b897c3ce75dd1c1bff3b0c7927ae6f6",
      "text": "还有，吾主。我亦为主准备了，\n与女武神们的决战之日相衬的供品。",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000059:dialogue:000": {
      "source_hash": "sha256:f8f3012c60c3a39183994a012877883b83d767b6f781b08ee52d9f9b63ef1735",
      "text": "宿有甘美黑暗碎片的，\n野兽罗宋炖肉！",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000065:dialogue:000": {
      "source_hash": "sha256:bec166dc0a074a382c8f8f8439b3093cde13bd20f0cb74d4972336b3542f18af",
      "text": "哇，看起来非常好吃！\n非常感谢，阿斯兰先生！",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000070:dialogue:000": {
      "source_hash": "sha256:845dd730a39dd83b913379a36e4aa8c45f2253c927a76275e2e2785f8a426ce0",
      "text": "库库……何须言谢。\n此等小事对我而言易如反掌。",
      "status": "draft"
    },
    "story-text:v1:5_01_029_23:5_01_029_23_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:0589b02ed608ab46072788e7051cf4d3804da5ef653f433fa7debcae7211d850",
      "text": "待汝之魔力枯竭之时，食下此物即可。",
      "status": "draft"
    }
  }
}
