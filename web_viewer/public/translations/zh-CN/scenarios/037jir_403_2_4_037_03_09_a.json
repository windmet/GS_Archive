{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "037jir_403_2_4_037_03_09_a",
  "source_raw_hash": "sha256:efe8934f4079e6b8880c582321318be3b95b4c52384d68d1256a3cc82c1211e3",
  "entries": {
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:7ee38a8e19d5663a3a9cb5c66942251f4ae123c94593075edddec9e524f9bbba",
      "text": "●●●●プロデューサー酱，\n今天辛苦了。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:3fcb28eb15c34a72b7203011a175cf18c6984b24c4c345e810e84e66317f6bee",
      "text": "今天的工作真充实呢。\n不仅买了特产，心里也暖洋洋的。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6a7a14ce735770c84b012781fdcc7cb2a8879e17fa65c772be7e4363740a0f18",
      "text": "接下来的一阵子能享受丰盛的饮食生活了。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:e5071f91626e27d25173045fb7ef5c6a98af189970e17affea50fbc76c3069c7",
      "text": "然后啊，类说想用买回来的冷冻饺子\n办一场饺子派对。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:91d908c5bd2541c8f252d54f4d8c87d084e31fbf202916fa1bb0a7377c76e50d",
      "text": "硲先生也会来，\n制作人酱要是空的话也一起来吧。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:1c5f5dd090d3b4b693ff435f0385b9688a76eda56656e6b2f3085545320a19d8",
      "text": "谢谢邀请\n听起来很好玩呢",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:b9ed75f20b146f40a87954d8246ae46e5e65ba6f669c00101fe7e868379e0433",
      "text": "美食节的特色饺子，\n看起来很好吃呢",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:846eca1ba1937e431891885b331a0f78571fc99fa3fea7a709382daf163d6e5e",
      "text": "买了好多回来呢，尽管敞开吃吧。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000023:choice_short:000": {
      "source_hash": "sha256:73042c33f803d402dd4a1c6c6f128bbe845f096af955ba85b8574b078c88dcf5",
      "text": "我也会带些东西过去的",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_a:2_4_037_03_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:ff575ccd2c1eb3ad49a76cc523b39fc5ba53d4a1e64bb7fcfff90419121452f1",
      "text": "哦，谢谢啦～。\n那日子定下来之后我再联系你。",
      "status": "draft"
    }
  }
}
