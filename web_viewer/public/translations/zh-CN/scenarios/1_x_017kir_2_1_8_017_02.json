  "entries": {
    "story-text:v1:1_x_017kir_2_1_8_017_02:1_8_017_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:132bc7df7e7384796ac58649359e9c8f540573f5f919f198389578b47132acda",
      "text": "●●●●プロデューサー君！祝你生日快乐喵，\n噼里啪啦咚咚锵～！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_8_017_02:1_8_017_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:a60081755de81c3e61b32140d741b014971696422f4d637feb30448c0d451e3a",
      "text": "构思庆生的小品入神，\n一不留神太阳都已经下山了喵……！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_8_017_02:1_8_017_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:191018fc0c9b5eb62afa6402da5cf05598e8bfb4ab5e1531301c7a1bcfda1e89",
      "text": "制作人君，今天度过了\n愉快的一天喵？",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_8_017_02:1_8_017_02:cmd-000020:choice_short:000": {
      "source_hash": "sha256:8ecde634a87a9a46c5ab411f0e3cd0e6ea9dbf0dec4226363212e2bcc14bbc46",
      "text": "托大家的福，\n过了很愉快的一天",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_8_017_02:1_8_017_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:2296cd27402e6b4ccfb8259d7235c95a9016d03aa4afd672a9ec9be0639594cc",
      "text": "那比什么都好喵！大喜的日子就是要热热闹闹\n开开心心地过才最棒喵♪",
      "status": "draft"
    }
  }
}
