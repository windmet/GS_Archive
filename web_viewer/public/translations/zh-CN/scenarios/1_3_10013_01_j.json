{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10013_01_j",
  "source_raw_hash": "sha256:0b5364dfaafd5a9a906b6fcda4925ddca56fb15475c9b01cf0b5cddbfd9f6dcf",
  "entries": {
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000021:dialogue:000": {
      "source_hash": "sha256:396bfc148c0211731ea8a1a87313f37099af16899c09b1d06bab538859e3a0a9",
      "text": "这个嘛。我……",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000029:dialogue:000": {
      "source_hash": "sha256:bc2060c44898b4992984008835f0890f5aad69c47a5185c6ab6c3429989dc684",
      "text": "（即使能够从那一天逃开）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000032:dialogue:000": {
      "source_hash": "sha256:43eb3605db5c5f049c9e44eec0aec9b9ca7e30a152db97029acc02ef10a03f81",
      "text": "（在某处也必定会\n发生同样的事情吧）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000051:dialogue:000": {
      "source_hash": "sha256:4574224687e635f5acef902b009385ee94eebe3a5e04a1e2f588a17de02a596c",
      "text": "（然后……被仅仅一次的失败彻底击垮。\n在机场里，一直凝望着再也无法飞翔的天空）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000056:dialogue:000": {
      "source_hash": "sha256:4952e6db5a6b0d00dec507a4b94a8d5502919fb821cf766c785f7401f7fb9ea5",
      "text": "（……哪怕能改变过去，\n我自身的软弱也是不会改变的）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000073:dialogue:000": {
      "source_hash": "sha256:14cb0904786f53c5ae201c55a1abbde79106f2ab358f6632da52c4ea6acb1993",
      "text": "（就算一时粉饰太平，\n终究也是无法欺骗自己的）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000078:dialogue:000": {
      "source_hash": "sha256:c4794c06fb2e4c0d2c846218e64d24d8c346fc780c604893c83e893be6aaf3ae",
      "text": "（既然如此……\n哪怕做好了受伤的准备，我也想要向前迈进）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000084:dialogue:000": {
      "source_hash": "sha256:696c352aac3cd7964953e61d373c0594b4221ea86ee1bdc7840a6778ebb41aa1",
      "text": "（我想和在这里相遇的辉先生、薰先生一起，\n跨越任何挫折与失败！）",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000100:dialogue:000": {
      "source_hash": "sha256:a9e1336a1e86a335e2ae044891446bc0e95d84a0f4e351b0ca1e2e4959ee33b0",
      "text": "哪怕真的能回到过去，我也不会回去。",
      "status": "draft"
    },
    "story-text:v1:1_3_10013_01:1_3_10013_01_j:cmd-000105:dialogue:000": {
      "source_hash": "sha256:d9210cae3128ad664d282de079132bab43050a792a1019f42d25794ed920ad02",
      "text": "我想和大家3个人一起，继续朝前方走下去！",
      "status": "draft"
    }
  }
}
