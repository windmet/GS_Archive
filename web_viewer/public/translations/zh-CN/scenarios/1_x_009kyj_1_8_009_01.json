{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_009kyj_1_8_009_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_009kyj_1_8_009_01:1_8_009_01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:479f6127f74d87d7ced4d3c40ed69a78ae7078eb55c29a5c53bfabdcacbdfd5e",
      "text": "喂喂，●●●●プロデューサー？\n啊，是我。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_8_009_01:1_8_009_01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:164778b720df9fb37a370f5d67f71d083e0041211e30f69dcd087e7a923eca6e",
      "text": "我想起今天是你生日……\n那个，祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_8_009_01:1_8_009_01:cmd-000014:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_8_009_01:1_8_009_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:290a83df70e2cc7b07d7a0b618f2ca08e7ee6ca76d3f7147db544fa5addb69ab",
      "text": "不客气。太好了，总算好好说出口了。\n因为我很想祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_8_009_01:1_8_009_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:a50bc82db4e4a1314dbea5ad4bcdd7affbc9d2ac21af8637948ff1779aed3b0c",
      "text": "祝你度过有自己风格的美好一年。\n那就回见。",
      "status": "draft"
    }
  }
}
