{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_004_23_5_00_004_23",
  "source_raw_hash": "sha256:d4f7b4ba87f6b3707eea7a92a4d9abf3e17752cf36c90e53d3b5e9f7d9be4a8e",
  "entries": {
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000000:title:000": {
      "source_hash": "sha256:91959a8fccc342a7a33fbb01e1744462a949f8e8d5a879ac6464973a3cc89b8e",
      "text": "一起吃年糕汤的回忆",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000030:dialogue:000": {
      "source_hash": "sha256:5c4f5e8cde58acb5189188a7cfe4eca6d31c705a9602a4ea9a34ae12186df294",
      "text": "制作人，新年快乐！\n新年开工，好期待！",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000038:dialogue:000": {
      "source_hash": "sha256:5d12952afcacb3bc4a183085896b9252c2cdc8b2d8aaff242e4c5587461a56b1",
      "text": "新年快乐！一想到今年能接下\n怎样的工作，就让人兴奋不已呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:8e956684eddcaaefacbbcff0d17696d558e80ba0f35d89b3660398b70493ab95",
      "text": "新年快乐，制作人。\n今年也请多关照了。",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000046:dialogue:000": {
      "source_hash": "sha256:185ba2d4fc9ee2b39ba7c082b63fd68b00ab8ae8824c24250317ecc88bcbde53",
      "text": "好的，请多关照！\n大家新年假期过得开心吗？",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000054:dialogue:000": {
      "source_hash": "sha256:4586e29615c27a65244998782a958af7aeba4538c6a7184b3d0729a6b2b93383",
      "text": "嗯！去跟商店街的大家，打了招呼！\n满满都是笑容，好开心！",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000061:dialogue:000": {
      "source_hash": "sha256:6061c82719061ea41e5d364664733fb9ad94f263ceba74cb4f36ac2e879ff704",
      "text": "新年问候结束之后，我们在我家一起吃了\n年糕汤哦。还玩了蒙眼拼脸游戏呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000074:dialogue:000": {
      "source_hash": "sha256:824cb5775b7f241e999471cc5d9dcd3928fa678070e167cd174652fe014c4af0",
      "text": "年糕，好好吃！\n恭二的年糕，拉～得这么长！太有趣了！",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000079:dialogue:000": {
      "source_hash": "sha256:8d2b9722d01bb027d30932008c702764b0526523deef1218083396d3b95c24ea",
      "text": "那次可折腾惨了……不过\n倒也算是有新年氛围的回忆就是了。",
      "status": "draft"
    },
    "story-text:v1:5_00_004_23_5_00_004_23:5_00_004_23:cmd-000085:dialogue:000": {
      "source_hash": "sha256:db19a58b999477f84867ae57a0c867b109a866b5a10589b452ea8b67cd51c07a",
      "text": "新年假期也享受够了，今天开始工作也要加油啦。\n今年也请多关照哦，制作人！",
      "status": "draft"
    }
  }
}
