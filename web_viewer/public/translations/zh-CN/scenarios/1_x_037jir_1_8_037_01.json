{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_037jir_1_8_037_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_037jir_1_8_037_01:1_8_037_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:5eecc61ae86d594619c43c51929fec075d63e0828555b1ba06b90ef0c11cb7c6",
      "text": "●●●●プロデューサー酱。\n听说今天是你的生日啊。恭喜恭喜。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_8_037_01:1_8_037_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:8a6850692163d36ec26a2bfa8ea5f5d4a78fa8dac4ce80bdbd768c863566559d",
      "text": "啊，次郎先生。\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_8_037_01:1_8_037_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:d3f4a9f3ffc9b268c9536b2be7dfdb0b4953150b12af56352b998adf002f0c79",
      "text": "●●●●プロデューサー酱\n还是一如既往地忙碌呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_8_037_01:1_8_037_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:aa599cf2696991bb451196c2fd525caa4689559d0e70a4c7f7b2964adcde4873",
      "text": "勤快是好事，不过至少在生日这天\n稍微偷懒放松一下也不会遭天谴的啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_8_037_01:1_8_037_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:1ec458da143d4d963244a3b459aa6a8d2a2061f9dc2271c64d2dde3611a95ec6",
      "text": "好啦，大叔给你泡杯咖啡，\n歇会儿歇会儿。",
      "status": "draft"
    }
  }
}
