{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_003hok_2_1_8_003_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_003hok_2_1_8_003_02:1_8_003_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:2eded1ad9a62349ab0c3af6c2d1fbd72cd4abd18406107d5adf97c373d3a0828",
      "text": "晚上好，●●●●プロデューサー。\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_2_1_8_003_02:1_8_003_02:cmd-000012:choice_short:000": {
      "source_hash": "sha256:60e85f303a57a4535764d3d82bcb360e87d15d4189f70b428f7ce253cbd8710d",
      "text": "才刚刚\n过了零点呢……！",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_2_1_8_003_02:1_8_003_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:4568b1b057144517184218ae52d30f22f8107d24d392e7190c7b97ba39631155",
      "text": "因为我想尽可能早点传达给你。如果手边\n有杯子的话，能和我一起举杯吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_2_1_8_003_02:1_8_003_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:38752f51e1a5959bc118eb4928e2c98d54b40e97e3d0f4314db2f99da489625a",
      "text": "那么……\n为这一年一度的特别之夜，干杯☆",
      "status": "draft"
    },
    "story-text:v1:1_x_003hok_2_1_8_003_02:1_8_003_02:cmd-000022:phone_message:000": {
      "source_hash": "sha256:8b971fd552aa6a190e573038f697af4408dc4718dbfd01a3ea9c720edd102008",
      "text": "呵呵，虽说是隔着电话，但能像这样与你一同庆祝，\n我也感到很荣幸。祝你度过美好的一天。",
      "status": "draft"
    }
  }
}
