  "entries": {
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000009:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000009:title:001": {
      "source_hash": "sha256:89828192d579f18535395c18b60bc892f1f320255224c4760801d0c25d10ca6f",
      "text": "鬼屋体验采访的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000014:dialogue:000": {
      "source_hash": "sha256:1cd65cb8af1e9ffc87c7e9471f8acc3a2eb25c92ff2373064d6d1de07ad7529e",
      "text": "空无一人的游乐园，\n总觉得有种奇妙的感觉呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:057006d2502480642f56e3740ac320a747840153cfce0f250c1d164b20dc12ab",
      "text": "是啊。因为今天是鬼屋的体验采访，\n所以特意定在没有游客的大清早进行。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000018:dialogue:000": {
      "source_hash": "sha256:1aa23c6a7e74df198b22f6eb53432ffce51b225813dfe2784f97bcb3ef58cdd7",
      "text": "道流先生挺喜欢鬼屋的对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:f6b7ed64d7c22d05cbecb3d50b2704a17a131008040c4fc268dd182720763108",
      "text": "是的！听说这次的鬼屋是最恐怖的一档呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:af967c2d7174910231fe9269978a38ad03b4dadca2382748c22cce6fd9756e70",
      "text": "哎呀，真期待里面会出现什么样的鬼呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:738ef015a6eae66aace525c8d6794914d5c22a5d5fecd17e8445e2d861ad4427",
      "text": "啊，好像差不多要开始了。\n那我就进去了！",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000039:time_caption:000": {
      "source_hash": "sha256:4b60862588adc9e6e95a88313cb3e21370590932c00c2068d98a0eeed5b4246d",
      "text": "体验采访后……",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:20727b2e5f0d552631564c68a953ff86853659d24463728aa4b0df4c1a4e84d8",
      "text": "道流先生，辛苦了。\n鬼屋怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:bed83e344ea7dfc43df085c70bc5bdf2d278b3e952c50f9778c80591b6286e68",
      "text": "很有意思！不过在出口附近有个小男孩鬼魂\n突然窜出来，当时确实吓了我一大跳呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000053:dialogue:000": {
      "source_hash": "sha256:fa199dcdd8b93d5ffc9f37e13ca6270f929fedb9b8cf544c692a6c8aa7f51bcf",
      "text": "哎？我听说这次的鬼屋里，\n并没有安排小男孩样子的鬼魂啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_03:1_5_039_03:cmd-000061:dialogue:000": {
      "source_hash": "sha256:30bdde436d332d2dc4fe5c781c3fdc46c946a658029941fae55be1c8a6bf2aff",
      "text": "诶……？啊哈哈，怎么可能嘛……\n那个，刚才这话是真的吗？",
      "status": "draft"
    }
  }
}
