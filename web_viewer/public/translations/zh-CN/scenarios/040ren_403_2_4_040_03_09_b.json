{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_403_2_4_040_03_09_b",
  "source_raw_hash": "sha256:4b89f85f4c13a936a18f5146f264c49fb98a2d0cfbd7bbd514a1f970d2eaddea",
  "entries": {
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000006:choice_short:000": {
      "source_hash": "sha256:4a028ad518df77cf9dd078e576f7b20de107de6b4dfd7011478e76af3a4b2a1b",
      "text": "喂，涟先生？",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:e39a69252296842195b6550080c0b1d21bd7462c772390cca0ab641b3bce1e09",
      "text": "啊？搞什么啊你。\n找本大爷有什么事。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:571e03506238170c391ed89e0872cd65da7cee83487296e53977e0f6914f4c26",
      "text": "看到有涟先生的未接来电，\n所以打过来了！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:9b27a3a1989ee4fe8e0de116eca8b8912c29813c2419de4b01a014d674dfb8f2",
      "text": "是涟先生打过来的\n吧？",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:52e24a436521542bafdb1f95940554e54e295caa40973871b018919e90ac74df",
      "text": "哈啊？\n本大爷怎么可能会干那种事。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:eeb06612e63110015e1d7ab60e7875e463bd24711d1a915567b07fd8cad1aca6",
      "text": "不过正好。\n你，给我带饭过来。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:f9fb73a40f937a5c4e50eac0b16209ee0d752c46b1287d845df4273ed531193a",
      "text": "听好了，在训练室。\n马上送过来！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:166b69db6c327d6947b99959e28fcdf91d360d5b8e8cbe96de2a184387b036dd",
      "text": "磨磨唧唧扯什么废话。\n挂了啊。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_b:2_4_040_03_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:14491386a52bd1234e1729f3e11ae54026b2317abca916aea0dc20549e9f5a59",
      "text": "别为了无聊的事打电话过来！\n大笨蛋！",
      "status": "draft"
    }
  }
}
