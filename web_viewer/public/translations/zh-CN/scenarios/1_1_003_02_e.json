{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_003_02_e",
  "source_raw_hash": "sha256:53305e589baa3f5009d6f15348c14d1241275a96a53f062924f3d155f5d45c7f",
  "entries": {
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000015:dialogue:000": {
      "source_hash": "sha256:4c7eb5ee152f899168b7995c5970ac0adab5a860be1566e0a5d870d6e0a237cb",
      "text": "今天也没有联系。\n但是，那个歌声真的太棒了！",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000017:dialogue:000": {
      "source_hash": "sha256:a1770fecd3d38b9c3c1fc0efac4c6c6430821500189e55d4e6e39867cc79fedf",
      "text": "想把这份感动传达给更多人。\n如果可以的话，想再去发掘他一次，但是……",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000026:dialogue:000": {
      "source_hash": "sha256:c62399950082d0393c9a4bd06408fee32d406519c5282f0ce693794db32a93f5",
      "text": "也没那么容易就能再遇到吧。\n至少问个名字就好了。",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2c34df26a8b89ceeab865f516596b5778c1a80d46a181e31b60a812e938fb621",
      "text": "呼……呼……",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8094bedf2f09195e6463a2dcdc24e4032c6e2a6357ebccf34d511a34b4da9275",
      "text": "咦？\n在那边睡着的不是……",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000041:dialogue:000": {
      "source_hash": "sha256:0434fa536237735f7f39d8a9799f6526a3e08e9ceb038ce20ff23ebf63f38b32",
      "text": "呼……呼……",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000044:dialogue:000": {
      "source_hash": "sha256:252f3d4e02e7e39660ec5026e3c8c4f25ceb55c22744f82c27ddf21d68f3f3ca",
      "text": "果、果然是他！\n过去看看吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000064:dialogue:000": {
      "source_hash": "sha256:4ca561a7e1dc39a902129cc07a142ca7cf2c3ea28acbf04ac6eba8acb7383d97",
      "text": "嗯……\n这个脚步声是……",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_e:cmd-000068:dialogue:000": {
      "source_hash": "sha256:f586a19d13bb511cf50c50d43d4c57f5864b8fbae0f43622e5397fd75bb72e25",
      "text": "……？\n你是……",
      "status": "draft"
    }
  }
}
