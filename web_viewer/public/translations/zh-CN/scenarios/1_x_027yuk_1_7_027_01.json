{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_027yuk_1_7_027_01",
  "source_raw_hash": "sha256:a667c0b351278f3a5c9f78a936e6bcb40bf5fdd2ecffb971cfc25ffcde29596d",
  "entries": {
    "story-text:v1:1_x_027yuk_1_7_027_01:1_7_027_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:830e99bb9a4667c62e7943621a68ffffd148a8e9032cdfd9f8c8529b4c7fa2c4",
      "text": "哎呀，●●●●プロデューサー。\n是有什么好事发生吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_7_027_01:1_7_027_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:e352d84078a58cacfff21318587eff4f9706fa1fcadcacf76105a7635b710805",
      "text": "今天是幸广先生的生日呀。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_7_027_01:1_7_027_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:ea679fb8b6e1dbfe079aad8a62c85dd0182fbbe3ef88394f461707832d35e1bc",
      "text": "哎？生日……\n啊，说起来今天确实是我生日啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_7_027_01:1_7_027_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:47b6e41667dab619243681c1e73723a1681df15d239472842d8d4771b8024c27",
      "text": "哈哈，我从小就是这样。\n多亏了●●●●プロデューサー才想起来。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_7_027_01:1_7_027_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e8cfb18139da881caaec7b4eaf7412ae7bb8a801f530e445f9f37de18bc8aa70",
      "text": "谢谢你，●●●●プロデューサー。\n能得到你的祝福，我很高兴。",
      "status": "draft"
    }
  }
}
