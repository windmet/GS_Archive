  "scenario_id": "1_5_003hok_1_5_003_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000010:title:001": {
      "source_hash": "sha256:09b4b2baf11b243f91014558abe3b9f2af1398ed9182b6ec41dd53a703e223d4",
      "text": "在电视剧中饰演富家少爷的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000014:dialogue:000": {
      "source_hash": "sha256:ff4bb57f6e49d952e1ff5f0e52d84dbbbcd6f01e81e6ed18dd6437a53af61728",
      "text": "真是配得上大财阀世家设定的\n气派豪宅呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:443d336dbb3bd2533dd9ad29c6039416455a6aae86dde973e70fd44b398f2b88",
      "text": "北斗先生饰演的是少爷的角色呢。\n塑造角色有难度吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:eab8de0a446813190314c0d397e64ce33e6af759d06ef2a2da2c41fe4f76bd1f",
      "text": "毕竟是个和我性格截然相反的角色呢。\n说难确实也难，不过挺开心的哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:5a2373032f0ab33cfe3d5b816926194f2f7d248242a8a2c927aeb17926284a5a",
      "text": "正因为是和平时的我形象不同的角色，\n才正是有机会展现出我全新魅力的时机。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:883b0cc0933439a2273461b41726035f3881ad6a6cdf3420fb4e671b04e8c9e2",
      "text": "很棒的想法呢。\n真的完全就是这样。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:1f164aa47921ca29cda6fe08810f5b3cf167661cf3d080faca37215841db6101",
      "text": "●●●●プロデューサー要是在今天的拍摄中\n能发现我全新的一面，我也会很高兴的。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000036:dialogue:000": {
      "source_hash": "sha256:1040a94dfb84b35cba145968ac4797fefa453b570ae1b8977b5a1e37b764ea03",
      "text": "好的，交给我吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:18fdd988656d30e1221992a8e5342ad2365297be3e0970fc76bd375d57074c64",
      "text": "那么，我差不多该去准备了。\n想好好投入到角色中去。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000043:dialogue:000": {
      "source_hash": "sha256:7b17178994144045549f56f379aaabfc92170c4350db7e0acdc8871db60f02fa",
      "text": "不愧是北斗先生。\n拍摄请加油哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:c3584f0bf8a30cbca1313b673a829ee3ae74515d14744d2377099a7c85269782",
      "text": "（拍摄进行得很顺利，北斗先生的演技\n也得到了导演的高度赞扬！）",
      "status": "draft"
    }
  }
}
