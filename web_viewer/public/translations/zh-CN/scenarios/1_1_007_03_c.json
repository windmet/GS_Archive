{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_03_c",
  "source_raw_hash": "sha256:7d735317fc074598b4036684fdd9a2a0484908f4e2028dee4d886916839bb30c",
  "entries": {
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000027:dialogue:000": {
      "source_hash": "sha256:189fedd65409321d81ca05b2694e5e8e7965c5c3f2ab2235f13da6c7312f6431",
      "text": "（没想到，已经在演艺圈大显身手的人，\n也会来参加偶像的试镜）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000030:dialogue:000": {
      "source_hash": "sha256:68449c91f3e9468bb9ffbc97958b9c988dfd5df7fc77d4f936a79e2541534814",
      "text": "（……比起只专注于茶道的人，\n事务所肯定更想要有经验的人吧）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000034:dialogue:000": {
      "source_hash": "sha256:e5ea9a309f03f793f3ef03c4aef04baa369a55b74320aca3e0a81d1f6b491a62",
      "text": "（不，即便如此，\n我也不能还没做就放弃）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000039:dialogue:000": {
      "source_hash": "sha256:fd7537b0003120cfc963962b62ec97b83c380c2180215fccef34f0bed700d4d5",
      "text": "（因为我要成为偶像，向更多的人\n传达茶道的魅力！）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000056:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "几分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000073:dialogue:000": {
      "source_hash": "sha256:1b9324da9724d89c047a31f72ae72fef8828c8650726bed047e47c71663caf56",
      "text": "让各位久等了。315 Production的\n试镜现在开始。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000085:dialogue:000": {
      "source_hash": "sha256:fc1a35690048fd107ee29aaf021b0a0db70abe9a1196beb0353673f9efc37af7",
      "text": "在此之前，我们这边的评委增加了一位。\n社长，拜托您了。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000094:dialogue:000": {
      "source_hash": "sha256:8bd640a54171c519a376b3b11e7226d79ac65164868ef0c491b5806c58043a8f",
      "text": "我是斋藤孝司！听说有试镜，\n临时决定参加。请多关照！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000105:dialogue:000": {
      "source_hash": "sha256:9d549bea60e83a7853859ecaec3cd15111129087427bfa8f1f80bfef76c80fd1",
      "text": "我们才要请您多关照呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000110:dialogue:000": {
      "source_hash": "sha256:2a341d756b634a988151527f0e88654f2e3c735de0f99f9a17e68bd6903e75d3",
      "text": "……请多关照。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_c:cmd-000116:dialogue:000": {
      "source_hash": "sha256:bc93e2424daa9a21a7a0b74ec0efe58d52ed0c22247136a476d1ea285cd021b4",
      "text": "那么，首先请进行自我介绍。",
      "status": "draft"
    }
  }
}
