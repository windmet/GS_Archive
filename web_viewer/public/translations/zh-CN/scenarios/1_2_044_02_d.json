{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_044_02_d",
  "source_raw_hash": "sha256:6b760d9a8eeea21fa60c52fc927aec66208bbb284b1044189051e672f0ab8b5a",
  "entries": {
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000020:time_caption:000": {
      "source_hash": "sha256:0caba00123987c65267cb553eff1c391af5c1350a25058166325804f0b0c7b21",
      "text": "生日当天……",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000034:dialogue:000": {
      "source_hash": "sha256:cf73ae9f335c364d3b1367e6a1744fa521cc452a74f433435f2ee33b2eb3a157",
      "text": "雨彦，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000036:dialogue:000": {
      "source_hash": "sha256:888454f3c236f17d2ce8b6333c5e3f5d8899a37f00f2cfa2421442e5225a5986",
      "text": "祝您生日快乐，雨彦先生。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000044:dialogue:000": {
      "source_hash": "sha256:27ff7382b8cbd89c21878d7715dfb9a3e871dd7da5f557f0a6ac10c3f8dd5142",
      "text": "生日快乐～。这是大家一起挑的哦～。\n里面的东西就留到打开之后再期待吧～。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000049:dialogue:000": {
      "source_hash": "sha256:d25253b7b67a1a380e76d2286360e95e595505abd3791e1e9602e33dab3db875",
      "text": "连生日礼物都为我准备了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000052:dialogue:000": {
      "source_hash": "sha256:6b00d2ddfb10f29e2ce885c5fe0c1ce9ca1b55935260eee2e974a989124e72a9",
      "text": "谢谢你们啊。真没想到你们居然背着我准备了这些，\n完全没察觉到啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000057:dialogue:000": {
      "source_hash": "sha256:8f501fd5b14c7fef890cd727998f7c055a319ce67be56d3c614b5441cc3b6adf",
      "text": "就当成是这样吧～。制作人和\n克里斯先生可是非常努力地在准备呢～。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000061:dialogue:000": {
      "source_hash": "sha256:933e2186d92a56f047d05fa4d281e07ba99c7fb7fbc267de10ab79e9979901ad",
      "text": "想乐也提了很多宝贵的意见哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000065:dialogue:000": {
      "source_hash": "sha256:fcc2d4aed5de50925efa9219cc64568ec75136f2a1a79a2730e97b62f02b0417",
      "text": "选了我们大家意见达成一致的礼物。",
      "status": "draft"
    },
    "story-text:v1:1_2_044ame_02_1_2_044_02:1_2_044_02_d:cmd-000070:dialogue:000": {
      "source_hash": "sha256:9f371f6d7057ee579b104e579ba3ace1bd82b69df0c6cc73af0aec4aad63b954",
      "text": "嚯。那可真让人期待看看是什么呢。\n留作之后的期待吧。",
      "status": "draft"
    }
  }
}
