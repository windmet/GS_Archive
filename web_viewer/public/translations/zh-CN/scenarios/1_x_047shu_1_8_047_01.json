  "scenario_id": "1_x_047shu_1_8_047_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_047shu_1_8_047_01:1_8_047_01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:fd5d140d7776bea561e8c15de321fab633c62fa7be83fec7bf3f53be120746fb",
      "text": "……啊，●●●●プロデューサー？\n我正要去参加练习呢……",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_8_047_01:1_8_047_01:cmd-000012:choice_short:000": {
      "source_hash": "sha256:8c8ab65d5bf59e73715eb445fdbfc0d1c4c92ce08eaee4d0df08cfe69e65ce88",
      "text": "发生什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_8_047_01:1_8_047_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:eece3064b04da6e62dbe3a142d0c46021c6741f67af7c51785e841d03db57526",
      "text": "哪有什么事，今天不是你生日吗？\n祝你快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_8_047_01:1_8_047_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:c97e67945f5a3b7cde4e6d55f1ffcebffa62a4d857ee20a7143dd4829329e27f",
      "text": "等练习结束之后，我会顺路去事务所的。",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_8_047_01:1_8_047_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:8439fad9214255c48cd40b05c506f88ed404bfb2c2dc56b6d3e37e76ae4e7854",
      "text": "我想应该不会太晚，等着我吧。\n那就待会儿见。",
      "status": "draft"
    }
  }
}
