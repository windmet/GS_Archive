  "entries": {
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000010:title:001": {
      "source_hash": "sha256:78956b85a37261e7d3641cf56a11b3a021056a755e2a0827075165c903f9454a",
      "text": "知名历史小说舞台剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:7dfdcc1ec42538dd29adb584fd4d5ebecdab9bc23f31325ad3cf58a13a8ca37c",
      "text": "“休得胡言！\n吾绝不会向敌人屈服！”",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000019:dialogue:000": {
      "source_hash": "sha256:6a9e86653d3699ef198f76f21d1a6dfd5d92010cee2f45d95d498c996ec0ccee",
      "text": "……是不是稍微，再多一些魄力\n会比较好呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e068940e3623928fa374ed29b7fcd3ee01037b9fb89107db57ba14276affba83",
      "text": "“休得胡言！？吾绝不……”\n呜呜，用力过猛咬到舌头了……",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000036:dialogue:000": {
      "source_hash": "sha256:95ca3415bfde7416822c16b62938330677a238049a610525a60c0be8085245fb",
      "text": "九郎先生，辛苦了。\n我带了慰劳品过来，要稍微休息一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000042:dialogue:000": {
      "source_hash": "sha256:78cc1cef1c2c61cb9d9e5439c05a002cc5c3d5455ef5d3b9410781f5184b4a17",
      "text": "●●●●プロデューサー……\n也是呢，多谢您。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:1888877e36e8be7f78dfef17b2dbfcbdc067b3e35f8146cdb7736c65d9b78edd",
      "text": "看起来似乎稍微有些吃力，\n有什么是我能帮上忙的吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:22d38661e7d594d19f81502fde8149147a3a254df4fc3e38fa80241d86538cf6",
      "text": "让您担心了，实在抱歉。\n若是能说一句不要紧就好了，可现在我还……",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:505e02b0aaf5480c2b3ad9f329a778ccb3440b29fae29c9dc7bf95354fd2bc46",
      "text": "但是，即便此刻尚且做不到，\n唯有精进苦练直至做到为止。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000061:dialogue:000": {
      "source_hash": "sha256:a57a9705a8012deeea4f25dd3f1ed487b2fbc744325b783085efd0efc50a3dec",
      "text": "那个，●●●●プロデューサー。\n能否请您稍微陪我练习一会儿呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:b6d54f82bd1932081b0ab3a8948b6874b4e01a1296fb23e08565939e6f4132f7",
      "text": "当然可以！\n陪您练多久都没问题哦。",
      "status": "draft"
    }
  }
}
