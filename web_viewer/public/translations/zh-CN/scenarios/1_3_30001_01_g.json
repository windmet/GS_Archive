{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30001_01_g",
  "source_raw_hash": "sha256:e398adf12581c9f63fddc6e6f679290fad998927871bdc2b7c153d679ebb7172",
  "entries": {
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000021:dialogue:000": {
      "source_hash": "sha256:6d5b9a2e5830064a27588c27c7626f53c07621d19841d9209761a66ebee5545a",
      "text": "我们谨向二位送上最诚挚的应援。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000030:dialogue:000": {
      "source_hash": "sha256:7c2de953284d458ef884937d2fedf46af124d23e4450fae807429d070cf1edd1",
      "text": "呀呼——！把歌声和笑容传递给大家！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000052:dialogue:000": {
      "source_hash": "sha256:a859814ecd674472d950765c76bc15846e11927d2f25b00218c8c61e84029141",
      "text": "请听这首——《想いはETERNITY》！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000069:time_caption:000": {
      "source_hash": "sha256:cbfb50f613c56d6d0336076995230c7035e54f363b9aacbef7928deaf024db67",
      "text": "表演结束……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000081:dialogue:000": {
      "source_hash": "sha256:7119c27625984ef68d8c1d1ea61cb39e869becd3890d211ff9c78a1a14db831e",
      "text": "感谢大家的聆听！\n愿大家的笑容之花，从今往后也能……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000088:dialogue:000": {
      "source_hash": "sha256:4f96435f64638e53cbb134fb089e70907d0db976608ea8b436d8981713f918b4",
      "text": "实，你哭了！\n怎么了，不要紧吧？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000094:dialogue:000": {
      "source_hash": "sha256:7aaef6352f232606ffa9b2a0998997f0aa31dc0c9fe50b3835cc7baee5e74585",
      "text": "皮埃尔……\n谢谢你，我没事哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000107:dialogue:000": {
      "source_hash": "sha256:3d389fde18c1ae4cf25fc599289a726da0c23fd3e238c1900a2082ebea05af6c",
      "text": "……二位，真的恭喜了。这个请收下。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000110:dialogue:000": {
      "source_hash": "sha256:8d799dbc5072b960190a91028f39510d7f2b8c0dc96af91e8db888767dc6ed1e",
      "text": "好美丽的花束……还有，那么精彩的歌声……\n谢谢、你们……呜呜……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000113:dialogue:000": {
      "source_hash": "sha256:7924d5e215d987d667d9937e05d1d11bb0c4e6d5c24981375017746ed448d203",
      "text": "……啊，你们的心意，我切实收到了。\n谢啦，渡边。你真是我最好的哥们！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000118:dialogue:000": {
      "source_hash": "sha256:da2ca485ab89a36a307fbc65ae2c69b5f569adbd1044cf39ccc02a088e110f49",
      "text": "我也是……作为朋友，\n能在你们的喜庆之日锦上添花，真的很开心。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000135:time_caption:000": {
      "source_hash": "sha256:7823f8c3b6be94411f17c1968ba69b64e83c516fdefe2ddece84d5a8321a6435",
      "text": "当天夜里……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000143:phone_message:000": {
      "source_hash": "sha256:ecefb1e6ac03061c9926c276102ddbe8d03c21fed6699b27b6f1565c5b16e034",
      "text": "啊，喂喂！\n制作人，我是皮埃尔！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000145:phone_message:000": {
      "source_hash": "sha256:b37877dc494e990518f0c0370bc6843e48b9bee90f4089fa6a34a6e9c2dc7bf2",
      "text": "喜宴，太好了呢！\n真的非常棒！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000147:phone_message:000": {
      "source_hash": "sha256:39f57c6c3aeda7cc875322a85b85e6b126acdb9596fa9cf2d5da5a88b5a4f0f3",
      "text": "实，哭了。\n我也，差点就，哭出来了！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000149:phone_message:000": {
      "source_hash": "sha256:f15042bd8b40a5df88da99b60c12aa2cb3f6afe464176fc519a9845177bdd4f8",
      "text": "我们的祝福心情，\n传达给他们两个人了吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000151:choice_short:000": {
      "source_hash": "sha256:8cb223181dc61910b8b3045c3b1ccb984ffb5719e859650e2fcca06f5e931548",
      "text": "一定传达到了哦！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000153:phone_message:000": {
      "source_hash": "sha256:94be1894304e786dd1a26c0e2e27d7c3dbaa9925d217575acea7de64b7bdad21",
      "text": "嗯！要是这样就太高兴了！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000155:phone_message:000": {
      "source_hash": "sha256:bd891f5f5eb88704a2c85cc353397f56bc9e42b4b80d8c38ab0c3d4d96757f30",
      "text": "喜宴要是每天都有就好了。\n那样就会一直很幸福！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_g:cmd-000157:phone_message:000": {
      "source_hash": "sha256:a5f23a226ff1d3d2e04651c688951bf229d9ec3f242aeafb68538f6c5cf72e70",
      "text": "那么，明天见啦，制作人！",
      "status": "draft"
    }
  }
}
