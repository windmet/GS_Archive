{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_014_23_5_02_014_23",
  "source_raw_hash": "sha256:e6a64c19e2857fe4012940a4851c9ff2728dc476d291653143ec950a861b39ee",
  "entries": {
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000012:dialogue:000": {
      "source_hash": "sha256:8d5397454afe454537ed51d764d4d9a9a406fc509ef208b72285732e9683d2b9",
      "text": "抱歉啊，●●●●プロデューサー。\n特意把你叫出来。",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000015:dialogue:000": {
      "source_hash": "sha256:44b653bc081e5f3fdd89209c6169b5e54d3a0c40e359cb2751b1877b79ba0965",
      "text": "我准备了情人节的回礼，\n想亲手交给你。",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000021:dialogue:000": {
      "source_hash": "sha256:34d792908865309fdb7ca189dee1b4dd277972ea656f5d88aba0c0f13a8046c7",
      "text": "这个，不介意的话就收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ea944bf123dbfa8d0de546ba5e7d1a81ca7a6309998d58969a99f518aec9a16d",
      "text": "这是我超级中意的一款罐装甜点。想着也想让\n你尝一尝，就特意带来了。",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000028:dialogue:000": {
      "source_hash": "sha256:9a729e4ce84932d590ae592c415e643167f000c16dfd01c8a0d97db9ad44c3c8",
      "text": "非常感谢，外观真漂亮呢！\n我现在可以尝尝吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000033:dialogue:000": {
      "source_hash": "sha256:e556b2aeb233363118ab2d3f1f024f92471134d51caa5f087433bdad87ad433a",
      "text": "啊啊，当然可以。\n能让我听听你的感想吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:31d3ff583a88cbb49aec21023c9af9801e04da047617b9813b166c327353cd7d",
      "text": "那是当然！那么，我就开动啦。\n……这真是！太美味了！",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000041:dialogue:000": {
      "source_hash": "sha256:207eb360796219f86106840c82ac62e77f5a1cb0679279f0bb4f7a8d833d9676",
      "text": "是吧？\n我就知道你也绝对会这么说的！",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000045:dialogue:000": {
      "source_hash": "sha256:8438af70c3c9c88f75472a7ebb364e2a3bb54e6b514d32646e728a136f804801",
      "text": "这样一来那时的约定就算好好遵守啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:ede571921c992e2e1b38f14288959dad6d756c9cbf7e96db4f2783a2437abcc1",
      "text": "是的！非常感谢您的回礼！",
      "status": "draft"
    },
    "story-text:v1:5_02_014_23_5_02_014_23:5_02_014_23:cmd-000054:dialogue:000": {
      "source_hash": "sha256:50901ccda88e06a552ce90254af7372ee06203f4cede042278c3b9c11b83317b",
      "text": "像这样，作为送礼的一方看到对方\n能这么开心，果然也是件令人高兴的事啊！",
      "status": "draft"
    }
  }
}
