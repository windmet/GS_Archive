{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_038_23",
  "source_raw_hash": "sha256:fb472b921cc4049d148d82a91693e9022576551a8368fe8c8d4d445277ed8ef1",
  "entries": {
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:4aa10f5240fd5c628e1a52b18e6fb4a37721f31a9a5df59ff1fac15fb2d5f6a9",
      "text": "辛苦了，制作人。\n我稍微借用一下电视可以吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:dee732862fdf4b1e6b2eca281c2a69bfdd8c11dfe3f243bbca835d8c1d8714b5",
      "text": "当然可以。\n难道是想玩格斗游戏吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:db9e49e7ba5447ff254d4ae836623dea684a974fb31a4610d8a096e72e5428a4",
      "text": "啊啊。自从那次工作之后，偶尔就会想打上一盘。",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:4a011eb2ee4d2ed34059245b6c35622413804ea75cfbe8f99702ebe83884c865",
      "text": "大概也是因为当时练习了很久吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:5fe7d956cae232ff1fb1c7c8afe18f22be509e3e0fcf72ce2416d2ee8fae0df8",
      "text": "是这样呢。\n当时大家玩得都非常投入呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:c41cfe725c097d9ffd273bc117690701d976018080b8293e6d2b98fa14db4ae7",
      "text": "对了，●●●●プロデューサー。\n方便的话，要不要跟我一起玩这游戏？",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000037:choice_short:000": {
      "source_hash": "sha256:1c920d5efa7c14d8fce395b7a024240e0072a09c18b664f0decb9584ca989fc3",
      "text": "不嫌弃的话我来当你的对手",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000038:choice_short:000": {
      "source_hash": "sha256:434e77bd8940b9a1eec320564c08c73d1102a04543273f456bee3b8873a75b5e",
      "text": "由我来陪你真的可以吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:d5adf7b77b93f2256c6c6119c27d9f9c7f7bd205a9b506982129c3d540384fd7",
      "text": "啊啊，我现在的心情正想跟你较量呢。\n我现在接上手柄，坐到那边吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_038_23:5_01_038_23_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:565d4d4636c6fecabbf516e77c19208e4037b712a4a055bc7c27b8d61ccd0099",
      "text": "好……既然要打我就绝不会输。\n我会全力以赴的。",
      "status": "draft"
    }
  }
}
