{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30007_01_a",
  "source_raw_hash": "sha256:30a7abd437fc900438e512dd8572c822503e88a9f530bbc5baabcedab4967bf7",
  "entries": {
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:523976672ec17c53caacd258fbe23a9728f6c46221edfc6d9fa511e2b7ff60d5",
      "text": "炽热5人的挑战！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:1113b913b9a5b567fb45b41f1c088f6efc193feb7a7fb386051e98ca14ae1764",
      "text": "315 Production在视频频道上\n开启的新企划。这次被选中的成员是\n实、锐心、隼人、龙、朱雀。\n初次一起工作的5人为了了解彼此，\n决定互相提出问题。",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000027:title:000": {
      "source_hash": "sha256:6bd711a0c587f0c078d13f61396e0634340adf4afbcabad0ac20aea8f2b2a191",
      "text": "序幕",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000027:title:001": {
      "source_hash": "sha256:523976672ec17c53caacd258fbe23a9728f6c46221edfc6d9fa511e2b7ff60d5",
      "text": "炽热5人的挑战！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:5a484064bdb87264ac479c300a530152a1b6e0de35e2fa6cfeedbf85eb9abdc0",
      "text": "打、打扰了。录制已经开始了吧。\n好紧张啊——……",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000056:dialogue:000": {
      "source_hash": "sha256:3929bd312a59bb8416e7d38b8300b72746f0f40f2ad274a3b240b486934d0a85",
      "text": "来，摄像机在那边哦。\n正在看视频的大家。你们好！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000071:dialogue:000": {
      "source_hash": "sha256:4a05d0c1492b349be0ebe4e5ebbf0ab73636811ea52d2b9bf590215a37d0f218",
      "text": "哦哦，这里就是平时拍摄用的房间吗！\n比想象中要宽敞啊！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000074:dialogue:000": {
      "source_hash": "sha256:07dca3fe479a88234a11ce9ceff97e09147b49c4672ec9436dec5fcc14c23639",
      "text": "嗯。自己能站在一直看视频的地方，\n感觉好不可思议啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000089:dialogue:000": {
      "source_hash": "sha256:e2f8e9d6eb0ed8d8332a6487c60d5255f8cef0551c211a51c34f55832c500e6f",
      "text": "座位顺序怎么定？",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000093:dialogue:000": {
      "source_hash": "sha256:06d6f4732238671b333679cee0d242c47fafb3b19ecade762c9de31af9eaa748",
      "text": "没有规定的话，\n按进来的顺序坐不就可以了吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000107:dialogue:000": {
      "source_hash": "sha256:7a126e6f9c58bf5cb34c7e4e1e5788b4585e4cd8e44acc9c28e43b4a7f980c5e",
      "text": "那我坐中间啦。\n好嘞，拿出干劲好好加油！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000150:dialogue:000": {
      "source_hash": "sha256:f65e157f0e30ba5072f7dd0d877b7e7fc12d987e8a0ef3e4f24f36c46a765ac8",
      "text": "那么重新来过……正在观看315 Production\n频道的各位，大家好！",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000153:dialogue:000": {
      "source_hash": "sha256:7a8efa16552c3a3a6ce7146a43658f85f85a10b3364b1e969411b18fbbd875dc",
      "text": "这一次是这5个人。\n不知道有没有在大家的意料之中呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000168:dialogue:000": {
      "source_hash": "sha256:b8f373e4d06317adb47ec04afa0a2af19fd19997ef803b4d3db0a2756bc5dc25",
      "text": "应该也有人觉得很意外吧？\n那么事不宜迟，来定企划……在这之前。",
      "status": "draft"
    },
    "story-text:v1:1_3_30007_01:1_3_30007_01_a:cmd-000172:dialogue:000": {
      "source_hash": "sha256:47a4a22738009fedfbdc7529a7442790a2f8d715b4152cebf1cce7ad75c08b0d",
      "text": "首先是自我介绍。这次可能也有\n第一次看这个频道的人呢！",
      "status": "draft"
    }
  }
}
