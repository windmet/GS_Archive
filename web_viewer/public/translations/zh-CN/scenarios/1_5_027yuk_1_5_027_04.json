  "scenario_id": "1_5_027yuk_1_5_027_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000010:title:001": {
      "source_hash": "sha256:3b8fd1aea9dc7975105ba23aaee259fbf2dfe1c592ec91ab2238f8299b82a483",
      "text": "日本电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000014:dialogue:000": {
      "source_hash": "sha256:ddba7b2450e66f471d917fd248a0b765908501e6be513593f58328e14cd80859",
      "text": "今天的拍摄好像抽不出太多时间，\n进现场后需要马上换衣服。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:a972093515991edb9b528c610bf619c75a8d623422e06db500b064405310f251",
      "text": "既然这样，趁现在先把台词确认一下吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:3b051a3b1eb7759c6709718263bc4c37bc5127b88bad631e05a89fe1d1541359",
      "text": "●●●●プロデューサー。\n可以的话，能陪我对一下台词吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000033:time_caption:000": {
      "source_hash": "sha256:16216436c5b82da4dd0de41754414e2d7a9993afd63ae3cac590ed427f10856e",
      "text": "一小时后……",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:4204f95e34d606e689ee15108c68a23adff2cc60c2c437c1f4e2daf92d4bbac1",
      "text": "谢谢你，●●●●プロデューサー。\n能在最后对一遍台词真是太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:70de6800bd952ce6c3dc0d4fcd4b7a5f132f76173571b6ba4f46dcb95ccd12d9",
      "text": "不客气。\n是个充满昭和时代人情味的故事呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:a06470930f11fa46bdb375c8c0383698b5199fc3e7f0938113286ba1480c0f80",
      "text": "幸广先生饰演的，\n感觉是一个难度很大的角色……",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:e0996608d073952691c3293bb81efe38e0376c3ef1b01426d122a563fe72a1fc",
      "text": "塑造角色时确实费了很大一番功夫呢。\n剧本都反反复复读了好多遍。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000059:dialogue:000": {
      "source_hash": "sha256:3224fb6465518e1a5f4e8b2aa3557115775bfc4d85ff15609974baec4f07488c",
      "text": "怪不得本子都变得这么破旧了。\n上面做的笔记也多得惊人。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:cd6b97a4dcea42a81ba846e616dc79eb46bf30087d57d61fb5fe4c059b6336a7",
      "text": "这点程度理所当然啦。而且难度越大，\n我觉得越有挑战的价值。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_04:1_5_027_04:cmd-000071:dialogue:000": {
      "source_hash": "sha256:4d37bdf4c4420a611bbc17f0a194e3783d7e4b55abf523307d29282f9a74ed07",
      "text": "……哎呀，好像马上要到达现场了。\n带着享受的心情去好好演绎一番吧。",
      "status": "draft"
    }
  }
}
