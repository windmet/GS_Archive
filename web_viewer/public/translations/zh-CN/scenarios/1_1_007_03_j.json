{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_03_j",
  "source_raw_hash": "sha256:7d735317fc074598b4036684fdd9a2a0484908f4e2028dee4d886916839bb30c",
  "entries": {
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000029:dialogue:000": {
      "source_hash": "sha256:cbd39aadd9bacbc16a6da5215bf3cca604c631925c542bc431831fd613e149a6",
      "text": "打扰了喵！……喵喵！？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000056:dialogue:000": {
      "source_hash": "sha256:a4ec2025a8b34231d14648878106fe2de674e85e23fe70f04660defe72730596",
      "text": "（噢噢，歌舞伎里见到的蝴蝶先生……）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000074:dialogue:000": {
      "source_hash": "sha256:2876fecc8431d775887934d9bc27f9fdd1039a15994578b77f965fe113888705",
      "text": "（这位人士也让吾辈叮——地接收到了什么\n电波喵……）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000100:dialogue:000": {
      "source_hash": "sha256:e7fbd262a03e80105574b38b79aaf4539fc61b08d0867bddecaf29fb821e20b0",
      "text": "（现在当务之急是成为偶像喵！\n这么说来……）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000111:dialogue:000": {
      "source_hash": "sha256:b74410a55489512b4ed621a39eed56dfb6b78ddaa15029ed74a7975b2c4d867c",
      "text": "咳咳。\n您就是制作人君喵？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000115:dialogue:000": {
      "source_hash": "sha256:683fc79b62d832f47397312e0274d0ee747c9db4abb40f221eea3b7770aeb076",
      "text": "是、是的。\n您是落语家猫柳桐生先生……对吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000120:dialogue:000": {
      "source_hash": "sha256:10817a2d0f6836e0d8b8772582cec98fca937a4cebe6c3fd211f8043a9334c0b",
      "text": "正是！吾辈有件事\n想问制作人君喵。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000126:dialogue:000": {
      "source_hash": "sha256:0039736f12f7ea8a5bc344882c4d9cf6456eb4e3c235ccfe57bc6a91d1ed6f56",
      "text": "话不多说！吾辈身上有“偶像的光芒”\n喵？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000129:dialogue:000": {
      "source_hash": "sha256:5d4da947d6b2da0ef430443c98e47ab911d872a752c096e0fa6044356a7b7322",
      "text": "（光芒……）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000135:choice_short:000": {
      "source_hash": "sha256:2bb2cc1fcef195b31b2992cfa5cc20e1fb8af8a1314d7d05c14572f25baa4d64",
      "text": "有的！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000135:choice_detail:000": {
      "source_hash": "sha256:da7e2d4b40b63f98e9fc566d7b5145da923c16c638a22c9f1885bf030e4dc72a",
      "text": "appeal",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000159:dialogue:000": {
      "source_hash": "sha256:32a44aed6697b73a71c7e17861d8c2a3d9681cd94d80912ce3aaa819a8a9b450",
      "text": "（在电视上看到的时候，就被吸引住了。\n一直想看看他在偶像舞台上活跃的身影！）",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000176:dialogue:000": {
      "source_hash": "sha256:54b91e5aeea40e2506f9fcff462ed667e8d70ac786a894d22f0259bd12406715",
      "text": "方便的话，您要不要来参加\n315 Production的试镜呢？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000183:dialogue:000": {
      "source_hash": "sha256:6d682b6c7f68b10a72a5ca9f16832f4b89808d590fe1760423b5dddfd1f07b89",
      "text": "喵什么！？\n当然！吾辈十分乐意接受喵！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_j:cmd-000194:dialogue:000": {
      "source_hash": "sha256:c1429e67621c66ac1cca99942af444822e86395285b039f8c288c8e547f33fd0",
      "text": "（喵呼呼，这样一来吾辈也\n拿到通往偶像的敲门砖了喵～！！）",
      "status": "draft"
    }
  }
}
