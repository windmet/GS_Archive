{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "027yuk_402_2_4_027_02_09_b",
  "source_raw_hash": "sha256:8558e78171cb325bdfc8e63eac3780678da98795cc4b95b5cffbe8435535f11f",
  "entries": {
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:7bc058873899636d218dab99e4a7932289efafea97a595ec75654d5873d5b56b",
      "text": "喂，制作人？\n刚才提出的策划方案你看了吗。",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:fb09667cba9d536165a124859b474051a6c863ef9a91583cffef2aa29151d61e",
      "text": "是的，我想在这次的婚礼上，\n尝试使用各种各样的花朵。",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:739f1528a62ea45f1cda470c854796bc82eb0a04016b6c4731312759fd089992",
      "text": "虽然资料里也写了，\n但种类和数量都增加了不少呢。能筹措齐吗？",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:8d562912bd1eaedf0cbad39dbf6db51c804356ce72df0247b654221c1170342f",
      "text": "很棒的想法，\n交给我吧",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:b88428b2aadbcbab5c16114d81c141139cd1344c5ef7a0bf472fe1b97bb62bfa",
      "text": "没问题的，\n我试着安排一下",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:7cd3ccd0fe15f6d453bd9125580e3306dbb61ce2b713a7d6b11c645aeaa3a8bb",
      "text": "谢谢你。\n真不愧是制作人。",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:bac069479201eb5f93fd0864062ce36c259d6b8e4b5e797746a3d443f90c0d48",
      "text": "要是又有想商量的事，\n我会立刻联系你的。",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:fe69590abc5dc02bb639da0f022b692ae99e3854bd34a1b62c154f2565628db1",
      "text": "为了办成一场能留下一生回忆的、美妙的\n婚礼，敬请期待吧。",
      "status": "draft"
    },
    "story-text:v1:027yuk_402_2_4_027_02_09_b:2_4_027_02_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:b392c8849ec371b679d523c9f616bacc65bacb26b8c363956754712fc100734b",
      "text": "那么，就拜托你啦。",
      "status": "draft"
    }
  }
}
