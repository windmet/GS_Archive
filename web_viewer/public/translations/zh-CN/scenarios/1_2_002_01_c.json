{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_002_01_c",
  "source_raw_hash": "sha256:7301b95c7282804360f2eab1e51d3d96d96adf689905edc7ddb2e91babc72c96",
  "entries": {
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000017:dialogue:000": {
      "source_hash": "sha256:69a50a1329fc5dc7b808d02ff0d32d9b8da503e32dd0914ec1c7c7afcbabafdd",
      "text": "这是5岁时的翔太！\n全家人一起去摘苹果时的照片。",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000021:dialogue:000": {
      "source_hash": "sha256:f03c95e5d4f15e0d1c643191dda6a7eaaeb794398367bd621d1d83456f0de2b4",
      "text": "是翔太用小小的手\n摘苹果时的照片……",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000036:time_caption:000": {
      "source_hash": "sha256:d97839694a88d3dbaae2835aa42718463b83dd8670118274c73ca9eac5ddd44c",
      "text": "事务所",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:71a4407baf9b4f73178d09ad8e9aebb6eed29d7f7c65274a85e4abe033910abd",
      "text": "能深深感受到翔太先生非常受家人的宠爱呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000045:dialogue:000": {
      "source_hash": "sha256:025f56806326236a7fabe2d92229e26c8f8b5d73b5bb29b0c98942218f24ee46",
      "text": "嘿嘿那是当然！\n因为我很可爱嘛♪",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000049:dialogue:000": {
      "source_hash": "sha256:b0911ae13c95db0b24c815129583279429e50e0560c0760b0811c1c365e95a82",
      "text": "演播室里的大家，\n也全都被我小时候的样子给俘虏了呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000052:dialogue:000": {
      "source_hash": "sha256:33bb2d717626cc72f5056031e3a36df45f0d031b5ba52c7942718955c093c1d0",
      "text": "是的。全都是些非常棒的照片和录像。",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000057:dialogue:000": {
      "source_hash": "sha256:6b52482244218fdbcad09361e3762527712f5d435c3a9d81fb950e0531c5c915",
      "text": "听到制作人这么说，\n真开心～",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000062:dialogue:000": {
      "source_hash": "sha256:da2c55ffeea9e00973a808f620b5a6afdab7312aa6eef38e250d4c732743524d",
      "text": "话说回来，要在这么多的照片里\n挑出来还真是辛苦呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000068:dialogue:000": {
      "source_hash": "sha256:825d8eff261a786b2350cfffe7a27b1213af8e7ce6dfdcdc5e1ac8210b026408",
      "text": "我明明说了带太多会让制作人很为难的。",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_c:cmd-000074:dialogue:000": {
      "source_hash": "sha256:e88a4551f46eaec3e056dc8b302689c049cfb07bba103131c56f227607a5b0e3",
      "text": "结果大家这个也觉得好那个也觉得好，\n拿来了好多好多！",
      "status": "draft"
    }
  }
}
