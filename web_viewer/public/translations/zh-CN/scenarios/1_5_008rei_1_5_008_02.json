  "scenario_id": "1_5_008rei_1_5_008_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000010:title:001": {
      "source_hash": "sha256:8db27b92a1c142f203109d638eafe6b45b07b19fbf5ffe1212716980913ce63f",
      "text": "护手霜宣传发布会的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:850a34dc01885dedd7b6f9b595fdc5bc2bc6e372d2f80a51bb86751088e30fad",
      "text": "与自己用过的品牌合作……\n而且，还被选为了形象代言人。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:fb780af49e4eb0bde66a98e2c9ba56e1db78aef0d5f9bb76763d6d4c6aa1fbe4",
      "text": "宣传的商品我也试用过了，很中意。\n为了让更多人使用它，我会全力以赴。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:b961c63e33bbc897647cb990e6382c698240eab09a40b65e9c3f811da2b9b54a",
      "text": "那样就太可靠了。\n因为对方也很看重实际使用后的真诚感想。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:eac0d04b5c9cc59d0a5438bd35e59465fcf63da9f8b59b8ce75c3db6724e1c15",
      "text": "敷衍了事的言辞是没有说服力的。\n这与音乐是一样的道理。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:c4636f29256236010c956699a82d30ec662ebc2b0b0e12f14941ac8d529a44d4",
      "text": "作为偶像的歌声也好，作为小提琴家的\n演奏也罢，光靠做表面功夫是传达不到人心的。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:942498ce8882610c7d166603d08de7b4238d2a43749b3f941077bac33294e96d",
      "text": "但只要我们倾注真心，\n想必对方一定能感受得到。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:9ee90c501fcc70de3c80acc4b202e75baeb241b011980988a5bd162aff3133e3",
      "text": "是的，我认为正如您所言。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:028618979f4e9089bc896d3f7c2020beac61a22b102789b351172d5f05076381",
      "text": "看来会场已经准备就绪了。\n那么，我去了。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000052:dialogue:000": {
      "source_hash": "sha256:8dd9a096d13d5abe0eb4c5fa2944827f095d70d26975ca9091cb0ee5d3608cd9",
      "text": "（多亏了丽先生的宣传，\n护手霜陆续卖断了货）",
      "status": "draft"
    }
  }
}
