{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "021jun_401_2_4_021_01_09_b",
  "source_raw_hash": "sha256:6dfafc46533fd6dd1aecc21b7a86538f570c45f8c9cf142051118d194723e231",
  "entries": {
    "story-text:v1:021jun_401_2_4_021_01_09_b:2_4_021_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:4de96656eca93ea08c5399eb1dceb14731222f832eb94b17512ce517187ced47",
      "text": "喂，制作人。\n辛苦了，我是冬美。",
      "status": "draft"
    },
    "story-text:v1:021jun_401_2_4_021_01_09_b:2_4_021_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:bbf11afeae8ab7acd097d88c75e6d323d763d16fbb839267fde9b02152226722",
      "text": "今天和一希先生他们的队伍进行了联合练习。\n大家合在一起排练，就能看到新的课题呢。",
      "status": "draft"
    },
    "story-text:v1:021jun_401_2_4_021_01_09_b:2_4_021_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:90dbd7461320502e1796cca20a7e387654c877e113b64de12918d1bfdf7ac945",
      "text": "看了对方队伍的表演，\n我也受到了启发。",
      "status": "draft"
    },
    "story-text:v1:021jun_401_2_4_021_01_09_b:2_4_021_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:128eba7f4fe04b941e713e63f451f833ab69d8d25f97d6bafefd7a1200e417bd",
      "text": "两个队伍我都\n很期待！",
      "status": "draft"
    },
    "story-text:v1:021jun_401_2_4_021_01_09_b:2_4_021_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:b33fddb3b7b4ddbfebbd3979de985197eb5ede5447adbed955e4aac2f905bd01",
      "text": "我们互相鼓励了对方。我们的队伍\n也会进一步提高完成度的。",
      "status": "draft"
    },
    "story-text:v1:021jun_401_2_4_021_01_09_b:2_4_021_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:c16796f67f37a84de00f0d7e9b1ad3c5a447f0288247aec1bb5391c29d59677f",
      "text": "为了在当天能做到全员动作齐整的行进表演，\n我们会努力练习的。那么，回见。",
      "status": "draft"
    }
  }
}
