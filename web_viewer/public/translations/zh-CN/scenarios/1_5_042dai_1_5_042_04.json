  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000010:title:001": {
      "source_hash": "sha256:07da3bb81ffa63096ed86026897aa61e2af2cc6f4ebc22e3f99fa47ea39c5088",
      "text": "出演冷冻食品广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:79b8002912a01c2e30796c11caeac08ddfb3d70f56662d49148354f38bd127df",
      "text": "今天是拍人气冷冻中华料理的广告呢！\n平时经常见，感觉很有亲切感啊～",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000019:dialogue:000": {
      "source_hash": "sha256:f7682219269987f7529c268af3026f06315772e8776ce4fb549bd9508fb57214",
      "text": "这份工作敲定的时候，我脑海里立刻就\n浮现出大吾先生大快朵颐的样子了。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000024:dialogue:000": {
      "source_hash": "sha256:93ef05cad419a0e09b2bdbada45de67cc9f8b7188c396dea576b794cf0103a28",
      "text": "冷冻食品很方便呢。没时间的时候\n也能简单又美味地填饱肚子。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:b608e27f452d2149ef820e9a06b993f4bb17285df3fe59e380f7e4d2cb2b8046",
      "text": "美味，靠微波炉和这个就能做出来。\n完全正如这款商品的理念一样！",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000035:dialogue:000": {
      "source_hash": "sha256:a2e7e11a193e480b52cd792be441d793856d549d15853964f088e485c7a6251d",
      "text": "接到广告工作之前没深想过，\n这也是多亏了企业的努力吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:a1f804c09b8916122fbe22828fccf1fe150d54916212050dbf7a72e4028319a4",
      "text": "是啊。而且碰头会上听到的\n对冷冻技术的执着追求，也让人大为吃惊呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000045:dialogue:000": {
      "source_hash": "sha256:95d19361dd13a5cfa0ce60dc576aeb0777487d735f03579369e9f01665306d17",
      "text": "没错，就是那里。可不是单纯冷冻起来就行。\n商品完成之前，肯定经过了无数次试错吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:d066b14ed20c197c96d1ecdaae4848840d037b19e8012d9edd95ffd5c589d8a1",
      "text": "可以说，这是冷冻食品专家做出来的商品。\n倾注了专家灵魂的商品……",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000054:dialogue:000": {
      "source_hash": "sha256:e8eb0bf9450ae955b1863841811a75ab165e737dcdc3d51bb8e31361133f2f22",
      "text": "所以，俺要在广告里把它的魅力表现出来！\n既然选了俺，就得回应人家的期待才行。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000056:dialogue:000": {
      "source_hash": "sha256:34c6b03b61b109601bed8ecfe6dcf733b0fa7353fe4c81fabd9dc87a599e543a",
      "text": "就要这股干劲，大吾先生。\n拍摄请好好加油哦！",
      "status": "draft"
    }
  }
}
