{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_032nao_2_1_8_032_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_032nao_2_1_8_032_02:1_8_032_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:c42b16bb904479f5c0c50b647334d05d837dd5c6394c55295c0753aea2e175ad",
      "text": "辛苦了。那个，在等待上场的时候，\n我有话想跟您说……",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_2_1_8_032_02:1_8_032_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:0d3bea1d8b55af478f8376da453efe7f9cadeb882337444391c8a35ed2069bb8",
      "text": "今天是●●●●プロデューサー的生日\n对吧？祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_2_1_8_032_02:1_8_032_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:2bf0b6b2b4d959f616db84ee5a952c845a420a12ed13a8787b54ae5e23e84546",
      "text": "谢谢你。能收到直央君的祝福，\n我很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_2_1_8_032_02:1_8_032_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:bda5e57bddc11c99cc549a19c5425539a5a02de1b7164980b8d1dfbafc22251d",
      "text": "诶嘿嘿……能好好说出口，\n总算安心啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_032nao_2_1_8_032_02:1_8_032_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:a32cc4a48a174e015e21b25d26eb41b4041002abc24492a8e5ab8684f428d07d",
      "text": "工作请加油哦。\n祝您度过一个愉快的生日♪",
      "status": "draft"
    }
  }
}
