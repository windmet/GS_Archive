  "entries": {
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000011:title:001": {
      "source_hash": "sha256:7b4686311156810b34a8ea8fd56ee26d22f6cf8cfd76b0f27f677214792532c2",
      "text": "儿童运动球鞋CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:340cde33995c6285d5998ded82ea22294ec67a92d501468f222ed92edb28ef2f",
      "text": "志狼君，这是CM拍摄时\n要穿的运动鞋。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:9c48b33c9d6260640553b44c9009618ba9a710d8df401c980dae1ea32fd091d1",
      "text": "哇，帅呆了！\n我马上穿上试试看～",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:aaac1fda2969feb2de948ceefc614e3ac7b82d6329527b7996b323af7f67956a",
      "text": "喔喔，超轻便的，太好跑了！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:5c967135b141c3748a072a0c280048ab2d587488a1b22a9d172abb40102d1cae",
      "text": "志、志狼君！\n不可以把事务所当跑道跑哦～！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:491abdc9588e39e8f7e85984faab0f18e8bbc23c30872c62626f4f0851f7245b",
      "text": "抱歉抱歉，一不留神情绪就嗨起来了。\nCM……是什么内容来着？",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:8ebdb7a9bc75f402ad0751dce02bb6749de521163b3e046ad79e16933a2437ea",
      "text": "需要你穿着这双鞋，\n在各种各样的地方奔跑。",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:ea2301039711e54b5130302f65554c5795de0d3ab6a96a9c45ceda953671324b",
      "text": "可能会很辛苦，没问题吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000051:dialogue:000": {
      "source_hash": "sha256:38f8eef333b8a867c855a1a0066d1062dac2b5f83c7b52388f1396daebfb2ea0",
      "text": "那当然！\n我本来就喜欢运动，尽管放马过来！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000057:dialogue:000": {
      "source_hash": "sha256:7073065f2d06e806f7141a010c61d7048433abb5cf54cefbd8fd26fd59423f88",
      "text": "既然要到处跑，那还是先习惯一下这双鞋\n比较好吧？我去外面跑两圈！",
      "status": "draft"
    },
    "story-text:v1:1_5_033shr_1_5_033_01:1_5_033_01:cmd-000063:dialogue:000": {
      "source_hash": "sha256:70261e0d3d6c627a2d3967804aea3d751f84995f1fb16b8c623296a8f36d2c87",
      "text": "那我走啦——！",
      "status": "draft"
    }
  }
}
