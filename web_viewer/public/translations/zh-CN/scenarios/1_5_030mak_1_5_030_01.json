  "entries": {
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000010:title:001": {
      "source_hash": "sha256:25fa26a01a5a921eb23d20cb4fab01be69c51ac3966f20727b70393106b6c342",
      "text": "TV学生脱口秀节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:ceddaaaecb90788477d69d2d7674dfe55c29a970f401a1b9801bdca8722d3e57",
      "text": "彩排辛苦了！\n在●●●●プロデューサー看来，感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:14c9f41cef8e14092fe7058f9286544cc4abf18b75aa6512e288d3dd8ed892dd",
      "text": "和其他嘉宾聊得非常投机呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:bf58599dc3ca4154afc104d56a4e9ad129179ff0f64353cb2c32e38278ebe400",
      "text": "看着非常让人安心。\n真不愧是卷绪先生！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:6ee98a9e9d7a75e165ba910978e13c990495bd0822973a290cbd2b5fa9f2619c",
      "text": "啊哈哈，谢谢夸奖！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:566711e7a1888781f2c4a5906f755116342d19dfd9502bf46a36f61d344b59a1",
      "text": "因为是同龄人聚在一起聊学生日常梗，\n所以可能比较好聊吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:027ff4a576d23baeb6361f2d54d1b806fab8ec613b4b646be3f029c5649a719e",
      "text": "卷绪先生和其他嘉宾，\n转眼间就打成一片了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:564d59766838d8f2f087ed1edc8695cff147ac4709bfd82c0ece82c5ae169aef",
      "text": "我从小就经常转学，\n所以属于比较不认生的性格。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:151bd1c381a75468e2e9ee257c8442463966755d6be664fbb9f6d5307ff12083",
      "text": "过去的经历化作了经验，\n一直延续到了现在呢。我觉得非常棒。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:f8a3bdc96582969f36834cee35afe72c3e039939d8270dd8bed35b0bf38cb1e6",
      "text": "能听您这么说真高兴。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_01:1_5_030_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:4ff3b536e6125fa9499545c0cc4b6d5e1cd13876bcd09a81834616fed9d13b3a",
      "text": "今后我也想继续珍惜\n与人之间的纽带！",
      "status": "draft"
    }
  }
}
