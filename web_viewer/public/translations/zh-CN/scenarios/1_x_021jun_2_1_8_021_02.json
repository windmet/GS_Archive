{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_021jun_2_1_8_021_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_021jun_2_1_8_021_02:1_8_021_02:cmd-000012:dialogue:000": {
      "source_hash": "sha256:9aa002a76710d9660745c4af3cb50c422507ced584c2c67fb74d7b6ec890c6e5",
      "text": "祝您生日快乐，\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_8_021_02:1_8_021_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:54c17ccb3c0a12d054ec74e8e8b82c75d30af254567586746248f308d4ea1537",
      "text": "衷心祝愿您刻下的新岁，\n能够硕果累累。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_8_021_02:1_8_021_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:5eb5730dd46e44a071f922c623e015b4fd1f10e1ac1da49dfb9aca23022219a7",
      "text": "谢谢你，旬先生。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_8_021_02:1_8_021_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:e2f8b8515377b62dd716209e3f374e19f391a6a9765e95e7a85effdc9173ee50",
      "text": "成为偶像之后，\n我的世界也变得更加宽广了。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_8_021_02:1_8_021_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:7a13394696d55de6648156ad41172d1d0c84435d5401bab30070ca9dc348f7ea",
      "text": "为了不辜负您的期望，我会继续努力的，\n今后也请多多关照。",
      "status": "draft"
    }
  }
}
