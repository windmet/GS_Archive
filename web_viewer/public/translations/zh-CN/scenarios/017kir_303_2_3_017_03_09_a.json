{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "017kir_303_2_3_017_03_09_a",
  "source_raw_hash": "sha256:7a5e3e99c4df86ca077223aef673783fa714b85c4d3fa64fa5fd6b8da62afe8b",
  "entries": {
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:213e9052c3d38a7af3251450ff29484d00edc3e3107c715ab6774d40dfaa00f1",
      "text": "喂喂，●●●●プロデューサー君！\n快听吾辈说喵！",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:ad6093a5746a40f7171334352b5cd9fbed736134729b3227266bb7c532985039",
      "text": "在练习休息的时候，吾辈给九郎君和蝶蝶小姐\n设了个专场演了一席喵。",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:abf9b973ffb82e959a5b0169bba4cf4d66940b659a48dc648b4f04a2411d5191",
      "text": "亮出了浑身解数的特别小段子，\n大受欢迎喵～！",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:733c289b6f32a4050063584de850056076f6a36cb6955c9643083221153d4e3a",
      "text": "好厉害啊！",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:9da2cba1b2fe7331f348ec7322f750c2d291cb1f5ba5f3336414398859a42ff7",
      "text": "不愧是猫柳亭桐之二！",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:d6c56a78424c285d76f5344df0afbd3d5ca7418d4a8d1691556ac486eb0cbde0",
      "text": "●●●●プロデューサー君，\n谢谢你喵～♪",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:d7eee1bf12dd40c2de7d4ebdd05eb74be5466a8a728f1591b22ddb4e0957edfe",
      "text": "喵哈哈～♪\n哎呀呀，这点小事不算什么啦。",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:bd919baae65589850c84e072e81ba667748a0c372fa2dd6d5f37beaf7beab9f9",
      "text": "今后也要不断创作更多特别的段子才行是也。",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:2c9e247c46b64977456e222477a3196649fb1101e1f121662ba532a14637a2b8",
      "text": "也会表演给制作人君看的，\n要好好期待喵！",
      "status": "draft"
    },
    "story-text:v1:017kir_303_2_3_017_03_09_a:2_3_017_03_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:4b408e2afc1fdee61c5a209183ba72e15a122f087c91ae8183bbd7de2516ddfe",
      "text": "那么那么，吾辈就先告辞了喵。",
      "status": "draft"
    }
  }
}
