{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_041_22",
  "source_raw_hash": "sha256:fab39e0f56fb7709b0dbdc0a5fdc55cc9d9d29c26fb60f18b1cb604836e8aabb",
  "entries": {
    "story-text:v1:5_02_041_22:5_02_041_22_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:7f1fa5053d278263798a3120cbe929d7e6b081f6a2fe71c8c7e979589ce7e9ed",
      "text": "●●●●プロデューサー，辛苦啦！\n能借用您一点点时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:df78a32b4a36ac5e9aed2149bb7308c4405384dcf8c932b9724b93db9a4d51bb",
      "text": "白色情人节快乐！\n巧克力的回礼，请收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:51b80979d5e863216ce4bf3c033c077f45b074819e25ee41dc41fb4e7adfa57a",
      "text": "收到的巧克力，我真的超级开心的！\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:20b4a26bb4e0c20eb3ec6865726fd91061acecf5c0161c041d04787708b39032",
      "text": "每一颗我都珍惜地品尝过了哦。\n每一个都非常好吃。",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d6ab4c7b9632567f97fb529aace1d7f9eb2f67673afc2614ce2aad59fbf4da0d",
      "text": "那么，我就先告辞了。\n接下来的工作也请加油哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000017:dialogue:000": {
      "source_hash": "sha256:9b980f3149197d8a4ec7a9f3ccf0ada5825a30e306aa68de8d9fa7a74eacea31",
      "text": "●●●●プロデューサー，正在休息中吗？\n刚好遇上太好了！",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e70760326f881d8242c08d90c0e9ef2cfeda72e52a771f9b608d3f13f5633a5b",
      "text": "这是情人节的回礼！",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:d68760e50fa43c86fbe6dc8586b89ad2d97b291acbb889693182447799b99427",
      "text": "从收到的巧克力里，\n我汲取到了许多力量。",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000033:dialogue:000": {
      "source_hash": "sha256:0e42a35c461e64b8a87b39fdd3eb32db80fd7df99ed5acc7f83c8fd80ebb5eac",
      "text": "所以这一次，轮到我来传递力量了！\n在回礼里我倾注了满满的心意。",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:4e342e8b05ba3bb03423dec26fdd4c9cb268758828c1adbf92bd6104139f6901",
      "text": "来，请收下。\n不嫌弃的话，请收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000041:choice_short:000": {
      "source_hash": "sha256:db05aa835f55c0e68c7bf87f7ce3556dd15795b60168448570a76379bd739dd3",
      "text": "从回礼中切实感受到你的心意了！",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000042:choice_short:000": {
      "source_hash": "sha256:432b1be50d22e1402a906bd5a94e2ab1841febe40a290196a3ef57d3c9179c80",
      "text": "非常感谢！好开心！",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f5f310b7022887bef19ebf5c087838d31d38405962623937c28153042f4deb87",
      "text": "嘿嘿，能让你高兴我也好开心。",
      "status": "draft"
    },
    "story-text:v1:5_02_041_22:5_02_041_22_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:932e8a81cc317258cea450c7d57f3b15eaaee1fdb76012712b7aef41c662bbd2",
      "text": "今后也一起加油吧，\n●●●●プロデューサー！",
      "status": "draft"
    }
  }
}
