{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30009_01_g",
  "source_raw_hash": "sha256:0b7f774b23309d281397e2310fb183a676be8651b29082fe6f59cf20259a139f",
  "entries": {
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000024:dialogue:000": {
      "source_hash": "sha256:9dfc691860edf8a8605f6dd775421c419ea8d76f6ff1c3835869cc5db7bf0900",
      "text": "终于，明天就是正式拍摄了啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000035:dialogue:000": {
      "source_hash": "sha256:8911356727768373e13f2cdc7ec48bead4d747099357e84bbaa36fce34126c04",
      "text": "龙是在街头约会。英雄是在黄昏的海边\n求婚……是这样吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000041:dialogue:000": {
      "source_hash": "sha256:363529ceb800a0443f6ad4d45f5690fabb53d6d8c0dff85196974a84cd988876",
      "text": "是的！诚司先生是在商场里\n购物的情景对吧？",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000046:dialogue:000": {
      "source_hash": "sha256:3c6911f8feb1d5b0373c82669069343360155ade065b8348fdcc9491a20542c2",
      "text": "嗯，没错。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000048:dialogue:000": {
      "source_hash": "sha256:13a9fb33c506dd45fce228dc768a96c904532d65ad5da3610654a6b655453bbf",
      "text": "各位，状态调整得如何了？",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000060:dialogue:000": {
      "source_hash": "sha256:7e68ddf8b8f20b4247ac639dda2e490912203e9e0a545249867a69781e0f82de",
      "text": "完美！\n只要不出什么倒霉的意外的话……",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000069:dialogue:000": {
      "source_hash": "sha256:294131c7a0123c3019f505fbd3d9ecf41dd70db6ad4e4f2b46438ce0bd812fd9",
      "text": "诚司先生和英雄先生都表现得超有范儿。\n平时的拼命练习终于出成效了呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000076:dialogue:000": {
      "source_hash": "sha256:0d4a8268ca4fef1c694d8104365f0522c6aa107973259c0ba9d3dce8fb0adf96",
      "text": "一度还在担心会变成什么样，\n好在总算是像模像样了，真是太好了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000087:dialogue:000": {
      "source_hash": "sha256:c7076c4853b9593237d930e64b0e6390bf7b4c0aa3abce20ece4a11f612cfe23",
      "text": "好，明天一定要圆满成功。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_g:cmd-000096:dialogue:000": {
      "source_hash": "sha256:503e60e31e6c17f6b1764d7641fcd4e0a9debf34b973bcff35b97aa2e18b3b07",
      "text": "是啊。\n去吓那些拍摄人员一跳吧。",
      "status": "draft"
    }
  }
}
