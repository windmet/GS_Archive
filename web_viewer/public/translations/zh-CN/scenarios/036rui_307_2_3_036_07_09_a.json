{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "036rui_307_2_3_036_07_09_a",
  "source_raw_hash": "sha256:a7aa9ee1554bbfcf40da46198ed1eda5c5741dee9a723e3f629805d20549370c",
  "entries": {
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:0ee16f5e185dd32a8eb08286dc4c951e0d8d95094680a3c86e8067991332a6d1",
      "text": "Hi，制作人酱！刚才电视上播了牛奶博览会的\nCM，我忍不住就call你啦。",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:41907f066f5371ed9ae4708606f08549960fce756c639915fc57fe7dac4f917b",
      "text": "因为我正好在做焗菜。\n感觉这个timing太绝了☆",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:f35e8f00a09e384bf3df4a24cab6a3e6572845ff04ab97a38c787549c71069ad",
      "text": "是类先生在做吗？",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:28a51d91a6fdf3b521ad58d0213b696360ddc3d474ac03541222c20f6fb5d735",
      "text": "不是哦，是Mr. 山下在cooking呢。",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:49e12885e174120f0dbfb405a2cd6adf7f17c01636bb9c4e01fc379a17df70a8",
      "text": "我无论如何都忘不了刚出炉的味道，\n就向他request了。",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:4ba63a999c0b7c20c2c62d89332fcf261693f86ed02f3fda3bac750fa1a92127",
      "text": "我现在在Mr.的家里等出炉呢。\n呵呵，good smell哦☆",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:d46d04cb456d6492a8ec52a5628dd0962079b63a6df9bebac3f267b6e49c43a7",
      "text": "请务必让我听听感想",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:2757422697437a303cbfd6f0c198ab8d949cb7006a6be268bb74db8758ab7f3d",
      "text": "Of course！不过光闻着这个香味，\n我就觉得绝对不会让人失望呢！",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:f569c10762ac21171ade3b6da80db34f2671683d1af52ee3a616c2fb392f5e61",
      "text": "啊，好像差不多烤好了。",
      "status": "draft"
    },
    "story-text:v1:036rui_307_2_3_036_07_09_a:2_3_036_07_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:e4ee04173dee48f5f9300a3c0eb0c4edeeab6a6a5bfc387e90ec96f2a3f202ae",
      "text": "嗯～，so hungry☆\n拜拜啦，制作人酱！",
      "status": "draft"
    }
  }
}
