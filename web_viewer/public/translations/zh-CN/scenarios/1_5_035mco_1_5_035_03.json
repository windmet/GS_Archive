  "scenario_id": "1_5_035mco_1_5_035_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000010:title:001": {
      "source_hash": "sha256:128c7212fc772a90bd998e77d73060dfcc9c0e21cc8e90b2c18465aa8f48d59d",
      "text": "问答节目客串出演的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:10ed982b1509163b93d76a894c82b5df590c7b35d277190f3af2401aa9457149",
      "text": "辛苦了……话说，道夫先生！\n这、这一大堆书是怎么回事！？",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:0c8ca4f86f367cc722bac2088fc05a50acbc8dcd785d0c901b46342debd365fe",
      "text": "辛苦了，●●●●プロデューサー。\n为了准备问答节目做功课，我就拿了些书过来。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:0fc4fc95a004cf51505714df858df2d4d0bbea57d10d35ab206a9e1f1716ea04",
      "text": "毕竟对手是就读于高偏差值名校的、\n货真价实的现役学生啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:29f1061d3790936eda5125a44c91842e0b0146388c528a419763d8dadbe9aa2c",
      "text": "原来是为了这个在学习啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:338e625974af81414a89b05d91ca5205a2e3d46801a959b5639b6e055caaa855",
      "text": "嗯。我客串出演的，\n是现役学生与各领域人士对决的节目吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:a5eaa8ce45999e803c94660a0fceacb992860184df0321bd580f4cfb05cf92ca",
      "text": "自从得知对战对手是曾任高中教师的我之后，\n学生们似乎比平时更有干劲了。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8f247521712f2c0d495a5b170d6fe1be0e132a00c0be1c3431f0f862d635aaad",
      "text": "为了回应这份热情，\n在录制之前我们这边也必须做好充分的对策。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:2df92bc3dee605a16ffebbb9f58ecffb8685362f4cdd7d2be2b568c92965f33f",
      "text": "好的！如果有什么我能帮得上忙的，\n请随时告诉我！",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:1d3cdd80476f40e53602a40222485c40ccd6c1b18a9c7ecf78a20c45f153298b",
      "text": "一起加油吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_03:1_5_035_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:6636cd0a584c6bdeaf43d9a673e7ef326ac6d8a7c83ec9a6899d9a813b45be04",
      "text": "谢谢你，●●●●プロデューサー。\n到时我就不客气地向你求助了。",
      "status": "draft"
    }
  }
}
