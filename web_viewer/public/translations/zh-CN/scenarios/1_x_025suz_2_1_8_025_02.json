{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_025suz_2_1_8_025_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_025suz_2_1_8_025_02:1_8_025_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:bd03fb60ddc72306eba155293dd088a376044160244f16d2b9de7bb699ef22bb",
      "text": "赶上了吗……！在路边扶了个老爷爷，\n结果彻底弄迟了！",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_2_1_8_025_02:1_8_025_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ec98cf7f1990365fba394604e590e32b3660e1d36b496e8e00820908465e1502",
      "text": "●●●●プロデューサー，\n生日快乐！今天能碰上面太好啦！",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_2_1_8_025_02:1_8_025_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:e1a64cc989fca0db6e4bdd335929382fb8911001e6a1b99347fb447158d921e9",
      "text": "非常感谢！\n您是和玄武先生一起过来的呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_2_1_8_025_02:1_8_025_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8255e5e0b7412f5a1b458bc1f7780a13cae01a7d62cbe25d17888e9ecff012c0",
      "text": "噢！我和玄武一直都在商量着，\n要一起去给你道贺呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_025suz_2_1_8_025_02:1_8_025_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:0f51957ca6abb4a6bf74b557b0ba98036b4a0cd3900b8916d29cd967a5147462",
      "text": "哇噢，别闹腾啊喵子！嘿嘿，看来喵子也\n想给你庆祝，坐立不安呢！",
      "status": "draft"
    }
  }
}
