{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_011_02_a",
  "source_raw_hash": "sha256:b9ea31866296c68de99136395a6a7f631abbe371ab6b5ad60ba848f238aef804",
  "entries": {
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:56c6fd4f0c3071c5fbbfaa7d8efccd372539c9cff5ab747985a2a92130839c36",
      "text": "展翅高飞的小小挑战者们",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:5df0ef4b05b4291955f690608ca326132c1962e984c2787fe87f9b11728d12c3",
      "text": "直央下定决心，今天一定要向母亲坦白自己想辞去演艺界的工作。\n可就在这时，他却收到了来自事务所的偶像邀请。\n另一边，得知直央收到邀请的志狼下了一个决心。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000015:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000015:title:001": {
      "source_hash": "sha256:56c6fd4f0c3071c5fbbfaa7d8efccd372539c9cff5ab747985a2a92130839c36",
      "text": "展翅高飞的小小挑战者们",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000017:time_caption:000": {
      "source_hash": "sha256:4d65c8efddfbf0f9bbd504ba1c0f70629e362f8bf9a11d14242f989812c2346b",
      "text": "电视台·走廊",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:bfdc2079bb10615956a611cdd678e77bd4147fd740aa41d09292b93285854f0b",
      "text": "咦？妈妈在跟谁说话……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:c4542fdd0d8cc6e485bbf95265ed9d78e3a0c947c75c72cbb1a9abd5f466bf9e",
      "text": "是电视台的人吗。\n虽然是张没见过的面孔……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000062:dialogue:000": {
      "source_hash": "sha256:d3b04bdd5cfbb37d532b4227b53daa09e0e2e37839c1a4984ded48cb82946eaf",
      "text": "妈、妈妈。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:8e3a42b87d1f0dc273a43cc796aae9b9cbdb56d3db69c865c5f15cb9965d5fa4",
      "text": "哎呀，直央。来得正好！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:11e6cd6a8714baa80a2498d6dba88401bf89d53d918037c498987525dbaea1e5",
      "text": "这位是叫315 Production的\n偶像事务所的制作人哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000074:dialogue:000": {
      "source_hash": "sha256:9fec44ad352857941ef5758c98340b5ef7d3dd40fa383040a84829b6d99b2610",
      "text": "初、初次见面，我是冈村直央。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000077:dialogue:000": {
      "source_hash": "sha256:ef11f57815572788ca71f669fca464cc058c57d934710a5b1999604fe8326724",
      "text": "那个，制作人，\n为什么要跟我妈妈说话呢……？",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000079:dialogue:000": {
      "source_hash": "sha256:8a66ede9f4b4fce20baedd738a4631b67faa8983a93eb17d4a23973af28c85b1",
      "text": "这位制作人啊，说是来发掘直央当偶像的呢！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000083:dialogue:000": {
      "source_hash": "sha256:089457626c0c73bc0273c7531c0af5fbebaf1b4962fcaf2ce06f174e64a5ddbb",
      "text": "哎……\n我、我去当偶像！？",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000088:dialogue:000": {
      "source_hash": "sha256:9dd34b4dc0105e0f190e2ba917c207cde65dd60fe276b00621266927df7bc7cf",
      "text": "啊哈哈……是开玩笑……的吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000090:dialogue:000": {
      "source_hash": "sha256:a7b3fe56b5c2fa8cb860d80ab53e742e25affa247647ab93ffcdebfd30424814",
      "text": "是真的哦！\n妈妈都打算答应了呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000096:dialogue:000": {
      "source_hash": "sha256:6a3dfe18375bf7152ca46056e1606a98315ddeca707161fde515619d3bda6563",
      "text": "哎……哎哎！？",
      "status": "draft"
    }
  }
}
