{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_03_g",
  "source_raw_hash": "sha256:58e91dcdcec6ba4f758d31b67e7b46ff975d47d9b34a7bd0284319e4c5c42c0c",
  "entries": {
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000023:dialogue:000": {
      "source_hash": "sha256:fddc885accf06f5643e9984200cca281a221fa5c6fbdce93afd13b327d965179",
      "text": "别以为个子高，\n就能在那得意忘形啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000029:dialogue:000": {
      "source_hash": "sha256:839bbc0d85857bf209ef89a7a610cdb9bdc4322f82e8a07fd568d837c5eefdd7",
      "text": "等等，我都说了是误会吧。\n我刚才并不是在瞪你们……！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000032:dialogue:000": {
      "source_hash": "sha256:0797698ae39ccfa9bfe9cd1ff11f12580c4ca2d1442deca73b17f4555d0e4b42",
      "text": "啰里吧嗦烦死了！\n还没被揍够是吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000040:dialogue:000": {
      "source_hash": "sha256:119dea6104ce8da6032ed1813747e8e41cc2adc4ff8c9ee6f1e5d0511cab2748",
      "text": "（完全上头了，看来根本没法沟通）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000045:dialogue:000": {
      "source_hash": "sha256:1969e45a5d8509f5ae0c871c121ff1bd2419a67e2c9d9de654f3f6adab5a35fb",
      "text": "（就算抛开和高中生的体格差不谈，\n对方人数也太多了）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000052:dialogue:000": {
      "source_hash": "sha256:27eed7c58ebbb6c6028c81e10fd7be78b0c01bc2d77d6681c7718a3cce2585a5",
      "text": "（但是，绝不能坐以待毙！\n就算是误会，既然找上门来了我就奉陪到底！）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000060:dialogue:000": {
      "source_hash": "sha256:af5812165b2398276dbd829a57696363ac8f92d8138096f256936c5d2c61e673",
      "text": "你那是什么眼神？\n想打是吧混账，来啊正合我意！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000064:dialogue:000": {
      "source_hash": "sha256:8bf0294c2b0d14f8816a691276389c2f948d946f58fcd86237267e3e21e7c02c",
      "text": "给我等一——下！！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000073:dialogue:000": {
      "source_hash": "sha256:3eb2350ab2b7e9290a45052fc14dab2e2167705be9042bd4568b3e122bb86cef",
      "text": "啊！？在哪呢！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000076:dialogue:000": {
      "source_hash": "sha256:93c1e75f90592bb71b10b12d19a8a5b35406fde0f4a3879de08f3e594bcbaf3f",
      "text": "喂，在那边！在攀爬架上面！\n臭小子，给我滚下来！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000084:dialogue:000": {
      "source_hash": "sha256:8b235ae00aa5994498d2267660231d51f408cd69776b8042d26098bdf8a6e730",
      "text": "三个人围着揍一个，\n哪边是坏人一眼就能看出来吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_g:cmd-000087:dialogue:000": {
      "source_hash": "sha256:5b89240d283117171e91e7812fef1222cdd8e5a36248bdc6818df5fd899bcdbb",
      "text": "喂，那边那个。我来帮你！",
      "status": "draft"
    }
  }
}
