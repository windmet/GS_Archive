{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "039mcr_401_2_4_039_01_09_a",
  "source_raw_hash": "sha256:5e42e228e1d41a3fbd886cbdd897c7a358507bceab5f9acbb2059683c89e2fbf",
  "entries": {
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:4f314d6d92f789221a42998084c68a92a1733719edd694f7796a978ea90e2f77",
      "text": "●●●●●●●●●●师父！\n现在方便聊两句吗？",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:7edf5d233a4a792e4c8509e182f3afe9cce956a6d4164b92911c8ac8eac82a73",
      "text": "是的，没问题哦！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000011:phone_message:000": {
      "source_hash": "sha256:e4f45f8119810ca9fbdd7a6e82a5e08e338075a7faada0caed8ef45e8f122454",
      "text": "首先，师父。谢谢你帮我争取到了\n电视剧的工作！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:bcd21a8c2608d0524b911e74d08edc6ee44e03576232675c565f1e68bd0ac275",
      "text": "看了昨天播出的那部电视剧，\n忍不住想再次向师父道谢！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:0b85e660d11b8820a31cebad101c328044fd133234dbb88a9a2721c10367d665",
      "text": "作为一个观众我也看得很开心。\n能出演那样一部好剧，全多亏了师父！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:bb2c6849c8e737041759831ec8139bd02f95670a89351a7b7c1cad5a336cc1e4",
      "text": "这是道流先生努力的成果哦！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000018:choice_short:000": {
      "source_hash": "sha256:e57429a965dd559664e348b1f93944ab6a8889b7fb7a11d07224e0ef498cae12",
      "text": "我也想向您道谢呢！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:791da97fe32390f22297c9a3e9dfdbe3bf151b87cd36e3628f349ee4c4934370",
      "text": "哈哈。我就猜到师父会这么说。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:83d6ae38402e9f664b5d0b303726a294598f87c3e8e3b6ff507df0b3b7c6f5e8",
      "text": "但是，唯独这一点请听我说。正是因为有师父的\n支持，我才能不断努力下去啊。",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:fdeda80f98643b9e133edfa9b078343c5df64736fc27e09fb2ebad865d822af0",
      "text": "我才要谢谢师父呢！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:071946dbf6a351201aa0c1b34c1d393a5dc7e1396fc1cfc9bab8ac3ad80fc1ce",
      "text": "……这样下去，感觉我们要互相谢个没完没了啦！",
      "status": "draft"
    },
    "story-text:v1:039mcr_401_2_4_039_01_09_a:2_4_039_01_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:3f8dca4e60a2527d71870a737fe5b074abf0150ac7a7fc6e280c69dee29159ba",
      "text": "为了下次也能像这样互道谢意，\n偶像工作我也要继续全力以赴！先这样啦！",
      "status": "draft"
    }
  }
}
