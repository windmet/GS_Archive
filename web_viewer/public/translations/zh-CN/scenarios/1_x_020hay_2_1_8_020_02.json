{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_020hay_2_1_8_020_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_020hay_2_1_8_020_02:1_8_020_02:cmd-000012:dialogue:000": {
      "source_hash": "sha256:a310f5ce62a45506f4e9d2b1cbd1b40576258b2a0a78ab0424925fc8f58353ac",
      "text": "旬先生和夏来先生也到了，\n我们差不多该开始碰头会了吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_2_1_8_020_02:1_8_020_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:c4a7430f485acea6d8ef28fce486f90453d935c86ae2461d8f7635857791279c",
      "text": "稍等一下！\n在工作之前，能先让我传达这句话吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_2_1_8_020_02:1_8_020_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:1159e9952ba09cc11a13b850c7abfe64401f304b13be1baf8d48d2bc48e18aac",
      "text": "祝你生日快乐！\n今年这么晚才送上祝福，对不起啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_2_1_8_020_02:1_8_020_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:3a882eb72dcb487305f629d8f2c60a09cf1ca8f6c8813e77fbaa4d56eb0451bf",
      "text": "哪里的话。\n能收到您的祝福，我就已经很高兴了。",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_2_1_8_020_02:1_8_020_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:95dea8df6ff1bbba93797526b2cf0e8046b705ad6999020e477ec301ce77aef7",
      "text": "一直以来都在背后支撑着High×Joker，\n真的太感谢你了！",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_2_1_8_020_02:1_8_020_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:d275a87d2ff251ad97d45438f6c0fb2cfe11957320791f4b6f451c106ad6c67f",
      "text": "今后我也会超努力的！\n要好好看着我哦，●●●●プロデューサー！",
      "status": "draft"
    }
  }
}
