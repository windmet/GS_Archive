{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_008_23",
  "source_raw_hash": "sha256:896be0d685f1a0fe27c56e8effe3437c0994491930f444bab244d857897caf4a",
  "entries": {
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:a689de700b12c6516a04fa219396e876fbc66532f49745f482f769ddb51456f9",
      "text": "情人节的礼物，谢谢你。\n收到的巧克力，我会好好珍惜着吃的。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:f24530480b51acb8f6be371788791fa98813e2e5acfb9ea35371fb7d1c9b1538",
      "text": "不过话说回来，还真是不可思议呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:e101b6558406e9990a5f48b15341eedb9b7b6889983d42b2525de8c0bf125ad5",
      "text": "我原本并不是很喜欢情人节，\n但今年心中似乎不知不觉间产生了一丝期盼。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:52259407e9274aaefa035c76149b21a8941a7a2192680437a5f3e75f05431c98",
      "text": "是因为去年从阁下那里收到的巧克力\n改变了什么吗。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:fdb0e4a9af6c40f3ba47563eace68d1a91d24be4b3e569ca1033feedded7f76f",
      "text": "总而言之，大家享受情人节的那种心情，\n我现在感觉自己多少能够理解了。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000033:choice_short:000": {
      "source_hash": "sha256:8fc64a41ead8a5c429aa2190fedd3653f588683cc3c4848a7dc71d1454c40172",
      "text": "能听到你这么说我很高兴！",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000034:choice_short:000": {
      "source_hash": "sha256:91b263b28e2ff5891ec5a1054c7cf1f912923d4f4bdeaa78cf233d1164fa5504",
      "text": "能让你感到开心真是比什么都好！",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:5c4436bcc9a262df95dbfc1c3c7588411bf5f7d028b9746d2de0dbbb398c24f3",
      "text": "啊啊。\n我很期待品尝它。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:c2f667c4e89b764ce2cf78efa81a53c543646da277430a3e92fcd5c4c847fb8c",
      "text": "……差不多快到现场了呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:c85fc2d644c8c43700d1b8cfcae1dd6bdc4c001595b1c910889f3e5c7a53a324",
      "text": "阁下，再次感谢你在百忙之中\n为我准备了巧克力。",
      "status": "draft"
    },
    "story-text:v1:5_01_008_23:5_01_008_23_a:cmd-000054:dialogue:000": {
      "source_hash": "sha256:5111e2105f93637eeb661fddb93f3034a86a3b2c1206b856a87cd2f004704cad",
      "text": "为了能报答这份关照，\n我也一定会竭尽全力的。",
      "status": "draft"
    }
  }
}
