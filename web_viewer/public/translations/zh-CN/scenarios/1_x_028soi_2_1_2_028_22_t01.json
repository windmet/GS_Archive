{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_028soi_2_1_2_028_22_t01",
  "source_raw_hash": "sha256:4d0dfa93dcd89b489691521773f37132aa9b770487eb3badcf47981932b84f8b",
  "entries": {
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000006:phone_message:000": {
      "source_hash": "sha256:4ab7dc9f1b7d8329acb1b92e331b3f3cfc2bbc823e9bd2316c7b85cee19c8314",
      "text": "制作人，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000008:choice_short:000": {
      "source_hash": "sha256:1a997562bb6be69e93b68654e4b726559407ab3519b9b504052b289577d15af5",
      "text": "辛苦了，\n庄一郎先生！",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000011:phone_message:000": {
      "source_hash": "sha256:2628044b3a4f213dc1e73a16da8e9198948dddb0196b758b9d6549b5d0706702",
      "text": "今天非常感谢您。\n无论是派对还是蛋糕，我都感到很开心。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000013:phone_message:000": {
      "source_hash": "sha256:e80129c6b56724b54bc130a501a08fe06f22b319c83fa8fd7909e2b3d61e5362",
      "text": "听说制作人也参与了裱花练习，\n还帮忙调整了日程安排呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000015:phone_message:000": {
      "source_hash": "sha256:540ba41d9b79c76950c0bb7e22f4236c6dd202348da3730ccaaad3a2d08e83e5",
      "text": "感谢您在百忙之中，\n特意为我抽出宝贵的时间。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000017:choice_short:000": {
      "source_hash": "sha256:7b6f55abeabe958e0759062d988942849d959b518c5b99958ef0303cadd44bf5",
      "text": "我能一起为您庆祝\n也感到很开心",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000020:phone_message:000": {
      "source_hash": "sha256:3ccb09e835af3cfe0e63150afad5cc22fc4cab952d11164b062a7fa370ed56a1",
      "text": "多亏了您，\n让我度过了一个难忘的生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000022:phone_message:000": {
      "source_hash": "sha256:6749c2677d0478441b512e7237ab66288e1a99c79549c2eb0db2745733445058",
      "text": "等到了制作人生日的时候，\n我也一定会做一个令您难以忘怀的蛋糕。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_2_028_22_t01:1_2_028_22_t01:cmd-000024:phone_message:000": {
      "source_hash": "sha256:de67d26f43655f8884b95bb6d5ab5e8e634769a9e7be21c56e2a42ae03f4f2e2",
      "text": "敬请期待。\n那么，我们事务所再见吧。",
      "status": "draft"
    }
  }
}
