{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "023har_402_2_4_023_02_09_c",
  "source_raw_hash": "sha256:aadfaa899c13bb29865a3736416f6f01951263e0699d65ce69c5b19da383a116",
  "entries": {
    "story-text:v1:023har_402_2_4_023_02_09_c:2_4_023_02_09_c:cmd-000006:phone_message:000": {
      "source_hash": "sha256:cbe2e3320f7133d05a77ac42fb34d6aaaf17b21c5b4db7b3d00c1c8d773bc26c",
      "text": "喂？●●●●プロデューサー？\n我现在正和雨彦先生还有涟一起开会呢。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_c:2_4_023_02_09_c:cmd-000008:phone_message:000": {
      "source_hash": "sha256:ff9d7bdeeca05f7bce4d0cd6cee0bce74c5e337f51796d8cb7bff45142e041d7",
      "text": "我们一边为拍摄出谋划策，\n一边听占卜的事呢。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_c:2_4_023_02_09_c:cmd-000010:phone_message:000": {
      "source_hash": "sha256:9132216f4b64ef135c9ed23fb193fc37eafe7d930dfac975840e8ed43c682f1c",
      "text": "听说星座占卜的历史超级古老哦。\n我以前完全都不知道呢。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_c:2_4_023_02_09_c:cmd-000012:phone_message:000": {
      "source_hash": "sha256:292e4170f55a9fb4bbeeeb5ba76ba840e3f9d7802ee98f0aa995849bc63529b6",
      "text": "他还教了我怎么看星星，\n下次我也教教●●●●プロデューサー吧！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_c:2_4_023_02_09_c:cmd-000015:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_c:2_4_023_02_09_c:cmd-000018:phone_message:000": {
      "source_hash": "sha256:749adc5a4322a57e0adaa1a5925fd9edd55849cfaf99defcffffe2f85aca0490",
      "text": "好嘞！啊，差不多该回会议里去了。\n先挂啦！",
      "status": "draft"
    }
  }
}
