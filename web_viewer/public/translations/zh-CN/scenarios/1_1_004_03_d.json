  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_03_d",
  "source_raw_hash": "sha256:3bf446d55f40d76667707ee45a401d81d9c0b5d013098243151e938f373d4c18",
  "entries": {
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000024:dialogue:000": {
      "source_hash": "sha256:b853d59061239eeecbebdd025be826f79e539c30e2f6e625249ad50149aebdb2",
      "text": "呃……三、一、五、Production……？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000028:dialogue:000": {
      "source_hash": "sha256:f57c2104c33a28db529816bea7331b307291ad069943fb477d9aa08ff17b74e5",
      "text": "？三、草莓（いちご）、三……Production？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000033:dialogue:000": {
      "source_hash": "sha256:f320814e5e0e871e08fc86956d3fa967e44a185ac35e4a4bc5139cfb8c1b8d55",
      "text": "不对，大概不是这么念。实先生，这个怎么念……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000048:dialogue:000": {
      "source_hash": "sha256:e620ce2bbe16f25fb9dba906ef4f5bf202fe039f16701e306d7d3d8c9964b927",
      "text": "啊！这个要读作“Saikou”哦。\n315 Production。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000052:dialogue:000": {
      "source_hash": "sha256:5550ac5e1cc1e8f176d67bc601c35cd25b14626a1c9c644a235287df0236477d",
      "text": "315读作Saikou啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000069:dialogue:000": {
      "source_hash": "sha256:bffeb4d19fdae0133f31d6b1d4907ce6f489dec67f2b27a222ec79714ff87d5c",
      "text": "挺有意思的名字吧。\n大概是取“最高（Saikou）”的谐音吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000075:dialogue:000": {
      "source_hash": "sha256:32d6032fba643bd4087bb0d09aaaf51d57e974446f35d734fc6e149f83dd7aa0",
      "text": "谐音倒不如说是冷笑话吧？\n不过，确实挺有冲击力的……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000082:dialogue:000": {
      "source_hash": "sha256:0657649a6b9f94030eb437b21fa5d0b63578e0968c6b87d385ac6c6c081c8331",
      "text": "不过，“最高Production”吗。\n总感觉有种热血过头的气氛，我不一定吃得消……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000097:dialogue:000": {
      "source_hash": "sha256:9ffe4d6f1a7741ec312d11c068ba5a2ee7bd2e9d0c9ffa63143e56a038d3a5aa",
      "text": "Saikou……\n最棒的，Production……！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_d:cmd-000102:dialogue:000": {
      "source_hash": "sha256:10d3f254de8fb83d5dd2cbad3acc624da0853e8dfd31d701f77bd4c1e011a52f",
      "text": "实，恭二！\n我们要参加的试镜，就定这家吧！",
      "status": "draft"
    }
  }
}
