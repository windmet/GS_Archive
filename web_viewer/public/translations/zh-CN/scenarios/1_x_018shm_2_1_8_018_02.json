{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_018shm_2_1_8_018_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_018shm_2_1_8_018_02:1_8_018_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:f9d5dea446f93f3e9b2c02ed7eaf4e5f3fcfcb194b6745338c15780324cf3b3b",
      "text": "早上好，●●●●プロデューサー酱。\n我就猜这个时间你肯定在事务所。",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_2_1_8_018_02:1_8_018_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:a2d9929c62835aafd3e6e2bb59f3987a3c7a2ddeeea921f2fc14ad0111f4759c",
      "text": "生日快乐！\n今天一定要过得开开心心哦♪",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_2_1_8_018_02:1_8_018_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:f37a3c35984f8134ad6f39ad6e076f1c1427133475356e4ed7f5c09cc2f0aaf7",
      "text": "翔真先生，非常感谢您。\n我一定会让今天变得美妙充实的！",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_2_1_8_018_02:1_8_018_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2b70e53bfc8d95c0bc31bea84b228928a3df35431ca53f0b3aa7cadc62c74204",
      "text": "呵呵。至少今天稍微放松一下肩膀，\n也不会遭天谴的啦？",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_2_1_8_018_02:1_8_018_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:0aec7f17817e1b8db0dda84750f3c1a11598dca8f735ba7b127d850895eeb7ac",
      "text": "平时你都那么努力了。今天一定自然而然\n就会变成美好的一天的。",
      "status": "draft"
    }
  }
}
