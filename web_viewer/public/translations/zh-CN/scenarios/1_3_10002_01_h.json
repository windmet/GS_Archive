{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10002_01_h",
  "source_raw_hash": "sha256:336ababac562bd4e41dda46491265cd4b5bbe341b8e5e830d4e0ea45ab17b045",
  "entries": {
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000018:time_caption:000": {
      "source_hash": "sha256:8b2ae14eb5142058a1d20802a47baf9252887402991406a97941fc566f758137",
      "text": "《7 in LIVE！》播出开始",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000031:dialogue:000": {
      "source_hash": "sha256:6520ab183ae2344b04c1302b7e4a1d0d8aa903d5511409bc3125c7cda614a1e5",
      "text": "大家，早上好！我们是从今天起担任为期1个月\n主题曲演唱的组合FRAME。",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000046:dialogue:000": {
      "source_hash": "sha256:713e31f6924074e6474e79185413f05a6b7d857ab9ee16811bee95e6366488eb",
      "text": "首先由我开始……闪闪发光的小虎牙是魅力所在！\n我是握野英雄，请多关照！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000060:dialogue:000": {
      "source_hash": "sha256:d0184d1b06e09b37c13a51fa691b8cc6e71beefb933e0bb819a69413bb409fcb",
      "text": "论肌肉绝不输给任何人！\n我是信玄诚司，请多关照！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000076:dialogue:000": {
      "source_hash": "sha256:c99acc4618dcd6b9ce6e9eb4e22805459e5fd6a9d100f3f3e0120450f2d29a92",
      "text": "无论何种厄运都能用笑容击退！我是木村龙……\n咦、咦？麦克风好像出问题了！？",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000079:dialogue:000": {
      "source_hash": "sha256:fd71ee18d2786fec57998ad9054abe9dec727ae0a1a53654331ae4b0631d74cb",
      "text": "（龙，用我的麦克风！）",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000086:dialogue:000": {
      "source_hash": "sha256:ac66fc904943cdbc75ed71ca97f6756f69f1146650d791ca9ffe21cbcc669fbe",
      "text": "非常感谢！\n重新来过……各位，请多关照！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000105:time_caption:000": {
      "source_hash": "sha256:c981d373a457764d2958e4f95469d565418423884ba4fa857db2ad10faa3b07b",
      "text": "广告中……",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000113:dialogue:000": {
      "source_hash": "sha256:66c7bda2e113008c4b9837d300f72c4d7595a27251b07cb6ee7a1214c0092993",
      "text": "呜呜，一开场麦克风就坏掉了……\n彩排的时候明明还好好的～！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000119:dialogue:000": {
      "source_hash": "sha256:51fcbb81222931e1e788141e0ca0b57f5a4bfed4eda258b44b057380a01f4e9f",
      "text": "没事的，龙。\n救场的事情就交给我们吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000125:dialogue:000": {
      "source_hash": "sha256:daf5b8cb210363d85105cd32918d0649d85a682dd1549128885a87cb575065fa",
      "text": "英雄先生、诚司先生～……！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000131:dialogue:000": {
      "source_hash": "sha256:2edf43cd9001b55bb3f31c821f2636e6d2edd4e48560199f7b90704628440493",
      "text": "各位，刚才的团队配合非常棒哦！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000133:dialogue:000": {
      "source_hash": "sha256:9a94523ea9d102e41be37fa1df2bb1475baef20c0fcf944a73a9cafbf91b4092",
      "text": "马上就要进入新闻资讯环节了。\n诚司先生，接下来就拜托你做好准备了！",
      "status": "draft"
    },
    "story-text:v1:1_3_10002_01:1_3_10002_01_h:cmd-000137:dialogue:000": {
      "source_hash": "sha256:36715a0db82dfed3cebfb77240a999689b9a75e47453710dab9c549718e0684c",
      "text": "啊啊！",
      "status": "draft"
    }
  }
}
