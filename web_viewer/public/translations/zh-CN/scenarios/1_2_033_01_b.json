{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_033_01_b",
  "source_raw_hash": "sha256:d01a89d9e11a63ff01ca2d78fdbe367e9c635b17f385bc031b128de6db15c9ec",
  "entries": {
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:87edb4e4877e1580fba7667a8a2b16869969f3830da00d13bf9bd853f5f33b78",
      "text": "作业必须要写才行哦。要是被留校的话，\n练习的时间也会变少呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000020:dialogue:000": {
      "source_hash": "sha256:8bc537d182c581b2e757ea4cfc48b3413682a590a67bfbacacd7e7d2c4e9dedf",
      "text": "诶——！？算术这种东西不写\n又不会死，有什么大不了的嘛！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:1d589541724a3b913e8162589f7904a8207dcbe956481c8293e756d724fd63e1",
      "text": "……志狼君，\n可以让我看看你的作业吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:61eba08f5d913028ea348945e4d9cc77797a86b06601a788ae5172f2260afda3",
      "text": "等等哦！\n……诺，这个。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:1c0806b4e0020038831a7e35e1f65898e0c8c3775b82c5bc992d64a099727350",
      "text": "……原来如此，是稍微有点复杂的分数计算呢。\n这道题确实可能会觉得很难。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000040:dialogue:000": {
      "source_hash": "sha256:aee61b022a418fcf18f44b3d692f1f6953f146b7c21f5417ff54fc07ddfa0306",
      "text": "对吧——？这种题根本不可能啦！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:584705368abf955678d5ac52d63c5269b4e9fd75c8f8e437ec5214d5b9d516c0",
      "text": "但是，能解开这么难的题目，\n会超级帅气的哦！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:0c49ceed34a9b6c3fa74cc1adb40a7de9fbf1f23a948600c9d109486ceb2bcc5",
      "text": "……帅气？",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000064:dialogue:000": {
      "source_hash": "sha256:9338c049ab4d323a332d5b8f9945857db9b605cfe023fdfb4747de4a52691827",
      "text": "是的，非常帅气哦！\n克服不擅长的事物是迈向大人的第一步。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000069:dialogue:000": {
      "source_hash": "sha256:03f2035d3f78bbe807cbe05c9fbc3b7e728e63382dd7506849b15b183cc8d1fa",
      "text": "要是有难懂的地方，我也会帮你的。\n首先来试试看吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_b:cmd-000077:dialogue:000": {
      "source_hash": "sha256:9ab3139c9d3544cb4c5c56e2cecfa5c7294cd2a1811a8405dd01df6f18a33711",
      "text": "真、真拿你没办法——\n既然你都说到这份上了，那我就做做看吧！",
      "status": "draft"
    }
  }
}
