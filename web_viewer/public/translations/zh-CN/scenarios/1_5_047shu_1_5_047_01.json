  "entries": {
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000010:title:001": {
      "source_hash": "sha256:a07887e515b9a35465a22046886f994064e4d5d38abfbb648fa98a29ca7dbe3c",
      "text": "苏打水广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:dce3977af193b4380c0ceafc92bb0855f4e43f79b9eb405d9d409ad33a171115",
      "text": "呐，●●●●プロデューサー，\n这瓶苏打水我能喝吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:40c1f4c8ebc5e0455ec66ae93bf9540822d9a6d83dc1ae3b5cf964e16c126d68",
      "text": "我倒是不介意……",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:b3987ac23007cb176845e5e59fb271fb671687a95d62ab10c3b7d4896d07d88e",
      "text": "等会儿拍摄时也是要喝的，\n肚子不会撑到吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:deffb5fb8e07c5854b3e44e46c058341561afe4b7079f00fe75501a08aba2944",
      "text": "没关系，我一条就能过。\n……呼。这款苏打水，喝起来真顺口啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:e228b67387ba72d14f9cb42e75f6f994fc50b6beb5b7a0d83275338b3e505a6b",
      "text": "写歌的时候，\n我也喝过拿到的样品……",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:f3bcfe9397d85d1df9a47b3845fe25a829b50d7899315fc21f45becd831370a6",
      "text": "又顺口又好喝，再加上由我来\n出演广告，绝对会大卖特卖的吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:648e5045c7e7e04f750cd1c663b3dc6e01a3e1fd742d7ee8a30b71e291581455",
      "text": "是啊，肯定能大卖特卖的！\n秀先生，我很期待您的表现哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000054:time_caption:000": {
      "source_hash": "sha256:f9aecbc1aa9d75278e30c5a1849ad2c5980c5badf5d1ef5900cb7292ab227219",
      "text": "拍摄开始",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000066:dialogue:000": {
      "source_hash": "sha256:78640d700d248ede971448f6a1919c4918062f34f387551f75d2c649472c7ba0",
      "text": "“呼啊……嗯，早上好。\n啊，帮我备好了苏打水啊。谢啦”",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000081:dialogue:000": {
      "source_hash": "sha256:25e2b4e7984a9f19a492c1bd120dcf06d5b4507dfa8540c9ef85c5601fb315c5",
      "text": "“……嗯，好喝。喝了这个整个人都清爽了。\n早晨果然还是得喝苏打水呢”",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_01:1_5_047_01:cmd-000085:dialogue:000": {
      "source_hash": "sha256:487a22430ddfb0d5377cb3d49f4f30bbaa5c256be4883963ecdfaae8a6c5ec3f",
      "text": "（秀先生的演技大受导演和工作人员好评！\n正如宣言的那样，一条就OK通过了！）",
      "status": "draft"
    }
  }
}
