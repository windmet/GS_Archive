{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_010_23_5_00_010_23",
  "source_raw_hash": "sha256:afd60d4cd4af5fc4d7c616d96cb4d974448821ba5cb6eb78d9796380681d75fa",
  "entries": {
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000000:title:000": {
      "source_hash": "sha256:264558b2c07290c70bbc517e4fe78038cb670dfe2848e1760677eb817f17ce06",
      "text": "新年特别下午茶",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000041:dialogue:000": {
      "source_hash": "sha256:4c017671e183e951de306cfe1881f1eaff9af33dbfa192adef8e55d6ec4e1223",
      "text": "制作人。\n新年快乐。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000053:dialogue:000": {
      "source_hash": "sha256:c347d560f79f98b43ae3f2907a72b1222f3083dbc223b3d951a57bb298e09a7a",
      "text": "今天欢迎来到Cafe Parade的新年特别下午茶会。\n请务必好好享受一番。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000060:dialogue:000": {
      "source_hash": "sha256:d7fcac4117b6c5be0eb6f0b30990d156ff0e08dfff49c383bad108421a015822",
      "text": "感谢您的邀请。\n每一道看起来都非常美味呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000085:dialogue:000": {
      "source_hash": "sha256:3063898940cba02d761db8f641c7bb3f6d272f6e747ffecb0902189f49aa8e71",
      "text": "诶嘿嘿，谢谢～！\n装在多层漆盒里，超绝可爱吧♪",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000093:dialogue:000": {
      "source_hash": "sha256:af1681e05152597ace018b3b57a035eae990b35bd3467f3c45b218e8923fdc17",
      "text": "阿斯兰先生和庄一郎先生，\n可是拿出了看家本领呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000115:dialogue:000": {
      "source_hash": "sha256:3022fc80025866aca991fd8d729d5d629276742f45ae0bb1bc151bcd6e1991d5",
      "text": "吾等已精炼出足以配得上全新舞台揭幕的至高贡品。\n给吾好生细细品味吧！",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000121:dialogue:000": {
      "source_hash": "sha256:ce8adfd57a8c6cd3454ecb55d8d1fde6a0a8244afe8c94121776a56dd06db831",
      "text": "我们以年节料理为灵感，准备了仿照伊达卷的\n蛋糕卷，以及红白相间的果冻。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000127:dialogue:000": {
      "source_hash": "sha256:18358e75fecf374e6fabc4ed31c83a75b7f7531d6b05680f8f284da0476dce70",
      "text": "请务必品尝一下。",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000164:dialogue:000": {
      "source_hash": "sha256:0e30baeeb89c2b5826db2757a2a7cd81bcef3c23911a78aeb15c3957ebf87180",
      "text": "再次祝愿，制作人、大家，\n今年也请多关照。那么……我开动了！",
      "status": "draft"
    },
    "story-text:v1:5_00_010_23_5_00_010_23:5_00_010_23:cmd-000178:dialogue:000": {
      "source_hash": "sha256:4dd20a48e5a4b2edf42f2483207d8cb4fe8706e14bea9ff460b759f26684bbca",
      "text": "我开动了。",
      "status": "draft"
    }
  }
}
