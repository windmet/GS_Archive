{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10018_01_h",
  "source_raw_hash": "sha256:549761e1162bb51a83002b48d5f36dd131df806ec9cd64fa51a0ca0fbaf72fc2",
  "entries": {
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000022:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "几天后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000034:dialogue:000": {
      "source_hash": "sha256:292dc9f92c7443ea14ee798a11be17d26704be62fb0bad3ffde2b53004a69fd2",
      "text": "涟亲，这边这边！制作人酱\n交代的问卷，大家一起来写吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000050:dialogue:000": {
      "source_hash": "sha256:840ea6763c2e5219b86da7d4054ee8c8875ad1b734e690e4e99034429b04e782",
      "text": "吵死人了，四眼仔！",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000071:dialogue:000": {
      "source_hash": "sha256:5081620c413dc3af84c930f4445aa211606397e4c6c19ab167fbb3179652697e",
      "text": "啊——！涟亲，既然要去练习室的话，\n要不要一起过去？",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000075:dialogue:000": {
      "source_hash": "sha256:28d3ef1af0385eed63729f8e1d0abc923e5289ce53a5a8f046c40247f0e6efaa",
      "text": "烦人……",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000084:dialogue:000": {
      "source_hash": "sha256:9c9c7bfd1dc61ac55561a95dad5f1276be8041f078bb0e169b0e5e9c62b01a3e",
      "text": "啊，涟亲，等等我啊！\n我也一起去！",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000116:dialogue:000": {
      "source_hash": "sha256:9bd4c56d6b0446b247a8afa9d7ed182197ed5c8c919464359d31cf0a3c442b41",
      "text": "呜～涟亲的舞跳得简直太Mega最棒了！",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000123:dialogue:000": {
      "source_hash": "sha256:8c3966ceb9d82c598da6539df77dd2fd540d88a42f9a085cbaad96578cd7e66f",
      "text": "哼，能做到这种程度是理所当然的。",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000141:dialogue:000": {
      "source_hash": "sha256:5bebb356de5f44d33c8f62b2fd461ca0f3be2ce82215d48b602eadbc363b58eb",
      "text": "是啊，真是精彩的步伐！\n比以前还要更加熟练了呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000151:dialogue:000": {
      "source_hash": "sha256:d3f7aba8a17cd882c85e95c023aff1adcdb0e2f89dbb91bd9b0a36ce4ae52df3",
      "text": "那、那个，涟君！\n可以教我跳舞吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000158:dialogue:000": {
      "source_hash": "sha256:98158ee28ff03db3b001abc10797203ff3d2a60d6af5d3a40b4ede5936708087",
      "text": "哈啊？本大爷凭什么\n要做那种事啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10018_01:1_3_10018_01_h:cmd-000169:dialogue:000": {
      "source_hash": "sha256:225693c01be2ba438a02876be5e87003d1fb300c1dc0cbc14a433b118b0f4097",
      "text": "我、我想让舞跳得那么好的涟君帮我看看。\n拜托了……！",
      "status": "draft"
    }
  }
}
