{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10003_01_f",
  "source_raw_hash": "sha256:691d1dc0fe4d2c42ec6e91e24121a70c6d5bdd32dc47969ecd2151e578a9f389",
  "entries": {
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000018:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "数日后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000031:dialogue:000": {
      "source_hash": "sha256:c7afe54921eef6c482d3ec8b5eaae6180556ac640a47e20e097ac3a0eb59e782",
      "text": "训练超级圆满地结束啦，辛苦了！\n刚才好帅气哦，卷卷☆",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000038:dialogue:000": {
      "source_hash": "sha256:d20b74e233c62eb79dca328a75d77aae1141552af660851244b81ce9770cb333",
      "text": "啊哈哈，谢谢。\n咲酱也是状态越来越好了呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000045:dialogue:000": {
      "source_hash": "sha256:ae838f7343b5783f2ff61269729ff9021cca93b4cab55fc7c078b2d7132b4a6a",
      "text": "特别是最后那一幕……啊！\n说起来台本……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000050:dialogue:000": {
      "source_hash": "sha256:afd81567d5d52fb9f06c05f48ee6881ff56a6094f4656d39e8ebe58863c638d0",
      "text": "怎么了吗，卷卷？",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000060:dialogue:000": {
      "source_hash": "sha256:a203022138327b83e91a1161fe1efdbd7e9903e5b50bf62ba67592ab77ef2599",
      "text": "果然不在。台本好像落在练习室了。\n我回去拿一下。咲酱你先回去吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000067:dialogue:000": {
      "source_hash": "sha256:f68840556a312a2046f36841297e79965908fb26f7ae182d349458f3da79e11e",
      "text": "嗯，知道了！明天见咯！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000084:time_caption:000": {
      "source_hash": "sha256:90a6d9f8ac93d41ae46200f74e5fa66c8b2d2bdf74ae48965c0c9a843d109700",
      "text": "休息区",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000092:dialogue:000": {
      "source_hash": "sha256:b656f5613feb8766b032f45540308be5539de9eda8728f208086effe3f4d8583",
      "text": "那个，刚才用的练习室是……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000097:dialogue:000": {
      "source_hash": "sha256:35592de3c49ddd852beab1f75388dbc00f9160610cee0aa8a2e7bc637cc56799",
      "text": "咦，灯还亮着？\n有人在里面吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000114:dialogue:000": {
      "source_hash": "sha256:cf97a67f098c83d333df5c6e5ecbf9d6cbb021d0494145301268911b54515242",
      "text": "“对吾而言，乃不可或缺之物”",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000120:dialogue:000": {
      "source_hash": "sha256:6eb8c06492210dce6bb5cb28d546c5b1193663c40c988c2de551886920771508",
      "text": "唔……仅凭现在的程度，还不足以动摇灵魂……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000126:dialogue:000": {
      "source_hash": "sha256:a5ff118fafa576151ca6836d6b116762bcd5fdc1b31d08a2f07a819e15aeaa4e",
      "text": "……撒旦你也这样认为吗。\n既然如此，稍作歇息后，便再次演绎一番吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_f:cmd-000133:dialogue:000": {
      "source_hash": "sha256:a9083a05f323e037f5aadb2e86433a53d8cc2ce24c89f5c7c5b52d10d314c8ab",
      "text": "阿斯兰先生……？",
      "status": "draft"
    }
  }
}
