{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_006_04_c",
  "source_raw_hash": "sha256:0454a1a956f016996da3bb6648df3118b04301b0467fb30c7fece5e0ece4ab5b",
  "entries": {
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000027:dialogue:000": {
      "source_hash": "sha256:56285b00a18c1d2d2163cb0e49d50a30a530e2d4cce2c7f77ebba6f6dfe2b428",
      "text": "可以吗？\n地点和做饭都全包给你了……",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000034:dialogue:000": {
      "source_hash": "sha256:e93177f86fe94a7d4dc4caa95cbd9735c0bbc6ac170ca07e01bcebaf11669f0c",
      "text": "嗯，当然可以。不用客气。\n我平时也经常自己做饭。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000039:dialogue:000": {
      "source_hash": "sha256:01722f54ab434d67b354aabbab86a452276bf1ac35758e2249e316fb715f3a8d",
      "text": "而且，我也想不用顾虑时间，\n和大家坐下来慢慢聊。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000045:dialogue:000": {
      "source_hash": "sha256:39399a767ddb6b6baa22343c32877a7d7500b3f2efdba2446e36778b897520cb",
      "text": "那务必打扰了！\n好期待诚司先生做的料理啊～。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000060:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "几天后……",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000072:dialogue:000": {
      "source_hash": "sha256:92a8c4638dba8c813ad9d03a80d014060a8995c226da83669b6cf1228cac35b8",
      "text": "味道……嗯，做得不错。\n再稍微焖一会儿吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000089:dialogue:000": {
      "source_hash": "sha256:b9a81b41a8fe6e8cde003608271b7962314d3d30e7bd6a34f1e22ace6e5c9e02",
      "text": "好香啊～。\n天音也想快点吃！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000097:dialogue:000": {
      "source_hash": "sha256:381d66c19358059c7da3d5eb13316e2e48f0cd7e3d3f50774aad46a81ef64549",
      "text": "等客人来了再吃。……好啦。\n还想再做一道菜……肉还有剩。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000107:dialogue:000": {
      "source_hash": "sha256:5137db0d5943f44d960f3158d3fd6ce3dfc8a52b701f596c377a384cbdc69352",
      "text": "你们好！我是龙。\n英雄先生也一起来了！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000111:dialogue:000": {
      "source_hash": "sha256:1c3a8d561a194f38f7be2d0258a856521027a31531cfb3a9046b48183d954281",
      "text": "抱歉天音，舅舅现在有点腾不开手，\n能替我去开个门吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000114:dialogue:000": {
      "source_hash": "sha256:3ac5833e3cdc3d7f955615613a985e95e8892e2b8b39873204e9d05b8d81480b",
      "text": "好～的。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000127:dialogue:000": {
      "source_hash": "sha256:8286f80855548deb23d7909d076f4532cca8db8a42e2d27d12cfbcdef83daa8b",
      "text": "欢迎光临！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000150:dialogue:000": {
      "source_hash": "sha256:ee85c8311a4feb1ab87f1df707db9c2aed08c74d182fd01f09fc08d7b3d3b826",
      "text": "嗯！？",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_c:cmd-000154:dialogue:000": {
      "source_hash": "sha256:dd814d1c96c43fbd50257d99bb8ab51c1de7a73d4fdf223615b88b479b05bdfd",
      "text": "啊……你好……？",
      "status": "draft"
    }
  }
}
