{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_039mcr_1_7_039_01",
  "source_raw_hash": "sha256:c98e7e1c819f10c69450e491000768ba9f3e6dfbe2c05476918c17563c14dadb",
  "entries": {
    "story-text:v1:1_x_039mcr_1_7_039_01:1_7_039_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:e08160d678d14682e6ec48e1a4a8be52a70f68eee9b8dd0585440b129fed8f58",
      "text": "●●●●●●●●●●师父，\n听说您在找我，我就过来了。",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_7_039_01:1_7_039_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:43f22e1d85a3ee60d6d335168a751243b665418ec531d9e4e37f63d77d8d58af",
      "text": "道流先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_7_039_01:1_7_039_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:3cfb4eca3aa5de02e2c7bfc54c00be2e9728a7e2cb9eb0f0b1c89b7615e50333",
      "text": "非常感谢，\n●●●●●●●●●●师父！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_7_039_01:1_7_039_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:440fd6e42bc2f7cd2680db2b0ab501af2735bd360c1a5549a94d72a49f5d844c",
      "text": "没想到您特意找我就是为了给我庆祝，\n太感动了！！偶像工作也更有干劲了！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_1_7_039_01:1_7_039_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:ec0d5d108a6ea0deb58aec2c0ead9969c9c0ab2ef2b0f582dc1e8a5840bd0df5",
      "text": "今后为了站上偶像的顶峰我也会继续努力的，\n请多多关照！",
      "status": "draft"
    }
  }
}
