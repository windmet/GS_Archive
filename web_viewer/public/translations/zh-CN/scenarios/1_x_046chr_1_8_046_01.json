  "scenario_id": "1_x_046chr_1_8_046_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_046chr_1_8_046_01:1_8_046_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:3933bf667452f1c18c6eec1362acf1cdd9714143b5c74fbd73f740f7aed6b342",
      "text": "●●●●プロデューサー，\n祝您\n生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_8_046_01:1_8_046_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:d334bb3fa8f70091098e8ce7ff59bc626ff7a09a99f94505a48f35636bf47123",
      "text": "如同依偎在水母旁的\n黄带鲳鲹幼鱼一般",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_8_046_01:1_8_046_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:e0603ebe7c707ca78006a45f676f88a8b93b8b1f96d319ae72564c11ad7811a6",
      "text": "今后也让我们一同\n畅游在名为偶像的\n这片辽阔大海中吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_8_046_01:1_8_046_01:cmd-000015:choice_short:000": {
      "source_hash": "sha256:795f1b41df27186eecf952a1a95a9103d7b26cf982c27686ee44df3a16db4d11",
      "text": "一起加油吧",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_8_046_01:1_8_046_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:bb01411c99f0c2a606e9a7b153c527037c9203786421026c56775a940810f52d",
      "text": "好的，请多关照。",
      "status": "draft"
    }
  }
}
