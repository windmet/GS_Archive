{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_001tom_1_7_001_01",
  "source_raw_hash": "sha256:dc8509e931b0758b8cad470bb1dc875021d2dbd3ae31bdabdf7f7d496ff5651e",
  "entries": {
    "story-text:v1:1_x_001tom_1_7_001_01:1_7_001_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:ac6b1a42a1218180debd5fbfaf55a1b9aece622e077357378832226896dca50a",
      "text": "冬马先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_7_001_01:1_7_001_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:c1f1f57fbe02be0ce4db72e8056ea2fe66fab86a26152579a24fbea10f788778",
      "text": "生日啊……你还特意记着呢。\n●●●●プロデューサー还真是一丝不苟啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_7_001_01:1_7_001_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:467b657db6ec07dafedf1ff3eb4096bacf0437ff04369a1573ab81049b284884",
      "text": "我又不是不高兴。\n你能祝我生日快乐，那个……谢啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_7_001_01:1_7_001_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:65f17caf78b7448201ca8cbd960ab7d28ef53e64754600ada3a8c5c98d9ae304",
      "text": "啊——……总、总之！\n就算是生日，要做的事也不会变。",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_7_001_01:1_7_001_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:9af336b1206ebd98fd107166625fb0e2def442fb27807db164c146d41fcc4a65",
      "text": "我们的目标可是顶尖偶像啊。\n好啦，赶紧去练习吧！",
      "status": "draft"
    }
  }
}
