  "entries": {
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000010:title:001": {
      "source_hash": "sha256:1a9940e9032f8a273bdfd4861b0545acb1dfff51293468c699c579a9595f1d72",
      "text": "工作服厂商广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000015:dialogue:000": {
      "source_hash": "sha256:5f8b9119148ef7810679d515a842b664518fb7a4ee6f9023584576063db99c95",
      "text": "今天是工作服厂商的广告拍摄。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:c5aba41b613ad8ebe80239f543ef21173d6815118d3d1d6abd0a37670cf84ae5",
      "text": "因为一直调整到最后一刻，今天还是\n第一次穿上这身衣服，穿着感如何？",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:6c89ea0e0347f3c0d421cfd7964d8d1637716d360569ee7f1db739faa99cfd62",
      "text": "面料轻便，便于活动。\n透气性很好，最重要的是结实耐穿。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:bbad73d8742ecb10c4b86d27ae058049bf9de85ec7aa66dae350ead722f4826b",
      "text": "确实是件相当不错的工作服啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000030:dialogue:000": {
      "source_hash": "sha256:1d99a8a1ba8f9837865a8389ae451481253e4059c4cc5155a97336472cef9b91",
      "text": "我以前做清扫工的时候\n也经常穿工作服……",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:b611d0afec10c688c9e81a1e6e1b3df7f3666c5ad264a757f6e69bdb1fa13c36",
      "text": "要是那时候有这件工作服，\n说不定会一直爱用呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:e322cf21c500053c1a850e3d44468f79576fe75f2febdd481facad1a7807f4c8",
      "text": "呵呵，我会转告对方\n雨彦先生对它赞不绝口的。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000043:dialogue:000": {
      "source_hash": "sha256:327c4b1423c52888fbfac7fdd3c543a09efffb36d2ccf2507e91cbe0221676c7",
      "text": "嗯。\n……好了，拍摄差不多要开始了。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000046:dialogue:000": {
      "source_hash": "sha256:59b4ea4e3bdfbcd10e5e5e62fa4881314e8067b0b2535e2b7ab487921e6d95c2",
      "text": "我这就去了，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_03:1_5_044_03:cmd-000048:dialogue:000": {
      "source_hash": "sha256:24436d104bffb9225fea343fd835315709fc8801aa355dc1b61ef6af23aa2680",
      "text": "好的，路上顺风！",
      "status": "draft"
    }
  }
}
