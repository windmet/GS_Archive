  "entries": {
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000011:title:001": {
      "source_hash": "sha256:a66a2deb4ff432a3d0bdfe0b3dc6d5fb8e71444ed50b362914036b1d45674c7a",
      "text": "眼镜品牌CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:7a8f6d46e4c184b425b2229a0c00f700fac981b2ab44c1b1629aeb955b817405",
      "text": "“哇！完全感觉不到戴了眼镜！\n而且连很远的地方都能看得很清楚哦”",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:3d37829cfa45e423fc8f86993dc2153d4493b64a907b645e23302234c5466fe4",
      "text": "“妈妈，谢谢你送我这么好的礼物。\n我会好好珍惜的♪”",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000034:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:7488800f2194b46fd2c258fd466c4e977eb82bd7acf092737d06df18eab70b8d",
      "text": "辛苦了，直央君。\n居然一条就过了，真不愧是你。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000042:dialogue:000": {
      "source_hash": "sha256:d63b5ac29a10becda26463a8decfe9191543d601a219425ad426b7b7cb6c6462",
      "text": "谢谢、谢谢夸奖。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000045:dialogue:000": {
      "source_hash": "sha256:6395a10572f75c75710b66c6d45d2a2f7b0bbca4e89a8dcf583b4b38a3b0fce8",
      "text": "实际拍下来感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:9feccb2b389cd45920f5b67e472e70b5b7f93dfed7a6e4e8537a808ad6442403",
      "text": "虽然有一点点紧张，但工作人员们\n都非常亲切，让我能安心地投入拍摄。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000054:dialogue:000": {
      "source_hash": "sha256:5aee1a5be7c551584224ea316435bfc84e892199fcac14faf77a939bbfd3352d",
      "text": "而且这款眼镜，\n很轻巧，戴起来真的很舒服呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000057:dialogue:000": {
      "source_hash": "sha256:2464c68ec1ef21198357bac2a88c7775322279a7f220c6387bd55aa9afc1e815",
      "text": "感觉平时不习惯戴眼镜的孩子\n也能轻松戴上呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000060:dialogue:000": {
      "source_hash": "sha256:4a8ce603950d7658461b38a967434571b1a9e41bc1c90e16de599905e8ddae5a",
      "text": "款式也很丰富呢。\n挑选的过程应该也很有乐趣吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_04:1_5_032_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:1cd5d0cca416be0957a85a7406077955f18efb989c1a6348c535952151e783dd",
      "text": "呵呵，是的呢。要是能通过我的CM\n把眼镜的优点传达给大家就好了。",
      "status": "draft"
    }
  }
}
