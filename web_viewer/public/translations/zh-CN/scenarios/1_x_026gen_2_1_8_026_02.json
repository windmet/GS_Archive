{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_026gen_2_1_8_026_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_026gen_2_1_8_026_02:1_8_026_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b4c1c31d0016255b799f3ec8d36cf1459fe85d7f2bd366c7440833af7f003be7",
      "text": "太好了，幸好你还在事务所。\n我和朱雀早就说好，今天一定要向你祝贺。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_2_1_8_026_02:1_8_026_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:a91837173a479de297475dc2c4ae32a6a2c5f6993ed5a6cf3d44d32d0e589f80",
      "text": "●●●●●●●●●●番长，\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_2_1_8_026_02:1_8_026_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_2_1_8_026_02:1_8_026_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:0c50ff76dd1fa000b669b835072b52ebf0cf754cf2ff6124beba9a2e9676f593",
      "text": "我对胸怀壮志的番长今后也充满期待。\n当然，我们也会一如既往全力以赴。",
      "status": "draft"
    },
    "story-text:v1:1_x_026gen_2_1_8_026_02:1_8_026_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:9db8c1b7acd6fbf4b49f976bdae302ea115165118918ad4cae88dae93fae2e08",
      "text": "戮力同心，一起登顶偶像巅峰吧。",
      "status": "draft"
    }
  }
}
