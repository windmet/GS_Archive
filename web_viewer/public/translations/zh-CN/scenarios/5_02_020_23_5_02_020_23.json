{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_020_23_5_02_020_23",
  "source_raw_hash": "sha256:bb970ebcda42149aff45f096b5f041900cedd82f1baf4f93328b39a334f7f631",
  "entries": {
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:277d97395aafa173b215b287c0c7e593de4f292ddfb287841c025ece30985ce5",
      "text": "●●●●プロデューサー，这边这边！\n抱歉啊，突然把你叫出来。",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000022:dialogue:000": {
      "source_hash": "sha256:68a53f6eb2f23d228eeedd2b21f45bfa37bdb26e2f98c62d12ca494a3b716800",
      "text": "我是想亲手把白色情人节的回礼交给你啦。\n来，给！",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000026:dialogue:000": {
      "source_hash": "sha256:d428c8d22645a594d5f8e67935d27dc088b217259d819d0d6973d10aa87362f8",
      "text": "非常感谢！\n这是……扩音喇叭吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000030:dialogue:000": {
      "source_hash": "sha256:7c3748d57a2e4a4c7deeb2e962006ab549ba74d25e45d98c9f05969924c47918",
      "text": "对呀。\n这个是我支持的棒球队的应援周边哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000034:dialogue:000": {
      "source_hash": "sha256:2f1c3f9c19cba3ec5e7c026bade01248b48096adda7be101c7c15901c3a484b2",
      "text": "回礼送什么好呢，\n我想了好多好多……",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:ba4883199e2dc7d4978b5375e05699eb58516fb6f756570acb4f97c9af9c9277",
      "text": "因为很想和制作人一起去看棒球比赛，\n就选了这个！要不要一起去？",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:1e477ffcd490a81965e8b04199156fe5c2ae0205ffe234d6a727533f407a9085",
      "text": "听起来好棒啊！\n请务必让我一起去。",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:fadbcaa89dae51d0b1c8f34e73075197ddfca9566e3267f8692cbdf53811ff05",
      "text": "真的吗！？",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:755c84c65d1afe22f6f6e46ce20923bdd124fe7b2845040b6d7cda20218e12e2",
      "text": "那我去买票啦！\n有空的日子定下来了就告诉我哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_020_23_5_02_020_23:5_02_020_23:cmd-000053:dialogue:000": {
      "source_hash": "sha256:e5ee9df06de2d3629ef4d0bd6d5e29da9b8b4f1eb63dce26a7af1dee5d9e28c4",
      "text": "嘿嘿……真让人期待啊～……",
      "status": "draft"
    }
  }
}
