{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "005kao_401_2_4_005_01_09_b",
  "source_raw_hash": "sha256:bc0534d38989e0295b0f0f0336b4733a314e8c5e5a11069110aa0411d1925d18",
  "entries": {
    "story-text:v1:005kao_401_2_4_005_01_09_b:2_4_005_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:bbe0cf10b66bb18e86791d675a5204f83a534072e32022a7541cf1a623dd6a93",
      "text": "我个人收集了一些\n关于假面舞会的资料。",
      "status": "draft"
    },
    "story-text:v1:005kao_401_2_4_005_01_09_b:2_4_005_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5ebb807c343e052495408d75a79504bb80e0f6ac8342cdd5793a72706aa280eb",
      "text": "如果要开学习会的话，\n应该用得上。明天我带去事务所。",
      "status": "draft"
    },
    "story-text:v1:005kao_401_2_4_005_01_09_b:2_4_005_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:005kao_401_2_4_005_01_09_b:2_4_005_01_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:68414bd403e6c610553baf2117b86d65e81982b0fc5e3e9fc1a80473f3cd5d7a",
      "text": "那就拜托您了",
      "status": "draft"
    },
    "story-text:v1:005kao_401_2_4_005_01_09_b:2_4_005_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:28c5648f518a06c8b46ad403950bea7fd6ffe292e2d109fcfad13644ed3fa4d3",
      "text": "嗯。虽然可能会和你准备好的资料\n重合，但那也是另一码事。",
      "status": "draft"
    },
    "story-text:v1:005kao_401_2_4_005_01_09_b:2_4_005_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:e9596a17de97a59b53950e60f1da8ccbb2e2dd1fbcf2eb36f9c3f0f8ae39a655",
      "text": "借给别人看也可以。\n详细情况明天再说。先挂了。",
      "status": "draft"
    }
  }
}
