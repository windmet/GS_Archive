{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_01_i",
  "source_raw_hash": "sha256:92f5643fdf7f0bae8066a8c7fb603a7146e2052749daae25d4cead580a1f32e6",
  "entries": {
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000032:dialogue:000": {
      "source_hash": "sha256:f750b2be49b6e6e82cf923107ff566903b710fd56b5a3248222d777b62f541d4",
      "text": "……、……。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000041:dialogue:000": {
      "source_hash": "sha256:937f819207a70bac15cfe5a2e1f67c70cae30d6df2cf68db5d0016d0454fd514",
      "text": "唔……。\n那帮家伙居然说了那样的话吗……。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000046:dialogue:000": {
      "source_hash": "sha256:80d103e2f2852a174d940f9a02468285722d6995c6d4b5582db0522c924e46bb",
      "text": "区区一家新面孔事务所，居然这么狂妄！\n我一定要让他们好看！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000066:dialogue:000": {
      "source_hash": "sha256:69526c674c9fd0ca8f0909da2ddab4b2cb601cd8af9507c478f7ca2d1ca7c950",
      "text": "总而言之，就是男极的相关人士\n听到了那些话对吧？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000072:dialogue:000": {
      "source_hash": "sha256:f1d6e288555ccde605f8f10fdfc637f016ffbba5f0c3f3d0631781dffb5afaa3",
      "text": "应该就是这么回事吧。\n毕竟信玄先生家里都收到信了。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000082:dialogue:000": {
      "source_hash": "sha256:db8a3a44ea5ca762a389e60bebc3a0be3fec6146fb0584791db5e871cb603e64",
      "text": "……可能是因为情绪太亢奋，\n声音变得有些大了吧。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000086:dialogue:000": {
      "source_hash": "sha256:e5ef9b730020c78e8ae9943f2ef9877cbd415e6c231f195b173ac822836c36e3",
      "text": "应该更加注意一些的。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000089:dialogue:000": {
      "source_hash": "sha256:2d1e36f21162d90bfa5d34dede1a96b7c586d9c096eb7bb1ecc35b18f82dda4f",
      "text": "我也因为是在自己家里，\n好像有点太得意忘形了……。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000103:dialogue:000": {
      "source_hash": "sha256:f7c87f3ecd0ec6267f26e07b764c02c705f1f9d7e692f30a53807906c1c4426e",
      "text": "……不过，多亏如此，我反而更加燃起来了！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_i:cmd-000105:dialogue:000": {
      "source_hash": "sha256:bd213b5293136bba1ab29447f9b18c51eae288b1c2c402f01d2ab942378fd009",
      "text": "诶……实先生？",
      "status": "draft"
    }
  }
}
