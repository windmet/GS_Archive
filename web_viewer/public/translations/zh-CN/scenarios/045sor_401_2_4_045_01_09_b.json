  "entries": {
    "story-text:v1:045sor_401_2_4_045_01_09_b:2_4_045_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:c4be8f7c08a6007c9998dbe8196f70bd056fbeeb3c1c466f2935d39b3c41a1a8",
      "text": "制作人，辛苦啦～。\n今天商量工作的事，谢谢你啦～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_b:2_4_045_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:b3063fc6c1db26f4bbf2852264887bf924ab21f55a531e7847f76ebf25f24a77",
      "text": "大家好像都很期待做点心呢～。\n特别是英雄先生和春名君～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_b:2_4_045_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:ea2268a90a9d92bb4da6bcaf6642b2f86d15627e559d1fd433bd3fcf0e4e760d",
      "text": "两位都很喜欢\n甜食呢",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_b:2_4_045_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:14f4cf23b650123fc9d856bd01572795458ca01d19d0f02f8f208e4fe8be88ce",
      "text": "是呀～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_b:2_4_045_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:2dc65031efeb0d09d6c1fdff5ec3348d6b5639b0f213de4f6782398edd1578d9",
      "text": "大家究竟会做出怎样的甜点呢，\n好期待呀～！",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_b:2_4_045_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:4248deba9e7f6f4538b35e5cb1de19bf291e5365a55c0f40da6f1b648d22577d",
      "text": "那我就差不多先挂了哦～。\n明天见～。",
      "status": "draft"
    }
  }
