  "entries": {
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000010:title:001": {
      "source_hash": "sha256:c85952662d0e02ff39f46bff430e6681a5aeb5095c23db2583f93f18819c6f5e",
      "text": "在资讯杂志上介绍拉面店的美食测评工作",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:500a469e7e81ffaa2c71dd88f5a9d1d0a5bd4930d37856525e3993fddb8b6dfa",
      "text": "喵哈哈，今天要做拉面店的美食测评\n喵～♪",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:a9534ff229ac6cb310eb804e2e41ed18edd1de2fe0f5aedd8dad010f6cb2c858",
      "text": "桐生先生，心情看起来很好呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:d26ffd77c88c6a0e4f90bc54ab0cb42550b215bc029f3ced73d5cf303cb4c4e2",
      "text": "呼呼呼……实不相瞒，吾辈\n最喜欢曲艺场演出之后的拉面了喵！",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:5632b6cec5e157e54e872e1e0bef9c8ae09f3904773dc853c4be08d14927f59e",
      "text": "吾辈对拉面可是非常熟悉喵。更何况\n今天的外景地点，还是备受好评的拉面名店……",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:5baa736075be2a205eab8b1c5c88ef78b554c89028bd8e9881b752d535ed99ef",
      "text": "吾辈虽然也一直很在意，\n却苦于没有机会去吃是也。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:288ebb4e8cd25652d2f52c27f3324cb3ea588dd4fcda48049b2aa958f52191dc",
      "text": "吾辈可是超级期待今天这一天的喵～！",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:96b28780b0ec5fa6221c5b85b6373576dba7cd98569ab779478452487acbe925",
      "text": "呵呵，我很期待桐生先生的美食测评哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000055:dialogue:000": {
      "source_hash": "sha256:7f11c6fc67342d0f124fee04030a32f50f08f8f5b7553e0995ad213438a54b0d",
      "text": "赶紧来享用刚出锅的热气腾腾的拉面喵！\n嚼嚼嚼……唔唔，这、这是……！",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000057:dialogue:000": {
      "source_hash": "sha256:e00fcad5fc7b321ac63f981334b3e92ed29a29a222b0696aa046af856b61c503",
      "text": "汹涌扑鼻而来的浓郁风味……\n只要吃上一口，筷子就停不下来了喵～！",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_01:1_5_017_01:cmd-000064:dialogue:000": {
      "source_hash": "sha256:b83c957cb6d125160c08fc899d038b28784de2013f3ca9bf9c5ee90b5a044ade",
      "text": "（桐生先生的美食测评大受好评！\n杂志发售后，拉面店连日爆满）",
      "status": "draft"
    }
  }
}
