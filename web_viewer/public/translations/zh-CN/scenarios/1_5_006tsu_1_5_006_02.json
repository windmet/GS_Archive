  "scenario_id": "1_5_006tsu_1_5_006_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000010:title:001": {
      "source_hash": "sha256:57ae752911579c99ea8e15a5ac4d6bf38ccdd29629cdae4b62e8629376213311",
      "text": "在青春电影中饰演老师的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:8b67e0594191b5805aa20bacfde1a56f024509c5e834509ca1f3916eea7b3cf3",
      "text": "“能走到今天这一步，全靠你们努力的成果”",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:12df18d44efc6ce01ba467d6109afe38c8430aa3e8192abaf81e15e2dc094842",
      "text": "“来吧，大幕即将拉开。把你们的演奏，\n传递到所有前来的观众心中去吧！”",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:87ad024d340059b3d0402bd6661c18357b3e17c9b5bb881c37e37ad13451920d",
      "text": "●●●●プロデューサー，感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:2d65113fbac84ff4223e73308b5e49bf4d62f4c49af9ea5a6c68ce90b8c12ffd",
      "text": "很好哦！\n特别是最后的笑容，非常棒！",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:6188eae7d344931d286cb951f25150eed34cb3d9dfe56c1276a3d4fdd07eb552",
      "text": "因为有最后推学生一把的戏份，\n我就想着希望能带着笑容送他们上台……",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:84d99de3ed0862ad69fdee490d959a2cf48f9654c81a5e543f120a97454aadba",
      "text": "本来对角色的心境还没太大自信，\n看来有好好传达出来，太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:1fd298123da181ec0b5efce5f157c5208e66c714f04cd2fc17dd3b4203f0b9bc",
      "text": "自从定下这次的角色后，你在演技课上\n下了很大功夫呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000052:dialogue:000": {
      "source_hash": "sha256:76737058b95adaa7ab19c8be57e34ebd49e49da40b4d2a71c6af2d7192f6b724",
      "text": "是的。希望能回应那些指名一定要我来演的\n各位的期待。",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:f2b5271047f1c51e1d2a16a463d876cc0f7f270b00aaa3734f09f80128ec4d47",
      "text": "那个，我可以再稍微练习一会儿吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_006tsu_1_5_006_02:1_5_006_02:cmd-000059:dialogue:000": {
      "source_hash": "sha256:bfcbf76067436c898848756f1e959de1524a5f9f69a3853a0ccc5b976d3e7d21",
      "text": "嗯，没关系哦。我也陪你一起！",
      "status": "draft"
    }
  }
}
