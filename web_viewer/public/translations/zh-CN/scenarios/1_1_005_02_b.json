{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_02_b",
  "source_raw_hash": "sha256:9195939249b631e44050e1ad391c945b80e5a9a6c517d92fdb384cb11a2cfdfe",
  "entries": {
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000015:dialogue:000": {
      "source_hash": "sha256:d349cec7098b390919450d21d3803ef255b0083a2d80b463c18cef51a4c0bf4e",
      "text": "这里是……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ea4349c07480f72a65900d8b1da8f989e6d869eeff0271e38e670edec13c7f42",
      "text": "（真怀念啊。\n以前也经常来这里和悠介一起练习呢）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:6b6e57661dffea0ea1fc24cb78033d140280771d7175b2a4569b21508d99879e",
      "text": "（两个人比赛颠球，\n或者一直研究必杀技直到太阳落山）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:9485ef892b622387a211a73b20ec537b3df2c360f18a0de40d1db49c81f813f5",
      "text": "悠介……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a00d3aa1517050e45ceac99fedcd8f5fde7dd1aebba53a6d495f0c805019b1e5",
      "text": "缺阵的事，差不多也快正式公布了吧，\n报道出来了吗……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000055:dialogue:000": {
      "source_hash": "sha256:636f9b34b8a65af8947413c1e8a42dad21a2f68625a8821087044a44401fad3b",
      "text": "“苍井悠介选手缺阵！复出短期内无望？”",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:668c8e07ee0d2231756007550aff02665a4c4e0720a176d0559abf7c1d23e7c0",
      "text": "“看了比赛，那伤势感觉已经不行了吧……”",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000063:dialogue:000": {
      "source_hash": "sha256:2b8acfc8623acc83bc4b8b5e40265f1b8e05e6fbdbbe23d01248bfe1b0632bf7",
      "text": "“前阵子状态好像就很差了。没调整好？”",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000067:dialogue:000": {
      "source_hash": "sha256:f73fc0fbd7568106b094acb9bb5322141642eb33f56419e0fa0840d63bf40770",
      "text": "“是不是教练让他上场太多了啊”",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000081:dialogue:000": {
      "source_hash": "sha256:6a7ff919ffd0fce7c39834d863f689957e8303152af6b7ef15aa185de51d975e",
      "text": "（不对，根本不是那样。\n教练和悠介都没有错！）",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_b:cmd-000085:dialogue:000": {
      "source_hash": "sha256:fbef3188550e5351a1f269003c23bf1850a467141f701eefe74a20b57dd75dc2",
      "text": "（悠介变成这样，都是因为我……）",
      "status": "draft"
    }
  }
}
