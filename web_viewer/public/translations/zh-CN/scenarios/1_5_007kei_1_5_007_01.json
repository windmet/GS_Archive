  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000010:title:001": {
      "source_hash": "sha256:63834c691040bb24ec019191c7e1e8871f41c35682bdacf6c76b544bad5814d5",
      "text": "在电视剧中饰演保镖的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:064f40a5099f52deda7c6c83cf63a220ec1478b52538952588409ab163a71207",
      "text": "虽说说是要锻炼，\n但要在室外做吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:f9af3064cbae04cef2e54000e3fc1a8d666e667a5231ce6f8b694f74c34b2daf",
      "text": "是的。圭先生的话，我想首先慢慢来就好，\n把身体活动开来。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:21493300ffccd42a0c5c5e4f9b1ca314a788b45dfa143a8f4265ada2570d7016",
      "text": "平时指导训练的老师\n特意为圭先生制定了简单的训练内容哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:07b40e82bffedd0221e8cd6c7b9b2930a5e541e0f34703b235644b62cfc617a9",
      "text": "这样啊，谢谢你。\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:a4f3ea9669d2d7ac5161df8c4b83b6edd7fdcf1e32309b39db0323a694fbff88",
      "text": "下次的电视剧里我要演保镖的角色，\n所以虽然明白必须要锻炼身体……",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:a25390dc557d7d0becc04091fa84b0fb4d34596aeb0b13a1b8f9c9236338e913",
      "text": "但我不太擅长运动，\n正发愁该怎么办才好呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:36511cd55270587549bd575605aff9f126db32511c214fa07aa95bfb5b10f89d",
      "text": "不过，既然是●●●●プロデューサー特意为我\n准备的……我会试着努力看看的。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:19a5e5502102b90b8d9b50522441003e217b3c50d38ad0bffb77d553e55d20f1",
      "text": "好的！距离拍摄还有一段时间，\n按照圭先生自己的节奏来活动身体吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_01:1_5_007_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:2d269b5d1578c5c73398de858a1d499390972d5f6af391f1a20b238a3180e7a2",
      "text": "嗯，那就拜托你了。\n●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
