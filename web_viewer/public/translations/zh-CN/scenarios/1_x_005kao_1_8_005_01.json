  "entries": {
    "story-text:v1:1_x_005kao_1_8_005_01:1_8_005_01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:55b5d6e25ce6f39a3f8ff03fa39af6ba62bcfdb249ec1d20ac474986fdc96866",
      "text": "……喂，●●●●プロデューサー。\n辛苦了。现在有空吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_8_005_01:1_8_005_01:cmd-000012:choice_short:000": {
      "source_hash": "sha256:eac45b6855021e10962477f5af1f545f3e25f3d1397bf8a1a1c5c53306cfe0cc",
      "text": "有空哦",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_8_005_01:1_8_005_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:3b8a6ff279cdb38fdf831a31363fe6fc5df6cf3182409e33f957355d84050c9c",
      "text": "那就好。\n今天应该是你的生日吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_8_005_01:1_8_005_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:4c3566d9d31bd797b4947c29ed34c32713f430434e223747ed8fc445b3279c19",
      "text": "●●●●プロデューサー，祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_8_005_01:1_8_005_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:31cb625dda851982230d58fe49909f8440cb2f522e9291f1e30da1b7b68bc3f3",
      "text": "我只是想传达这一句而已。\n那么，我接下来还有练习，先挂了。",
      "status": "draft"
    }
  }
}
