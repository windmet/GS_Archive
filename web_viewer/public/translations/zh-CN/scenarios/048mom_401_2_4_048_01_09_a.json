{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "048mom_401_2_4_048_01_09_a",
  "source_raw_hash": "sha256:6f9d356b685e7bd41a6196d08c71a9b154d92cda0f8156242b350569dd567771",
  "entries": {
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:1a94b515471b79da22b8903bf321b73aa382512e609f02904f0f9bdbb7030068",
      "text": "啊……●●●●●●●●●●P酱？\n突然打电话给你，对不起哦。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:e5096cf9930aeb452c45ca07aaed256893b0d8ad8102c1942044253d66bf13dd",
      "text": "正好在\n休息呢。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000009:choice_short:000": {
      "source_hash": "sha256:45a2ea88bca7e3772c90b23608d454d05bd14dcaa352d69fa0b1c54e25534a56",
      "text": "没关系的！\n发生什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:18eed1c5c7f529f01eb456244409e9a48396ffdfb12041fcaba4670b38fe0cc4",
      "text": "原来是这样呀。\n今天也辛苦你了。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:64e9d55b8b7495d3edb380351798944f1e393e32f404b12b202af401836e8e3d",
      "text": "啊，没有啦，其实也算不上什么大事，\n只是……",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:d6c4b4014a33cbd38d57e2ce2adb760ab3c6ecb3c71207c651a88d78c63d70ec",
      "text": "……就是前阵子的那个，\n关于苹果派博览会的事。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:0b468b67920614380e6d6de585d36fbd4a4c573bdd34fdc51f3a98e7994c4596",
      "text": "P酱，之前不是把我做的苹果派\n狠狠夸奖了一番吗？",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:2c6f80be13ac973013041773df18651b2987c3f5ea7e9988aae561b0c5042016",
      "text": "能看到P酱的笑容，看到你那么开心的样子，\n我真的很幸福呢。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:20c5b8d25aff50d11276514cdc10e05a246a165796d7c17a6e6c076304c0e0a5",
      "text": "今后我也想看到你开心的神情，\n所以工作上会更加努力的。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000028:choice_short:000": {
      "source_hash": "sha256:0f3f030d529e4218558a271e51c8a52e082904aa85908fed349c40cac816f4f9",
      "text": "在工作中，\n去体验形形色色的经历吧！",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:8d184fa32913839ad1893c98e3c37018f8cff65de63e239fa0c692f49fdfb7ee",
      "text": "嗯。只要能和●●●●●●●●●●P酱在一起，\n无论遇到什么事我都觉得很幸福哦。",
      "status": "draft"
    },
    "story-text:v1:048mom_401_2_4_048_01_09_a:2_4_048_01_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:5cbab2771acbadc623a93f14728777b7c20099e6c9bba594915bf97c539d6049",
      "text": "那么，明天见啦。",
      "status": "draft"
    }
  }
}
