{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_002_01_e",
  "source_raw_hash": "sha256:a686a6230dbc40c2197afe5bb6149008db4826e0636f986d21d5bd0b03eb8f28",
  "entries": {
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000011:time_caption:000": {
      "source_hash": "sha256:f41789a3f975725f965b9e44a78df3c090c2e74399319f3374cc0492972ca458",
      "text": "数年后……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7babb18749a26ba8b5a40ed299eaf8d4122a637beda964e9340a9662530dc792",
      "text": "（差不多快到最终面试结果公布的时间了……\n哇，开始紧张起来了）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000035:dialogue:000": {
      "source_hash": "sha256:e7bfbdade5ac238a1176cbcbbb2f70ef84ee150034c6d67935b3e471e1d236c1",
      "text": "（不不不，没事的。我都那么拼命学了，\n连司法考试都通过了。这次也一定……）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000045:dialogue:000": {
      "source_hash": "sha256:c5f92972942f46c1626b51cd75131e93872f38dde6ad7bbb59067b0100923986",
      "text": "……来了！\n您好，我是天道。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000050:dialogue:000": {
      "source_hash": "sha256:5c43a5f1731f955036e5443b7b432856b2c74ba9bbbcf74a2d53452e2c6653b0",
      "text": "是的……合、合格了！？\n真的吗，非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000053:dialogue:000": {
      "source_hash": "sha256:18e4839ac0b05541c23629bb3714f840fd0ac760db06c8f8984559f7dea232b9",
      "text": "好的，今后我会努力的。\n请多多关照！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000058:dialogue:000": {
      "source_hash": "sha256:e3b3f2e100afc8c76c3c1028cb16a88d10ef3231cbb06d1eb6f20d57191e564f",
      "text": "好的……好的，失礼了！\n……呼～～……！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000066:dialogue:000": {
      "source_hash": "sha256:20a7be2aead93e507338c6d4e9047e99b985fcf774b626c651adc4e5a6c211ba",
      "text": "（我真的，考上律师事务所了……）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000071:dialogue:000": {
      "source_hash": "sha256:8d4e2ef9a87d8d2be62a2b545ba7ac62cad655b1102adef62ded0e80053cbed3",
      "text": "（这样终于能够作为律师工作了。\n能够让更多的人展露笑容了！）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000075:dialogue:000": {
      "source_hash": "sha256:cc56001e6979d62d347ca123a96c2976cca3e978f9a1fa5b58125ed9b83e7e51",
      "text": "（我的梦想，梦想实现了！）",
      "status": "draft"
    }
  }
}
