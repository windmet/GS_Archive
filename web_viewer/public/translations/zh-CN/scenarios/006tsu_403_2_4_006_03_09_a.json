{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "006tsu_403_2_4_006_03_09_a",
  "source_raw_hash": "sha256:e2f13f213037410cc8d38cb56f99b1528f1df3620f4db4da8638f442bed49233",
  "entries": {
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:c734d963d2f661ab0b66fd4ecef571bc9732ab2283a063cd59ebbd5cf4ae3f4d",
      "text": "●●●●プロデューサー，包裹收到了。\n那些全都是看了CM的人的感想吧。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:8bf3a6747ae85e5af301f2382565ddfd6bc9ce4de1910a4c505f4477476622bb",
      "text": "我接下来准备去读，不过有点紧张呢。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:d8860ea5e740a83af8821aa3377f4ae6be0628bf69cef2fc9ea4f0236891d442",
      "text": "反响超级大哦",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:98044b88e1c2a2a95eec988dbf837343e0206c6c0ca2ff2bd9c41b6652826fa1",
      "text": "真的吗？那就太好了。\n关于这次的CM，我格外在意大家的反应。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:16a91510cf65e6ff0e1fb9675ce9d0ae0caa0de0435562cf439eccb387cb0b6c",
      "text": "虽然制作人、辉先生和薰先生都夸我很帅，",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:08f7f71f0bff526f2470282b64a284ec19d569dd207f9d4d6fc6488803cbde22",
      "text": "但会不会有人觉得\n“和平时的形象不一样”呢。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:75259b32ee0287326029fe6e52cd5e04fc8255d4cdfe440e0fb7e5aa265d1db1",
      "text": "这也是翼先生的\n魅力之一哦",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000020:choice_short:000": {
      "source_hash": "sha256:921e062c90ddf0126864a26f6e9a387c0bf672d1bab4a62f120e6097b1940ade",
      "text": "不如说反差感\n很好吧",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:2f528f02dabc0f5bac767328d8b7817d33c19199b747459c77d0c7b236265bc8",
      "text": "是这样吗？\n我自己还不太清楚呢。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:f49cd52b37757ab378e2ce6517d00e8498440a28325d6b77afbd5aa7ad9950d0",
      "text": "是这样吗？\n反差感啊……",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000032:phone_message:000": {
      "source_hash": "sha256:805514ea71f60e951db66de49cffb879deabe8f5673d4bbb4855fa8fe628d410",
      "text": "不过，大家能高兴的话，我也很开心。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_a:2_4_006_03_09_a:cmd-000034:phone_message:000": {
      "source_hash": "sha256:15ecda4620dbdf32690d5e94761737500d996ed2184830f40f40ddb3624a70e7",
      "text": "我去读读看感想吧。\n制作人，谢谢你。",
      "status": "draft"
    }
  }
}
