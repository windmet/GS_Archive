{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_03_b",
  "source_raw_hash": "sha256:27d6fd712d6da0a21ebc85c7da7cbfc60c70dcc860e81c985e52506717999639",
  "entries": {
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:32422daa9388d2963730340e0143b27d9385f0654c02a8a1f9f88c8ab509ec7e",
      "text": "欢迎光临Cafe Parade！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:8b98e0cfd034e863a9f85407386801e169e16ad2c8060e18924602167a7b561c",
      "text": "这里就是我打工的地方哦。\n稍等一下下。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:01dfbf0b9b426403d7e3c47d2de07ddc85c0a0a0b965e56d5cc1b02ef261ac69",
      "text": "嗯。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000064:dialogue:000": {
      "source_hash": "sha256:c8c81ce16bb69f0e2b119dd24799c2b08ea30c268c0ebd5c21cc2be8741abf30",
      "text": "（哇啊……超级可爱！\n好棒的店啊～）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000085:dialogue:000": {
      "source_hash": "sha256:911363c32da402dec3c467f0e6bd375d61fcf7151460cde525daa601d85594e3",
      "text": "水岛同学，久等了。\n给，毛巾。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000089:dialogue:000": {
      "source_hash": "sha256:b16704380c93fa87f1402b6f473235988cfc56270bba01d1ed134288d0f24bdd",
      "text": "谢谢！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000107:dialogue:000": {
      "source_hash": "sha256:608bffae2e5d27e5b8c7bae73987bbf9f75c5b2eef197fee3bad950bb6e2a9ac",
      "text": "初次见面，我是店长神谷。\n情况我都听卷绪说了。真倒霉呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000116:dialogue:000": {
      "source_hash": "sha256:901918eeaaf35f3f3368b3a4658f53d6391e41560f57c20a3ca9da8f02609302",
      "text": "初次见面！我是水岛咲。\n那个，非常感谢您让我来避雨。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000122:dialogue:000": {
      "source_hash": "sha256:2852d17280697050f21229d099bb367d646d371e672e1bc3ebcdc3d8d73cb07e",
      "text": "互相帮助是应该的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000130:dialogue:000": {
      "source_hash": "sha256:e32b83b8164ec4279bd95016d0d189ed1ec71905379bf72a8ab1e03113107ec5",
      "text": "我准备了热红茶。\n来，请往这边坐……这位小姐。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_b:cmd-000139:dialogue:000": {
      "source_hash": "sha256:2f47021e2631c86f3a0943b1254f1ffde2223475d38ffb7db0c9012979d86d9f",
      "text": "（这位小姐！？）",
      "status": "draft"
    }
  }
}
