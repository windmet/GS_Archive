{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_039_23",
  "source_raw_hash": "sha256:6431b937e017f347884ede2cf19687a52f5c0f9447b4a7aae8bb230fc7008390",
  "entries": {
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:9a58d0f35c3a58b15dcd8f74f23dfd4ae3a27a479d3b37be80b4e15ab35d007d",
      "text": "欢迎光临！……啊，师父！\n你过来啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:752c5a835bb0c7e74b73cf1327c5e59f3a7875156f3b14af14fbb5a4145a9e45",
      "text": "来得正好！\n我刚把试作品做出来呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:6ed56bb2af28d8aab087dca589e707256926bee77d4da52c95443378649461b5",
      "text": "辛苦了，道流先生。\n有一股甜甜的气味呢……",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:eca8cccfc06630ec25173819338f28a76fd9544739fdd70891914220365f4c4b",
      "text": "毕竟是情人节期间嘛，\n我就试着做了一款加入了巧克力的拉面。",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:07786f11c581469977eed63309d77d31c90b40ac05c743c3f4613ffa3aee909d",
      "text": "虽说是出人意料的组合，\n但这味道意外地相当不错哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:6790b0aec55628510ff8ba45aff78c4a0501b91451d379913b893c3b50f244ad",
      "text": "除此之外，我还在考虑结合情人节推出其他服务……",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:28601341dc300e40ba6695dc9375aacf3a6c64ab21ddb216d5e136f91c14d120",
      "text": "不过首先我想听听师父对这碗拉面的感想！",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000041:choice_short:000": {
      "source_hash": "sha256:06d7d08e48d4b97a68e558f9a0623f9fc4a069d50bb303e53abaaef8e60dad5e",
      "text": "太棒了，我开动啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000042:choice_short:000": {
      "source_hash": "sha256:cc1daba66a92e1544bb5e0d4379823da17e2d909abdc0954e0c2132943351bea",
      "text": "道流先生的热情，我好好体会了！",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:0f2817efad88b03da1c2cc61fbaf3cf44c239c988e0c8fca47983a9b38bd863a",
      "text": "非常感谢，我马上端过来！\n配菜浇头是这个还有……",
      "status": "draft"
    },
    "story-text:v1:5_01_039_23:5_01_039_23_a:cmd-000062:dialogue:000": {
      "source_hash": "sha256:ba4888c211b4b25a201d25ce1d1248fd17812e0fa9f3d5d47dd395504296e736",
      "text": "好嘞，做好了！\n情人节特制拉面一碗，请用！",
      "status": "draft"
    }
  }
}
