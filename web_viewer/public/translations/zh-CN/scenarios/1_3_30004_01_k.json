{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30004_01_k",
  "source_raw_hash": "sha256:450a935775bca1508ad4abfe59c5f5547a46a8c9b5cc431c1181f0cf92aa9f12",
  "entries": {
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000014:time_caption:000": {
      "source_hash": "sha256:c444011f87be92a51fc9901bc4f3a46ccab37ccbd02fbc038a7ddff2b83cf8f0",
      "text": "看完后……",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000028:dialogue:000": {
      "source_hash": "sha256:d3cd149fcf68e781a370c8901c3dfab2d35e8e4be4ce22bfc42d696105a2e965",
      "text": "……呼。\n三十分钟过得真快啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000032:dialogue:000": {
      "source_hash": "sha256:c324c1637d5e3675efa33937f9fc8e5b4ca30daf7cc81e9874d0b9813831e98e",
      "text": "因为太紧张，手心全是汗。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000038:dialogue:000": {
      "source_hash": "sha256:640620afdb632b9376f181cda1e963f1eab3456240646779c7a48a2842ae4067",
      "text": "不过声优的工作，也挺有意思的啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000045:dialogue:000": {
      "source_hash": "sha256:82e6c5ed6d326d2e0f8a600b585256f1ff926cde65f79aff8bed88f7d9dfefe3",
      "text": "是啊。虽然一开始在想会变成什么样，\n但真是一次很棒的经历呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000052:dialogue:000": {
      "source_hash": "sha256:9f408ca9ba68db1dda750e7c687d793870ea6810ca5e0fea5c0b1a1b12d8ecb8",
      "text": "嗯。虽然面对新事物会感到不安，\n但能看到不一样的风景，感觉挺棒的呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000056:dialogue:000": {
      "source_hash": "sha256:0d9eff50fa7cc4b5e81e8a71ba4ab2f9572d0ab488720906c2abcfcc491104e6",
      "text": "《明日转》的主角也是这样的心情吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000065:dialogue:000": {
      "source_hash": "sha256:1d4b0a7356277ac6880f4c33ab53cfadf43a79fc391d66f99d16651137b870a0",
      "text": "肯定没错！\n享介……今后我们两个人也要一起加油啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000073:dialogue:000": {
      "source_hash": "sha256:2a62dca3f0d7efefb6cf0610d5546164c3d7cd47e2450123d763185e9c7110bd",
      "text": "嗯。目标是成为顶尖偶像！对吧。\n如果是我们两个人的话，绝对能够做到的。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_k:cmd-000087:dialogue:000": {
      "source_hash": "sha256:896954c7a973c90069d4891a123ff1095c1a1fbf6d2f6dd91997e72eaacdf2e6",
      "text": "啊！今后两个人也要一起全力冲刺啊！",
      "status": "draft"
    }
  }
}
