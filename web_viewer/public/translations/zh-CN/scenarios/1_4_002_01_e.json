  "entries": {
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000011:time_caption:000": {
      "source_hash": "sha256:de032b14ad770092a08e64ee0b7359b1bdf150548e5d96e8eacb1487cc8ae481",
      "text": "次日……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000022:dialogue:000": {
      "source_hash": "sha256:4f8e4c5bfb7d232b0a35012d89b08af538621b21d93631eb9273a3e4b36a8ac5",
      "text": "呼……呼……嗯…………？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000032:dialogue:000": {
      "source_hash": "sha256:6060b148ea5d3bbb3618afef97c5177fa59e3951414c3c9018bb3167855b7ed0",
      "text": "（啧，感觉到有人的气息……在玄关吗）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000038:dialogue:000": {
      "source_hash": "sha256:2a3235e07267e90678425f9fbd7452cb80f43ee500fd6c48fd2165bbeea496e3",
      "text": "（从脚步声推测……恐怕不是妹妹\n或者制作人……是谁？）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000054:dialogue:000": {
      "source_hash": "sha256:33a089b27f03175151a57fef5aa05dd329f0187660058c7e306b506322078c2b",
      "text": "噗溜！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000067:dialogue:000": {
      "source_hash": "sha256:21903f5b6f125355842dfec8602d874a95301aba93eaa0d481e4827832128850",
      "text": "这是……玩具箭？\n为什么墙上会有这种东西……",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000081:dialogue:000": {
      "source_hash": "sha256:5a17eeb7582cc86008db9a32affd047ea01f01f924fff1d8aaf31a5d0e9caa44",
      "text": "（箭上绑着什么东西啊。\n……信？到底是谁把这种东西……）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_01:1_4_002_01_e:cmd-000094:dialogue:000": {
      "source_hash": "sha256:9d3b085e5b73266089d7563fbb32fbf7d6e617d76b24777d57c75037bfc9a49f",
      "text": "这、这是……！？",
      "status": "draft"
    }
  }
}
