{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_044ame_1_7_044_01",
  "source_raw_hash": "sha256:e5089d43e72a5b2edea7335d251ad396d440f5111092c1a02e00868adcde246f",
  "entries": {
    "story-text:v1:1_x_044ame_1_7_044_01:1_7_044_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:09ebf8146295cb456aa6c3a4459637776b81f482c915b3be4857b99caaaea71f",
      "text": "雨彦先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_7_044_01:1_7_044_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:9848e222ad890a440c8bdd38f1192967f9c2251218f16a12e6c3db5f878ee435",
      "text": "到了这个年纪还能被人庆祝生日，\n总觉得有种不可思议的心境呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_7_044_01:1_7_044_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:13ea9421d4e88609cbab2d6d2b48f54d7a5c4acbc49b70d6484d92cbfc617833",
      "text": "没什么，是你替我庆祝的嘛。\n我自然觉得很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_7_044_01:1_7_044_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:96783bda7129bf919d08b6b410fd1ce23bb0b2a6cc67b5acfa53d3ab5e86c62e",
      "text": "多谢了，\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_1_7_044_01:1_7_044_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:2293b24f746d8704273d518d0eb431d95c5ab7a91f03cc0ec81feb98f180946a",
      "text": "就让我作为偶像不断成长，\n来当作给你的回礼吧。",
      "status": "draft"
    }
  }
}
