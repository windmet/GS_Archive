{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_01_h",
  "source_raw_hash": "sha256:2c369236be1af07d28e847ee252657c5321b4ec37bdfc39f2001f8fb0916c776",
  "entries": {
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000020:dialogue:000": {
      "source_hash": "sha256:3c091417729f5eaada9c9f68b4049a81982254858ca8834c9060543468a29040",
      "text": "气球……？\n这个，是要送给我的吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000022:dialogue:000": {
      "source_hash": "sha256:98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "text": "……！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000028:dialogue:000": {
      "source_hash": "sha256:1cff071299b646902efbf13d6177d6eaa081e39f00b36206391907ad8d8e6d2f",
      "text": "哇！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000032:dialogue:000": {
      "source_hash": "sha256:27aa539c6b2723b770ed38d490bd8aca77bdb2fc59e68eda23a00fcff9e500ef",
      "text": "（拥、拥抱！？）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000037:dialogue:000": {
      "source_hash": "sha256:370d01fc70edca1cb5350023e5f962080bf2f2747bc50cc7659f27a2fb156e35",
      "text": "（咦？……好神奇。\n暖洋洋的，毛茸茸的，感觉好安心……）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000042:dialogue:000": {
      "source_hash": "sha256:5462ea30bf96dabbfc090ec5e670d929841ddf606a989d04e6c0de9e24380ca8",
      "text": "皮埃尔大人！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000062:dialogue:000": {
      "source_hash": "sha256:7ec75cc254ca3f9e193a581e98baf7bda9b11ff1c220a00da385d15e4510b964",
      "text": "您这么久没回来属下很担心。\n难道这家伙对您做了什么……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000067:dialogue:000": {
      "source_hash": "sha256:419d173a0640985a7502b860a4da2ed38ef11e7678601f6a817d22264094316d",
      "text": "就是这个！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000069:dialogue:000": {
      "source_hash": "sha256:331f675a95fe655d1bb3f9685ec7e70e15e76338802e720b26601f57df1d3d10",
      "text": "怎、怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000074:dialogue:000": {
      "source_hash": "sha256:ae746d2114b78cfcf09d12ed09bb0fd9375cae290bf3649148955df8a701a0d4",
      "text": "就算语言不通，也能让别人露出笑容……！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000078:dialogue:000": {
      "source_hash": "sha256:d25e408385503f8f732f0919f2d6f302ff283ffdbb320e57aeae6f365b21f1b0",
      "text": "我要变成这只熊！！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_h:cmd-000080:dialogue:000": {
      "source_hash": "sha256:dd633da1a5fd433efdb576a15c2c14217a5f12d924641488c6d8e1619b179c88",
      "text": "诶……诶诶！？",
      "status": "draft"
    }
  }
}
