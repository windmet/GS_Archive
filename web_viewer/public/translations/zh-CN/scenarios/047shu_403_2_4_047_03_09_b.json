{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "047shu_403_2_4_047_03_09_b",
  "source_raw_hash": "sha256:0ddcda311f02c0b06b7e9231e9ba4701cac8128880ce7d284ecf692719658c55",
  "entries": {
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:05ac3dd244b9907e801c5e7e4eda40f13f0e704b6a28537e43794a1cfcf1b6cd",
      "text": "啊，●●●●プロデューサー。你现在在事务所吗？",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:fb60ea983694ea38faa416db655c6f98b72a1041195a735aacbeeccb275fb741",
      "text": "我正准备过去一趟，你能抽出点时间吗？",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:3df3ce403edf641282048739f96fa8b066707ebb6c416747af9dee030fcca019",
      "text": "好突然啊！",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:55f2b33df920c2a4e5c8df27b11a754391fc3d8cedb08a2a8bee45dea7ed354a",
      "text": "今天应该休假才对……",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:d4ca4e172a749612bc2b0d41f2dd95f26971f535347d5c320191b3aa38005188",
      "text": "这叫惊喜啦。看你每天都那么忙，\n想着顺便给你送点慰劳品过去。",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000019:choice_short:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "谢谢你！",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:cfca4181d63fa6477c79290fc4838306c85fe96edecba438da275ece10edd1f8",
      "text": "不用客气。……话虽如此，\n其实这也是为了接下来的工作做的预演啦。",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:b1093e2b9a3c1c97c9015cd2b0ac07426d4a369c4b8605f0074a06941ee287fb",
      "text": "你看，我们这次拍摄的角色设定不是配送员嘛？",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:f3057fff860463ff9c9c8df208030b55ffc797180c4c4a3bfbcfba5728e91762",
      "text": "我觉得要是能先体验一下类似的事情，\n到了当天或许就能更顺利地进入角色了。",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000028:phone_message:000": {
      "source_hash": "sha256:cbfb05307eb554d90e4dd3cd00fe244aff3f68dd9749c8f75590d1fe732cec54",
      "text": "既为工作做了准备，又能慰劳你一番。\n这主意简直绝妙，惊喜感拉满吧？",
      "status": "draft"
    },
    "story-text:v1:047shu_403_2_4_047_03_09_b:2_4_047_03_09_b:cmd-000030:phone_message:000": {
      "source_hash": "sha256:33357d0dcff03d997ac6f14a3b90c6a7d7f8cff26cea3bb155aeebe4ad2578fa",
      "text": "我马上就到，在事务所等我吧。",
      "status": "draft"
    }
  }
}
