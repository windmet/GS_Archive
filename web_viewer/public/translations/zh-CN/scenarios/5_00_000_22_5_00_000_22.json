{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_000_22_5_00_000_22",
  "source_raw_hash": "sha256:32be8234d63f955530bd92b3bbc7352b1b88098d6be973e81c3697769dc6338f",
  "entries": {
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000000:title:000": {
      "source_hash": "sha256:5f7dc137925ae5daa4b96272097d78a26a008c51f7cf93627fac249f54ee028c",
      "text": "新年的抱负",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000000:synopsis:000": {
      "source_hash": "sha256:1071cbddebcba9c3c6bba057206381077a17e9ffaf7e86ab035f17fa5756a0d5",
      "text": "在事务所互致新年问候的\n社长、贤与制作人。\n大家聊到想让偶像们\n写下新年的抱负……",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000013:time_caption:000": {
      "source_hash": "sha256:5f7dc137925ae5daa4b96272097d78a26a008c51f7cf93627fac249f54ee028c",
      "text": "新年的抱负",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000021:dialogue:000": {
      "source_hash": "sha256:62f7e9d2606ad670054b9dbedfd7a5c51b15a4efd5070b6a06667339f8a84daf",
      "text": "制作人君，新年快乐！！\n今年也让我们一起充满PASSION地前进吧！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000030:dialogue:000": {
      "source_hash": "sha256:7a7aa8ea6a846f234378d9a086fe135eb7414926cd0598070b1a8a2a7e9689c1",
      "text": "新年好，制作人。\n今年也请多多关照！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000035:choice_short:000": {
      "source_hash": "sha256:1910df61045b11756dfb8300b85118c117eeae0453b7a575e20d329b0c083285",
      "text": "好的！请多多关照！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000036:choice_short:000": {
      "source_hash": "sha256:79e22e03ca47e0efab26c376e2299daa575e9578d62008718c75d43d487e3d52",
      "text": "新年快乐！！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000039:dialogue:000": {
      "source_hash": "sha256:5cc2b40a590f9ce1ae05e05f9d6fd1a38013b75a7386b9caeeacc5f6eca4de32",
      "text": "PASSION！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000042:dialogue:000": {
      "source_hash": "sha256:55915c723050c526f2f8b43792e9af2ebb991acbfcc634b536131507e1ba0eba",
      "text": "嗯，很有精神的问候！接下来也请怀揣这份热情，\n全力去做好偶像们的制作工作吧！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000044:dialogue:000": {
      "source_hash": "sha256:ebee70fbf9a18c16a923596b04dff119bb3180b3c425efc50a8bbb1194627fb9",
      "text": "那么言归正传，我想让偶像们\n写下新年的抱负！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000046:dialogue:000": {
      "source_hash": "sha256:9c8bd5002b3446e6b922ecee3e8e1cec4a2b907cf32cdb9bc4270688553a091e",
      "text": "毕竟平时难得有机会能和他们好好深聊嘛。\n我想从新年的抱负中感受到炽热的PASSION！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000055:dialogue:000": {
      "source_hash": "sha256:05103a5951952dc1432cdfa9f6e473b9ade609a46f445b98c5507980e4a87cb6",
      "text": "既然如此，让他们以组合为单位，写在后面的白板上\n您觉得怎么样？",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000058:dialogue:000": {
      "source_hash": "sha256:41607f7a0ad9e5806e2cfbcbf11f650e6ad358030a86bb1fcb6c87ea93d76462",
      "text": "这个主意真不错！\n偶像各位那边，就由我去联络吧。",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000063:dialogue:000": {
      "source_hash": "sha256:2787b0382456a9c3d75c9e5a09886a3bb0b8fb8fd8388c5fc25885b1685b62cc",
      "text": "就拜托你啦，制作人君。\n偶像们究竟会写些什么，真让人期待啊！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000071:dialogue:000": {
      "source_hash": "sha256:cf3b7f2f51cde0f0e0900b72a8a7f27a9ae4132ff8f87bbf6c345494ca456631",
      "text": "好的！白板上写好的抱负，\n我会拍下照片留作纪念的！",
      "status": "draft"
    },
    "story-text:v1:5_00_000_22_5_00_000_22:5_00_000_22:cmd-000076:dialogue:000": {
      "source_hash": "sha256:3053346ab623acb7d477659a62c2c5701bae1a6a4a6c98063bb71a61f3fdcf9b",
      "text": "说的也是。以后说不定也会想拿出来重温呢。\n交给你啦，贤！",
      "status": "draft"
    }
  }
}
