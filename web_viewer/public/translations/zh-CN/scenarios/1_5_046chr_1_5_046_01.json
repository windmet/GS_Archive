  "entries": {
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000010:title:001": {
      "source_hash": "sha256:513b2dd09780cb32847383547abd2426eb7879a6d4cf85356c573bd8b18cfe40",
      "text": "中国战国历史题材音乐剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:158686f357ab6edd322ee20f4be9f9a565bcfbdd7bbf60b99cf512c31015d672",
      "text": "（克里斯先生说音乐剧课程结束后\n会回一趟事务所，但到现在还没来……）",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:0c2b768095d3672c4bccfe6434caa8a9941456d79fb6c086d0ddae9b81e7ee26",
      "text": "（怎么回事呢？去看看情况吧）",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f0fe34d5e694ead4e76e0466a2682585494ab1a2f2c0b17a42856e8c31f4dc87",
      "text": "“我绝不能在此止步～♪\n直到与那人的誓约得偿～♪”",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000063:dialogue:000": {
      "source_hash": "sha256:3144ee5906e1354360b90243e2cc1a92cd76e4db8bbb01025401c92ac326bb30",
      "text": "……感觉不太对呢。\n“我绝不能在此止步～♪”……好难。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000070:dialogue:000": {
      "source_hash": "sha256:35665ad8e13f77f8e911cfcc9749d95c07d48cc2bc7ef4f6338a4abfe6d93767",
      "text": "克里斯先生，辛苦了。\n原来还在继续练习啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000074:dialogue:000": {
      "source_hash": "sha256:230807c02e7d2b29d23a687918a91135eecfd2005dccbca80be04a564fd26418",
      "text": "诶？●●●●プロデューサー……？\n啊，已经这个时间了吗！",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000079:dialogue:000": {
      "source_hash": "sha256:d2f9d23e7ed178c83e32d57127133d5d9d956499aec80ea9a412ccfe8dd247e5",
      "text": "不好意思，我不擅长唱歌，\n所以想在联合排练之前尽可能多提高一些。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000083:dialogue:000": {
      "source_hash": "sha256:2abebaf166476bebe291b4391c088d28763e454906f88925e3f1b00a85656b3f",
      "text": "能允许我延长练习时间吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000087:dialogue:000": {
      "source_hash": "sha256:3c18433b332cf53555763022c66af14a5b02514edc9244cb92c15c4b187b7687",
      "text": "既然是这样的话，我也来陪你。\n一起加油吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_01:1_5_046_01:cmd-000092:dialogue:000": {
      "source_hash": "sha256:ee1ccad83db1999c15bd0c7a41e825d7290fcb19d218385c38068c935ca6943a",
      "text": "●●●●プロデューサー……\n好的，非常感谢！",
      "status": "draft"
    }
  }
}
