  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000010:title:001": {
      "source_hash": "sha256:27dde1e68f4564e3996e56027c937ea3c1d3486ece30f0ccfa3a24dd274f12a0",
      "text": "电视节目中体验无人岛生活的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:94421d0e06962d7cec0630134d4c967ce10c81f16ede8baa2cb240f4a3506c4d",
      "text": "克里斯先生，电视节目的工作定下来了。\n这是节目的企划案。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f75202b3fa5d2cb2fb82d1b4b6d6a4b3fa4c0dc1fe367d4474bd39f398240946",
      "text": "是有各种环节的综艺节目呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:9c057d9e37d3dde5462e8aba11362f30e43ca3458a355399a53a6662d34c2697",
      "text": "由我负责的环节，\n是《惊险刺激☆无人岛生活！》吗……",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2dbe44c299836d688bcce4d2524bb3add1991bcf2ad130fa7e939c7565edc6e6",
      "text": "原来如此，要在无人岛生活三天呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:642f9da91d30847e71724132d423fc79d840c399a967bc5e38070a4bbd88e099",
      "text": "因为克里斯先生对大海很了解，所以对方才特意\n发来了出演邀请，不过……",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000038:dialogue:000": {
      "source_hash": "sha256:90110aa09a85d990d2b87ad888e050b629039dbe6a0c04227541e4e1792fe00f",
      "text": "毫无疑问这会是一场严苛的外景。\n身体吃得消吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:45112319dfa9e11bd4d87d44eb1eadd3e82946ccf627056732331435a2ea6104",
      "text": "没问题。我很擅长户外活动，\n而且也有过在无人岛求生的经验。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:4bd8eb00fbc792f6f2622e4d2cb240543b2b7b55f7b8f5c243a194c26cb90f00",
      "text": "这么说来，您之前确实提到过呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000054:dialogue:000": {
      "source_hash": "sha256:b180a8dabb8506c3fad62144564f39f15e62db39f182d6536ff89377dc0398f4",
      "text": "是的。所以就交给我吧。\n我一定会让这次无人岛外景圆满成功的。",
      "status": "draft"
    },
    "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000059:dialogue:000": {
      "source_hash": "sha256:4b56bfc30eea9a89d6e6843c0d8c8f648b8294c810f49ea64f1122fd98e4a136",
      "text": "那我就放心了。\n但是，请千万不要勉强自己哦。",
      "status": "draft"
    }
  }
}
