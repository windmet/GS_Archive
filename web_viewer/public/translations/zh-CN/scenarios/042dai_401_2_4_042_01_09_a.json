{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "042dai_401_2_4_042_01_09_a",
  "source_raw_hash": "sha256:2114cd2a4c38baca5be645c72d9281a04b0a0e471ea242ab4fd068bbf640ace4",
  "entries": {
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1597171a8f23cb3a2a9ab253af634051d0b262355c2262fb6c06d394f10974ad",
      "text": "喂喂，●●●●●●●●●●老大？\n哦——是俺啦。",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:4fdffd87c4e063aae39c5333196ddd7a4ee0f36ab03358f99e6ee2375b341076",
      "text": "看着祭典演出的照片，\n忍不住想跟●●●●●●●●●●老大聊聊啦。",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:06ee514f356d037f62ab1a753a3cf20bdcfed62b0aab48f6913a15b9c471af6f",
      "text": "再次祝贺演出顺利！辛苦啦！\n哎呀，真是一场好演出啊。",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:56b7ea5a1f6af43c654e93b0f804681bcdef209fa9ed7ba28121604dff9c9914",
      "text": "最让俺难忘的果然还是烟花啊。",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:da38a3dcef7d1183a6957bf9a9144fdb69a6a4f93db68f5f381b34bff3d8d343",
      "text": "绽放的时间点掐得太准啦。\n嗨得不行啊！",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:9908b1df36607bf131db7dd114e9d059dc9fba2a221186dfe4b2dc818ab59f6d",
      "text": "祭典也很好玩。\n真想大家再一起出一趟远门啊。",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:f34da42f3c06fc2aec9a604f251bc4e0b0b6e65c059ca120a8f92d8288b689d1",
      "text": "为了让各方都能来邀请俺们，\n下一项工作俺也要加油！",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:795f1b41df27186eecf952a1a95a9103d7b26cf982c27686ee44df3a16db4d11",
      "text": "一起加油吧",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:a6c4907228fa9834fe10b7f635cd786a4b23e1a7df44fff45bf1af5cab3edfae",
      "text": "嗯。\n多关照啦，●●●●●●●●●●老大！",
      "status": "draft"
    },
    "story-text:v1:042dai_401_2_4_042_01_09_a:2_4_042_01_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:ebd34ffcaaeb9716416b575199480e836745d8625182acd5fea2e72264bc6de2",
      "text": "……哎呀，煲电话粥扯了这么久真不好意思。\n明天见啦！",
      "status": "draft"
    }
  }
}
