{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_006_03_h",
  "source_raw_hash": "sha256:39fc09f665c41a4cf779bfd510352bc3d7b845ec465f6edfea5f1e002cd43f0a",
  "entries": {
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000011:time_caption:000": {
      "source_hash": "sha256:3db3a42d9b966018020a11584e5daca095992592800bfea252f0b3daeadf30eb",
      "text": "315 Production·社长室",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000017:dialogue:000": {
      "source_hash": "sha256:7f9cac7b932e0821b8a2be859504e811f0d78ac3fd3c1be446fa4cfeefe3a754",
      "text": "下一位是……\n握野英雄先生、木村龙先生、信玄诚司先生。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000019:dialogue:000": {
      "source_hash": "sha256:fc15818765f85f8cf397ea78817601efa0a4eeb09bf9f35312f6cbba408930a3",
      "text": "如果是这几位的话，\n我想一定能成为优秀的偶像！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000021:dialogue:000": {
      "source_hash": "sha256:9bed55e93714a70b2b2f0b438587a543495df06691c634df927077c712acda06",
      "text": "啊，我也深有同感。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000037:dialogue:000": {
      "source_hash": "sha256:6cf4ce6efbf3c5db3ea9c6b47b11469da09641fc5801bc998ba8a6ac9c5a8ad5",
      "text": "两位请用茶。\n选拔进展得如何了？",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000045:dialogue:000": {
      "source_hash": "sha256:2995a7701140ac49dd1f69f0111804ce634857bec3b8e88a216b9c16e61a1288",
      "text": "很顺利！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000056:dialogue:000": {
      "source_hash": "sha256:555a61ca4d74dcfba30b62933d6351c7d088a6d18de1e1a823caea9970558e95",
      "text": "啊。是前阵子那几位前公务员吧。\n我也记得很清楚！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000060:dialogue:000": {
      "source_hash": "sha256:e6182c585c28aa1d10171d028874e8c858b46112d78f734a784444767415f1cd",
      "text": "虽说至今为止有各种履历的人\n参加了试镜，但是……",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000065:dialogue:000": {
      "source_hash": "sha256:8b2b273bde6ea62cd2627a0fbdcb97c50b1731c5683912356b7438796d33fbb9",
      "text": "前警察、前消防员、前自卫官，\n印象真的非常深刻呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000068:dialogue:000": {
      "source_hash": "sha256:6eee60681c7173bad0dce0e40eede764dbbe7af9d7bb2d864a41f6af8ee945c5",
      "text": "是啊。不仅如此，\n我也感受到了他们作为偶像原石的光芒！",
      "status": "draft"
    },
    "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_h:cmd-000075:dialogue:000": {
      "source_hash": "sha256:2cc55fa0ef63adcedaf5b34de04c20a9e3d01587e15aa9abc4dc2dfd475c28d0",
      "text": "（社长的眼神也仿佛在说“感受到了绝佳的热情！”。\n……既然如此……！）",
      "status": "draft"
    }
  }
}
