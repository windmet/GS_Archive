{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_034kan_2_1_8_034_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_034kan_2_1_8_034_02:1_8_034_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6daea0caacfa97e03de0525177947426de79a72c9124d8bb6ef329e064690825",
      "text": "喂喂，醒了吗～？\n早上好，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_2_1_8_034_02:1_8_034_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:34670ab31b83ef14050e96abc6deee1ab88316637078fb1a4f98220256af619e",
      "text": "今天是制作人的生日呢，\n祝你快乐！花音也超～级开心呢♪",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_2_1_8_034_02:1_8_034_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:54010d0d36263704dacdc2b03242ef747c5a25628dfa256f20e2e400fb8f7bdf",
      "text": "人家想早点跟你说话，一醒来就马上打电话了。\n吓了一跳吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_2_1_8_034_02:1_8_034_02:cmd-000016:choice_short:000": {
      "source_hash": "sha256:630f95af37c6e5c5ef0456f9ea94cbcd29f355265565aabed277e42c9c817d14",
      "text": "多亏你，\n我醒过来了！",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_2_1_8_034_02:1_8_034_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:7e4cc6517208aadb6869109c64a6dbd4fdf3d86a264e56d8a6fbda8955c78957",
      "text": "诶嘿嘿。到了事务所人家也会给你好好庆祝的，\n等着哦！",
      "status": "draft"
    }
  }
}
