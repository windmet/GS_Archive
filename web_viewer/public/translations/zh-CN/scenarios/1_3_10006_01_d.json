{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10006_01_d",
  "source_raw_hash": "sha256:645450afab3af7403bd72eb47fafd0dbb5f825e4a3c38a56e92b2c76ee568d48",
  "entries": {
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000037:dialogue:000": {
      "source_hash": "sha256:ef4445361830f9f7d2f110701d9accae9f6f715f2cc4763d322216bcb3261652",
      "text": "那个，我有件事想拜托志狼君。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000046:dialogue:000": {
      "source_hash": "sha256:ed0c84c2dfd74957a1d9037d48e131ed3c7e8f098a4021527eaacf3f2a2fe337",
      "text": "就是要在结业典礼舞台上跳的舞蹈，\n无论如何我都有个地方跳不好……",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000050:dialogue:000": {
      "source_hash": "sha256:ca7fead651e1be26936cd8eced3d6939e576b5d5012ce682e7ca208e2b475a4c",
      "text": "啊——副歌前面的那个地方啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000060:dialogue:000": {
      "source_hash": "sha256:835f73d23b87a2802990a3243ee9bcdabdf3367b1673001e5c98adf4f98f880e",
      "text": "嗯。想让志狼君教我\n跳那里的舞蹈……可以吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000069:dialogue:000": {
      "source_hash": "sha256:44ca7b1dd58746dc1f4ca2bb74257b8eef4643cb86896aaffb83f515ad7deae5",
      "text": "作为替代……虽然不知道算不算，\n我来帮志狼君写作业怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000079:dialogue:000": {
      "source_hash": "sha256:0ad99775a394b1d9d2429a16ae39c3a32f3ecbc4977fcc6efd4f7994f8d43bdc",
      "text": "哼～？就是所谓的交换条件啊。\n嘛，既然你都说到这份上了那就没办法啦。我答应你！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000084:dialogue:000": {
      "source_hash": "sha256:9bae0cbaa9b2f25e81e2170aab1bb09eddd7bd8f6266dec901a30631fed32ec8",
      "text": "谢谢你，志狼君！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000102:dialogue:000": {
      "source_hash": "sha256:57ff279baf8d49756bcb61a87f82114f538ce82604c23f9fcf5830b31b71505f",
      "text": "既然这样，花音也要交换条件♪",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000109:dialogue:000": {
      "source_hash": "sha256:8cfc5b866424836897bf931f278e3f77045f379b88376fc09019c54e0efd62b6",
      "text": "帮我写作业的直央君，\n我就教你超级无敌可爱的摆姿势方法吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000116:dialogue:000": {
      "source_hash": "sha256:610ae6caf91518650dd7739a6a9ba1f98716fc724ab9268a05d2bcebf710b547",
      "text": "也谢谢花音君。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_d:cmd-000141:dialogue:000": {
      "source_hash": "sha256:060a45b5f47e9030c4654992e8d08d98281e2842e81540b41e976b78c65ac423",
      "text": "大家互相教对方擅长的事情吧。\n这样一来肯定能变成很棒的舞台的。",
      "status": "draft"
    }
  }
}
