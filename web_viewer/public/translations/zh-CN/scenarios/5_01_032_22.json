{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_032_22",
  "source_raw_hash": "sha256:3322925fa49bd4bb70b8100d72243685229cf6d9679730afdcd27ba137f3bc0c",
  "entries": {
    "story-text:v1:5_01_032_22:5_01_032_22_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:43e9b00c8c0126942bbdf2604425fa6c3b2119736cb72bf0458e611228a8faa1",
      "text": "诶……这盒巧克力，是给我的吗？\n谢、谢谢你！",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:9861eacebc514e606827ffe1c7a29637357d39338701a51b22a663fa5f044f34",
      "text": "嘿嘿。能收到制作人的礼物，\n我好开心啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:fc14bcd924038f4ab2694540a95286eda53a9de09fcbdbd79bc09a68286b5cca",
      "text": "虽然很好奇里面是什么……\n不过接下来还要上课，等回家再拆开吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:95068ee4ea94d5def5f444769d41424e44bec8f0f428c7462f8e6f0109bab87c",
      "text": "从现在起就非常期待拆开的那一刻了。嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:ba55e75235e2a1165f5009308c8c081fd4ddec495373387ecc063192b78b18e6",
      "text": "那么，我去上训练课了。\n如果有时间的话，你能来看看的话我会很高兴的。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000015:dialogue:000": {
      "source_hash": "sha256:83ce5a37529bebfab0d770750f26b8b9516326bb74b5d7bee6cb8ecfdc0fb44c",
      "text": "是情人节巧克力……\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000020:dialogue:000": {
      "source_hash": "sha256:55bb48d12fb97dfe679b1ab7696c62e519c2e43b417e018a59204787e9e22fcc",
      "text": "嘿嘿，能收到●●●●プロデューサー的\n巧克力，我超级开心。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3cc2bebad06a9ca2ccd37137bb264710f134e44391b5c8b0d648496a5a3a210c",
      "text": "那个……现在可以拆开吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000026:choice_short:000": {
      "source_hash": "sha256:e36a63ad3672ffa7433b237f2e5eece145e4b9c14c41f1224a06fba4f167246e",
      "text": "好呀，当然可以！",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:b113e7d1151de30bb75291ca94d9d4a28d05f8ee9969ec0d586683399a303c9b",
      "text": "……哇啊，看起来非常好吃。\n吃掉感觉好舍不得啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000038:choice_short:000": {
      "source_hash": "sha256:a1f6c577effdeda8a355c1eb5758e0d9453cfc587d075b3422e5a3b53431e7c5",
      "text": "非常好吃哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000039:choice_short:000": {
      "source_hash": "sha256:d61ef14d33c2180041359a378773a623442fbdf296d30b3d56db9d39053022cc",
      "text": "你能喜欢，我很高兴！",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000044:dialogue:000": {
      "source_hash": "sha256:0865b0eca9cb12b6b3ff4a6a8716a833c34640216f924c9343a4cb3747bf5cf5",
      "text": "嘿嘿，很期待吃掉它呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000051:dialogue:000": {
      "source_hash": "sha256:e13ca58b4dde91233caaeddb697bc69d1c3e543456810bb230a8bd42b144a34b",
      "text": "好的，我会怀着珍惜的心情享用的。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000060:dialogue:000": {
      "source_hash": "sha256:57c589724bce184f03fbb133000681fbd6555bedf4b0879e86345646ba927686",
      "text": "啊、那个，虽然还早，\n不过请好好期待白色情人节哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000066:dialogue:000": {
      "source_hash": "sha256:31c99c5ebf1e0331bf26365e9a0ec0bf554c4f5bfdb05b22a31c1a2aea2694ed",
      "text": "我会挑选能让制作人\n感到开心的回礼的。",
      "status": "draft"
    }
  }
}
