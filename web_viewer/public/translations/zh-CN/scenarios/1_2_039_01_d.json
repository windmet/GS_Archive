{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_039_01_d",
  "source_raw_hash": "sha256:c2908f07175141a357f9c1f7e12f7d56b54dfcf76e2a9894ee561d2bdc189113",
  "entries": {
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000010:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "数日后……",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000014:dialogue:000": {
      "source_hash": "sha256:3842e1cfc97b0d030b11ede9dbd641c7c1f092fefbc1380c4456f88bc66e6dba",
      "text": "……以上，就是寻找走失猫咪的来信。",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000019:dialogue:000": {
      "source_hash": "sha256:1ae37348e92225782697a5b58bcc2dfb720a5055b79857e73c49105c072426ed",
      "text": "有线索的人，\n如果能联系失主的话就太好了！",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000024:dialogue:000": {
      "source_hash": "sha256:7910acb3eb0309616bee6cf1eaa762a0dfe1d28ea44e651ab0c6604e2c6ee2a7",
      "text": "重要的家人不见了，一定会很不安吧。\n我也祈祷它能平安找到。",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000032:dialogue:000": {
      "source_hash": "sha256:650d489855c3d23f52a9ef0bef9fd147639843e365ca1653a685ed3aa52cd651",
      "text": "……虽然不算是顺带提一嘴，\n但其实我最近也在找一只走失的小鸟……",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000036:dialogue:000": {
      "source_hash": "sha256:10e1ff4684cdd0d09381f3b3b3b1c0a017a0e9f2ffc39fe56e6e331c16cf2a3d",
      "text": "尽管到处打听也贴了寻物启事，\n但怎么都找不到呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000041:dialogue:000": {
      "source_hash": "sha256:16f92539b6c225989621437ddbd70f26b9e833a28887480e0ec69227b7b7fc49",
      "text": "如果大家身边有人在找走失的宠物，\n希望也能积极伸出援手！",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000050:time_caption:000": {
      "source_hash": "sha256:4f10f377623d30a2f8e6eef9924c2cd8b7962dcbd80ad5f1e46aca35a570d7f4",
      "text": "录制结束后……",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000058:dialogue:000": {
      "source_hash": "sha256:93adc0947748d65e0bfa06b9a95065adee54beae6080349c129e1f5afc920386",
      "text": "●●●●●●●●●●师父，辛苦啦！\n按你的建议，我在节目里呼吁过了！",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000060:dialogue:000": {
      "source_hash": "sha256:aeefb2937106504a27db9254d7536a27bc3b85dc860503a6c7b2d2e6ea13ec31",
      "text": "要是能收到反响就好了呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000066:dialogue:000": {
      "source_hash": "sha256:31fde7de90549428ec1cedf507a3bfbdfb9614496994aec28eb37d6606f60fb7",
      "text": "是的！要是能因此得到\n附近邻居的协助，那可就如有百人相助了！",
      "status": "draft"
    },
    "story-text:v1:1_2_039mcr_01_1_2_039_01:1_2_039_01_d:cmd-000070:dialogue:000": {
      "source_hash": "sha256:8ee718c959ce1dc2c08ddff72fd1f84f06ff3e62cc1056b0783fa6f654914204",
      "text": "我也不会气馁，继续搜寻的！",
      "status": "draft"
    }
  }
}
