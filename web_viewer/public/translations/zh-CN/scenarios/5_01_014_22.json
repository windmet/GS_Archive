{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_014_22",
  "source_raw_hash": "sha256:67116bdcb85e77bf7041125ab66af7d307dcd63d465657b954fb72aaab2f5d40",
  "entries": {
    "story-text:v1:5_01_014_22:5_01_014_22_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:4eb43045ee94c7de7170f3ad437834b549a031a1a4deb4942e52191ea3736474",
      "text": "这是情人节巧克力对吧。 我超级开心。谢啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:594f42fc90215d31bb80111e267a44f2ababa8ee043358d94002db30411ece34",
      "text": "最近这段时间，不管出门去哪儿都能看到 摆着看起来很好吃的巧克力。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:d37696a3b71f078b0959947261a4355dfd0ef05dfb4d0cd35a2bea8bc40202b6",
      "text": "因为经常看到，能收到你送的我很开心。 而且这还是情人节巧克力吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:4f002d8c8c440a9052ef7c1a0f7bc5e16467f37923900436fcdb0d87f7e67640",
      "text": "毕竟我以前就连人情巧克力 都几乎没怎么收到过啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:d4e96ac0a62d30a39fb052060baafcce55f6cc7c9e62573cb726c77636e7463b",
      "text": "白色情人节我会准备好回礼的， 你就满怀期待地等着吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000017:dialogue:000": {
      "source_hash": "sha256:ec196e89eb6b30f89a5ef402d4adf02fe75ff657ea87550b8c4d09337a0f8b2c",
      "text": "欸，这个是……情人节巧克力吗。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:0bfdd75fd31cda60bc6689a72fd279f1ed6fe3e25455d44b6da042dcccb78dd6",
      "text": "●●●●プロデューサー，谢啦。 我超级开心。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:04a03e78ac00936f042437ea3a2e930a60dfa50c1571f651bd08f94252a07ce6",
      "text": "没想到你会给我准备啊。 不，想想你的性格，确实会准备呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000031:choice_short:000": {
      "source_hash": "sha256:78e82f9718ed101147ea1c9e3fb5820f1c9906b70562d32919d9810a3cec907a",
      "text": "我在里面注入了PASSION！",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000032:choice_short:000": {
      "source_hash": "sha256:22eeeb7064a4200d49ca932877c24a67994e9aca65588e1447c64186d19ac6aa",
      "text": "我挑了您可能会喜欢的口味！",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:80d4d8704b125c79df2f57e0912006f46105ac099ab9a5046e28344d2804a7d6",
      "text": "那吃起来还真让人期待啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000045:dialogue:000": {
      "source_hash": "sha256:f0479e82398f92cf2f9cf3317d9dff401a46836b78c906afc9f3096d2366b688",
      "text": "哦，真好奇是什么味道啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000053:dialogue:000": {
      "source_hash": "sha256:39e0231934e3f9a991b8aa69f2d6e98406951cac984b5297b53b7131f242544d",
      "text": "你这种体贴周到的地方， 我真觉得特别厉害。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:beaea377f1a9ef614fcc61966b5ac0b58523795e99472f80d71e20972937d675",
      "text": "这份巧克力，我会好好品尝的。",
      "status": "draft"
    },
    "story-text:v1:5_01_014_22:5_01_014_22_b:cmd-000062:dialogue:000": {
      "source_hash": "sha256:e0744fb5eca97bef9a9d13a4570da4ff22bcb44635e400dedb091a1df468ac91",
      "text": "好好期待白色情人节的回礼吧。 我会去找找能让你开心的礼物的。",
      "status": "draft"
    }
  }
}
