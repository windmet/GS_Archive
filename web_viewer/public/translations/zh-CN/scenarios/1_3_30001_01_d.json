{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30001_01_d",
  "source_raw_hash": "sha256:e398adf12581c9f63fddc6e6f679290fad998927871bdc2b7c153d679ebb7172",
  "entries": {
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000018:time_caption:000": {
      "source_hash": "sha256:4645244d29e9480ea2c2827a809a17a17c95d652212af0f3e03b16f43a8ee563",
      "text": "喜宴当天……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000029:dialogue:000": {
      "source_hash": "sha256:df6f3cea1618b3b72e0d361f29a483136c46c18f4c53ccbea2ef1acce6ce3c6f",
      "text": "原来喜宴是在这里办啊。\n相当宽敞呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000034:dialogue:000": {
      "source_hash": "sha256:f0eee5ddc1e1f79c9bc01aaa9c9c5d77869e7e175da2612dd6c778134c0d5630",
      "text": "好热闹！\n有好多客人呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:8491ce737ed2e7c66f6477501cd99715495aa76b686be23aa65cd6f57aaa5bda",
      "text": "……感觉面相凶狠的人挺多啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000045:dialogue:000": {
      "source_hash": "sha256:4e6f6957efd1d20467ccc1d555ec16e2a331ee9beb4d553aa1e933801231d6f1",
      "text": "呵呵，确实呢。\n虽然大家长相挺吓人，但都是好人哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000054:dialogue:000": {
      "source_hash": "sha256:9b87a85159589e65d89b185bf26bb4edc0b8a82eef455881d76deea6930731cf",
      "text": "嗯！刚才我迷路的时候，\n他们给我指路了。大家都很温柔！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000071:dialogue:000": {
      "source_hash": "sha256:4a5607c5dc9af31d0b622d255e085efe3e2ce89527887fba5819be95be139e4b",
      "text": "啊，实先生，好久不见！\n听说您以偶像身份出道了！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000074:dialogue:000": {
      "source_hash": "sha256:9a8d52d945f70db99e0d5ecfa001462809f3d0f256e47a3ce8ea45a20dcbee56",
      "text": "实先生做的事果然还是那么帅气啊！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000077:dialogue:000": {
      "source_hash": "sha256:c1b6eb516f3221937282c620e0d8b49d14de4e38e765047782a24dcaab986218",
      "text": "实先生不参加婚宴吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000080:dialogue:000": {
      "source_hash": "sha256:f39e19eb99f5b096959d2f71ec9e337fbb22c02921cc2f9f7b5c3304527e9288",
      "text": "嗯，我稍微有点……对吧？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000095:dialogue:000": {
      "source_hash": "sha256:89a662a632fdf15c34f32ce2c2fcf6673e28b7b00583b779b2715e83c254e5b9",
      "text": "（……实先生很受人仰慕呢）",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000100:dialogue:000": {
      "source_hash": "sha256:15270a453b50a39a9eb1d3afce83299902ac745cc684d1135c2a2efb41e1e6cf",
      "text": "（想必在这里，\n他也曾是大家值得依靠的同伴吧）",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_d:cmd-000133:dialogue:000": {
      "source_hash": "sha256:2aa47f85dd048fcbb089f4dedec08cf7b012c0bed6710dbe2f61845aee03e979",
      "text": "让你们久等了！那我们去休息室吧。",
      "status": "draft"
    }
  }
}
