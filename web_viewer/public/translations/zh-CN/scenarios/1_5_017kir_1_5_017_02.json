  "entries": {
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000010:title:001": {
      "source_hash": "sha256:ec462080db94b6b614a93b3454cbbd75ff0c1f931ac8fec046f6777a0d808f5c",
      "text": "出演猫粮广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:c5e6f27bd6c5691a4f4f6b5ba5eded71ccadee44c39310d4db24bf8ac2604a00",
      "text": "喵喵喵～。\n喵～喵喵，喵喵～♪",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:c42b681d7e3718ed623c93ef3dafe716835ef6199bb0bcd103b35917e26d61eb",
      "text": "喵～喵喵，喵喵喵喵～♪",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:b6459b57c6e72bdc1a2a1763a5be64136923b4f0a4fffac5e48df7b31967beff",
      "text": "一下子就和搭档的猫咪搞好关系，\n桐生先生，真厉害！",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8fc9f67b334aebadf953edc770aa25ac224587a9b0a09d62f672d4674d435af6",
      "text": "呼呼呼……\n吾辈也没有那么了不起啦喵♪",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:5e3386728e28918614df824206146dbeb964fdd21dda1c886d0c49c78e486edb",
      "text": "吾辈擅长形态模拟，\n这点小事简直是小菜一碟喵。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:c82232d8afe11069f8f76cb33510a11121ada500ebb05271232a9742794d2409",
      "text": "呵呵，真不愧是您。\n桐生先生的话，广告拍摄一定会大成功的！",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:e5b555f24fa8cedd2fa4aefd05e4341189e03a442da94581b9c797abd177cb42",
      "text": "那是当然的喵！\n一起加油喵。喵喵喵～。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:c49d65cbbb6ecb1ad27e90f321ea48332ea44534e2f38113207022a7f433fe39",
      "text": "喵～。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000062:dialogue:000": {
      "source_hash": "sha256:350bf49fc6f6c2ddab0568eba43f670e546aca664991458345e7b74c97d61fd3",
      "text": "喵喵！？想吃猫粮了吗喵？",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000068:dialogue:000": {
      "source_hash": "sha256:26280a08085183525a226b13cfdf490d0f26d3a211cac3b72487eb80318bc1e3",
      "text": "虽然很想喂给你，\n但这个要留到正式拍摄喵。",
      "status": "draft"
    },
    "story-text:v1:1_5_017kir_1_5_017_02:1_5_017_02:cmd-000076:dialogue:000": {
      "source_hash": "sha256:03faae7a75345bfb0ac005daa6adc5390d225559d3be0ca05106ecd1e80f58d6",
      "text": "要是拍之前就吃饱了可就麻烦是也。\n换成跟吾辈一起玩好不好喵♪",
      "status": "draft"
    }
  }
}
