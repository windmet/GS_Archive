{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_012_01_e",
  "source_raw_hash": "sha256:40a84e02825d034610deb52c0330a1cd67b00ec0f2a1829b2c7f2f6e15372c32",
  "entries": {
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000022:dialogue:000": {
      "source_hash": "sha256:4d804d0b09c883b3f2c70856ae92573a4de9b8caa516d6963f6a87366d00c7dd",
      "text": "正如舞田君所说，我刚才\n已经辞去了教师职务。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000033:dialogue:000": {
      "source_hash": "sha256:1854b99efe3091cfc35f42ae70cad94d78cd464a11b063598158e5d62c29c5c5",
      "text": "辞职了……这也太突然了吧。\n发生什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000048:dialogue:000": {
      "source_hash": "sha256:c966d5c3901816319f77aac92151b3ee312633b13a05c87f7278f23c8bd3d035",
      "text": "嗨嗨！Mr. 山下！\n我也是和Mr. 硲一起辞职的哦！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000055:dialogue:000": {
      "source_hash": "sha256:3fdd58c8b46c305b5b81a234f43f8b0a8cf26832a3ec1228bd690ef7cdcd7ad4",
      "text": "啊——是，舞田类君。\n能问问理由吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000059:dialogue:000": {
      "source_hash": "sha256:b0abe6aeb34430b53608009cef15317e0e8603f631ec1c07baa06d1ee44648f6",
      "text": "因为那边看起来更有意思嘛☆",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000063:dialogue:000": {
      "source_hash": "sha256:c41464fe4a4863f1643ef1539b22af406d54b587057ba248db081b7b62a871f3",
      "text": "……我就猜到类会这么说。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000076:dialogue:000": {
      "source_hash": "sha256:07bf5c8ced97b9caac4c69f5a5759c01d3cf40bcbc2994bb72480813930a4f9f",
      "text": "跟着一时兴起过日子的类先不谈，\n为什么连硲先生也？",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000086:dialogue:000": {
      "source_hash": "sha256:3770b0d679387d2395f8de7023d0a5033e97e97e7a85c50705f7b12b15d583f5",
      "text": "啊，我本就打算找机会和山下君\n谈一谈的。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000091:dialogue:000": {
      "source_hash": "sha256:c359be696e1e63c9bd031c0c4ce19a85027ee0e649a68ae510016ee168dbc189",
      "text": "前几天，不是有叫Jupiter的偶像\n来参加我们学校的文化祭吗。",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000100:dialogue:000": {
      "source_hash": "sha256:669d5082c38b175b7d7cf4f311c6715bc96b634f80226e6c4b08b4c5d93b0b09",
      "text": "记得说是类的朋友当偶像来着吧。\n还给我们办了Live……",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_e:cmd-000111:dialogue:000": {
      "source_hash": "sha256:1bbe6584b9e0126faba768e4a50a7b900d3c355d8c94983f5f64412d82fd0791",
      "text": "没错。……正是那场Live，\n让我意识到了。",
      "status": "draft"
    }
  }
}
