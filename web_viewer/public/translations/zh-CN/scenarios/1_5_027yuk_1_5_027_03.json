  "scenario_id": "1_5_027yuk_1_5_027_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000010:title:001": {
      "source_hash": "sha256:1c34ad1b9a4d86583d52094d2b6b1304bef5e8556b4d180d1bbe0fc9ff0e4634",
      "text": "红茶CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000015:dialogue:000": {
      "source_hash": "sha256:90963d4bf49fa411aa786c109fdbe4b097655af4530604ed86d170e232444bce",
      "text": "幸广先生，让您久等了。这是\n您下次要出演的红茶CM的相关资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:78be5280b559ac293db0c4ec90ecb4e88e72d0dae11c455bd58787da8012a0b7",
      "text": "谢谢你，●●●●プロデューサー。\n我马上过目，能稍微等我一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000030:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "数分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:9ea974e020a44153c2dd6b317c4d7aa71c572fe024acf33dcf99b1adbc9f6585",
      "text": "……原来如此，是剧情短剧形式的CM啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000042:dialogue:000": {
      "source_hash": "sha256:442ce2d57991237471c6052d7ba71bb848e0f452bc1505bc7a26cdb64e4cf8a0",
      "text": "幸广先生饰演执事，为暗自倾慕的\n大小姐冲泡红茶。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000045:dialogue:000": {
      "source_hash": "sha256:8a83ef1a0ddfa578e40195d2956160e081c44ce7e6eb30d8e6a9ddbbda539ca5",
      "text": "而CM的理念则是\n“为您奉上极致的一杯，与极致的时光”。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000049:dialogue:000": {
      "source_hash": "sha256:8e33d4177fe92d10218a65a91669f3d50cf64401d5b484fa8daa3bfb178656bc",
      "text": "很棒的理念呢。我泡红茶的时候，\n也总是想着要提供最极致的款待。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000053:dialogue:000": {
      "source_hash": "sha256:08e5d732d96c1d555938c3dd8be4120e73001d03fa4e060f2e4b71ea8a59f5c7",
      "text": "红茶如果茶叶的量或者水温不够恰当，\n风味就会大打折扣。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000060:dialogue:000": {
      "source_hash": "sha256:63a367af4b6759e7a9c9b0afdbb25cc575d8f38487e6ff3cfdbe2bb23d56adeb",
      "text": "焖蒸的时间也很关键，只要差了一点点就……\n抱歉，一不小心就滔滔不绝起来了。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000064:dialogue:000": {
      "source_hash": "sha256:a4869c0a8e918ebff9d4c57a35130545803a6748b9f4889cec07a51b9bc458bc",
      "text": "有自己的讲究是一件好事呀。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_03:1_5_027_03:cmd-000068:dialogue:000": {
      "source_hash": "sha256:0643038d950b23dc3323421ab572db2e564a487e3bbc32683aa5feaad5c0e69d",
      "text": "嗯。为了能让更多人领略到\n这款红茶的美妙之处，好好加油吧。",
      "status": "draft"
    }
  }
}
