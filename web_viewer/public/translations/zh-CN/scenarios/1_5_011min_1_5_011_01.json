  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000010:title:001": {
      "source_hash": "sha256:6922ac721f92fce087276c236508367c866c775ab375be03bd994bf9e0dff510",
      "text": "旅游资讯综艺节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:c3d32888f1f080406c71cb1e975cc701213d2708698a803d19fa2e3a56cb075e",
      "text": "实先生，今天我们要去录制旅游资讯综艺节目的\n外景。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:5551fd29698b1ad6e8c4651f323f49acbcddb756587aade4b61b18a35f554210",
      "text": "是骑摩托兜风顺便去打卡美食景点的\n企划对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:7200fe871e599738c7469b9a6b155f207dc891f029906024aaac299a6928454e",
      "text": "是的！实先生很喜欢摩托车呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:bad4165c7c2c5203ecbab65d27f6fb6859b4be5ecfbeb125428e2cff430d089f",
      "text": "嗯。摩托车自不用说，兜风旅行我也很喜欢哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e83b22751fea9792a72d6521a21a0b6bc28ef3a0d76ed9bda7f95934995b635d",
      "text": "所以从接到这份工作的时候起，\n我就一直很期待今天的外景了。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:9d41201ab6aa172cac314fc0cf5a8272d7e4d4faf492e22518164dada74a6f91",
      "text": "既能转好多地方，\n还能吃到好多美味的食物呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:fe5dbdedc97fd95a65e6cacd56c53e50f5c59bf227d114a269d68e955bbe25d9",
      "text": "把外景的事告诉恭二和皮埃尔之后，\n他们还对我说“听起来好棒”呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:d231319ce4192bef5b02e4a8001452fcfb85942b1bd5dbc3d9c8fdcd7e0376bf",
      "text": "我已经答应他们，会带好多见闻回去跟他们讲的♪",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:b5b888ab242cfe78702d05d655b291947649d25c96397ff524438a2e3ccda703",
      "text": "呵呵，Beit的各位感情真好呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_01:1_5_011_01:cmd-000050:dialogue:000": {
      "source_hash": "sha256:5d927ef2da875f917c159a7afa92e70266fa6f9ccaca711f2fdd9c44c147fdd9",
      "text": "是啊。和他们俩相处时间也很长了，\n对我来说就像家人一样哦。",
      "status": "draft"
    }
  }
}
