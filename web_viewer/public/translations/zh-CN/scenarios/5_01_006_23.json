{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_006_23",
  "source_raw_hash": "sha256:8ac8929c3e8c4a9ef26793a19958d9e13990e701d2f2ea18fd2bb965ab1554c2",
  "entries": {
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:a796ecdb234cf88584e8a3dc679b9795f57f80cb77d43ea0d393def1601da21e",
      "text": "啊，●●●●プロデューサー。\n辛苦了！",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:85ae7fd570564789cfdcc3d5760478b9905f75c5063c73d64705f9a68f2932ed",
      "text": "因为有话想和制作人说，\n我刚才一直在找你呢。现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000028:choice_short:000": {
      "source_hash": "sha256:b111dd6c417007e7a7eb39cd6ff35602bec246aa4732d5b987bc46f10cb06b39",
      "text": "表情这么严肃，是发生什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000029:choice_short:000": {
      "source_hash": "sha256:f92b424df65a3e64dcf06be95dc9b1ca7d9203c353f4d06fd348fe2cb69566dc",
      "text": "好的。请问是什么事呢？",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:7103a010106085c64091effdfc82d25fb4a75ee85e2c5b0627a3c2b5b24ce306",
      "text": "那个，情人节收到的巧克力\n非常好吃！",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:84e512dbd678d6b620dbad3664c466b1abb865573fe07c367785717a00c3417e",
      "text": "今年也是我喜欢的巧克力，\n一转眼就被我吃光了。",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:f49f80d55b403c5424af7eab5522d9c7bbe5e90acdb10146816f6edc13f79d41",
      "text": "像这样跟你说话的时候，\n脑海里还会浮现出那个巧克力的味道呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000062:dialogue:000": {
      "source_hash": "sha256:50a98acbb4d7a0989001365611b01be90dc2a4f1894277d21dcbb116ddc75754",
      "text": "呃，一不小心我自己说了太多……！对不起。\n我无论如何都想向你传达这份感动。",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000067:dialogue:000": {
      "source_hash": "sha256:88099d5ccf0189589d3b0026cb839c92793c14db88d712430f30b2aa153e2525",
      "text": "还有，我也真的感到非常开心！",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000070:dialogue:000": {
      "source_hash": "sha256:7bd03e620e6b037f0504d56b92e3a771bdba0dbef009ea54d11ac36619fb937a",
      "text": "哪里哪里。得知你能这么喜欢，\n我也很高兴！",
      "status": "draft"
    },
    "story-text:v1:5_01_006_23:5_01_006_23_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:bc0149911463885b576869eb94d0c4df19e7ccd4b24f58e3dc4d56bc0c22e507",
      "text": "白色情人节的时候，我也会准备一份特别的回礼的。\n请一定要期待哦！",
      "status": "draft"
    }
  }
}
