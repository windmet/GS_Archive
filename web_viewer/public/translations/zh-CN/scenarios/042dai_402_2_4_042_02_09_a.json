{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "042dai_402_2_4_042_02_09_a",
  "source_raw_hash": "sha256:964046673d42b6520f5340903bce695b4ccb483da47587bda0e53fc7dbedb3a7",
  "entries": {
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:0a1b6239c12de5d9fcbbb100749b8d1647946cc7f5871470d752e9a672e2ce13",
      "text": "喂喂老大！\n现在方便不？",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:eece43d5c0f3fffb2c271614cc3849926790d8c9ac80738aa3ffeabdddfda41b",
      "text": "前几天的活动辛苦啦！\n超好玩的啊！",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:764458258a17c709b8f3d7b66a0b7f6184310a8f7a4bcfcda322ddf88eb2ce0e",
      "text": "要是能再和春名、英雄还有想乐\n一起工作就好啦。",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:9603b612cc4d5fab169dc623b6fa16dbd2e372c52ccd24514be334ce1b47c4fc",
      "text": "和大家一起做点心，\n也是一段美好的回忆啊。",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:a5484161644aac8df587bb1a959fd613432c2a39b9924d461df3b7411eec256b",
      "text": "英雄和春名手都好巧啊！",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:64281955db38c1bde147ab3b01426c575a8d31d847f83bebce7203cb26a4e0f9",
      "text": "俺也学着凉之前在饼干上做的那样，\n试着用糖霜画了画……",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:e47fbdf1042632b1bab2c2554e8253efb2b9cbd8cbdc68e072ac87064cfde960",
      "text": "果然还是画不出凉那种水平啊～",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000020:choice_short:000": {
      "source_hash": "sha256:481f7c36fc67219730809c43170e3973fc46d051e4e9b7b57206ac7de12cf448",
      "text": "展现出了大吾先生的特色哦！",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:98ae4a745055ed7d4771188738d9028b38a72cf55e0a1f9bba58054ea234ce06",
      "text": "非常棒哦！",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:5565dcce8ac6dbf8f0789b577f8754cc7c749c4df181e8cf065fdf9f094db5a3",
      "text": "是吗？谢啦，老大。",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:99bf710e9e3262cb365f105cc2022685920566f146c74080d2c3f9955bf849cc",
      "text": "下次俺打算给凉和老师做马卡龙。\n由俺送给他们，他们肯定会吓一跳吧？",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_a:2_4_042_02_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:67f9ce0c93f2b0f0a3f892bb354c1cd2e4cf410fdee012e637a09f6b67c09c6f",
      "text": "老大那份俺也会做的——\n上面画了什么画，你就好好期待吧。",
      "status": "draft"
    }
  }
}
