  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000010:title:001": {
      "source_hash": "sha256:32c2354ab27e119a5673aa32c4e4c1a08c48046bac367e3e4f1fcf9f98e4076c",
      "text": "出演矿泉水广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:14c42f765b429e0b5a4854a877ba56d61764819c932fa7c79899d872586edcf7",
      "text": "是矿泉水广告的拍摄呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:f9548a9d08c24bfdcf4521d7cf53a0b271cea01c2cb19902c80c0661c4ed2473",
      "text": "虽然我不太分得清味道的区别，\n不过拿到的样品很好喝哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:3d7acd33ea86383db93358fc88e60c2c5444a6b362a20edde4c49adcdc3156f4",
      "text": "那真是太好了！\n转达给客户的话对方一定也会很高兴呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:121eb9464ed3205c82aab858a54a0e93a59cf40e5f0ea2bb91218e8b8d48adae",
      "text": "广告的概念也很棒，\n真让人期待拍摄呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:5d5ab9f4436f6ccb8db7f961d8c7ff98b785980651ed23356f3da22462dc8319",
      "text": "那个……我是不是不太需要怎么动来着。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8a85579a716f6b492e9f8281de80b80f370bcb4f79b91ea0730993f3a3f311fe",
      "text": "概念是水从山川流向大海，最后在圭先生的面颊上\n滴落下一滴水珠呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:a1d6012478fcf6616380527d724330b9a6893095e3d1ecdf8a5bfb3d84832ac1",
      "text": "动作太多会很累……真是帮大忙了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:8a0072c158f89421bbc1f5d561f0ca8696487d7c5083f7065f12dfb59a14fd6b",
      "text": "为了拍出优秀的广告，我也会努力的。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_02:1_5_007_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:1910df61045b11756dfb8300b85118c117eeae0453b7a575e20d329b0c083285",
      "text": "好的！那就拜托您了！",
      "status": "draft"
    }
  }
}
