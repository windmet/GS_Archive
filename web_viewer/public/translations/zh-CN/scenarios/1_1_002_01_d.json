{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_002_01_d",
  "source_raw_hash": "sha256:a686a6230dbc40c2197afe5bb6149008db4826e0636f986d21d5bd0b03eb8f28",
  "entries": {
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000015:dialogue:000": {
      "source_hash": "sha256:0f6b06a292d42beea1d271992fef2f068c24ddd04dc4b286bd25dd46e6ba9549",
      "text": "作业你完全没动笔对吧？\n既然这样，我来教你解题方法吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000018:dialogue:000": {
      "source_hash": "sha256:e62ec967d5e82cd165f0fc87621a5aee9899803818071585251e7e941254d9b3",
      "text": "反正午休还有时间嘛。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000020:dialogue:000": {
      "source_hash": "sha256:2c2a586ad810239e4dceb95f9347cd1919c095d25ddf6996a5cf44ab88a2187e",
      "text": "真的吗！帮大忙了！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000026:dialogue:000": {
      "source_hash": "sha256:6e03f4fdff5ba580d03902b35f32760091bec0a725c5eeb6e53a4bd8d7afb7e8",
      "text": "咦，天道要教大家功课吗？\n那我也能拜托你吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000030:dialogue:000": {
      "source_hash": "sha256:fcb21aaf4d9687661004c87966360e6f40ad41fdcecc1998b257faab082ae247",
      "text": "啊，还有我！\n这道题我怎么都搞不懂正发愁呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000035:dialogue:000": {
      "source_hash": "sha256:8b1f9b28c0eeee3d8a7de227ed52f60b3c6ecc5edd7a621a489577d3add658dc",
      "text": "好——嘞，那大家聚过来，\n我一口气全教了！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000046:dialogue:000": {
      "source_hash": "sha256:69b0c1a9205d4b41f269484b8932714f8019705ca34f54539a20dadbb1f03a73",
      "text": "天道真厉害啊。学习这么好。\n将来想做什么，已经决定好了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000050:dialogue:000": {
      "source_hash": "sha256:75fa6a547704b83f09dbcd5329cba5166a3e2ee19a1975374e8946223314b642",
      "text": "诶？这个嘛，虽然很难说……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000055:dialogue:000": {
      "source_hash": "sha256:94e3dbf02664224621614523bbf3cfc9a0949dd01e2ec055ea37656832561d95",
      "text": "……想为别人派上用场。\n这种想法，我一直都有。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_d:cmd-000064:dialogue:000": {
      "source_hash": "sha256:4f4dab694964b1a9fde4bca628ed854cf76c3bec10037d3b285be592cec54a1a",
      "text": "所以……想成为帮助大家的正义伙伴！\n大概是这样吧。",
      "status": "draft"
    }
  }
}
