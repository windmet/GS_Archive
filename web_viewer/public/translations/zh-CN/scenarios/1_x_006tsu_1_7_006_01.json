{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_006tsu_1_7_006_01",
  "source_raw_hash": "sha256:f870f7c953860c77822b619e789c069005800c6203e4aca5992114b66534e090",
  "entries": {
    "story-text:v1:1_x_006tsu_1_7_006_01:1_7_006_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:6b1977bbd79c8bd33860c7b981f1ebfbe51b55614adbca842950a6ebc205d70d",
      "text": "翼先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_7_006_01:1_7_006_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:d4ad872d0a7027ac44f27c9e2f828526534654748ff1eebbc8a7a4839e1fd65e",
      "text": "哎！？啊，非常感谢您，\n●●●●プロデューサー……！",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_7_006_01:1_7_006_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:27ceec7c4e092f18369997d2c6a6d49460f1c88e0e337eb233ee442eba97656c",
      "text": "不好意思，我没想到您还记得，\n吓了我一跳呢。啊哈哈。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_7_006_01:1_7_006_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:108c3027f8cf91b3cf92f41e91cbca56cc6efb2c0701115e6a24a5a8eabe7f14",
      "text": "那个……能收到您的祝福，我真的非常开心。",
      "status": "draft"
    },
    "story-text:v1:1_x_006tsu_1_7_006_01:1_7_006_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:765345f9f2d8cb024c79458d67266a7378675e68e0124c31fb4aa22a0644d239",
      "text": "等到了●●●●プロデューサー的生日，\n也请让我为您庆祝哦。",
      "status": "draft"
    }
  }
}
