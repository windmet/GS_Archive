{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_034kan_1_7_034_01",
  "source_raw_hash": "sha256:0c1c299c30ed69dc690fefc9cb743a2cad10926264b127dde822b457a54b62cd",
  "entries": {
    "story-text:v1:1_x_034kan_1_7_034_01:1_7_034_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:c950e3ac640b26077e649f6bad3fe12a4c3fab364e50f599126d7c7e470cce7e",
      "text": "●●●●プロデューサー，我告诉你哦。\n那个呢，今天是花音的生日哦。",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_7_034_01:1_7_034_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:f51604826f7dd58b3b730bb47d1aa6cd8ebc4f79ce2ee77a0c0e46d2cf55b2e9",
      "text": "祝你生日快乐，\n花音君！",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_7_034_01:1_7_034_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:b5b22f991739a45761f16c4f96d3b3f4516d534d88e3f6f178ab9dbde4bcc71e",
      "text": "诶嘿嘿，谢谢！超～级开心的♪",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_7_034_01:1_7_034_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:b9d1a347ec4b32d11afd6884052602d644ea53f22bf69d4b0e385e2affc3924a",
      "text": "●●●●プロデューサー。\n今天多陪花音聊聊天嘛♪",
      "status": "draft"
    },
    "story-text:v1:1_x_034kan_1_7_034_01:1_7_034_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:60646a615259f67c32d4128f17ba5731e62dfe687d16e9b276fb5ce716f79e2b",
      "text": "人家有好多想说的话呢。\n唔，先从什么开始说好呢～",
      "status": "draft"
    }
  }
}
