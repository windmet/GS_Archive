{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_005kao_1_5_005_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000010:title:001": {
      "source_hash": "sha256:0841fa43309335bc89435229862d84004e9add90b31a90ef1d3023d2d37a4487",
      "text": "高级公寓广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:6761a1384178fb8170fe7f34de15c84f3e123392002d558c75a285c5fce39321",
      "text": "这是下次广告拍摄的资料。\n这家企业在公寓建设方面很有名呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:788288d35b31203892feb830e097c2b4b8e6e0e5a955d195c460b6083719a7f3",
      "text": "商业设施、剧场，还有公寓……\n是要巡访这家企业打造的建筑群吗。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:1ee9452625d369189acaca1aa43bcd175b24290895876658c529079683657b36",
      "text": "是的。主题是“休息日，你会去往何处”。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7c4e1c4615b3683b9070846799e7acc4d6f07901f10adf8e5e1f5616ab4f56e6",
      "text": "辗转于东京都内的商业设施等地点，傍晚时分\n回到公寓的大堂门厅……",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:98f7c360d62ef4f94d9710b0381827431c48088a62ed56fa98cb21cdb492cb60",
      "text": "是带有一点故事性质的构成啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ff6c410afbb3f519d9cbd0fa1a5a5ba6d597cfae087a42d9815b5c80a4058abf",
      "text": "在公寓前拍摄结束后，会借用公寓的\n一间房间进行最后的拍摄。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:7986242cdbf1a5a8494d1782cf5c61f1a04c08de35420cd2208b7b2c66aee24a",
      "text": "夜景的拍摄吗……看来从早到晚都要搭进去了。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:5ed163073356dc8f5fc25753aab4b4b4b33894818fab57546ca587c56d5ac2ff",
      "text": "是啊。\n算上等待时间，预计要花大半天以上。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000047:dialogue:000": {
      "source_hash": "sha256:3b1ccce89ec16f7318bc1e2a4f2f428f331bc2b493c4e9e19424dc06d1fc53db",
      "text": "为了让拍摄顺利进行，\n我会把身体状况调整到最好。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:bf05d714096a7e71beb37c4f471584877e1c9e358048f6c9a2f5eeb77b6d0d24",
      "text": "为了拍出一部优秀的广告，我不会吝惜努力。",
      "status": "draft"
    }
  }
}
