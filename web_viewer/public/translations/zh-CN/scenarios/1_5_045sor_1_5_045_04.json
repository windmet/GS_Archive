  "scenario_id": "1_5_045sor_1_5_045_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000010:title:001": {
      "source_hash": "sha256:b9bc37413ea33705296d5e9d94a7586eec8e0c6fb39f6441087efdf01425d78a",
      "text": "单人旅游节目中介绍日本名胜的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:a91c6fdc71ec53ecd9811a9788e0c37ae5b0ef4f7d3e0e4c5ecd886e33741b0e",
      "text": "欣然启程路，心潮逐浪高。\n马上就要到录制现场了呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:6edc7536802b19ec8082168836e4cb1ac3f599e07dfc8554fa90bb45ac62c4e5",
      "text": "是的。今天录制单人旅游节目，需要想乐先生\n去报道日本的名胜古迹。",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:d7906bf4f90fee03e9ca0b276520e0aa3f1826c2aace5e3676b838d29124f916",
      "text": "想乐先生经常一个人去旅行对吧？\n这次的外景地以前去过吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000028:dialogue:000": {
      "source_hash": "sha256:77e80a8e6ca093401b596c89325519f1840e6e33affc7a7582acbdcfe4d7582b",
      "text": "没有。虽然一直想着什么时候去一次，\n不过总碰不上机会呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000032:dialogue:000": {
      "source_hash": "sha256:f982c8fa5e6a226ed9b156e9492437cd925ad519dab06ae2252e4477be887b33",
      "text": "所以自从听到这个工作起，\n就一直非常期待呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:e2c74cf9a9100b98414c97db3edf1ecba5e83660334e41ac834cf36bfebe1375",
      "text": "听说是个自然风光丰富、\n景色非常优美的地方呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000042:dialogue:000": {
      "source_hash": "sha256:9c2a059bc87eb6845518d2aea4857b25b537c17731926825de4dc0d89fb72535",
      "text": "我想●●●●プロデューサー\n也一定会喜欢的吧～？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:3d1f617476711129d0c369c8657a6fd117af34c1fbd3574cad2c1cebd637dbe5",
      "text": "呵呵，那真让人期待。",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:500108800b9b1b77ba398a8eb307362f329701f6e12f609aa205053610979369",
      "text": "节目大概只有15分钟左右，录制本身时间很短，\n结束后去散散步也没问题哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:781f5df5140d485c4ed9380562ea0e699604df0f761f435b3b88838897ebc80b",
      "text": "谢谢～\n那我就不客气地去到处逛逛了～",
      "status": "draft"
    }
  }
}
