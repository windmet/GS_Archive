{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_023har_1_8_023_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_023har_1_8_023_01:1_8_023_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:9e6cc46e14c4774532ae03ad60dd61c1051512c6aba7da5fbf1c124b3215194b",
      "text": "这么晚发来真不好意思。\n●●●●プロデューサー，\n生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_8_023_01:1_8_023_01:cmd-000011:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_8_023_01:1_8_023_01:cmd-000014:mobile_message:000": {
      "source_hash": "sha256:6cc229369b2be40fd56fc9a2d7a12248ffc164d222548e56f148dc3680ce83b5",
      "text": "太好了！本来想零点\n一到就发的，但打工\n弄得太晚了。",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_8_023_01:1_8_023_01:cmd-000016:mobile_message:000": {
      "source_hash": "sha256:9a66c5f4adea6455e35338e63eca6e9da1579e1951dfc7b87eb70f044a6fc83a",
      "text": "虽然想着要是吵醒你\n就不好了，但还是想\n先跟你说句生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_023har_1_8_023_01:1_8_023_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:f94568c14fb4f82e7b9a11fdb158609cbb5f69506bc04f8a05698db51241363d",
      "text": "明天……不对是今天？\n我会带甜甜圈去慰劳\n大家的，好好期待着吧◎",
      "status": "draft"
    }
  }
}
