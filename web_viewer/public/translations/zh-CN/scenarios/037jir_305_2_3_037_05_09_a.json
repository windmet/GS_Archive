{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "037jir_305_2_3_037_05_09_a",
  "source_raw_hash": "sha256:13062b947ce13e3542e67cc89be3b5acefa262f60aaff1e47c6fdee2221c6323",
  "entries": {
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:24d194a07814def647d7e0100a2ec8132b622a7838a6f2d94de3dbb9bfc62733",
      "text": "喂喂。\n是我，山下。",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5063a0217a48ade9a760ed1c493d5bacb78d65220fa56bcd94194c0738befab3",
      "text": "今天MV拍摄辛苦啦。\n现在方便聊几句吗？",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:3bae49df01ecc834c971f0ddfd2660b6a5ff465dcfa9e42504c78f3774111ff7",
      "text": "那个MV拍摄用的布景，\n真是豪华呢～。",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:7d6004e3d30d37c915e9aa6c0c7b64d664c1c78c35cee03569c4ccd83eb5e905",
      "text": "那一套得花多少钱啊。",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:0c8065fef3aeacc06ae7ddd775feade257eaf0de21a6675e0368fccf3ad25a99",
      "text": "啊，服装也很帅气呢。\n真的没问题吗？让我这种大叔穿。",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:6eca2b42f64eab8a0fc3995b7e5fa50b03ec34fc41fd04956d5b14f4925ff044",
      "text": "非常适合您！",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:51cdb9ec2ff3807611b55e9dc460ddba945c814824a80475927c148a7f740cab",
      "text": "哈哈，谢谢你啊。\n你这么说我就放心了。",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:9cd1e8ebe6c98b887c486a7ff149969798685fffd3a8421f68c21e8ddc52eea2",
      "text": "视频拍摄也顺利结束了，\n我差不多该悠闲一阵子啦。",
      "status": "draft"
    },
    "story-text:v1:037jir_305_2_3_037_05_09_a:2_3_037_05_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:a5df3dfebf909bf79101497f17c3a18154f2f86815335e20fa50155eafdb548a",
      "text": "●●●●プロデューサー酱也\n偶尔好好休息一下吧。那就先这样。",
      "status": "draft"
    }
  }
}
