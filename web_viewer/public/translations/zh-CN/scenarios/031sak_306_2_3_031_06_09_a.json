{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "031sak_306_2_3_031_06_09_a",
  "source_raw_hash": "sha256:66b1936b0a92635434403cb9e2212cb7d9d8c4c68db7253167969d40a1dbef20",
  "entries": {
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:35ef8913893e07181cdf5efb87c0943769d42166fa16b9b8249d61c5ac9a6a3f",
      "text": "喂喂，●●●●プロデューサー？\n呐呐，快听我说！",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5039fc1a65d637197303398384ba52954a71e20b19365acd027edd1569e4ab21",
      "text": "庄一郎帮我做了冰淇淋蛋糕哦！",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:3dffcdc56fad5514980d5322ec50b269a02ac7642630019b880b09a005d0ab9c",
      "text": "草莓冰淇淋和香草冰淇淋\n一层层交叠在一起，超级卡哇伊☆",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:d169ff5d807851c8c1210bb6930852a7bf3fcbf5b2507a58870bd5506a121b0c",
      "text": "我和卷卷一起把作为装饰的草莓\n放上去了哦♪",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:53c64b54ea85a777e68afadfa052cff46b7fc0749030eb7dd6884ac876337a42",
      "text": "听起来很好吃呢\n画面浮现在眼前了",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:50a3815bbdd7d886e234c345fb859450c89fc5dd921ccaef88d98932ec0842b0",
      "text": "请务必发张照片过来",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:d9f12509cf83d1d385defa864d141e384730aa10f06a9d20ccce2a9a8218ba9e",
      "text": "嗯！他说下次还会再做，\n到时候制作人也来吃嘛？",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:e1e7c429c8ecf7b2266dcecc14d4de44c22c43f5fafc73354f4ba7d8959266a8",
      "text": "分量超级大，\n好想也把悠介和直央叫来啊～",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:0f8b1799d5737fd8790a95406e88265e8582fcc7b64fb6c2531c8d9465cdcf22",
      "text": "大家一起吃的话，心情肯定会啪地一下\n变得超Happy吧！",
      "status": "draft"
    },
    "story-text:v1:031sak_306_2_3_031_06_09_a:2_3_031_06_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:e36f64cbc9d9f3b2852024feea2747340194f051a270362503dc920578309d75",
      "text": "到时候我会提早联系你的。\n敬请期待哦♪",
      "status": "draft"
    }
  }
}
