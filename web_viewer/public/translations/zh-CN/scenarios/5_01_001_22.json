{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_001_22",
  "source_raw_hash": "sha256:cde0578d3cfb4699cc2eb10b3820c8a7c5d7e7562cd9a59051a22eb6d02eb141",
  "entries": {
    "story-text:v1:5_01_001_22:5_01_001_22_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:b59277d4feb703a76c85c65ae73a6c68a8232f6a45cf34c88f4bbf83648d6fd4",
      "text": "这是情人节巧克力吗！？",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:0a50905a580844ddc5f6c096f2738c4019a5969d4c0f02751fa2c97e35ffbbb9",
      "text": "没想到你居然给我准备了。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:d2d3d5c901444368af947e1a18b6700c4af3f33fd500c492b103c0c6dc750aa9",
      "text": "刚才写学校作业正好费了不少脑子，正想吃点甜的呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:521691ee5d609985b517508ce9d06f6006cfb9bf434bada8cc4dbe0b8d15695d",
      "text": "那我就不客气，这就开吃了。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:7c58fb17180843721f7e6481cbbb46be9544ba05e0b5b0107e02473cab2ae813",
      "text": "这是什么……超级好吃！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:58ba7c5ed43127857a29da8da7a1785b914bd1f736c261a1f4284a70781c9ce2",
      "text": "谢啦，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000013:dialogue:000": {
      "source_hash": "sha256:06df44bc2336d2fa43b78b79002f928154955584fca60b2fd3d283120e26a214",
      "text": "●●●●プロデューサー，谢谢你的情人节巧克力。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:280189a9d17de836631899f048882a4f199daf170ffe079da30f4a6920e36ae3",
      "text": "接下来正好休息，虽然有点心急，我现在可以打开吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e87b7e4069e676601702e279ddd96a86cc83d309a57998f5e899190ffa105c90",
      "text": "哦哦……看起来超级好吃啊！总觉得吃掉都有点舍不得了。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000029:choice_short:000": {
      "source_hash": "sha256:e647cfcb909f50563355b2d39c9c89f2f547b3600e474a72c992b70d9442a74a",
      "text": "不介意的话请吃吧",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000030:choice_short:000": {
      "source_hash": "sha256:4e9791fe24a847171d69823f2aef35902c9bca547780327379efd9fa72725e07",
      "text": "别这么说，快请吃吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8db9a5f4470e59be1fc6d0a179b24fde5cfc137cb3e384a6c493c25973122c93",
      "text": "……说得也是。这可是你特意给我准备的。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8db9a5f4470e59be1fc6d0a179b24fde5cfc137cb3e384a6c493c25973122c93",
      "text": "……说得也是。这可是你特意给我准备的。",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000049:dialogue:000": {
      "source_hash": "sha256:3965b919d1e53e0368b1be4a8e3600421cb357af1fadb4e82caa87211b3dd376",
      "text": "不吃才更可惜对吧！那我就心怀感激地开动了！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000058:dialogue:000": {
      "source_hash": "sha256:becbb6f5f146265e97fd116c86a18d9d40b8434ba1987e93f6162dde41d330bb",
      "text": "……真好吃！很合我的口味，制作人！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000063:dialogue:000": {
      "source_hash": "sha256:1221873321bf23a3293d09167d51259483d8159cb25b5828cc760f85a4b12633",
      "text": "既然收到了你准备的这么好吃的东西，白色情人节我可得好好回礼才行啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_001_22:5_01_001_22_b:cmd-000068:dialogue:000": {
      "source_hash": "sha256:89c9a49a79d79deeb689f1ff91b4c050a40419c63ca4ebd51644aaec72edec4f",
      "text": "我会准备让你中意的东西，你就好好期待着吧！",
      "status": "draft"
    }
  }
}
