{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "022nat_305_2_3_022_05_09_a",
  "source_raw_hash": "sha256:a97dee7d8c8723e316a6a43fa2220c4c6d129d1011bb1a004d438a84e19f8a9e",
  "entries": {
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:a7772b4a0dd5a131e1f57c5c3c5b71e0da3c0403cb7beb7f1e9ac1d68f18e533",
      "text": "啊……喂，制作人。",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:a3061e821498966e908fcc3106cae6f33749c7602c80537f05dd6dbd1e9452a4",
      "text": "可能有点突兀……\n下周星期天，你忙吗……？",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:7298d0f0bd0213e1cb83d1ae134e03a76ba5737ec1cbb9adbb20efa6ec293c35",
      "text": "下午开始就有空哦",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:4af0cd005076c513e28969383d21499c9f92cbab2b998f357f8d32820c0ce9a6",
      "text": "这样啊……前阵子在美术馆办完演唱会后，\n我和英雄先生他们聊天时……",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:fbb08f4760012e3712c76d24da5356dbcfe89f4a4028fd731f03c574839d983c",
      "text": "聊着聊着，就说好下周日大家一起……\n去松饼店。",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:d7bb40f7c865d1680d2d8d124914b4d8a88fdca92f2b3552ce124ff357334f88",
      "text": "如果制作人能来的话，大家……\n应该都会很高兴的。你觉得怎么样？",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:d8b138a52f7fc315431051e40d1640694ca6a4e548f30af17b55fa866eadc0e7",
      "text": "听起来很有意思呢",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000020:choice_short:000": {
      "source_hash": "sha256:615e7ba8f6737b30ef2563b0e05e2aaa4bb8e40980053518cf95d99d816024ac",
      "text": "请务必让我一起去",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:a692928495ec088e137e042228bb915d12b10eb9067bb605324038984d4fc1d4",
      "text": "嗯，绝对……会很开心的。",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:8058aacc4b4ae92963e1817b9f5f8a855a5899272afd50edf75a3d98c1cb1f6b",
      "text": "你能考虑一下的话，我会很高兴的……那么，\n明天见，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:6fac8a4bcd39683bbd68f171a2364bc444466bdd1af1773c78a1da7d4acf7568",
      "text": "太好了……那我……这就联络大家。",
      "status": "draft"
    },
    "story-text:v1:022nat_305_2_3_022_05_09_a:2_3_022_05_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:3163b4d82f460b1e414b46b2b2db1042c8c275c923c3790bf390743fb53f03ee",
      "text": "具体的时间和地点，稍后再说。\n那……我挂了哦，制作人。",
      "status": "draft"
    }
  }
}
