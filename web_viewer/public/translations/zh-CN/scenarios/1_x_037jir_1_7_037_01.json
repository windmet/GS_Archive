{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_037jir_1_7_037_01",
  "source_raw_hash": "sha256:36c8f7741332c8fecf23fb0f9787456478a1810412c6406467bc52ea47232691",
  "entries": {
    "story-text:v1:1_x_037jir_1_7_037_01:1_7_037_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:be08d994ae5a152a4511a70587d42a267d80c11a69baf3179503db86f370ad6d",
      "text": "次郎先生，今天也是您的生日呢。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_7_037_01:1_7_037_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:0432e3cc4de0571a94cb6becec38979d94225ed703c187bceb2ab6e8c82091ea",
      "text": "哎，生日……？啊，今天是我\n生日来着啊。怪不得总觉得今天挺眼熟的呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_7_037_01:1_7_037_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:fb62a88a86c1b4dfc5b3e4e4b888426a6adff0505905b53b321d6838690db5c3",
      "text": "●●●●プロデューサー酱，\n没想到你还记着啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_7_037_01:1_7_037_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:0e37e813daa7a429b771578b15181870fa679f751716b69a04e248eebdff5d16",
      "text": "虽然我已经不是过生日还会高兴的年纪了，\n但能被庆祝，感觉真好啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_1_7_037_01:1_7_037_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:8cfdd5e859407a20643e7ff6830704cc2afa9eb10d28379ace7119d8c4524291",
      "text": "谢啦，●●●●プロデューサー酱。",
      "status": "draft"
    }
  }
}
