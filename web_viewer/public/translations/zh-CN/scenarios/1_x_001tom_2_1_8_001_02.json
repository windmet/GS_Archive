{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_001tom_2_1_8_001_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_001tom_2_1_8_001_02:1_8_001_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:56b3db2e31b5c27bcf5d45c1b5b2463342d41acbf4338d96d27e34d006d5481f",
      "text": "喂喂，●●●●プロデューサー？\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_2_1_8_001_02:1_8_001_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:2193d14e06f8f09128689ef9f2bfe0f50381451c10aee81055b83174bbc23aa3",
      "text": "现在能占用你一点时间吗？\n那个啊，祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_2_1_8_001_02:1_8_001_02:cmd-000014:choice_short:000": {
      "source_hash": "sha256:7c667b3c4a963215f5dd55c54fc0e4a366f4e5945b4d38228b12cc5a2be7da4f",
      "text": "太高兴了！\n非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_2_1_8_001_02:1_8_001_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:33ad6b4f1a3dc761093301f695ec9396f4f4ca019f586d75dc86dc14012a0796",
      "text": "我原本想着待会儿当面跟你说，\n但那样不就很晚了嘛？",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_2_1_8_001_02:1_8_001_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:1e5ebe6ff518284ea94c7ba78223fd500911d0f06ae4622426e347677c3f45b9",
      "text": "我真的很感谢你。\n一起度过美好的一年吧！",
      "status": "draft"
    }
  }
}
