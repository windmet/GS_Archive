{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10015_01_f",
  "source_raw_hash": "sha256:6c352bfc21e534421702afbb63c82c161ba41174e8536a1d699ae28a656ccba4",
  "entries": {
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000023:dialogue:000": {
      "source_hash": "sha256:187f9def42dd98ecbe40a94d5d77fcee26801d83142116e12026cc44c362ee72",
      "text": "接下来就是课程的日程安排了呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000027:dialogue:000": {
      "source_hash": "sha256:9531efba9b3e19b407cac01efc67ad4e232b1d0d67d1d70616472eecd5fc5bd3",
      "text": "好的。练习室已经按照这样约好了。\n能请各位确认一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000038:dialogue:000": {
      "source_hash": "sha256:00e3f6b5fb9876e9a013e9219dc3f2e79cf6d5ed702cebf9fcacff7072246241",
      "text": "我看看……嗯，没问题！\n谢谢你，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000044:dialogue:000": {
      "source_hash": "sha256:ecf934d57ff2d1f9d9f89d6e89073d26cc53713b90a2b64c620aaf6ba811d968",
      "text": "对了，反正都要练，\n不如用手机录下来试试？",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000054:dialogue:000": {
      "source_hash": "sha256:6a622e5c482418336385d9739877cc9b2455c5eabb230acee65371194b468116",
      "text": "比如想从这种角度拍、想拍这样的镜头，\n实际录下来看看效果。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000058:dialogue:000": {
      "source_hash": "sha256:803ffc96487d957ebf1765268a72dd1c02c8599ddeec272275f044f848cd46f9",
      "text": "下次商讨的时候，\n我想把这个带给对方看。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000063:dialogue:000": {
      "source_hash": "sha256:11c56a04638b8e7170752bc03e3983d01dba3853def974f5e57729c59e40ccf4",
      "text": "那样的话沟通起来确实会更顺畅呢。\n我觉得挺好。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000068:dialogue:000": {
      "source_hash": "sha256:1180e66a9935e87492be640e90afa250e6734f2d3eadb779dfadd05162f90900",
      "text": "好像很有意思。\n我也赞成！",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000073:dialogue:000": {
      "source_hash": "sha256:3e1839f5c26e897db9598924f660d19a2f2c17c47dd5652d0cdb06b4ea13d3a3",
      "text": "好的，\n那就由我来负责拍摄吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_10015_01:1_3_10015_01_f:cmd-000081:dialogue:000": {
      "source_hash": "sha256:8b98315469d67ce85146546709a6c14fda3149c21905bec4a045007a69088829",
      "text": "谢啦，拜托你了。",
      "status": "draft"
    }
  }
}
