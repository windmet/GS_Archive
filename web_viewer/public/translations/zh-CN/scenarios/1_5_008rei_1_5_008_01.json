  "scenario_id": "1_5_008rei_1_5_008_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000010:title:001": {
      "source_hash": "sha256:59bcb99dc4726025ad9a9c968a294b295476fc71f7b57aa13bb6b933f290eb09",
      "text": "音乐剧对台词的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:319011c532d863b4811f959d6c67b6aa4924ac63ef3b98d265efcf99a3578bda",
      "text": "没想到，竟然能出演如此知名的作品。\n真不可思议。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:c83ee19e38161b2c34efe23dc87633915f6f537e9f2bc5c4701c1aa28406a8fe",
      "text": "毕竟是几乎无人不知无人不晓的\n知名音乐剧呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:5f2f36829dad42ac569ef1635495497fc4efb003934bfd1656e9823b18717d37",
      "text": "是啊，我自己小的时候\n也看过好几次这部作品。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:050619cb607a110a1917a274e8c849db4de3ee88c0a5ba4ccaa5b2fc21d24142",
      "text": "真是非常精彩的作品。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:2b9cebc39ed5c112136e0d2ad85fdc739037a11dcc67aef2de31fccd60cfe89e",
      "text": "能参与出演是我的荣幸。\n我也定当竭尽所能。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:96f6b897634f55409a5b40d48128d050ddfd03f85bfd643a753488508b2d4f41",
      "text": "为了能将那一天的我所感受到的感动，\n传达给观众们。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:1a86e336845e3beae8317034e2ed4fe7ec5e70336724d49f2e611beb8df3f530",
      "text": "令人赞叹，丽先生！\n若有什么我能做的事，请务必让我帮忙。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000040:dialogue:000": {
      "source_hash": "sha256:b5c44f817b335a43948dddce16b85fcc5cec9432802e52c3b78a644cd5017f99",
      "text": "谢谢。\n我本来正打算回事务所后对对台词。",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000044:dialogue:000": {
      "source_hash": "sha256:578992bc4c82bc3a73f607e7878223e51b5fdcca83783ab370d106111850e1aa",
      "text": "阁下若是不介意，\n能陪我练习一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:a48117cbc044093d006837a25b00d98cd2c7834f0e0e352f14a217e619c3a16d",
      "text": "好的，那是自然。\n那么，我们回事务所吧。",
      "status": "draft"
    }
  }
}
