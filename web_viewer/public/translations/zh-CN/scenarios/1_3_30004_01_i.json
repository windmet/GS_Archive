{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30004_01_i",
  "source_raw_hash": "sha256:450a935775bca1508ad4abfe59c5f5547a46a8c9b5cc431c1181f0cf92aa9f12",
  "entries": {
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000014:time_caption:000": {
      "source_hash": "sha256:d754b865bcb97c6ac4d1751a7324118e65611b0ee124791cbf4f7dff6d44926c",
      "text": "数小时后……",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000023:dialogue:000": {
      "source_hash": "sha256:d21bed7f196381153e7d50d86a5ac423f457b5d1c5be394162d5588531fda9d4",
      "text": "我觉得自己表现得相当棒呢。\n大家都被我的演技给惊到了♪",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000030:dialogue:000": {
      "source_hash": "sha256:e397957ee1a59cc41477697bcdb85eb7b625d8364bbfb3fa0e1ffc8c7e9d96eb",
      "text": "不对不对，明明是我说得更好。\n大家都在看着我呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000035:dialogue:000": {
      "source_hash": "sha256:3ae9075e8643a56baec424a11ded68bb198e5a8fab94d7aff22f35303468e495",
      "text": "是那样吗？\n我觉得明明是我演得更好啊……",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000042:dialogue:000": {
      "source_hash": "sha256:da76218e46640ef7671bff13a419aa31e573d7cf79fbf1f52c360bce85f3fb10",
      "text": "呐，●●●●●●●●●●监督。\n你觉得谁的表现更好？",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000044:dialogue:000": {
      "source_hash": "sha256:0ac4dc16d4a15651876b938d44d8695a910388fa1a24a6f8f43d1735032145d2",
      "text": "难分伯仲呢。\n两位都非常棒哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000048:dialogue:000": {
      "source_hash": "sha256:c0c561f4368395182587daaf6d43906bfaab0fe783280e8ef85c3eb578d3573f",
      "text": "嘿嘿，是吗～",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000054:dialogue:000": {
      "source_hash": "sha256:3d5d5ca4e0d38825fd8bd4e4a5796a2ba3efc8cc84d3ea7b6fcfb7592c23937f",
      "text": "不过既然……\n●●●●●●●●●●监督都这么说了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000062:dialogue:000": {
      "source_hash": "sha256:e3f0bff2feb1bfac5ecf5fb78a45842d1235f7f4b3fbccb652008c872bd54ead",
      "text": "那就暂且这么算吧♪",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000066:dialogue:000": {
      "source_hash": "sha256:f1cb18f30ec8996b5524544878ab5c81a38a040f65585da1d16317d74c91a860",
      "text": "哈哈哈！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000076:time_caption:000": {
      "source_hash": "sha256:d97839694a88d3dbaae2835aa42718463b83dd8670118274c73ca9eac5ddd44c",
      "text": "事务所",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000083:mobile_message:000": {
      "source_hash": "sha256:a119cb2b7d5fb5b00dd2e9150a1c5c16b1ffac21aa57acf94157f1ea5dc044a2",
      "text": "今天录音辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000085:mobile_message:000": {
      "source_hash": "sha256:87f57d92cf04f92a7f9be9853cf9f6122be1ee1e50e2a78aa0bcadb98305e633",
      "text": "辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000087:mobile_message:000": {
      "source_hash": "sha256:54949ab98e6caf0422477bc0bba4f971996341706e312e9a1d7048baf4485356",
      "text": "说起来录音时候的画面，\n和平时看的动画\n稍微有点不一样呢<emoji>image_talk_emoji_08</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000089:mobile_message:000": {
      "source_hash": "sha256:e865c5d4d5c923247a1dca5efd17f66f94b9944dffcec12370ce04a49a4ad106",
      "text": "对对，像是草稿一样的感觉…\n而且还没有上色",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000091:mobile_message:000": {
      "source_hash": "sha256:ebeacd9a982d14d97983cf489dc046313cc4336ed1162b3e1d8a37445be3937e",
      "text": "原来动画一开始是那种样子的啊！\n长见识了",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000093:mobile_message:000": {
      "source_hash": "sha256:5232aa83a8f61f84bcf7a5194ff1f0718d03909d541d9096e4983b26860a7397",
      "text": "一想到那些画面涂上颜色动起来，\n就让人兴奋不已呢<emoji>image_talk_emoji_16</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000095:mobile_message:000": {
      "source_hash": "sha256:0a5281c9995e6ec63d3cb981c089b4e7a63d0c16029e8b7e4cebd5951d9e0cb3",
      "text": "真的会播放配上了我们声音的\n动画吗<emoji>image_talk_emoji_08</emoji>\n总觉得还没有实感呢",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000097:mobile_message:000": {
      "source_hash": "sha256:813dea62b5b93218c16a6f327bc617b6fff59fd6a8b7cce7f16de90b416cea6a",
      "text": "离播出\n还有一段时间呢…\n真是迫不及待了",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000099:choice_short:000": {
      "source_hash": "sha256:20753d958822439239c8f9167e6584493aaaf7991e850246bf0cb9d992925471",
      "text": "真让人期待呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000099:choice_detail:000": {
      "source_hash": "sha256:7fb58b02cb7ab0996b301a6f2bd70d29451d393a719566713c1bfaed2603c32a",
      "text": "很期待播出的那天呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000102:mobile_message:000": {
      "source_hash": "sha256:a04b0723cc8e2f3ac840f69cfcffb2ab2c1005f342fac69fde2be29ffef2f33c",
      "text": "嗯！\n超级期待<emoji>image_talk_emoji_36</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_i:cmd-000104:mobile_message:000": {
      "source_hash": "sha256:6b73e1f18747ceaac7f93869042fa9d4ee9d93218106173a65007c64e3d677ef",
      "text": "我也是！\n我会每周看着动画\n耐心等待的<emoji>image_talk_emoji_05</emoji>",
      "status": "draft"
    }
  }
}
