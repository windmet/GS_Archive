{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_02_g",
  "source_raw_hash": "sha256:9499408360e90444446ed2c2c80f162c2cb655e1f049636a4875838b0489639c",
  "entries": {
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000021:dialogue:000": {
      "source_hash": "sha256:2c9a55d25da3daf2114c0778be9d7315fe3d3e59e02042c55f05f03817e2e631",
      "text": "哈啊！？喵子也要！？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000030:dialogue:000": {
      "source_hash": "sha256:5ad4df6c65f48f984588877f7036468ec002d3c43af76ba01b7b9fa2a93fb33c",
      "text": "（……虽然说了些异想天开的话）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:3d597bb7ab107891a97f662d9d67f254e4380babacace8fbd5a3a6793bf59373",
      "text": "（但眼神看起来不像是说谎……\n先听听看再说吧）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000047:dialogue:000": {
      "source_hash": "sha256:142f16f4d1906055969045607c6784e0fbebd137721953708fbb1eb9720ae148",
      "text": "根、根本就搞不懂\n偶像到底是个什么玩意儿啊！喂，玄武！？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000053:dialogue:000": {
      "source_hash": "sha256:5b8362459a7da816e40a3d37942e2da3bb890b6bd883381d081c4fbbce0f42b0",
      "text": "冷静点，朱雀。……喂，之前也说过了，\n我们对偶像并不了解。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000057:dialogue:000": {
      "source_hash": "sha256:79a6fd20ada26fa9d1941cadc1cebd87b2bc4c376508c3fcf623b5d908f7f971",
      "text": "偶像这行，到底是要做些什么？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000060:dialogue:000": {
      "source_hash": "sha256:4e55fcca5d84f5822b627a3f29a45639b3b2d1b52d667a665ce782bbc2e65ffd",
      "text": "这个嘛……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000075:dialogue:000": {
      "source_hash": "sha256:897f76610bd556766a995858ff09dcf62bdcb3aa2b4bed0cf29da1b1e0bd5b1a",
      "text": "……偶像这行，\n涉及的事情比我想象的还要多啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000085:dialogue:000": {
      "source_hash": "sha256:6548fab2b0ddca372db4e4d651305fbe8a742a3686da0a4442f89d81c4271e2f",
      "text": "……喂，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_g:cmd-000089:dialogue:000": {
      "source_hash": "sha256:1f2c8ad98be132e88db5429368bfc9a839251844e2284d9272f95f250fc943af",
      "text": "刚才的话里，\n你说过偶像能上电视对吧？",
      "status": "draft"
    }
  }
}
