{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_403_2_4_040_03_09_c",
  "source_raw_hash": "sha256:4b89f85f4c13a936a18f5146f264c49fb98a2d0cfbd7bbd514a1f970d2eaddea",
  "entries": {
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000007:choice_short:000": {
      "source_hash": "sha256:65e913e1dcaaa1e0d17df402cd931254087f79b5bac5c96fbe031c0db9ab69fa",
      "text": "涟先生？\n怎么了吗",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000011:phone_message:000": {
      "source_hash": "sha256:59f27c0101c76cbf041da7a2d06d708b2cd74e7dae9c28c4f78c263185a51a25",
      "text": "烦死了。\n谁要跟你们混在一起啊。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000013:phone_message:000": {
      "source_hash": "sha256:5052bfd6e734cf5b80fb9bdb05846bd13c4d4865f62600f3360257957ee36237",
      "text": "哎呀哎呀别这么说嘛！\n一起去吃顿好吃的啦。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000015:phone_message:000": {
      "source_hash": "sha256:47017733e3323647a68ad5f7bc275062d717531e3454152486a81f1e2e71ead0",
      "text": "是之前渡边先生推荐给我的店。\n我记得……好像是肉很有名来着。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000017:phone_message:000": {
      "source_hash": "sha256:6dc4eb63437ba514a0b6e43e23a69337136120aab2613f760ce4f431d0cf4087",
      "text": "肉……？",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000019:phone_message:000": {
      "source_hash": "sha256:7502e42c583af23a8f991ced112634524448e1dc874bb898d00c4018f8b753c1",
      "text": "嗯。据说是很顶级的肉呢。\n你肯定也会喜欢的。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000021:phone_message:000": {
      "source_hash": "sha256:2d49f00c5d47211e9bb0a9e6d8969ae8b69c1e0a9ecd9a7dd268e8daf45fb6ee",
      "text": "哼。\n既然这样，那我就去一趟吧。",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000024:phone_message:000": {
      "source_hash": "sha256:f069960038ffab7c43aae8dbc7b67e5b538b10a86d8c64986b6d1c1273fc310a",
      "text": "大刷子，赶紧带路！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000026:phone_message:000": {
      "source_hash": "sha256:a1a011ce9e38b7f64cd92492ec7f146264de5a479b89789606841de94d8af218",
      "text": "啊，等等啊涟！\n我还没收拾好呢！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000028:phone_message:000": {
      "source_hash": "sha256:173c0caa6693f35a1529962878eb9774b660203260499329ab0b358353b7681d",
      "text": "动作快点你这甜甜圈混蛋！",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000030:choice_short:000": {
      "source_hash": "sha256:ed2a628cd5fa1aefefdf39806201c9e843568289c3afaa559be9715e76191962",
      "text": "打错电话了啊。大家\n玩得开心点哦",
      "status": "draft"
    },
    "story-text:v1:040ren_403_2_4_040_03_09_c:2_4_040_03_09_c:cmd-000033:phone_message:000": {
      "source_hash": "sha256:fb6495b0335a7f86a09882d66a4ce2db6e9c0b30c59ce47d65889e044d38912a",
      "text": "本大爷要把店里的肉全吃光！\n咕哈哈！",
      "status": "draft"
    }
  }
}
