{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "006tsu_401_2_4_006_01_09_a",
  "source_raw_hash": "sha256:4bf67a2e35a9d16d5264f4724d5202c9cf1a37fe0aca7da0b737c3944ef20ccf",
  "entries": {
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:276435faff68445aaea05d42392bfd5c1b9fb9fcf26c3cfa777627e40b19d2a5",
      "text": "●●●●プロデューサー，辛苦了。\n我是柏木。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:7fc4e6110ac39cfd78845f0fdc91b712c98b050b912039a59fa6b26bd3da54a7",
      "text": "偶然看到了滑雪的广告，\n就想起了拍摄时的情景。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:de271851efdfafb79bf9dfe2427e7f703dc3239d9b9587029f0cc4f8261209ca",
      "text": "从缆车上看到的雪景\n也超级棒啊。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:dbe135b9f6bfafc3ccebb063f821df6f48e5e6fcd8484f28f21aa8c199820c81",
      "text": "啊，不过，从飞机上看到的\n雪山风景也特别美哦。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:ad438d41bdae309cee89c3d06981c4aaf28efda8fec32cb4a89262e829f8eca4",
      "text": "真想哪天能和●●●●プロデューサー\n一起看啊。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:1ce2fc4b4273a472a67743dbe136f2e8142e837f055073bfb8beb61ac537c3f7",
      "text": "为了能接到那样的工作，\n我想继续努力！",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000018:choice_short:000": {
      "source_hash": "sha256:9fb6c921d51e980a031b9119f4e8c1779d51f60a0e80389d1fbb9d14a5efa9d4",
      "text": "我也会努力的！",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:cfc08170540fb6cfc63647427ea0447fd055e13d54bf91e16ea6a259079dd2aa",
      "text": "哪天一起看吧！",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:2e45db7ddbb8d2c38cd0a3ec6a79f763eb927656a6fdf96a2e0d4c945740842a",
      "text": "好的！\n在那一天到来之前一起加油吧。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_a:2_4_006_01_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:bbf3fb1c3d9de6e36d895334d2240d41a2c8a65c17c8c93ea4e698397cdb3ceb",
      "text": "能和你聊聊真的太好了。\n明天起也请继续多多关照！",
      "status": "draft"
    }
  }
}
