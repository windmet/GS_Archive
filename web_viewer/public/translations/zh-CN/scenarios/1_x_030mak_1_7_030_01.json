  "source_raw_hash": "sha256:1858b33002bb31d75449fe23c1e89c7885d4d88c1fa4ee89ee366a2d04a89d80",
  "entries": {
    "story-text:v1:1_x_030mak_1_7_030_01:1_7_030_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:c87eab53a75b3feba061e415a009936846bc3ef3e3d317b4abd0084df47d2e14",
      "text": "卷绪先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_7_030_01:1_7_030_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:3c22bb90035ba2a36aed5326c991eee9cf1ba932e29eae7c5c184df1807d5317",
      "text": "非常感谢您！\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_7_030_01:1_7_030_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:b0d8dc1d532aa81ae934f70de80b7ec981bf82e83a6c5e63b5f694fefd51f166",
      "text": "能像这样得到您的祝福，\n我真的非常开心！",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_7_030_01:1_7_030_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:bf2c1fae62368219e3c8b185d7ef3c1f1a342a78501a8f728624c3ffb302d396",
      "text": "生日可以吃到好多蛋糕，\n每一年我都好期待呢♪",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_7_030_01:1_7_030_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:2a24e11d94c8277f9f88c8f029c2eaec2af76803514bd6d71231e04fe7463938",
      "text": "等到了●●●●プロデューサー的生日，\n我们也要一起吃蛋糕庆祝哦！",
      "status": "draft"
    }
  }
}
