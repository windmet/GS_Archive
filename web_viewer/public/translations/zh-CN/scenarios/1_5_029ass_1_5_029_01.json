  "scenario_id": "1_5_029ass_1_5_029_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000010:title:001": {
      "source_hash": "sha256:afd7487bcdf0ae8c8bfc76711a22b16fda63feba4d27511acde4c3ea098ced66",
      "text": "海外音乐剧电影配音的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:98d36ff4bffdd80826d6b23f78147b122c3ce8fbc040ba13c161edb9d4c7c2c5",
      "text": "阿斯兰先生，\n因为设备故障，录制好像要推迟了。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:ec53077eac106d71edea115f17fb721bd541b9bebfa518db49b0ba738c9af961",
      "text": "什么……！\n难道是阻碍本座霸道的试炼吗……咕……！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:331dedbe3ecf3189f495925ccc83f905896238accdfa5399e4764998554e44d2",
      "text": "无可奈何……\n在时机成熟之前，便来翻阅神话之书吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:9bb620b332520a21f711db9f9cf97b341fea458514a9591d511a280f2a2fb017",
      "text": "以成为最高位咏唱士为目标的痛快物语……\n本座所饰演的乃是主角永远的宿敌！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:dd80b6d2b235b95688f6fcd6579b78b5a341720c913a0641c002d9d40dda58c9",
      "text": "我也看过台本了，是个很棒的角色呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000044:dialogue:000": {
      "source_hash": "sha256:63fffccc0cd7ee3ec76457360f9ce7c4efddc53d1a011d98e49866a525274d79",
      "text": "虽然从角色设定来看演唱部分很多，\n但我相信阿斯兰先生一定没问题的！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000050:dialogue:000": {
      "source_hash": "sha256:cabef1cafbfc8d8c73a2ffb65b864a3c7135d30830f3ae53a024042f33aa8d8d",
      "text": "嗯，那是自然！\n为了增强暗之力量，本座早已反复修炼。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000055:dialogue:000": {
      "source_hash": "sha256:a68a8f96df1b8bd29ba3ddc9e1d7e607bff2188c12e8316a21a8df52d230cd75",
      "text": "吾主亦一同为这无尽的修炼助了一臂之力。\n本座理当言谢！",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000060:dialogue:000": {
      "source_hash": "sha256:2143e710d689f4c83d51e6c4b1eb6a768f9424d8de2d299375b9c2f99174741b",
      "text": "能为您帮上一点忙真是太好了！\n……啊，录制好像要恢复了。",
      "status": "draft"
    },
    "story-text:v1:1_5_029ass_1_5_029_01:1_5_029_01:cmd-000066:dialogue:000": {
      "source_hash": "sha256:0aeddda36248e6ab2dd4a8d7a559301d022ec1c0b863d29884dd31143a52db2d",
      "text": "库库库……时刻已到！出发！",
      "status": "draft"
    }
  }
}
