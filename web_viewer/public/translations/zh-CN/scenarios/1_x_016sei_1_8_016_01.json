  "entries": {
    "story-text:v1:1_x_016sei_1_8_016_01:1_8_016_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:c441b31c381e4ee443977cac4432465c931c3ebf0631fe7041b302332edc56ea",
      "text": "……喂喂，●●●●プロデューサー？\n突然打电话给你，不好意思。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_8_016_01:1_8_016_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:9a119427e30f489fd2f9de4a40580fbe8c4be7e16bbb113c537a074b1b1ab4a2",
      "text": "虽然等到事务所再说也行，\n但到时候时间上可能会比较紧迫。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_8_016_01:1_8_016_01:cmd-000018:choice_short:000": {
      "source_hash": "sha256:eac45b6855021e10962477f5af1f545f3e25f3d1397bf8a1a1c5c53306cfe0cc",
      "text": "没关系的",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_8_016_01:1_8_016_01:cmd-000021:phone_message:000": {
      "source_hash": "sha256:98cc0fc7186cb8a20f6db0a996e359fa713d14b05b36f23e4a26755ad498a498",
      "text": "那就好。再次祝\n●●●●プロデューサー，生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_8_016_01:1_8_016_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:fa1959df42338b2bce136484459badcb481f47f13bf925a49f94a78246158618",
      "text": "能传达给你太好了。\n那么，待会儿事务所见。",
      "status": "draft"
    }
  }
}
