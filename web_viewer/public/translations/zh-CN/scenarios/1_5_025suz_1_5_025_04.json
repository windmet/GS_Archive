    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000011:title:001": {
      "source_hash": "sha256:6075714cd7a7a1f4a4f4f067dad8629d35620578c3a12e8fcbad41cb1a526c3e",
      "text": "动物综艺节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:fb48c157df595121af433d80cc4a9b554d46eb61f3b96170806299003ae6e299",
      "text": "喵——！喵喵喵——！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:6d26038ac6cd7ccf2113487df082d80a30692a142181a6f948bf8f75dc10c172",
      "text": "噢噢，怎么了喵子。\n你就那么期待今天的录制吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:e10ee2b2c7eea3bb28694cb2f5cdd7eac9de0ff2bd123af657a2076bf886dbb9",
      "text": "喵喵，喵——！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000029:dialogue:000": {
      "source_hash": "sha256:dc880cf3031ffedffabba5fb0fdcc9db9db4acfd6ed1d4274569e70fa0fb8ee4",
      "text": "干劲十足呢！朱雀先生和喵子，\n这次要和旅途中的招牌猫互动。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ea76c3ee4c15daf18d39c5ee9cc2e2b6501156ecf30a15b9d4cc83f6f7535880",
      "text": "是动物综艺节目的固定环节对吧。\n好嘞，我也要打起精神来！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:d9f8086afe7aaf09d6e52b50d52d3841f426160a1d982053e389a9a850828861",
      "text": "……哦，好像快轮到我们出场了。\n那我去了！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:127e8cb04274023e09300df557cc6f12d8836567900bb4ea41bf01d7c35dd759",
      "text": "好的，路上小心！\n请加油哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000060:dialogue:000": {
      "source_hash": "sha256:3a499f30fae6cf4a8f8ceb3eb15bd5a15fd4946f7c8b9d4986dd1665211c0f42",
      "text": "哟！我是红井朱雀！\n这边的是喵子。请多关照啦！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000066:dialogue:000": {
      "source_hash": "sha256:772e89c636daee532f9ab97e48edb15969065cd2bff3ed4e38b20430772847e0",
      "text": "愿意让我摸摸吗？\n乖——乖乖乖……嘿嘿，很舒服对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_04:1_5_025_04:cmd-000071:dialogue:000": {
      "source_hash": "sha256:c735bd8683f28c9f9b7169af669336aabac23d96631afce9c5d9aec15605ccb4",
      "text": "（朱雀先生和喵子出色地完成了拍摄，\n创下了极高的收视率！）",
      "status": "draft"
    }
  }
}
