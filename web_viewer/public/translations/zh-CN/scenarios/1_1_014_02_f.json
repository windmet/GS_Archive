{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_014_02_f",
  "source_raw_hash": "sha256:e8e94daa4dfb18642f4f6b686f43887aaee720d8beff08f3b58c617f3ce2b52f",
  "entries": {
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000020:dialogue:000": {
      "source_hash": "sha256:3015868d454247a3508eb32e39f5551ba20ca7744d713869fff891f4f2659b41",
      "text": "……哈啊……哈啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000027:dialogue:000": {
      "source_hash": "sha256:973580dbc3e7d5057f8d36e2e3372f98d898a94e5bdfdb6535122b09405c46fc",
      "text": "呼……！跑到这里应该就没事了吧。\n要不要在那边的长椅上稍微休息下？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a88e5af35d43f54bdf3976b946202b792d9ee7d1be72bc91a1ffe6ecb9dac97a",
      "text": "噢，那边正好有台自动售货机。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000050:dialogue:000": {
      "source_hash": "sha256:ebf24d18ceef48ae31ad761e7a25a84f73f403f1c386bfc7cb9c3dd856ff1ee5",
      "text": "喂，饮料这个可以吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000077:dialogue:000": {
      "source_hash": "sha256:f1e0ed33fa531ef08ae9f0399ada9ff8500d6ad651e30bad7e1a8f095343ba1e",
      "text": "啊，嗯、嗯！\n那个……刚才救了我真是太感谢了。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000080:dialogue:000": {
      "source_hash": "sha256:c679ef13e0056bc27daa84ab5d178b7035211a4e124d5ba91c62d07ca1133d0a",
      "text": "而且，还请我喝饮料……",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000084:dialogue:000": {
      "source_hash": "sha256:0f0d41207c4ae261b6ace27117a746bb560c60b61e888d4a4b66c8a44f514d7f",
      "text": "不用在意。\n比起那个，稍微冷静下来了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000088:dialogue:000": {
      "source_hash": "sha256:0957be7f105db0a9a446195af77b64f7d435c09c287e4046586f3151d8ac0549",
      "text": "嗯，多亏了你。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000094:dialogue:000": {
      "source_hash": "sha256:b75924739414f25a95da9a9beb401e5ca5e1f45cf959e7df65ebf568c5e08da3",
      "text": "那太好了。\n我说，接着刚才的话题……",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000099:dialogue:000": {
      "source_hash": "sha256:097aea04d9ba78a7500f1196e0d930fbe4d3b3bf0fb903ae4c35216253833b41",
      "text": "你是秋月凉吧？那个偶像。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000104:dialogue:000": {
      "source_hash": "sha256:29122617ff65f3beb7039c95db430236d5b2266ca124454879c0a3bb0c823de8",
      "text": "诶？你认识我吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000111:dialogue:000": {
      "source_hash": "sha256:e9681b62fc1b3834baf99c6c62d6d047590028ba819341b6606eb19a928fda7c",
      "text": "噢！话说……这么说来，\n俺还没报上自己的名字呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_f:cmd-000119:dialogue:000": {
      "source_hash": "sha256:ba24f3e456327abf1a83838a5220b72501d68b38e06d1dabae045f489cb681c1",
      "text": "俺是兜大吾。请多指教啦！",
      "status": "draft"
    }
  }
}
