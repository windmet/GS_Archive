{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_017_22",
  "source_raw_hash": "sha256:15c1c4888f631851deb712092e1b3ec80ff8a067b0a7b775dbde88e8ff697f40",
  "entries": {
    "story-text:v1:5_02_017_22:5_02_017_22_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:d795a751b755defe293fea5c22f713a05f8c9378eb93c5d6923d5848e47ac8cc",
      "text": "噔噔锵锵♪\n令人期待的白色情人节到啦喵！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:4965eac04979b0ee4a15c448715b99e32863ae7dd9570e06b72d7ea44869c201",
      "text": "吾辈准备了感觉制作人君会喜欢的\n回礼喵～！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:780a76ca4126448114ce4d4219d8d7e538e2e4d629dfcd3ecf85504ee8fd6b8d",
      "text": "里面是什么拆开前可要保密喵♪",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:cfc9d6e7940970bd4f5ef6302d7673816074446bd9e979c0e03034ef37944856",
      "text": "脑海中浮现出制作人君的面容，\n特意备下了这份珍藏喵。",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:5a52f9c7e116d17b47449e94836ebfff61c189976e51ca4af9a4e49cf5ac9f57",
      "text": "何时拆开全凭你心意喵！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:fa1662b74889e12572b688c3ac958874b5b482e061a4e51f9b65b1ad9198f096",
      "text": "不过，拆的时候要是能叫上吾辈就很开心了喵！\n因为想亲眼看看你的反应喵。",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000017:dialogue:000": {
      "source_hash": "sha256:3852b4fbaa8ef42de5fe980c158dd2eb45c3e8392af6d7b0d3b47f738f23f495",
      "text": "咻啪——！\n制作人君，辛苦了喵！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000022:dialogue:000": {
      "source_hash": "sha256:e5de89db7fcafdd84692c192593627ccc83ec239a92e5ad41e52952b24fa0fa9",
      "text": "把白色情人节的回礼送过来啦喵～！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000031:dialogue:000": {
      "source_hash": "sha256:a18866b83452b70a5b1085fcb7d58499a16bb17d46fd9fe91655ea618433523e",
      "text": "上个月谢谢你的巧克力喵。\n这是吾辈的一点心意喵！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000036:choice_short:000": {
      "source_hash": "sha256:0f1170f22c9e7d89e514a61c7d8707bb90e9f5ef269a17ab9db216c7c76ae46c",
      "text": "好开心！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000037:choice_short:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:16bf938431eac20d856552fd7436aaa696451d6e41b0940494ab9763604e6245",
      "text": "喵呼呼，高兴了吗喵？",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000051:dialogue:000": {
      "source_hash": "sha256:af90e1dbafd495ab6e92395ea636f66d3bcb9fb4a157d2613a7af06b10d386a4",
      "text": "●●●●プロデューサー君开心，\n对吾辈而言也是天大的喜悦喵！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000061:dialogue:000": {
      "source_hash": "sha256:b771e41590232d7b5421997678efc1e73a71c83a23cc8fab50e54c139517c207",
      "text": "吃了收到的巧克力后吾辈的工作表现，\n正如你所见喵。",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000065:dialogue:000": {
      "source_hash": "sha256:d2b093df64efe008b9d221799367c9f44e08ed7e5e3404f9b37d2ad3b1e3050b",
      "text": "状态一直都绝佳喵♪",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000072:dialogue:000": {
      "source_hash": "sha256:2b2540f0b80d9ea06676ea39e534890c65560dbf5b7163ca9b41bd700d17728e",
      "text": "今后在工作和演出里也会继续让制作人君\n大吃一惊喵！",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000079:dialogue:000": {
      "source_hash": "sha256:f4f0accb683356ad6d8edc492f45d7f872e1efeed7c6ac43b7de1ac9e426a73b",
      "text": "想和你一起看遍\n各种各样的风景喵♪",
      "status": "draft"
    },
    "story-text:v1:5_02_017_22:5_02_017_22_b:cmd-000086:dialogue:000": {
      "source_hash": "sha256:8ba964d500c0643c2f07b55a1af9aa8f2d4d77f00324568b64ffc0e7e80d98ff",
      "text": "对吾辈接下来的舞台表现，\n敬请期待吧！",
      "status": "draft"
    }
  }
}
