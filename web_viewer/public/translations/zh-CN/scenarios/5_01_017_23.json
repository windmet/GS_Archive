{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_017_23",
  "source_raw_hash": "sha256:87d6ac12314a7812363bc0b2bb104ec4774f3a6f18be52bf8d80e4347da7911e",
  "entries": {
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:4af57e74e3e860cdca30700e035472499ae0b08bd42512be75b0e1ce05199516",
      "text": "唔唔……哎呀！唔姆唔姆，这个气味是？",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:e5c0db9913eff5a066ed2a0943f4f235274bd4e8812d72655b52c4e4dffb602c",
      "text": "桐生先生，辛苦了。\n怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:e35695d6a1818ab4fde5b2b80bbbf536ea591b2078ba1e1e4eeaacce607847d7",
      "text": "从制作人君那边，\n飘来了一股好像很好闻的味道喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:f582a63ffe2abe4f0b2a916a8aeb7bcba056813e858a7c21256521b635ee11fc",
      "text": "这轻飘飘～飘散过来的香气。\n在下可是超～级有印象的喵。",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:1155c68be758e1e4d873a4fb9a28c572172fc266c169eeb0f4b9ea895cdeab04",
      "text": "含进嘴里就会化开化开、\n让人变得幸福的那个呢，还是不是呢喵？",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000047:choice_short:000": {
      "source_hash": "sha256:eacf694c23cb0fb12f5fe52edf61d45fbac1d28a59a32b6ebb590209de63666b",
      "text": "不愧是桐生先生，一下就察觉到了呢！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000060:dialogue:000": {
      "source_hash": "sha256:e320965ab61eecae207d497f53cecad3bacbefafe3073549f851f6a96539d51a",
      "text": "喵喵，制作人君知道这股香味的\n真身是什么吗喵！？",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:90d9e894c2fafa952274b4d8d9131f44c2b0d6e56aec3e2c27e625915f9f648a",
      "text": "请务必告诉在下\n它的真身喵♪",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000073:dialogue:000": {
      "source_hash": "sha256:294e9951a4383cc3f2c0859b149600b0b71924eab9dd1fa3c2212ef210494ca5",
      "text": "明人不说暗话，这是送给桐生先生的\n情人节巧克力。来，请收下吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000083:dialogue:000": {
      "source_hash": "sha256:f41877a7b1f783fc2a0adbe3ceef9467ab51a3b6e25875b737117fa7c310d1af",
      "text": "喵呀！居然把这个藏起来了！\n制作人君，真有一套喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_23:5_01_017_23_a:cmd-000089:dialogue:000": {
      "source_hash": "sha256:c09a98049713ecb712bce9a0f1aa7f49f1a0ef9221d49e29460e335383d1a5dd",
      "text": "在下就满怀感激地收下啦喵♪",
      "status": "draft"
    }
  }
}
