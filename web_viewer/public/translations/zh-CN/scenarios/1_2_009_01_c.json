{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_009_01_c",
  "source_raw_hash": "sha256:29e347a5907048937b6bbf07d234de78a8433ab57d10753f72c443ee308df73d",
  "entries": {
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000016:dialogue:000": {
      "source_hash": "sha256:ca0092afae1bde09c8dd8ba1c3c0758fb687a5afee04e6856598f416f6fc76ca",
      "text": "像这种花絮一样的内容，\n读起来很有意思对吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000021:dialogue:000": {
      "source_hash": "sha256:14a53ab1b9c1116499468bf93e7d7e90affd4a5f300adc02b6fc458b045a339d",
      "text": "是啊。一边看着一边再玩一遍之类的。\n和游戏放在一起的话，大概会很热闹吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000028:dialogue:000": {
      "source_hash": "sha256:1cb8155934386e1da43aba62bbeb5c8218b93ff0998b0b5afb4de12238c1b016",
      "text": "话说……抱歉，得去杂志区才行。\n呃，是在这背面吗……？",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000039:dialogue:000": {
      "source_hash": "sha256:d472b2e1b82c0d0cfda0ddb3c9276b8e9a6c8f81a2bd51611714522b23941a12",
      "text": "这里是……不对，好像是参考书专区呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000042:dialogue:000": {
      "source_hash": "sha256:7796ce3dcbfd1d985bde24fab04b8318bcf2868add3d4c5a88c22ccd5113954d",
      "text": "啊啊……\n好多高考历年真题集啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000058:dialogue:000": {
      "source_hash": "sha256:4ca7e5ceaf0ee7c2895ab691e8acb114889e28b85a515c75754c6d0fbe593c7c",
      "text": "大学联考的事，还有老爸的事我都听说了。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000061:dialogue:000": {
      "source_hash": "sha256:3d906bb765107b00038390e2342c595a5f9e6ab99ede6e0eb5ea56e2685769a8",
      "text": "就算你就这样逃避离开，\n也只会变成丧家犬而已。",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000080:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000083:dialogue:000": {
      "source_hash": "sha256:921ef916de755cfe42738481c2b51198b9d7813fedb3ad8e95049e1d73f4aca2",
      "text": "恭二先生，怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_009kyj_01_1_2_009_01:1_2_009_01_c:cmd-000089:dialogue:000": {
      "source_hash": "sha256:b3a7292235434c1fe1ee0432d835f0fd2aa0f6069c45f4162c2daab685f06d04",
      "text": "啊，没……没什么。\n比起这个，看。这边是杂志区。",
      "status": "draft"
    }
  }
}
