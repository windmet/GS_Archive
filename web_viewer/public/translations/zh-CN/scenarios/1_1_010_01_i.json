{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_i",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000020:dialogue:000": {
      "source_hash": "sha256:6a231e6256593da4ea148b96a24daf389af6dbb04f8bb16fb5047804425e9620",
      "text": "吾、吾名为阿斯兰·别西卜II世。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000025:dialogue:000": {
      "source_hash": "sha256:174536c9dabf176d4236be8a3ab608a10254b5baf49d1478d60a94bbb3fcf5ab",
      "text": "II世……不对，是阿斯兰先生对吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000029:dialogue:000": {
      "source_hash": "sha256:ff0c070f251dbc45eec27040b6e87013f79953e9d5160cdaeeb121c8ce0e4d55",
      "text": "然也！镇坐于肩上者，\n乃背负世间万般罪恶之堕天使撒旦！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000033:dialogue:000": {
      "source_hash": "sha256:78dbb12dd628a7070453c418c67dbd15e97bb011476774140f79f6bfc923d69f",
      "text": "阿斯兰先生，\n是希望作为主厨被雇佣对吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000038:dialogue:000": {
      "source_hash": "sha256:bd38e2f5ca240752e571597f9c15b3d6e48000765cdfac3dc04729a4ea5aaf94",
      "text": "唔、嗯。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000042:dialogue:000": {
      "source_hash": "sha256:dc9cd50414c79a64d26e60f281eeee05a795f369abfc0e77250dc0d6c47294c3",
      "text": "既然如此，作为测试，\n能做点什么给我们尝尝吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000047:dialogue:000": {
      "source_hash": "sha256:d993cb531272be30ad95d46a1d5f50368883a80c29f6c09de26ff9d5156c0cc2",
      "text": "嚯。汝竟欲对身为暗之眷属的吾，施以试炼吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000056:dialogue:000": {
      "source_hash": "sha256:741b36aae5176e474348fb40e1125d50904e4a1febbec058530d79baf460ae33",
      "text": "哎。你愿意考虑他的事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000061:dialogue:000": {
      "source_hash": "sha256:e842b0bfe0c9ffbadb108b37f94b4575d0e9c87f260314b45022c9580036a917",
      "text": "是啊，嘛，虽然情况不太明了，\n但也不能对有困难的人置之不理吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000065:dialogue:000": {
      "source_hash": "sha256:967b9e6dd05dd36911307568514b05d678eaaecf95915042931d129e37065e08",
      "text": "那么，阿斯兰先生。\n厨房在这边，请进。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_i:cmd-000081:dialogue:000": {
      "source_hash": "sha256:ca0357e82a2792f2e6df4d9b10c23cef263399f2e5d0ab4e6c31f5d65792b379",
      "text": "……哈哈，什么嘛，东云。\n你自己不也是个大好人嘛。",
      "status": "draft"
    }
  }
}
