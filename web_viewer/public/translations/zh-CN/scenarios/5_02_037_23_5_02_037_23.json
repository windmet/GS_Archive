{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_037_23_5_02_037_23",
  "source_raw_hash": "sha256:c16bc06eb525a2e9616983a44ef94b0eaf2c6c00ebb6e91cba97765d584e1683",
  "entries": {
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000020:dialogue:000": {
      "source_hash": "sha256:6baac5661e09d5f89dc1e2061122da2d09bba4eedbfbf765f3347bcb60fc20fc",
      "text": "好啦。祈愿既然也做完了，\n要是彩票能中奖就好了呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000026:dialogue:000": {
      "source_hash": "sha256:75145ccdecdb0dd6aa2eb27ec425d3943783cf57585fa1ff196dcb23beb17c38",
      "text": "要是中了的话要做什么好呢。\n制作人酱有考虑过吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000032:choice_short:000": {
      "source_hash": "sha256:b5dd7d0d940d826fed504798cd8dc7cb449b47609dfedd0556661da134da0f08",
      "text": "买想要的东西",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000033:choice_short:000": {
      "source_hash": "sha256:b556a13757525952d170101e66b6e44fbde97495692747bfb8a137fb078fae22",
      "text": "为了将来存起来",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:a79abaa97335decfbf8c41ece5847c2c05c9be1ad1bff954c2be70b8adb6490c",
      "text": "真不错啊，梦想越来越膨胀了呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:f8770b1c195fcdd17f536cf0102085d9438f0d3947e2ca1ae7d24a85bfd20eb2",
      "text": "要换成我的话，让我想想……啊！\n首先得好好感谢一下制作人酱才行呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000053:dialogue:000": {
      "source_hash": "sha256:9cdd30ae9c9d0649fbb6fa2b6f65ca187aa8914f7b5861e3b2df530a68bdfa8f",
      "text": "我可什么都没做呀！白色情人节的回礼\n也已经收到了，再多的话就……",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000059:dialogue:000": {
      "source_hash": "sha256:2e7640d18e62a96823fdc889b9d37de6e95b5fccc594efa8f131d8f5e6d16cd9",
      "text": "在说什么傻话呢。\n那是那码事，这是这码事吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000066:dialogue:000": {
      "source_hash": "sha256:003230c3b7cc0250b8cbd9b1e4e4ab5d750991fac01aa3502f2edda09e5b311e",
      "text": "而且平时也一直受你照顾嘛。\n这点程度算什么啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000071:dialogue:000": {
      "source_hash": "sha256:600de1257165f6fb874389fa69828fdaeeb5908d03e298a70a64dc95faccf5d4",
      "text": "……不过，现在就聊这些，\n也是八字还没一撇就打起如意算盘了吧，哈哈。",
      "status": "draft"
    },
    "story-text:v1:5_02_037_23_5_02_037_23:5_02_037_23:cmd-000077:dialogue:000": {
      "source_hash": "sha256:62a358fc069f7e287990e50f09522b939d6accbe536c04af372e6bd51a6d3de3",
      "text": "嘛，就当作是中奖之后再来享受的期待吧。",
      "status": "draft"
    }
  }
}
