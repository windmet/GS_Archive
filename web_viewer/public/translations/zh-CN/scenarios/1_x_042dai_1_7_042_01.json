{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_042dai_1_7_042_01",
  "source_raw_hash": "sha256:2fde45206d1b29e0d1a666a111dd3563753a8d076083d73dccf61a24102762d5",
  "entries": {
    "story-text:v1:1_x_042dai_1_7_042_01:1_7_042_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:d64650116da4584c60b5a2c1cfe25274744b835aa5c87f509ec79a9ec49a08e5",
      "text": "今天也是您的生日呢！\n大吾先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_7_042_01:1_7_042_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:83f41661b0990a30c0a633464f14db7daa9901f2d2d5cbc1e7b614839d7f9a96",
      "text": "谢谢你啊，●●●●●●●●●●Boss！\n俺超高兴的！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_7_042_01:1_7_042_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:91d03e0c3c39f1482df93eeb947902f44bb471afdb962d661a3e8e6ad77d4bb5",
      "text": "而且，祝贺俺的时候Boss脸上的笑容，\n就是最棒的礼物了！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_7_042_01:1_7_042_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:e3ddc23ec266e52f20f8c29fd0480b2b29c227a77f374ba4b486495b04cec0dd",
      "text": "收到了好东西啊——！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_1_7_042_01:1_7_042_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:4c34e34f453f89a96361450eafb45d9ba7caf0b2f88617965cce1ebb2dfb23bc",
      "text": "多亏了●●●●●●●●●●Boss，\n感觉今天一整天都能挂着满分的大笑脸度过了！",
      "status": "draft"
    }
  }
}
