  "scenario_id": "1_5_028soi_1_5_028_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000012:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000012:title:001": {
      "source_hash": "sha256:e09a2e01d29c3cbba1e48ab5720ef9afd30a754608ca1dc1afb09e4df26e1ddb",
      "text": "TV资讯节目外景记者的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:8f3b9862fc54dae021ecd5d2be73c571f2bddbdaa6b409d110a45ee1e728da94",
      "text": "电视机前的各位观众，大家好。\n我是Cafe Parade的东云庄一郎。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000024:dialogue:000": {
      "source_hash": "sha256:39ebfd058748a7c92120ee9184f1f686140fa49d85c474a0668c268519757805",
      "text": "今天我们将造访在这附近举办的、\n世界各国点心的盛典。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:c005fce62e40cff3982cc326d28377d52cca7b8d03ea68b4c1bd2c0e80727a07",
      "text": "究竟会有什么样的点心呢？\n那么事不宜迟，让我们去会场转转吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000041:time_caption:000": {
      "source_hash": "sha256:43a477e6e5a8dba6c90c681f36a5d0145af69b1f6b5c14ffcf1d57086762257d",
      "text": "报道结束后……",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000045:dialogue:000": {
      "source_hash": "sha256:bdb8a4acfe308c61ab04f38642fbb85b196ef22e0d240ecd6c9dcb4f929a91a7",
      "text": "庄一郎先生，辛苦了。工作人员说\n您的报道非常通俗易懂呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:add53cefa0f3da3b0b5ecc172059391d798c710b3857c341086ba514934b3c5d",
      "text": "接下来，要采访为了这次活动\n特意来到日本的著名甜点师了对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:271a5ef72ab0ac9880e14e1fdbab900d932b84e83f3a0960003a50e43f2ddb34",
      "text": "是的，终于要开始了。稍微有些紧张起来了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000054:dialogue:000": {
      "source_hash": "sha256:9e45fcd908be9be74ec0fbdabc18ea3b5a3687418c72594e856ee3571154ddfe",
      "text": "毕竟能向他这种级别的甜点师请教的机会，\n可不是常有的。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000056:dialogue:000": {
      "source_hash": "sha256:c5f8ee63b2d6c2a9bd8e8a15f824b638ee13813560f98646f26b4ab533675533",
      "text": "要能听到各种各样的趣事就好了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000063:dialogue:000": {
      "source_hash": "sha256:6ef61d6e064e70c1e97a738ae7ae14cc8f179b57e1399fc1d710ad29c3e610e4",
      "text": "是啊。……哎呀，采访好像要开始了。\n那么，我去了。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_04:1_5_028_04:cmd-000066:dialogue:000": {
      "source_hash": "sha256:d7e5ee54fd382c3ee468764e8264fc9a6f83aea3bdd0a101b7ca54450e705d91",
      "text": "好的，请加油哦。\n路上小心！",
      "status": "draft"
    }
  }
}
