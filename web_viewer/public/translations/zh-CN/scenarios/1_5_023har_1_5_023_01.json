  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000011:title:001": {
      "source_hash": "sha256:3a16d6b35c51ea7e8b168fa672af043132d75ccda8244ab2b1ad676d7739c130",
      "text": "罐装咖啡广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:c54459edd4d751dfd03ffba0f25155107b1000bc12ebd58b01f72b70b67e31f9",
      "text": "接下来就要开始拍摄罐装咖啡的广告了吗？\n终于……终于等到这一刻了！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:6cb9a2eaff82a7eac26ceadcfd76b28a47f2d11ca5a47cb77e1e64fc243b6770",
      "text": "很有干劲呢，春名先生。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:43dfcb8061427225aa8538800ced99b368fe6f50c06ff6ebbdf3221b325682b6",
      "text": "春名先生明明不擅长喝苦咖啡，自从决定接下这份\n邀请之后，我就一直稍微有点挂心呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:6971bb29e0a7f5124311fd6acdab599380111af91531f2eb9929e184423e7755",
      "text": "嘛，不擅长归不擅长……",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c135a11dee01360593065933e920d69396ffbfaace485dd7f1658aacee5978c9",
      "text": "难得有人特意指名找我，\n果然还是想回应对方的期待嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:b647517b17712f26c666efc04ec1fb7a0ec5d86aa40b52fcdc01d007f946e1e0",
      "text": "而且试喝的那款还挺顺口的，\n没问题的啦。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:c94efd5fd0ef80050aef8bf4cdfc81e8ef6beec169ecd367c4b6562856ea3759",
      "text": "我明白了。\n拍摄请加油哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000059:dialogue:000": {
      "source_hash": "sha256:629faf00421503bc562bbaa4d15797d879edd5b70727f20eaf2d48826b9c31a1",
      "text": "“哈啊，好累……\n诶，是慰劳品吗？”",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000066:dialogue:000": {
      "source_hash": "sha256:ff35e4f58cc54c22c6718378a3e0c840ced27128880675da3febf38d87b7bc21",
      "text": "“这款罐装咖啡我之前就很在意了呢。\n太感谢了！”",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_01:1_5_023_01:cmd-000071:dialogue:000": {
      "source_hash": "sha256:7df185bb0fe4e9d8f2272fe8f41e2bbb1a8072be9442b94497a519d6925808eb",
      "text": "（喝完咖啡后的灿烂笑容\n得到了工作人员的一致好评，收录大获成功！）",
      "status": "draft"
    }
  }
}
