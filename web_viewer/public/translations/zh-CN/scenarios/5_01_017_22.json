{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_017_22",
  "source_raw_hash": "sha256:7d5ecb5c900fb114cbd2b9386d3895d4e4ea18cbd19bebdb1941a83452ca9763",
  "entries": {
    "story-text:v1:5_01_017_22:5_01_017_22_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:c7de6a54a619652c4372198994ac94402423e5265359bcdbc9ed741eaa5745d0",
      "text": "喵喵！？ 是情人节巧克力喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:5f35bc89737a2d02020b3ba7e9a9e36338a59e4d0f98e5df72355c33db8c937e",
      "text": "●●●●プロデューサー君， 太感谢你了喵～！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:00475e5b2dffc670298766553d930149250a2683c8b9d0b1714d96b251a5e9e1",
      "text": "吃下这倾注了PASSION的巧克力， 毫无疑问立马就会力量满满喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:5d1b8d38359903076eb8d9f4a7b71e68d6e2c9f47007f422a72d782a78ffebbc",
      "text": "接下来的工作，也一定能轻巧飘逸～地 华丽完成啰。",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:6333165b57796bdf2eb404bd2d3ce96087f7df61e10f725a15dc99c59695e9f5",
      "text": "所以说，制作人君。 人家也等着你再多送点巧克力来喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000017:dialogue:000": {
      "source_hash": "sha256:b3f104b1a6436ecdb87825550616fe64c6d7426dbda4040a6ee51bf90f5305dc",
      "text": "这个巧克力…… 吾辈已经察觉到了喵。",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:f7a687c67129de3ea958a93271d53e51f4c5204cb25f521866665898d8286b11",
      "text": "从制作人君手中接过的瞬间， 吾辈就已经感应到了喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000031:dialogue:000": {
      "source_hash": "sha256:7aab6bdd530d7c37ac0a695a3805bee98af65ecd555f365c4fd86cdf09167ed5",
      "text": "这份巧克力里，装满了●●●●プロデューサー君的 浓浓心意！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000033:choice_short:000": {
      "source_hash": "sha256:c910da11a0af95239fb828603f4ab23d8f2819284d3db745612c3325a8670f64",
      "text": "是的！我在里面注入了PASSION！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000034:choice_short:000": {
      "source_hash": "sha256:88f69bff2272ce0beb0bf6bf9e97be0ba7e6b406620a6d062b007e150a15aade",
      "text": "我在里面装了满满的心意！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000042:dialogue:000": {
      "source_hash": "sha256:48dbd3128022059c792b4d96d84c787eea7985d851c17b96f1af10116ce80c27",
      "text": "PASSION！ 哎呀，这倒是出乎吾辈的预料喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000051:dialogue:000": {
      "source_hash": "sha256:976997eaa583ddc5e40630711fd2cf7299623564f45f4285a39778896e3d8a1b",
      "text": "果然！ 吾辈的直觉猜个正着啰。",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:ee9e24060ea970865bb10113ea4d786d1d7c14fc1da221ab8c46bd1447887f32",
      "text": "制作人君的心意， 吾辈已经郑重地收下了喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000068:dialogue:000": {
      "source_hash": "sha256:0b19fa6220f3efef63f6d88d098f71d222da55cc951784d2d785d1738beeb081",
      "text": "这份回礼，到了那个叫白色情人节的日子， 吾辈会好好地、加倍奉还的喵！",
      "status": "draft"
    },
    "story-text:v1:5_01_017_22:5_01_017_22_b:cmd-000075:dialogue:000": {
      "source_hash": "sha256:3a2171cb22a26f3a2a61ac16a66fb6ced8396e3f277b733b50fb46441804316d",
      "text": "从现在起就请怀着扑通扑通的雀跃心情 好好期待吧喵～！",
      "status": "draft"
    }
  }
}
