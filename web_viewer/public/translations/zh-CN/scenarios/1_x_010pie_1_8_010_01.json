{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_010pie_1_8_010_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_010pie_1_8_010_01:1_8_010_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:72e9db8011ea6e307643b9e722cd95295504cf4a970e006f3ace4eb400ca282c",
      "text": "早上好！……啊，●●●●プロデューサー！\n今天是生日，对吧？祝你快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_8_010_01:1_8_010_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:b0ea19a93ad34313ad4b8729617de3b52af4fdf514f6baadf30a624322592f86",
      "text": "你看，青蛙玩偶也说，●●●●プロデューサー，\n祝你生日快乐呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_8_010_01:1_8_010_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:65f0e230de6695ddbf9d33226c0e97591c0e8d3c61a3bfbcb202eb78d6937993",
      "text": "皮埃尔先生，\n非常感谢您！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_8_010_01:1_8_010_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:fb27486d50017e5142fcf768a4dc1cfbe9ac242752e0e113ee979972ed722181",
      "text": "能为●●●●プロデューサー庆祝\n生日，我真的好高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_8_010_01:1_8_010_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:4d00d3d38260b69bbb37fa68cb7a2806bbb484889c31fdcb14a4c15750251951",
      "text": "满满都是笑容！\n一起度过开心的一天吧！",
      "status": "draft"
    }
  }
}
