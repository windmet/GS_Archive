{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_015_23_5_02_015_23",
  "source_raw_hash": "sha256:cd5eee61a9e0c5e2a6d543a4224b34bbc7a32d3bdb983ed7e00cb32f2fc61760",
  "entries": {
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000018:dialogue:000": {
      "source_hash": "sha256:064a8656fb3a7342497913f41b0469eebc1f59e382c11a25eef4cb483f290fe1",
      "text": "对了，●●●●プロデューサー！\n我有东西想给你。",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000023:dialogue:000": {
      "source_hash": "sha256:ab0ee740d670e3465a72ea12ac0e027b160a7575ba12827f92ec7e465de9213a",
      "text": "给，这个。是情人节的谢礼！",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000028:dialogue:000": {
      "source_hash": "sha256:ead3f1610655a396e58db8e2e2f05eb78393ac1b4988fa25762d58d4db2a4a3d",
      "text": "因为平时总是从你那里收获幸运，想着要是也能让你遇到好事就好了，\n我就编了一条祈愿绳手链。",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000031:dialogue:000": {
      "source_hash": "sha256:e3f3f85114a3f832b281e08eed69855254b922ccf1f1e50862a129bc959386f9",
      "text": "非常感谢，真开心！\n我会好好珍惜的！",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000041:dialogue:000": {
      "source_hash": "sha256:9ad524064b9555bff79006d3040ef840683351b5d35e574bf46502e4fc8b532e",
      "text": "真的吗？\n嘿嘿……被你这么一说，我也很高兴哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:8759a49987e20b235f33ae60dbbd10c54e49245c44322b856c1efa83461ff6b4",
      "text": "……啊！不过祈愿绳的话，不断掉的话\n愿望好像就没办法实现呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000054:dialogue:000": {
      "source_hash": "sha256:e6ae4013463216dda8507de17e663c04cf9b7b0e96bf019df6f3f9a5a6a55cb9",
      "text": "虽然想让你好好珍惜，但又很希望制作人的\n愿望能够实现……唔——。",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000059:choice_short:000": {
      "source_hash": "sha256:06e64f1af3168ef8e969cc2fb4f48ee639c04a4acd1b66d46c6a88f939764acc",
      "text": "断掉之后我也会好好珍藏的！",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000071:dialogue:000": {
      "source_hash": "sha256:95399e324466cfabd3d7fe323417705d39670ca4cb4da1ff852e3360ae1a45eb",
      "text": "原来还有这招啊！",
      "status": "draft"
    },
    "story-text:v1:5_02_015_23_5_02_015_23:5_02_015_23:cmd-000077:dialogue:000": {
      "source_hash": "sha256:7c5f7b2701f5582ef3f27f62236bca4426b4c5d53afcb911544c9c1b4414193d",
      "text": "要是祈愿绳断了请告诉我哦。制作人的\n愿望到底有没有实现，至少这个我很想知道呢。",
      "status": "draft"
    }
  }
}
