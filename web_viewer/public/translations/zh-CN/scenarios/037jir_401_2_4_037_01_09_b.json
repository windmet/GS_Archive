{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "037jir_401_2_4_037_01_09_b",
  "source_raw_hash": "sha256:0b8bfbc1326057aa351c29b238214330b6e5d204aa5314cd4c93f21b174c3cd7",
  "entries": {
    "story-text:v1:037jir_401_2_4_037_01_09_b:2_4_037_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:c5a42a35ee63c7bb17ad266e4dede0adb16c413911f66f0c9774b6b90606f42f",
      "text": "等等，不能乱玩手机啦。\n……咦？已经接通了？",
      "status": "draft"
    },
    "story-text:v1:037jir_401_2_4_037_01_09_b:2_4_037_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:1b5935958f2f134db20ca498095bb75d605fe1b5dce72ba8510a3d8f9a3f8f2e",
      "text": "那个……●●●●プロデューサー酱？\n哎呀呀……突然打过来真不好意思。",
      "status": "draft"
    },
    "story-text:v1:037jir_401_2_4_037_01_09_b:2_4_037_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:a04375d0d6b5e85284b049b867d9fa7f0022bdbcba2382bc4665f58832d7fe35",
      "text": "音乐节结束了，我难得来一次猫咪咖啡馆，\n结果猫咪碰到了手机。",
      "status": "draft"
    },
    "story-text:v1:037jir_401_2_4_037_01_09_b:2_4_037_01_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:ce569c3f37d14b3eeac6415dc2262afc0b3d4c08a8b012ce79163f85514e18ca",
      "text": "手机屏幕原来对肉球也有反应啊。\n哎呀，连大叔我都吓了一跳。",
      "status": "draft"
    },
    "story-text:v1:037jir_401_2_4_037_01_09_b:2_4_037_01_09_b:cmd-000023:choice_short:000": {
      "source_hash": "sha256:93c2bc3f4409e517a36605ecf0af8217888765932187b81f6b6c0c95c45d2ec8",
      "text": "呵呵，我也吓了一跳",
      "status": "draft"
    },
    "story-text:v1:037jir_401_2_4_037_01_09_b:2_4_037_01_09_b:cmd-000028:phone_message:000": {
      "source_hash": "sha256:353be76e706cd67ef5699e7afec64b772125c7a86c9a85f54ee109114a63887f",
      "text": "哈哈是吧……喂喂，爬到肩膀上很危险的啦。\n那就事务所见咯。",
      "status": "draft"
    }
  }
}
