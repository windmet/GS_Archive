{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_035mco_2_1_2_035_12",
  "source_raw_hash": "sha256:0cfc38ea855ce4071bec209568f3e183b59dd3a1e3dd16b1ec619bbba75b9174",
  "entries": {
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000000:title:000": {
      "source_hash": "sha256:1e9e420cecfc139e01a1d218c63a01c75234efdb0173fcd7854c2b53a755f2d2",
      "text": "一如往常、又胜过往常的快乐夜晚",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:ccd03962a9ae4ca94390df6bbd6ca7c0eebce52f2ccab059eb868fc9fa3e4010",
      "text": "S.E.M聚集在次郎家。类提议在道夫生日\n那天去吃晚餐。作为生日的筹备，\n类负责调查道夫想吃什么，次郎负责选店，\n大家分头展开了准备。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:6f5107bd91ef41f31b6c9df2188e0706848a55c22bfe3d6efc5529dc2373fbf7",
      "text": "今天是Mr. 硲的\nbirthday dinner呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:f8c94587bff4911017c976fb50e865d8c377b6e9abd5fe80482054fe2180797e",
      "text": "Mr. 山下，\n准备工作辛苦啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:07d50def72c66b09325dcb8731fec872a1e537d27755c748b133b5996ab0bc1f",
      "text": "说什么呢，类你不也\n一起参与了吗。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:9d4e0cf276a398e508d2578be300de5f9d74ff11f9181829d3a0de0ac2aa66b7",
      "text": "还准备了那么大的一份礼物……",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:2a3e14485e7056c242c7429e3308a6e2a883ae812d2bc1ff670e2366e3e7cb04",
      "text": "毕竟The greater embraces the less嘛☆\n好期待今晚啊！",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_b:cmd-000017:dialogue:000": {
      "source_hash": "sha256:e242813541522d1b73568b19a272532bdc53162f8d1edfd3256e7a53d846a0e0",
      "text": "Present收到有高兴吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_b:cmd-000020:dialogue:000": {
      "source_hash": "sha256:7569da5cde7a656a088686ed225c7fb159ca21dbda14328c4a84e98fe813483d",
      "text": "嗯，那是当然。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_b:cmd-000026:dialogue:000": {
      "source_hash": "sha256:3933873c95e1edd5ee2e190a3d53bec9d4998428edad63f727bacf36b1a6c1da",
      "text": "没想到你们居然会准备\n那样的礼物。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:170529bbb5dc0186f9cb91ad45ad0f4ac52ef290816fd47094af2f019d923ad5",
      "text": "是舞田君挑的吗。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_b:cmd-000041:dialogue:000": {
      "source_hash": "sha256:6e3376a1f98547b4c27f5ad511dc727c525de1dc8fc2e41220c490d4e10decd7",
      "text": "Yes！\nMr. 硲要是高兴的话，那就大成功啦☆",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_c:cmd-000018:dialogue:000": {
      "source_hash": "sha256:d55ea1bd41b5120ecebb9093eeb450123b1d23fdb4d578cd10bb3483bae6e495",
      "text": "挑了一家很不错的\n居酒屋呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_c:cmd-000021:dialogue:000": {
      "source_hash": "sha256:5513955febc96ccc9d018fa41f0a7b60938a156de828687d6e7a373602d2aaf5",
      "text": "噢，很合您心意吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_c:cmd-000028:dialogue:000": {
      "source_hash": "sha256:1f026f72f98093b984d8d1dd71e788df246a3eaacd283d2f55ea9709bedd2913",
      "text": "那里是我最推荐的店。\n偶尔会去喝上一杯……嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:2d0c0f1864bedfbac400f0d92a9ae43bf1b759605c18745e34bd5479120d86ce",
      "text": "赏脸的话，\n下次再去吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_12:1_2_035_12_c:cmd-000034:dialogue:000": {
      "source_hash": "sha256:3ea2f09652bf7b3a07b2a341e114e84d48acc929a1fcf447f2d338e57b749ccd",
      "text": "好。",
      "status": "draft"
    }
  }
}
