  "scenario_id": "1_5_038tak_1_5_038_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000010:title:001": {
      "source_hash": "sha256:914b19b715e2594d58f785b571bd3594ec5a8a4b63accadcffaf3df33fe2fc9c",
      "text": "饰演快递员出演快递广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000014:dialogue:000": {
      "source_hash": "sha256:dc457729b7ab2b576e83357e5a91d2435f0377fc6bc3e6b6f232643a801b29a9",
      "text": "拿着这个包裹跑上楼梯就行了吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e6e2592e7af9eb38eb4b01a25ddf2e7d3d2edadd79449b08e017c8c48a672b5a",
      "text": "嘿咻……嗯？\n箱子明明很大，却非常轻。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:214857bd9b3fd1abd4ab71f5da4c8730c61db2ee3f19f01cc358176dd8f18dc9",
      "text": "因为要全速跑上公寓楼梯，\n所以似乎特意把包裹减轻了分量。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:93bcbd6a686cb6987b73ec1e1cf0391f395e238157b26d0d4b5a130d31694b5f",
      "text": "这样啊……但如果可以的话，\n我想用和实际快递员同样重量的包裹来拍。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000032:dialogue:000": {
      "source_hash": "sha256:b9e452937c104b87bf7a839d122e0ffc5cae4e7d250eacf179923f819c3144dd",
      "text": "那样肯定能拍出更好的效果。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:d191b4696d70f70c6c666861e28a2021875b5daebf905e7575b5260efc111a6e",
      "text": "也许确实是那样……",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:ac214352b1bc3a8ee4b9a8db0d2492fa54c987cf69d07cec48136d0058966e5e",
      "text": "我吃得消。让我试试吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:9e94dee8bc6d41186625d3718ca8d9884bd4f5fd59f38fc435248a9c79e04aa2",
      "text": "……我知道了。\n那我去跟导演商量一下。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:d9ac246a0cedaac74e0e74bfdd48e6f56c1bb96bfe5af07ea6b613e88efc10fa",
      "text": "武先生，导演同意了！",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_04:1_5_038_04:cmd-000056:dialogue:000": {
      "source_hash": "sha256:50f236f329f5d589fbad7c08f63d26ef3d7a07d06fd7e8389519f9c389b4a3cd",
      "text": "谢了，●●●●プロデューサー。\n那我这就去拍摄了。",
      "status": "draft"
    }
  }
}
