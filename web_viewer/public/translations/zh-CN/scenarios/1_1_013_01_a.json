{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_013_01_a",
  "source_raw_hash": "sha256:755f1d5ed21884dd603e672c079c3ab14300986229b0f7944f90d66bef52d484",
  "entries": {
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:737811db70a015a367074274ca52c88a644739f5f9a9c13c914c0fb7b820387b",
      "text": "汉子们的战斗理由",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:395581e31a1e1220cddd110a1132a373119b4081aaee4364c073131ca2245d4c",
      "text": "因事故导致格斗家生涯断绝的道流，\n在从医院回家的路上，偶然走进一家拉面店，\n邂逅了命运的一碗。数年之后，\n拳击手武出于某种原因，\n敲响了偶像事务所的大门……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000012:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000012:title:001": {
      "source_hash": "sha256:737811db70a015a367074274ca52c88a644739f5f9a9c13c914c0fb7b820387b",
      "text": "汉子们的战斗理由",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:da73a06e54f635d4dc4cc325c920046efe1c02d3aae7d5d6697960dfe4d59e85",
      "text": "欢迎光临！",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:8824f3dd5bf339d60c110bd66c3ab0d6e01fc04a01d17cfcb5b5256db21ff49c",
      "text": "来一碗拉面……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:ff24dc74a7d1117be99a53c4e09776e90f6ea329b27506b63cf29d84a0610115",
      "text": "（不知不觉被香味吸引，结果就进来了……）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:1425b9cc27208a23f3e23888839ca021bd749e876fbc95e20a80a37c89e49e51",
      "text": "（就算在这种时候，肚子还是会饿啊）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000061:dialogue:000": {
      "source_hash": "sha256:7319a9905ff38adb377d0fbcb7e0c8700e5451556a5d304bbde4a2625fadeec7",
      "text": "那么，请多保重。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000063:dialogue:000": {
      "source_hash": "sha256:54d8d0e2410dc87322ecd04110ccec41fc40e0549f03c000f5dd60d8f942228a",
      "text": "好的，非常感谢您。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000084:dialogue:000": {
      "source_hash": "sha256:ca77d474c41174882058ce7b2cd88cbfe7fd539096e13b30702de84342a29426",
      "text": "（……已经不能再参加比赛了……吗）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000090:dialogue:000": {
      "source_hash": "sha256:b47628f7bc349e9dc6b5439c90c567db1cc362e19c6db86ebe94c669df9bf347",
      "text": "（真没想到，刚转入职业就遭遇了交通事故啊）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000096:dialogue:000": {
      "source_hash": "sha256:c87f48df4091ccf9a9f09b5989927a1ccdc8d7d533c9de2f7ae45caf22980db8",
      "text": "（幸好没有生命危险……\n但这伤势，作为格斗家而言却是致命伤）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000101:dialogue:000": {
      "source_hash": "sha256:552106d931021efbc653a3a60af3128a673f0d75574ba99722e1e9798b4c29f4",
      "text": "（格斗比赛中，瞬息间的攻防就能分出胜负。\n要是无法像以前那样行动的话……）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000109:dialogue:000": {
      "source_hash": "sha256:79b33d16b9b193ef9d04f41fef5bbe7d8e1004898e347cf5c797f87b495a5624",
      "text": "……我的梦想，也只能在这里放弃了啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000114:dialogue:000": {
      "source_hash": "sha256:97bb7ea5ab98da666ba36eaf8c8731cd7600b23fc96536b35b62504edb431d49",
      "text": "咕噜～……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000121:dialogue:000": {
      "source_hash": "sha256:7cc031d69f4168d02b10d2729618872e05c63090591c9be44cdc6aeed43d9995",
      "text": "哈哈……去吃点东西吧。",
      "status": "draft"
    }
  }
}
