{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_005_01_d",
  "source_raw_hash": "sha256:f317a4313c8391be3ec272b19453fb539e31117b2ebbfd6b86b02c7ab13dfd03",
  "entries": {
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000021:dialogue:000": {
      "source_hash": "sha256:20066411b72f5ba17a3318b6b66a80b85c293313f07b9984946f31b03cf0dbce",
      "text": "……咦？这个便利店塑料袋……\n是薰先生买来的吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000025:dialogue:000": {
      "source_hash": "sha256:2553fc75f54a042a260c2cd5af215301400b3b2241903f25c8f525fe23813f6a",
      "text": "饭团、布丁，还有运动饮料……\n难道刚才出门，是为了去买这些吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000030:dialogue:000": {
      "source_hash": "sha256:5a0a7deb1eeabeb3564ba02f6b3b006ef5918498596becdf59801e31a2b8e24f",
      "text": "我挑了些对肠胃负担比较轻的。\n那种程度的话应该吃得下吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ad46fd99a48d54ccf491eae84c7bf6f0745a2de965187c89e82a4e7fb8ad16b3",
      "text": "谢谢您！\n正好肚子饿了，太开心了。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000037:dialogue:000": {
      "source_hash": "sha256:3729a075afa68f8df1c3393001f4b9586657d01a05a58f8bd7684b145293cb11",
      "text": "你该不会想告诉我，熬了通宵之后，\n连顿正经饭都没吃吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:be60dd565f5cce74d250cc39b71c4e55a207bb0909fa1fcfd766414a5d3aa817",
      "text": "……对不起。下次我会注意的……",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000042:dialogue:000": {
      "source_hash": "sha256:db9b1909bd075ade689f87a1e0279c8fa8a071c98533eeacfdf4590635a6533f",
      "text": "知道就好。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000062:dialogue:000": {
      "source_hash": "sha256:ae7706b077044d4713c4221dcecfc861511bf5f38522f7fbe683656b0a5ce5b6",
      "text": "（薰先生开始看起剧本来了）",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000072:dialogue:000": {
      "source_hash": "sha256:97855ea669728f0d67d735d268cea5152e6b5ea8c843ac75dd34033d9e89daa5",
      "text": "……您还不回去吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_d:cmd-000076:dialogue:000": {
      "source_hash": "sha256:b52f69a98d54cc3c01da30ba76bc85d5c7031be1dbbea7c3ac01b712317e6bb9",
      "text": "……啊。我还打算再待一会儿。",
      "status": "draft"
    }
  }
}
