{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_007kei_1_8_007_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_007kei_1_8_007_01:1_8_007_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:4d2368bf70eb35a4f41a7cc8aa0ae092be368d59f8c97d8b65ef240e4a36bfda",
      "text": "今天是●●●●プロデューサー的\n生日呢。我是听丽先生说的。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_8_007_01:1_8_007_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:62447461a9819c17ef5a55cbd8ac0d7387b2204d5acb259cb270d9c8f9dfbec1",
      "text": "呵呵，怪不得大家的声音\n都透着欢快呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_8_007_01:1_8_007_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:4b187ecb3421d18f7921d6c7a53e453ca6ecfa3d2247d9eeaeef79c45db1d22b",
      "text": "能让我也送上一句祝福吗？\n●●●●プロデューサー，祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_8_007_01:1_8_007_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:e028bf85a4059cdfb2d5de8d6151ea6dcb55819fbd3d030dabaa843a8ac1248d",
      "text": "非常感谢。\n我收到了非常棒的赠礼！",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_1_8_007_01:1_8_007_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:6d3c769e9bf27a663fa418206429f930c63902c77d9a1d979e6f06b1da2b33a5",
      "text": "你能喜欢真是太好了。明年我也想再像这样\n为你庆祝呢。",
      "status": "draft"
    }
  }
}
