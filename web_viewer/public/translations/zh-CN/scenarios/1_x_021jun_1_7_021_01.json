{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_021jun_1_7_021_01",
  "source_raw_hash": "sha256:ae53f874f7bd617d20687e9ad8085915d6631a2603fdb1a6d0202fe6a02d6c25",
  "entries": {
    "story-text:v1:1_x_021jun_1_7_021_01:1_7_021_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:17dcfe103bc69344f8ed3c22338908747334b4dec17daecff9b8bf62ded90fd1",
      "text": "旬先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_7_021_01:1_7_021_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:b01f9c20bbfb5c906e8dca1956fd03832e2731c6d363bcb82a0279581a40edd3",
      "text": "哎？生日……我认为比起庆祝，\n现在还有更应该做的事情。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_7_021_01:1_7_021_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:177a89556a9345f3215eddcc2720c2e16022a137ebdf3b5b8d8f8efcd467bea8",
      "text": "315 Production是刚成立不久的事务所，\n而我们也还只是初出茅庐的偶像。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_7_021_01:1_7_021_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:2591fc424f73f71afcc64872d12a738ad7f6f845bd8ca443e5716d9a7285d932",
      "text": "啊，不……我不是不高兴……\n只是不太习惯这种事情……",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_1_7_021_01:1_7_021_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:fdae99aeba262f59ab4df4e6747fdbcaa89e5e2b5222f4c2d7774738959008eb",
      "text": "那个……●●●●プロデューサー，\n谢谢你。",
      "status": "draft"
    }
  }
}
