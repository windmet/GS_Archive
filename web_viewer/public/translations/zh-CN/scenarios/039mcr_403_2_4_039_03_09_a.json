{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "039mcr_403_2_4_039_03_09_a",
  "source_raw_hash": "sha256:6e577eb0411561ea35ee96ce3eeca62baf87b57d5633df617f94132894a2487c",
  "entries": {
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:99ca81820b726e435bca5b6ae5b24d77faf5eff2653ea1c937393e2cc916a00e",
      "text": "啊，●●●●●●●●●●师父。\n那个录像，师父已经看了吗？",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c018e93256f361d661bdd863f9ec37265f70be63b95277f55f4c8eb606ba12f0",
      "text": "外景地的夜景，是不是超级帅气！？",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:a363c9041cdccd3e9167096276bc360f526c87d9f64fbb22ca7f055e407095b4",
      "text": "确实非常棒呢！",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:016295559f26128ab57e6b97e94ffd2ba3e7a85a11877289a3af118e5e028945",
      "text": "看着画面虽然很美，但实物更加\n有魄力，好想让师父也看看啊。",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:40c6021f2116bd54bb666caa03533f86398371bdf84a55d98733f8edf438ca1a",
      "text": "……对啦！不介意的话，下次\n要不要一起去看看？",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:3be5372ee19603dbc450aa256c143b673311639ed2d1096d9337497913a20d3a",
      "text": "拍摄前我发现了一个人气的拍摄地点，\n我来给师父带路。",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:7a8b62a8342ee068719852abc9b324ab1eeb10576bf9202ea3e577d7ddbcf362",
      "text": "听说从哪个角度看都很震撼，\n肯定会很有趣的！",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:728685484381b6a2bf2ad8416384a613b33284f61fb0860fdbb036caa5e37b5e",
      "text": "请务必带我去！",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:b733be1a984a91593c9b085a2fd4424cc9e2547ee4639a0af9e6f55a642bd453",
      "text": "那就拜托你带路了！",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:ef06363ee4cb033c187fd25c636c7d8025816a38e9682fd563962c3afc46b0f6",
      "text": "好嘞！师父都这么说了，\n提前查好攻略真是太值了！",
      "status": "draft"
    },
    "story-text:v1:039mcr_403_2_4_039_03_09_a:2_4_039_03_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:c00453f945ec93f8f172437fae809c6062240d0fa0d5f4795ec51a727534ffc8",
      "text": "下次见面的时候我们对一下时间吧！\n那么，辛苦了。",
      "status": "draft"
    }
  }
}
