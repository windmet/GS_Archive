{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "033shr_401_2_4_033_01_09_b",
  "source_raw_hash": "sha256:b6046261fc94262da935f8f109cfae3ab9ad84c086c74b995ad4b58863fe1e7f",
  "entries": {
    "story-text:v1:033shr_401_2_4_033_01_09_b:2_4_033_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:1c7a52ad9cdbada86cb2a5e97221836974a8f1dd208ea7e0a1e4926b990e0810",
      "text": "哟，●●●●プロデューサー。\n听我说嘛～",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_b:2_4_033_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:a7ca7d5929d046372a4887b69df4d27903871e62d834c9e14232c00ae8be1993",
      "text": "我光顾着展会完全忘了做作业，\n被老妈狠狠训了一顿……",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_b:2_4_033_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:33f86cedc293d532fc5c828870516dbb1e3ac2863b022837315ed713f8cfeb75",
      "text": "要我帮你看看作业吗？",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_b:2_4_033_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:050e26dcc443d141447d9b3f32e888d4b2d0a2a41cee9f8be1018dd5f17aa3de",
      "text": "真的吗！？真不愧是●●●●プロデューサー，\n太靠得住啦～！",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_b:2_4_033_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:4ffad93ceeeef4f3f2147bf7f8fa86e31067d289da284e254f144a7b64178ef3",
      "text": "那我明天把作业带到事务所去哦。\n拜托啦！",
      "status": "draft"
    }
  }
}
