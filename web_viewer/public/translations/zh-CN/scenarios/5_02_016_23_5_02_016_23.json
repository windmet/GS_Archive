{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_016_23_5_02_016_23",
  "source_raw_hash": "sha256:af95c16e5c7a59ac213f76cc000db39663b594d2a394fc1e9efbadfc9274819d",
  "entries": {
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:f851f2ffe1259802cd457d9f5a95c8182c8850a68e8357a56a422282213c73ca",
      "text": "辛苦了，●●●●プロデューサー。\n不好意思，现在能耽误你稍微一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000023:dialogue:000": {
      "source_hash": "sha256:39fb937856586f824d45bd31079a228ead6b8a08917b666844f58b667e471584",
      "text": "好的，完全没问题！\n工作正好告一段落了。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000026:dialogue:000": {
      "source_hash": "sha256:e0485d7f2980ce90dd0f7a8bd59cbc12e82dc0d3fc49c96bc3e148823e65e313",
      "text": "这样啊。看来时机挑得很合适呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000031:dialogue:000": {
      "source_hash": "sha256:3d1a1d5ec7d6787fcb6c60371a94eba223a73742a0fb8b9b043aa07671556c91",
      "text": "我准备了对情人节收到的巧克力的回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c3d4a800b7ad5774ceea3bb9e920bd00f0b3dd10ca20dbdc630217cb30f6388c",
      "text": "考虑到平日忙碌工作的制作人的健康，\n我选了全营养食品。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000038:dialogue:000": {
      "source_hash": "sha256:f6b9b77a8c634edd76813831803ee502faabf45de8a098d9687f0bb39486e319",
      "text": "在肚子微饿的时候，或者\n想调理一天的营养平衡时，随时都可以吃。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:f600970fa6916ebf731ae004920275ef9dd7702e7229e406cb70cb279d312313",
      "text": "直接吃也可以，加工调理一下也很好吃哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:05b2cf453f88bf8abf4516d826f89529bb6be6379b177736caf854a614ed9732",
      "text": "非常感谢……！\n我会吃了它好好加油的！",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:e4139fbb82a5c9b88b4510edeee33b0859c1da1b2f1958994e4f00a4e0ddd6bf",
      "text": "由平时总在依赖你的我来说虽然有点怪，\n但也千万别勉强过头了。",
      "status": "draft"
    },
    "story-text:v1:5_02_016_23_5_02_016_23:5_02_016_23:cmd-000054:dialogue:000": {
      "source_hash": "sha256:b2d749ac838e69c505f4ab0439e826ea2829a78c4a88773aca30899835dd0f5e",
      "text": "要是有什么我能帮得上忙的事，随时跟我说。\n我马上赶过来。",
      "status": "draft"
    }
  }
}
