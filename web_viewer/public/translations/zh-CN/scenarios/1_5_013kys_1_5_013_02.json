  "entries": {
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000010:title:001": {
      "source_hash": "sha256:c84aa87af6c2df55bf6873e439bb423c9b96577e149a279e8588a5c06c68db6f",
      "text": "新款休闲零食广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:5690ced99f5fa825b0ea07cf9910793a928e4d90e0d198aa771b5ace118d07e7",
      "text": "享介先生，零食广告的工作定下来了哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:315abb644bc664834957f88ee9f6e64d147dcfa4b55edd075733f2f5d7d86a9b",
      "text": "诶，真的吗！这家零食厂商，我和悠介\n经常在便利店买他们家的东西！",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:3755d126b1e35dca912082b3ca8ec54f6f2bf0c3183f0261906e04d643a7bf8e",
      "text": "前阵子他们不是搞了零食大选吗？说是获得第一名的\n零食会推出新商品来着……",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:31300487211562648d9ff7a4b2a81a975defd308ba8b59860beb44bd43e5b7c6",
      "text": "零食容量居然比平时增加了1.5倍！\n●●●●●●●●●●监督，这不是很厉害吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:7fde028ac5afdbe0d1b3a366f2b5bbf5388e2c6a6b3152f8b501cfd56faaadf5",
      "text": "确实很厉害呢！\n据说是为了纪念大选第一名而限时发售的。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:767b69ea4516614d3604152963cf9754ca37e900ed5ae91cabf2bed472120763",
      "text": "这是那则广告的资料。\n感觉会拍成一部相当独特的广告哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:c3527c5df77e9fbaf9b05a567488071eef05b72d1a9d494086397ee6a13109b8",
      "text": "诶，是这样吗？啊，这就是概念啊……\n啊哈哈，这是什么呀。好有趣！",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:1c86478de1f2a38ae9fd5422ba343a13c4773e710b42c13707c77d2ca9e49fc6",
      "text": "为了表现出增量感，会有大量的\n零食造型抱枕掉下来呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000050:dialogue:000": {
      "source_hash": "sha256:1caf80828e4dbe440c776b981041de9476f80ff3b9cc50a9b1ea8810056d3cd7",
      "text": "感觉超级好玩的！真想快点开始拍摄啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_02:1_5_013_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:74a983b610d32c5df26c4c09779b3b8e248a6f8d7cc22b90d58fde3e436e35a6",
      "text": "嗯，确实呢。\n那么，我再为您详细说明一下资料吧。",
      "status": "draft"
    }
  }
}
