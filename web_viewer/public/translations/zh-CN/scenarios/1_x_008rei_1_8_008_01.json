{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_008rei_1_8_008_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_008rei_1_8_008_01:1_8_008_01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:f927f8b1135182008ef7a6f5c709df3ee70948823df0f3406ffe0a2255587573",
      "text": "……啊，是我。抱歉突然打电话给你。\n现在方便占用一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_8_008_01:1_8_008_01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:07a9e2049c2561b67bbc41e2a4edb1bcd7e7938d1a235838269966c3f1610b0c",
      "text": "这样啊，方便就好。\n今天应该是阁下的生日吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_8_008_01:1_8_008_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:ab98ce20832243d9f523abf12c817a943ae090cdee9ace52f0795b235e0e2bac",
      "text": "祝你生日快乐。\n祝你度过一个美好的生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_8_008_01:1_8_008_01:cmd-000016:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_8_008_01:1_8_008_01:cmd-000019:phone_message:000": {
      "source_hash": "sha256:7b5f521fec84f2a9726f6010f2328968ca7f10778d66906bae3963df2577a46e",
      "text": "不用客气。今天一天也拜托你了。\n那么，我们事务所见。",
      "status": "draft"
    }
  }
}
