{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_013kys_1_7_013_01",
  "source_raw_hash": "sha256:631dc5ffdcdcd8e9daeedba3c8a2c3cdeb928f04a8161cb429e7a06addbd786e",
  "entries": {
    "story-text:v1:1_x_013kys_1_7_013_01:1_7_013_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:ce102472a4020d5333ce84d9cf70e723f492d1199a06ca786c0c167a003fa70e",
      "text": "享介先生，今天也是您的生日呢！\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_7_013_01:1_7_013_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b3aa2b0c6361f73829ca5340772885fd2782c9a1f3f4d9093d6b18f9d7e2c313",
      "text": "哎，只有我？\n……这样啊，悠介是另外庆祝的啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_7_013_01:1_7_013_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:c1323b1194e8489e4744a42e32fdcdc2ebc566fb4471b1b8967164c39893d481",
      "text": "平时生日总是一起被庆祝的，\n稍微有点吃惊呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_7_013_01:1_7_013_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:f0a2da886e43a7293824756b627a174883c04d2233f5722204c482cf94f356f8",
      "text": "感觉挺新鲜的……\n怪难为情的。嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_x_013kys_1_7_013_01:1_7_013_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:2d07c7a10dd1fa7bd5a9a23c671ab86e4bf8a8fe007f7019617080f74b7b35b5",
      "text": "谢谢你，●●●●●●●●●●监督。\n我超开心的！",
      "status": "draft"
    }
  }
}
