{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_002_03_f",
  "source_raw_hash": "sha256:e17c8c924b4c6899c1ab8bbdde4cd84fcf8a4d3773006a672496946ef68fea68",
  "entries": {
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000029:dialogue:000": {
      "source_hash": "sha256:6cd4f0caa2530e2213e719ce52ee9065db5ab1fec23a93b726299fd0b4991c2f",
      "text": "唉，别说全答对了，简直是一塌糊涂。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000035:dialogue:000": {
      "source_hash": "sha256:11fa2181575571f601d501cd57bb3bd2d67d1fa81a5276a93545f5e7e43dbc75",
      "text": "是我不好啦。但是关于我的问题，\n享介不也答错好几个嘛。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000042:dialogue:000": {
      "source_hash": "sha256:4f35f7359669119f0db6dad8d2d2ba8a0de62d18c57757e7725a4af128bc33d2",
      "text": "那个是……没办法的吧。\n因为悠介你自己乱了阵脚，我也被带偏了啊。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000045:dialogue:000": {
      "source_hash": "sha256:2aef9c125e93e3e5898f659e49ac8d8fc4d37b61c8b91942c9f8c6483acf4866",
      "text": "…………怪我咯。",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000050:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000054:dialogue:000": {
      "source_hash": "sha256:721544a3e77bec0f9f58af4119419ca45708300be7f97bd7ade37710989239aa",
      "text": "……算了。我先走了！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000064:dialogue:000": {
      "source_hash": "sha256:6899fc0bc8c94f19c9155cabde18ca5790eb23c70aadefb9c191754ac922e793",
      "text": "啊，喂，悠介！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000079:dialogue:000": {
      "source_hash": "sha256:4963d3c453b554bf899ef3c3c62b32ea797d8857fc184b8b3c88624f66f40b2c",
      "text": "（那家伙……明明规则是两个人一起冲线啊）",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000101:dialogue:000": {
      "source_hash": "sha256:c5b01b2bcc3a1b8325320f4d7d67bf7798e52f7701e0baa53b8567ee0ce7fcc9",
      "text": "喂——，享介先生！",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000117:dialogue:000": {
      "source_hash": "sha256:6dacade7739de6df723e566d2ffef4a0ee34dca6dd6b2b9747832d35bcac1807",
      "text": "朱雀，还有玄武？\n你们大老远跑来这里帮我们加油吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_002_03:1_4_002_03_f:cmd-000132:dialogue:000": {
      "source_hash": "sha256:6b78d07ec6f0b43a20a54cba0d4d2d08d24dccec0396109ff4a172b51a6ef620",
      "text": "嗯，从会场那边赶过来的。\n比起隔着屏幕，我们更想直接到现场为你们打气。",
      "status": "draft"
    }
  }
}
