{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "017kir_401_2_4_017_01_09_b",
  "source_raw_hash": "sha256:362701b00d84d07fe467382b6fa073872ffcc2b7508cce8852f30e1a2096093b",
  "entries": {
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:01065066947d489aab9377359b5362d3f409a1f214f1fb7387b30c3c6a456720",
      "text": "●●●●プロデューサー君！托付给吾辈的\nCD宣传，吾辈想跟你商量一下！",
      "status": "draft"
    },
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:649d5e619f82823190361070366d43ede9d0b902855e9910dcc6f793ebff1e11",
      "text": "明天，希望你能陪陪吾辈是也！",
      "status": "draft"
    },
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:979814068de8ceb26de58f00c63a01ac15f7fda59f18f146ff3ac72b85d23ee4",
      "text": "吾辈想着这个也想放、那个也想加，\n结果一下子想出了好多个方案喵！",
      "status": "draft"
    },
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:9837012a5fb8c8694d0b884f9e1d38fcc2fa76a6efb6a862a36bd22d830b97b9",
      "text": "哪个都想拿出来展示，但考虑到时间\n又不得不精简成一个，吾辈好犹豫喵。",
      "status": "draft"
    },
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:59c55d4b878df63d50ff372587f8319ae3821c1cf3fe8c6bce31cf184b4a7c34",
      "text": "明白了！",
      "status": "draft"
    },
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000015:choice_short:000": {
      "source_hash": "sha256:1328858b72076382b4434a1d60241e572fa393e0e21d8022ddd6bd6bcd0ca477",
      "text": "包在我身上！",
      "status": "draft"
    },
    "story-text:v1:017kir_401_2_4_017_01_09_b:2_4_017_01_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:035fc94c059d5601ab2242c4d53f44d9af9596f52db82e42b0a7fdb8cb04c083",
      "text": "谢谢你喵～！唔唔，这么说着说着\n又有灵感了！后面的话就留到明天再说喵！",
      "status": "draft"
    }
  }
}
