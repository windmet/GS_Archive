{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_019kur_2_1_8_019_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_019kur_2_1_8_019_02:1_8_019_02:cmd-000014:dialogue:000": {
      "source_hash": "sha256:784f9e43d4b4f2f767b25cfc94cbac6957daa9b59ba631b8ed795206102f7b72",
      "text": "距离下一次出场还有一个小时呢……\n●●●●プロデューサー，现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_2_1_8_019_02:1_8_019_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:52bddc608117e80fb36c2ad8342cb81cd5ee425160c78e07325894e9a7e711d4",
      "text": "可以的，怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_2_1_8_019_02:1_8_019_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:5d98ff3aeea06f3a814e69ffd052ead934b926bea41348aa120422404290076c",
      "text": "太好了。因为我有无论如何\n都想传达给您的话。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_2_1_8_019_02:1_8_019_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:d919e43e3a82dfb1848d940b203211008571845a41e798a37cdeb0488637824d",
      "text": "●●●●プロデューサー，\n祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_2_1_8_019_02:1_8_019_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8610c2fa1dfdaef930b3212e794dd0a295774fec1a10e7c5a0df35c57b4b0007",
      "text": "一直以来为我们尽心尽力，\n真的非常感谢您。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_2_1_8_019_02:1_8_019_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:089b5eeb1f6f8d9e02f7b64793b1c114256ad40ff6ecfc7a7f2d613f268f43a3",
      "text": "虽然我还不成熟，但今后也会继续精进，\n往后也请多多关照了。",
      "status": "draft"
    }
  }
}
