{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_e",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000022:dialogue:000": {
      "source_hash": "sha256:fa4587fbf4da3f2de639bde39f47792eaddcc2053e880a367f959875d3125591",
      "text": "神谷。\n有客人来吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:b87ecbcace6441725fde5b6f47570aefe0a3fe31179e9d1377025cc6e68606df",
      "text": "啊啊。外面有个人没打伞被淋湿了呢。\n我就请他进来了。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000040:dialogue:000": {
      "source_hash": "sha256:b95c3fdf58ce31ecf96ed6f75d8322f949ef78cebe8afe983d291ac0f0baea0f",
      "text": "看着挺冷的，\n打算给他泡杯红茶。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000045:dialogue:000": {
      "source_hash": "sha256:e88a18f50c2cc2e67c790f2f0055a1ecad68d2c98f329c1ffad30bcbd42d3c93",
      "text": "那么，选哪种茶叶好呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000050:dialogue:000": {
      "source_hash": "sha256:b8c2a047d18dadcbd457e541113841fa3bc6c9f3499b740f444e77aa62b20405",
      "text": "不介意的话，把这个也带上吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000055:dialogue:000": {
      "source_hash": "sha256:71bb2a34e8b2eb9e3cb7b5694d4fe6c0edf386eea0b5265f73cf475f8f488533",
      "text": "这是……巧克力的点心吗。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000058:dialogue:000": {
      "source_hash": "sha256:6385d93b098add1a81b059cd613f240ce29372ca46255f40306b7ffdc158508f",
      "text": "是的。新菜品的试作品。\n希望能合他的口味。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000065:dialogue:000": {
      "source_hash": "sha256:48a2f0f3f22963a2e2c31be30c2f253e94499d669d553500bd6a26467fee39b2",
      "text": "谢谢，我一起端过去。\n既然这样茶叶就……选这个吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000069:dialogue:000": {
      "source_hash": "sha256:b639918317b685c53dd5a444fe04d4877767495f7d52b7c490b1b8ec39fc40ab",
      "text": "那我送过去了。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000086:dialogue:000": {
      "source_hash": "sha256:10f4b390b945569a427c2cf74c920f1d5519e0319f187984cd7ef78619b1d337",
      "text": "（……真是的。你还是老样子呢）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_e:cmd-000090:dialogue:000": {
      "source_hash": "sha256:d8a4d9b531b72cd4658efa824cffa6883054306ebf39870c87156f6fe5c948aa",
      "text": "（一看到无处可去的人，\n马上就会捡回来）",
      "status": "draft"
    }
  }
}
