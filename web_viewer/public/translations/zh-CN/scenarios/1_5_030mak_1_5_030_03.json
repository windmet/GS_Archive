  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000010:title:001": {
      "source_hash": "sha256:a93c5b3ecd7bb95e3c69a36f0b61aa950a1727bb2a35832bdbe2dbe4a5204af6",
      "text": "冰淇淋CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:58338fa6739c7e9de2f6e0e84d16baae70b8ad4abec9f4e66afdfb80bcb0c296",
      "text": "卷绪先生，冰淇淋CM定下来了！\n这是资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:258b3d9a069c4488b57959930e45d980ac13c81d2809b7a16ea6727502c3dbf6",
      "text": "哇，是知名连锁店的CM啊……\n这家的冰淇淋超好吃的！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:37d2c4c3a423e51b743b59f94237f206390a4ab909832505cb2b20cb6f8b07d3",
      "text": "我和咲酱一起去过那家店，\n因为口味太多了根本选不出来……！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:5134923cf2c62ccf7f605f42867313656de84d7b7d468d2d402d671bae90125b",
      "text": "后来我们买了不同的冰淇淋互相分着吃。\n两种口味都好好吃啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:424ecdffc64044e801a7b013aee08f30b7f28ad6f0ca33c2d00d9a30d049a8f0",
      "text": "呵呵，卷绪先生和咲先生感情真好呢。\n这次的CM是宣传新款冰淇淋。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:e8ef73b2a9280c9c02450817b39abb9f2a7c2e729c2786868de9ec8f5a5601a4",
      "text": "新款冰淇淋一共有两种，\n据说全都是期间限定口味。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000052:dialogue:000": {
      "source_hash": "sha256:054e79a0ec469adbf622f7e033b02f6a3743213c96ee69eb0e1b42764b0daed6",
      "text": "两款都好色彩缤纷啊。\n到底是什么味道呢？好在意！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000057:dialogue:000": {
      "source_hash": "sha256:95d843e4ccd79ea0195fd4b6ef503778ae8d0dd736fb607892596bfb7b2e0485",
      "text": "听说过几天会把试吃用的冰淇淋\n送过来哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000063:dialogue:000": {
      "source_hash": "sha256:8ab6387db521bc9d980d236cf313ea8e70adb27801237ef619b7a3942d27f95c",
      "text": "真的吗？太感谢了！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000070:dialogue:000": {
      "source_hash": "sha256:162d94c7257a342f54b2d80c3832264fd20e95527ecec3cab782d7e5014889e5",
      "text": "能提前尝到冰淇淋，好开心。\n我会好好期待的。",
      "status": "draft"
    }
  }
}
