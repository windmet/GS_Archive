  "entries": {
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000010:title:001": {
      "source_hash": "sha256:45291d930da3aaad46c4380f7c5168496f65021c5e7aee121043a543548e69a4",
      "text": "纪行综艺节目外景的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b7e818aa38ecfbca26ffc721abfc3758a6ecf2020f9bf7a4d006d35bb2783423",
      "text": "这次外景的起点是这座城市啊。\n从这里辗转搭乘巴士前往目的地对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:fc18a1f6a1762ae6885bdc026837f9ec0ebbd8fb449ae825e20579374beecb05",
      "text": "虽说目的地是确定的，但途中全看掷骰子的点数呢。\n感觉会是一趟有趣的旅程。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:0ee8f32e25f9a58ae3fdfe6d02d83524790d388310576386567a4a2ea19ee725",
      "text": "途中路过的店铺也需要您帮忙介绍，\n拜托您加油啦。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:8542b92e326ae36fd32e1234c9b3f1fc8ce3e8b07bab9d2cc26f7b725eb3c540",
      "text": "嗯，真期待能遇上什么样的店铺啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:b6baceccc70e194450478d98d7502cee20acd8e7e07cbae385cee7c55822f792",
      "text": "对了，给Cafe Parade的大家\n买些土特产带回去吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:6a299e86e972d37d208d65d1ee40cad04b9871d7d002e9869d4d21d57d76ea0b",
      "text": "大家肯定会很高兴的。\n啊，说到Cafe Parade……",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:3bbbcecf19075a49801e61404bc44c30b279e1b836c7e598c4099971bb409cfc",
      "text": "嗯？怎么了吗，\n●●●●プロデューサー？",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000044:dialogue:000": {
      "source_hash": "sha256:3c6cf6c13c490171e381eb54bdca9d07fdbe37c9cc43981366b37dde599878d9",
      "text": "成员们都很担心\n幸广先生会不会迷路呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000051:dialogue:000": {
      "source_hash": "sha256:6fea9ead990a6d71651c2b72a33fd1deb1d9c1fd985acfd18690c7bc97b2d00f",
      "text": "哈哈……大家也太爱操心了。\n没事的，我早就习惯旅行了。",
      "status": "draft"
    },
    "story-text:v1:1_5_027yuk_1_5_027_01:1_5_027_01:cmd-000055:dialogue:000": {
      "source_hash": "sha256:99c3b6e25ddcccd6094f72d6e64d706b7b2dc3102a37ff1a6c87bb51a24243d1",
      "text": "好了，录制差不多要开始了。\n今天也请多关照，●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
