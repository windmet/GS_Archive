{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30001_01_c",
  "source_raw_hash": "sha256:e398adf12581c9f63fddc6e6f679290fad998927871bdc2b7c153d679ebb7172",
  "entries": {
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3a4ac9ac8dba1e6be7aa7de6d0d50742702a9d028062caf1780e846b04dc503f",
      "text": "●●●●プロデューサー。\n有点事想跟你商量一下，可以吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000026:dialogue:000": {
      "source_hash": "sha256:1c2e9689aae396f036d038da029f692095bf5e286fb9d425e7f7389a21895036",
      "text": "实先生。好的，请问是什么事？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000030:dialogue:000": {
      "source_hash": "sha256:be112ee24d0038df5e1b077e911d50841e91bf7b9307c0055eeb7cadd5449512",
      "text": "其实我过阵子要参加老朋友的结婚喜宴。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000033:dialogue:000": {
      "source_hash": "sha256:ce7576696ecc2f738b2a0da4c8f1bffa797c5c841425f34f343581d293cbe28e",
      "text": "作为祝贺，我想和Beit的大家一起\n登台表演一次。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000038:dialogue:000": {
      "source_hash": "sha256:8c6fa254e3132830049c5f8d5be75009dff6cc61db164f9e6cb36f4b34b66032",
      "text": "新郎也很热心，\n还同意了进行拍摄，你觉得怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:cbada3d793b8c2375b0a4d3d6ff8371bd45e287a5ca42e81e889c5f41e47eac5",
      "text": "真是太棒了。请务必去办吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000046:dialogue:000": {
      "source_hash": "sha256:5ae58b54970a2a62b72be6729438121b80644f3136009390195d8fa23c35e2a8",
      "text": "谢谢你！\n我会去跟皮埃尔和恭二说的。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000059:dialogue:000": {
      "source_hash": "sha256:0722f76bf67df588b21e6383ed8c5b04b2e84100a2756450acd48d537f3adcbe",
      "text": "在结婚喜宴上表演什么的，\n虽然让人有点紧张……",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000063:dialogue:000": {
      "source_hash": "sha256:9250391480184d72c5b384df287aa3d807153399cabd6bdac9e0ab60f0182a00",
      "text": "不过，我会协助的。\n毕竟平时一直受实先生关照。",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000067:dialogue:000": {
      "source_hash": "sha256:bc92a5ff8a738b1a299e91f45f808e80c9b00f5de40003efb7ae8149500da0bc",
      "text": "我也想去！",
      "status": "draft"
    },
    "story-text:v1:1_3_30001_01:1_3_30001_01_c:cmd-000073:dialogue:000": {
      "source_hash": "sha256:dac1f9ca45efc7ea147a41873fb957674449920873b57072f5667b03f702c0dc",
      "text": "要给实的朋友送上满满的祝福！\n然后，让好多好多人都露出笑容吧～！",
      "status": "draft"
    }
  }
}
