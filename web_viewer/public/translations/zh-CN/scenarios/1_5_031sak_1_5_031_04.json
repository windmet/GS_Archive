  "entries": {
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000010:title:001": {
      "source_hash": "sha256:7ff67eecee3a41fb6218b7a634fa66be8a47bd40efaa89bfa34c7ffd9296dcaf",
      "text": "接受杂志特辑采访的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000014:dialogue:000": {
      "source_hash": "sha256:434b7335d0f89054d419cdf49c1bac00f73d75ffb1ca74685cc37f86970911c3",
      "text": "咲先生，拍摄辛苦了。\n采访安排在休息之后。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:3ab21a704efc94645700e206ced0181ccafc1ed4d90786d8bfc2a8c8a3318ace",
      "text": "好的～采访我也要干脆利落地搞定♪",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:4fc0ab716f88f2e83e368ade8159f5cd6c6471c95597d395b6114792ec80b663",
      "text": "拍摄进行得很顺利，干劲十足呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:db537c66dee21e0263900a1f44f1900c9de4f68adac29237d0bf5c810663c38c",
      "text": "毕竟那可是我每个月必买的杂志，\n还能给我做特辑哦？",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000038:dialogue:000": {
      "source_hash": "sha256:f7c05f1add810bca0b6c50ef7378fb6b881a51369d6bdf4f73474af4f687873f",
      "text": "超厉害的对不对！\n听到工作内容的时候，我超级开心的♪",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:d4b81b23c958e7d2980da87e273542a915446afd354f6aa802b471324ea0003e",
      "text": "唔，采访的主题是“朋友”对吧。\n聊到朋友的话，果然还是卷卷吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:e185609da6213ffe48281c6883a6f4846b71a3d5c83861a828f85bd8a5aa2e58",
      "text": "你们两位感情非常要好呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000060:dialogue:000": {
      "source_hash": "sha256:ea0c1bbb56a7abd88f84c21c39f2451f4b4562fe691829a6eb2384b6b20f771d",
      "text": "我和卷卷可是挚友嘛！\n对啦，聊聊前阵子一起出去玩的事好了！",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000070:dialogue:000": {
      "source_hash": "sha256:9892974328c31eeba5d9b312bd3b9eb91fc9856d7a31b79e2c330fdcf96acdb6",
      "text": "啊，聊聊一起去吃蛋糕时的事好像也不错？\n呜～想聊的太多了，好纠结哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_04:1_5_031_04:cmd-000074:dialogue:000": {
      "source_hash": "sha256:063852a14ea75bd2c34bd1ece7afe01faea2c2dff3c8fd65cf75dc18291e8b36",
      "text": "呵呵，咲先生的采访，\n我也非常期待哦。",
      "status": "draft"
    }
  }
}
