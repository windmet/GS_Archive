{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "049eis_401_2_4_049_01_09_b",
  "source_raw_hash": "sha256:fd5eb0d3f49f12e6d299487081d963ac558142eaac132fb162c4111381ebb9a5",
  "entries": {
    "story-text:v1:049eis_401_2_4_049_01_09_b:2_4_049_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:f96b4f3ef2d418e4e5e877a04cfb43125a51764ddf14c60c9b129bcaee545931",
      "text": "是我，●●●●プロデューサー。\n交谊舞练习用的鞋子送到了。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_b:2_4_049_01_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:d5bfcfbab04fcbea213f430330bbe582fb1d51d871fc8dfe7a8b5772a3d4569b",
      "text": "活动起来\n感觉如何？",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_b:2_4_049_01_09_b:cmd-000009:choice_short:000": {
      "source_hash": "sha256:6c50c696efe7fd78e58ec49a8846f811e1b964ebae74c2317a4d569e931cdf14",
      "text": "穿上去的感觉\n怎么样？",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_b:2_4_049_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:36106c5994d0604b1299fc54e9e86b5cb653849a4e07b0fe1ea1e48c63ddb00b",
      "text": "虽然不真正练习一下\n就无法做出准确判断，",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_b:2_4_049_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:59248e0cdcfc4e23a1eb27fb361f7e80f302f4437a9391c451e2ffa826e30298",
      "text": "不过若是用于普通的舞蹈，并没有任何问题。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_b:2_4_049_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:5c364cd1090464d7e89766bf9f1dc5cec87fa44299e7dd229598a03167915f6a",
      "text": "练习中若有不适感，我会当场说明。\n百忙之中打扰了。先失陪。",
      "status": "draft"
    }
  }
}
