{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_004ter_1_5_004_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000012:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000012:title:001": {
      "source_hash": "sha256:1337a7ee2a59c9b755f206b7607cf5a5d17b1889d28eb360e39161df56e485d1",
      "text": "专科学校广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:3bc8d55b3acccb66853772f81fd5124039254bea3b162b1acc8df31187079e8f",
      "text": "“你们的话，一定能成为想成为的样子的！”",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:622a5e9f6851645ba333393978a039c8386136a9cd852cbc23284a40856acc3d",
      "text": "“朝着梦想，和同伴们一起努力吧！”",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000034:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:cc8e9203e6ca0d11b9346f2f206e240db2222c1c36aa599ae804dbc2b8e2098c",
      "text": "拍摄结束后，您被学生们\n围着聊得很开心的样子呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000043:dialogue:000": {
      "source_hash": "sha256:925157bcb79bee598eae17b53b78d3e383a6b91246be8260ed02d49d67c537cc",
      "text": "参与广告拍摄的，\n都是实际在这所学校就读的学生对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000046:dialogue:000": {
      "source_hash": "sha256:616753f50959f1f60d5dde843d21b82b11bc7df9819d47624348a686292661c4",
      "text": "嗯，被问了学习相关的事，\n还有司法考试之类的问题。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:0cba13906fb685aaa82e90ede730fb7cbbca53dfe298d2fcfdc4e2651c5ee7d0",
      "text": "当学生的时候经常会感到不安嘛，\n只要能答上来的我都想尽量回答他们……",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:462a6a95861b6689911645f6fae31e968515c518c4ddfae96146c87f99264bb0",
      "text": "集中注意力的方法，还有高效推进学习的方法，\n我想我还是教给他们了的。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000057:dialogue:000": {
      "source_hash": "sha256:3071f4c8e399a5c0fa3a130eb7e8812ef681515f1474d9c73d33a77db19a99d7",
      "text": "大家都很认真地在听，真的超级开心啊！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000061:dialogue:000": {
      "source_hash": "sha256:46930db17b1fd097db3a74b44e2d39c0e78e2385b0b49fa6a67781912b4a2037",
      "text": "我觉得也是因为辉先生教得十分热心的缘故哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_04:1_5_004_04:cmd-000067:dialogue:000": {
      "source_hash": "sha256:176b17d41679aeeb43490bcb66558b03fe7c0cc883f708a4fa3bb0715e49f9f7",
      "text": "哈哈，是吗。被这么一说感觉有点不好意思呢。\n在现场能有这样的相遇也是挺不错的啊。",
      "status": "draft"
    }
  }
}
