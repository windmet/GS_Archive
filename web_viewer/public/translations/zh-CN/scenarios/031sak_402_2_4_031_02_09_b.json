{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "031sak_402_2_4_031_02_09_b",
  "source_raw_hash": "sha256:6d568f0a1108a19828ec102f2e25ae687c75f7dc8821566095ade38a0f7c6e5c",
  "entries": {
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:18741574ebf1c7211159c040f423f3127a4c77d915702e3414159df4a8b44b9e",
      "text": "●●●●プロデューサー，快听快听！\n在今天的练习里我打出了好多全倒哦！",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:44595f00473410e838d26780d2a7609dfb5109ef9fd1e39c9eb94bb8433d72f4",
      "text": "前阵子感觉还像是碰运气，\n但今天完全是靠真正的实力哦♪",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:b5a51cf35f5942a36c0ce84c2b44bc7ff57628d93e3955b0edb6d67ae5416713",
      "text": "恭喜你\n这是练习的成果呢",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:89472aed21c2099176f79a3bb7d15a9b9c1f2d7eb8343511ae5a90b8731bdcde",
      "text": "真不愧是你\n好期待正式演出了",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:8c261ab19952bfe53e0f5032d652d5d63696aa2390a43d9f7c7b3a7aa14cca15",
      "text": "诶嘿嘿，谢谢你，\n这样一来就不会拖大家的后腿了呢。",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:830b3c72c6da2c60e037d5989716008b9661dc6403b7d17bf2383726b39e3de5",
      "text": "下次我打算稍微挑战一下\n面向中级选手的练习。",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_b:2_4_031_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:a1bc7f9e980fccb4ccec5992bb96775e0e6e8431293392f2276604d22d9f448b",
      "text": "我会给制作人和大家\n带来惊喜的哦♪",
      "status": "draft"
    }
  }
}
