  "entries": {
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000010:title:001": {
      "source_hash": "sha256:84e5d9bf4cb35905045ff2fc5693315c3288b68db08127c59fec28bd485cc6cb",
      "text": "铁路公司旅游推广的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:5ffecf953522ad14979f3766d9d143ea1afc40cf9bd465225e7b539328a44aee",
      "text": "薰先生，铁路公司旅游推广的工作\n定下来了！",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:32231060b0db76bc30d0b15536c764e75c12adc15d8ce89a0011c62393d31845",
      "text": "这份是实际要前往的观光名胜的\n清单和资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:83b3c75e31079d1a9bb82e036a3264c06a2f1cd61884ebbfa0cf184875b01c90",
      "text": "有去过的地方吗？\n听说会有关于观光景点的问卷调查。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:7b0f8add4b4a4d9f6f9f5e6b458c27588af8f7813c2b672826bd50300e7c383e",
      "text": "不，全都是没去过的地方。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:48e30c3c23db71f7929c22b39135a333bd8189d7001cd63fe321a1c7652bf12b",
      "text": "清单上的观光景点，也仅仅是\n在电视或杂志上看过的程度而已。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:d4bbb72b3042646b4b8bc87266f07394dd39da4b4dc3b0af80a038407ef90ad5",
      "text": "问卷是指这个吗？……原来如此。\n要写在观光景点想做的事啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:6d267a8d4163e72219e2007a29f10688e3c86ed1561daa5a36da53ba4b7d4f90",
      "text": "有必要对这些观光景点做详细调查了。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a0f9a18ffb7172edea9b024a59840f30c9a0a7c925b544f018638cd845d41f38",
      "text": "如果有需要的东西，\n我会去安排，请随时告诉我。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:4996bc8f324b05b089c551aa739cd2efd758799e97823c2ca8e6fdf6942f59a0",
      "text": "嗯，知道了。接下来我先去书店，\n买些能作参考的杂志回来。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:26803cd49c2054e4e6dce3a43c06198209573bdd9070c73de711a0d8dd6a3e1d",
      "text": "如果还是不够的话，就拜托你吧。",
      "status": "draft"
    }
  }
}
