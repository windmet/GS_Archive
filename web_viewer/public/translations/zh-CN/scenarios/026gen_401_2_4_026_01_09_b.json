{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "026gen_401_2_4_026_01_09_b",
  "source_raw_hash": "sha256:e428fee731f4fd18b3c320cb04d1bb611910625c57ba238a283a00ebca1271fe",
  "entries": {
    "story-text:v1:026gen_401_2_4_026_01_09_b:2_4_026_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:7c2fa16a7bb7133e232a4a8377e4b37c5a81263c33574b5f20a2dc6ba8d15057",
      "text": "……喂，●●●●●●●●●●番长？\n签售会和演唱会辛苦了。",
      "status": "draft"
    },
    "story-text:v1:026gen_401_2_4_026_01_09_b:2_4_026_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c9ac466b1ecb8ec3411b4c21576da24eccfc03de47463ff7915d31591c18a653",
      "text": "尤其是演唱会，气氛真是太热烈了。\n粉丝们火热的心意直接传达到了我心里。",
      "status": "draft"
    },
    "story-text:v1:026gen_401_2_4_026_01_09_b:2_4_026_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c1c1e9fcc093f8a0613b0a3b5b821308260d1e360e88b0f20d0a9623557f5ad3",
      "text": "在●●●●●●●●●●番长看来，\n我们的演唱会怎么样？",
      "status": "draft"
    },
    "story-text:v1:026gen_401_2_4_026_01_09_b:2_4_026_01_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:2128156de5921bb586c01b6c15e7959b835fe98e34ef0789a31252cebf094b82",
      "text": "是一场棒极了的演唱会！",
      "status": "draft"
    },
    "story-text:v1:026gen_401_2_4_026_01_09_b:2_4_026_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:7844a5815df8ebd8f8df9f9248aa39799f9c95cc61c024671a1c55ffe5349f1d",
      "text": "哈哈，那就好。\n那么，明天见啦。",
      "status": "draft"
    }
  }
}
