{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_033_01_e",
  "source_raw_hash": "sha256:d01a89d9e11a63ff01ca2d78fdbe367e9c635b17f385bc031b128de6db15c9ec",
  "entries": {
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000021:dialogue:000": {
      "source_hash": "sha256:628a912f795a9ab23d6dd046c4662d8f1799829daa99e8e8222aeea9852135ef",
      "text": "终……终于写完了～！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000025:dialogue:000": {
      "source_hash": "sha256:b4576e566253b738788b35863a6f9428832ecce4d5a7e8da7007512c83a1ad13",
      "text": "真不愧是你，志狼君。\n辛苦你了！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000027:dialogue:000": {
      "source_hash": "sha256:8f4411522ceb83fcdcb2f648b4d683aa4a7e4b64ebf887ee22805d1dfae3fbd8",
      "text": "一开始虽然很苦恼，但最后\n基本上都是你自己解出来的呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000034:dialogue:000": {
      "source_hash": "sha256:1a84f5fc099a06564360d1c1283bf5cab210bf0108a6b5b959172cecdd7bafe0",
      "text": "对吧——？\n我要是认真起来也是办得到的！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000040:dialogue:000": {
      "source_hash": "sha256:03aac66c9d89758d48ecfb6e6e7da14543980f90e641d609944dd1e52d2813c1",
      "text": "而且……●●●●プロデューサー教得\n也超级清楚！谢啦！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000049:dialogue:000": {
      "source_hash": "sha256:a304a916338ac48f49bfe51aeb90bc36a19904a9b0584c4688ef0f878ef1fac3",
      "text": "这样就不用挨老妈骂了！\n好啦，有想看的动画所以差不多该回去啦！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000055:dialogue:000": {
      "source_hash": "sha256:404490ceede9bd7ae81defc6f64faa2fb0a8835c3990963f89cfeb9839786dc2",
      "text": "今天谢谢你，●●●●プロデューサー！\n这份人情，我会用工作来还的！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000069:dialogue:000": {
      "source_hash": "sha256:ac03036097c495fbc01b45c07431455051cd0bc4f2c82cc2837e336626e85126",
      "text": "呃，那叫什么，出世后付款？是叫这个吗？\n不对吗？算啦反正是那个意思！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000078:dialogue:000": {
      "source_hash": "sha256:0856803ed53fe365abd426b604d94a7ed7dd6fd4cd0299bebecd9133536752b3",
      "text": "那我走啦，辛苦啦！\n明天见——！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_e:cmd-000082:dialogue:000": {
      "source_hash": "sha256:efcd53c8b80d699ee02bbc413a5060f1bc9b6cc1ef4d54d9f2b77f44387a5a1a",
      "text": "好，辛苦你了。明天见！",
      "status": "draft"
    }
  }
}
