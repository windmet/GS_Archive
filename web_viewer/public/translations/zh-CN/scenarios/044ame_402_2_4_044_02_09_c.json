{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "044ame_402_2_4_044_02_09_c",
  "source_raw_hash": "sha256:2bb26eaa4881f0b4c401af6967947d6f0dc5f465a13fad31778d56c346365407",
  "entries": {
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000006:phone_message:000": {
      "source_hash": "sha256:f9e6c58a7eb4c5d72a81b1e7ab07d3a1bc81944757fb65ad69e2734f0b316022",
      "text": "制作人。\n刚才和若里、牙崎的碰头会结束了。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000009:choice_short:000": {
      "source_hash": "sha256:cf3a78e1b7c223c31da6e62c2b60b716840e08a4519d2a56a58bf3bb1ef54d3a",
      "text": "辛苦了。\n怎么样了？",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000012:phone_message:000": {
      "source_hash": "sha256:cc12fee49605864adf92c858a7c99237785ac4be100e595d486002e090416683",
      "text": "若里向我打听了各种占星术的门道。\n说是要回去教给High×Joker的大家。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000014:phone_message:000": {
      "source_hash": "sha256:90ccfb70e83814a62db2b440ffc2aa79cbcfdcf0ae905795ea8915f48973a7fb",
      "text": "牙崎一开始虽然看起来很无聊，\n但总算多少提起了点兴趣。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000016:phone_message:000": {
      "source_hash": "sha256:9b9a93fb979294bae7d89e3d5738dfe14e3cd21c9978e4b2c6c96c4fecebfe86",
      "text": "事情也顺利谈妥了，\n感觉能够顺当地推进工作了。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000018:choice_short:000": {
      "source_hash": "sha256:6f7b9ae5e64e059bacc7111e8cf872b54f53667af053ac22a9b412040c991e9e",
      "text": "那太好了！",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_c:2_4_044_02_09_c:cmd-000021:phone_message:000": {
      "source_hash": "sha256:229c001cd5234c7fd791187b1a2c7218a14c83c1c5d6ee418ab586adcd9a3157",
      "text": "详细情况明天再向你汇报。\n挂了啊。",
      "status": "draft"
    }
  }
}
