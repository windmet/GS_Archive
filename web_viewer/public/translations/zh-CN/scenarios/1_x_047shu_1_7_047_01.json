{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_047shu_1_7_047_01",
  "source_raw_hash": "sha256:dffe53e84981761994a118cdf81dea63b728596fa21182816b972fbb6228b5e2",
  "entries": {
    "story-text:v1:1_x_047shu_1_7_047_01:1_7_047_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:6ec133eec5957f18f281dfa855b105aeaf85d0664603273fc1099050fc928b6b",
      "text": "●●●●プロデューサー，找我有啥事？",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_7_047_01:1_7_047_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:7774aad87acd46d8b879a84ec9397691826e79822e77d9e3e16dbd7818d9641e",
      "text": "秀先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_7_047_01:1_7_047_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:18ee10f61133034bb5003c59cb6111dc46e04512431572bc4c052c736ebd3a36",
      "text": "……毕竟是我的制作人，\n记住生日也是理所当然的吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_7_047_01:1_7_047_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:f47445694b681a293f18fb2cf3f1c9e90dc02390f7640a88c312f5d264a74241",
      "text": "没想到你还会给我庆祝，有点惊讶。\n虽然早就知道，不过你还真是心细啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_047shu_1_7_047_01:1_7_047_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:1847e945d3d18510546027919c30195c133e043d8560162f6f211b1e35d89448",
      "text": "这种地方也很优秀，不挺好的嘛？\n不管是谁，被庆祝生日都会高兴的吧。",
      "status": "draft"
    }
  }
}
