{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "009kyj_401_2_4_009_01_09_a",
  "source_raw_hash": "sha256:b1b96150055f279af6a766c6c50477c0956d23a98c23abfff4ad30770d823f09",
  "entries": {
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:ecab36c35363e118c1d967413293293f01b98ff2a3baacfda300660721e46c5f",
      "text": "现在方便吗？不，可能也不是什么\n大不了的事就是了……",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5c66ac13d38970da4e6cd3517f71c1588680361087cbdffb5f90495947318cd9",
      "text": "运动会的直播在网上成了话题，\n我是听实先生说的。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:2da41cb59a0ee7f01cd0b33d06ea67cf0d2e3cac3590a06dc5fe06eb81abf791",
      "text": "这代表我也为提高事务所的知名度\n做出了贡献对吧？",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然是啦！",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:1824d3a19d22ada862af1ed98635a8dfc6a50aa4e5ff9b42102492e55ab1f606",
      "text": "听说反响很不错哦",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:9a6fe87fe20b583e4ddff2c1b3f352b92215b06191ee511fddb8872c587d73c1",
      "text": "这样啊。那就好。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:1d1ff78f84a103b3e869f600d232436b7875cd22ab7dc4b8525f2a200e56d9a3",
      "text": "是吗，那边的评价也传到你那里了吗。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:46a13266a88a67a74fbc72db78509367d9a89f7679c8a03bcae758b1315f1042",
      "text": "说实话，在演出时我还是会紧张，\n可能也还有些生硬的地方。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:4696984741de29318565f1843439477ffc547ecbf90472eb5bb4ab851f52e46a",
      "text": "但是，一想到有人在注视着我们的努力，\n总觉得……",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:add6f1c7835eb09ff23a23646b667901cce88da5f4d513605f15fe89ac0ece94",
      "text": "动力就涌上来了啊。",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000030:choice_short:000": {
      "source_hash": "sha256:1764254cc15cc885c0f23157e357ae7203bff876386c30b45b50efd390b0ae24",
      "text": "我会全力支持您的",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000031:choice_short:000": {
      "source_hash": "sha256:c9c3c93524847ba29774a799295c0fdd472df43e2a24de668f045cc7966dd9f1",
      "text": "一起加油吧",
      "status": "draft"
    },
    "story-text:v1:009kyj_401_2_4_009_01_09_a:2_4_009_01_09_a:cmd-000035:phone_message:000": {
      "source_hash": "sha256:2411ba2fa9b8e75303fcffe52ff7c480cbc6bb199beaeb0f5d5347c162f2478d",
      "text": "嗯。\n谢啦，●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
