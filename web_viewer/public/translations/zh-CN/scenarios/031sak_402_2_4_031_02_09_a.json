{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "031sak_402_2_4_031_02_09_a",
  "source_raw_hash": "sha256:6d568f0a1108a19828ec102f2e25ae687c75f7dc8821566095ade38a0f7c6e5c",
  "entries": {
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:91d7a53f4f79918e327e11a02b145c0cd6c7d50bbf5de414918c5899b58357dd",
      "text": "呐，●●●●プロデューサー！录制结束后，\n我和冬马他们拍了纪念合影哦！",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:7cd3b76581076a6a270003ee29b431a780da11aca0d1256cc8ab171cd8b81730",
      "text": "感觉就像是胜利的纪念一样，真棒呢♪",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:10ad19eff6333e6cc4437736b43a910d3f513daaa3836d0ecfa806da7fad4cab",
      "text": "说起来，节目宣传用的照片会做成明信片，\n作为礼物送给观众对吧？",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:00bbbb2401a7196c831d5b833bcee119c535b2941b05c2d1c789343c188c9d6a",
      "text": "真好啊。\n我也把照片打印出来看看吧？",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:baf1634e9e25ada9ed0dc398db411cab137ab321e487ca20e72623d3828e3bdd",
      "text": "实体照片也别有一番风味呢",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:a1a47be3b25acc994ea9fab5af9a972e1b286ce8bd01c68d48f0bb9a30e5d678",
      "text": "纪念合影的话更是再合适不过了",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:086d2325a3be9c122f4ed5d07ba22d4ade0a4c2cfe97552ee2baf957a1885ab3",
      "text": "对吧对吧！夹在手账里的话，\n感觉会很不错呢！",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:b5a5ccbfe55782d4017122242a6515fdb784b563ae695e3b08091244ecb949fb",
      "text": "特别感一下子就提升了呢！",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:30cb0f55807f61f1b2aad57039f55d16ab7894277fa01b48a575c60d524f5872",
      "text": "啊！我也想要一张和制作人的合影。",
      "status": "draft"
    },
    "story-text:v1:031sak_402_2_4_031_02_09_a:2_4_031_02_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:9b8f0f5304ada3c4fe0b7f7ae509c1a5bbf16974ac8b37301e948c3fecaf854c",
      "text": "下次，我们一起拍一张吧♪",
      "status": "draft"
    }
  }
}
