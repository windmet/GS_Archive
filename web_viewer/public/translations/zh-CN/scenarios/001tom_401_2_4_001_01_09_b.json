{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "001tom_401_2_4_001_01_09_b",
  "source_raw_hash": "sha256:4f4973c0e20cba19c51206e9eb1d2c23e33effc2691ec4ded91a2277ad3facc3",
  "entries": {
    "story-text:v1:001tom_401_2_4_001_01_09_b:2_4_001_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:b5344f1a4c547d667cd9068e37536b7f28c55a816b84ebd6f0942617ff510aa4",
      "text": "噢，●●●●プロデューサー？\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:001tom_401_2_4_001_01_09_b:2_4_001_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:2cfbbb6fca088f7f158dac157893e672e8e6f150c0a0e9c3cd15673b598e74eb",
      "text": "总觉得，突然很想和你聊聊\n刚才那场演唱会的事。",
      "status": "draft"
    },
    "story-text:v1:001tom_401_2_4_001_01_09_b:2_4_001_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:278dfcb4215200ca177b651c1b6b86a503c16cde5267ed95fa21df879c6ec518",
      "text": "粉丝挥舞的荧光棒，真漂亮啊。\n有多少道光芒，就代表有多少支持我的粉丝在。",
      "status": "draft"
    },
    "story-text:v1:001tom_401_2_4_001_01_09_b:2_4_001_01_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:967ed95ccac9a4ab970e1725dabed162f86d0988fb4bd649b4289615e2b89e32",
      "text": "这让我超级开心，\n也由衷地想回应大家的心意啊。",
      "status": "draft"
    },
    "story-text:v1:001tom_401_2_4_001_01_09_b:2_4_001_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:873517275eed9f7eee079936481a46d91d87f6ecdedffff783505e9b29d07ae7",
      "text": "……也就是说，怎么说呢，就是想跟你说一声\n我今后也会继续加油的。仅此而已。回头见！",
      "status": "draft"
    }
  }
}
