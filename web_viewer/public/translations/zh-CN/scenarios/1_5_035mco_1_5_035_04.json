  "entries": {
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000010:title:001": {
      "source_hash": "sha256:87f36457299455a392bc184eae690a580a9ded72cdf0642879043cbe2059c1ef",
      "text": "出演警察特务部队电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:a71c65388ae2c21886a02c4edc179840c0eaac5d0877b4206b5613f3bf94d699",
      "text": "“你已经无路可逃了。\n不要再做无谓的抵抗，束手就擒吧！”",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:17ffd37c792aafcc0b7112d28855a055c4f7e3e42786ee9b1b6aa1c2d7e6d682",
      "text": "“啧，还不肯死心吗！？\n冲这边过来了……可恶！”",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:035faabaa8f4fd75eda0d1b70e9ba3b3f30607b95e0943292b67f37540c8d2ef",
      "text": "“没办法了，迎击！”",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d04d4190a1973acc385f94d70af733562bbc706c3cb40cd657aa472da91d9cfb",
      "text": "……呼。●●●●プロデューサー，\n你觉得怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:5377183f475aeddb169a61e9512f467738169e1458bda0758b5a2a1b6b7a57b9",
      "text": "比刚开始练习的时候，\n台词和动作都自然契合得多了。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:6803a8ba9f2e64c29c5fda31c6e8694a35d41b7b78877f587ea0e6b742d1e889",
      "text": "特别是动作戏的部分非常棒！",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000043:dialogue:000": {
      "source_hash": "sha256:2ddb607afa95bedc244dcee8355fc54e88d3c35d2b39f4e2c4e4ed06c4cc131c",
      "text": "这样吗。因为我出演的是动作电影，\n所以目前以相关场面为主在做重点练习。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:4ba28af501d8927547b8b5ee9b1ed0c2b6fd861bad83bbcf5912f9ad17975985",
      "text": "但是正如你所说，\n演技方面目前依然存在课题。",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:549a66c47923ea345614c2a7ea8f46fb045ea560388279a7784e923a69c56266",
      "text": "我想重新调整一下训练计划。\n现在能否向你咨询一下？",
      "status": "draft"
    },
    "story-text:v1:1_5_035mco_1_5_035_04:1_5_035_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:d0bea0e9b3410028e4a673fbd82324d66349a7a134733956cafb3398598fc41e",
      "text": "好的。\n我们一起来规划训练方案吧！",
      "status": "draft"
    }
  }
}
