  "entries": {
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000010:title:001": {
      "source_hash": "sha256:386f6b3d039db55f86d97a1a871eedb7c0cbab27f37ef9562eb01256446c411f",
      "text": "在资讯节目中报道猫咪咖啡厅的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000012:dialogue:000": {
      "source_hash": "sha256:2ffe647bbf592e7e2763b0b133f905817204335d98c2a637290d7cc26deba4d4",
      "text": "（今天为了录制资讯综艺节目\n来到了猫咪咖啡厅，不过……）",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:0970762504fcb410ed302bb37ba190dd32a7ca00cd9d228bf367a6cd3a50ab12",
      "text": "哦，毛打理得真整齐啊。\n喜欢像这样被摸是吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3cb750843990704a6c66f18a0e9b35afcffc333f80f6f54564f60b181b98ba30",
      "text": "那边的那只……嗯？\n想让我用逗猫棒陪你玩吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:f5d22414f52f81037f01d197dc88983c9975203415b2a0d803218b9d62b03661",
      "text": "啊哈哈，居然自己把逗猫棒拿过来了，\n真灵巧呢。好啦，过来吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:f1f4bacdf99eb9439b4ef08306212722e1002466cb0e4f4338a103dbe6254db8",
      "text": "好厉害啊，次郎先生！\n猫咪们彻底跟你亲近起来了。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:17e118c274c34631600567abeb4f4460f789f50fbd7c5a0f3bcd34e1b63f039f",
      "text": "其实我以前来过这家猫咪咖啡厅啦。\n看来猫咪也还记得我呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000042:dialogue:000": {
      "source_hash": "sha256:748d31c2ec129228f227653c0c64fb07604cc841f9450fb1dddcba81d27e6432",
      "text": "原来是这么一回事啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:49cd0ad68c624e649f82f0cd1d07fba2214587b54206b25a1ff29a02e3ace9eb",
      "text": "猫咪真好啊～\n又能治愈疲劳，最重要的是还这么可爱。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:c49d65cbbb6ecb1ad27e90f321ea48332ea44534e2f38113207022a7f433fe39",
      "text": "喵～",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_03:1_5_037_03:cmd-000056:dialogue:000": {
      "source_hash": "sha256:4454b078f37e8fe149ddc2ddc9592a2afc1bd309cf4e0b0ede40c10ae784d658",
      "text": "哈哈，好痒。再过一会儿\n就要开始录制了，一起加油吧。",
      "status": "draft"
    }
  }
}
