{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_023_01_a",
  "source_raw_hash": "sha256:8d3527ac83386f643d6e2c1774a18a354abea5da343e3b888c5674e26959bff3",
  "entries": {
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:6112a73e9dee3bcb607667b581d20cd032d8f99f11e66ff8378c75d7c522c226",
      "text": "老妈亲传的力量",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:fc4a64348116ac4deb81ef47c27699e3cc39695aa7ec10d90c290eef49151afa",
      "text": "赶往工作现场的路上，制作人突然被陌生外国人搭话。\n看到慌慌张张的制作人，春名跑了过来，\n没想到对方居然是熟人……",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:6112a73e9dee3bcb607667b581d20cd032d8f99f11e66ff8378c75d7c522c226",
      "text": "老妈亲传的力量",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:6249deb3034a4b8606b9bd71b177e16a9a15bee09bae81802b69852398d43fb1",
      "text": "……然后啊，那家店的新品甜甜圈超好吃的！\n要是今天也卖就好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:d63ece1c0a6156ac4eb3a0dda0a224c4f03b8616d24125472759c44e72cdde9e",
      "text": "我在官网上看过照片了，\n每一种看起来都很美味呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:94a1cecae26592f208a06ce8e6000ee9cb77ffefa5ef6db2312498b75bcfd19b",
      "text": "是吧！然后……咦？好像掉了什么东西。\n我过去看看！",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ff96e21376883c9d62945af21f3cea2f338a7f9f6d857a8b92147f519d8a49a0",
      "text": "好的，我在这里等您。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:7a89fbc4ae233973177c83e1421d3dfb07431fe76a0d72139bd21d6e253bf9bf",
      "text": "Hey！　Did you see my cellphone anywhere？",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:c6e1c68ea5885d5b8fe7822ee67aa623dc195b39256cba1c7538c7ec37cc04df",
      "text": "I lost it somewhere.",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:45af071828dacd950ac6ccebcee9f95444c230a1c7f2012d9de53e05331110cd",
      "text": "哎！？那个……",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000059:dialogue:000": {
      "source_hash": "sha256:9e84820a85745c9f2de54ab0fe97900e484c00bdf0b371f2e98fad90f4e5b162",
      "text": "久等了，●●●●プロデューサー！\n……话说，怎么了？认识的人吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:654e21224d4d14ce93f5c9b4c817f366831dbf3ce5f777d9947c53a4a102ca13",
      "text": "要是有什么事，我来听听看。",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000067:dialogue:000": {
      "source_hash": "sha256:b7b799aae68022c5cebf26b604ce53404f8f5bab6f92cc3c5258b5cf2860a9f8",
      "text": "……！\nHaruna！",
      "status": "draft"
    },
    "story-text:v1:1_2_023har_01_1_2_023_01:1_2_023_01_a:cmd-000073:dialogue:000": {
      "source_hash": "sha256:16be4ef0bfdc92d35c0cb1c35ffcbc286baa4f86c502c7836126b8342a2bc04d",
      "text": "哎呀，这不是比尔嘛！\nIt's been yonks！",
      "status": "draft"
    }
  }
}
