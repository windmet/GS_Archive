{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_032_01_d",
  "source_raw_hash": "sha256:ca828b92dabb1442652ef0ca980136c5e030487cfd88d6b9937e39ce4c7d52a7",
  "entries": {
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000014:dialogue:000": {
      "source_hash": "sha256:b145732d726b9f5b4792f22a40038b2559ed3e8624629ce0f0d7b542627d2b2a",
      "text": "真是让人捏一把汗的展开呢……",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000016:dialogue:000": {
      "source_hash": "sha256:8dd346f15c25b0d9a7d8c4c6eef4b9af1b776494eedc92de0d5ad4c4b406a97e",
      "text": "谁说不是呢。刚才那一步彻底扭转了局势。\n直央君逆转了呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000020:dialogue:000": {
      "source_hash": "sha256:59b15029aee926aec8e7d3393a19fe4614b754be3a5fc6b687685b76593759de",
      "text": "认、认输了……",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000030:dialogue:000": {
      "source_hash": "sha256:8e2f6c266805d2aab878de95b680225d0c45f734c11888853b0065e02192dfbb",
      "text": "承蒙指教，非常感谢。\n在千钧一发之际勉强赢下来了……",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000033:dialogue:000": {
      "source_hash": "sha256:e1b7d2cc40169250ca8e491f822b515aef2f1916d15073e96def2ab5e1d625b2",
      "text": "哈哈哈，直央君真是温柔啊。\n这局下得很愉快。多谢啦。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000037:dialogue:000": {
      "source_hash": "sha256:62d9c3f472fadd0e9cdb4d72b524ab15997eedd851895504aeeceec24c8b60c1",
      "text": "我、我也下得很开心……！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8b6df578d30de56a4f6197b029aea2f8c1e682c55906fe8100fc3830f63920c9",
      "text": "直央君，恭喜你。\n精彩的逆转！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000045:dialogue:000": {
      "source_hash": "sha256:484af6658f03517452b0453d71c04b23094e43a11a795c2b1e6586c23fa20a0e",
      "text": "不、哪里……这次只是侥幸。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000050:dialogue:000": {
      "source_hash": "sha256:005d3845803718a78b48f75081cd1a7eb275dca9fa9affc0f3339f804e632d5b",
      "text": "差不多到必须出发的时间了。\n制作人，我们走吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000067:dialogue:000": {
      "source_hash": "sha256:046a68862ba1f9d72f447e27b77e0665a82d2f0edcad6210c06e0d000a849a0e",
      "text": "那么各位，我今天就先告辞了。\n下次还会再来的。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_01_1_2_032_01:1_2_032_01_d:cmd-000072:dialogue:000": {
      "source_hash": "sha256:07e2f27e383d295c91b7034050ad22c38c0d41709a6ae16249111e59a91dfde8",
      "text": "好，下次来跟我下一局啊。\n等着直央君再来哦。",
      "status": "draft"
    }
  }
}
