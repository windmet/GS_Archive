{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_402_2_4_040_02_09_b",
  "source_raw_hash": "sha256:9b0be1092d4398103f461dcf713290506f497c4e44129890ecc7d545722a257a",
  "entries": {
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:2939a80c9795bff709e90a3fad10ae434cd07d2b6a60e1216d536c46b06631a0",
      "text": "喂你这家伙，烛光什么的不应该是本大爷他们的\n活动吗。",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:4eabe47eeb4c4db8c29dd41a5fb1e1eb4ac5c339d610a4c9e6df0d239a108815",
      "text": "刚才，我看到贴了别的烛光什么的海报哦。",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:e2dc39b40b08ead75986a563102d3ac15e4ea382b37a705d66a595135dae0ceb",
      "text": "本大爷他们的活动是在学那些家伙吗。\n还是说那边在学我们？",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:ff87d20696ce4981189860dcfcf1e171b1edca0505d7d16ce1e3bfcdea078293",
      "text": "两个都是独一无二的活动哦",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:79e780b4bed6babb99447a2c846c9e2dbf71ccab3b53d61094eecb56f4dd5c7e",
      "text": "啊？也就是说不是模仿吗。\n没有在把本大爷当傻子吧？",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:160f2231161a1030bf55b9ba36ee1f332e618496e80270a7b5b972dbccc1c431",
      "text": "理所当然，本大爷的烛光什么才是最强的！",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:dd670978a9ffa6e31cd4f26b7941028b7b50a31427aa950b323e9914cf8f6b1a",
      "text": "让我们把它办成一个精彩的活动吧",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000021:choice_short:000": {
      "source_hash": "sha256:2f6fc1399ddb4f10146481df02023f3a49cf971d72982e8ea14e081bad875fa5",
      "text": "涟先生就展现涟先生的魅力吧",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:9876f0a05c77dcb65fed647f5a8a36d010764167346e0233b742f9b25f799a45",
      "text": "哼，那根本是小菜一碟。\n本大爷要把那些家伙吓破胆。",
      "status": "draft"
    },
    "story-text:v1:040ren_402_2_4_040_02_09_b:2_4_040_02_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:38b3cc966b4b26a1646151f25822954b963b96d5991569b101fa3ec044ce491a",
      "text": "你可别在那发呆拖后腿啊。\n走啦！",
      "status": "draft"
    }
  }
}
