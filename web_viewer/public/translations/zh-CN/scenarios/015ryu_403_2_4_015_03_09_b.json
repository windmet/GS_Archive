{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "015ryu_403_2_4_015_03_09_b",
  "source_raw_hash": "sha256:9700d5c4903af24b195404bd3aa60786e2acadb1ec07f201b28baa2da45132c5",
  "entries": {
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:6afcb41f645e0571d2dce38eda41c5182efe64bbde516e0480defd3bde5eadef",
      "text": "啊，●●●●プロデューサー？\n现在方便吗？我有点烦恼的事。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:a98af54abe88daba458bd3c6ed103c29f93705e6a524e383e55f4f18e65e667c",
      "text": "这次CM里要演的怪盗，概念设定是狂野对吧？",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:050af8120c0cae4221469a8c3c14261997cec18390093c4a5f45c18f08f88ba5",
      "text": "狂野这种感觉，该怎么表现才好呢。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:ff165973a3fdf12cb71cca6616db68e5158d71527cc092bab179db96c70cab65",
      "text": "是动作的华丽感吧",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:3460ea18bf310c1998f2dbb9c2bf5ae3cbcb8589f279553d703226d6051e39b3",
      "text": "是高难度的特技绝活吧",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:39cbfc8bf9d24f49a70d888765dab7a58e2668d9e02264702e1b33b81e798042",
      "text": "华丽感啊……确实这次有讨论过，\n要重点突出动作戏呢。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:77150497987c00e690e2c68dc724e00dd7e6a6b3e49f3e0d3b5754ec6832d685",
      "text": "特技动作吗……\n确实很有魄力啊。",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:9f629a741142a41f2a5fb0abdac9805520d3515a604ab9dc2b777e40370720d4",
      "text": "也就是说要敏捷、大胆，是这样吧？",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000027:choice_short:000": {
      "source_hash": "sha256:baa9aaf60c1727629a8c8c0889154f41d89b7c8a6cce0ed4f0990e2d07719c4d",
      "text": "我觉得很好！",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000030:phone_message:000": {
      "source_hash": "sha256:288510f4b7239ca2fdcd5114b7806419381b8cd9488149b3297fbbd8153fc008",
      "text": "那干脆就下定决心，\n彻底试着耍帅一把可能也不错！",
      "status": "draft"
    },
    "story-text:v1:015ryu_403_2_4_015_03_09_b:2_4_015_03_09_b:cmd-000032:phone_message:000": {
      "source_hash": "sha256:d7a022e4c0853e6e12002957399706a39a385a7603942466bb7fed6a7f65be80",
      "text": "感觉稍微有点头绪了！\n谢谢你，制作人！",
      "status": "draft"
    }
  }
}
