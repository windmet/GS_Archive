  "entries": {
    "story-text:v1:1_x_033shr_1_8_033_01:1_8_033_01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:8ba33af80e6e08d2004d9797887964a7e6703b79f9b5ea49577e0dea99935529",
      "text": "……哦，●●●●プロデューサー？\n生日快乐——！",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_8_033_01:1_8_033_01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:f0873291adabc27ed5e4abdff565aedf980905a855ad5384f4b9b6436b6b4a1f",
      "text": "本来想在一到今天的瞬间就庆祝的，\n结果睡着了……嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_8_033_01:1_8_033_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:6369de18f2241b3734714cdf357c115fb5eb44da68b2b148806c9a2902ff2b5e",
      "text": "所以我一醒来就马上打电话了！",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_8_033_01:1_8_033_01:cmd-000016:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_1_8_033_01:1_8_033_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:6487b1cccaa8f6c2564ac5fc5991771c3415d4a11103830e426a6ec6c42ca2be",
      "text": "噢！……啊，差不多到吃早饭的时间了。\n那就待会儿见啦！",
      "status": "draft"
    }
  }
}
