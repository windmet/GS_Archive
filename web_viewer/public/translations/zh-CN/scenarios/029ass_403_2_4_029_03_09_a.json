{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "029ass_403_2_4_029_03_09_a",
  "source_raw_hash": "sha256:f1153a89af63100aa5ab2ee978943fe614837f53adaddb680510cb8d7c567c2f",
  "entries": {
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:5ec95219fb92c106e383c676da6c19867b2d6df61f01a0707129b3c89c487c6a",
      "text": "咕，吾主啊……！\n我在此诞生出了禁忌的秘宝……！",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:7bd7129a94e42259e343a37296235347cc331b7beb06eb54aa0ffb9b93a64b91",
      "text": "禁忌的秘宝？",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000011:phone_message:000": {
      "source_hash": "sha256:bf07df5b94bf11e1b0b7eabc91f9d5b1857e2dca3772bf23e92472198a5162db",
      "text": "问得好。\n我正想以最快速度告知吾主。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:891cb7bb52b4ee9d2c94f2428653efeaa2bf4370bc22d172d79b68f70b092c8e",
      "text": "前几日，那场从遥远彼方之地奉上的供品祭典，\n对我而言乃是获取宝贵食粮的绝佳良机。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:d0e2d72c34603630133842905532d958e469b47a2f8c1dd3477f3bc512bfa558",
      "text": "哼……我在该处得到了秘境的食粮！",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:dcdce7db13edc79c3293b046b7ca32c0e110ffcc50b0579cb30e656d0d1314b0",
      "text": "这几日历经反复摸索，终于编织出了\n全新的精炼术。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:97b81d3ea0bb518a1ed86e50095286377f8ff081308c143a60710f1c898fe602",
      "text": "藉由此精炼术孕育而出的食粮，\n正是名副其实的禁忌秘宝……！",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:9ba64e5b31632a21af6ca6b7201fa5e936bc3a8644271058c7dab60f0ad55e44",
      "text": "也就是说，非常\n美味对吧",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:dd1e8fb919c759ef47140f03a0204e6c4a8304c78daf5433f45f038c558f08c4",
      "text": "嗯，首先我想让吾主品尝。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_a:2_4_029_03_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:91cb1f62f1769febd8576200dfd71ec6adfcad9d897d8e01398597be76db22d5",
      "text": "待前往黑暗巢穴之时，我当再次通过念话机联络。",
      "status": "draft"
    }
  }
}
