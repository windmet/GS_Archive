{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_005_23_5_00_005_23",
  "source_raw_hash": "sha256:eb109f1875397bf383d6bc05444ca16a3a5ccd1ce4b880074457422ce90889a3",
  "entries": {
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000000:title:000": {
      "source_hash": "sha256:838e958b616af6f2fe3c21861e242fb3daf2d57a110e5abdf708c5312815c7dd",
      "text": "今年的首个必杀技！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:3fe8789029f5b0a0c772bee210cb149e8f8c3079b64d7b8c575112ad7ccf276a",
      "text": "新年快乐，\n●●●●●●●●●●监督！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000030:choice_short:000": {
      "source_hash": "sha256:ab11cfb33245ceec1b91f34b33b3fb44dce553a6967caeb4fcf9b7db9b9755ec",
      "text": "新年快乐！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000031:choice_short:000": {
      "source_hash": "sha256:4f0f342ee61a1538e3458a634930e1cdc5849b886378c515374fa73e556c4bec",
      "text": "今年也默契十足呢！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000043:dialogue:000": {
      "source_hash": "sha256:798896c9fbd585b5de7fda1355977b40b4ca92aec8d4dbfd6b25abb5b41fcb0d",
      "text": "今年也请多关照！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000059:dialogue:000": {
      "source_hash": "sha256:a5efc9d85449bee3ef47c01468ecf12d58945afbe7bf7e4a90cedd931da8863b",
      "text": "那当～然！刚才我们两个踢足球的时候，\n配合也是超级完美的呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000068:dialogue:000": {
      "source_hash": "sha256:38bfbb6ad5696675c6a40f0a0793dabdff1fe524c6837872d29d16cb3fd5f306",
      "text": "监督，快听我说！\n在今年的第一场足球里，我想出了个必杀技！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000075:dialogue:000": {
      "source_hash": "sha256:11caad79f8fd1651fe90c63ccf6f37a25fc84004ff853c2ee0c15730ab346f9f",
      "text": "新年刚开年就能想出好点子，\n真是个好兆头呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000081:dialogue:000": {
      "source_hash": "sha256:21eae4c5b3918fb8009a17848c8dedf506124e5a31e970a824a8d761c074b336",
      "text": "我们打算吃完饭之后，就去练习那个！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000084:dialogue:000": {
      "source_hash": "sha256:2a9a312cac3a5dfca756e0121c5ab070a36d48d6eacd6036a574edc93447ad71",
      "text": "练成了就去给监督展示，\n敬请期待哦。",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000091:dialogue:000": {
      "source_hash": "sha256:fb783f7eca063b88ed06b72047369f2db544dbe50df9353c50e11c1f8dfd78e7",
      "text": "然后当然，\n也要期待我们作为偶像这一整年的活跃表现啦！",
      "status": "draft"
    },
    "story-text:v1:5_00_005_23_5_00_005_23:5_00_005_23:cmd-000101:dialogue:000": {
      "source_hash": "sha256:5bfef6ccdae23c91f378e883ef11e8071f50eb8d8eec5be6a44bc0f21690ff2c",
      "text": "就是这么回事，\n今年我们两个也拜托你啦，监督！",
      "status": "draft"
    }
  }
}
