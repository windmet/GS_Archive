{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "010pie_401_2_4_010_01_09_a",
  "source_raw_hash": "sha256:f952597e52013f88e225ecb0fd9f55b73520565d71d80f534dc8c9a753ecc3c3",
  "entries": {
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:f1f87601861145082472f87869d4f307740e494eebf6fc415dd2f8f6bde9d984",
      "text": "喂喂，制作人。\n现在，方便吗？",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:107d7a10cc17e5fbee137548774f367215e5aa17b89cd6b39910e38030a998f0",
      "text": "昨天，看到雪花球了。\n里面的雪，亮晶晶。特别漂亮！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:0fcaa8ec885a48a463fd794e1365d3e576b01d896dcf14af8cc67bcf6b10711e",
      "text": "想起了，冰雪节呢。\n闪亮亮的装饰，有好多好多！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:bd9e3e0464e6318aef7feef17fbdf6952980c7410cb252654372e32ddab65708",
      "text": "夜间亮灯\n也很棒呢",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:adf4390dcbf531636fe42d9103f428e2ce65d1a245937ed8bfc2779d39e4d615",
      "text": "大家看起来都很开心",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:a115bec7ca628622180b84ae5cee793f354fc2d66919bf30da94064d6f9fa419",
      "text": "嗯！亮闪闪的回忆！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:26da52a8d5405e2b48220faf1d0a0dc2fc2332662e74db473d7023369ec59e57",
      "text": "PASSION之像，好大，好显眼！\n光靠我，做不出来。多亏了大家！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:80eafe0f3f89084cc47f3ec10771e5b1dcc5032b68ea4d0aaa643f54e6646984",
      "text": "大家的笑容，也变成了，回忆。\n齐心协力，好高兴。感情变得更好，了呢！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:3598788cfd85f75f64e954862af7d936cd7d8830d3673a9439bbfa3ca9c5d0cf",
      "text": "开心的事，有好多。\n快乐的演出，还想再办！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000024:choice_short:000": {
      "source_hash": "sha256:330f99a1e55b35e3d9fbcfc87db21e954c303722cfa2f654f6450687a3f1d97f",
      "text": "下一份工作的安排\n也已经定好了哦",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000025:choice_short:000": {
      "source_hash": "sha256:dd8cdc060d190bc8ddb7c2fecc983ceb45e806b7c8cce9d6b0f726cd9a5c0957",
      "text": "我们再开个会\n商量商量吧",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:23678295d27803d7232d0118e50689b752216b4539ebd53323aa0f236c1f2cb1",
      "text": "耶——！\n新的工作？好期待！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000030:phone_message:000": {
      "source_hash": "sha256:20b83893e8b35071bd510fd3c300af2ad971b1de995c559a6b2cec1e373d88ff",
      "text": "亮闪闪的我，给大家看。\n客人，一定很高兴！大家，都幸福！",
      "status": "draft"
    },
    "story-text:v1:010pie_401_2_4_010_01_09_a:2_4_010_01_09_a:cmd-000032:phone_message:000": {
      "source_hash": "sha256:fd5b00f63a234649bba1f6cd425efef37adb1fd9c1ced15f9692fc2208060a8e",
      "text": "制作人，\n今后也，请多关照——！",
      "status": "draft"
    }
  }
}
