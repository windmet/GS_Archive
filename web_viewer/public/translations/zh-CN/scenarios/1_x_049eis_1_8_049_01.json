{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_049eis_1_8_049_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_049eis_1_8_049_01:1_8_049_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:222267e357b95e8b5eeef65f891e93d4307f181cf7f03e956c01155a3a7c51b3",
      "text": "这么晚打扰了。\n●●●●プロデューサー\n祝你生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_8_049_01:1_8_049_01:cmd-000011:choice_short:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_8_049_01:1_8_049_01:cmd-000014:mobile_message:000": {
      "source_hash": "sha256:3176dc16f53a25bdca017e3190908bb796eec96e09a3a56e6f1f5d33c76155ba",
      "text": "毕竟是平日承蒙关照的\n对象的生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_8_049_01:1_8_049_01:cmd-000016:mobile_message:000": {
      "source_hash": "sha256:0147ee7ab96265b19ccdf29b465ed7a0e0cfb9129c2dc4e761854bb15a561f47",
      "text": "明天在事务所碰面时，\n再正式向你道贺吧",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_1_8_049_01:1_8_049_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:c39312360da47f9a187183e8c9ed0457acff3f4da4c71bdecf254519a08f63d4",
      "text": "虽然今天只剩片刻，\n但也请好好放松。\n明天再会。",
      "status": "draft"
    }
  }
}
