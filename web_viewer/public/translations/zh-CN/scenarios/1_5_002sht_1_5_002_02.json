  "entries": {
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000010:title:001": {
      "source_hash": "sha256:30861a6dc327449d2c02effa92bfab60046127257606b2db1d2e01bca2e64fd3",
      "text": "出演寝具广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:3f5abc1cbded89a5b455b4001075263bf83af4c3ff68c782e4053b8b1765004b",
      "text": "寝具广告不是超级适合我的吗？\n而且还是超级蓬松又软绵绵的枕头和被子！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:4d89914b4d5fab5c9ca68e37b9cde95ae8b9d5f57d9a7dad44a0dcdee0c7a679",
      "text": "因为是高级寝具品牌呢。\n每款产品的口碑都很棒哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:d10dbfa3fce0100bdd96d9105a6000b52b0034895a1a0f6fffa25e0264696dac",
      "text": "一定能睡得超级香呢♪",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:42821c3652902ff0a4cdd8b67958bafe9131fb16b76fbb2ab91b2724fa8fa2fb",
      "text": "要是太舒服了导致拍摄中途\n睡着了怎么办呀～！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:46fc5d6b3b189157c727028909203ae254d6cdf7e30e15294bf7eeb63b76cf57",
      "text": "那、那里还是请努力保持清醒吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:35609d253b0df19cbf4400c25a72e6372ebf81929066ed45b4313f313dfc1a08",
      "text": "哎～可是那也太难了吧～。\n啊，不过要是真的睡着了，那样反而也很合适吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:0574605ddc2fd789369b5895feee594d7cad627a282c1db63c95feccbda7ad26",
      "text": "毕竟，那就能证明这商品舒服到\n连我都会动真格睡着了嘛！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:14a0a1497a3b2555224b6953e77ae3a86155abe95d4bd00bb2c6c8c2e8e2f2b1",
      "text": "话、话是这么说确实……\n但是对方有预想的画面要求在呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:42ea55a20133a67adb9da0adedd487852eb7e8fa6485f7e7cbbf77d928313098",
      "text": "也是哦！\n嗯，没问题。我会努力不睡着的！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_02:1_5_002_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:e9ea83ea85dd97e9add4f8e9f878e8ad77c64941ec0754a8134e4180711576cb",
      "text": "那我差不多该去准备拍摄了～！",
      "status": "draft"
    }
  }
}
