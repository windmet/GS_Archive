{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_016sei_1_7_016_01",
  "source_raw_hash": "sha256:93ba13b3e3141223fffd6627b85602714218370dc8c4961814feca19557270cb",
  "entries": {
    "story-text:v1:1_x_016sei_1_7_016_01:1_7_016_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:5aa022cda58cab1136460489421d5b8fcee58bb948986a1ccf5c602de1b24b03",
      "text": "诚司先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_7_016_01:1_7_016_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:a07beb3585005dbab638e34166246caad76a09e7a7c1c93c1a3da5178e08adde",
      "text": "你记着我的生日吗？\n这样啊……谢谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_7_016_01:1_7_016_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:b895ccedbee9d80f7b431b057949759472a5e7cb522821d03cf909c562f87696",
      "text": "我不太习惯让家人以外的人帮我庆生。\n虽然有点难为情，不过很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_7_016_01:1_7_016_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:78806f808eeb3659b5856d721c6892258753eb8637d5a58537d573233f494970",
      "text": "作为偶像我虽然才刚刚起步，\n但正因如此，我会全力以赴执行任务。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_1_7_016_01:1_7_016_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:a34f2de170d1744d88253128a9fd11f2090344843b5c51c1c6724048fb2d67d9",
      "text": "●●●●プロデューサー，\n今后也请多多支持了！",
      "status": "draft"
    }
  }
}
