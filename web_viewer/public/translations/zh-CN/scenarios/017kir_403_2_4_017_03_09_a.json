{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "017kir_403_2_4_017_03_09_a",
  "source_raw_hash": "sha256:92d0634ba13bb6f506eba30cae5f9b797b082c9b3c2ac96301321ae54940f71f",
  "entries": {
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:51a3dfd8f65a81d4cf5c4e7eef7c472b6104525704c7338638be42b61bc4bb23",
      "text": "●●●●プロデューサー君，出大事了喵……！",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:034c3ac73bdebbf6e03b9192fb437b2966f5e82c4723365e409bf147fb761633",
      "text": "喵呜，师父竟然赐给吾辈\n超棒的牛奶寒天了喵……！",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6e7ea9d66850b6b27f4d7a49417e668214ea5ca5d43d8e3e85fe04b83e3abf1f",
      "text": "据说是师父看了我们的CM，马上也\n馋得不行，特意邮购来的……",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:2dce919f8f86b4bea9fc7bf6fe2c57555c4b17b27e265e315176a216b802d930",
      "text": "喵哈哈，真是何等光荣是也♪",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:146b6bb10ead8f7c9c0772a057eb1f16d37c312f9d0be69a8701f3a8de256891",
      "text": "这是比什么都\n值得自豪的事呢",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:f029691918c97b26895a4e1bc19b138246969ce707ce113e5d2ad65c78969d8c",
      "text": "因为桐生先生的笑容\n是真情流露呢",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:86c51c38ba72455086fa953dc91fd4290e0dd542b5319531c6835a5fbba76ff5",
      "text": "不光是吾辈，多亏了写书人君和\n软绵绵君大家齐心协力。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:091fc0766b9ff448517fc77056ff75c402df615a42300b7e5d7a7c29833b6eab",
      "text": "也是多亏了那种美味，\n奶农们真伟大喵。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:4c05a38db5530aee0ffed0ee51021abb7ce22c6d19f9f6a3962269a68a8a434b",
      "text": "……不过牛奶寒天就由吾辈美味地\n享用是也。喵哈哈♪",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_a:2_4_017_03_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:96b4b71c39e38b8a5c83eaf67107eca156883b13a797f6defd25a86b707b46b8",
      "text": "开玩笑的啦，吾辈也会分福气给\n制作人君的喵。等着吾辈喵♪",
      "status": "draft"
    }
  }
}
