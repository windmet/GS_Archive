  "scenario_id": "1_5_012yus_1_5_012_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000011:title:001": {
      "source_hash": "sha256:0845144942abcb22daedeec57a69ae9ced5ab5da5180a877fc12386c2475f517",
      "text": "健康饮料广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:13379657884c2a946adce4e9a6dc2f09083152341bff14707197fd28d14fa3f0",
      "text": "“喝了这个，打起精神来好吗？”",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000031:dialogue:000": {
      "source_hash": "sha256:7513ede8d97fbc18be82d7168d3a8a66a54764524cded4042efaebc230ca7530",
      "text": "“把美味与肠胃健康送至您的身边。\n坚持下去吧，每日欢笑好习惯”",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:78972272e7f4541d3452e12faef854865937dbfed7a75157df2cfa678256abeb",
      "text": "悠介先生，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000061:dialogue:000": {
      "source_hash": "sha256:f64ce2637e0e08c047eb81f32864fcaaa4f249151ff7cc0f377915de1e89729d",
      "text": "啊，●●●●●●●●●●监督～！等你好久啦！\n刚才的拍摄，没问题吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:cbc7b316e437cd06f6eacbb56226f8737c942cefa6b5e99368c0de91b0231773",
      "text": "很好哦！得到了很高的评价呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000067:dialogue:000": {
      "source_hash": "sha256:2bec2ca66479e6f376d3095f7ee0565b73b61b5fb6b5f7890ba1f4d9c5da2632",
      "text": "尤其是赞助商那边，特别高兴地说\n和商品形象简直完美契合。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000072:dialogue:000": {
      "source_hash": "sha256:4574dcb6f1fc6884febc9e5985b9814c64c503126735e2dfaac5fe2c167eb251",
      "text": "太好啦～。因为重拍了好几次，\n其实我刚才像比赛前一样，心跳得厉害呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000076:dialogue:000": {
      "source_hash": "sha256:415469419ace00e10ba8dc75572fc9d6d3f0776a300a2df5a0fdcf0a001b12c2",
      "text": "会有重拍的要求，也是因为大家都觉得\n悠介先生还能做得更好才提出的哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000081:dialogue:000": {
      "source_hash": "sha256:7a5654fa65ad8bbb31216d0ae7ce88f7327354ce8c638de037ba5e159ab49c24",
      "text": "每重拍一次都变得更有魅力，\n现场所有人都移不开视线了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000086:dialogue:000": {
      "source_hash": "sha256:4ede7d677df44235e3dd69de943c76211e97f7dab54d652e44bfd64b8f5f4954",
      "text": "哇啊，超级开心！\n从现在开始就期待播出了呢！",
      "status": "draft"
    }
  }
}
