{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_034_01_c",
  "source_raw_hash": "sha256:e940f8ee3eb6003a9b10ba5d65136e253533f2fc49deea9ff09acffcef6a20e6",
  "entries": {
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000010:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "数日后……",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000018:dialogue:000": {
      "source_hash": "sha256:7675aa045aa8acf74b318fc6466256ff02c71d994459bf995cdf2ad626e39560",
      "text": "（咦？花音君的妈妈打来的电话……？）",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000026:dialogue:000": {
      "source_hash": "sha256:f9b3e77fbd49ac8167cca9a43348caa946c6033f20a37fddb4eae865d7c5544d",
      "text": "制作人，承蒙关照了。那个，\n我听花音说练习延长了……",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000029:dialogue:000": {
      "source_hash": "sha256:f4117ee820ea8aa46ffcccd6efdbacaf0a4eaf4390d5a063026903351fe8349c",
      "text": "能告诉我大概几点结束吗？\n那孩子没记住结束的时间。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000035:dialogue:000": {
      "source_hash": "sha256:3e502bd3e8052c8ed1c81697f2b6e0e73cae74eeceec4bbe2677ec9b2456bf32",
      "text": "（练习应该早就结束了才对……\n啊，说起来……）",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000059:dialogue:000": {
      "source_hash": "sha256:f84f15d388586ff70c4eeae994e70404dccba08bce3659e78c6ecd7f9e272cb0",
      "text": "（今天我跟花音君说过冬马先生可能会来事务所。\n难道说……）",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000074:dialogue:000": {
      "source_hash": "sha256:133fe04af6b383fcee5af6ae9eb94f3b83dc3c7ee607334fc8fee2f41a6ca830",
      "text": "好的，马上就结束了。\n我会负责将他送回家的。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000082:dialogue:000": {
      "source_hash": "sha256:b4b0a9251c1bfa363673927ea0dacb9ccdabd23cd48f8852f580f718efa0270f",
      "text": "（在事务所里能藏身又不起眼的地方。\n……是仓库！）",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000104:dialogue:000": {
      "source_hash": "sha256:338d8b0c4d9c5488780a278c69eb969060baf144dd057dd0311563b3c786fc27",
      "text": "果然。\n你果然在这里呢，花音君。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_01_1_2_034_01:1_2_034_01_c:cmd-000108:dialogue:000": {
      "source_hash": "sha256:882f5cfca5aa4d5c88cd7ff7ab38202019043702c146d9e5884edc49701eb5be",
      "text": "啊，●●●●プロデューサー……！？",
      "status": "draft"
    }
  }
}
