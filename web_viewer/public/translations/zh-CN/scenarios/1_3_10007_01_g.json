{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10007_01_g",
  "source_raw_hash": "sha256:085ad4512fd55ba59f591d0d51b3ff98dd51dd40beb7cc07df2193235b1ad690",
  "entries": {
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000020:dialogue:000": {
      "source_hash": "sha256:625127b2cabe4f38343c873eb9e542566f5b95566bc66090110a59124d5b74ce",
      "text": "……我们是Altessimo。首先，\n非常感谢各位来到我们的演出。",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000023:dialogue:000": {
      "source_hash": "sha256:2b3cb789f54164c7563cd05a2d379193208971f168714d755b5c8b322bb1df58",
      "text": "站在这里的各位，\n应该有很多人还不认识我们吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000026:dialogue:000": {
      "source_hash": "sha256:1d49b1511f0e194bc92706b1ec5aead333b89606d42b749e75c53d4d739a1267",
      "text": "即使如此，依然感谢大家\n对Altessimo的音乐产生兴趣。",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000031:dialogue:000": {
      "source_hash": "sha256:f5a09804a8de885126f10e77a1352de8319490cbff8498b0a194419304805ec6",
      "text": "那么接下来，我们想演唱前几天发售的\n我们的新歌。",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:6d8a7297beb45c3c8ea846d96c7dc6f039694910458e75b8f68474b289b7be31",
      "text": "……请听。《Infinite Octave》！",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000042:dialogue:000": {
      "source_hash": "sha256:8cab47a2832b46ba45de04a06743f18d579e62ffb65358ff3fb391b3d6de6d26",
      "text": "哎，好像在办什么活动。",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000045:dialogue:000": {
      "source_hash": "sha256:04c6cc84047b918dc0b836a0513ef70ba44684b952fa025345a1cdca9119ba7b",
      "text": "这歌挺好听的嘛。稍微听听看吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000056:dialogue:000": {
      "source_hash": "sha256:52f04f8bbaf482ea8c70691b100b22ecfcc73b44f005da75bc850e6aa48205ed",
      "text": "（……啊。随着歌声响起，\n人们开始陆陆续续停下脚步）",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000059:dialogue:000": {
      "source_hash": "sha256:0ff1b6d123a93f065d92b0f6b77f6bc03d0563b33d9607bf8c34d9b44802e1bb",
      "text": "（我的歌声……\n热爱音乐的心情，好好传达到了！）",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000077:dialogue:000": {
      "source_hash": "sha256:fd64c56402fc72067fad4e9ea661116b330138ba218f0cb9a5835a479fe3068b",
      "text": "（丽先生的歌声变得更加舒展了。\n在我的身旁，艺术正初啼破晓……）",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000102:dialogue:000": {
      "source_hash": "sha256:f847c7101f845600b801af4f2fc3b33fbb7653a832d12ae1a6d8823cf4135be0",
      "text": "我们的演出到此结束。\n谢谢大家！",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000112:dialogue:000": {
      "source_hash": "sha256:f05283171aaeb2538cdbe3f6697f7ee9dc69f7b694d0ab285448219a3adc4f3d",
      "text": "每首歌都好棒啊！",
      "status": "draft"
    },
    "story-text:v1:1_3_10007_01:1_3_10007_01_g:cmd-000114:dialogue:000": {
      "source_hash": "sha256:a4e70b590f9eeb1d008a27da0ac47c3170156f251db3f4a69f3c52b906192357",
      "text": "呐，那边好像在卖CD。\n我去买一张过来！",
      "status": "draft"
    }
  }
}
