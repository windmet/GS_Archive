{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "004ter_403_2_4_004_03_09_b",
  "source_raw_hash": "sha256:c696388fcba68defa85c27aa951d8c6bc93538c37320713952d979fcd187bb6c",
  "entries": {
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:7fec03f60c1af2b3b3c6866e77cdacf813dc3ee7e1aca4d3d2da9badfbdf5c9a",
      "text": "喂喂，●●●●プロデューサー？\n刚才匆匆忙忙的不好意思啊。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:8e10da90f6ac0eb8fc49fc37ea76f8c72b9ca68b01fd9520be7db1c31c8407b7",
      "text": "你不是帮我叫了出租车嘛？多亏了那个，\n总算赶上集合时间了。谢啦！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:1c113ad688afceca847570915ff666ea1034910a07c4710b2d867e2fc6d7195a",
      "text": "请好好去玩\n哦！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:d4711a45a55460ab4196d370257e7f4b8a79b994f3626d7d4aba3613a54e9306",
      "text": "请帮我向那两位\n问好！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:fc0b998ba6ad3988bcdd46db2046cbe76c1b9fd4da5b68b6a668fc3fd273cb57",
      "text": "嗯。要是没别的安排，\n我也想让制作人一起来的。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:1ced0f062ebbd442645d4d41f15c28819a9add8fd8e658f55f611559a9ee8dc0",
      "text": "哦！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000021:choice_short:000": {
      "source_hash": "sha256:ad469e298f39bd28fd3610ed3d6d045fa313968b90ae9067e38cbb4bdf6d6283",
      "text": "怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:5ba5d7d663ad6f23a14b839126b76272687c5c67c9e099e55c17be1f6c52ef49",
      "text": "店门前站着的是樱庭和翼吗？\n咦？离约好的时间应该还有一阵子啊……",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:26b423fba6364e2e61f7e98769259267c04c02ba7ded8620ba03f529f5ae60b1",
      "text": "稍微等我一下。",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000032:phone_message:000": {
      "source_hash": "sha256:ddf3cf693bec685b52246d063f84c2e1b5d335dd53b55352d35aaf2cb4066d51",
      "text": "哇啊！我和别人的时间搞混了！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000034:phone_message:000": {
      "source_hash": "sha256:41a4beb52b9306cb59fd3f15235af4e0a6efdc687712e27e8b571a94f505df4f",
      "text": "不好意思，制作人！\n和樱庭他们碰头的时间已经过了！",
      "status": "draft"
    },
    "story-text:v1:004ter_403_2_4_004_03_09_b:2_4_004_03_09_b:cmd-000036:phone_message:000": {
      "source_hash": "sha256:41c5613c4e83d8504449d2380ed8bf90d60b53808ae9297c96bacf53018acf25",
      "text": "今天真的帮大忙了！回头见！",
      "status": "draft"
    }
  }
}
