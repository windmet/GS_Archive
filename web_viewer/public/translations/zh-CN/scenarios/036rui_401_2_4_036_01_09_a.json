  "source_raw_hash": "sha256:89381fbbd1cb7da6ff1e1fde718e8b16b77ffb0bc44a1b1b863685e0453b4c37",
  "entries": {
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:7e4a34448c436942772e2a322890c32b2e9281862b5c157189868ce43ee4728b",
      "text": "Hi，制作人酱☆",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c60b12ee49738bd009d9108f609a558ec4c22933c61a1b3e24110c4c7684f89f",
      "text": "我明天不是off吗？我打算去参加一下在Museum听说的\ntour。",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:1b7ead1064aaf2e2cad2e269c262f20fc7217762f25d4dc01f3011000512e4aa",
      "text": "叫作“后台导览游”，\n听说平时进不去的地方都能去哦！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:814c3591184abc36f04fcc67de468de6cb61a4270441611a0d20d2b95b3de10f",
      "text": "可以参观修复老旧作品的过程，\n还能看到存放art object的仓库呢！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:8aaa44b3407326175ca2721880803751f4d9aeff71b14190a1ab1d395b25b6d9",
      "text": "感觉有点像职业体验……？\n能看到Museum的幕后，so cool对吧☆",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:1c113ad688afceca847570915ff666ea1034910a07c4710b2d867e2fc6d7195a",
      "text": "请玩得开心哦！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:9ec738e1947ef7d13c13f2da65da24c66037424a1d922c14ea1a06060ed17790",
      "text": "听起来很有趣呢",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:e763669121af544570f32080d44c5def5bff6ddac476a817e890e8e8b2ec3b91",
      "text": "Yeah！太期待了，\n我都担心今天晚上能不能好好睡着呢。",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:dea8c5b8a84e1eb359c827bc2d8e4881fc23c42dd9a1f42d1a2fb50491d5f65a",
      "text": "制作人酱也感兴趣？Umm……\n真可惜，明天的名额已经预约满啦。",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:3fee4b1624258c328ee8e6439d00951a4e3dc5694734a2a586bbe66f9a25869e",
      "text": "下次要是还有tour招募，\n制作人酱也一起来吧！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000030:choice_short:000": {
      "source_hash": "sha256:ea1ab40cf369d7208d876e24f63f078473a1f1011fc89f16c08d40e888fbd51d",
      "text": "好，一起去吧！",
      "status": "draft"
    },
    "story-text:v1:036rui_401_2_4_036_01_09_a:2_4_036_01_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:f800155bd6a7821d53d59bceca6b3ca51f79b3857ce6b2a50137c72399e3e259",
      "text": "OK！预约一start\n我就再联络你。那么bye☆",
      "status": "draft"
    }
  }
}
