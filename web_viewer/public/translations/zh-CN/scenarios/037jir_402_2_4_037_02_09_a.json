{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "037jir_402_2_4_037_02_09_a",
  "source_raw_hash": "sha256:19cb4d6f90b162e9ba41d609831c1c24ba05d5d65a0161e5f0f56d72aec86a43",
  "entries": {
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:15df3d96e6a28843784f255b274caa0f213ea3edc8c0107a30421922fed36377",
      "text": "●●●●プロデューサー酱，\n现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000007:choice_short:000": {
      "source_hash": "sha256:3ae563d401510c89e64ef36e736fa333ed63c370ef668eb12d0e60ea4630db61",
      "text": "怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:7fc161fd1bcae9f3fef4a7ee19f0d5131a7e1ddf78a30a2ba5884eb5fd863f80",
      "text": "硲先生看了那个冰淇淋的广告，\n夸得可起劲了呢。还是一脸认真的那种。",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:97eb654a8ce5973955b0d7e70c26f13cb586d14bc019d40d6f2f27f16e53dd26",
      "text": "类也说什么“没有人比Mr. 山下更适合烈日下的\n漂浮饮料了”。",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:95d44e488b8b5a8b4d5b3b554a46a3931290265cd4d467bd004fd7dd0628c5e5",
      "text": "感觉再怎么说也太夸张了吧。\n这应该算得上是大获成功了吧？",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:fe6c0f97b8b3bd7a9ffeaf131828a151dec180a430f86e53e70cff91e267a245",
      "text": "确实如此。\n看起来很好吃",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:7882e60b102a0ba6ffec8922dc9fa3c23e0895f533ad3b5da0fba6281fc17c5b",
      "text": "当然了。\n大获成功哦",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:48b16affbe6c246d19b28b5181073697eea2fddea97508bbe4ed23eb95f3e8a5",
      "text": "哈哈，那我就老老实实高兴一下吧。",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:f9331e632b3766494774c3dcf45b5788198803524b24006de6a9257ffbe3dac0",
      "text": "然后呢，硲先生说想去那家冰淇淋店\n吃吃看，",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:0eb6eb22f554953003dab3dca9dc070fd9f20d0701139792ba1ba6b92294fe45",
      "text": "类就提议把制作人酱也叫上，\n4个人一起去。怎么样？",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:dcb74658edfb8781bd5207a6c20a2decbefc1dc1d327be404afb56656c4f5019",
      "text": "话又说回来，硲先生到底会选什么样的冰淇淋呢。\n稍微有点让人好奇呢。",
      "status": "draft"
    },
    "story-text:v1:037jir_402_2_4_037_02_09_a:2_4_037_02_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:cf154b661a51004e7e6903d6c176f70393fd5848a38133dcf37eb298cfc919cd",
      "text": "……开玩笑的啦。\n那我之后再联系你哦。拜托啦～。",
      "status": "draft"
    }
  }
}
