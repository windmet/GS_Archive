{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_10_b",
  "source_raw_hash": "sha256:acd9bdebd0b67d2ca39a3ffe0b4d38a41f02323688a0578b452d159916f2f27a",
  "entries": {
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:7647d69864c80cee6ade15b17b6edf5b838b4fcd3a20bbd82b98a68ddd408f11",
      "text": "我泡了咖啡。冲得比较多，\n想喝的人请自便。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000042:dialogue:000": {
      "source_hash": "sha256:da79e1ce298ed00e1d989a394b853435c48b14d5e8e1cdb6a2c0dddfcd757586",
      "text": "给。这杯是给●●●●プロデューサー的。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000045:dialogue:000": {
      "source_hash": "sha256:ef09fa8de1220ed9b39bd7aff7113c155b35b53b1c2044f8c2dd7e2725507f7f",
      "text": "秀，谢谢你！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000049:dialogue:000": {
      "source_hash": "sha256:2a195cf3badde3f78f656f72536f9de5c26ce8b5979fd65fb609661f5d76db13",
      "text": "说起来在C.FIRST初次Live的时候，\n你也像这样泡了咖啡给我们喝呢。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000054:dialogue:000": {
      "source_hash": "sha256:0397aa9abbbb96b8a789b4b82e544d05994ad51a5aae1db4ff809bfb9fd2362e",
      "text": "有这回事吗。\n看来我还挺照顾制作人的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000068:dialogue:000": {
      "source_hash": "sha256:77f5e383f15cb81d8334ee71ef00f309dd4cc87f5c8a938426b18961b787f80d",
      "text": "哦，这股香味……是咖啡啊。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000075:dialogue:000": {
      "source_hash": "sha256:1794bbc5c0bcd24165ff6224b4b8abc4786e3973e247c0734a62dd6fec452625",
      "text": "是秀泡的吗。那我就不客气了！\n喝了热咖啡，心也就踏实了呢！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000085:dialogue:000": {
      "source_hash": "sha256:1c9137da9234510eb24b67ebebb181030e361f12e20c462eb4df5fe0231db33f",
      "text": "啊，那就好。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000092:dialogue:000": {
      "source_hash": "sha256:2b23c0f4c6f736893e95f4435ad62c816103dc7c2f02eeea70a5d65420d04625",
      "text": "（……完全没注意到辉的双关冷笑话！\n也就是说……）",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000108:dialogue:000": {
      "source_hash": "sha256:dabfaf5ce960d0a2b6ca21014228f92d38575accd950dbe0c90db2f56efd438b",
      "text": "秀。您果然，稍微有点紧张吗？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_10:1_4_001_10_b:cmd-000115:dialogue:000": {
      "source_hash": "sha256:71f4e32a47b4532d0a80bda02d9dbae5168b2ac92c809816845824d6f1d6249d",
      "text": "咦？啊，嗯，算是吧……",
      "status": "draft"
    }
  }
}
