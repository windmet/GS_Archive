{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_02_i",
  "source_raw_hash": "sha256:9499408360e90444446ed2c2c80f162c2cb655e1f049636a4875838b0489639c",
  "entries": {
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000018:dialogue:000": {
      "source_hash": "sha256:2e287a5a2f6e1faa69a48f7d6a3b144761d497623c50ad0d341313a234d9ca6d",
      "text": "你这家伙，是认真的吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000023:dialogue:000": {
      "source_hash": "sha256:89fb69e3fec0b7b6a51829175f7b6b0d131dfe1bcd5a5aaf2af88a120130bfdf",
      "text": "废话，认真得不能再认真了！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000028:dialogue:000": {
      "source_hash": "sha256:592b61da26fb52affa2181b4993593720d835eb90ac747dafb4c619d0ebd66d4",
      "text": "听了●●●●プロデューサー的话，\n我的心就像着了火一样热血沸腾啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000033:dialogue:000": {
      "source_hash": "sha256:9df44ec2a75bb432564f893f66767b79a62afd5549591795aea0a7fdd872ff3c",
      "text": "要想让世上不再有恶人，\n就只有这个办法了！！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000044:dialogue:000": {
      "source_hash": "sha256:79eaf03e728e40825cb82950dce997ee3c0788a01a3bd9ea4d77b75d9b55bea4",
      "text": "（……很像朱雀会有的想法。云蒸龙变。\n借着这股势头作为偶像登顶，还是说……）",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000056:dialogue:000": {
      "source_hash": "sha256:4d0eabc7d044dfce1ba75d5eef407f71ae24809177d5df45e744670e0774fe3f",
      "text": "玄武，我觉得只要和你一起就办得到！\n拜托了！！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000061:dialogue:000": {
      "source_hash": "sha256:f8e282e4fe243707c71e74dc6912c2e0c9275954b47c669d6f262b75ef11b4fa",
      "text": "……被相棒说到这个份上\n要是还拒绝，那就不算男人了。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000065:dialogue:000": {
      "source_hash": "sha256:4ad5a1e26643213365b68d593a61a260c262f4241990f691b982fdbb17da21db",
      "text": "我黑野玄武，就陪你一起去参加\n315 Production的试镜吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000068:dialogue:000": {
      "source_hash": "sha256:abc5a6322b76059d665f3210daabf93dd4d37c8841ec55e8b60a7c729561e68c",
      "text": "玄武……！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000071:dialogue:000": {
      "source_hash": "sha256:28bd052102d0b1701e829653b88a89df1a4d11922f3f283fe5b89b4cc4dfe346",
      "text": "喵喵喵～！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000078:dialogue:000": {
      "source_hash": "sha256:c0eb4b49a25c2a913eb9b92efaa0e6209549a28bf3b4c2f3c88df31770a19ea0",
      "text": "啊啊，喵子也一起！\n呜喔喔喔，燃起来了！Burning！！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000083:dialogue:000": {
      "source_hash": "sha256:a134ed10d2b6a042488a9a2fc8e1954f7347bc359f32a1f7e270e2d4665fd840",
      "text": "朱雀和喵子都拜托你了！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_i:cmd-000088:dialogue:000": {
      "source_hash": "sha256:f9f2362c0ac3d821efdaa012da8a0c922fa1acf0909f92ab102ff4fb5ccad204",
      "text": "我们才要请多关照！",
      "status": "draft"
    }
  }
}
