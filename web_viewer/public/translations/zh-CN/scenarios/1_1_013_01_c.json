{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_013_01_c",
  "source_raw_hash": "sha256:755f1d5ed21884dd603e672c079c3ab14300986229b0f7944f90d66bef52d484",
  "entries": {
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000013:time_caption:000": {
      "source_hash": "sha256:f41789a3f975725f965b9e44a78df3c090c2e74399319f3374cc0492972ca458",
      "text": "数年后……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000022:dialogue:000": {
      "source_hash": "sha256:4e2fba4c1dc652ff6bfeeabe71779d93353019a5c341c0641979c180215aee77",
      "text": "想详细了解偶像相关的说明吗……那么，\n连同试镜的内容，我来为您说明吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000029:dialogue:000": {
      "source_hash": "sha256:344bda025dec918242fe434054c5ed05ec606d4645ebeb0ed8a84aa0e372b276",
      "text": "试镜？……总之，\n我想和了解详细情况的人谈谈。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000035:dialogue:000": {
      "source_hash": "sha256:ea39cb7b013f75f33f93c56f1229588789e9271ed405d4a641c370c9ca07020a",
      "text": "好的。我去叫负责人过来，请稍等片刻。\n在此之前，请先喝杯茶吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000049:dialogue:000": {
      "source_hash": "sha256:5fa028b534c2b0fd206bab765bf02bcc187dba1a7b9a944ae3de3fc4c72f3f2a",
      "text": "（这里就是偶像事务所……\n本以为肯定会被赶出去的）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000060:dialogue:000": {
      "source_hash": "sha256:e2a0dc4b3222e167b601c89859049266cb4e8004fd4e288699871b564ad07f08",
      "text": "……真的可以吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000066:dialogue:000": {
      "source_hash": "sha256:aba676c59dd891a14fb9814b15c00f0b935f6a027cac296c8fd87f4df327e7eb",
      "text": "是的。粗茶一杯，请不用客气。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000070:dialogue:000": {
      "source_hash": "sha256:b185421210a490b555cd056f74e2e98b29a7f7727e8fe57e32cc8fe99912c35f",
      "text": "我不是指这个……",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000075:dialogue:000": {
      "source_hash": "sha256:bfbcb349cc82492be05db6e8cb47acbe07d93590d30d5dc64531c25770544e78",
      "text": "……不，谢谢。",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000089:dialogue:000": {
      "source_hash": "sha256:fbfb997ac8ab2eb294fe49000a916dd77a1409bbd71207995c25e0dbb8ee2a22",
      "text": "（虽然只是凭着一股冲劲，\n来到了拳馆里的杂志上刊登的地方……）",
      "status": "draft"
    },
    "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_c:cmd-000093:dialogue:000": {
      "source_hash": "sha256:14b2240bd28f800546818ac38724a2ba402e8727ae8fd8806508f2368d60194b",
      "text": "（这里真的会有妹妹的线索吗……？）",
      "status": "draft"
    }
  }
}
