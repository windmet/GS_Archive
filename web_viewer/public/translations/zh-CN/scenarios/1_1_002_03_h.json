{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_002_03_h",
  "source_raw_hash": "sha256:11b4b9560f8164cf8d157d8ca267133ba8fbdb93f1b10125650284748d96d9a7",
  "entries": {
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000017:dialogue:000": {
      "source_hash": "sha256:fc78ff7f8e0ffefbbab35a9f69277d00f69eada4a6b2fd1da12f510c8c4b5f9f",
      "text": "哈啊、哈啊……姐姐！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000029:dialogue:000": {
      "source_hash": "sha256:687aac1aec14559fee9193a00981a94f51c46c7016ae47bedec0fb8ebacc363f",
      "text": "姐姐……是我啊，是薰啊。\n求求你睁开眼睛……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000031:dialogue:000": {
      "source_hash": "sha256:c0b6f3e6d7d7ca66cebc76347795925e9d2fcc4543b96b8ac31ba99573e6fc43",
      "text": "呜、呜呜……姐姐……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000044:dialogue:000": {
      "source_hash": "sha256:9730de01b6a982afa06b999148b15df6e1e1ea5c41d860eaff6edf2c03e7901d",
      "text": "（和父亲、母亲不一样。\n只有姐姐，没有抛弃我）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000047:dialogue:000": {
      "source_hash": "sha256:bca3d41539b8425a98e185d28b6b3084a0fc4731944f713697af2825d2d7f1b5",
      "text": "（真真切切地注视着我……）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000066:time_caption:000": {
      "source_hash": "sha256:f41789a3f975725f965b9e44a78df3c090c2e74399319f3374cc0492972ca458",
      "text": "数年后……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000070:dialogue:000": {
      "source_hash": "sha256:0f7d2d9ff005aa60384491137378b99fdc964b047831cc4b8afb5c4ef4d295c7",
      "text": "我听说了哦，樱庭！那台手术，\n是你做成功的吧？真不愧是你啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000076:dialogue:000": {
      "source_hash": "sha256:e23bd589dafd9be3cc251a3b3c3c0543709989b948ed0a23a421a811c13f5d11",
      "text": "那种程度的处置，能做好是理所当然的。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000079:dialogue:000": {
      "source_hash": "sha256:2ec11324ec608197f479fee3bee2aade754bcda4c8a176678d435209f010cc62",
      "text": "你要是有闲工夫在这里废话，\n不如去为下一台手术做准备如何？",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_h:cmd-000082:dialogue:000": {
      "source_hash": "sha256:3273e9e6a2f1d07fae9748cc2e8486e06a944ae9381c927af42d81ecb7cd86c2",
      "text": "哈哈，依然是嘴上不饶人啊。\n嘛，不过你这种一本正经的地方，我挺佩服的就是了。",
      "status": "draft"
    }
  }
}
