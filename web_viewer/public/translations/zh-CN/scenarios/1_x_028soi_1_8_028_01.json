{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_028soi_1_8_028_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_028soi_1_8_028_01:1_8_028_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:b614def8b1ce6bfbee40433478a4f8d2883953d65e74c745eb25572d93f9f829",
      "text": "喂喂，是●●●●プロデューサー吗？\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_1_8_028_01:1_8_028_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:97579dda7973c4243e80d0fb140b7b71f37a73ba936dc1a55408547b3649b1a5",
      "text": "今天是●●●●プロデューサー的\n生日呢。祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_1_8_028_01:1_8_028_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:c215116e0246ba07f427beb24d1b3127ef61cdbef7b5b0d66377f7e94a59cb82",
      "text": "我准备了蛋糕，\n稍后会带到事务所去。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_1_8_028_01:1_8_028_01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:b97842fa8ccf5c3b155bb1dfce40f44f2d320cbb5a8cf8252f98275a3ee16d0f",
      "text": "非常期待！",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_1_8_028_01:1_8_028_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:8efdf29345bf127e4c7dbe10e69a90ce4022dd3031436d0248edafcc7823694f",
      "text": "好，敬请期待吧。\n那么，先失陪了。",
      "status": "draft"
    }
  }
}
