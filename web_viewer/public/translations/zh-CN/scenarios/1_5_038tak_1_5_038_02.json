  "entries": {
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000011:title:001": {
      "source_hash": "sha256:c19ae650c90b2ed73fb6c6292842d60241b1b5851f44900ef4a2d92275186f36",
      "text": "漫画改编电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:adbc9324073ee41a59444029e3ed885bbede91a944bff9606c30de0dbf79eaee",
      "text": "“队长因伤上不了场又怎样！\n这能成为放弃比赛的理由吗！？”",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:2fb82123f44ebbc6aa6a085b6ad6ccbf20d2e6cee9c44c21219f64f8e5ab38ba",
      "text": "“下个对手确实是强校。\n甚至被说成是夺冠热门”",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:783932baf1f4e6496dd73423929965844d0995d22c45334e1646715f8411a642",
      "text": "“但是，胜负从来没有绝对。\n现在还不是轻言放弃的时候！”",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:9970f619471e23318480231a5d7c10d47da1ca32daf01c16e28a5f60d4971880",
      "text": "辛苦了，武先生！\n真是逼真的演技呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:bfc112eae66fe84e13cb80612073b45c369a545923d0b9d2e7efe535794ba58b",
      "text": "特别是武先生说服大家的那场戏，\n太让人感动了！",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:4397244449111e4e1afdebd6e0a16da8ce2ae3198b563882c2acfcc7ddbbdd78",
      "text": "谢谢你，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:17a2982452f5f8184948c0009cdc68bf88d42ae7fbb202d1726d005f5e507779",
      "text": "不过害得大家重拍了好多次。\n拍摄时间本来就已经很吃紧了。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000055:dialogue:000": {
      "source_hash": "sha256:0de0cb72810fa45d54b8818905bf4b8f8ffeace0670e4f5a1c00a92e079c8039",
      "text": "但是导演说了，正因如此\n才拍出了很棒的镜头。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000059:dialogue:000": {
      "source_hash": "sha256:941fa5308ad5aecbed15390738a7fc83d75e3f5b9cdaf79177d5b95aba056b43",
      "text": "这样啊……那就好。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_02:1_5_038_02:cmd-000062:dialogue:000": {
      "source_hash": "sha256:21774922908f26f6a83c128742617991ce68e959e1a7ba72a9ce682eafd6c6f3",
      "text": "保持这个势头，接下来的拍摄也一起加油吧！",
      "status": "draft"
    }
  }
}
