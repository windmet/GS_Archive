{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10009_01_g",
  "source_raw_hash": "sha256:a9ccb675c531f47db4c9adbf4afd6148c60f75efc998167350f55c3cee338648",
  "entries": {
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000024:dialogue:000": {
      "source_hash": "sha256:34c273bddab24bd4b0c4b9a670d5ae849ba6e21edb641d4134615921b4920e8f",
      "text": "……这里我打算写上这次的干劲与决心。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000026:dialogue:000": {
      "source_hash": "sha256:2480dc0596078ef7c0ae4e1897a65e92d07a106c1c23a669cd2de2d4a80020c9",
      "text": "……也能拜托凉和大吾写一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000033:dialogue:000": {
      "source_hash": "sha256:2c524d4eee6677719eb4a25eec6384e31152fabbc2e540f9741fb3f14c2deff2",
      "text": "当然好啊！凉，你先写好吗？\n这种事果然还是得队长先来嘛！",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000049:dialogue:000": {
      "source_hash": "sha256:2833dfc64cc705ff9523c0fab16e43675e47b71dc5090625806833edc3aba980",
      "text": "好的。那就……\n“加油干！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000054:dialogue:000": {
      "source_hash": "sha256:f2c194f875fbb7172b7e7fa8dd83c3f95f5b27eeebcee5a0e7d93c10e747643e",
      "text": "诶嘿嘿，字是不是写得有点太大了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000068:dialogue:000": {
      "source_hash": "sha256:6e2ea3535d2607e75994115b3cf01ceb8d0cfc845c5272a8cd75f8f8e9356577",
      "text": "……很有凉的风格，挺好的。\n接下来大吾，拜托了。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000082:dialogue:000": {
      "source_hash": "sha256:747c222c209c6236225341fba36d0a160cd601eaac2982fb20734210ff42eb8f",
      "text": "和凉还有老师一起“加油！”搞定！\n写好啦，老师。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000092:dialogue:000": {
      "source_hash": "sha256:ce3c191f8523ffe51043b261f6b019cfd0a412816584e34e5b8d09a0c69c02db",
      "text": "……谢谢。我也写了“全力以赴”。",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000109:dialogue:000": {
      "source_hash": "sha256:74137e90b09d130a8f9e4edaa3d94cd41f0b88eb7a0c4968e2d97334c8b1c665",
      "text": "……●●●●プロデューサー。\n最后能请你也写一句话吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000114:dialogue:000": {
      "source_hash": "sha256:6fc4d0c11bff1c74cc55f685cdab46d27dcd1c46fc77ed5463105e676c63668f",
      "text": "好的！那么……",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000118:choice_short:000": {
      "source_hash": "sha256:04c96611d839d93538d32a00a03cc682facc34950b9552f85bedf03970796cf7",
      "text": "为大家加油！",
      "status": "draft"
    },
    "story-text:v1:1_3_10009_01:1_3_10009_01_g:cmd-000118:choice_detail:000": {
      "source_hash": "sha256:da7e2d4b40b63f98e9fc566d7b5145da923c16c638a22c9f1885bf030e4dc72a",
      "text": "appeal",
      "status": "draft"
    }
  }
}
