  "scenario_id": "1_5_037jir_1_5_037_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000010:title:001": {
      "source_hash": "sha256:202549fda7b9db909613b1aaa5638cd0db2a5e50ee9cbf793648413ea4e9eaee",
      "text": "作为嘉宾出演儿童广播节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:bc8e2c43b8bb25f0c344f48f7255f21d944dbae4146835cdb6cf8f28e6a75d4e",
      "text": "广播录制马上就要开始了。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:3d8ce977f649f13412d92e617cbb2106b60219c87990ebeb767096057866da84",
      "text": "这次的录制中，孩子们会打来电话咨询\n各种各样的问题，需要您来进行解答。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:a135166f729984124cc0a53ef2098504827730efc787cfa6b42ca73706b61539",
      "text": "电话咨询啊。小孩子总会冷不丁问出些\n让人意想不到的问题吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:0409f4eb8a69fd1c74314a6299d04a53043f1217afbccc2b116e0d45b79ad4dc",
      "text": "完全不知道会蹦出什么问题来，\n真是让人心惊胆战呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:70ea5ceee4e17222a88f70defd94fe3a91adedf43a8848ef04f0a987702b4095",
      "text": "没问题的。次郎先生的话一定能答上来！",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:244f6ef8f4d180e5202b506eba5b5c7737ec005fc9c4f56e7e2a6a10bc26e288",
      "text": "既然●●●●プロデューサー酱都\n这么说了，那大叔我就去加把劲吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000043:time_caption:000": {
      "source_hash": "sha256:83b91878176a36430c39bc5426de2edd68820f09e7576494a38fc8f14e07694f",
      "text": "录制中",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:97d823317dcde5a6d8fec1995fccc9ec9ae5451e63a2dc11f7017b71eeea0d17",
      "text": "“为什么大海和天空是蓝色的呢？”",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:75b059425f17c4dfe791a74ba88d9d2495aae0a37708e0a2e3de632f3999c766",
      "text": "问得好呢。空气和捧在手里的海水\n都是透明的，所以会觉得很不可思议对吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000056:dialogue:000": {
      "source_hash": "sha256:ac63687cc734061ea44e9ec4aa837b563dce0a7b6f0033cb032e8686e744f080",
      "text": "但它们各自都是有正经原因的哦。\n首先是天空为什么是蓝色的……",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_01:1_5_037_01:cmd-000063:dialogue:000": {
      "source_hash": "sha256:cef12ff33685a806ba68473aafc3ddd39cb2c50a29110dc78d560f09cc0040b3",
      "text": "（次郎先生的讲解非常通俗易懂，\n受到了孩子们的一致好评……！）",
      "status": "draft"
    }
  }
}
