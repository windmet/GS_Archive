  "entries": {
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000010:title:001": {
      "source_hash": "sha256:b01d59a8ab27c13ae73578c575b7a5924324c76f4911c2d042de83f1ee8aa9e8",
      "text": "时尚品牌模特的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000014:dialogue:000": {
      "source_hash": "sha256:b3b3726eeb40f994ff404f470cc7807454f93673f4569db27233a0c85b7f9cbf",
      "text": "九郎先生，您被选为某时尚品牌\n新品发布会的模特了！",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000018:dialogue:000": {
      "source_hash": "sha256:8d035c823363545a2c6e443668dc102bb28fc9e17624a4846d134c8ccf90a3c0",
      "text": "哎，由我来……吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:50423f9fad70c1c938aef5859ae65ddcffc66c01fada4399f0d5355fc0eb9fd7",
      "text": "是的！是一家新和风时尚品牌，\n这是相关的资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:79749e0e95f2cbe66bf973e7a45cf57b00203ddd2f5717590aacc63a94596916",
      "text": "是将和风与潮流结合起来的服饰呢。\n搭配得非常出色。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000028:dialogue:000": {
      "source_hash": "sha256:ba81eeaf1255ad28a5d86771245eafa733c117ba1401fe26b4c3c6ca4fad5ce1",
      "text": "据说是基于想让大家更轻松随意地穿上和服这一\n理念，来进行整体搭配的。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:68bc8e8275dd3207ce3bc4f8579aea06559efac96ed666ca2b1371517f293097",
      "text": "原来如此……",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:2de55ecff4502026c21fc135252b20a4b4f2029ba3f5fb3e1bb907ff6bdfe139",
      "text": "九郎先生？",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:500556ea379e89f151c843586970014efdfd33ba9456f2eda9be147511b22011",
      "text": "我认为为了推广茶道，即便是新事物，只要是好的\n也有必要吸纳接纳。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:d70fff891a60db904799169f886cd2bd15f9204b892e9d7544c3234da9279204",
      "text": "恰如这些服饰一般。",
      "status": "draft"
    },
    "story-text:v1:1_5_019kur_1_5_019_03:1_5_019_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:d224bc89e377c0ef9368a7f6905bed53b3a23918870603ad48299538624bce04",
      "text": "我想怀着向其学习的心态，\n来全力以赴对待这项工作。",
      "status": "draft"
    }
  }
}
