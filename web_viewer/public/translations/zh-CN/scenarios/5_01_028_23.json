{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_028_23",
  "source_raw_hash": "sha256:9a4a0784cf84f0548f16225d193e7633fea9ada685b4d67e85539d31847522a6",
  "entries": {
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:a729a344ab5f08f6bae39caade47546aa24e855bc6d5b1ea6cdb18af1bb61e25",
      "text": "●●●●プロデューサー，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:4ea06208a8305951d6fa297534351f015e99fd784d730308f96ef45e781000d4",
      "text": "我想差不多到了该休息的时间了，\n就带了慰劳品过来。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:2e4c66c50117c2aa3f8e5ad1ca23224c189c92328a4287f099a83c11ddbf5ab9",
      "text": "你了解得真清楚呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:951ffb11c2226f2190bccb66a0f12bca9d0fc53ca598c14884ee3e7cc38b2bdb",
      "text": "呵呵。毕竟我们相处的时间也变长了嘛。\n那么，请用这个吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:96d87193a9341d9d4a6c164dbea24226c693ef55b8977359c2f4142ec67f55c7",
      "text": "去年的情人节，非常感谢你为我\n准备了那么难入手的巧克力。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:6a6ebd45fafcad94a31aef7dca0f01366ba3deecbf759dbee215e213c13e67af",
      "text": "作为那次的回礼，\n今年我也去入手了珍稀的甜点过来。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:9d112caa3006f811ba46e9a4fb8e7694d7212afbd879e47cca4ae360f731b8c9",
      "text": "真的可以吗？\n应该很费功夫吧……",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:7c267c27829c963ea045657d39ecc309504b833b15a96e8ad179c431eca3db98",
      "text": "是啊，确实稍微花了点周折……",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:133916b72d96c2d16295bc91200d67062591be40a6ed20f75e8ced4e6d5b48cc",
      "text": "不过我听说制作人去年，\n也是费了很大劲去买来的呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_028_23:5_01_028_23_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:6ac388b13e042425e7203aac5e84d2770305636962d76b68d4ad004b54eb4f3b",
      "text": "一想到这是谢礼，这点辛苦就不在话下了。\n请别客气，尝尝看吧。",
      "status": "draft"
    }
  }
}
