  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000010:title:001": {
      "source_hash": "sha256:af7c24e6a6571468cf3726c8432ddf91eb4da580d8503007c2d7e99cf31380b5",
      "text": "出演舞台剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:9ee622375b67ddae3e7dca8109310f8963c29bfdccdd039fa94b5d452fb123e4",
      "text": "排练期间太开心了，感觉一转眼\n就到了正式演出呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:7d9ba2ff27e619c3ebb6d521ec8b332f6a3ea6468b4467258d7a968ab6849a32",
      "text": "排练场很热闹呢。\n我的印象里大家都在非常自由自在地排练。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:83e134a7334fc145984bba733c2fc63a672b309b7e2b7aabd4239937af40139a",
      "text": "因为导演说了只要顺着剧本来，\n随便怎么发挥都可以嘛～！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7386e7e7ef19b42ed731e58e04a4b9f938a2b9b6a421c95554d21332f5203515",
      "text": "剧里的舞蹈编排能交给我来做，\n真的好开心！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8ae2e07532d13c348d66beff647e9f6b1278d8b479bff3f0ae861b8153f3b4d0",
      "text": "我觉得是非常适合翔太先生饰演的\n那个奔放角色的舞蹈。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000038:dialogue:000": {
      "source_hash": "sha256:444351c00903c67c00e2c7d434c5b718992a6b74b4fcc72ef8061e759b9238cf",
      "text": "嗯！导演也是这么夸我的哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000043:dialogue:000": {
      "source_hash": "sha256:fed6121f692ea959d54cdb796842d27d6795f1cec90c92f1892795f307db6142",
      "text": "加上也是我擅长的曲风，\n动作一下子就浮现在脑海里了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:21613cad7c71a597b67039413be69a75649cd91f294b94b6d64172da7a674672",
      "text": "正式演出我也很期待哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:459e5d8d1bd889042d9717f7b4e1bfabebee1b89cafb0adaba3b3da25463e397",
      "text": "谢谢你，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_5_002sht_1_5_002_04:1_5_002_04:cmd-000058:dialogue:000": {
      "source_hash": "sha256:f3718d505390eea5c71922e37a3ccdb58bf728588fc9cc67f1aa042bb804af84",
      "text": "啊，时间差不多了！\n我去换衣服化妆了～！！",
      "status": "draft"
    }
  }
}
