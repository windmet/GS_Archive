{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_036_23",
  "source_raw_hash": "sha256:2193aff23d5973e141b8b471b5f686cd0a26aa8546ff8a41581ce1849b2e0ef6",
  "entries": {
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:9c849f2a952929343c419215fc66ef03a4bb268cfb2c6099e7e13aac8759c2a7",
      "text": "找到你啦！\n制作人酱，工作辛苦啦。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:2393ae156fb6de56cafa6aefbf8d57d339a5dad698f90f5009e2cbc62d4843e2",
      "text": "车站前有在卖Valentine限定的drink哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:a05beac1c89b3dd65067a169398439ad867bd1020d1c4db4e9a9aaa9a081d54d",
      "text": "看起来超级好喝的样子，所以也把你的那份\n买过来了呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:868f3cb0a3cd8ea051f6fa71b22ad383c2b639f50bd00d62a194e3267fb5ec43",
      "text": "就当作是对Delicious的valentine chocolate的\n回礼，怎么样呢？",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:71d680ec091ae9ac276f9c2a89dad200409ec27d4c371fa52fb7653fc7b3a061",
      "text": "非常感谢。\n那我就恭敬不如从命收下啦。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:dcf7cc3cc458ad31acaca8c4337783e3862a8cb1c0fe9b72a4ec87edd6b43f9b",
      "text": "嗯。请用！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:27cbe5c49f5edca55c693624bf8f0048311af63d3ce9a793aecd7a753c345e89",
      "text": "……非常好喝！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000060:dialogue:000": {
      "source_hash": "sha256:7b9bd756bd499a3b4f8bafd4095ce598e497721a47eb9026a17f841767ebd233",
      "text": "啊哈。你能喜欢真是太好啦♪\n呐，不介意的话要不要就这么来个break time？",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:9d2fd3bf8c8d6fc3c0496f7c868b14641fbcc23fdd32de5ff8d23db3da6142e8",
      "text": "好主意呢。\n稍微聊会儿天吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_23:5_01_036_23_a:cmd-000070:dialogue:000": {
      "source_hash": "sha256:f05a504ef78d6fd4bce9904a0f82fb73cc121e6570c3c5ada9ac396899d7bfe5",
      "text": "Yay♪ 我啊，可是有超多想和制作人酱聊的\n事情呢。首先是……",
      "status": "draft"
    }
  }
}
