{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "018shm_401_2_4_018_01_09_a",
  "source_raw_hash": "sha256:231e07f2d2f7f7c6a0a37ee9cca7d10e73a81441506fd183145d6ae84af160c1",
  "entries": {
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5698704f4b3a19885a414c6cd064c0ead4e8792dc2148fe9548501f2cb31ffc0",
      "text": "……喂，●●●●プロデューサー酱？\n辛苦啦。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:53e61466b67a35cd4de7d77259f85ca457e67ffaee35d682199af9b4569b71dd",
      "text": "我想着差不多到了你下班的时间，\n方便聊聊吗？",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:eac45b6855021e10962477f5af1f545f3e25f3d1397bf8a1a1c5c53306cfe0cc",
      "text": "方便的哦",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:2da6555e46b8d4593c7f9c674bce633c538ad248a640660c52467889a6829f69",
      "text": "呵呵，那就好。\n有点想找你说说话了呢。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:2e4a787cb85b0718c0838554a1aff8267f1c0c84cd2e4ba7470e0e8c8ba9810f",
      "text": "再次祝贺音乐节圆满结束。辛苦啦。\n我们的舞台表现怎么样？",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:cdc190b96067c31c57182d3eaf0eb9260a628096bf3ede2b3a3ec456dbf6aaa5",
      "text": "是最棒的舞台",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:ae2bc48e01cd539e193195c1c68170f2242e63bef4c746ebe57dd3fa6f2f0079",
      "text": "谢谢！我也能自信地说，\n那真是个最棒的舞台！♪",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:8862b47ee46118f22a903b20878ab92e1f8501a462d2eb25fcb3a66fd7417c5c",
      "text": "前阵子我走在街上的时候，\n还被去参加了音乐节的粉丝小姑娘叫住了呢。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:5d124e4831e2a355263c8c77aaee42a8000684388d80257beb3d39cbaf9a55b9",
      "text": "听她说了好多感想呢。\n收到了很多让人开心的话语。",
      "status": "draft"
    },
    "story-text:v1:018shm_401_2_4_018_01_09_a:2_4_018_01_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:96a928263f1991685a397f44561d98362a70c2aa2a164396fc55c9801b4c086b",
      "text": "很期待下一次能登上什么样的舞台呢。\n那么，明天见啦！",
      "status": "draft"
    }
  }
}
