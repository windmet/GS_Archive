{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "024shk_401_2_4_024_01_09_b",
  "source_raw_hash": "sha256:e891192ec7d341f86bc9551a717a6aff3ab338569c81dfb987c47d5e41af7d51",
  "entries": {
    "story-text:v1:024shk_401_2_4_024_01_09_b:2_4_024_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:85e20f007609658fadc45aa0ded5272d11c04e09661e0fd497426fca0c4bb964",
      "text": "喂喂，是●●●●プロデューサー酱吗？\n我刚才正和隼人亲他们聊音乐节的事呢！",
      "status": "draft"
    },
    "story-text:v1:024shk_401_2_4_024_01_09_b:2_4_024_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:f994e4119e439012b9bdb51dec4e18ba33081d7d9ca4a59594835c27e3e106f4",
      "text": "然后大家就商量着，\n有一件事一定要告诉●●●●プロデューサー酱。",
      "status": "draft"
    },
    "story-text:v1:024shk_401_2_4_024_01_09_b:2_4_024_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:1c39a8fa1bdf84de069846e38d741e2cd8ff69f28da674b7d09e87abd4cbd97c",
      "text": "我们还想再办那样的音乐节！\n所以，今后也会超绝努力的！",
      "status": "draft"
    },
    "story-text:v1:024shk_401_2_4_024_01_09_b:2_4_024_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:795f1b41df27186eecf952a1a95a9103d7b26cf982c27686ee44df3a16db4d11",
      "text": "一起加油吧",
      "status": "draft"
    },
    "story-text:v1:024shk_401_2_4_024_01_09_b:2_4_024_01_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:a47b9403ccfbc924c8e66f4bcf66704c5a4e7bbf8b04f1a7607d3c241fe7a211",
      "text": "好咧！那么放学之后\n我就去事务所，拜托你啦！拜拜咻☆",
      "status": "draft"
    }
  }
}
