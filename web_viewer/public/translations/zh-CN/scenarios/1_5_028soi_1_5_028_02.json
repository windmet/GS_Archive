  "entries": {
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000010:title:001": {
      "source_hash": "sha256:acad8a179ec9060026b0f7726b705c364af246812e29a8fa941eca858200d449",
      "text": "TV料理节目旁白的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:4a4ab100b5c7867994ec05b34a69addcdad1c72c675dfb8d036ed09e7b37cee3",
      "text": "不好意思，●●●●プロデューサー。\n任性地提出想去看看录制现场。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7cc06e7b1627f513ab5d1c2ab8d8c9ccde50967463e3501bcca7cd51fb8078d1",
      "text": "没关系的。去跟工作人员商量之后，\n他们很爽快地同意了！",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:1d7d70d6ae815609b3413e69745883f578673ce10bc12055110a5ce5ad70adb6",
      "text": "毕竟庄一郎先生这次是\n负责料理节目的旁白嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:5752b8715c48a86720c54cc025a36b0f336fade012c25e5a7255b9cbb14f73cb",
      "text": "亲眼看一下现场，\n也能更好地找准感觉！",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:45ed22ac1aaeff5982dd6162df61bbb61f8a488df4b380917a7d8b2812756323",
      "text": "谢谢。这次的料理人，\n也是一位极具盛名的甜点师呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:0a821e77e5678db36f7e3e4f938dda67a14bc515b8c407ebf4e6b7de48317579",
      "text": "我很想知道他会怎么烹饪。\n无论是烹调手法还是最后的装盘，都极其出色。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:7032aad20ace0dfa375c598415aa2b5ff98a7f2017f16247893734dd818fb3e8",
      "text": "没想到还有那种烹调方法……\n呵呵，真是受益匪浅。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:c98f50e64d5c6bed2ed8a230feccd1fee55a92adb5b4b5401caa41375d547e7f",
      "text": "试吃了一下，\n味道真的特别棒呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:603f8a79449c8c2e6008bd4e54915f7603a6d99288457d47e0d1785d210c6af0",
      "text": "呵呵，确实。多亏去参观了现场，\n感觉能配出一段优秀的旁白了。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_02:1_5_028_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:243d5d277a3fb88ad2cdb2fd5989f1681a4f71c3490ba6ed6a3eb891194c18e9",
      "text": "那就太好了。\n很期待庄一郎先生的旁白哦！",
      "status": "draft"
    }
  }
}
