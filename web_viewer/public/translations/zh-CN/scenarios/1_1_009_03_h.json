{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_03_h",
  "source_raw_hash": "sha256:58e91dcdcec6ba4f758d31b67e7b46ff975d47d9b34a7bd0284319e4c5c42c0c",
  "entries": {
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000016:time_caption:000": {
      "source_hash": "sha256:329b45cb19cd7f6739deff00854fb54bd88a0e9d3535b36296a3b735f599097a",
      "text": "十分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000039:dialogue:000": {
      "source_hash": "sha256:492d93197d08093d3523edf59db94e4796c55be0f280e493918490ab579f2f95",
      "text": "好痛痛……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000045:dialogue:000": {
      "source_hash": "sha256:110764bc95c26ac14e2a5c76067481b5bc47b2099794f365709ce1d1aed11954",
      "text": "我刚才都听到了。\n你为什么要瞪那些高中生啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000052:dialogue:000": {
      "source_hash": "sha256:844c13d10a2bbb0d93d479cb242124a99347c571094481bbf3dcdfd6b11edb81",
      "text": "没有，单纯是因为没戴眼镜，\n把眼睛眯起来了而已……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000059:dialogue:000": {
      "source_hash": "sha256:7cd23d5952232bbd8562c1c3c723322cdeb56c7cdff06f812b8855c086e95155",
      "text": "真的假的……那不就是纯找茬嘛。\n你可真倒霉啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000064:dialogue:000": {
      "source_hash": "sha256:6f4f8827970114c51cc7bd78f4f36cf0e038ad974f41e08a43e0827eeb1d38b4",
      "text": "你才是。\n为什么要帮素不相识的我啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000067:dialogue:000": {
      "source_hash": "sha256:9447c1434c70671b0c59cb9d8c8a497dd7f78ec488aa8bc0cec328039ccfd882",
      "text": "看到有人被坏蛋包围，\n当然要去帮忙啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000071:dialogue:000": {
      "source_hash": "sha256:2f9fca14851e016942e2489422f774492b8713ecd19dfcda264b7138f146260d",
      "text": "你刚才一个人也打算跟高中生对着干吧。\n……很有骨气嘛，你这家伙。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000076:dialogue:000": {
      "source_hash": "sha256:07a4251a07fb14f72a8a03c27fe109707b438f43afaa05970b9b82acf0230fef",
      "text": "你刚才也很帅气啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000081:dialogue:000": {
      "source_hash": "sha256:2dd919272092b4f02298c56fee9c147e524aa0a16f2399576f7646fdc2b7b84d",
      "text": "……呵，虽说我们输了就是了。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000084:dialogue:000": {
      "source_hash": "sha256:34eb53431e1e80ca3ab84fef8e8483a070116efdc7d70bb57c9c9ed39e277212",
      "text": "是啊，被揍得鼻青脸肿呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000089:dialogue:000": {
      "source_hash": "sha256:e5c17010aeb18c47070ebcc9d2d6b0b91e5b991c2185d0601dff318a6ee85796",
      "text": "说起来，还没问你名字呢！\n我叫红井朱雀！初三！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000102:dialogue:000": {
      "source_hash": "sha256:21e0c6b174e1d3f22896870291e352a7e5793ffe07c2067d48a81e491ce4b4fd",
      "text": "然后，这家伙是喵喜威。\n我都叫它喵子。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000104:dialogue:000": {
      "source_hash": "sha256:e5d0765a37d210f766c76b197a95148a35ad17d33c4c6123cc2aaea2ce131bd1",
      "text": "喵喵～！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000120:dialogue:000": {
      "source_hash": "sha256:fe96b413c808e95399e2f3f7b7ae5316c11dbd0893c1e10e51247cbaaa03bbe1",
      "text": "……这样啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000123:dialogue:000": {
      "source_hash": "sha256:25f1636ce4121ec82999eb41612a9cf17f2d9d0799684510837f24153e215863",
      "text": "怎么往那边跑啊？\n算了，无所谓啦。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_h:cmd-000127:dialogue:000": {
      "source_hash": "sha256:749da9da33084379379782d9779df299a31807f7d0a34c6634e1aebed9e5f66e",
      "text": "话说，你叫什么名字啊？",
      "status": "draft"
    }
  }
}
