{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "006tsu_401_2_4_006_01_09_b",
  "source_raw_hash": "sha256:4bf67a2e35a9d16d5264f4724d5202c9cf1a37fe0aca7da0b737c3944ef20ccf",
  "entries": {
    "story-text:v1:006tsu_401_2_4_006_01_09_b:2_4_006_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:71a1c9f135cb5476c66d9e5eee064a8c4db5ffb94b4368fc902f8495fb7cb0fb",
      "text": "●●●●プロデューサー，辛苦了。\n我是柏木。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_b:2_4_006_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:15a2274eb8ea3b9321df5a6e59a5f24594623a32afbd3a3d539975d0b4dde11c",
      "text": "前阵子那个广告的评价\n好像很不错，我总算放心了。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_b:2_4_006_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:0ead09ac32160d13456532f6491010df580df2bcdb5aa260e88607742365eef9",
      "text": "那是因为翼先生\n非常努力哦！",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_b:2_4_006_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_b:2_4_006_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:af63c0e1a2ab202abd3345c9d2446f7544c99d9197aecf2dbca61fdfe4104ee2",
      "text": "现场也非常开心，\n我还想再接滑雪相关的工作。",
      "status": "draft"
    },
    "story-text:v1:006tsu_401_2_4_006_01_09_b:2_4_006_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:56c5112008d29902e29382bcd53c4b5f103ac238d39680cf3b7444c73416ecf3",
      "text": "为此我也要在各种各样的工作上\n继续努力！",
      "status": "draft"
    }
  }
}
