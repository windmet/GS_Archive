{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_042_01_e",
  "source_raw_hash": "sha256:6138ad75f7b33c97d3ffa0be4ad63ba19c4ec1418830577f29943523923fa76a",
  "entries": {
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000013:dialogue:000": {
      "source_hash": "sha256:b24f780d6706a238f4bd37b1ebc5cd3caf61f073b74d6622119d0c0f040ff90e",
      "text": "虽然出了点小意外，\n但总归是次开心的拍摄呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000015:dialogue:000": {
      "source_hash": "sha256:4c09bf875b78536ef3a067f87aa58eab7f692aeb775d5c166664771483f7bd8c",
      "text": "是啊，真期待播出的日子。",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000020:dialogue:000": {
      "source_hash": "sha256:eabf68b383b701bbfe0b5b25a99639f8ba4445fa838fc24d16d91b86846e8418",
      "text": "嗯！\n好期待会被剪辑成什么样啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000026:dialogue:000": {
      "source_hash": "sha256:80b9f58bc5092ca95b957be46c199a0869089cbd9f321e4abdc1e972ae70f1e4",
      "text": "嗯——，还有啊，Boss。\n有个请求。",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000028:dialogue:000": {
      "source_hash": "sha256:ccf31b375de4dce2efa34bf4d6f746f24092599f4d6c18cda458d911450d5bfe",
      "text": "是什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2e5dd632dbed59e18a6cbccade46c351f8ba93f7b429b45c16467079777729ef",
      "text": "凉和老师他们两个，肯定都会看\n俺出演的节目的吧……",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000035:dialogue:000": {
      "source_hash": "sha256:bef95de6ed32f175e150e6a4b49ac25c9ba6fe1cc77f32940b65921b6cdf5609",
      "text": "俺怕老鼠这事，\n在节目播出之前希望能替俺保密！",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000037:dialogue:000": {
      "source_hash": "sha256:00c5c600c3f9f8d2c2fa29c2ad00d4d544d7353bc1bbac9c1047d1419aa6b37c",
      "text": "明白了！\n既然大吾先生这么说，我会保密的。",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000042:dialogue:000": {
      "source_hash": "sha256:69b9037f8fc4a39e8ba61dd107d4f8d417430dda6c3b839f8b11f6dc8652735f",
      "text": "多谢啦！\n虽然也不是什么非瞒着不可的事，",
      "status": "draft"
    },
    "story-text:v1:1_2_042dai_01_1_2_042_01:1_2_042_01_e:cmd-000047:dialogue:000": {
      "source_hash": "sha256:d781bf7e26d6fdf282921fabe505bbde30b4501fb629ef3d0173407af2c1e043",
      "text": "但这是俺和Boss，两个人的秘密嘛。\n这样一来，还稍微有点让人兴奋呢！",
      "status": "draft"
    }
  }
}
