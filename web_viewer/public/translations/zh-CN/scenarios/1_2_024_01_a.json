{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_024_01_a",
  "source_raw_hash": "sha256:82cdf61b8e2bf68657cd5822477fdeca568559c2d6d6db12975f4ea1b1f4c0b7",
  "entries": {
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:83f68ddf38e7b557a57f40e1d9510c27e3e502b63261c3c043019783d22c6834",
      "text": "衣锦还乡Mega荣归",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:2ca8808c595764c6f8671d07bf0a7060ce9e3bb835f77788d74bda80f7b206d3",
      "text": "四季确定要出演与他颇有渊源的青森当地的活动。\n能站在曾经作为观众仰望过的舞台上，他兴奋不已。\n到了活动当天，面对令人怀念的会场雀跃不已的四季\n面前出现了一个人。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:83f68ddf38e7b557a57f40e1d9510c27e3e502b63261c3c043019783d22c6834",
      "text": "衣锦还乡Mega荣归",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:8bcc3b90781b7221410f39116bb9aa9c61f962284ed979b620bff57e20e21561",
      "text": "辛苦啦，\n●●●●プロデューサー酱！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:ec419eda149e79e1dd3e2249244e32eedf47ed8af91c88c1c28b918798c807f8",
      "text": "敲定新工作了对吧……\n咦？今天只有我一个人吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:28d6cd2968d2616b54c1b93972b2a9c22722832435e5f5f1263bb4cfe93e3d23",
      "text": "是的，没错。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:b0d08385eed556706cf636c4e762cb3df48173cbbd874abb0181416c47b2a6db",
      "text": "原来是这样啊！\n那么，是什么样的工作呢？",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000039:dialogue:000": {
      "source_hash": "sha256:ed6ff00e2578b8fe4bfeeaeb2c5ae4fa7886ffe772ec68e52b3c58865f02eb93",
      "text": "这次的工作是去地方活动演出，\n地点是……青森！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:6fd50836a262911cde0733d643e49e5abc7a9065b782de0478d1bd665547eff9",
      "text": "……哎？哎哎——！？\n真、真真真的假的啊！？",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:8f477f36276f546040caf30616ef8c690712acaa6556849cc0258f758d34890f",
      "text": "是的！是真的！关于活动的详情\n请看这里。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:dc8ca92f3d4801c01af6ce145d72fe6aaf9fdf39d37a21d482a99fe5ab3874de",
      "text": "哇——我知道这个活动！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:27c5d732837b8e95f92f5e9c1d674c2b650029d0f18cb0b160caad30aacf4a61",
      "text": "没想到会因为工作去青森！\n得赶紧告诉奶奶他们……",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:23023da970ea1a957ca0f000d9317a6a77d0b7d0e3337fbefb2f1073d3657a4c",
      "text": "啊，解禁情报之前不能说！\n这里必须咬牙忍住……！",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:716a55cebfe8a4d177c07dc95df4bbb98feb1649ebe5f1534996b5bb7ab4ef47",
      "text": "活动的公布日期已经定下来了，\n网站公开后我马上就通知你。",
      "status": "draft"
    },
    "story-text:v1:1_2_024shk_01_1_2_024_01:1_2_024_01_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:d31a055f7331e6ce637ae76b1c2997bc03694f6274926f2521f7bcfd072d92b5",
      "text": "太好啦！我要用马赫般的速度联络奶奶！\n呜呜～好期待啊～！",
      "status": "draft"
    }
  }
}
