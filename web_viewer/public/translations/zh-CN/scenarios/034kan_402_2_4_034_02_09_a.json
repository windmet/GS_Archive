{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "034kan_402_2_4_034_02_09_a",
  "source_raw_hash": "sha256:178d35e90132aa047d1c1d70de014a9043a640f61e8b5b5f25ec9942e62bee80",
  "entries": {
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:cef13e2201e4fcf93218eda844f60839a9a5b4e387b2fd9b6aff75c0b83b1f0b",
      "text": "喂，制作人。\n爸爸看了前几天工作的照片哦！",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1ee855160c7e0917a99e738f5c30960fdbb41b4352e4f36a3224ce272189ed9d",
      "text": "然后呢，他说感觉\n脑子里涌现出灵感了！",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:e6ae23d68ff4e79e07b4ae47b26f79ff2e081dc4d403b06846d0b7e7c3e53449",
      "text": "花音能做这样为别人带去力量的\n工作，真的很开心。",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:137cc4b5a18384f0ad6463c443a8a2fc19b24b9116da4938238a7662fe9e5ff3",
      "text": "这是花音君努力的成果",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:3068aebdb294272253ad380dd2d45d487b3e5714b0b0efdf8f2df45d9103b7e2",
      "text": "因为这次的工作大获成功了嘛",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:aadceafbfcac964483eab774ce5d8404e6173a23321c7458edb8cf299a76a592",
      "text": "诶嘿嘿，制作人，谢谢你！",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:e35b43df85cfe8164fd81ef48c1c78b336d1b51533da4e9e722fb86c4693b7a0",
      "text": "然后爸爸还说，希望花音以后能让成为自己新娘的人\n真正幸福起来呢。",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:41e6742027fbc53add9938cd617b51a3f431d9bca1b5f9acd43197a4ebde762a",
      "text": "虽然完全想象不出\n什么样的人会成为花音的新娘，",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:c03e83abfb791beb3256cdc488a7c425046779dc1099cb38c2c3f7d884c3d0f1",
      "text": "但花音希望能和新娘两个人一起\n变得幸福呢♪",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:553fbcc5f42f5c3399de027b2c55693240702742a614e2984be37e47e9f793d0",
      "text": "因为如果两个人都幸福的话，幸福也会变成两倍吧！\n呐，很棒对不对？",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_a:2_4_034_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:434448eeea9cc907f0afe00fb195d38fef7a11f978e060b8ccc8173f36dd1cbe",
      "text": "那就明天见咯，制作人！",
      "status": "draft"
    }
  }
}
