{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_03_f",
  "source_raw_hash": "sha256:27d6fd712d6da0a21ebc85c7da7cbfc60c70dcc860e81c985e52506717999639",
  "entries": {
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000017:dialogue:000": {
      "source_hash": "sha256:c31d925f5ea92085267a4ffadeae39b8eede38d1aca3f2988809e6831cb4c03c",
      "text": "这里在招兼职吗！？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000021:dialogue:000": {
      "source_hash": "sha256:8e8bd1c641df25fe7a7e623a767278b866330c02b57fa27045d2a114f49dd6bc",
      "text": "哎，兼职吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000029:dialogue:000": {
      "source_hash": "sha256:e8d3bd16093b3d92b9b8b218672fb1c907cc281a860139ae59e93926717eef1f",
      "text": "是的！我想在这里工作。\n拜托了！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000035:dialogue:000": {
      "source_hash": "sha256:ab3590d7308dcbb00b6b3c46c77be99e9d275fc861bf38e7f2adb74aef81cac0",
      "text": "哈哈，之前也遇到过类似的事情呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000038:dialogue:000": {
      "source_hash": "sha256:ef5eb92c85a8dcb733d95b3e17bdc280a963cb0a8599bcb39c5060139a8becc0",
      "text": "虽说有卷绪加入了，\n但Cafe Parade确实人手不足。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000044:dialogue:000": {
      "source_hash": "sha256:0f0ff808e506f5429a4a036d5e352880956f45f5dc4da91b5b276c4ff464ae03",
      "text": "水岛同学愿意来工作的话，倒是帮了大忙。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000049:dialogue:000": {
      "source_hash": "sha256:647bb78a31a9d45bd69a0d422fd168243a0af900361f52e39053d6a5ac5e6e2b",
      "text": "话虽如此，光凭我一个人是没法答复的。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000053:dialogue:000": {
      "source_hash": "sha256:2349fdc06bcb6f40d4777849a598ae2c936389757cc5642bdec5406b4a8e342d",
      "text": "店里的钱包掌管在另一个人手里，\n我得去跟他商量一下。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_f:cmd-000057:dialogue:000": {
      "source_hash": "sha256:116c0c6af2025980a95cb4d4bbaa8ec3b48285bc9ca094d71d9404e089c489e5",
      "text": "好的！拜托您了！",
      "status": "draft"
    }
  }
}
