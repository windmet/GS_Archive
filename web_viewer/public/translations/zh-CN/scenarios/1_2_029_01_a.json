{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_029_01_a",
  "source_raw_hash": "sha256:c2b2ed07bce59189edc8a5818f30ec742f6b6fba499b07b87c0d893138e7e18c",
  "entries": {
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:aa9df107c1e647b54e7bae9f7c1661b96e456a42d42a1af893a04ce25971f647",
      "text": "幼小之人的来袭",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:6dbc634bf248be7047423063ad4656c7174cee96d7a312973f503dec9704b5cd",
      "text": "制作人接到了一通电话。\n那是原本今天休息的阿斯兰打来的。\n不仅如此，内容还是求救信号……\n赶往阿斯兰所在的Cafe Parade后，\n那里却有一个素不相识的孩子……？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000006:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000006:title:001": {
      "source_hash": "sha256:aa9df107c1e647b54e7bae9f7c1661b96e456a42d42a1af893a04ce25971f647",
      "text": "幼小之人的来袭",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000011:dialogue:000": {
      "source_hash": "sha256:d47f869448430103f305409673938dc818a5ba9fb8bd8b97419ec48ddd9a98ae",
      "text": "……咦，电话响了。\n喂？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:e9d7821192f089774f50b0fb575c0ff578c159479f56f3cf83e2a9eade12fae8",
      "text": "啊，吾主……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:84f283bbfa16b0e47188b9ca33eeb57113a3bf77c2bb376488a823fe617880ea",
      "text": "这声音，是阿斯兰先生吧。\n今天应该是休息日，怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:fb8877303ed395fe3b5126235f81955acb34f4a4367fdc3f16ce1ef534dd8e9c",
      "text": "那、那个……吾……\n救、救救吾……！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:4c83b90927b10f36d0caacac8d3fbc6052dc2d0bf67fab167ca33b6b8b8a0147",
      "text": "哎！？您现在在哪里？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:bcd0047b5eed991611c2a57ef22d127aa7c3268d7cb8be454661df89a2d692a0",
      "text": "吾现在藏身于圣域之中……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:d77154ac2e78b4bdd2ea0e5a71fa8cf23e9616586e00100cdff116a1396900b5",
      "text": "唔！那家伙的气息越来越强了……！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7e3e682e89d8ea13f13e54fcc1a629ada0fd08517491a32996536217afe29ee1",
      "text": "汝方为留存予吾之最后的希望。\n拜托了，吾主……！！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:8d56be9a092192779e8f682c4fa09058f1272c4d60cc48588dcbb1d6745140a2",
      "text": "阿斯兰先生……阿斯兰先生！？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:b3ec3183865185bea7c84d21c698cafe16d271c9508e03e8625c8174953130e0",
      "text": "（说到圣域……是那个地方吗？）",
      "status": "draft"
    }
  }
}
