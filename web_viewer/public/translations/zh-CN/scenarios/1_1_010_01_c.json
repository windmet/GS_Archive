{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_c",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000016:dialogue:000": {
      "source_hash": "sha256:ec9305c3e4888959690a16fde649502cb142058d5f2cd85df098609761f6de1a",
      "text": "（自那日起，吾便在师尊座下研习精制术）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000018:dialogue:000": {
      "source_hash": "sha256:9b70eddebfe3b619b529d887d5d2a7fa081ee71581020f268df2c6a4dc7c9141",
      "text": "（其后又远赴他国精进魔力，待回归故土时，\n师尊却已不知所踪……师尊之店亦荡然无存）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000028:dialogue:000": {
      "source_hash": "sha256:919e5778cf03f00690ca1e5b19b6655c8838f58dd6d4efd61be6fa9ba37f98a9",
      "text": "难道吾之容身之处，\n已然无处可寻了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000031:dialogue:000": {
      "source_hash": "sha256:8862db5a38e0d75ed5414c7b0603fe9aa770a64dc6a3b8891f756fe9c7269584",
      "text": "吾今后究竟当如何……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000046:dialogue:000": {
      "source_hash": "sha256:4bfc48a77291ee72af0571a34e387bf6a9c972b568328cfffab8eba200cfb428",
      "text": "你没事吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000049:dialogue:000": {
      "source_hash": "sha256:a351f775b34410907e94402da7a38308aaa3c6d1965a29a11d8707d2bc9bfcbc",
      "text": "唔！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000055:dialogue:000": {
      "source_hash": "sha256:5c9a1d068231b2b99f4bb073f02122824a1dc41ef7a95a1a850044c1c162e877",
      "text": "都淋成落汤鸡了不是吗。\n呆在这种地方会感冒的哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000059:dialogue:000": {
      "source_hash": "sha256:dc2095c826989060aadeaf72ee5dd57315329b19c5df13fc34d7715e639ca6b2",
      "text": "不介意的话，请进里面避避雨吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000065:dialogue:000": {
      "source_hash": "sha256:4f2e88f8d65367bade8e3643d51a2a389785f945801d6ba3793702ab10b26b67",
      "text": "吾、吾乃暗之使者！\n岂能轻易受人施舍……嗯？“里面”？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000071:dialogue:000": {
      "source_hash": "sha256:50266627b68604a9280cfe4ec8184f46af3fde97d58a102153e77e517dd3cd5f",
      "text": "是啊，别客气。请进！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_c:cmd-000093:dialogue:000": {
      "source_hash": "sha256:32422daa9388d2963730340e0143b27d9385f0654c02a8a1f9f88c8ab509ec7e",
      "text": "欢迎光临Cafe Parade！",
      "status": "draft"
    }
  }
}
