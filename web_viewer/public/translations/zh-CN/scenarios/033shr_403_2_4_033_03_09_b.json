{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "033shr_403_2_4_033_03_09_b",
  "source_raw_hash": "sha256:02701b18d85b95fc3c181646c64bfde14df83984be6c57f2fa654a7df3cb21cd",
  "entries": {
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:202ba4ee494d0054f150333abb5d8a9593e6f5b3ffe13057901e5a859fd43a8d",
      "text": "●●●●プロデューサー！听我说啊！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1dcf850527a4772f2cf767df4a8b131a61682490960a515bd4b2f56b9a535256",
      "text": "我今天的作业已经全写完了，\n现在就可以去参加训练课哦！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:c3010341175cbc3cfa1558ca85b86af76aeb858479cfce6e5f3b0d3afd318ba3",
      "text": "太棒了！\n好快啊！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:b8fa400909119a3ec4bf5ded74fdf430a0e065733780818667341b7969f6bac6",
      "text": "之前纠结的题目解出来了吗？",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:c59248bcf5549bca0f278e02757dfc5c0873c753c9ef8206c1009ae8527ba9c5",
      "text": "一直不会做的地方，\n辉教我弄懂了！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:f8ac868e07e43fd1651d2256b994c22a5c585f763eb09b12f9e9ae6c194c44ce",
      "text": "虽然很难，但辉一直在讲冷笑话，\n所以连学习都变得超好玩的～。",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:a1f252aafd6542968e9eaa1d43636000cb6f9b2ba3bf73cf5fd088fed9aa2563",
      "text": "结果不知不觉间，\n全都搞明白了，超痛快！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:2434ccf89c75629af76f635eedd2e74a1e9003de7d5a2a2b83e926fd4afbc663",
      "text": "就算明天的课上被点名，\n我也绝对能答得上来！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:6d32291356347faa4edd53dace9421eab3c4e15d507377bc5d42e52d652e98fe",
      "text": "要是我自己主动举手的话，\n老师肯定会大吃一惊吧～♪",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:baaeb5130c61c81546a946b0d4733cfc1970e710bebe20037762d849603e921e",
      "text": "要是你想学，今天我学到的地方，\n待会儿教教制作人也可以哦。",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000029:phone_message:000": {
      "source_hash": "sha256:aebfe44528614e648a1fef90ddc10914973f487608be56c7f0f1cc36a64a1f47",
      "text": "……啊，是道夫老师和实！\n嘿嘿，我今天的作业已经写完啦！",
      "status": "draft"
    },
    "story-text:v1:033shr_403_2_4_033_03_09_b:2_4_033_03_09_b:cmd-000031:phone_message:000": {
      "source_hash": "sha256:30f17123ff71477a327c9fa39732b3f54f6a27abe6f9759c7f010d1f17570043",
      "text": "制作人！大家都到齐了，\n我们一起去训练室了哦！拜啦！",
      "status": "draft"
    }
  }
}
