{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_044ame_1_5_044_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000010:title:001": {
      "source_hash": "sha256:47686eb0a4b61f78e24de8d2f5b5abd2717530ba5fa231bb93308272767d6ba4",
      "text": "清洁用具广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:af816c26fb287c1db1827793b3a3eab907958b412eeb4303effaf9e195425078",
      "text": "拍摄时间都过了，\n居然连彩排都还没能开始啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:9067e5081a36593cd5e336fb587b1556dbdc690c27391b229c3f934df193dcf4",
      "text": "虽然说是器材出了故障，\n但到底什么时候才能修好呢……",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:75037671c8083140aee2d2bd0742bdd5e660e018c640d6e18fe6415d086f43b4",
      "text": "雨彦先生？",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:79527d4826148ddc4d6fe7dfdabb4288e771d661f5e96ec290f0cc37c3a0d3a9",
      "text": "我发现有点让人在意的污渍。\n先失陪一下。没什么，马上就回来。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000050:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "几分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000057:dialogue:000": {
      "source_hash": "sha256:c7a36d1fc075bbc05adef00227f9786f1f3e32d1140a6cef2fa7777771def38f",
      "text": "……啊，雨彦先生欢迎回来。\n工作人员刚好过来叫我们了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000060:dialogue:000": {
      "source_hash": "sha256:c266f9a329bdc5b40331903ca5012e82b0eacea54ebe1c2d9e6281d6d3ace1cc",
      "text": "看来器材故障已经解决了啊。\n太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000064:dialogue:000": {
      "source_hash": "sha256:968a654382041f8dc72890d47e802f1ca80f0cf347faabe842b28b9a8946d7e8",
      "text": "这样就能安心拍摄了。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000067:dialogue:000": {
      "source_hash": "sha256:be02b15c9e8c0581e5fbc0da15c0fd46500ee440bd870dab7c1db6b7bb5c23ad",
      "text": "是啊！不过……雨彦先生\n刚才去做了什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_02:1_5_044_02:cmd-000073:dialogue:000": {
      "source_hash": "sha256:3bf950159dd0af9e835ca90334ceff91350addfc436cf7d3ff2229c69c5160ae",
      "text": "只是随手清理了一下而已。\n既然叫我们了，就回录影棚去吧。",
      "status": "draft"
    }
  }
}
