{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_015_01_c",
  "source_raw_hash": "sha256:db06ee4ad501a06e5f4daab51b377b7f7718bdcbf52b5247575d38c3f53c4333",
  "entries": {
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000014:dialogue:000": {
      "source_hash": "sha256:11ff574e9861f80340b60dfd7c9fab74542124bb6372b35874f4552f053f6d48",
      "text": "哇，好有趣！\n真的，净是些没见过的杂货！",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000016:dialogue:000": {
      "source_hash": "sha256:950dd50a1af7d25a012f33c3f0ce6dd65245864a854e25ef3044587a6c874806",
      "text": "这种店，亏你知道呢～\n难道说，你经常来吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000018:dialogue:000": {
      "source_hash": "sha256:2a8a17e5289260bba3a59e21515e17a1651d10a1548b358e2af337563ebbb33b",
      "text": "算是吧。好像我的喜好有点怪呢。\n就喜欢这种有个性的店。",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000028:dialogue:000": {
      "source_hash": "sha256:61940f03c4f7d335b97562515c27b9803bfa42463cae0859159228e0deac1428",
      "text": "（……“有点怪”，呢～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:7a521dec96a9cac2f2b3e5c93f1dca72023f0ce8183839d37845476350e949ae",
      "text": "（这种话，是可以自己说出来的吗～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000035:dialogue:000": {
      "source_hash": "sha256:fc7739c0363ba30b9ab96f41f57672b174ae35236a82b3c5dc9dda17ecef4a4b",
      "text": "（肯定是因为自知没有个性，\n才想要表现得与众不同吧～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000038:dialogue:000": {
      "source_hash": "sha256:25757ff2cf9ce56cf849cc49d21f4568c0d2573102b10523d315138be52ac79f",
      "text": "（伪装自己，以保住容身之所或地位。\n那不就说明，是个非常没有个性的人吗～）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:d289d7475043fe61d16c57e4029b0c62b9eae0f19d6bf28dcb40de3b6417be66",
      "text": "（虚张声势戴面具，终究不过同路人）",
      "status": "draft"
    },
    "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_c:cmd-000046:dialogue:000": {
      "source_hash": "sha256:37504d772c9fd3a744ed4df26d957b091fd59f6ab8b3deb4af2cce1c996dc2da",
      "text": "（……嘛，说到戴着面具，\n我好像也没资格说别人呢～……）",
      "status": "draft"
    }
  }
}
