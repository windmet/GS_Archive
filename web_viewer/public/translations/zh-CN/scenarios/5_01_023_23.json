{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_023_23",
  "source_raw_hash": "sha256:dcf363d5d01116b53db49a868782e51a52e069d3d25b9181b5f96e256f4cb229",
  "entries": {
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:086dc254b3a5f0ed5dcf8a62c30b424a30ce7de54e42e3337565460330b03275",
      "text": "多谢啦，制作人！\n谢谢你陪我排队。",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:89b2d9e1b928aaaf711b027f4c915f7bc7368d035eb26cd185914e7f5ea87319",
      "text": "哪里哪里。我也很想尝尝看，\n你能邀请我真是太好了！",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:72c0ad76e755a3c3f9a6e88802af05e20b1b216ec993a33e3b9d34befae610ea",
      "text": "真期待啊～情人节限定的巧克力甜甜圈！\n看起来超级美味，排这么长的队也完全可以理解啊。",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:84a5de362ee1f3d15d76e7aae1a7fa63d18af7ccfb69739557ccf478fff7afdf",
      "text": "对了，●●●●プロデューサー！\n等顺利买到了，我们一起拍照吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:96effba52520348aaee1302025794f82cc353c4f29a5da903bdc786aaa28a89f",
      "text": "外观看起来也超可爱，\n可是现在引发话题的商品呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:3d5b6c5f0b971c31913f2d32a2b908a9fbc399463cd120fdee5fdc866cc13eb4",
      "text": "嗯——买几个好呢……\n好纠结啊……制作人，你吃几个？",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000036:choice_short:000": {
      "source_hash": "sha256:70c97ed70d620b9cc7b66f9f98fc03cb8e55d396b5493a7b83782f608e159c7b",
      "text": "春名先生想吃几个就买几个吧",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000037:choice_short:000": {
      "source_hash": "sha256:5f4b930ba4cb8ef31a5647445d848115bea7588a05ca7aedc182a1df6141302b",
      "text": "多少个我感觉都吃得下！",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:12227a597c37794cafeb008be6ad672eca6e8b715975dc93ab4d662cdae9a43a",
      "text": "哦，那我们就买一大堆吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:133396bfa9cf892d182305bc415cdf4e082905d1580f13d3873de5ac9d296b37",
      "text": "啊，队伍前进了！\n嘿嘿，就差一点点了。",
      "status": "draft"
    },
    "story-text:v1:5_01_023_23:5_01_023_23_a:cmd-000054:dialogue:000": {
      "source_hash": "sha256:6d3667e52483faece3def47cece43ae548a173c986a1de101c1d5702d0cc4a52",
      "text": "和制作人聊着天，\n排队的时间一下子就过去了呢。",
      "status": "draft"
    }
  }
}
