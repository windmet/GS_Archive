{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_008rei_2_1_8_008_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_008rei_2_1_8_008_02:1_8_008_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:c626d0cef5c39bcbc598bfe0ff7ae65ada9f532c3d313c80d1964217f8c11233",
      "text": "辛苦了。\n我听说阁下差不多要回来了，就顺路过来看了看。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_2_1_8_008_02:1_8_008_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:ddd11df3faa0870efd772b25076b29e9e5673624f13c582c2d9f605b07071875",
      "text": "祝你生日快乐。\n我只是想来传达这句话而已。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_2_1_8_008_02:1_8_008_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:e540b3d77b3a6a4aa3d96fc9dffb56948b52342e71e10a77fedf9a4a277fc95b",
      "text": "非常感谢。\n难道让您久等了吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_2_1_8_008_02:1_8_008_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:07020dddabab385f4f0b87e201d1f6313697d8a86bbbcf55b997c137161d04af",
      "text": "不。我也是刚刚才到。况且，\n为了给阁下送上祝福，等上一会儿又算得了什么。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_2_1_8_008_02:1_8_008_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:186bbf6acdcb93fc9db1d5cd25565962c9acd745c4fd6468292f8f089e0e874b",
      "text": "虽说夕阳已经西斜，\n但还是祝你度过美好的一天。",
      "status": "draft"
    }
  }
}
