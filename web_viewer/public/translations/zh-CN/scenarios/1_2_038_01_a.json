{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_038_01_a",
  "source_raw_hash": "sha256:a36823baed9e2a399b85b518dd1862222eb458e43f6c94e2462b44aa3156739a",
  "entries": {
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:356015c1a1f762c80ceea62c4c93a3b68cb2b3696c3e41d2acc427a8d0a991a2",
      "text": "倾注珍贵的心意",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:6f13cf95f000bf2ffcd1e73b2f7065519b0787415bd7a79a5b3e36849907e374",
      "text": "客户听说武喜欢猫和猫咪周边，\n便发来了联名猫咪周边的邀约。\n武虽然着手开始构思设计，\n却在主题上犯了难，迟迟无法动笔……",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:356015c1a1f762c80ceea62c4c93a3b68cb2b3696c3e41d2acc427a8d0a991a2",
      "text": "倾注珍贵的心意",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:b03a17dff93f42b5b12c5570892b92c06b41403ea6e633e83a1aa01ee65c8860",
      "text": "辛苦了，武先生。\n让您久等了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:9104ba9bb9c965c622698674af9f239509bc70ca87306b6e5d132b9014070229",
      "text": "没，不要紧。\n所以，要谈的工作是什么？",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:dd506d3f80f551783f7e0b03a86037cab2707708b1332ea23c2af27834cd00f4",
      "text": "其实，是客户听说武先生喜欢猫和猫咪周边，\n主动联系了我们。",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:a64bf2064a0a5e860ca91457e2052aee860c526a5107cb8661f5c47cc42f1ef0",
      "text": "收到了希望能和武先生联名推出猫咪周边的邀约！",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:36a38ac86a89564fa563982d1bb8851b6e5c2b8837f14a6cf6b82962c5e6765a",
      "text": "周边联名吗。\n我有什么需要做的事吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:49dbc737408b7509e6801afd64f39aaeb3bfe4b48497ad0ed4f53ddb497c40cd",
      "text": "有的！需要您提提看想做怎样的周边，\n以及在周边里加入怎样的图案主题。",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:5b6a26608c5acd74baab9514c4485eda6edacf2520b913f6442e0b2d50e66c86",
      "text": "设计方面会拜托专业人士负责，\n所以您只要构想大致的形象就可以。",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:e024e7b91b22f115272bd15c54aae86912922cdcb290eccf283b276f889af7da",
      "text": "原来如此。那样的话我也能做得到。",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:9a47b4ef457b14d044e4dc4cd8e99e92814ad5d80b1f748693b8d5d4688e640d",
      "text": "居然知道我喜欢猫啊。\n挺开心的。",
      "status": "draft"
    },
    "story-text:v1:1_2_038tak_01_1_2_038_01:1_2_038_01_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:ab61c5ca799424842d24d3ea045ca1d7b52755e01b7b8ebac4c1e65367e21e86",
      "text": "这份工作，当然请让我接下。",
      "status": "draft"
    }
  }
}
