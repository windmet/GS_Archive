{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_020hay_1_8_020_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_020hay_1_8_020_01:1_8_020_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:bb218054575aba7bd57ed05c4a4a44a5614aec669cb7402c729a799156b5bcaa",
      "text": "早上好！\n……啊，是●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_8_020_01:1_8_020_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:88344627b0e180a57691c16f660df32b607462959dcb90027aca042f6b5a7657",
      "text": "生日快乐！\n我决定好了一见到你就要第一个说。",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_8_020_01:1_8_020_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:5e6b03cffd384edf727c99a8cefeb1faceb6c28a25e5fe07fac395b9f41d6628",
      "text": "原来是这样啊。\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_8_020_01:1_8_020_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:96d5f1926c1cd78ac0c0beb123d904b89c0710947cbfe79e17a190fd81aa0a2b",
      "text": "不用客气！\n哈啊，能好好说出来太好啦～。",
      "status": "draft"
    },
    "story-text:v1:1_x_020hay_1_8_020_01:1_8_020_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:4e54368b939a9650ea8bfdc6671535ac5700d5aac1922660096136f94a879a3d",
      "text": "不仅是今年，\n明年和以后我也要一直为你庆祝！",
      "status": "draft"
    }
  }
}
