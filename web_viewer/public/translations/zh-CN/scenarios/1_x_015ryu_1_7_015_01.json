{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_015ryu_1_7_015_01",
  "source_raw_hash": "sha256:f420f988b422c35346a31b3b544e64222368a484e707f464ac989e74118cb4b4",
  "entries": {
    "story-text:v1:1_x_015ryu_1_7_015_01:1_7_015_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:90ff81b881f4895dbc4cd9d776cbfaa19bd7bedb3d3489054752c7dc59a2cfd7",
      "text": "闹钟也坏了，鞋带也断了，\n今天也太倒霉了吧……",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_7_015_01:1_7_015_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:1ff7f087d192d6741703bc2e7d11c3aa77ea25238f5d4232c51aa5f14571081e",
      "text": "龙先生，辛苦了。\n还有，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_7_015_01:1_7_015_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:84b125dda6cfae53e0eee1bbd1c2ff706b289b3e5c7000177c60176558031cc7",
      "text": "哎！？……啊，说起来，\n今天是我生日啊！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_7_015_01:1_7_015_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:459e5d8d1bd889042d9717f7b4e1bfabebee1b89cafb0adaba3b3da25463e397",
      "text": "谢谢你，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_7_015_01:1_7_015_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:963b5509beaa5ce13d4b900d911af5da140161247ec70d9560ce53dde401c728",
      "text": "我刚才还在想今天真倒霉呢，\n一下子就变成幸运日了！",
      "status": "draft"
    }
  }
}
