  "entries": {
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000011:title:001": {
      "source_hash": "sha256:01f75c9576b5f02681110d44b6d946313a9da1689c1701b70b2d0fdeff82c100",
      "text": "大型食品公司炖菜CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:5e84cce77d7f3e87defb130ae77759b84797b7c76c8ce1ff1528446c6031cd35",
      "text": "今天是炖菜的CM拍摄。\n主题是“阖家团圆”。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:d220f2844e27672bc7104a70d4e883d9cb55067bcae97884cc01a4d6c1300afa",
      "text": "花音君饰演小孩子，要和其他共演人员\n一起吃炖菜。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:4cab343bbb6e7531f8936fff845b22a6dbf9127c9133c7264347e80cf748fb53",
      "text": "花音知道这个炖菜！",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:cd986aa734f8c284f886d787530001e0b21f523e1a02d9d009dc97d0903c3c30",
      "text": "妈妈也用这个料理块，\n给花音做过炖菜哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:69e83f91b324af0574b6e7a9d716f560cf5a93b0e56cd02776edda873cccfa90",
      "text": "超级好吃的，花音好喜欢♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2a6d8cb6fceb225304ec8e168549439776abc6b6f32deb796470f1984a6950b0",
      "text": "呵呵，这样啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:909cd0e811ffd23ed88c856b88fe49097bade3f834dcaddb35a7a8e4286861a5",
      "text": "就用刚才展现出的笑容，把炖菜的美味\n传达给电视机前的各位观众吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:aa628db2971b84d85c1070c88b88193fb02ad583bb6b59208cc576479e351b34",
      "text": "嗯！花音会加油的，\n●●●●プロデューサー要看好哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000051:time_caption:000": {
      "source_hash": "sha256:987ba07860aa3b428ec26f201eaa1c362650078965ee6576fd32ad3e1eabd711",
      "text": "电视演播室",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:64d94c132992d10019f4f2fe33fe554c195c14ed1b7d67ab295bfadf3795413e",
      "text": "“嗯～！妈妈做的炖菜\n是世界上最好吃的♪”",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_02:1_5_034_02:cmd-000063:dialogue:000": {
      "source_hash": "sha256:e81981fdaa5eac385d69b0dcea804fe4f2cc42e3735afe9dc326a17701c1e126",
      "text": "“……啊，已经吃完啦。\n妈妈，我还要一碗～！”",
      "status": "draft"
    }
  }
}
