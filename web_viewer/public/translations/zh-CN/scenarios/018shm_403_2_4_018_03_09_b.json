{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "018shm_403_2_4_018_03_09_b",
  "source_raw_hash": "sha256:6da13b5f3098def158d2c6f846663beb88096869269fdfc964253716015e66c6",
  "entries": {
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:3198644747a5e3511c47eceaaa005a710b7134f19367cf84d4c4a7cf6aae9f99",
      "text": "●●●●プロデューサー酱，辛苦啦。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:e752e9c9a776c199bae6026f991bac412bb629d2a664e1233e453c6e274a3014",
      "text": "前阵子拍的CM，我看到已经在车站前面的\n大屏幕上播放了哦。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:71978ca01c6887b9297e56d7137039d62613a0d0b4a7b724211fd70a03256192",
      "text": "和小伙子还有九郎酱一起看的呢♪",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:478b2c8c0fe8bc54dfab31b1c39153ac68ffa91df6ba0aef2adbce3d0cc11900",
      "text": "蝴蝶的主题方案，是艺术家查了我的资料之后\n专门提出来的吧？",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:8188a9a1d8cbf6151ed011f92c0beae142529ba15131cc8afe41b2e7916bcdbd",
      "text": "在彩这个组合里诞生的形象，\n能在个人工作里也得到运用，真让人高兴。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:1ee14847220fad77c4e0d8a862fe11dba02f7f183fc504189de5594f050c8306",
      "text": "我一边看着CM，一边和他们俩聊了这些呢。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:a84d98ce923bde77fe54797f0b7fe5f7105572de51e3b34b5098ac31db3d0185",
      "text": "这是件好事呢",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000021:choice_short:000": {
      "source_hash": "sha256:2a26f9ae627af31c9e5da365e89880375281c20d422d5cde8127e7657342345d",
      "text": "真是美好的关系呢",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:4eb6fcaa56ed0dbed349f7e4027a4176d55969a06ce74ce6aac6334e427b7fe5",
      "text": "是啊。我也再次觉得，自己也想成为\n能够给他们俩带去这种积极影响的人。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:6139a690dc41e7be52a9180fa93cae86078ccf236d0cb4fed97eba34e7d5a8f8",
      "text": "所以今后我也打算认真对待每一份工作，\n好好加油。",
      "status": "draft"
    },
    "story-text:v1:018shm_403_2_4_018_03_09_b:2_4_018_03_09_b:cmd-000029:phone_message:000": {
      "source_hash": "sha256:f8902b2e59ec5867272518c3778e15001f618a85fa7ed0b10596997b1652447a",
      "text": "下一份工作也拜托你啦，制作人酱。",
      "status": "draft"
    }
  }
}
