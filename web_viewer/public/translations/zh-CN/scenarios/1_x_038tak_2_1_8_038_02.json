{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_038tak_2_1_8_038_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_038tak_2_1_8_038_02:1_8_038_02:cmd-000013:dialogue:000": {
      "source_hash": "sha256:7c3e21c89c8d1d1b4cd7a6b0774171117128df13f978f3114ec2b4fdaaaf456f",
      "text": "●●●●プロデューサー。在录制开始前，\n能占用一点时间吗。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_8_038_02:1_8_038_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:d9e6571186264e7583d9e02f14347f6ada23848f5f71f0db8149d4b9473894aa",
      "text": "生日快乐。\n集合的时候没能来得及说，抱歉。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_8_038_02:1_8_038_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:db48bf1adb4cef807ea327f69205bb7b13d054499390895f9ae39f20dcf56445",
      "text": "没有的事，能收到您的祝福就非常\n高兴了！非常感谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_8_038_02:1_8_038_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:7c59723cff12a836fdeaa0bf67709538f2b076b5c529ec84d2de0f27431d4194",
      "text": "为了让你的生日成为美好的一天，\n接下来的录制，我也会好好拿出成果来的。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_8_038_02:1_8_038_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:6e0451a301d573767014682a8c77d14ce03cbfac970f76bc607ad1a2b7857f15",
      "text": "那我们先去录制了。\n度过美好的一天吧。",
      "status": "draft"
    }
  }
}
