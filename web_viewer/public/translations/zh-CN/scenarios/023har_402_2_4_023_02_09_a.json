{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "023har_402_2_4_023_02_09_a",
  "source_raw_hash": "sha256:aadfaa899c13bb29865a3736416f6f01951263e0699d65ce69c5b19da383a116",
  "entries": {
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:3fd68cf362337fb57d8ffa408702c929974a1001b0ae693e5dea086056e4445e",
      "text": "……啊，喂？\n●●●●プロデューサー？",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:a78e8a0faff7a069576632c90f3a5bf890864e124119e1fe245e19dc2fbdd9e1",
      "text": "辛苦了。\n请问怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000011:phone_message:000": {
      "source_hash": "sha256:5b7226e5c8595c186878a213baf0a1f96c024fa4f975299ef4cd24ed0f7f0042",
      "text": "倒也不是真有什么事啦……",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:db3c87ca8af02d2028f6f49d80358d91407456a1aabab7463c108bd75e37dba4",
      "text": "今天的夕阳超级漂亮啊。\n又大又晃眼的。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:f1339f1aaf0cf5afae90e5e8ab70bdfa17cd450dae8074819efc7e5be780c06c",
      "text": "颜色美得让人想一直看下去。跟舞台上看到的聚光灯好像……",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:115a6e24558180005f6a90d8ac63ca53773449e1e252e3da104f9bf4ac818fe2",
      "text": "然后我就突然好想听听●●●●プロデューサー的声音，\n忍不住就打电话过来了。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:d8d5d9b800a6d12e86e597a6fc2ca57f68a4a4c38e23aaedfa0887ac1fa94e18",
      "text": "明明你很忙，不好意思啊！\n听到你的声音我就安心多了。",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:acde61fdb1ca8dda8350727771da81ff9398295977c04d868dc6225c1121df82",
      "text": "那就好",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:5132a657ac06e4afc46885f0ba76a236b09da732eeae928a770d2d43cda7d902",
      "text": "有什么事\n随时都可以联系！",
      "status": "draft"
    },
    "story-text:v1:023har_402_2_4_023_02_09_a:2_4_023_02_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:d19b1c0b7385cde81cae2a51eda387e4db8fa5d0e3f3c9b210ed909017403c6f",
      "text": "谢啦，●●●●プロデューサー。\n那就明天见！",
      "status": "draft"
    }
  }
}
