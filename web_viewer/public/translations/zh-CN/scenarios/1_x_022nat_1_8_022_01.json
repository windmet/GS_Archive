  "entries": {
    "story-text:v1:1_x_022nat_1_8_022_01:1_8_022_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:5ceb74e3e1e529f914837da21c2ada15d77ec2e572de570f2725bbf2bbf7f2aa",
      "text": "●●●●プロデューサー，\n今天，是你生日对吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_8_022_01:1_8_022_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:f3357ec07c6f2c8c8986c542e8a5916b079ecd9d9befc9604cc35532b596c7e7",
      "text": "听四季他们，说的。\n生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_8_022_01:1_8_022_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:bc7b89201c37f6fd41ae3c94ed516debba0a67b7304bd89e9e2688a98052947d",
      "text": "我已经记住了，\n明年也会为你庆祝的。",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_8_022_01:1_8_022_01:cmd-000015:choice_short:000": {
      "source_hash": "sha256:b97842fa8ccf5c3b155bb1dfce40f44f2d320cbb5a8cf8252f98275a3ee16d0f",
      "text": "很期待哦！",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_8_022_01:1_8_022_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:82665cc93dea94f0002e6bfaa1f3c7db9a5302c41cedc7d954fe2e8ad1f40871",
      "text": "待会儿在事务所\n也会为你庆祝的呢。\n那就，待会儿见。",
      "status": "draft"
    }
  }
}
