{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10006_01_a",
  "source_raw_hash": "sha256:645450afab3af7403bd72eb47fafd0dbb5f825e4a3c38a56e92b2c76ee568d48",
  "entries": {
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:2ce8b5579fb51c36ff3073ac8bcd58dd6ac535604d60568c35a1c7b1d7ee19e7",
      "text": "越过我们的那端",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:d69f9326d65f8c7e2734bf2f3f105a90bba25e28211c74d5612907dcc33fd97d",
      "text": "もふもふえん决定作为惊喜嘉宾在结业典礼上\n举行现场表演。正当他们为了正式演出\n而刻苦练习的某一天，三人聊起了\n“要是长成了大人会怎样？”的话题……",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000007:title:000": {
      "source_hash": "sha256:6bd711a0c587f0c078d13f61396e0634340adf4afbcabad0ac20aea8f2b2a191",
      "text": "序章",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000007:title:001": {
      "source_hash": "sha256:2ce8b5579fb51c36ff3073ac8bcd58dd6ac535604d60568c35a1c7b1d7ee19e7",
      "text": "越过我们的那端",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000010:dialogue:000": {
      "source_hash": "sha256:f6402e9e83c454d76b42c8b0bb83ef2a21e8ea3c9bda1b79f4d4dbd13f8c0a78",
      "text": "哼哼哼～，哼哼哼——哼哼♪\n……咦？",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000020:time_caption:000": {
      "source_hash": "sha256:4bbacdc9473b8a904f46dfcdb542bdf525b64b0ad8a4f01f17816a23aab19ceb",
      "text": "幼儿园",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:822108d7d55372bd3223d830a7a1869f13d488bf027bee0836fcdff5e854a967",
      "text": "这个玩具是我的！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:06ff79c67a5ae340b467ef80b5837cee191768c631120a009fcf54d60d2682a2",
      "text": "才不是！\n明明是我先想玩的！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:0c979ebdf4267ee16aaaf093fcdfa712bb198b6395fb74c7753d62bcd2a27760",
      "text": "大家，不可以吵架哦！\n连もふもふえん都说了大家要好好相处呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:69ead8ef39bbf5acb39d7256757650efa9a4ffe7bf431b9c972d8e34701dc19b",
      "text": "……“大家，一起来唱歌吧！\n一起来跳舞吧♪”",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:224d16dd30c55b522e353bf897c1d26327a9048bffedc8885861f3dd6b8c679b",
      "text": "啊，是《快乐闪耀》！",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8709adf40996c01c1984ba81164bf666129b1d3ecd808c22d598f0a7466fe23c",
      "text": "“快乐如此闪耀！\n属于我们的主题乐园！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:afe55556191ffc80c59301b1b40c3084844b48b70d32c597dd53cfbbdd031d72",
      "text": "……园长老师。果然，要是能把315 Production的\nもふもふえん请来结业典礼就好了呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:e83f299a346c5411ced88133c04fadd2868af03a8aec43845b34034a1890d311",
      "text": "是啊……如果他们能来的话，\n孩子们一定会很高兴的吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_10006_01:1_3_10006_01_a:cmd-000049:dialogue:000": {
      "source_hash": "sha256:1c1d39d385b0610ead2e59b0d1b5e6500cd08f6a5a5f93610f2f4955fb02db14",
      "text": "嗯，一定很高兴的。……我抱着试一试的心态，\n给315 Production发一封委托邮件看看吧！",
      "status": "draft"
    }
  }
}
