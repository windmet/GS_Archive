  "scenario_id": "1_5_005kao_1_5_005_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000010:title:001": {
      "source_hash": "sha256:94444c56327ff6250188b8c45ebccae6b2e0952fb5375a4c1bd518051f33f65f",
      "text": "音乐剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000018:dialogue:000": {
      "source_hash": "sha256:2561f58562702ec8ee0267237f26adb32eb9102d9a2d3ec8234fda7affb5c25d",
      "text": "辛苦了，薰先生。\n差不多到练习结束的时间了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:7761aec9b66733bde95403dd159087a52a57e3a606c6a310c18985dd5ae21533",
      "text": "啊，已经这个时间了吗。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:caad5e00078890ae3de0f45f74a791c7d773c5bbf97785e72dce55cade23e610",
      "text": "指导老师夸奖您，说歌唱和演技\n都已经很有成效了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:665e8e10db6ac6d7d16b191a350c3894b21b3bcb8d4edce7cea47328a22d22d0",
      "text": "共演者里有很多演过音乐剧的人。\n我可不能拖后腿。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:4499a961fbb758da0b015491cf68fe38e86be728fcc57906ab110c22f798e2fc",
      "text": "●●●●プロデューサー，我还想再练习一下，\n排练室还空着吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:17aebdc57739c4f4a567f2ec8ee87c8035288d845e37c5aa1be863458993d007",
      "text": "嗯。这里空着，\n您可以直接使用，没关系的。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:77d1bb8cd69f7e36327e9d8666642a5eb2f3a4e9c34ead6174872abd2ef9dc20",
      "text": "这样吗。歌唱和演技先不谈，剧中的\n交谊舞部分我还有些不放心。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000043:dialogue:000": {
      "source_hash": "sha256:945c74df7e546121e75dfbc98d9425f65023ed31a653c1dcdaf9267751ea2efb",
      "text": "在舞台上还要与其他演员共舞。绝不能出现\n撞到别人的情况。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:ff9edc59309065f5c3dc2ce5f476a4c39da1633374f4f5e6eaac031e5376e3ae",
      "text": "我想在下次排练前，\n把它练到完美的程度。",
      "status": "draft"
    },
    "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000049:dialogue:000": {
      "source_hash": "sha256:497bddfb563f808a52656738b500a86c3327cc41d547d5f83391a5ed6fae1875",
      "text": "明白了！请加油，薰先生！",
      "status": "draft"
    }
  }
}
