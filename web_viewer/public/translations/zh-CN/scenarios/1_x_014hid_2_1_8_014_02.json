{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_014hid_2_1_8_014_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_014hid_2_1_8_014_02:1_8_014_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:6bb2943af763ad5f87b4ce151a308cc39da391fb7f7a835a13c409519d94e006",
      "text": "喂喂，●●●●プロデューサー？已经在事务所\n了吗？辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_2_1_8_014_02:1_8_014_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:50eafaa836f5cff4d77a72c5b3b4d56b46a37b27a082b679f07e27385abfa414",
      "text": "今天是你的生日吧。\n生日快乐！一起度过美好的一天吧！",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_2_1_8_014_02:1_8_014_02:cmd-000014:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_2_1_8_014_02:1_8_014_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:6373f0306ad2c62b21a6cf1cac1e7b3307912c7224811b54e7ce7a6e2490f14b",
      "text": "你今天上午都在事务所对吧。\n待会儿我带点慰劳品过去。",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_2_1_8_014_02:1_8_014_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:a2cfbab46d3b26a38bd9cc9b9ab84fdc74f9105ec092957e1cb4f83055607144",
      "text": "我会准备最适合庆生的好东西，\n好好期待着吧！",
      "status": "draft"
    }
  }
}
