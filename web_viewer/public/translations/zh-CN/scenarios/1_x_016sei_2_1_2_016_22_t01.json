{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_016sei_2_1_2_016_22_t01",
  "source_raw_hash": "sha256:8da757c2f9f935e59fbf6f640fd035823c40b6e28acacc9a19ea849400b3f4af",
  "entries": {
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000007:phone_message:000": {
      "source_hash": "sha256:ecf35e95ac0b1ddc893df9bc4876062abc427e71bb56534b6750f68b2f8df45e",
      "text": "喂，制作人。\n现在方便说话吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000009:choice_short:000": {
      "source_hash": "sha256:2e4511c79dd301bd751212ca916d4ecb6803d0f2fe2fe7f710a166e18d934922",
      "text": "方便的",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:f98fbdf1cd6b65f910bab90ba532271075c6d847121b789878d772dcbd476a2c",
      "text": "那就好。我想再次向你道谢，\n谢谢你来参加我的生日会。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:7f779e86d8f0eb43af90e43d5168c161e09fa015576d58787cd201e3c1397a4a",
      "text": "天音玩得很高兴，\n我自己能得到大家的祝福也非常开心。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:4233d838fce6a6929ade20a8af6a601c95e2f1ebb95345d10987e1ea8946d110",
      "text": "现场的布置也让我大吃一惊。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:b581879e78322f6e553893e0ac34065d5a1338a6f83d176d9b28f2ec5872c3d2",
      "text": "大家百忙之中一起做的准备吧。\n过程是不是挺不容易的？",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:6bd5ff22ba7256b45f572645dfbe41a39cc1db6bbe3345fa64c26d5ba533d26b",
      "text": "是为了庆祝嘛！\n没什么大不了的",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000021:choice_short:000": {
      "source_hash": "sha256:5cfe876da43f7f7ae6313095aac2c439eddcd8f3e77a7a4dcaa226cecf2cfe8b",
      "text": "毕竟是\n诚司先生的生日嘛",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000025:phone_message:000": {
      "source_hash": "sha256:ad8d81e736b99125b9c3633b162504aeece7691a74b4582854789b708934542a",
      "text": "谢谢你，我很感激。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000027:phone_message:000": {
      "source_hash": "sha256:84a3e6d4b7e765965dfd38cb89b84ef254c9e57c679f99fcb181d3f143b8a6fd",
      "text": "多亏了制作人你们，\n今年我也迎来了一个很棒的生日。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_2_016_22_t01:1_2_016_22_t01:cmd-000029:phone_message:000": {
      "source_hash": "sha256:1cd63b5d83ac28ca0e17c0de6b20380292ff5f6e3a2a2a7872d28c2a804c9bd1",
      "text": "再次感谢你来参加生日会。\n接下来的一年也请多关照了。",
      "status": "draft"
    }
  }
}
