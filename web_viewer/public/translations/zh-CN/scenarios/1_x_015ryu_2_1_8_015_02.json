{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_015ryu_2_1_8_015_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_015ryu_2_1_8_015_02:1_8_015_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:390e6ffad0632198fd59d1e9d98726dc93a6ea4ff5dce23959291a839c2e12a9",
      "text": "啊，●●●●プロデューサー？\n今天是你生日吧，祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_2_1_8_015_02:1_8_015_02:cmd-000012:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_2_1_8_015_02:1_8_015_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:36aaeae2f640f9c5a986666a55fde052e060950d497e86f8d9b0e09455737851",
      "text": "太好了，好好传达给你了……！难道说\n今天其实是个挺走运的日子……哇啊！？",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_2_1_8_015_02:1_8_015_02:cmd-000021:phone_message:000": {
      "source_hash": "sha256:a688059c81c03e919b4502a04ee468e87e9ab7350bb02842f20a416180412731",
      "text": "知、知道了知道了！这就去！\n……抱、抱歉啊制作人！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_2_1_8_015_02:1_8_015_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:9e5dc2d320664f2fdcd4b5c149d81ea2ea4ac6cab92794ab34bfa3103b31f129",
      "text": "约翰非吵着要去散步不可……我先挂了。\n等当面碰头的时候，我再好好给你庆祝！",
      "status": "draft"
    }
  }
}
