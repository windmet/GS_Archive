{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_046_23",
  "source_raw_hash": "sha256:ec7d1aa4d645368561a1393eb93268f35c15b50ba98a9a4841a9e605953b295e",
  "entries": {
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:3f36d64d0280bcb33dc0d95e71de3e6219756e9cceee1dc3db5af6ca5b6d562f",
      "text": "●●●●プロデューサー，\n前几天的巧克力非常感谢你！",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:77a545388259691aaea9b9a9af0bc631a410cbda2a49925c5e8095d1c7c7b083",
      "text": "非常美味。\n制作人真的很清楚我的喜好呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:a9900c728ea4967db49d3d076ef141d1ec0422f2bf8150f5a44480a808d3097c",
      "text": "能合您的胃口真是太好了！",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:a6068c784f9221e1f14ff56519d5735adc8b430321271e1a9f823fe1efc1769f",
      "text": "这家店的鱼料理也是极品。\n只要和你在一起，总能邂逅到许许多多美好的事物呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:07d672d51d74c18992cd552750be6f774507a6af970bf6d18adcb13d537ac13a",
      "text": "到了白色情人节，我也想回赠能让制作人\n感受到美好之物作为谢礼。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:ead03dba01e4fa49b2b453014df43387022ec140e85aa0ddb696d10d1ae23d22",
      "text": "送什么好呢，我会好好深思熟虑一番的。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:300f859371a8926b774966cdc2f83bb2e6ef63842718bc49476a53a492ed257b",
      "text": "非常感谢。\n有您这份心意我就很高兴了哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:b1bbbd117953bf17cfa52eb60fd483fb7f7df324fbaca397dcb35e1a64f62fb5",
      "text": "既然收到了如此充满魅力的馈赠，\n我也想以同样的方式传达我的感谢之情。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000039:dialogue:000": {
      "source_hash": "sha256:0ab062f8886042165567c361bfd336c7cafaabaaec9352ce4ebc075083a3bca3",
      "text": "为此，我打算从现在起就开始做准备了。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_23:5_01_046_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:667889ea8d3a8c002002c83538d93c5c5fe11c882c5c02855fddb94ee4b718d1",
      "text": "白色情人节，\n就请怀着期待好好等着吧。",
      "status": "draft"
    }
  }
}
