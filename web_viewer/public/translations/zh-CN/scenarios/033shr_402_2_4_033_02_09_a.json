{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "033shr_402_2_4_033_02_09_a",
  "source_raw_hash": "sha256:485c86c6a962ae99125bd6f4ae88df4bb183083c9db6845cc772dfb169d16158",
  "entries": {
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:7a032484cfcfacb0aa59050e9aab1d1aef8084ec14674c2010270404f9252361",
      "text": "●●●●プロデューサー！\n辛苦啦——！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:03bff6896efda07404fdf2ca13710d87e53c968d818767c9d5a836bb9e1410fe",
      "text": "今天我把冰淇淋带回家当特产，\n老妈高兴得不得了！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c06ad30c27ae2d5b67fa7b9e07c4e57a784067ac1479083d28afd113577b8a50",
      "text": "总觉得有冰淇淋在就会让人兴奋起来呢。\n就像过特别的纪念日一样！",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:37e5da8102b4d5aa1194866589d430ecfda9948a23b1b60964991548ee359ec6",
      "text": "冰淇淋的魅力确实很大呢",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:d0952aabff250de63d775ce0dc0a00033fda805f71c506eddfe32bc25694aa24",
      "text": "能让所有人都绽放笑容呢",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:ccc5a3427290dbd219e9582df2a7e8e13b71985a07898b2641e13d881b80eb94",
      "text": "对！就是这样！\n在今天的拍摄里我也把那份魅力传达出去了吧？",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:fb9debc97845b75459c3f2ab072bab8f736466986c14493f8fc8bd404640b74a",
      "text": "非常完美",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:4d3c7b273c055b79f26515a1d6d8cc6157bc8e846c72fd39de0aadf6fa20e600",
      "text": "嘿嘿，既然制作人都这么说了，\n那就肯定没错了。",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:4b3b7301cfd3246646f30b6be8bd96263173b0fe4739800e869b6f85b5e825ea",
      "text": "啊，老妈在叫我了。\n接下来我要和老哥老妈一起吃啦。",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:88e1ca7743a0c7fe42367cf97495e3b261b30c88c321a3a8dc7aa7c750141191",
      "text": "糟了，冰淇淋要化了。",
      "status": "draft"
    },
    "story-text:v1:033shr_402_2_4_033_02_09_a:2_4_033_02_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:85df74447b763828b0e89d64792207267c4cc7e415d7fe2a555053ea9234aa81",
      "text": "总之，我的工作大获成功是理所当然的！\n回见啦，制作人！",
      "status": "draft"
    }
  }
}
