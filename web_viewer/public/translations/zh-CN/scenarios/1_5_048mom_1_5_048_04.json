  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000010:title:001": {
      "source_hash": "sha256:365dcee0c38af98fe80a24fdbd2bf8c7c798c1986512ba23c28f4eb37972406b",
      "text": "帮忙处理案头工作的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:2078d86dea0b0b609316c7eab6d7d28c22c2a58a9f5bed5919e04618403c2a75",
      "text": "●●●●●●●●●●P酱。\n文件，我都整理好咯。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:7b216b8d23fc5c5d9a592ac1f70e272a7bf0c9131adf6d437694d3d600a302a2",
      "text": "非常感谢！不好意思，明明是休息日，\n还让你来帮忙处理案头工作。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:09dc23103e550329fccd0e63e55c844b0c893dde16d5965242f4e000f9696d0c",
      "text": "没关系啦，只是我自己想做而已。\n要是还有其他我能帮上忙的，尽管跟我说哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000032:dialogue:000": {
      "source_hash": "sha256:852cd749c12274016c9b9fc98b56eb437597f94217dc9957afe1705915ee66db",
      "text": "只要是为了●●●●●●●●●●P酱，\n我什么都愿意做。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:84f085619d1b0621a5b50ab90f6d5c18583ed8503cc2df07f44664630292c4da",
      "text": "那么，我就不客气地拜托你了。\n接下来的工作是……",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000038:dialogue:000": {
      "source_hash": "sha256:a2c3e2da18a04dc5dc01daf4e4cdc2d65b5202823303ead2b0fdbd839c6b85a1",
      "text": "喝点喜欢的东西，好好放松休息一下。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:997b27a9951dac990c2f40d187ee12b8037306119dcea4ef0aecd378aec483a4",
      "text": "哎……休息？",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:1296d290dbac68b30268eb885196c033cce99510eff65464ef69723987deea18",
      "text": "是的！\n休息日的工作，就是好好休息。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:127431b21d9133ab2bddf3a3d6d382256f4fee2032cf1a51fb7e5901078cdde3",
      "text": "既然这样，●●●●●●●●●●P酱也\n一起休息吧？好好休息也是工作的一部分嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_04:1_5_048_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:fc0c4677c23e998c47817d1f09c8ec90d45be57b5403c4f8c847fa083ed33f9f",
      "text": "我去拿喝的过来，\n你坐在沙发上等我哦。",
      "status": "draft"
    }
  }
}
