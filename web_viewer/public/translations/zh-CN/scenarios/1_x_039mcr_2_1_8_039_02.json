{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_039mcr_2_1_8_039_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_039mcr_2_1_8_039_02:1_8_039_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:932390453679e1b90d89156d2a14e55f141c0540e33dffd32914b00ade332f01",
      "text": "●●●●●●●●●●师父，早上好！\n今天也请多关照了。",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_2_1_8_039_02:1_8_039_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:696580b80a7a0c0064d9c65768cb9955b64f42c45f037b28432148776c957493",
      "text": "今天是您的生日吧！\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_2_1_8_039_02:1_8_039_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:db4cc1e52f0ef6fcca4bd89a6756860bf1d79ae45c0c2e48be491f9240b2a708",
      "text": "非常感谢！能被您记在心上，\n我很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_2_1_8_039_02:1_8_039_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:ae2cc6e2769f99987dfc580bfb88148c0ede8132079477592d755ac489508577",
      "text": "今天刚好有录制真是太走运了。\n毕竟难得的日子，我们想当面送上祝福！",
      "status": "draft"
    },
    "story-text:v1:1_x_039mcr_2_1_8_039_02:1_8_039_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:848fdb1b009f4173f344d3a742cc3e26e4c578e7a4d120670584388b35f412bb",
      "text": "虽然我知道您会很忙，但要是能度过一个开心的生日\n就太好了！",
      "status": "draft"
    }
  }
}
