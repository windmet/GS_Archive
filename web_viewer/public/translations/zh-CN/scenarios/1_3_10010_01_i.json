{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10010_01_i",
  "source_raw_hash": "sha256:89d1924816bb84e9e4ae224d590fd9d018b828e7dfc09bf90692e92fc91e983c",
  "entries": {
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000018:time_caption:000": {
      "source_hash": "sha256:d7925c854232949411555f5be27fa7bfb8331273bef02a50185277ac865ae80d",
      "text": "比赛后……",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000030:dialogue:000": {
      "source_hash": "sha256:5cf505d60f066a8d544ca9e771fbe2df63af2e0ce5e6de09ad1ee3f3cecff9c0",
      "text": "“你小子，\n那是哪门子乱来的过弯切入法啊……”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000039:dialogue:000": {
      "source_hash": "sha256:eb9ec60600f518b3c01ded0a1b6d60e8706cf5bdbfdf0a112c9bb88d676ee477",
      "text": "“开出那种速度根本追不上啊。\n我们完败啦！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000045:dialogue:000": {
      "source_hash": "sha256:b972a87bdf2135a665b1e4cc39f7e4ddb501799382958247f36d4125de522bbf",
      "text": "“你们俩跑得也挺漂亮的嘛！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000052:dialogue:000": {
      "source_hash": "sha256:7168cd0485ca4b786a8aa30fdd763a838a7b2138abb15c4f85cab416eec5f771",
      "text": "“谢了。不过，仅仅赢了我们\n最好还是别太满足”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000057:dialogue:000": {
      "source_hash": "sha256:a1d55b0617757cda261584471109c51b256659e359d94375d3a5d9394c2a68b9",
      "text": "“在这座街上，跟我们一样……不，\n比我们更强的豪杰可到处都是啊”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000062:dialogue:000": {
      "source_hash": "sha256:d830826d0eb7d24e91759fd11864375e5d1c6ca4a5b302429cfc768fe8384224",
      "text": "“嘿，那可非得全去打趴下不可了”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000068:dialogue:000": {
      "source_hash": "sha256:cc84b66d15d96243f9e51b37cc24a98b8e1b206ad182d70959ca38d25871aa98",
      "text": "“哈哈，不愧是打倒了我们兄弟的男人！\n干劲果然不一样啊”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000073:dialogue:000": {
      "source_hash": "sha256:1b58783f7136ed77270372479a4a4ee6b6a1c2a2c521c726cee38aa560c2e8ca",
      "text": "“你能否站上这街头的顶点，\n我很期待”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000077:dialogue:000": {
      "source_hash": "sha256:160a9d8d85effbfdb3c46782735dc3a8cafaddbcabfb831cad943f928a247132",
      "text": "“噢，包在我身上！”",
      "status": "draft"
    },
    "story-text:v1:1_3_10010_01:1_3_10010_01_i:cmd-000084:dialogue:000": {
      "source_hash": "sha256:392d668732b7fe89d6993f8461cad37de017d6b1a78ae3eb8ded5142ecc27002",
      "text": "“听好了，绝对不准输啊！”",
      "status": "draft"
    }
  }
}
