{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_032_02_d",
  "source_raw_hash": "sha256:07ccd2db488e954cf9c8b18d5da9a00c751dcefbd673381811a53683167bf148",
  "entries": {
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000023:dialogue:000": {
      "source_hash": "sha256:dac232795985b46208d0b282fe7d7833a858d4f51b34af33cf127ad00888a4b6",
      "text": "花音君、志狼君，你们在这里吗……？",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000043:dialogue:000": {
      "source_hash": "sha256:8b9f4078b3886020df2f0a146ea51a4a12fec2453995ff3402455ef5c6d06b6a",
      "text": "直央，生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000045:dialogue:000": {
      "source_hash": "sha256:fc2622216a0092b6bbe424cffa95eaa93469f2af7c4fc0fd30fc70ae943e4501",
      "text": "哇啊！？",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000059:dialogue:000": {
      "source_hash": "sha256:c4d30ee121f228a3ccfe57eae9e37f920ec49e2c7b946a12b9ff772beb8b3620",
      "text": "吓、吓了一跳。花音君、志狼君，\n连制作人也在……！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000064:dialogue:000": {
      "source_hash": "sha256:fb19bee7a84f3b3e21128bd04509dc27225135e496d65e55a376a16115cb73d4",
      "text": "啊哈哈，太棒啦。作战大成功！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000075:dialogue:000": {
      "source_hash": "sha256:14b7de2bf2bd8e74015329c9369714810caef9229fe0cb659721c6437a28a716",
      "text": "作战其一，“不被直央君发现偷偷办生日会”\n首先成功了太好啦～。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000080:dialogue:000": {
      "source_hash": "sha256:355dc1a828c182bb9b4413a839198cc3136e4a195fce6021551d41d2f9fe46b7",
      "text": "这算是“其一”的话，\n难道还有其他的吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000090:dialogue:000": {
      "source_hash": "sha256:a9b72cb2104444e6a1ee251bf3caa9b40a839a839b7d6565edad2533b45dc4ad",
      "text": "作战其二就是这个！直央肯定会喜欢的东西。\n大家一起挑选的礼物哦！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000094:dialogue:000": {
      "source_hash": "sha256:76d51d36229192e8b63d5ab16bde3fe341c7db30bd01c26b2ed1ef675c8f3b1f",
      "text": "哇，好开心啊。谢谢你们！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000102:dialogue:000": {
      "source_hash": "sha256:3538a88fbf546c1d403fec1dd375255e90508a4625236a9ded6dca8a709c2778",
      "text": "作战其二也是大成功呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000110:dialogue:000": {
      "source_hash": "sha256:195869db56203dc200451bc98956a1010e50856b1695d38f747359e3f7367fb5",
      "text": "太好啦，志狼君♪\n制作人，那个也拜托了。",
      "status": "draft"
    },
    "story-text:v1:1_2_032nao_02_1_2_032_02:1_2_032_02_d:cmd-000119:dialogue:000": {
      "source_hash": "sha256:1b668bcf1c303d89370327fafe03da0abb16fed67c2ba7a623b6c8e3c9a22f5e",
      "text": "好，这里还有蛋糕哦。\n大家一起吃吧。",
      "status": "draft"
    }
  }
}
