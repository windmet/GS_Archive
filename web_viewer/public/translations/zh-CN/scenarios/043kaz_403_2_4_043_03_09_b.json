{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_403_2_4_043_03_09_b",
  "source_raw_hash": "sha256:9a57cb018853a5f49306695d75b338cb4d0c992420db89ebefaecb088588a4c2",
  "entries": {
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:36efffa8f71832d07852f25305c61e8748c5da94d1fc78314f2d314ffe110bac",
      "text": "……今天辛苦了。才刚分开就联络你，真不好意思。\n我突然有点事想请教你，方便吗？",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:f68795b2191c0093fec6c932048e3fcdaaac114a737c5354cd40f339e977c742",
      "text": "……今天的酪农体验，拿到了一盒马苏里拉\n奶酪当伴手礼，制作人的话会怎么吃？",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:74108f1d6033c3cf90d20b3b9034bb308e33e4f813468c64b3c3bedf6e00b328",
      "text": "……我想了各种吃法，想听听制作人的\n推荐。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:426a59f840a5d7c73031bcad9f5f3a56212a6bac86233a811102192197572f6c",
      "text": "和番茄一起做成沙拉怎么样",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000015:choice_short:000": {
      "source_hash": "sha256:981aa903423c5369d790f9bad0c0bcb47e9ff263aa65e9c947129041eec7e27f",
      "text": "简单地做成披萨怎么样",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:b590d8ca137cb16c07ab6efcd9d6db15d12f50f94cf7e6a596b582f729e0aaa0",
      "text": "……原来如此，用新鲜的奶酪做沙拉，\n真是非常奢侈的吃法呢。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:8e7ff031817c242a208a09e1347b85284d0094cca58691820cf1e0617c6c9e5f",
      "text": "……果然披萨很让人有食欲啊。\n就选这个吧。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:db7c891a5c15d19a247e61b3583ea3d4df91f7964061a572751991158289d2f5",
      "text": "……我打算回去路上把材料买好。\n谢谢你，非常有参考价值。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_b:2_4_043_03_09_b:cmd-000029:phone_message:000": {
      "source_hash": "sha256:e11c37250b23f05dda4f6efbff5bac15800bcf06b108306dc230796cec3969c0",
      "text": "……制作人回家路上也要小心。\n那就先这样。",
      "status": "draft"
    }
  }
}
