  "entries": {
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000010:title:001": {
      "source_hash": "sha256:32b06cb112adeaf50f9d28fd41a983c58fbe792fdcb265a9c553f5363cfed875",
      "text": "无线耳机广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:1c7c68be5cba27cea1f3d8fa98ddd91d7631be8912f6f4f1f8581b2984f2ce89",
      "text": "享介先生，这是下一期广告要宣传的\n无线耳机。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:7d304db1dc6c2f5e76384b15ea068ebc7d88a3e3838c91d826bdf933a84d0ef0",
      "text": "对方表示广告里会为享介先生准备专属的个人配色，\n这边是色板样本。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:16ad3730d36035858ab4f463e9b2273fdbe9facae85956f21fc524897d2a65f7",
      "text": "我的专属配色！？\n哇啊……种类好多啊。唔——……",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:e398bb174e0d854345568cb3557e1d990aff05841f578ef8436aaeecc2ebddda",
      "text": "果然还是选这个吧！\n毕竟是W的代表色，感觉最合适了。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:ffc9d6d182086144fc49a6a3acb63afe7df35888152b4de044b25716b7e3d95e",
      "text": "●●●●●●●●●●监督，怎么样？\n合适吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:f1a80cd433e7d588086aff639c52f28e63685a872c7463918e9c0700f29d7ceb",
      "text": "是的，非常合适！\n那我这就把选好的颜色转达给对方。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:0c450627aad7d153e532be20a684c57cdc981402bfc0fdd03f586eac8457fec3",
      "text": "另外，对方也希望能听听您实际使用过后的感想。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:b94766ace571f9ca6f93d5bdbecc6bc72b142f1e875ed00f431c1c043a102a53",
      "text": "包在我身上！今天的练习我马上就戴上试试。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000057:dialogue:000": {
      "source_hash": "sha256:7d8f973f3b35e3a24dfb3305c74711e655b5302cf8463f633c3747d2ba6db907",
      "text": "因为有耳挂，\n动作幅度再大也不用担心会掉下来。",
      "status": "draft"
    },
    "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000063:dialogue:000": {
      "source_hash": "sha256:37b17b06eb8dacc2d7fa7f0fedfeaf6510336143fff23081a1b49c372c8268a1",
      "text": "而且造型简约又帅气！\n嘿嘿，我已经迫不及待想等到练习开始了。",
      "status": "draft"
    }
  }
}
