{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_038tak_1_7_038_01",
  "source_raw_hash": "sha256:c5403977976666466fffe994ae1e3786216917b15b5fb7eeaf4a1254fd32e270",
  "entries": {
    "story-text:v1:1_x_038tak_1_7_038_01:1_7_038_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:c05a2fc18dffb1672de1d9bf00e22107e3f69913a889f4c15671edf1f80505fc",
      "text": "武先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_7_038_01:1_7_038_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:7c7f8d68817e6361a5a99ddf2c9484094e44a87d2921de2b8d77b9e7d50d9f77",
      "text": "哎？生日……\n啊，谢谢你，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_7_038_01:1_7_038_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:fef0b8e6a93f6551ee0761430bb1ce642b0ef8cfd96f13be7e30fe6d7d43af85",
      "text": "不，我倒不是忘了，\n只是很久没像这样被人庆祝过了。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_7_038_01:1_7_038_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:c4eb7f8abfa217179ba9f4cb762109e1639365c05e49e31385b40533c8aff5c8",
      "text": "太吃惊了，一下子没能反应过来。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_1_7_038_01:1_7_038_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:79bbe34ca48c8fc83e357a3436627c9ee068a33f384199942bbf747c0211d043",
      "text": "谢谢。\n……感觉挺好的呢，这种气氛。",
      "status": "draft"
    }
  }
}
