{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_016_03_b",
  "source_raw_hash": "sha256:45e1695765d3f05eb4bc8d5c282918f8670c96907c811ced6d1685d4a4d239f2",
  "entries": {
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000011:dialogue:000": {
      "source_hash": "sha256:6121ae63987d4b2f87ef68a1aa889186722140c4576d265750d15f25e26a55e3",
      "text": "那么，我先告辞了。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:998ae0176332896f2d591e274fd4002d4a01756c60644184f87208d9779af506",
      "text": "……嗯？",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000035:dialogue:000": {
      "source_hash": "sha256:2fa429138756d0c3115b35f1344cc63bd9bbfae3616b0d398b8a0b36817986e5",
      "text": "眉见那混蛋。\n总是擅自为所欲为……！",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000050:dialogue:000": {
      "source_hash": "sha256:f58d88a79e5ae16490f0cb4c515baa8552fec8b66d5564e70781861b386b718a",
      "text": "（……啊啊。是那时候在一起的家伙吗）",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:8fb608cd1968abac3ea6e9c884610a033e294a2e5fa6473ec65efbef3874567c",
      "text": "（难得给过你机会，\n你却好像根本没有反省啊）",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000070:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000072:dialogue:000": {
      "source_hash": "sha256:8d5d9db1beeb0d4162521478d8484f40492692cc4f44b624633c3e2c06a25c23",
      "text": "唔……可恶……",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000080:dialogue:000": {
      "source_hash": "sha256:aee951012cf49d2d528bf75452d99bc40267ed92ec71e44be4cda17a5a7a8382",
      "text": "……逃跑，是因为\n心里有愧吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000093:dialogue:000": {
      "source_hash": "sha256:4ad61b907b5917bb154dbe56b5eb05cf11841204247d8f506a6e6a072a6b23f5",
      "text": "（既然明白自己的错误，为什么不纠正？\n就是因为这样，才会一直愚蠢下去）",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000103:dialogue:000": {
      "source_hash": "sha256:9b211ef3f7018fad188d79a0c79bc182e64a2ec15f81832b37a6348c52d61413",
      "text": "……算了，无所谓。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_b:cmd-000107:dialogue:000": {
      "source_hash": "sha256:09eb3428159efc027388e9ac2e76d56c12d89ebd23be0fd830bae1eaea020a45",
      "text": "要是再有什么事，由我去教导他便是。",
      "status": "draft"
    }
  }
}
