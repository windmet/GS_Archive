{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_016_02_a",
  "source_raw_hash": "sha256:de35133b50209a66dc6035784ad18121b4d70e120ebc21881c2849e4e1cf958b",
  "entries": {
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:83390e59a842e3fcc2b2d1803d1c877890c58c84b89f6b5526d152746e057450",
      "text": "活下去的资格",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:75421a0e2325b16a3d20e943213ff4dfd824eda39dabdfd5817accab573ab2d1",
      "text": "百百人为了迎战全一模考而努力用功。\n房间里虽然摆满了各式各样的奖状与奖杯，\n却没有父母所期待的“第1名”，让他把自己逼入了绝境。\n不久后，模考的成绩出来了……",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000010:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000010:title:001": {
      "source_hash": "sha256:83390e59a842e3fcc2b2d1803d1c877890c58c84b89f6b5526d152746e057450",
      "text": "活下去的资格",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000012:time_caption:000": {
      "source_hash": "sha256:da7ea783b4786b1f89d5de9d40ba80cd399bfc740d1d66622ad26929b4f48d19",
      "text": "百百人的房间",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:df4fd807a200438531b835eff12eec0888a18dc494a1340a64692f160cfa4e63",
      "text": "嗯，复习到这里，期中考应该没问题了吧。\n接下来是全一模考的范围……",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:a848491496effd0545758b079d8fd25a72bdc7fd2dbff9673b3f2dcfdb8ef8bb",
      "text": "……啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:0d4ef395d7e249cfdd2c68b51ebc8866906512ef52756f1aec6fbd4952ea660f",
      "text": "（刚才，头晕了一下）",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:bc3f87163db457e3f82b1858bba1032d3440244f8b3d043455c144624823803f",
      "text": "也是呢，不知不觉都已经过了零点了。\n这样下去，去学校大概又要迟到了吧～",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:6ebe7e3ca162f0c08a10b831685ff7e3270573dcff3783be8411a6096aa29e2c",
      "text": "（即便如此，还是先把模考的复习做完吧。\n因为，这次一定要赶上才行）",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000070:dialogue:000": {
      "source_hash": "sha256:e19442183370fcd44d679ef68e85627dfd3cc55605765d691e863c8d892c5922",
      "text": "（必须赶上……\n爸爸和妈妈期望的模样才行……）",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000080:dialogue:000": {
      "source_hash": "sha256:f4a4a7d10733ad542628fb72d44c33bbdda35ccde9ac6a3e594795c43baaa634",
      "text": "……我必须拿到第一名才行。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_02_1_1_016_02:1_1_016_02_a:cmd-000094:dialogue:000": {
      "source_hash": "sha256:cf7859283c68795596e202221797744bca025488fec185d54d577de823a9018c",
      "text": "不是这种半吊子的奖项，\n或是奖杯……",
      "status": "draft"
    }
  }
}
