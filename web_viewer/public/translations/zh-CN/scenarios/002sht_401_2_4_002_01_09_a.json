{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "002sht_401_2_4_002_01_09_a",
  "source_raw_hash": "sha256:7d468bcf23d93fcfac880a5deab7eeabc06f479ec9da7f4c0e0036e2902cf6db",
  "entries": {
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:2cad0cab831cf6c8d1eb0be2de79f7d6b931b69409c287a863f20f12d1a821e7",
      "text": "喂喂，●●●●プロデューサー？\n还在工作吗？",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c013d16859a282645717e74cf0018b6258e0c1547e4d5f603a3d869971efaa6a",
      "text": "这样啊，没事就好。\n我刚才在读粉丝信呢。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:53051dd3cc0beadd9b1820c8ee2559ca304ac8548da33187e851a9624a67ad34",
      "text": "对对，就是在见面派送会的时候收到的\n粉丝信哦。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:441b58c8cf6f1b8e650b59e8e570e4fe4e4daf598b44058e3a4d0a554f2e26b4",
      "text": "大家都说，超级期待\n我们的见面派送会呢。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:6ec78192b37d88d6acfd79f81c1f7cce5f664d6e60e2a46f01c53f9a25eee44e",
      "text": "啊，见面派送会之后寄来的粉丝信我也读了哦。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:ef1bf83448fefecc722d7e7c609d196137227806eb79bb7a11f15bbedfd76d78",
      "text": "说是收到我们的留言卡片超开心！\n大家能高兴真是太好啦♪",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000018:choice_short:000": {
      "source_hash": "sha256:a3e158434cc768b750323a6cd49e611e50e00ea8ff0a6b3cb70fd6d4ca177026",
      "text": "真的\n辛苦您了！",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:c247d1a5e6bb8d04075bc2965971e39e5f00c5f85fe767f008b071ef001a6c9c",
      "text": "●●●●プロデューサー也辛苦啦！\n……哈啊～不知不觉有点困了呢。",
      "status": "draft"
    },
    "story-text:v1:002sht_401_2_4_002_01_09_a:2_4_002_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:b5a37895720b5d87a4e09fc97d4cd93b9bd25acfd654593f7b95f2a738ffe02d",
      "text": "啊～，已经这个时间了吗。\n差不多该睡了。那就晚安啦。",
      "status": "draft"
    }
  }
}
