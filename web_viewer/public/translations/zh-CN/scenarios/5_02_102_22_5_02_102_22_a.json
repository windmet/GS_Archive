{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_102_22_5_02_102_22_a",
  "source_raw_hash": "sha256:9145b434f842e46df75461dcc6062b4a318f54711ef04decd035804934bad550",
  "entries": {
    "story-text:v1:5_02_102_22_5_02_102_22_a:5_02_102_22_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:0d13a8f3dd8ecd28913f9e07f0ac73279b9badf67dc3e5420fcd70283c051b9b",
      "text": "哦哦！制作人君！",
      "status": "draft"
    },
    "story-text:v1:5_02_102_22_5_02_102_22_a:5_02_102_22_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:d9113fd2d6a552ece3e622ff2f1115c024aef35794532e8c090e3893888d3b38",
      "text": "前几天从你那里收到了巧克力，\n我是来给你送回礼的！",
      "status": "draft"
    },
    "story-text:v1:5_02_102_22_5_02_102_22_a:5_02_102_22_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:e4667fd6f5a7e147c51946646846c4fac26cbdc93edbfc74756333cba6aba661",
      "text": "里面可是毫不吝啬地塞满了我澎湃的Passion！",
      "status": "draft"
    },
    "story-text:v1:5_02_102_22_5_02_102_22_a:5_02_102_22_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:07e61882d68302c3bd80f3b1b7675abdf98caf6331be6bdfb4bd86417abae4a9",
      "text": "别客气，尽管收下吧。\n哈哈哈哈！",
      "status": "draft"
    },
    "story-text:v1:5_02_102_22_5_02_102_22_a:5_02_102_22_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:69ab7268a6187bc7b058e0400231bdc5f543ad739a8f6398e1539f8833b7fd93",
      "text": "那么，今天的业务也请奋发图强吧！",
      "status": "draft"
    }
  }
}
