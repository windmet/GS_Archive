{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_048mom_2_1_8_048_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_048mom_2_1_8_048_02:1_8_048_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:a45d1f752715dd8d502fa8dabe4018500b3a8447f4d2e80963230ccc2191c64c",
      "text": "嗯嗯……啊，通了。太好了。\nP酱，差不多到了你起床的时间了吧……？",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_2_1_8_048_02:1_8_048_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:75f0a7179c86219711d91ceb6abf625e8662845b38dc92f2c3c71b9ef4039c60",
      "text": "早上好。还有，祝你生日快乐。\n祝你度过美好的一天哦。",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_2_1_8_048_02:1_8_048_02:cmd-000014:choice_short:000": {
      "source_hash": "sha256:329ea257821d3b7c54881d32478956976a8f524c2b4bcf91dd9875e9cec582a1",
      "text": "非常感谢\n……您看起来很困？",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_2_1_8_048_02:1_8_048_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:ff0c5d58e27131f7d8e7b0dab2d0fff6515be4a31c5f6ed729dc7ef79cd51b90",
      "text": "啊……被看穿了吗？因为无论如何，\n我都想早点把祝福的心情传达给你……",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_2_1_8_048_02:1_8_048_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:bdb469fc5381f38794ce429cc2b5308ab4d004642df69be8ff9f1bddf0e064a0",
      "text": "待会儿到了事务所，再让我好好为你庆祝吧。\n我很期待能见到你呢。",
      "status": "draft"
    }
  }
}
