{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_041ryo_1_7_041_01",
  "source_raw_hash": "sha256:63e16108085c0a96f650e6b7881d364889f05e228d28aa60ebc3a93808fe3266",
  "entries": {
    "story-text:v1:1_x_041ryo_1_7_041_01:1_7_041_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:1ea37407bc68dcbb3fbf19403dc9e097d0c778c1fee078994221c66ebab12504",
      "text": "凉先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_7_041_01:1_7_041_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:f2262b51a075b94b9731bd8db9d91033ddec3f4c61c5fef9628b02cb1b0d5855",
      "text": "哇！非常感谢，\n●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_7_041_01:1_7_041_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:75d5686acc7a36a1c8ba0f5b312ca51fd1d0f6c9bde14fe3c8d204df4850f835",
      "text": "诶嘿嘿♪\n能被你记着生日，我好高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_7_041_01:1_7_041_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:2748cfd65495a117bf21c18bbd8daf8dcea41ae55e508fb0c7978d86abf21a7b",
      "text": "听到●●●●プロデューサー的\n祝福，我整个人都涌出力气来了！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_7_041_01:1_7_041_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:3f2f02460a411c45e5c3ab6b04e9c14e7af1d649a783eb76d879f7bb34a7bcb6",
      "text": "今后这一年，为了作为男性偶像\n能够取得长足的成长，我会努力的！",
      "status": "draft"
    }
  }
}
