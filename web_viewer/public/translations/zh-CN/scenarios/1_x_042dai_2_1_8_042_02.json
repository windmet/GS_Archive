{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_042dai_2_1_8_042_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_042dai_2_1_8_042_02:1_8_042_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:1fad44b5f2feba68c6660d1a7d27bd0cc4cc81c69641df03916959c635f956bb",
      "text": "●●●●●●●●●●Boss！休息时间打扰你真不好意思啊。\n能稍微聊会儿吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_2_1_8_042_02:1_8_042_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:283438495f73b8e1be67c983f5b690aa9e5022e3e9f8dbcced5aa853b954f596",
      "text": "生日快乐！要是错过这会儿就到晚上\n了，所以俺想趁现在先告诉你。",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_2_1_8_042_02:1_8_042_02:cmd-000018:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_2_1_8_042_02:1_8_042_02:cmd-000021:phone_message:000": {
      "source_hash": "sha256:baf194a38a4c6df53f6d59757b11d8167299b8f69cc0bd546a42439b897cec06",
      "text": "回去的时候俺会顺道去趟事务所，盛大地替你庆祝的！\n好好期待着吧！",
      "status": "draft"
    },
    "story-text:v1:1_x_042dai_2_1_8_042_02:1_8_042_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:9b75d0083e0b46ed5c2cebde39878b259ca8cdd1575a2b4b7272ca06281e4825",
      "text": "那俺去把手头的事办完。\n待会儿见啦！",
      "status": "draft"
    }
  }
}
