{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_002_01_b",
  "source_raw_hash": "sha256:7301b95c7282804360f2eab1e51d3d96d96adf689905edc7ddb2e91babc72c96",
  "entries": {
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000014:time_caption:000": {
      "source_hash": "sha256:275508181548edd14fe0ff29d556b3d8ca2600b9839a18c6653d4d2698068c27",
      "text": "翔太家中·客厅",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000022:dialogue:000": {
      "source_hash": "sha256:19d37282aaab39532f5bf26d6c862860ced13abb8ff4a5943af48315a69c44b6",
      "text": "喂喂，我有点事想问一下……",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000032:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "几分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:a2327730537d4f65f3886b62a71c016f51de6390fd9801c6ec8a93cb8a814a70",
      "text": "……事情就是这样，\n有什么有趣的故事吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:cddf41d74eebd5194bf6da75cc83165f750ec78194a1ecf535a9365b69b4f5fa",
      "text": "原来如此！\n有啊有啊！稍等一下！",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000057:dialogue:000": {
      "source_hash": "sha256:0b0370e8c93b6b40e604f62c568b7e260c9432f17daebc9bbe1c09c50833ec5f",
      "text": "让你久等了！",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000065:dialogue:000": {
      "source_hash": "sha256:45bd54e4142c715b03c4a22eb7a15533fc7b4d73f2c557c85e8de3aa7bd042ee",
      "text": "哇，好惊人的量！\n这些全都是我的！？",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000071:dialogue:000": {
      "source_hash": "sha256:bac0328d6e86a63f3f2a244e62ea080248f528229abce26dc647020f9f5fd056",
      "text": "对呀对呀！这是翔太上幼儿园开学典礼时的照片，\n哭着说不想和妈妈分开……",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000078:dialogue:000": {
      "source_hash": "sha256:06043010416e2eea498385e85ca6c53467f9040260e190b5e196d393efec85c7",
      "text": "这张是运动会赛跑拿了第一名的照片！\n得意地比着V字手势的样子超可爱的！",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000084:dialogue:000": {
      "source_hash": "sha256:54290808a3e3c1b396c2e16f2fb30f6867b432b72e872ca49eb13fcaa3e944b0",
      "text": "我回来啦～。",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000088:dialogue:000": {
      "source_hash": "sha256:64d16c1ed2f8ea2f9763677b8341c747170fa45f1a7908bce95f9a8088cd5ac5",
      "text": "我回来了。\n刚才正好在门口遇到妈妈了。",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000094:dialogue:000": {
      "source_hash": "sha256:0e8599dc79fa43b2c3bdcc80425cb189d9126f8794a8352d736b6e34317baa1a",
      "text": "啊！大姐和妈妈回来了！\n快来听听，翔太他……",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_b:cmd-000106:dialogue:000": {
      "source_hash": "sha256:bfd7bc69c5545564008d27820ce5e7122360c4551c61b3b8f51025ff402c8829",
      "text": "啊，等一下……\n啊哈哈，感觉要变得热闹起来了。",
      "status": "draft"
    }
  }
}
