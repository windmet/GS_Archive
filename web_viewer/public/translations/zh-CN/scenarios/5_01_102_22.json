{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_102_22",
  "source_raw_hash": "sha256:7a2c9303c0767704c239d96a04544a2fd9b3c817d9f6cb8246a61e04dbbbd93f",
  "entries": {
    "story-text:v1:5_01_102_22:5_01_102_22_a:cmd-000011:dialogue:000": {
      "source_hash": "sha256:92c187cbaa5dde71d81fd42472793fc0120799e999c8e92126440013e7380083",
      "text": "嗯？这是给我的巧克力吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_102_22:5_01_102_22_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:3e74dcc03d9befe080516212b10d3a96cdf34436630b5b6e9bd6870d33b689b3",
      "text": "居然连我的份都准备好了啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_102_22:5_01_102_22_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:3b408516b793979a29071664a2af70f08c1591a57f16f0f55cba17a16dd58316",
      "text": "我向你致谢，制作人君。\n巧克力中所倾注的火热Passion，我确实收到了！",
      "status": "draft"
    },
    "story-text:v1:5_01_102_22:5_01_102_22_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:c258bdb412dabf7c35c1e66308f7733a5b14d9ea839430420f063400cc5bf624",
      "text": "到了白色情人节，\n我也要准备一份倾注了我之Passion的回礼！",
      "status": "draft"
    },
    "story-text:v1:5_01_102_22:5_01_102_22_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:16692a2b21735ae4fd90c0f3bb570e0281f8b7c64b5c0a3e102fa3ea3a7d3dfd",
      "text": "给我好好期待着吧！",
      "status": "draft"
    }
  }
}
