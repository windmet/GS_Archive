{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_10003_01_g",
  "source_raw_hash": "sha256:691d1dc0fe4d2c42ec6e91e24121a70c6d5bdd32dc47969ecd2151e578a9f389",
  "entries": {
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000022:dialogue:000": {
      "source_hash": "sha256:9a21bd20e311b57f4ae1470b15e77196972def1965581938085860de56fac1cd",
      "text": "辛苦了，阿斯兰先生。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000032:dialogue:000": {
      "source_hash": "sha256:a5468a97cc7565cdee357d56eacc3178b64af10df4f4dcb95cdf0815f20105f7",
      "text": "卷绪！？\n汝不是应当已与咲一同归还了吗……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000049:dialogue:000": {
      "source_hash": "sha256:50e1b93c1e5eb6519e35d5e54f60bf24258393cacd6ad6a7da48aec87b2b5dd9",
      "text": "我落了东西，回来拿的。\n阿斯兰先生这么晚了还在练习吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000067:dialogue:000": {
      "source_hash": "sha256:2411660303916127cadb55782b05b8bf4cc27cc83b554ead325455763cdb8956",
      "text": "唔、嗯……神谷之前不是说过了吗？\n想要通过神秘的魔石，将特殊力量传递给全世界。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000073:dialogue:000": {
      "source_hash": "sha256:bcbe2c75444ad583a13f2649dc5ff04397e5a7ec696ed0f98e70e830ce23d28a",
      "text": "吾与撒旦邂逅，被赋予了黑暗之力。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000078:dialogue:000": {
      "source_hash": "sha256:60dab67f461ac3e87b7a6631f1312713bbf2eb649399d2416066fa5910ac76c7",
      "text": "吾亦欲如同撒旦一般通过此圆环，\n为迷途羔羊赐予黑暗之力。",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000090:dialogue:000": {
      "source_hash": "sha256:35a39c142edbc10ceac77f12f0152525fcf03b53c88f7854a373d5e881cf313b",
      "text": "阿斯兰先生……",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000100:dialogue:000": {
      "source_hash": "sha256:fdf0f6c98b063fcd0face22460541fec77ad791619ed51661c159df0d1abfa99",
      "text": "不介意的话可以一起练习吗？\n如果有什么我能帮上忙的，请尽管告诉我！",
      "status": "draft"
    },
    "story-text:v1:1_3_10003_01:1_3_10003_01_g:cmd-000108:dialogue:000": {
      "source_hash": "sha256:7ec46c46e51cbb6be04c242d61975b68e5bce2d4ea0c8d9344b8734fc1d601e3",
      "text": "卷绪啊，吾向汝致谢。\n为了彼之试炼，一同反复磨砺吧！",
      "status": "draft"
    }
  }
}
