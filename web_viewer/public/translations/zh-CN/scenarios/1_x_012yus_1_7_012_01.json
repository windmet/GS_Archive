{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_012yus_1_7_012_01",
  "source_raw_hash": "sha256:9e0430f5433856f8f38637ea6696e4db1e8b0497f3d1bda91bf1d207e03d0b71",
  "entries": {
    "story-text:v1:1_x_012yus_1_7_012_01:1_7_012_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:4c6bb60fab96084c5457a5a7125900ee9716392e7c414f4a645ce3230e9292fc",
      "text": "●●●●●●●●●●监督，\n你知道今天是什么日子吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_7_012_01:1_7_012_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:669d72dff7d944fa7130ba77cd379adb753600de27c73b808ce310a188642010",
      "text": "当然知道了。\n悠介先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_7_012_01:1_7_012_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:684dd870a810f775e72d229c2520719b62b3f71db49a8238e88c9625535f23b4",
      "text": "真不愧是●●●●●●●●●●监督！\n果然把我的生日好好记着呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_7_012_01:1_7_012_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:31a5ba90864c1424ad52bc5979d5c925b713483cf83e2bd3e61e288a08994cc3",
      "text": "315 Production一共有49名偶像，\n我还担心监督会不会给忘了呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_7_012_01:1_7_012_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:bcb0fdc3820165c8b7e3eba431a3d19bdf12359bb79ac2a4eb33709090e72ecb",
      "text": "所以你能祝我生日快乐，我超开心的！\n谢啦，●●●●●●●●●●监督！",
      "status": "draft"
    }
  }
}
