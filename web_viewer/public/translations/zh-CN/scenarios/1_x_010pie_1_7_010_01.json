{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_010pie_1_7_010_01",
  "source_raw_hash": "sha256:1f2d5680fece8e267af37ea0f117c5431c5eae1d52b3832f29e671af7e46036f",
  "entries": {
    "story-text:v1:1_x_010pie_1_7_010_01:1_7_010_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:c2760c43129fbc38b076428f8cfffe38f8d2d5bd547e54bb80ea41fa748f0438",
      "text": "啊，●●●●プロデューサー！\n你知道今天是什么日子吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_7_010_01:1_7_010_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:e2b609c840075b54f928f92ad16beb083feab60b74bad1b070a293a5989b2c4f",
      "text": "当然知道啦！\n皮埃尔先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_7_010_01:1_7_010_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:8a294a7b2e3ba144065a1e56e2c00651978758e3363dcc1b707bea17540f02fe",
      "text": "呀呼——！\n谢谢●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_7_010_01:1_7_010_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:6062c4771586ca685b4746549be8ef02ab0c302ab422444ad39eb5c0d40eb06c",
      "text": "祝贺我，好开心！\n心里暖洋洋的！",
      "status": "draft"
    },
    "story-text:v1:1_x_010pie_1_7_010_01:1_7_010_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:42a3d8f7d8cc5f7aeb4ed52cfee58c21841759da34134b63b6c0c8d75537f490",
      "text": "我也会给●●●●プロデューサー的\n生日庆祝的哦！",
      "status": "draft"
    }
  }
}
