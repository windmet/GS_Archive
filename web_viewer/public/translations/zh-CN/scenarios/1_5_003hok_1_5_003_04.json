  "scenario_id": "1_5_003hok_1_5_003_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000010:title:001": {
      "source_hash": "sha256:e7ca9a74010c232e12c9275b64ebc7093943ae00e4882385da389e51c815d93e",
      "text": "在资讯节目中负责穿搭造型的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:fc3b2f02ec394fd7048d15d9c138e78780bc37547572d40ca775cafa604fa2dc",
      "text": "给普通人搭配服装的机会\n可不多见，真让人期待。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:fcdd5a06cde9e6f521149e1cb6ae48a25c46cea47ee8e19d78acd3acda78593a",
      "text": "这是一份能发挥做模特时的\n知识的工作呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:8930a6c04a3fd9c51f4a7b6a56264ec75b531b902ff2b026da9a7266be035e25",
      "text": "是啊。关于服装的知识比起普通人来\n我也算了解一些，希望能做出很棒的搭配。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:09b7cdebed1b92db412de02b96889076261e88ee8b5620652f546d8b05fe193a",
      "text": "首先，我想好好听取对方本人的意愿，\n再构想完成时的画面。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:0a299d217e7cd9d0c8373d90786784eefde17191305fd0dcf82310514d1f9179",
      "text": "哪怕衣服再怎么适合本人，\n本人要是不中意就没有意义了嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:f45498b72f1b1f4a45425c774cec1febc2c253da9cd3bec852bd7789cf290b80",
      "text": "我想做到让穿衣服的人和被穿的衣服\n都能感到幸福。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:e8ccb1998729f26973203b5cd3cb048db78071fd1b327ea0baab41ffd83a3de5",
      "text": "真好。被搭配造型的人要是也能高兴就太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:bc0525934e36e748de9cc3886cc4bdbf144ddda592ebb1e490dc41bf18cc00cb",
      "text": "如果可以的话，要不要我也来给\n●●●●プロデューサー做个穿搭？",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:d6e9b6b9b2a188960419c4ff08a9b9f135abed0cd0c98fdb9270c8bd04b5c9ea",
      "text": "开玩笑的，突然被这么说肯定会吓一跳吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:605f12620d4292d0a11245463fe419534b730457c6ebf74745e912da7610be26",
      "text": "要是有机会的话，请试着交给我吧。\n好吗？●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
