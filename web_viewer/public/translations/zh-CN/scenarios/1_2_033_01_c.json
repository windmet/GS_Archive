{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_033_01_c",
  "source_raw_hash": "sha256:d01a89d9e11a63ff01ca2d78fdbe367e9c635b17f385bc031b128de6db15c9ec",
  "entries": {
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000030:dialogue:000": {
      "source_hash": "sha256:031f802793e1700d0ae73be2aaafff4d3d2b73b4c030714a36f0125349bf5d77",
      "text": "嗯——，那个……这里是……咦？\n好像之前在课本上见过……啊，有了有了！",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000039:dialogue:000": {
      "source_hash": "sha256:f9319e4340ffc08b93e6c17a63557e9da7bdcc4c3c0915fde320ca65a07667a1",
      "text": "（志狼君看起来非常努力呢）",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a54866e7418667f1e88daede872c54d2354f355906a7b9a1369af8c7952a90aa",
      "text": "（看起来非常专注，\n暂时先不打扰他了吧……）",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000063:time_caption:000": {
      "source_hash": "sha256:d754b865bcb97c6ac4d1751a7324118e65611b0ee124791cbf4f7dff6d44926c",
      "text": "数小时后……",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000077:dialogue:000": {
      "source_hash": "sha256:dce8ad7958e3bfc7624b4428fdf9b22be5af601c7abae42d0211f12e8c33e761",
      "text": "（文件这样就整理好了……\n啊，已经这个时间了啊）",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000079:dialogue:000": {
      "source_hash": "sha256:4a3d730e10de5add39aa4da916e9f5e5ca1e461faad006c0798fba61f3378b7e",
      "text": "（志狼君的作业怎么样了呢。\n去看看情况吧）",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000102:dialogue:000": {
      "source_hash": "sha256:f4487967188b19dcdc48328e031e46c8e57114bb2671fb5d5fa41276a7f37d25",
      "text": "志狼君，作业写得怎么样了……咦？",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000107:dialogue:000": {
      "source_hash": "sha256:41093b09b826ed6bcf31e21b09ce7a6b19471d893a87bb2fbd12fbd45d72fe4a",
      "text": "……呜。",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000111:dialogue:000": {
      "source_hash": "sha256:b89a63f5c54ff288c005635135523ba095bc858edcab11f663d880bd3b9597df",
      "text": "志狼君，你怎么了！？",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000119:dialogue:000": {
      "source_hash": "sha256:fb3241c95ff587f85ad13787fad3b3810d3a448ddd1a212a99da81cdabfaefe4",
      "text": "作业，全都是不会写的地方！\n可是说不会写又太丢脸了……",
      "status": "draft"
    },
    "story-text:v1:1_2_033shr_01_1_2_033_01:1_2_033_01_c:cmd-000123:dialogue:000": {
      "source_hash": "sha256:4524937641d418d0d506a52209f0818ee3a12c9339eff3a0aebd3c8d4210e15b",
      "text": "但怎么想怎么想都不知道该怎么办，\n完全搞不懂啊……！",
      "status": "draft"
    }
  }
}
