  "entries": {
    "story-text:v1:003hok_401_2_4_003_01_09_b:2_4_003_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:d83bf125ed230fa33616506c2c04b5f684103f0769fe072083e08342c5fb92e7",
      "text": "喂，制作人。\n现在稍微打扰一下可以吗？",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_b:2_4_003_01_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:7edf5d233a4a792e4c8509e182f3afe9cce956a6d4164b92911c8ac8eac82a73",
      "text": "可以，没问题！",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_b:2_4_003_01_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:91f822e6d86c47f9e3c7bca2ececfaee8ac6c1e4b6f5ca4a326cde20ecd410c5",
      "text": "谢谢。我已经看过电视剧的资料了。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_b:2_4_003_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:b1cc9886a0e2858cbcc1a91bdc276aec82bccbe92efba60d40e54ef69273ba57",
      "text": "据说打算参考我们的形象来编写剧本。\n真期待会是怎样的角色分配。",
      "status": "draft"
    },
    "story-text:v1:003hok_401_2_4_003_01_09_b:2_4_003_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:fb1c9b32913b0cbd4e6c34793b78bf5169a5dfaf97a9407f9c0b6d9d7aa4eb16",
      "text": "明天的剧本碰头会，\n就拜托你了。那么，Ciao☆",
      "status": "draft"
    }
  }
