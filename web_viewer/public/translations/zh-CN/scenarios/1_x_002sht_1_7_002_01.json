{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_002sht_1_7_002_01",
  "source_raw_hash": "sha256:221ff6cae3c7275e21e31e45167822a04a4815e5f4162a9ab9e58d0b38787d5a",
  "entries": {
    "story-text:v1:1_x_002sht_1_7_002_01:1_7_002_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:1f3e59187d0d71e9125bfd4931d1a593df7746560fd6a2b9d85da2b38eec8bb7",
      "text": "呐，●●●●プロデューサー。\n你还记得今天是什么日子吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_7_002_01:1_7_002_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:b72c887aa74b573c2e899799b9a97622d1cd6937353dc3a7f470a5bd23ac83fb",
      "text": "当然记得了。\n翔太先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_7_002_01:1_7_002_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:d1d4000cb5393ba534958e5cc773e4733c6fcf7dfc312505c3a6f9d5a75b1b3b",
      "text": "嘿嘿，谢谢！\n要是你忘了，我还真不知道该怎么办呢～",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_7_002_01:1_7_002_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:5a25633366a30b83a094c4db6763a31f662e29629356b62d6541a17fc3f38b57",
      "text": "不过，●●●●プロデューサー怎么可能会\n忘记我的生日嘛。",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_7_002_01:1_7_002_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:06cba22f27984c6738ae8face17ca66f516a67dbaf36fa8690b0181acb515333",
      "text": "以后每一年的今天，都要好～好为我庆祝哦。\n说好了哟♪",
      "status": "draft"
    }
  }
}
