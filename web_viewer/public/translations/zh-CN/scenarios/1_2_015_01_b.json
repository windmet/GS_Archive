{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_015_01_b",
  "source_raw_hash": "sha256:96ef399695d72adb0f09877fd26af0e5b84c075c25c8ecbc6591b9a6b93fbc03",
  "entries": {
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:d810bce181c18882266517ddc6218416b72cb46b2e32391112a2ade8f605bbf5",
      "text": "（这个包装，不是跟家里那个\n一模一样吗！？为什么会给我生发剂……？）",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:8c35e73851130371a859b34297cd74eaea2c6d11ee10e0e3da733049292212b5",
      "text": "龙先生？",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e6a42d946480c726bbe418ed34b2e98fea0a465282b72a622e3fc5f89c034303",
      "text": "难道说是看我的发际线后移了，\n才安排的这项工作……！？",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000035:dialogue:000": {
      "source_hash": "sha256:28d13c6602ecaa6afc2f0bda118e61794def4483d7c7d590e1afdbe6559745f3",
      "text": "怎、怎么办啊……",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:07f0bb88c787431268a1822c91bf2789f6aea5009e35931718e9f210ca0a226c",
      "text": "冷静一点，龙先生！\n这是新上市的爽肤水和乳液哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000041:dialogue:000": {
      "source_hash": "sha256:722d99f02fdd2e3e22ab90252ce3231b3e4f9b78194a3cb0c5e5d45604f49aad",
      "text": "龙先生的头发很茂密！",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000044:dialogue:000": {
      "source_hash": "sha256:97847c60df2b78c18696bf90fcbf5f320582b16119092955b42e9f42487cbae8",
      "text": "哎，不是生发剂？",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:5eb54f45785035cdd821bdbc50920d8b2a3ecc0e9da764e47f1ed339e29c18bc",
      "text": "……真的耶。\n仔细看的话确实写着爽肤水。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000054:dialogue:000": {
      "source_hash": "sha256:0ffcb26c7762870e15dd88c7b8fda77644e7cf2fcf936c9d24d9a234e70872f3",
      "text": "是的，确实是男士用的护肤品。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_b:cmd-000058:dialogue:000": {
      "source_hash": "sha256:6078b55544cb308009ef8675195e8f6848b0fbfef25d2de5a7ed836fab2d616c",
      "text": "太、太好了……",
      "status": "draft"
    }
  }
}
