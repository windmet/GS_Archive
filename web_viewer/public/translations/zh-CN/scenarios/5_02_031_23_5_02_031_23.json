{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_031_23_5_02_031_23",
  "source_raw_hash": "sha256:43bf73076fb50073f95b27aba1457731c3521bac31486472005351fcff1fa04f",
  "entries": {
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:d294c5848bf47424a4095a5813d533f10c57be2739f0e9a7aa4370d0716b1b8e",
      "text": "今天的购物真开心呢！\n看中的东西买到了好多真是开心到飞起（HapiPapi）啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:8dd0ef601b26d85af7c39833c6b1934df38def7c3cc1d4b9b6c7cae61d8a9192",
      "text": "这件衣服也是我一直想要的款式，\n这边的饰品也超级可爱（PapiKawa）！",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000029:dialogue:000": {
      "source_hash": "sha256:581be5ec6dc98ca4e6851f4c19599d71dcbeae3a7ebe90ce3f1e38233d706159",
      "text": "今天能和制作人一起来真是太好啦♪",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:82e5aa62b93b489b3f3f13ab0aaab935b8ab687569e298ba2051e828c2e29d0b",
      "text": "真的很开心呢！\n谢谢你邀请我一起出来。",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000036:dialogue:000": {
      "source_hash": "sha256:f9030de2bae8b2336e80c16e04c57489d236fa62b4f7eae8934580bf7c640960",
      "text": "我才该说呢！\n今天能陪我一起逛街真是太感谢啦——！",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:d9895adb08934328648287ebfaf2f856155a480d9496272613a488d3296443af",
      "text": "最后……来，这个给你！\nHappy White Day♪",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f47cead901c5a50c41866319987eb3a52db47d7dd88d4d26a72f90f098cbbef6",
      "text": "非常感谢。\n总觉得散发着很甜很好的香气呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000054:dialogue:000": {
      "source_hash": "sha256:9ae819675cf5ea1504ac8d866e69cb47f00537834edab05f66dc1cd1b61b899d",
      "text": "嗯。我试着烤了磅蛋糕哦！\n是我的自信之作☆",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000059:dialogue:000": {
      "source_hash": "sha256:2aa5a6fb073c2d2bff916165cfd00478c794ddc73ee1d1bb0b4409e142564c00",
      "text": "●●●●プロデューサー，谢谢你一直以来\n支撑着我们。",
      "status": "draft"
    },
    "story-text:v1:5_02_031_23_5_02_031_23:5_02_031_23:cmd-000066:dialogue:000": {
      "source_hash": "sha256:d7395178740239e2ccc7b25ece6f8d88211d0b600e8df4bcd4d76fc07c1762b6",
      "text": "饱含了我满满心意的回礼，\n要是能让你开心就好啦。",
      "status": "draft"
    }
  }
}
