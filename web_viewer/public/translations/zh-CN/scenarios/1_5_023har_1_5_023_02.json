  "scenario_id": "1_5_023har_1_5_023_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000010:title:001": {
      "source_hash": "sha256:a04170fd02a81a4918366ab7674de6e4f4378fb5963a2750cdb79281604cbeff",
      "text": "男士洗面奶广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:0752ae6e462d03f8352a51ea08054ea1aa3ca4ac5729e5ba8c9398767c1e43c1",
      "text": "●●●●プロデューサー，辛苦啦。\n那个包裹是刚送到的吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:955d09847f204313667dc94f3e3142f77fc8c12f7c09cff9b70c79dcb2179403",
      "text": "咦？这家厂商我记得是……",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:17aeaa89744c619bccad72190dec52e3ad92335961f65fb3e4ce836221aeba0b",
      "text": "是春名先生下次要拍摄广告的洗面奶\n厂商送来的样品哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:c9f3af0b9d4be68c708f6dfc8da33734f6c73034ca39a3035f98e5c256fe36e3",
      "text": "那这个，我可以收下吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:47e4c854af12436d83b28e4cac32f6f8efb0cf6ee84bf5023d1e9067951d5ffd",
      "text": "当然可以。\n可以的话，请拿去试用一下吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:9d8e0ef9a317ded6e3bbf4df65a6cb1a56f8dc5e8876388fddf84b7ae51008d9",
      "text": "谢谢！\n那我这就拿去用用看啦。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000051:time_caption:000": {
      "source_hash": "sha256:94c47e71a7f809652716c93dcac4901345742e2813115851d14db6b4d4bcc329",
      "text": "数分钟后……",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000060:dialogue:000": {
      "source_hash": "sha256:4fbaca0d62fae0f3b87d6129afe34e39294f98ff4c9daf9841319a5179124a42",
      "text": "●●●●プロデューサー！\n这个洗面奶，超级好用的！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000068:dialogue:000": {
      "source_hash": "sha256:ebb477099eb75b2eaa543116523244d2370d8c7e256ba325213c483780721229",
      "text": "怎么说呢，皮肤感觉特别棒，就是……很弹？\n很滑？总之太厉害了！",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000070:dialogue:000": {
      "source_hash": "sha256:410dee9754e265dadba897aafbc8404c9cdcb7c6621aa05bead7eea3e08159cf",
      "text": "呵呵，看来您非常中意呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_023har_1_5_023_02:1_5_023_02:cmd-000077:dialogue:000": {
      "source_hash": "sha256:e1efd7f4927e40b74de6af4c13848154569b9b725f8adc9a943761b2d031f72b",
      "text": "嗯！为了让大家也用上它，\n广告拍摄我也会加油的！",
      "status": "draft"
    }
  }
}
