  "entries": {
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000010:title:001": {
      "source_hash": "sha256:3c3162041daf9ee086e242f77723c4b491a2744b6789fade3a150f4393652ba4",
      "text": "特辣拉面广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:026d8c7efa01ad8cc923fb7f5e8bdf350668a4f423b35468e967d40ae690ee13",
      "text": "拍摄怎么还不快点开始呢～♪",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:0b5c96b41efc8e9fd02b1f94b563f7ef31dc06e3355b454c0084677aadb747f8",
      "text": "●●●●プロデューサー酱，\n我这边已经万事俱备啦！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:a414565fdc0b380346c2d8796e97d7f8d21738230f02b26fabe7bd019dc87eff",
      "text": "呵呵，干劲十足呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:25bdfdfee91fed9ff93c56cd96af6f2263f6b9eafdabc718f40ac48fd4fa40e0",
      "text": "那不是理所当然的嘛。今天拍摄的\n可是特辣拉面的广告啊！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:aec44e570dc3831f5448abe1005c8c99495d192e4d292aa206a4e54483be8941",
      "text": "话说回来，四季先生本来就很喜欢吃辣的食物呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:9dd8b01e3882063de48b4d02af61be25907fee8dca6f908e9564e53cc92e8f4b",
      "text": "是的！平时在学校吃午饭\n都超喜欢吃特辣杯面的程度呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:66bc8a28b5c87da7c35638942da7304ed2162327e78031cb64399e99954b312a",
      "text": "我会一条就过的，\n●●●●プロデューサー酱，好好看着吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000058:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000069:dialogue:000": {
      "source_hash": "sha256:69448951c8b33b379c0ed52e206a51a385fc8e1705c634469f218b09e99347b3",
      "text": "●●●●プロデューサー酱，我回来啦！\n按照约定，一条过拿下啦☆",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000073:dialogue:000": {
      "source_hash": "sha256:ba92795d63d14c808b7a9008f79498af537e9d9a526a0d2b8451d74b63399771",
      "text": "真不愧是您。另外，拍摄时准备的\n备用商品也作为给四季先生的礼物交给我保管了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_02:1_5_024_02:cmd-000082:dialogue:000": {
      "source_hash": "sha256:7577a393763c0b5cb440be7f9a9e1eca83e0f5cf0bb71171381162def8023b5f",
      "text": "真的吗！？太好啦——！\n这拉面超级Mega好吃的，太开心啦！",
      "status": "draft"
    }
  }
}
