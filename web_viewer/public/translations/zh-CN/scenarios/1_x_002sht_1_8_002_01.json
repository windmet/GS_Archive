  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_002sht_1_8_002_01:1_8_002_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f9502dd56433c8aade9924f3f995679012e9c77579a6dedd2b423c5e40d76063",
      "text": "喂喂，●●●●プロデューサー？\n练习结束了哦。",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_8_002_01:1_8_002_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:ca01771e20bda26067a0ae63a4ddeb59b8bc2966bb6ce8946d8068deae7b7a67",
      "text": "对了对了，等会儿还有工作呢～\n不过在那之前，我有句话想跟你说。",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_8_002_01:1_8_002_01:cmd-000018:choice_short:000": {
      "source_hash": "sha256:1c32f38a5c720fca349f735b404ebd3f049da3f2a485a13d5f2843476b573631",
      "text": "请问是什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_8_002_01:1_8_002_01:cmd-000021:phone_message:000": {
      "source_hash": "sha256:3f1eceaa2f115a1a07a7254a8facd6b9644ceea105e0b5074215cee20101b794",
      "text": "●●●●プロデューサー，\n祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_002sht_1_8_002_01:1_8_002_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:69f5f2dea423b399f1f7353a244536fab1226541d3f0903262570990631b5894",
      "text": "待会儿我会再好好替你庆祝的！\n那我先出发啦——！",
      "status": "draft"
    }
  }
}
