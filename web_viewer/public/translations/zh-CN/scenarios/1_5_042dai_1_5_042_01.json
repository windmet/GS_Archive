  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000010:title:001": {
      "source_hash": "sha256:b7d7ee07d123106945399d613facf19c30aa3e5f1366c918986d5cd09915fa13",
      "text": "游戏资讯节目嘉宾的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:b8f4512153ddccbe8160c955b186ec96a3bc10c180547bb86d2e0d8326a9cda0",
      "text": "今天的工作是游戏资讯节目对吧？\n因为太期待了，从昨天开始就静不下心来。哇哈哈！",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:54efbdc171852a2d02fd30c8d63f04d56c8db8a22cd781873ade74a6583a31fd",
      "text": "而且还是俺喜欢的格斗游戏！\n这下可比平时更加干劲十足了！",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:7f35769ea4e92e603f651e9bcf0e75d927da610da4af7b7bb9efaaa36809b174",
      "text": "啊，当然无论什么工作俺都是全力以赴的，\n这点可别误会了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:e7698850cf15aabce1950a5de0b48a330487ce042f8e2342c2405c454146d98a",
      "text": "我明白的。大吾先生无论面对\n什么工作都总是全力以赴呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:5bfb92a5cfebc60c8b9ada486f44092c0bc5c413b5b1245c0242a61858ea45d7",
      "text": "只要拼尽全力，说不定就能让\n看节目的人露出满分的笑容。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:bc1397cc1a8e7a213e3282ac2a073add7a05fb8f35aa7e1146713a1772b569fa",
      "text": "而且既然是最喜欢的格斗游戏，\n俺也想好好大展身手一番嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000043:dialogue:000": {
      "source_hash": "sha256:e61954762d753f9a8f521e14fb85f5e6a49a74cdd8a6066c0f2b265dde5a2029",
      "text": "连招接上时的爽快感，\n打出防反时的亢奋感！",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:f4a2d4bf1fe93dc41fce6cd89e2fcffa70147cb89deed7678fe8a912e2477ad0",
      "text": "要是能把这些展现出来，\n说不定大家也会对俺产生兴趣呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000051:dialogue:000": {
      "source_hash": "sha256:117902be3b99315f7956781d3f167039b5afbbf961044d273cd1e2073401527f",
      "text": "●●●●●●●●●●Boss也看着吧！\n俺会帅气利落地放出绝招的！",
      "status": "draft"
    },
    "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000057:dialogue:000": {
      "source_hash": "sha256:09e872c5dde167e233f9e07970a8c20c0810ce39b06da3d885169c9250ab39d9",
      "text": "那俺就去啦。\n会好好加油的。",
      "status": "draft"
    }
  }
}
