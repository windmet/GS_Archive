{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_042_22",
  "source_raw_hash": "sha256:b6985cf665f353f39439bd7d903e38e699b7cdd8f2f9500c575f99fd6f67c4b3",
  "entries": {
    "story-text:v1:5_02_042_22:5_02_042_22_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:a4dbf28e3174febcaf2cb1b56a267deed4eb80eb335178029d872ff7672204a4",
      "text": "●●●●●●●●●●Boss，辛苦啦！\n来看俺训练了吗！多谢啦！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:f36ca4967ce8d2a74ed65c90fa0515edc9a74de5d4d4e6bafaa624ad7c8afa49",
      "text": "来得正好！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:32242c21e35452526ccadcb3569c0877732ec8066be2f34023af3f25f8aca72b",
      "text": "白色情人节快乐！\n巧克力的回礼，快收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:a7b71f02980c6f53ac51598f7ca258cca55dfe1723d1b42ab47bca3f922b10a5",
      "text": "俺的感激之情，\n简直毫无保留地全塞进去了！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:afcb7676efaf8da9edb615727b14225e3f12fbdb66f81a93c81f72ce95b7daf7",
      "text": "要是能合你心意俺就高兴啦——！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:2450690bba8b484605046ca93cfd0b0d7bbc5e38f67cb36218b805621658ce54",
      "text": "●●●●●●●●●●Boss，排练辛苦啦！\n现在能借俺一点时间不？",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:ae9b8bf0cef21b281c02aa675475f89062d722f884a0f489ede87ef71a229170",
      "text": "正式演出的前头有想交给你的东西。\n你大概心里也有数了吧，就是这个啦！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:d31a28b6dc68b8806fb9ee50c23a055b6740f9cebafde226bc60db3ea9b2dd1c",
      "text": "白色情人节快乐！\n情人节的回礼。收下吧！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000036:dialogue:000": {
      "source_hash": "sha256:ecbbeb6ce0d3b61faf58bc202cb3fc6c3cbf26822a6e87f701d1e1d5f7d828a7",
      "text": "吃巧克力的时候虽然也说过了，\n真的是超级好吃的巧克力呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000040:dialogue:000": {
      "source_hash": "sha256:9d1073a6aa2867f8b4ff9ed5cc2fb4fa7f488d44aeb01f2918008a771651131a",
      "text": "情人节派对也超级好玩的呢——！\n聊了好多好多话。",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000042:choice_short:000": {
      "source_hash": "sha256:6114de92a803ab86e2b4c87b3bc1313418a9c7e350c8012f952610835edb2868",
      "text": "谢谢你的回礼！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000043:choice_short:000": {
      "source_hash": "sha256:49d3a948133c145c0137f26c1e4b65be842630a64dae22d8846f7f8ecce8d36c",
      "text": "我也觉得派对超开心的！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:9259220d5b9d8d191452b11e34aef04001c8c2117d4229508dcf08f787a252df",
      "text": "俺选了感觉Boss可能会喜欢的款式！\n你要是能喜欢，俺也高兴！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000055:dialogue:000": {
      "source_hash": "sha256:0ccf7baee6e0de1a496f6ea0aa8dcf80eac8473bee76489e7f45ef1eba551046",
      "text": "近期俺还想再办一次呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_22:5_02_042_22_b:cmd-000066:dialogue:000": {
      "source_hash": "sha256:a36a8fbf5ecfe1592db40b1f02fc2e8beba253d458652796e8058efb41d37128",
      "text": "要不要办个白色情人节派对？……哦，\n办吗！详细的事等工作结束之后再说吧！",
      "status": "draft"
    }
  }
}
