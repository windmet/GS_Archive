{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_02_d",
  "source_raw_hash": "sha256:9499408360e90444446ed2c2c80f162c2cb655e1f049636a4875838b0489639c",
  "entries": {
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7f0c2100cc239f72951531266c9d3dce6437034b3824e1364fc2207b62a2f401",
      "text": "咕～！闻到超香的包子味了！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000031:dialogue:000": {
      "source_hash": "sha256:71a6dc78035c9c7352ca16bba29a14484f48bec9e305c2835fd80e83054f388c",
      "text": "刚才不是才吃饱了松饼吗。\n还能吃得下？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000035:dialogue:000": {
      "source_hash": "sha256:a6fd884000e0efeec1ab144a9b008df92a2c616b451bc53a1fb4a2649076c836",
      "text": "闻到这么香的味道，\n肚子想不饿都难啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:23ac2ed0a1da4ab43f87af248f58a59b60eb97de0ff83bf142b909b7ace57f40",
      "text": "可是啊，待会儿还要去买衣服，\n零花钱……忍、忍耐啊忍耐！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000042:dialogue:000": {
      "source_hash": "sha256:6f0f299d0926879c2c9b3fe0402f2e450f58ee2cc6a2910a6a058af5b099bbaa",
      "text": "喵～",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000046:dialogue:000": {
      "source_hash": "sha256:7a9a3797db28fc98df6f53f4b242d1a74bf39c4f72940e853d027b95d6bb6cde",
      "text": "不行哦，喵子。就算你叫得这么想要，\n我也不会买的！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000053:dialogue:000": {
      "source_hash": "sha256:a3cff634cc297e498d0ee427702567ebce2d12dfbad0517d6282ad4f42ccb364",
      "text": "呵，看来这里是个危险地带啊。\n赶快穿过去吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000065:dialogue:000": {
      "source_hash": "sha256:037f11eda0cac90b6ef7a765ae5539f70103bcc9fbfed5a6cc42c44e2eb32467",
      "text": "那个，不好意思。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_d:cmd-000073:dialogue:000": {
      "source_hash": "sha256:dc987764475d4e385f60b19ca9ee98137b250d5d57a76f8a39ab3ed706d8d501",
      "text": "啊？你是……",
      "status": "draft"
    }
  }
}
