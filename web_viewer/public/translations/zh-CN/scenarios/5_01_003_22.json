{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_003_22",
  "source_raw_hash": "sha256:66a00de97d1b82ca2fa0503f957b3e3015d6770c075fae024a3a17e8db6240e2",
  "entries": {
    "story-text:v1:5_01_003_22:5_01_003_22_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:a4cfe2cd6ef36433df0a0a2a83d0e955050401e3d97d455020ac1739eab6a503",
      "text": "哎呀？这是情人节巧克力吗。非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:fd444672423979f8a50ce9b701c875cda65cfc6ecc687823de63d03a5567433e",
      "text": "呵呵，能收到制作人送的巧克力，我很开心。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:5299ea72bba438f34e150df76374215f5b573cbfc4e0e356ad6cf6c8b797488a",
      "text": "这么棒的礼物，吃掉还真让人舍不得呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:3e0895147d45e652ae21037afdeeead3b346e7c88a68f36acd9e6d4359187fc5",
      "text": "不过这毕竟是来自你的宝贵心意。我想腾出时间来慢慢品尝☆",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:7e0ff939e62c6cfd67f353140e97a8beadb287a71a5c99f62e48a815bd25775f",
      "text": "这份回礼就留在白色情人节……还请好好期待哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000013:dialogue:000": {
      "source_hash": "sha256:63d961c7b08daaf754446782de6e1fe7fffdcfefc841900122ec1e50e59df2b6",
      "text": "●●●●プロデューサー，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000019:dialogue:000": {
      "source_hash": "sha256:1aef6ef365f811dfd7bfd8a97b57f8edec29345bb1308e4708b79354e3dab1bb",
      "text": "哎呀？这是……情人节巧克力吗。非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:f2e98f695f3b9d5882de02273a373eb74821a8116e36ca6952d8ad6df6810ccf",
      "text": "呵呵。能收到你送的巧克力，我很开心。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:722a725c644a9fe41b68aaeb57fecc71d322d3288aeecb9ebc043c36c27af929",
      "text": "我会珍惜地享用的。谢谢你。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000031:choice_short:000": {
      "source_hash": "sha256:fbdf1212819faa335d458d436863d80ffd831e4150e8290d07358cb48cbe19cc",
      "text": "希望合你的口味……",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000032:choice_short:000": {
      "source_hash": "sha256:1528dfc1915e6378a09ab76bcefa34b81393927acb49d0d8ce1b19d6be37644d",
      "text": "你能这么说我很开心",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000037:dialogue:000": {
      "source_hash": "sha256:fe379e406c6e81513483cc05bc015a1c7223046d02717801556e353cc16bc208",
      "text": "这是你倾注心意为我准备的巧克力，怎么可能会不好吃呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:64950ee9e9384a692ea0f1d75f96c95c76c267569cbe6667abba2d62289434df",
      "text": "能把我的感谢传达给●●●●プロデューサー，再好不过了。",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:3c437a6e8a824968a4c2ff34668342d894657b5a41f2e6caa38859a64e732f21",
      "text": "这份谢礼，我会在白色情人节好好奉上的……好吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_003_22:5_01_003_22_b:cmd-000058:dialogue:000": {
      "source_hash": "sha256:c8d2c56228968c23e63070467d5e927ae7d5aea38401e69e5cc3e3d6dc3834f0",
      "text": "呵呵，请好好期待吧。那么，Ciao☆",
      "status": "draft"
    }
  }
}
