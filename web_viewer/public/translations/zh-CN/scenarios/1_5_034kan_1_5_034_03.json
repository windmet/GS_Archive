  "entries": {
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000011:title:001": {
      "source_hash": "sha256:503be7dda8502e53329133cd627e709e8142d6360504b7e87d553eb4fbeabc5c",
      "text": "吉祥物人气投票活动的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:c2a15df818e09dd63cc3eb4ea1fc13ebd90335c71bc8558b487c9c00bd533b9c",
      "text": "呵呵，今天能见到各种各样的吉祥物，\n花音超级期待的♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:a80310311a07991634c16a2eeb0c64f0dee8372bfee00e930e7b7a199c3405e8",
      "text": "还有花音最～喜欢的吉祥物\n在呢。诶嘿嘿♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:c93c69b5270c443630414b97bc6cd60734669c92fb469620fe8bf0c06846dfa5",
      "text": "活动定下来的时候，\n花音君非常高兴呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:cb7936b7f275f114531927b2319da8b8a09ebcb2e380ab6bb47bb0fec5c0faac",
      "text": "花音君需要负责介绍吉祥物，\n以及公布人气投票的结果。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:748842239882a7cc60e6d5c31d2a0d071154af0da7988ea86927e6fc827bfd21",
      "text": "马上就要正式开场了，\n还有什么不明白的地方吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000036:dialogue:000": {
      "source_hash": "sha256:a9ece8c2f6fd2ab27e3cc204acff9edfc0c1a987d2f97f6848e098d13f7759b5",
      "text": "没有，没问题！\n台本花音看了好多遍呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:bb68ba5dd9e234cfb80295e4d3aec2f7fc091dd1b27ebb7a6f17a65693d2be5a",
      "text": "要把吉祥物的魅力多多介绍给大家♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:487f7ff3d1d15b1f96db3ec2fefa4166313032a9d3547d66dd5d9c2e65aa8b5a",
      "text": "啊，工作人员在叫我了。\n花音去加油啦。我出发啦——！",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000062:time_caption:000": {
      "source_hash": "sha256:4f19cfe2d8ece0fcd379c0bc0478df4277496edf3aefb38f52c6f4db61798bed",
      "text": "特设舞台",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000071:dialogue:000": {
      "source_hash": "sha256:223b028516609bc42910038653c1e736929b43e9d139a7374a237ba842ce0579",
      "text": "大家好——！\n我是姬野花音。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_03:1_5_034_03:cmd-000078:dialogue:000": {
      "source_hash": "sha256:cdec3e583f29c15fbba37b4884fa50ec5bd320627e78cf7c96e1c9539aac8f68",
      "text": "今天会介绍各种各样的吉祥物，\n大家要找到自己喜欢的那个哦♪",
      "status": "draft"
    }
  }
}
