{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_016sei_2_1_8_016_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_016sei_2_1_8_016_02:1_8_016_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:34e0ca906d2e880b9f19297d08e9282a835e090aca88c2bec03657d88c00f8e6",
      "text": "啊，●●●●プロデューサー。已经到了啊。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_8_016_02:1_8_016_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f7c6d646fb93e87bdf3b7c74f08245f5df1a8554b1f91c7a445b05262ae7aa04",
      "text": "还有，生日快乐！听说是今天，\n我就一直很期待能见到你。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_8_016_02:1_8_016_02:cmd-000025:dialogue:000": {
      "source_hash": "sha256:51c9e1c8a4a82de5163727373c4e2d76b16fe96aad7460025873522caeeaccd1",
      "text": "非常感谢！能收到您的祝福，\n我很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_8_016_02:1_8_016_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:5a9d6b40c6ca915380c6998da5d213baff983b0941a2f65d23b9810e1b263473",
      "text": "能像这样当面传达给你，\n我也很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_016sei_2_1_8_016_02:1_8_016_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:075566ece9558ef4140b8b01eaa056a30e2b54e7d104ca849de7fed1a6f19784",
      "text": "等今天的工作结束了，大家再一起好好\n为你庆祝吧。",
      "status": "draft"
    }
  }
}
