{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_019kur_1_8_019_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_019kur_1_8_019_01:1_8_019_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:b1770cf951ac720b547462ab2e6c238f51558523d990307180a47d2e226d7833",
      "text": "喂喂，我是清澄。\n辛苦了，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_8_019_01:1_8_019_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:79f1b3c11c5f17ee3255a1376d0eeae3ec2a3d7497aaf6885c3724f94d90d60d",
      "text": "请问现在方便说话吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_8_019_01:1_8_019_01:cmd-000018:choice_short:000": {
      "source_hash": "sha256:8c8ab65d5bf59e73715eb445fdbfc0d1c4c92ce08eaee4d0df08cfe69e65ce88",
      "text": "发生什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_8_019_01:1_8_019_01:cmd-000021:phone_message:000": {
      "source_hash": "sha256:f1ef3da4a183bf123e458a04c6e5b866727c4b3252ad8646c1597cd4fecc8cf5",
      "text": "那个，●●●●プロデューサー，\n祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_019kur_1_8_019_01:1_8_019_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:0677003b30a9edc8e387fbca4dd146ff60be83b0ed1b36710d4de9782ad54c59",
      "text": "我只是想向您表达祝福。\n愿您度过美好的一天。",
      "status": "draft"
    }
  }
}
