{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "047shu_401_2_4_047_01_09_a",
  "source_raw_hash": "sha256:3da33153b5ccdd62d3cc328c2988d013d2dfe5c22e835815d7c48908f1575f3a",
  "entries": {
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:aa1e8471b80e1cc6b16e0e9490a2030f98faec16e4ddf60ec047659fb08a9ede",
      "text": "●●●●プロデューサー？",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5d02fd2f08ed2def5a0e63ab8b87f9a39ec11741451db3d633a41607771d5f9d",
      "text": "前阵子我单人出演的那场演出的反响，\n我觉得还是有必要跟你汇报一下的。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:283796433769d683fb50aa16c8a92ad73d60e52744060016b217c6cfb5e13778",
      "text": "班上的同学好像去看了演出，\n他们跟我说简直棒呆了。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:6c2e0051d5889b057903aa4e71305b5ed358d1a91f096ecf41bf943df0cb6e3b",
      "text": "接着别的人也都纷纷围了过来，\n闹出了不小的动静。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:68de93f1d7c335b57c6710583de0ea526bba2e940f82ca68b45a7466ddddb901",
      "text": "真是的，大家对我未免也太有兴趣了。\n……呃，算了，这倒无所谓。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:83a80776b85f6ea14722c27c8042c06b8e1174a017e17ae951704085c3d7ef4f",
      "text": "大家说想看我们315 Pro的演出。\n所以要是有了新动向，记得告诉我一声啊。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:b87996eae62d730bf200d138edf8ed2f1ea5162ca3bc3f8d867597f45f14c77d",
      "text": "像这样从周围的人开始卷入进来，\n也能为我们的下一步铺路吧。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:318a642cff64c9129780b99f29e87b195d7fb0e045bb82fe766d6546a12c461a",
      "text": "啊，当然，你给的情报，\n我肯定会等官方正式公布之后再去说的。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:ea6ed5dbe8dec95cd964328a95ab9a7d4302f6a542ca64ebbc898efc4ab98e2f",
      "text": "很替朋友着想呢。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:cd364e8529b5f61b06d106bd80ae9cc9f7adb354cea7c89b4bf77d7c677edd27",
      "text": "……我本来是打算正经聊工作的？\n算了，随便你怎么想吧。",
      "status": "draft"
    },
    "story-text:v1:047shu_401_2_4_047_01_09_a:2_4_047_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:98e8f98050b2c66c1d3f51bfd9e68fa39464ab2abd53976710642170cfc6ba63",
      "text": "那详细的情况等回事务所再聊吧。",
      "status": "draft"
    }
  }
}
