{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_101_23",
  "source_raw_hash": "sha256:59e27520ebc92e9a43d1a13ce6d14fc4cf7ed866f9f03f3d905052a7d2f512ff",
  "entries": {
    "story-text:v1:5_01_101_23:5_01_101_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:d381004f03beb46b9a065091df9ede3170fa89a65a2c1f423928f9176183d73c",
      "text": "今年，也有我的份啊……！",
      "status": "draft"
    },
    "story-text:v1:5_01_101_23:5_01_101_23_a:cmd-000020:dialogue:000": {
      "source_hash": "sha256:3a6c1416dbac5b40aec8cda674a3b91e768517f001efa982d8a7f8b6f8781a9c",
      "text": "我真的非常高兴。\n非常感谢你，制作人。",
      "status": "draft"
    },
    "story-text:v1:5_01_101_23:5_01_101_23_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:f3c8dbe1e81859372aa35bb849895455dc7f51913b692f176da1f95193b889ff",
      "text": "去年的巧克力，真的超级好吃。\n吃完之后感觉浑身都涌出了精神呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_101_23:5_01_101_23_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:94e6b3f75751f650e53db592b7b8cd8ce87bb20b827602a5975d14bd1320c8b9",
      "text": "今年我也会吃着制作人送我的巧克力，\n在工作上好好加油的。",
      "status": "draft"
    },
    "story-text:v1:5_01_101_23:5_01_101_23_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:1cf3c37ed39b0e16a505da6c25857442bb0d464776a88d3c66167c91179e4123",
      "text": "如果在工作上遇到了困难，\n我会全力协助你的，随时都可以来找我哦。",
      "status": "draft"
    }
  }
}
