{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_008_03_h",
  "source_raw_hash": "sha256:8d16fd07c45f3250a779fa1c07845eb79a27c06491e4fb222e41e1312c0fcfb5",
  "entries": {
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000019:dialogue:000": {
      "source_hash": "sha256:a439309fa6288a68b0e3d068e584b98ed1058f1a5591c4f448e893ebb78ff695",
      "text": "（父亲工作很忙，对我……\n一点都不关心……）",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000041:dialogue:000": {
      "source_hash": "sha256:cdac5c656bfc40f9d02edeb8d6c6ae3b196f838f59007db562860eba5ef6ecfc",
      "text": "那个……\n过阵子有钢琴汇报演出……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000044:dialogue:000": {
      "source_hash": "sha256:9b9c24498e8795a8f015c462cb478bc9fddb383180ea56543fe87dea068d2a48",
      "text": "那天我要工作。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000060:dialogue:000": {
      "source_hash": "sha256:2b84d6edc82ed364cf907b01ac3e4afe1b6ec00bd2489569eca68a5cca55fc49",
      "text": "这是今天发下来的试卷。\n分数比上次……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000064:dialogue:000": {
      "source_hash": "sha256:9b44213c664645b88e168389325e1142860c2437af7d0a64bb80701a5610b371",
      "text": "我很忙。\n放在那里吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000090:dialogue:000": {
      "source_hash": "sha256:abd7804fc3c9d9c45d0ffeba478a7de317c2bd5d547e60f15209d798db04f357",
      "text": "（就算像大家一样热衷于什么事，\n也只会觉得空虚罢了）",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000094:dialogue:000": {
      "source_hash": "sha256:3d9451d2a99375b54152a0df7cdf09f8abe4bd29a2e211847148d0fc12331ab2",
      "text": "（反正不管怎样，根本就没人看着我）",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000129:dialogue:000": {
      "source_hash": "sha256:f10f4f94d329f447538de55762f7caab2dddba8709be462300d6b0e5df61cfc9",
      "text": "……呃——那就这么弄吧。\n不对，还想要更有感觉一点啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_h:cmd-000146:dialogue:000": {
      "source_hash": "sha256:893427cf49acb332c92677f853bfcaebf0b1c2c035d70cf2fa3f78eb3fe68a3f",
      "text": "隼人……",
      "status": "draft"
    }
  }
}
