  "scenario_id": "1_5_012yus_1_5_012_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000010:title:001": {
      "source_hash": "sha256:093c5c5e7aeb0b42684d5106d7148dc90e18a69c7ade72e691c5349a3da013b4",
      "text": "热血青春体育电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000015:dialogue:000": {
      "source_hash": "sha256:b6a1a8741b7570ddf1e9a826065280c5df48c3dc4e51aa476c5dcc3296670535",
      "text": "“前辈，辛苦了！”",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000018:dialogue:000": {
      "source_hash": "sha256:957657e91da371f12520899001d6a04437284a9d61e91158befe978fb6b22b3f",
      "text": "哇！？悠介先生？\n话说回来，前辈是……？",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f27277550f5dc55a87cbcc19867ad160ad2eeef81c1a4e7b7264c1d289ee8537",
      "text": "“刚才前辈的发球，\n真的超级帅气啊！”",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:c2109333029e02c80eac58193dd4837ee79acc91760aac5b468450f960ec5076",
      "text": "“我也要为了能像前辈那样唰唰拿分，\n更加更加努力练习！”",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:9572accb934a96d9137ed121cf6c73d97746b899f44383cc63a6e0bbfb16da37",
      "text": "“啊，我是来给前辈送饮料的。\n当然，是按平时的浓郁口味调配的哦！”",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:140dc9b2c6deba47e4da2276c42701e3d47cf17bf00f340079c02bc04595ad79",
      "text": "……这感觉，怎么样！？",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:c8ef176bdc330e7443c9526e88d1819ead172053cc3fb14df1fae56327168127",
      "text": "是接下来要演的青春体育电视剧的台词呢！\n真的连饮料都拿出来了，吓了我一跳。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000049:dialogue:000": {
      "source_hash": "sha256:36f6f4e9b5c8c0e99c277bc57addcf920656e1f8f80d228fa2307f44c9f0936c",
      "text": "哈哈，抱歉抱歉！\n读剧本的时候看到你在工作，就忍不住试了试。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000053:dialogue:000": {
      "source_hash": "sha256:1d9eebfec5d96702d07eb781e5a1fcd4ce52c6c52c4f812e84831e29954ae855",
      "text": "不过，非常棒哦。\n大家应该都会觉得很想要这样的后辈吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_03:1_5_012_03:cmd-000057:dialogue:000": {
      "source_hash": "sha256:98a5295d2b362dc42163a1c8e7ecf9d78b37e2db0e84d06670b7f2b453c3aec5",
      "text": "太好啦——！得到了●●●●●●●●●●监督的\n认可，正式开拍我也要加油啦！",
      "status": "draft"
    }
  }
}
