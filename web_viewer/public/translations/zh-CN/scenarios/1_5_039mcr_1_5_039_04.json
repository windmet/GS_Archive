  "scenario_id": "1_5_039mcr_1_5_039_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000010:title:001": {
      "source_hash": "sha256:ef02152d71488cbbe192de242c5b501e3b90dd32fed3b053f14dbe04c3147d20",
      "text": "重型机械厂商广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000014:dialogue:000": {
      "source_hash": "sha256:9fb36f01535ed0c5a56bf2899df364492420e0a245a976f6b315052b2f57421d",
      "text": "这次的广告中，道流先生需要\n亲自驾驶拖拉机。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:41eb1b163e371be3ee136b2989b5586b5ca64d70b3a3a988281192cb7f7fb760",
      "text": "据说特意借用到了\n实际正在施工的私有场地呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000019:dialogue:000": {
      "source_hash": "sha256:1f2375a259522ec4450ff0f705d9a7582cf2b09c538c9b7005195df1ce03820d",
      "text": "能在真实的施工现场拍摄，\n真是难得的机会呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:85823c862abc41223257751dde75647ef3b29f15447a2f803240b5c64551ffbe",
      "text": "重型机械给人的感觉，\n不是很帅气吗。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:5746251f009beeada27b830243ee85ae0c4cd7c052bc66e9c6de34c6db1b9c20",
      "text": "能被选为形象代言人，太荣幸了！",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:ae9cbbc44405424ee93f90f230a05bda3c7d09becd7ed58b15faab16b06f36a1",
      "text": "马上就要开始拍摄了。\n请加油哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:1040a94dfb84b35cba145968ac4797fefa453b570ae1b8977b5a1e37b764ea03",
      "text": "好的，交给我吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000041:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000046:dialogue:000": {
      "source_hash": "sha256:ec4d0074000029db69025df8783af58d882a8ecb8622d9c66639dd33c8789b7a",
      "text": "道流先生，拍摄辛苦了。\n您的驾驶技术很熟练呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:c7287a4e9e0819cdee2d13e59ad440e4d1cc86bf9b9c0f13083d9ebd21ffdea8",
      "text": "谢谢夸奖。\n开拖拉机真有意思呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_039mcr_1_5_039_04:1_5_039_04:cmd-000054:dialogue:000": {
      "source_hash": "sha256:b910f8853076e1061099d77d7a709cf7ac8af9666d3dac486d9a0e2fc6ec2c64",
      "text": "作为形象代言人，\n我一定要多替他们好好做宣传！",
      "status": "draft"
    }
  }
}
