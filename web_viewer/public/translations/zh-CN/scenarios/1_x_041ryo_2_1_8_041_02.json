{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_041ryo_2_1_8_041_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_041ryo_2_1_8_041_02:1_8_041_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:39eafa8b9e7e5b267fcc2c855f7a4c2bd8fe370292a28274d197bf346938d574",
      "text": "啊！●●●●プロデューサー！\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_2_1_8_041_02:1_8_041_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:ed83695cf275a0405ce5a96bee248e2df525f32ac45140f878ad3464b49e3d38",
      "text": "非常感谢！\n凉先生接下来有练习对吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_2_1_8_041_02:1_8_041_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:c37f378e8ab07c58f85f1b0adc8e12571e1e71c1583220d15b39465142a2da7d",
      "text": "是的！因为干劲太足了，来得稍微有点\n太早了……",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_2_1_8_041_02:1_8_041_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:52dbc645f1aec05c2141facfa788b2a87fab62153d53dae788483c860cc5f878",
      "text": "不过托这个的福，能向制作人\n送上祝福了，早点来真是太好了！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_2_1_8_041_02:1_8_041_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:b9f079d46f53aa4cd05bc06c33cd6efffc730f31034d5d4cbaa7ff5b827ead65",
      "text": "等练习结束之后，请让我再好好\n为您庆祝哦。",
      "status": "draft"
    }
  }
}
