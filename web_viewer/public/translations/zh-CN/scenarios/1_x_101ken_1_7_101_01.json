  "entries": {
    "story-text:v1:1_x_101ken_1_7_101_01:1_7_101_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:51d193e49970d17f8d9048b8490ebcdde0e63104a5540a0e1af4787f11d0102d",
      "text": "贤君，祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_101ken_1_7_101_01:1_7_101_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:1f32a7fdaf0b53c9e6b74091289e39da1768db7b4427ba6df1a5d173dbce3f99",
      "text": "非常感谢！\n能收到祝福，我感到非常荣幸与开心。",
      "status": "draft"
    },
    "story-text:v1:1_x_101ken_1_7_101_01:1_7_101_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:ecbe0785ba53707c4e67385cecc619144d2a52bc7653743f4e0eea5584f61169",
      "text": "为了315 Pro，\n今后我也一定会竭尽全力做好后勤支援的！",
      "status": "draft"
    },
    "story-text:v1:1_x_101ken_1_7_101_01:1_7_101_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:045ccf40a19136088842f016dd83ccc3279878ad8ecb75bbdee31b52480895d8",
      "text": "今后也请多多关照了，\n●●●●プロデューサー！",
      "status": "draft"
    }
  }
