  "entries": {
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000010:title:001": {
      "source_hash": "sha256:5c2e56a60e13b4adf356a47710612372bffc5881f29ede8af8f99a0cd209ec8f",
      "text": "男士化妆品广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:6432ab252cfeacdd6b66b1ff192fded8ed07caf6ecf561ff7fe976d4be27746c",
      "text": "●●●●●●●●●●P酱，久等了。\n妆化好咯。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:715f5a66c5860ba3bc5938bdbcc7b01eeceb8d78e41ce1ef1abd4d554465de4b",
      "text": "辛苦了。……咦？\n百百人先生身上，有一股很好闻的香味呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:fe10daa5c21f6eb8eaef9cf412af3760117ac3fd8aa3ea4f4cbc4c6deee17646",
      "text": "是接下来要拍摄的品牌的，\n新款香氛哦～",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:0948d993eced1b8886550081b81f792d34cbefedf3c300aea799a8ef60c82838",
      "text": "化妆师问我要不要试试，就帮我喷上了。\n闻起来很香吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:4838177a11e268a9f1acf82b09c33959463d31558c78a7e18b7a86930c856ee5",
      "text": "感觉平时不用香水的人，\n也会很容易接受这种香味呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:22bb12fe7f20d805053ec8ebb99481b749e76eecc2ae58bd50189f6d9a7c0bb9",
      "text": "呵呵，确实是呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:85cbabe0516ca2b43e0397cba48eaddd443d6a855b91a4b169a046a83fc6a89e",
      "text": "呐，●●●●●●●●●●P酱\n喜欢什么样的香味？",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:c6b044f401e8886f2484fc21a83ebb374b0dcff87212a2dacc5dbd1a1f0b3515",
      "text": "嗯……硬要说的话……",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000046:dialogue:000": {
      "source_hash": "sha256:d164cd7a09c0e20caad237c2be7fb22a58665e23242d07db0171ff9c0c79982e",
      "text": "啊……工作人员在叫我了。\n彩排好像要开始了。",
      "status": "draft"
    },
    "story-text:v1:1_5_048mom_1_5_048_03:1_5_048_03:cmd-000052:dialogue:000": {
      "source_hash": "sha256:517abd50d2dc7df4a46075983ed61d591b3f7935167be3fcf0b7e08eae4b572d",
      "text": "呐，●●●●●●●●●●P酱。\n你喜欢的香味，待会儿要告诉我哦。",
      "status": "draft"
    }
  }
}
