{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_033shr_2_1_8_033_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_033shr_2_1_8_033_02:1_8_033_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:dedc9fee62d446dff723bfc22853e7b0ac572fc139d815251d09953f672151e1",
      "text": "●●●●プロデューサー！\n今天是你生日吧？祝你快乐——！",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_2_1_8_033_02:1_8_033_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:8e59c4f432f7222565ce89cb0a607ca143bc9fb480911d21c204db24a99db3be",
      "text": "谢谢你！志狼君，\n原来你还记着啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_2_1_8_033_02:1_8_033_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:8d750f27c377c21d4742839a26d5511ad21976295a1862ec5302afcc812dda80",
      "text": "那是当然的啦！我早就决定好今天到了事务所，\n一定要第一个对你说的！",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_2_1_8_033_02:1_8_033_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:3ff9a1a86c2260e451ef22cd1ec767cdf4302d0a0652231d69ab98d15adcf46c",
      "text": "因为想早点告诉你，我都一路跑到事务所来了，\n嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_x_033shr_2_1_8_033_02:1_8_033_02:cmd-000039:dialogue:000": {
      "source_hash": "sha256:3f638a1589cd9faffb46f049b03611e9483ab66238aadd4819304ceb91bbd176",
      "text": "等碰头会结束了，我还要给你准备超级多庆祝\n节目呢！",
      "status": "draft"
    }
  }
}
