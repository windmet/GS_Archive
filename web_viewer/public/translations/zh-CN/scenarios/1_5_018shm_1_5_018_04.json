  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000010:title:001": {
      "source_hash": "sha256:7a2d455796d719615fcaa14e774d0402bae23890419aa0669fad7c80eb032a7f",
      "text": "黑暗英雄电影拍摄的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:90aabffa9ae0f5c1e69addad00ca8618781bb2571d571ee69ac12da741a6fb0a",
      "text": "导演高兴地夸奖拍到了好镜头呢。\n不过完全没想到天气会突然变差啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:25369270d3ef7abac6d5c5b721e91393ed7547cbd18055514f18f207f01cf957",
      "text": "戏服晾干好像还需要一点时间。\n工作人员们似乎也在加紧处理了，只是……",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:de49245352d795f8cea5dee4cd42b8b13fdefcfddb33a93904e140389e59e328",
      "text": "我的这身衣服毕竟是反派角色，设计得很复杂嘛。\n装饰也多，花时间也是理所当然的。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:cdb1d2a9c7f637b008ae7f91da4d96e1d4e8d1cd3c35809fc2c01328268a3eb2",
      "text": "再说了，反正天气不放晴\n拍摄也没法重开。放平心态慢慢等吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000031:dialogue:000": {
      "source_hash": "sha256:6ae62ce6bcd617bc6a2b82e8835e1ab52690d0460d03775887d66209d9b908d2",
      "text": "呐，●●●●プロデューサー酱。\n跟我说说你对我这个角色的感想吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:f4b7bb3953ccdf58e5be7bf363104cb9d5c6ccd1ecbf3789b07bdfbede89f623",
      "text": "感觉比刚得知选角时想象的还要契合，\n这个角色非常适合翔真先生。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000037:dialogue:000": {
      "source_hash": "sha256:eed5a1a192584d8132e3469d9cee2497f7d45e5ff33932cc2f980f0bec4c15d1",
      "text": "听你这么说我可太高兴了。让我更想\n把这个角色演成自己的代表作了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:c7183ec3eaeeb685a04b638541a38f7c8b53deb67db9adc1c3c9a955047ca5d0",
      "text": "翔真先生的粉丝们\n肯定也会非常高兴的。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000046:dialogue:000": {
      "source_hash": "sha256:bffccc3f18720e08074000f5416c0b8e4dd000a501f075ef45f67ea67d570778",
      "text": "呵呵，粉丝们在社交平台上讨论得很热烈吧？\n我一定会回应那份期待的。",
      "status": "draft"
    },
    "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000049:dialogue:000": {
      "source_hash": "sha256:d695f214e0679d892033e3b4796e03fcf316350f742e9a21d59935aff8ac4da9",
      "text": "为了让更多人看到这部电影，\n我也一定会全力协助的。",
      "status": "draft"
    }
  }
}
