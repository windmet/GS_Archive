{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_005kao_1_7_005_01",
  "source_raw_hash": "sha256:8e6c98e7a7fbb7d379aeb01ae49315f1df8536956c9ddff7593f95857c09c96f",
  "entries": {
    "story-text:v1:1_x_005kao_1_7_005_01:1_7_005_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:73365f71cf4b70fa9d64d1ecdd7639882374cb4c5b976097507f6a736ba9bed3",
      "text": "●●●●プロデューサー，\n关于接下来的工作……",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_7_005_01:1_7_005_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:754a0a265099e398385c0c86c98dadcd2801a1efaafc2693b2a630b6638a7f55",
      "text": "不好意思，在那之前能先打断一下吗？\n薰先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_7_005_01:1_7_005_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:584fd48bbd6c0aa20bbd376cf5641c534932a1fd51855afac55dd66da8f63109",
      "text": "哈？生日……\n说起来今天已经是9月24日了啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_7_005_01:1_7_005_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:78fffd6ee93f4bb5c60514b0cc2abb54bf5f44063f9fcd5ee1c445de10f1f069",
      "text": "我以前并没有什么让人庆祝生日的习惯，\n所以都给忘了。",
      "status": "draft"
    },
    "story-text:v1:1_x_005kao_1_7_005_01:1_7_005_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:2df6e30a2e8cd74863d9aecae59638b05960b9f0d298ae670b189d4d4ed12f9a",
      "text": "不过是徒增年岁罢了，\n虽然看不出有什么庆祝的必要……那个，谢谢你。",
      "status": "draft"
    }
  }
}
