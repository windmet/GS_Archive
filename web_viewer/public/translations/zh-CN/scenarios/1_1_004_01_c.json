{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_01_c",
  "source_raw_hash": "sha256:2c369236be1af07d28e847ee252657c5321b4ec37bdfc39f2001f8fb0916c776",
  "entries": {
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000029:dialogue:000": {
      "source_hash": "sha256:99e6da28b9f3e3eea5b3f132e8cc8cfdc0e4a8ffd9ed7efb9318d3d005ee4894",
      "text": "我非常喜欢\n生我养我的这个国家。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000033:dialogue:000": {
      "source_hash": "sha256:83603507b79b4e3ec8330c75307744f131d813f82f1256424e0ae9f2cd5b9240",
      "text": "如果可以的话，我不想离开。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000036:dialogue:000": {
      "source_hash": "sha256:5fa1d2b4f7eaf4b923f2cd28f9809d1557e74576a27ae48fb8a0cd3d703c74ef",
      "text": "皮埃尔大人……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8418cf6c7cf9dfb497625b7398e2f3ac73448a5e9cb4f910e862b39708826ebb",
      "text": "可是……只要拥有王位继承权第三位的我\n留在这里，纷争就会变得更加剧烈。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000045:dialogue:000": {
      "source_hash": "sha256:ad1240642a7980e7bced276ff4155f7456115e926fbf8e063ae2de4c85d49f32",
      "text": "没错吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000050:dialogue:000": {
      "source_hash": "sha256:88d7caee33809085755b2aea1f80976b048aad5b7ca6c00cb84e5f9d9d0a9d7b",
      "text": "……是的。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000055:dialogue:000": {
      "source_hash": "sha256:e8d2fc84f53763b2aa7b2ec6071c018d0061936cd868478968f971bdf0bc7a4e",
      "text": "母后曾经说过。\n日本是一个洋溢着笑容的绝妙国度。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000060:dialogue:000": {
      "source_hash": "sha256:defeee7ac6525a6147e8ea8ed5cffcdc979ed0ac9a30691db7ff0607f9c25065",
      "text": "至少没有像这个国家这样的混乱，\n是一个公认和平的国家。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000065:dialogue:000": {
      "source_hash": "sha256:511315630ccd2481b7dedd0a1c26fb357c947011cf0ec7204fdabd791c2ba5a7",
      "text": "那么，我想去日本学习。\n去学习为了和平，我能做些什么。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_c:cmd-000071:dialogue:000": {
      "source_hash": "sha256:43f817ddaac795a4ddb4a5c0541e65e16b40e108a5c7b855b063ae23f91aea98",
      "text": "……走吧，去日本！",
      "status": "draft"
    }
  }
}
