{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_042_23_5_02_042_23",
  "source_raw_hash": "sha256:8e1ccd40274ca59ff9c79127301d5eede89028361dd4c3ad8ce8d9e61a49c731",
  "entries": {
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000017:dialogue:000": {
      "source_hash": "sha256:24a2320eaae2cc4269dc90018a26dceab1009af7d94e4e2f59d4da56e75905ef",
      "text": "●●●●●●●●●●Boss，辛苦啦！\n俺带了推荐的点心过来了哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000022:dialogue:000": {
      "source_hash": "sha256:86b07a1fbf454cb71190738b5623808054929f6d2f1c7692950ac60f2fc60544",
      "text": "今天不是白色情人节嘛？\n俺特意准备了想让Boss尝尝的好东西呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:12e0ffa6421d4534fac431590c45430bb578a9008740c05c53bd9e3a5c60cc6f",
      "text": "非常感谢，大吾先生。\n看起来非常好吃呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000027:dialogue:000": {
      "source_hash": "sha256:e52d42a92816f2ad57651b3fa97b5c8518b5e869845a85e2e5ba65a1e2640f98",
      "text": "嗯，超好吃的哦！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:f4e2f1a05fa6a7b3eb6934f75db9376c35f2b947a41e4fe9a1b5b678d33ccfdf",
      "text": "俺是从至今为止吃过的点心里面，\n挑选出了最想让Boss尝尝的好东西呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000038:dialogue:000": {
      "source_hash": "sha256:9825d44b3fb8e7e83c0b43e81817640e549a7a882eee5f4c634473163f156ad0",
      "text": "只要吃了这个，\n肯定能露出满分的大大笑容啦！",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:96cf2abe710ee36af63e7be3107152043e7339d1d2c95a2d23d1be5a23a19e06",
      "text": "光是有你这份心意，我就已经是满分笑容了哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000047:dialogue:000": {
      "source_hash": "sha256:bd7b10811d70c2f2f7e6f4feb469a5d789abb3053ee5203b49e6ba7bae51d6e1",
      "text": "哇哈哈，真的呢！\n看来是早早就大功告成了呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:7b2ca334fac6b5a0046d6346e1ef7055aa1c0d38c3878cc56d2ae9b72efd8fcc",
      "text": "点心，我现在可以尝尝看吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_042_23_5_02_042_23:5_02_042_23:cmd-000057:dialogue:000": {
      "source_hash": "sha256:5fabcd33f7e4da61359c0133a46c26218f0a1e64209364fc385328f71f91e796",
      "text": "那是当然啦！俺倾注了满满的热情，\n要是能好好传达给Boss就好了呢——！",
      "status": "draft"
    }
  }
}
