{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_008rei_1_7_008_01",
  "source_raw_hash": "sha256:930731ad781458059d631122b16393de0a54e6f1292320aaa10b5a5efc6d30ba",
  "entries": {
    "story-text:v1:1_x_008rei_1_7_008_01:1_7_008_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:8b15b15d8c6c78093a601206d3b9146d3e5c1b4a946bde8c80d81a4da22f2d15",
      "text": "丽先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_7_008_01:1_7_008_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b71b37293589570bd88c7fdb103fa004776000a401b36985ed69b4facab59a57",
      "text": "……啊，你还记得我的生日啊。\n谢谢你。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_7_008_01:1_7_008_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:1701a2957ee1f98c4a2f24ab7e30e4232af2ee1621770a92adbb08fae36e2f8d",
      "text": "像这样能被家人以外的人\n庆祝生日，心里确实很温暖。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_7_008_01:1_7_008_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:69e1d9c7bbbc4877f8f8cfde26e6df745cd4f213187b1cc98ccfb437e48386ae",
      "text": "今后作为一名偶像，\n我也会日复一日不断精进。",
      "status": "draft"
    },
    "story-text:v1:1_x_008rei_1_7_008_01:1_7_008_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:8b0eb9a93c14d2df10d21c72067443225976471c03de09b48db054cbb6651467",
      "text": "虽然我或许还有诸多不成熟之处，\n但今后也请多多关照了。",
      "status": "draft"
    }
  }
}
