  "entries": {
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000011:title:001": {
      "source_hash": "sha256:7a974f2b49de77bf8f04fe16204029f036bbe452c423a74ef23874de89ae369d",
      "text": "出演历史节目情景重现剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:4da8122cc5f7a6449449b88e451bb0e77ce690405ce1c6f8b7db23fa95e88ac5",
      "text": "原来如此，走到这里的话，对方就没有退路了……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:20f1dfb0607f6adbb249412eb1c75e810d24f2a18c7e19d7cd4e102b70395252",
      "text": "辛苦了。……直央君？\n你这么认真地在看什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:9d1253ca3b6f72bc99e2e32cc7ef20564df550b38fd1383edcb072f573559796",
      "text": "啊，辛苦了。\n这个是将棋的棋谱哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:260c6a5f225d6e01d949edcacbdb70e3fbd1bbfd2ac0ec2e8eacd4df6838f41a",
      "text": "之前接到了出演历史节目情景重现剧的邀请，\n所以我想着重新好好学习一下。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:1ac4977acf606441d33abbb8e67ea822cdaa5a9eb937c76ddbb63b1057382f0a",
      "text": "原来如此，直央君真好学呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000044:dialogue:000": {
      "source_hash": "sha256:21bfde2c6d6578187daee2f382799a6fdc8ed26f3b4509296f6aa42e4419ac33",
      "text": "这次直央君饰演的，\n是昭和名棋手的童年时代……",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:9d602a2c7c46f3f9e739b7fe26ce032fa39566155a4e0fb92848663d8ea7d8e9",
      "text": "听说至今都是非常受拥戴的棋手呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:9acd784abdb811f48504eb7e5d91414cd2e78a0a281118148bb145c2ad8c512f",
      "text": "是的！能饰演这么厉害的人，\n非常荣幸。",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000054:dialogue:000": {
      "source_hash": "sha256:f1dc39dfb6e80a977dbf9045b6245cdb86e107b1fbc630106438d3185a01941c",
      "text": "我非常喜欢将棋，\n所以这次的工作真的很开心。诶嘿嘿♪",
      "status": "draft"
    },
    "story-text:v1:1_5_032nao_1_5_032_02:1_5_032_02:cmd-000057:dialogue:000": {
      "source_hash": "sha256:145bc08ce651d66b53b6625f86b2adfee70175c1294ca86db326814e6c2a5a25",
      "text": "呵呵，直央君会怎么演绎，\n我很期待哦。",
      "status": "draft"
    }
  }
}
