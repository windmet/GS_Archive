{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_016_01_d",
  "source_raw_hash": "sha256:e5b4ebab726af50588b364cb9f4883ddbbbfd3fa1d0a2039dce122a7161f23e4",
  "entries": {
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000010:time_caption:000": {
      "source_hash": "sha256:adccf2e7a9d6877929d428cd50978c115e1c86ba75b63f3fad0ebed9ebade248",
      "text": "事务所·休息室",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000021:dialogue:000": {
      "source_hash": "sha256:cca2795b8d1d8bb7103e9647f3971f2e9717f2eec71c074f7024e827fe611f68",
      "text": "我做成了儿童套餐的样子。汉堡肉配\n海鲜焗饭，还有松软鸡蛋的蛋包饭。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000023:dialogue:000": {
      "source_hash": "sha256:c4a479fd349c43b351e04adc5aff3b6a499974535393d80b8f9e3651b1423f6e",
      "text": "每一样看起来都好好吃啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000030:dialogue:000": {
      "source_hash": "sha256:044658eb6f39eb2098db0543e26bc75cafec66d172da7d56b7ca0bee3f9a28c5",
      "text": "每一道料理里都混入了切得很碎的青椒和胡萝卜。\n来，尝尝看吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000032:dialogue:000": {
      "source_hash": "sha256:c87c061ec9b5c2359d270e7d375e9be99859d57fabec256b77b72dc9d2a4daa2",
      "text": "那么，我开动了。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000043:dialogue:000": {
      "source_hash": "sha256:e19c5742e65abf273a450a6c326b16ede9f20dbfda3ee93730ac0ab95da200ee",
      "text": "……味道如何？",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000048:dialogue:000": {
      "source_hash": "sha256:8ed6722565611bede352eb7c1e8c1c39aee6b9e8143824196dfcd4d908e51bc3",
      "text": "非常美味！如果不说是放了青椒和胡萝卜，\n根本就吃不出来呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000052:dialogue:000": {
      "source_hash": "sha256:d820b62c2cd49605279885fa6ab37a43e73dbd351bc13787be71f45f6bde44cc",
      "text": "是吗……！\n那太好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000057:dialogue:000": {
      "source_hash": "sha256:8c5d37ad1f8e807044c44b1b3a5e26c06ea09eff206f68e9f9d6e3df40cfde73",
      "text": "这样一来，要是天音能克服讨厌的蔬菜就好了。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000059:dialogue:000": {
      "source_hash": "sha256:b44c4c7180e11981521d426b58924d3666eddf1c919654ac7570b5c9e7052e07",
      "text": "请对自己有信心。\n诚司先生也尝尝就知道了！",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_01_1_2_016_01:1_2_016_01_d:cmd-000068:dialogue:000": {
      "source_hash": "sha256:ffd8f81f95f20d5ef665b71349459b81b817f3442b35dd9fa8880cc831a0703b",
      "text": "不、不用了，我就……",
      "status": "draft"
    }
  }
}
