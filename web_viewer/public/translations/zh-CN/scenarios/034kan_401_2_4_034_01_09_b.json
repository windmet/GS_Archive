{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "034kan_401_2_4_034_01_09_b",
  "source_raw_hash": "sha256:488bcde86636dac9bb3c0282c410bb33bb741573b7abdadd72850c33dce77868",
  "entries": {
    "story-text:v1:034kan_401_2_4_034_01_09_b:2_4_034_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:644e0194407fe74f511735daffc51e78c8f0beda22b2ed91cc06797b0e834b12",
      "text": "辛苦了，制作人。",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_b:2_4_034_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:422344be9486524f8104530b7b826a185a82980cd74d9042b107d1a5d53679dd",
      "text": "今天的拍摄超级开心的♪\n那个，刚才没能问出口，",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_b:2_4_034_01_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:ea2d0a388c2ee2ceed2ae1bdb3c966044da1f5a744a042443456ed762da0583a",
      "text": "和平时不一样的花音，感觉怎么样？\n有成为帅气的怪盗吗？",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_b:2_4_034_01_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:154611d2f62dda7edf2735194a4bcc35c82a5c1d9290f2e5cc0502222ed90cd3",
      "text": "那当然了！",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_b:2_4_034_01_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:f30e54dfb1e0721f6f83ec42b4b71f2cd923ef3506c5f5b44d6560797ded9676",
      "text": "太好啦～！这样一来，花音帅气的工作\n也没问题了吧！交给我吧！啊，不过不过，",
      "status": "draft"
    },
    "story-text:v1:034kan_401_2_4_034_01_09_b:2_4_034_01_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:2914ee39d01c5c9bbbffce7fedecef234d3a1726b500844dc75fc2d4eeb78b23",
      "text": "下次请给我安排可爱的工作吧——！\n为此花音也会努力的！那就先这样啦！",
      "status": "draft"
    }
  }
}
