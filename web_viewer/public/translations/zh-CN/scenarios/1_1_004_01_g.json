{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_01_g",
  "source_raw_hash": "sha256:2c369236be1af07d28e847ee252657c5321b4ec37bdfc39f2001f8fb0916c776",
  "entries": {
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000021:dialogue:000": {
      "source_hash": "sha256:efba021d82112e9b1cb6a5f4f70134390ee115dc330440585c9ad63ce212d8e9",
      "text": "那么，属下就在这里恭候您。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000024:dialogue:000": {
      "source_hash": "sha256:5e9689f554ddaed37865fcb4b844fafb9efe42041aeca0779c15e3ebff4f7f78",
      "text": "嗯！马上就回来。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000046:dialogue:000": {
      "source_hash": "sha256:9b7c7bfecf61d6ce8bd1736b02b1b25807aa69e2e0e1d4b4ac79e35969481235",
      "text": "（……太好了。\n要是露出这副表情，大家会更担心的）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000054:dialogue:000": {
      "source_hash": "sha256:7b467919549c45fbd28f29ed2c26beb30163f229ee602193b5fb284f567140d3",
      "text": "这边，这边！快点——！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000057:dialogue:000": {
      "source_hash": "sha256:383061c600c8f1e4f637c0d750fc35e455c08ed8d09c1fcf564cb9455a093e50",
      "text": "哎呀哎呀，别急。\n游乐设施又不会跑掉。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000059:dialogue:000": {
      "source_hash": "sha256:2b2d0c9726c62d4794e4484bae319b59c94619fd2d27ffbee8c5119d8b3b601a",
      "text": "好——！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000068:dialogue:000": {
      "source_hash": "sha256:d960e6b6fe51fc8419081baa4ec7d5fdad11ecbedabb07bec1150323d3653e91",
      "text": "（这里洋溢着这么多的笑容。\n可是，我却……什么都做不到……）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000077:dialogue:000": {
      "source_hash": "sha256:98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "text": "……！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_g:cmd-000081:dialogue:000": {
      "source_hash": "sha256:1b140b0488838e14dfe94a84dd14ed2951517416d8369fb070d906a55322a610",
      "text": "哇……！\n好、好大一只熊……！？",
      "status": "draft"
    }
  }
}
