{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_046chr_1_7_046_01",
  "source_raw_hash": "sha256:ed51a0308147a21f87582cd0e13dd639d8821cc8957b0813ecc4755f709a5dfd",
  "entries": {
    "story-text:v1:1_x_046chr_1_7_046_01:1_7_046_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:6d0d1b9dc47c6e3a4801049d9db166282a92658966b07202836a1494103a76d7",
      "text": "克里斯先生，今天也是您的生日呢！\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_7_046_01:1_7_046_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:6af74fee4d293ec3d25518a3fe8a57131b6cb0eb24c9faa457c4dc8f7239774d",
      "text": "哦哦，没想到能承蒙●●●●プロデューサー\n为我庆祝……！",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_7_046_01:1_7_046_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:158372db73fcce09d835e322f856ae0da37eef0fe0c7431139d9032e6dc139d8",
      "text": "非常感谢，\n●●●●プロデューサー。我真是太高兴了！",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_7_046_01:1_7_046_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:6530eefe4bfbf8bd3f2fb3c575bc2ffeeb240bc3f6a4645d142b6206c529c00b",
      "text": "那个，如果您有时间的话，\n能让我跟您聊聊大海的事吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_1_7_046_01:1_7_046_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:8e05266549cc8f5387b7976992eddb70d0b5ac26085ba556d0d9633d48fa2d41",
      "text": "我很想让您进一步体会到\n大海的奇妙与美好！",
      "status": "draft"
    }
  }
}
