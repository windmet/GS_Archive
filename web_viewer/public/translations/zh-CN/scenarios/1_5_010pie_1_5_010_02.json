  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000010:title:001": {
      "source_hash": "sha256:67e048ca871255403d6d7f4e8144aa523c671b00bf27c2564bd1e286fab74cc9",
      "text": "动画电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:27618b94634a0d7068464c77274b0c932af31867f060f7a95cf14c925ba6c9d7",
      "text": "录音马上就要开始了。\n皮埃尔先生，准备好了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000022:dialogue:000": {
      "source_hash": "sha256:c2ef432027a92c112d4fdbef14ec91d060c68fe9349e870984b0bc11fe2f0f73",
      "text": "嗯！准备，完美。\n我、好期待今天的录音。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000027:dialogue:000": {
      "source_hash": "sha256:4ff14c41a0ddc7c4ac6120c2b340081f33336b77a228c17ccc34a55ec069a7cb",
      "text": "是奇幻动画，演精灵的角色。读了台本，\n心里暖洋洋的。故事，非常棒！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:faafe59c453ff60c9909e49fee5b67f21310b0755dd661b4f20ce8e11a3ab1c5",
      "text": "但是，只用声音演戏好难。\n恭二和实、帮我一起练习了。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:464751d8b3d8159a92df99a354541931446892c4f3d0cc12265fb383dab512d9",
      "text": "●●●●プロデューサー，\n也帮我了。所以，没问题的！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:47262836f5b08f9506e7398a4023deb05057292a6ae0cfe95c07b18492538ed5",
      "text": "嗯，皮埃尔先生的话绝对没问题的！\n我会在录音棚外面为您加油的。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000051:time_caption:000": {
      "source_hash": "sha256:4f10f377623d30a2f8e6eef9924c2cd8b7962dcbd80ad5f1e46aca35a570d7f4",
      "text": "录音后……",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:8534608906e0c5beeb1fc4af094dc0b36e34003a7d923107d48d7c370bae98b4",
      "text": "辛苦啦～！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000059:dialogue:000": {
      "source_hash": "sha256:7929fdfdd57fae418d02ef09e3cee22e1ce62560d62203eb6cd6cea9f6d66d2d",
      "text": "皮埃尔先生，辛苦了。\n练习的成果展现出来了呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000066:dialogue:000": {
      "source_hash": "sha256:6d2eab0d980ce42b67014339de5c1592894750bd397ba52592e2ddd7e7c265e7",
      "text": "呀呼～！很顺利，多亏了大家。\n也要向恭二和实道谢！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000070:dialogue:000": {
      "source_hash": "sha256:0ae7f8991575e26a3ef8e0f258d78715694d191c59cb16216a5887619dc68652",
      "text": "●●●●プロデューサー，\n也谢谢你！",
      "status": "draft"
    }
  }
}
