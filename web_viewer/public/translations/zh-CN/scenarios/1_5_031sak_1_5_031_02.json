  "scenario_id": "1_5_031sak_1_5_031_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000010:title:001": {
      "source_hash": "sha256:a59993df01b60237c05ca9d1ac637e5d5c1ffb5726a0a0a7b4878b981dca62ee",
      "text": "出演青春电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:da065d2fcdac989d0117bcdf196c0ec9a92be57dd8df79008733af96e8ca44f5",
      "text": "哇！要在这所学校拍电影啊。\n台词我也记得滚瓜烂熟了哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:4bd85fb931ef76ec316a002edd5d2727943e013b3cd78e10dd16642207cb23d1",
      "text": "这是一部改编自小说的青春电影，\n读完原著感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:ff28dcddaae45d5d6a27c0dda02759becbe3243e2e17de79e079e3b268251f66",
      "text": "超级有趣的——！\n读到我演的那个角色的登场场景时啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:e8f8170f39ba941e447e497b0b9208d5b298f2f7e906af32c7ff3a0b58ed5c9e",
      "text": "一想到接下来要演这个孩子，\n整个人就心跳加速、兴奋得不得了。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:0f31ba94407f1ff7ba5b545cd291db243cea27ba1bd9b4f498ea73688a40cf29",
      "text": "而且啦啦队的服装也好可爱呢！\n还有制服也是！好想快点穿上啊～",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000050:dialogue:000": {
      "source_hash": "sha256:a7edb731ced951b44b2a10273013554d631c304b4fae374d0a627dfc5e422e76",
      "text": "在那之前，先去向工作人员和\n共演人员打个招呼吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000054:dialogue:000": {
      "source_hash": "sha256:fbd85f3e0b3a60ea3895de31e92e260b008a97be0f00364bf5a7c002bf62a372",
      "text": "毕竟自碰头会和对台词以来就没见过了，\n我也一起去。",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000061:dialogue:000": {
      "source_hash": "sha256:9c015f180561c526ef7299fafc14364c6d594f4458dd3972647ff38b56bbd976",
      "text": "啊，对哦！打招呼很重要呢。\n那我们干劲满满地出发吧♪",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000083:dialogue:000": {
      "source_hash": "sha256:84ec84da680ec75aee50f31a8b15a21ee420b9769da42c314af907c99169d159",
      "text": "水岛咲，超绝登场！\n我一直都很期待开拍呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_031sak_1_5_031_02:1_5_031_02:cmd-000089:dialogue:000": {
      "source_hash": "sha256:66a64bc02322cc031f1c7a9cea1a1b35bf91e08e4c5f629a52029b81530474e4",
      "text": "我会全力演好的，请大家多多关照啦♪",
      "status": "draft"
    }
  }
}
