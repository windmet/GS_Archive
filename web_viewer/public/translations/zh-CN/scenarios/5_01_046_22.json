{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_046_22",
  "source_raw_hash": "sha256:34b4918c6c020d87546f724242657d7906785280bc57c9fcb5935da0755834f7",
  "entries": {
    "story-text:v1:5_01_046_22:5_01_046_22_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:26b6197a70dc67505e295e9910b21dcd81eaa4060b342d3b7de2fa836dea7ebe",
      "text": "这是……情人节巧克力吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:f732e613f2a8c0ebde692b5e508dc16aa0aaa8c371e57bdbc1a9d066c3b742d9",
      "text": "居然……！\n特地为我准备，非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:dee43498e7b24e6262e5fe6bb88a15ca05f90f46fda3e795de5860b48b3c27df",
      "text": "简直和邂逅雪袖鱼的幼鱼时\n一样令人喜悦！",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_a:cmd-000026:dialogue:000": {
      "source_hash": "sha256:fe10d3e23681d2dfa46a7c7f0280177fd4a921dadf36e7a2740ceec1b36b69c2",
      "text": "这盒巧克力，我会在今天外景的休息时间\n品尝的。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:06b1a81d34b0f015adb67116fcfc259637f1947af4ae26b8ec3bd52ccb534781",
      "text": "那么我就先出发了。\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000013:dialogue:000": {
      "source_hash": "sha256:1bd72c0ed1342000077a4c8d5eda44b23920431b9a577fed1654ceab2baba9b3",
      "text": "这是巧克力吗？\n说起来今天是情人节呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000017:dialogue:000": {
      "source_hash": "sha256:49e291b0c26d978f3428f4d7f01c2753c6fee411e043917549987204e01c6113",
      "text": "非常感谢，\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000021:dialogue:000": {
      "source_hash": "sha256:384e6659bff4aa21a6f7eecd4b95d10431f51a15ead625bdd712eabae38ac30b",
      "text": "能为我准备如此美妙的礼物，\n我感到无比高兴。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000024:choice_short:000": {
      "source_hash": "sha256:eeda7289fb40e8ea09abc2605be7d240def49db26444dd8265535df813f84c96",
      "text": "我挑选了感觉克里斯先生会喜欢的种类！",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000025:choice_short:000": {
      "source_hash": "sha256:90e4867b69474de7f8e7434861e1264e3aa2a8cffe8bb9ecd698042419b009c5",
      "text": "感觉您一定会喜欢的！",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000028:dialogue:000": {
      "source_hash": "sha256:87a36ea998a68d030ac268167d254a51b850786d4ee9fff04ce48a48c0917f7f",
      "text": "光是这份心意就足以让我十分欣喜了。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000035:dialogue:000": {
      "source_hash": "sha256:2fc3359bc94ae8f5664746bafea8ecd761e744b773b1258f2880b3c1b17799d6",
      "text": "发现新大陆的先驱者们，\n想必也是怀着这般心情吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000042:dialogue:000": {
      "source_hash": "sha256:c949f2ce8400920aa006ba5a371b81f80bf27a4faaf7a6c351ab971c60ddb3e4",
      "text": "我会一颗一颗仔细珍惜地品尝的。",
      "status": "draft"
    },
    "story-text:v1:5_01_046_22:5_01_046_22_b:cmd-000046:dialogue:000": {
      "source_hash": "sha256:a84d07f34eed1cacf875f167c1411b0e29a34525e3fa14a9c91aaab4cc12e732",
      "text": "这份回礼我一定奉上。届时必定备好足以将我所体会的感动\n传达给您的礼物。",
      "status": "draft"
    }
  }
}
