{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_009kyj_1_7_009_01",
  "source_raw_hash": "sha256:3d75a2450070fdeae3fb105b038116a3b857eabcde19c11c126a035ec9ccea95",
  "entries": {
    "story-text:v1:1_x_009kyj_1_7_009_01:1_7_009_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:a51dd76d265db6c7f5c7dfc0d3d2176fdab1167be8e561b9055fab9dcc6650de",
      "text": "●●●●プロデューサー在吗？\n我有点事想找你商量……",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_7_009_01:1_7_009_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:515167e6eed97958d5260e1607dc4ff81ce3897144b2d3ed3731695c7a951b17",
      "text": "在的！啊，恭二先生，\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_7_009_01:1_7_009_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:8a4a0a00c57ab87d86eb6303c5022e630d9b2456ea4688ba4f8b43a6f2752fd6",
      "text": "哎……生日……？\n没想到你还会给我庆祝。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_7_009_01:1_7_009_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:3f6f76d18fd4c66103674f6504f86d0dfd64f57de8e12f5e7a3b247933de4aed",
      "text": "该怎么说呢……能被人记住生日，\n感觉挺不错的。",
      "status": "draft"
    },
    "story-text:v1:1_x_009kyj_1_7_009_01:1_7_009_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:56cdceebe2811a247ff434225b8918c2a225b0711313bc7ce69807a94e4cef5e",
      "text": "那个，谢了。\n我以后也会继续加油的，请多指教。",
      "status": "draft"
    }
  }
}
