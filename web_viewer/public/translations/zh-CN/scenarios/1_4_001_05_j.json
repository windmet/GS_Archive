{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_05_j",
  "source_raw_hash": "sha256:8acb6236973032f28f8aa1057958f2eeb58e3dbb1584feecf1dbc9e65243f01e",
  "entries": {
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000030:dialogue:000": {
      "source_hash": "sha256:ba866912b51e6e6385fd4535a7e713fe73a703cd09a9b6efd26552c2ed6bd55f",
      "text": "（我……一定要出战JIF，\n绝对要和他们重逢！）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000037:dialogue:000": {
      "source_hash": "sha256:b2d4e3990069e441d7825e49cd379f4738ac92b636180c01da74afbd980c613d",
      "text": "（为了住在大楼里的大家，\n我必须赢下来才行！）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000046:dialogue:000": {
      "source_hash": "sha256:286f133198360ef6f78f2bbc499fd9f8073e1d8c0bbed14e903ffa8309461751",
      "text": "（本大爷才是最强的……无论是小不点还是这家伙，\n我都绝不能输！）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000059:dialogue:000": {
      "source_hash": "sha256:8ff52e9f48c6e8cae1ed278d71663b7733def0c90d33e2405a555bb070d859d1",
      "text": "加油啊，THE 虎牙道——！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000076:dialogue:000": {
      "source_hash": "sha256:f8f477d2575eaf9887162f7a8ad01229f9abbb75ae05dc3a953f188b59aa876b",
      "text": "……没错，我们怎么可能在\n这种地方停滞不前！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000139:dialogue:000": {
      "source_hash": "sha256:1604ac82b475f13157394eaef650c493db1577c650933df1b8374b35c8032b19",
      "text": "唔……！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000167:dialogue:000": {
      "source_hash": "sha256:de5fcfadeb93d08995afa6e0fded8d234b341d5db509a7ba724b8073453b8f38",
      "text": "咕……",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000205:dialogue:000": {
      "source_hash": "sha256:f4f98eaa981c630d0ccfb1a26df8f2458dffc67d0dcd988b5592d43adad92a99",
      "text": "糟了！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000222:dialogue:000": {
      "source_hash": "sha256:14926d0e06b510bf515122103745ab3254d6da79a86174204f0e25d84f29642e",
      "text": "上吧，武！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000235:dialogue:000": {
      "source_hash": "sha256:c3135d45417ac312d919378308729eb95602e6bb90bb6fda2bd7f48c9fdecf19",
      "text": "哈啊啊啊啊啊！！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000243:dialogue:000": {
      "source_hash": "sha256:cfbefc2e06af4d7484d470bd4e6c77d1d7a059ebaf477c2060bb45debb4a03ec",
      "text": "！！\n这一击……挺管用的啊。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000253:dialogue:000": {
      "source_hash": "sha256:34e2dd38b86cbdb2cf76d70073814eaa35cb738ccf5d79ac26363a2359fc5db6",
      "text": "胜者！THE 虎牙道！！！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000270:dialogue:000": {
      "source_hash": "sha256:b52b436006ffed7840d09aaecc0d21002998e3d54f4b72adfa04e510309d750f",
      "text": "雷皇先生，手给您……",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000274:dialogue:000": {
      "source_hash": "sha256:4e6e1792b5de775908cdba0701dfaac046a19b72d013d3820cf69de7ce761c58",
      "text": "抱歉啊……嘿咻。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000289:dialogue:000": {
      "source_hash": "sha256:2348a25aac305e8550e607432ce066dee7ecc42558fa745fa6734d92081a1644",
      "text": "库哈哈！见识到本大爷的实力了吧！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000296:dialogue:000": {
      "source_hash": "sha256:70dfef028d20091b8d12ecb921e60c8061bcc3f7a811c8fbc2ef2f1b5542fa9c",
      "text": "呵……你们作为偶像，\n或许确实还很不成熟。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000301:dialogue:000": {
      "source_hash": "sha256:4400601065c3d6fa8547a302f5373d095e3bed8fb883c7ee6087e3ef558cab7e",
      "text": "但是……挨了来自偶像如此强劲沉重的拳头，\n我还是第一次经历！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000307:dialogue:000": {
      "source_hash": "sha256:8dac67eb7b6cbf6114c66e653d60cff17c956f59e95d171a477f08c38e969f1b",
      "text": "最重要的是，最后你们的配合让我由衷叹服。\n……很好！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000315:dialogue:000": {
      "source_hash": "sha256:5efb1425b6495d1738943ff027c9dc5c12767a1d84aef2dbe1e90b21f1b8460d",
      "text": "我来推你们一把！\nTHE 虎牙道……去出战JIF吧！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000318:dialogue:000": {
      "source_hash": "sha256:c588cd8672210682a5283ab106c6790d9215979b897e20f7866b76909b7fbe22",
      "text": "喔喔喔喔喔！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_05:1_4_001_05_j:cmd-000325:dialogue:000": {
      "source_hash": "sha256:c3e9b218d02bd3ec1ca2db196c755e2973660f28af910412bd8b8a5031ac27fa",
      "text": "（赞助商的推荐……！\n这样一来，距离JIF又更近一步了呢！）",
      "status": "reviewed"
    }
  }
}
