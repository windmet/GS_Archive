  "scenario_id": "1_5_001tom_1_5_001_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000010:title:001": {
      "source_hash": "sha256:17c1859b3ed4536bfab0f5716beb030bcd706e62a531e2aeced626da9aaa0993",
      "text": "体育新闻节目外景记者的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:27e6c6219bceb05599768a225278d1efbc7387cb130792a540b1d4a6af5d3ba3",
      "text": "今天的录制主要是介绍选手对吧。\n我一直都很期待呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:b3ff790de2739a817b0e83aa81f3bbffe73b6a83a415d5029b4f8437321f7151",
      "text": "喜欢那项运动的人虽然会去了解每一位选手，\n但平时不看体育的人我想就不会做到那个地步了。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:40514c9adadbde2f1f0360fcf305a4fbfaf38124daaa6c6211d771e9cea826f0",
      "text": "所以啊，能把选手的魅力传达给\n那些不太深入了解的人，我真的很开心啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:f9fe511f9ddcd1b16875ec1c83afe7170d626bb01fe47517735ad9cbdce02e56",
      "text": "了解选手之后，对那项运动的理解也会加深，\n观看时也会变得更开心呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000029:dialogue:000": {
      "source_hash": "sha256:9ac9fa816d0ad527e9734f16519f91172efc5d1ef210171f6a5be6552cd36124",
      "text": "对，就是那样！\n绝对会比以前看得更起劲！",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:b6747611b73066134716ca63e6144fe840b162defc6a4a101b982152cc1c6d9f",
      "text": "嘛，虽然只要懂基本规则\n看体育运动就会挺开心的就是了。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000038:dialogue:000": {
      "source_hash": "sha256:7cc2c5d7da9c659b7e19d7287036ce7fafafef9108ebbb4cf258cd0dd642f17f",
      "text": "即使如此，果然还是了解选手以及过去的\n对战结果会更能乐在其中，该说是这样吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000043:dialogue:000": {
      "source_hash": "sha256:5c7416c553ebdcc04d441150cd6ed76633544785a08cbca5f787891308b14a79",
      "text": "要是以这个节目为契机，能有更多人\n用这种方式去享受体育，那就太棒了！",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:e794621698754268bc6d3765f4208c375a7e2299e33a2ec88259141c36f69baa",
      "text": "我会做出能让大家产生兴趣的\n报道的！小菜一碟！",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:9d7443265739d6065da2047da9453a030d9ac798b1edddd4fa10480ef46f51ca",
      "text": "好的！\n请加油上吧。",
      "status": "draft"
    }
  }
}
