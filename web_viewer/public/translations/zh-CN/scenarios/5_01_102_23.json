{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_102_23",
  "source_raw_hash": "sha256:3c0b0a6519ef4701f98c04d364edb33f997aa50fed2f77bdc9cd007eb4273e78",
  "entries": {
    "story-text:v1:5_01_102_23:5_01_102_23_a:cmd-000009:dialogue:000": {
      "source_hash": "sha256:4ce6e959893b1665586f6ca8cab9602770025387a77ad00ef946fbfaa98fa8fc",
      "text": "没想到你今年也为我准备了巧克力啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_102_23:5_01_102_23_a:cmd-000011:dialogue:000": {
      "source_hash": "sha256:8930e6ff865a5d0251430de4c034e686b8031fb13d49a5481e5baec9701d7fbc",
      "text": "谢谢你，●●●●プロデューサー君！\n你的热情简直铺天盖地般传达过来了！",
      "status": "draft"
    },
    "story-text:v1:5_01_102_23:5_01_102_23_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:c4d391015512b1572336bce8f8f674c884f21e03dd9ff33e386007d04c9dd98b",
      "text": "这一年来，你的热情看起来更加高涨了呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_102_23:5_01_102_23_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:a8eb6eae9d77e97579477a4714fa91b2cb5e431140357a423728ffce3288d4d9",
      "text": "今后，我也同样期待着你的成长！",
      "status": "draft"
    },
    "story-text:v1:5_01_102_23:5_01_102_23_a:cmd-000017:dialogue:000": {
      "source_hash": "sha256:b0b42d100d8b8dac0b64adef58ff0a3e25626b33061bd9c3bed79a825ccd3b39",
      "text": "啊啊，对了。白色情人节的时候，我也会准备倾注了\n我的热情的回礼的！给我满怀期待地等着吧。",
      "status": "draft"
    }
  }
}
