{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "035mco_402_2_4_035_02_09_b",
  "source_raw_hash": "sha256:06cd9f2e76041832200c110038ab4889fe446fe23f0281cb4ca81bb06c5211ed",
  "entries": {
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:6133cf0b4462ab4157fdf18857067faa1a4aecc65fb1c0d7b446aacc5a226bf2",
      "text": "●●●●プロデューサー，我是硲。\n能打通真是太好了。",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:d6fd3db63971b6c82bf96876233a8d1a4fcb1f6b44c691675fc605eb50a4ebe1",
      "text": "刚才，我顺利从山村君那里拿到了信件。",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c06e6bcc697a4e2631ef0a489f119237970125d100ff76be5f55194e469b035c",
      "text": "这似乎是前几天参加烛光制作体验的\n孩子们寄来的感谢信。",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:6a52c747eef8024b7bb00dde20db032004efbf19f6b34b2335046496a6dbb692",
      "text": "关系变得非常好了呢！",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:06f6f878f4058ff6bf4d50fc3e470b1839d1c957e1d9670c6bf248740fa4022a",
      "text": "虽然交谈的时间很短，但他们得知我是偶像后，\n特意查了粉丝信的收信地址寄过来的。",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:f37a8976be84897d41d8cd36df4c409de6a7ffcfad1eeaa3896431100d415d41",
      "text": "教师时代的经验虽有很多派上用场之处，但像这样\n再次获得直接传授知识的机会，真是一种奇妙的体验。",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000019:choice_short:000": {
      "source_hash": "sha256:37213d948ffe69ea3536969a720bd893271116498d382692579d6c3129e9c1d8",
      "text": "能再次相遇就好了呢",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:8fa1b22e41509d33da8a78819736ea3d266797f207e10ad98a52b16759f3749a",
      "text": "他们感到高兴真是太好了！",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:964f206b4522d093d7e0282d080b30f179f76ff10292fda53926fb21bae8e7d5",
      "text": "嗯。为了能给像他们这样拥有未来的人带来希望，\n我今后也会继续精进。",
      "status": "draft"
    },
    "story-text:v1:035mco_402_2_4_035_02_09_b:2_4_035_02_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:58d91026690f38e67aa838b67267cfa70fc2e8253659f9530b3c0cd10996bc1a",
      "text": "那么，回头再联系。",
      "status": "draft"
    }
  }
}
