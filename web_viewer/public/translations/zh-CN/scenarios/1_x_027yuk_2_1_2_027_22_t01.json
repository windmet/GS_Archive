{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_027yuk_2_1_2_027_22_t01",
  "source_raw_hash": "sha256:3069421f6f91ab3a5eddfbc745ea2bf26b869cf116ec9ad70b63cc3b6bd8c733",
  "entries": {
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000007:phone_message:000": {
      "source_hash": "sha256:7f3eb7a3ad9d43459745fd78a887b07ce28955af25e2f889ed7df2eab0772123",
      "text": "早上好，●●●●プロデューサー。\n方便稍微聊两句吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000009:choice_short:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然可以！",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:7e5afb1f3ef0bb187f8ece5a85020d8920e6a1241bd38c800625f4c6acfd8cc4",
      "text": "我看到视频寄语了。还有降临节日历里的寄语也是，真的非常感谢你。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:fe13a6e02d44f80fbff73d534239b8c09980128851fc90f96477f29e392f925c",
      "text": "正是为了向你道谢，我才打了这通电话。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:0810311256e79ea5d5e5267a6e376abc6231a125ba9985f53ea6ab7293b13970",
      "text": "多亏了●●●●プロデューサー和大家，\n今年我总算没把自己的生日给忘了。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:9608c60869a2e25389d5540ed139aa5117e247ab5c53dd75a24f9b71e27f785b",
      "text": "拆开降临节日历的时候，心里兴奋极了。\n今天的派对我也很期待呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:f87f744efcfa7d01aac6be5daa5e989a7e1d4ec611436096450a9f8710d6a8fe",
      "text": "一起度过美好的\n一天吧！",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000021:choice_short:000": {
      "source_hash": "sha256:7ecf009dce6544074e272f88469424b3a04d3c16f0ba38f0566794b4ccc149f2",
      "text": "好！敬请\n期待吧",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000024:phone_message:000": {
      "source_hash": "sha256:02ed4b9d7a4eebfd76c2ea9eec2ee1f20e64d704b8b7fec620f2c77818b30816",
      "text": "嗯，谢谢你。虽然还想再聊聊，\n不过剩下的就留到派对上再说吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000026:phone_message:000": {
      "source_hash": "sha256:0d8e58710a380fc4e3092483df6bc3278ccef2a54870acca3116d36c4f5a1cc8",
      "text": "很期待能和制作人还有大家见面。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_2_1_2_027_22_t01:1_2_027_22_t01:cmd-000028:phone_message:000": {
      "source_hash": "sha256:f884ab1871e3c42c5d6eaa90d2b901ef2f27b3688138a2b10b50bccc47d22bdf",
      "text": "那么，晚点见。",
      "status": "draft"
    }
  }
}
