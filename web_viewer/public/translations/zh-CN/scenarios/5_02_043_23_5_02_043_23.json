{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_043_23_5_02_043_23",
  "source_raw_hash": "sha256:be1adfa6c07e37da9585a5b3d250c33537faf86f4c86383c57174371b39e5e7b",
  "entries": {
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000011:dialogue:000": {
      "source_hash": "sha256:612d7c87fcdb2ce7891be769b3b075a150f7cf25883834944195377210d47cd5",
      "text": "……制作人，久等了。\n再稍微等一会儿白色情人节的回礼就要完成了。",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000013:dialogue:000": {
      "source_hash": "sha256:1e3de6bdfa641c03f5472d25cc38de2d57d0c0161980a141df97fa44fb5ba636",
      "text": "好香的味道啊。请问是在做什么呢？",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000016:dialogue:000": {
      "source_hash": "sha256:62f3ae7812d470ff0cbe6ffc458684fd8e1f642ef5fef8ea37cc4701d84c6539",
      "text": "……是烤棉花糖夹心饼。",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000020:dialogue:000": {
      "source_hash": "sha256:d31868269f3e4f46728621c5e0fa15574098d575b81a99f751f1db9cd46df382",
      "text": "……是篝火晚会上很受欢迎的甜点哦。\n只要码在平底铁锅里烤，做起来很简单。",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000029:dialogue:000": {
      "source_hash": "sha256:2af7bc128f323cb47107a8e253947d85b169517e9f74ea3956b7845f49552811",
      "text": "……好，做好了。趁热用饼干\n舀着吃吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000032:dialogue:000": {
      "source_hash": "sha256:543fca06e92e3bc83f4ea3f151dbb3d40521f3170964b69da87da2085bdda8d4",
      "text": "好的，我开动了。……微融的棉花糖\n超级好吃！",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:fdc8cd839508f060ae83a5baff4d27d34aa85b04f9b482540f40e11ffeb63e42",
      "text": "……太好了。这次是用平底铁锅做的，\n下次想用篝火烤棉花糖招待你。",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000040:dialogue:000": {
      "source_hash": "sha256:69eed9ae1f03eaa027e0e4e262f1bdf310cda3fdb87e714624181bc8310c4602",
      "text": "……要不要再去露营，就像那时一样？",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000044:dialogue:000": {
      "source_hash": "sha256:e91b298ad659caf90f88e2d5c407c0e468a91bf10bc72afce268a0479e34a36e",
      "text": "好主意呢！请务必一起再做一次吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_043_23_5_02_043_23:5_02_043_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:235b1296caab9b98aa4687fc2195a9899b038a0705646b51f5e2feb7cbf47cd4",
      "text": "……嗯，一言为定。",
      "status": "draft"
    }
  }
}
