{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "002sht_402_2_4_002_02_09_a",
  "source_raw_hash": "sha256:108b24e63fd484a68c0908bafc7f1a7f2c2d27aa669d6f0348ff9e9cf74de5b9",
  "entries": {
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:4a6aa520df5866b4d3852cd56368af08b9d78ddcaa3c53341422532c703a732f",
      "text": "早上好，●●●●プロデューサー！\n谢谢你发来大家一起拍的照片！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5362636f72b47104b18b8055e79035dd9bbd2dfc599c8647d124502d904bf29a",
      "text": "看着那张照片，就想起昨天的事情了呢～\n直播真开心啊！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:cca675949d6a8295ecc9965fc4f8db4fb4079288198ea59af170abee8cdad0c9",
      "text": "真是名主持！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000011:choice_short:000": {
      "source_hash": "sha256:c15a94a473b01e9bf128e58872ddb5d451b19b9544ed0e53e474268efcb3779d",
      "text": "大显身手了呢",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:752341cdf049e5d72a22df2b2ed6653ebb2fe1e2c5a955b4cde45011f9bcddd4",
      "text": "因为大家都很有趣，\n不知不觉就聊得很起劲了！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:ff2c3acbfd4d210f8bd475f96303825b1fe7dc1a9203bc88e23d9dc84faa3c3e",
      "text": "你说打枕头仗的事？大家虽然也挺厉害，\n但果然还是我最强吧？",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:7a6f18b48a4b76420cf1f754a8d9cd93c4bddf7ef3336bae8eea890625971960",
      "text": "直播开始前，大家就一起参观演播室，\n聊零食的话题聊得很热烈……",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:ff43ab96e19abf9f0ef5ebdfb1ec3b5bc40cc213edde21f49fd3c5e5554cc9bf",
      "text": "正式直播时，也真的像是在和朋友开派对\n一样超级开心，",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:0c3a441c626788aa22282d536a5a9ce4b0197c9a18f9596f9ebf7bfb8407ef8a",
      "text": "粉丝们也因为能看到平时看不到的一面\n而很高兴呢。",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:8fc1c049ebe71d2549c17fd0d5fb4dd898054a55eb55c2cc4ce0ff76326bf14c",
      "text": "这种直播，要是能再企划一次就好了呢～♪",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000030:phone_message:000": {
      "source_hash": "sha256:e215c0bb83299dadb2dd6693177c078d105b711f16307def573500024ecc4e65",
      "text": "到时候，我也绝对会让大家\n开开心心的！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000032:choice_short:000": {
      "source_hash": "sha256:b9e8595b9a1ae33cd135af2caec31997b098ac21be8f0f2a36778df9a36da3a8",
      "text": "真靠得住！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000035:phone_message:000": {
      "source_hash": "sha256:8ca483c5998f096fd796a47f976a51962200e1a01ee0e42db49f185d67a8080c",
      "text": "是吧？好好期待吧！",
      "status": "draft"
    },
    "story-text:v1:002sht_402_2_4_002_02_09_a:2_4_002_02_09_a:cmd-000037:phone_message:000": {
      "source_hash": "sha256:0d620a94e9faa2a35921ca11f8432eacde8710c2c01ad7651f3baf1557b14389",
      "text": "啊，差不多该准备出门了……！\n那就先挂了哦。辛苦啦！",
      "status": "draft"
    }
  }
}
