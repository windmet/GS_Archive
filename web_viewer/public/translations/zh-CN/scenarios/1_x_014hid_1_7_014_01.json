{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_014hid_1_7_014_01",
  "source_raw_hash": "sha256:682429490df9bd23d6b933442b444153eeaac612d8a02f4369b7511e8dd62ca7",
  "entries": {
    "story-text:v1:1_x_014hid_1_7_014_01:1_7_014_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:d83b33bf49197fcc2eb905f9906532b2b456d5cfe1ad305d4fbe6acad4d7c6d6",
      "text": "●●●●プロデューサー，关于接下来的练习，\n我有点事想和你商量……",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_7_014_01:1_7_014_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:95a84b234c5555616c185833e61a24e4e2a07c3950486b3e39da29c76442e50e",
      "text": "英雄先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_7_014_01:1_7_014_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:ac88319a021acd966a881d8b68e10d9692d6322301a0fc9f80f663ae391aa33c",
      "text": "啊——……谢谢你啊，●●●●プロデューサー。\n……呃，我刚才表情很凶吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_7_014_01:1_7_014_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c6f94d80d25ae24e50a70c49065f416600a33ee12678dc1a6b046ebe19b52ac2",
      "text": "不，我这不是在生气啦。\n倒不如说正好相反……",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_7_014_01:1_7_014_01:cmd-000040:dialogue:000": {
      "source_hash": "sha256:1366c4b5415223aca8704dec35422eb69d9cdacc71a69d0b0ce3a558202a216e",
      "text": "我只是觉得你还好好记着我的生日呢。\n心里特别开心。",
      "status": "draft"
    }
  }
}
