{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_011_03_c",
  "source_raw_hash": "sha256:4246d48205b4aa8745c5feb48fb335b7fc14c430a56944412377b374ef336f64",
  "entries": {
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000019:dialogue:000": {
      "source_hash": "sha256:c61d9566c9cfd635cc5a81b6068f536c8c44e0fe6b7fe18c1a8e5667cb364451",
      "text": "这次新作的衣服，\n对花音来说已经太小了。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000024:dialogue:000": {
      "source_hash": "sha256:083f110266ea9f4770b8816bb4140e7841961adb3d6c3efbd2b219830d01f848",
      "text": "怎、怎么会这样～……\n花音明明最喜欢爸爸的衣服了……！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000033:dialogue:000": {
      "source_hash": "sha256:52aeb30435527ccc176a00b68fd0d0b67659c55e2ac3192ea97ca93a5e0332e5",
      "text": "明明……明明……呜哇啊啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000036:dialogue:000": {
      "source_hash": "sha256:3d7df980f8d5e0e82694bb48373c67297a2a4c7df1da4a5c45c4dfedb76534d8",
      "text": "花音！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000053:dialogue:000": {
      "source_hash": "sha256:970eb1b90d96df3d617903c2aac1319e9fbcaae7eb7cb7714338240831998fb6",
      "text": "呜呜～～嗝……抽泣……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000058:dialogue:000": {
      "source_hash": "sha256:2d28ef1695113effd0d83d8169f07e3be81adc7cb6488bfe2e076fdc3b3c1edd",
      "text": "花音，爸爸进来了哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000074:dialogue:000": {
      "source_hash": "sha256:50232abd2a841f39f301c161d6b60cfd7d39eb54dd0ff96a8f3630dbe1b7f7dc",
      "text": "爸爸……嗝……呐，再也穿不了爸爸做的衣服\n什么的，是骗人的对吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000077:dialogue:000": {
      "source_hash": "sha256:2cd913292ad0ada59435a3a89cd494d275b10da51aad2c71cf18714053223112",
      "text": "花音能喜欢爸爸的衣服，爸爸很高兴哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000081:dialogue:000": {
      "source_hash": "sha256:ecd276fa298771419029996dca7163f1701007bf1fe51a29a20b47a32dc74eb2",
      "text": "但是啊，人会长大成人的。\n总有一天会迎来这一刻的。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000087:dialogue:000": {
      "source_hash": "sha256:a24a47fd65bcdd4d2c9e5ee9c67db3555369217dd78208ebf7cf57ac84056b6c",
      "text": "呜呜……怎么会这样……\n那花音才不要长大呢！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_c:cmd-000092:dialogue:000": {
      "source_hash": "sha256:907d9deab2ebe7fed22b34ab40a6b52dc718ff69be414e247fc44a0ca16346c1",
      "text": "花音……对了。偶像事务所的\n制作人，给花音发来联络了哦。",
      "status": "draft"
    }
  }
}
