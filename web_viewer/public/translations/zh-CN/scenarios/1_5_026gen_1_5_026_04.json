  "scenario_id": "1_5_026gen_1_5_026_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000010:title:001": {
      "source_hash": "sha256:75f31703f249dff5645033a3bacd2198e2897114504dde330507979adfd319fa",
      "text": "教育综艺节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:68106cf1fbecf6c6f44245fa4d16390ff3adc6e8ce393f0aac51e62f6ec29dd9",
      "text": "小学里流行这种游戏啊。\n听起来蛮有意思的。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:2dba1822530c97696c45bca0a5c117d1897c05ad7d583f9f40243b8c1413030d",
      "text": "……不行，在这儿可玩不了。\n拍摄现场可不是玩闹的地方。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:8dffa3d0821e3243fe7565902e028eb6b50e1704e663a6a5beac8decc7940955",
      "text": "下次我们去外面一起玩吧。\n那样也能痛痛快快地活动身体，对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000033:dialogue:000": {
      "source_hash": "sha256:0d8daef03799ddc6bec0aaff1651528bb4ea4866c9f7e262b5bcf2be0ba5cc11",
      "text": "嗯，这是男人与男人之间的约定。\n那就等正式开拍再见了。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:9f71cd4181716f8cad42abee1845fc339ad8644e3612942b72d90f8f52432dc9",
      "text": "玄武先生，完全和童星小朋友打成一片了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000043:dialogue:000": {
      "source_hash": "sha256:31121616031414ac98af5be2afa8daee0ff79e9ceeb66593e5e3e43292907df4",
      "text": "以前在福利院的时候，经常照顾比我小的孩子。\n照顾小鬼头我早就习惯了。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f029ac3eb0940e57e279746e6ceaa909271563999561a4981353b0505f17233c",
      "text": "虽然经历了不少波折……\n不过现在回想起来，都是美好的回忆。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:e065ca83dbab4664ab24a7b56491e5cc2a717785981fbed7fe736d6345645e07",
      "text": "原来如此。正因为有当年的玄武先生，\n才造就了如今的玄武先生呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000056:dialogue:000": {
      "source_hash": "sha256:0f912a6418ddd54d3a68c75ca51c2ae920cc7327af92a444dccab1e9e9b1f3da",
      "text": "嗯……说得对。\n好了，今天的拍摄是长期播出的教育剧。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000059:dialogue:000": {
      "source_hash": "sha256:e35f1b77f8200d4a20324cdad237462335e092714380973320fb3089800d22b2",
      "text": "一意专心，全力集中！",
      "status": "draft"
    }
  }
}
