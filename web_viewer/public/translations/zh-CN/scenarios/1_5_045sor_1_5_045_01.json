  "entries": {
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000010:title:001": {
      "source_hash": "sha256:57e318ab5c911e32bf0fc8df895db75f45573d879e737ab5b3923c7f8f63a849",
      "text": "文具厂商广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:828c5e322e671ccbb8ea8a213deddcd1ee9c4cd1e78ba619fad48ecd97d5fc34",
      "text": "想乐先生，文具厂商广告的工作\n定下来了！",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:404ec06b18402ee601d6a2968148354fa6d8450ba44c3f40e94dd66581c62d65",
      "text": "这是广告中要使用的\n新款圆珠笔的样品。",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:59b6d46762b0b69a3e05e00f3817ddace3cab8b7546cc88b09ad033e8fc24738",
      "text": "我知道这款圆珠笔哦～\n在SNS上也很有话题度，我之前就挺在意的～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c3a2e22619da797634fa82bf551710178f6eac4f1b815687cb1dd3cc996bcab9",
      "text": "……啊，写起来好顺滑。\n而且颜色丰富真不错呢～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:28f7498bc208b022b6877176ae8db09c608410b7400527548d06d8ef7f0276fe",
      "text": "这么说来想乐先生在杂货店打工的时候，\n写过POP手绘海报对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:81a356892c2f658bdc06191be25ac98e11d20d4e42187bd227a33d6871bc4e4c",
      "text": "如果用这支圆珠笔写POP的话，\n会写些什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:fe2f77bfbdf9888e59f7b8f6844d5b0e27def9981c71915a7f253267054e81af",
      "text": "嗯～●●●●プロデューサー会\n写什么？趁这时候让我想想～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:c66ab3a133efb9425ff53b8cd7500a6b9857323ff87db6aace2756c826966563",
      "text": "诶！？那个……\n好写又色彩缤纷的圆珠笔……这样吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000054:dialogue:000": {
      "source_hash": "sha256:b6ee72d68f93184455bd97c63da85aeaa6bab48d61f509ba11e6ae578d3af077",
      "text": "啊哈哈，太直白了呢～\n嗯。我构思好了～",
      "status": "draft"
    },
    "story-text:v1:1_5_045sor_1_5_045_01:1_5_045_01:cmd-000061:dialogue:000": {
      "source_hash": "sha256:2268806eb2ed7c3382e6516fbb656c10f7a183b23ea14b2ddc87f247fd132447",
      "text": "面对无理的刁难，制作人绞尽脑汁。\n呵呵，开玩笑的啦～",
      "status": "draft"
    }
  }
}
