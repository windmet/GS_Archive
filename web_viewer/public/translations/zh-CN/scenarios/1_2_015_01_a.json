{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_015_01_a",
  "source_raw_hash": "sha256:96ef399695d72adb0f09877fd26af0e5b84c075c25c8ecbc6591b9a6b93fbc03",
  "entries": {
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:cfbab1beb22c4bc1bf5753e34dd8cb220f2b04335e2ae0a7080440cd771add6c",
      "text": "可靠的男人与内心的烦恼",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:c9045b35daa5257ed35ae8a890251895ab14cde51f1233cdc1909c630b069652",
      "text": "龙接到了男士护肤品的相关工作。因“可靠的男人”这一概念选中自己而感到欣喜的龙拿起了样品，但在看到包装后却大受动摇。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:cfbab1beb22c4bc1bf5753e34dd8cb220f2b04335e2ae0a7080440cd771add6c",
      "text": "可靠的男人与内心的烦恼",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:7da41e77cc832ab9bd079d17f3a620e5a63a6c8ed9ef34898a5495415f96a1ae",
      "text": "有工作委托指名龙先生了！\n是一份男士化妆品的工作。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:61f5e77e6fd89d34b89f0e9fc90dc89c3a18720ae7a0066fb78335e10a8964e8",
      "text": "找我做男士化妆品的工作？",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:a8b7bff74051fa1d6695d510dd2145995af82e455c8f14679fc022118c40b4cc",
      "text": "是的！概念是“可靠的男人也会做的护肤”。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:9e72214ea165dd676bcc852436c8ad141d0331fe59f598997b6d66bb8f93fdc1",
      "text": "说我是可靠的男人，真让人难为情啊！\n能选上我真高兴。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:e0df9da6e6e7eb9c47a618d67bfeccf6ed7f6f1440b1799c510e12b0e45f2397",
      "text": "护肤啊……",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000040:dialogue:000": {
      "source_hash": "sha256:85fc756f270ae7693759ba4c5330dc6509ace2e05e9c21039a69f592138f06f0",
      "text": "成为偶像之后，虽然会向制作人\n或其他偶像请教，",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000044:dialogue:000": {
      "source_hash": "sha256:9b5838b1a83a5f8679f51e03f5533b8ddc69a23ecad68a5aaf88a5c5c28d8adc",
      "text": "也做过适当的护理，\n但我从来没注意过具体品牌呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:2e55437398b9f0f8f71a2f9f2f49a047d62b279038e592926f34c790cd70501b",
      "text": "原来是这样啊。既然如此，在工作前试用一下，\n和现在用的对比看看吧！",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000050:dialogue:000": {
      "source_hash": "sha256:3d6e57276fe8d4c563879c182acf40fd45e7d8d1cb925fcfd501e2954eef4f43",
      "text": "这是本次工作中要用到的商品样品。",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000057:dialogue:000": {
      "source_hash": "sha256:3b669420a4a2d88228637c4f251338c55e7ddd7e93955876909bdba0e098a21d",
      "text": "嘿——\n……哎！",
      "status": "draft"
    },
    "story-text:v1:1_2_015ryu_01_1_2_015_01:1_2_015_01_a:cmd-000061:dialogue:000": {
      "source_hash": "sha256:6ea3860b8b9b0af4715d8614a3bfc40faa6d46eea973e6d8c275a7ff50f5df26",
      "text": "这不是老爸在用的生发剂吗！？",
      "status": "draft"
    }
  }
}
