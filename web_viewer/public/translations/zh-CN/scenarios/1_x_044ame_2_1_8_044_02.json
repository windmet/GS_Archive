{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_044ame_2_1_8_044_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_044ame_2_1_8_044_02:1_8_044_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:90c2bd7486fb9cb3fd838c0b1daab640e066491e61b48a4e38eb6b335fc72f42",
      "text": "辛苦了，制作人。大清早打扰真不好意思，\n能占用你一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_2_1_8_044_02:1_8_044_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:4c5ed4b6e30c37495afd72c0a1002cf670be42fdd481beeb2f9b39763a6439ba",
      "text": "我本来也想着碰面的时候再说，不过要是拖得\n太晚也就没有意义了。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_2_1_8_044_02:1_8_044_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f20a600af066d35b0af91248b1862a602329f3ebe28efd784ee3cc61e75c5dc1",
      "text": "生日快乐，制作人。\n今后也请多关照了。",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_2_1_8_044_02:1_8_044_02:cmd-000016:choice_short:000": {
      "source_hash": "sha256:606b1b9cc9c19b46c001b9fa489ac3fde7ba75fbc29d229e404f4bbf3c9485d4",
      "text": "我才要请您\n多关照！",
      "status": "draft"
    },
    "story-text:v1:1_x_044ame_2_1_8_044_02:1_8_044_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:6a4849b83fd6d4c9aa3a99beae79f9457c8c959444ca8de03777458c6b64687e",
      "text": "那我差不多该去工作了。\n你也不要太勉强自己了。",
      "status": "draft"
    }
  }
}
