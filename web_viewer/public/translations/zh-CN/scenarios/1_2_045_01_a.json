{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_045_01_a",
  "source_raw_hash": "sha256:b2f1f3f41f4d2eb4461df2eee070c04e87888b366af55f864682e91cd7e0d662",
  "entries": {
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:4babd33c01a21883fbcf77c542587f10e083554771d9c160a9e1fca76e48561e",
      "text": "真心也好，谎言也罢",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:0f4ee7188e38aaac86bd4fccfa50d9e690bb44bf93ede536e18d293fc72015f9",
      "text": "作为偶像出道后，想乐依然在继续大学生活。\n之所以尽可能想两者兼顾，其原因在于\n他对分居两地的父母怀有的复杂感情。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:4babd33c01a21883fbcf77c542587f10e083554771d9c160a9e1fca76e48561e",
      "text": "真心也好，谎言也罢",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:9b13e6720d41ff0a36a33e337170f7d167c165f8daf038306d6ba774765879a3",
      "text": "想乐先生，您已经到了吗？\n来得真早啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000022:dialogue:000": {
      "source_hash": "sha256:638be01143670fe928a0e6ca61652de21f8d075a93d098010c0f9f315506f2d5",
      "text": "●●●●プロデューサー，早上好～。\n我想把大学的报告赶完，所以早点过来了～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:ef657f928e4a6f69362dd5cde8f6dd841cc7107aa4bd79ffb4d29ae77b304e0e",
      "text": "原来是这样。既然如此，\n碰头会的时间要稍微推迟一点吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:8046182b7a6fde43b1d02c07985f8489296b12bb2fcc9764620657901ddc0433",
      "text": "不用，已经进入润色阶段了，没关系的～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:bcf4bb4058c6fc43974c7be6ae71b48bb8f1a74a33610a71560b5865001580c9",
      "text": "●●●●プロデューサー总是\n连我的大学生活都会关照到呢～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:276efebffe420f1493f38f3a5e0ff312e52df0ec1495804205de7c247f3704de",
      "text": "多亏了你，我才能偶像和大学生两不误哦～。\n今后也请继续保持这样关照我啦～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:1040a94dfb84b35cba145968ac4797fefa453b570ae1b8977b5a1e37b764ea03",
      "text": "好的，包在我身上！",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000045:dialogue:000": {
      "source_hash": "sha256:534a7964e3231c17d4a3f1677a47296787c9fde86c03b5b67343e4242076f9ec",
      "text": "……嗯，报告差不多能看到完成的曙光了～。",
      "status": "draft"
    },
    "story-text:v1:1_2_045sor_01_1_2_045_01:1_2_045_01_a:cmd-000049:dialogue:000": {
      "source_hash": "sha256:4d00ebfc8ffceb1fbc6aa836503412143ed8f5fd1817ffafae2e90a9b811df9c",
      "text": "既然●●●●プロデューサー也来了，\n虽然稍微早了点，我们就开始聊工作吧～。",
      "status": "draft"
    }
  }
}
