{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "042dai_402_2_4_042_02_09_b",
  "source_raw_hash": "sha256:964046673d42b6520f5340903bce695b4ccb483da47587bda0e53fc7dbedb3a7",
  "entries": {
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:a0db942444d5c27bc9c9f342f95c26725c62c7f7fdd3179545ca62645d2192b5",
      "text": "喂喂，老大！\n能拜托你帮个小忙不？",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:76acfeab08351048904710f2e071814d5a7c36586d8bfd04de5618ba943da58d",
      "text": "下次的活动不是由俺来主持问答环节嘛？\n念题目的练习俺自己一个人在练，",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:1581d944a71dc4e8326a56a35794575c15d2cb9c0b5854a0968f882c5b928496",
      "text": "但俺还想要一个能像正式登场一样回答问题的人。\n所以那个啊，",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:9c4b1f818a91d6ea1cf467088ee1920a6482a882181e1fe0a4e1ba6cabe49855",
      "text": "拜托啦，●●●●●●●●●●老大！\n陪俺练一练吧！",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:b9651974dd46b4b0b61191e0de4bfcb9428141bf41b768751e920af2780cd7e7",
      "text": "当然可以",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:d2f82329b4ea7260ab618730e0985a4113ba2572aa13b493e35743f1e96633e3",
      "text": "哦哦！真不愧是老大！\n谢啦！",
      "status": "draft"
    },
    "story-text:v1:042dai_402_2_4_042_02_09_b:2_4_042_02_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:702bc309fafa5051a022ed8a50fb8d8e47e7020bef6fc241b33e5f2fbf450299",
      "text": "那就下次碰头会的时候拜托你啦！",
      "status": "draft"
    }
  }
}
