{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_036_23_5_02_036_23",
  "source_raw_hash": "sha256:b688c84326bf4fc2499e0bb5196d68a1ee68a2240f1f386aaa10950fc91e3dcc",
  "entries": {
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000013:dialogue:000": {
      "source_hash": "sha256:80e196843f447acdf245c8416d6a5a07f93a0a1489b68de3edc6691d2ef3873c",
      "text": "类先生，今天承蒙您的邀请\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000019:dialogue:000": {
      "source_hash": "sha256:340b996d2ab60e7f13de75ab8fe7c53079987d6ed6bac6f6dfedc92e3c610b2f",
      "text": "You're welcome！我也因为能和制作人酱\n一起吃lunch而超高兴哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000025:dialogue:000": {
      "source_hash": "sha256:92ad50e4b7954c76437291b53cb7cdbe1fa4a9ae315fe3aa6415c500a040ec36",
      "text": "两个人一起吃的话总觉得比平时更加delicious呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000030:dialogue:000": {
      "source_hash": "sha256:f7ade65435fe648fa297945f31db1f0decc467672461e058b4f250919ce28cb9",
      "text": "是啊。那么，我之后还有一场\n会议要开，就先到这里……",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:4c398d52ebc378ea621dfc4c53335293fe8421685046e9f586b3bf19bb7fa9da",
      "text": "啊，Wait！\n在那之前……",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000043:dialogue:000": {
      "source_hash": "sha256:c3ea80a8ba8261492d92c9ba84997138b2a7c7547809a5473aabfa0b3dd39cdc",
      "text": "Happy white day！\n●●●●プロデューサー酱♪",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000047:dialogue:000": {
      "source_hash": "sha256:f08d204822ed6b70cd721b6f5b09c604a9884927dce1173f707ba5b828fff4fa",
      "text": "您特意为我准备了吗？\n非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000053:dialogue:000": {
      "source_hash": "sha256:6e4eb7f267b14854c55e54495a82cedb05a68d07c98a2dbbfb980a39d46dd8ad",
      "text": "Of course！\nValentine时，谢谢你送我那么精美的chocolate。",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000059:dialogue:000": {
      "source_hash": "sha256:4dc98d3af5599b8fcc2884fece40f944067133e100f269131733f5dcf84593b7",
      "text": "我也挑选了绝不输给制作人酱的巧克力的\ndelicious回礼哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_036_23_5_02_036_23:5_02_036_23:cmd-000066:dialogue:000": {
      "source_hash": "sha256:ededeef0bfadcb5018809ef3509e6c7c9f02cf9ab75a9da6e9b310a537f95ffb",
      "text": "下次我们两个人再去吃lunch吧。\n那么，see you！",
      "status": "draft"
    }
  }
}
