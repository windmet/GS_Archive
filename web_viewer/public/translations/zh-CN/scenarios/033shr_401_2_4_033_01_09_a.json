{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "033shr_401_2_4_033_01_09_a",
  "source_raw_hash": "sha256:b6046261fc94262da935f8f109cfae3ab9ad84c086c74b995ad4b58863fe1e7f",
  "entries": {
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5630fac575bf1664e93fb2fc6cdea27edf1161ec1a960c067a991104e5693927",
      "text": "……喂，●●●●プロデューサー？\n我正在等电车呢，半天都不来～。",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:f347fa67b5ef134c27b2d906d20c8ff2c19d96e10390a6da39c15fe5d9f510b1",
      "text": "能陪我聊聊天不？\n啊，你在工作吗？",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:eac45b6855021e10962477f5af1f545f3e25f3d1397bf8a1a1c5c53306cfe0cc",
      "text": "没关系的哦",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:6cdb918047e966736817cd3e8cabadbb5ac8dd313dbd8407c5e7a881069839b2",
      "text": "谢啦！\n我说啊，前阵子的点心展会真好玩啊！",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:73a6af0ba52bf05bebc4fc708530b46cfc39575fa15e047e74942e57ffc63fda",
      "text": "我的宣传做得很完美，\n演出也超级棒！",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:3506c1c2dfd9e2815b7ba609a8e64f1bb3f05ee43e3512da25c3ac5dab6421a5",
      "text": "客人们都嗨起来了，\n感觉超爽的——！",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:e961b6c58fa14fda88e16aaeb21f67b97e6994fc0cc40317977193a7411e8e4d",
      "text": "……对啦！喂，●●●●プロデューサー。\n那时候的演出录像有吗？",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000023:choice_short:000": {
      "source_hash": "sha256:a516116872c9e19c792e03d9eaf87fcfe18dec91b0e6095a739c0435ac960c41",
      "text": "我去准备一份",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:cd85fc3ea9f08a7d22d818a9f956f7f124e63e486f4e8473f1c2863713d8a6f2",
      "text": "好嘞！我得让直央和花音看看\n我有多帅才行。",
      "status": "draft"
    },
    "story-text:v1:033shr_401_2_4_033_01_09_a:2_4_033_01_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:1c8e4b0f2de37116a88d64afd6260bf63ea963402930945f0db2fe19e065c9de",
      "text": "……啊，电车来了。\n那就事务所见啦！",
      "status": "draft"
    }
  }
}
