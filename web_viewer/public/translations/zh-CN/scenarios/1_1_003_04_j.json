{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_003_04_j",
  "source_raw_hash": "sha256:1cfe97dd88f6b46841a348fda8672fe4ea21dd4a2c8a1c17595233b8126108d8",
  "entries": {
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000021:dialogue:000": {
      "source_hash": "sha256:5bd7224616495fb1efffdb5c8afa6a6844bf9b4f311f326473b7449169a4c460",
      "text": "……辛苦了，都筑先生。",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000028:dialogue:000": {
      "source_hash": "sha256:a2bed531cf4b69c49837a2ec79e53b5fc3b7eee338ee882bed49d2415f861a5b",
      "text": "嗯……早上好，丽先生。",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000031:dialogue:000": {
      "source_hash": "sha256:c6fc3fcd3f5c959593b908fb81754d2c83afc2a61be6ab752c979c7382d86724",
      "text": "您难道是在这种地方睡着了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000036:dialogue:000": {
      "source_hash": "sha256:323ec5610ce46c89eed7c330d07ed22cafd86690dd6873537dc9cb72f38aab29",
      "text": "嗯。在去事务所的路上……\n因为今天天气很好，不知不觉就……",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000042:dialogue:000": {
      "source_hash": "sha256:e878f51595f56caee08ac788d60b9963f079db20ca3c08a058cf6d043886954d",
      "text": "唉……但是，请看一下表。\n时间已经不早了哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000046:dialogue:000": {
      "source_hash": "sha256:64b27e51c59725938777887780a4de69f95ef18cc64ad7c7cf554772ebc96da9",
      "text": "我们的事情是一样的。\n迟到了可不好，一起去事务所吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000054:dialogue:000": {
      "source_hash": "sha256:e831d99a5bfe92b75ad731d91111d9533892e3656039964aa040e091b685149d",
      "text": "哈啊……也是呢，一起走吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000063:dialogue:000": {
      "source_hash": "sha256:3ddb3dc61363d05497bf832e492642b5db2e375f102b13bd50872c2ca506c0ac",
      "text": "（知道了时间也完全没有着急的样子。\n果然这个人让人完全无法理解）",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000073:dialogue:000": {
      "source_hash": "sha256:eb723ab8f226009aef2d7db01bf7112feb6cb2e49c5442b5056031d2e09b0ec6",
      "text": "（还是一如既往的一板一眼呢。\n光看着，我这边的肩膀都快酸了）",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000084:dialogue:000": {
      "source_hash": "sha256:baacea63b72e6d8aa5a5a51d43e12af7a52276a83931c217c6da82b31b67bbf1",
      "text": "（但是……）",
      "status": "draft"
    },
    "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_j:cmd-000100:dialogue:000": {
      "source_hash": "sha256:10411c71431ec9df7c94b09569474c78634de970ba79f10f78fec75d1072112e",
      "text": "（要是和这个人的话）",
      "status": "draft"
    }
  }
}
