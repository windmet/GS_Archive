{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "017kir_403_2_4_017_03_09_b",
  "source_raw_hash": "sha256:92d0634ba13bb6f506eba30cae5f9b797b082c9b3c2ac96301321ae54940f71f",
  "entries": {
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:487039246c2b9b4fad899d201c09dc338ea5b8f0e70004fc5060a1d811d2b03b",
      "text": "●●●●プロデューサー君♪吾辈发现了一家\n看起来很好吃的芝士蛋糕是也。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000009:phone_message:000": {
      "source_hash": "sha256:02b7659490fe73b9f9ff9410dc38cb20c527d225b15f07827098641101fa9f2b",
      "text": "吾辈现在就买回去喵，\n请一定要尝尝喵。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:ed79e27637f2a47ed23c23e800ad235c39375ee7b0b8d4e8f64db66aa36517e8",
      "text": "为什么是\n芝士蛋糕呢？",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:609a5b4b198fd3437aa09ffc352eba439c80f0da1ed3d44ec3dd9b7960ea1cbc",
      "text": "喵呵呵，下次的工作是要宣传乳制品是也。\n这也是学习的一环喵～♪",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:e5e1e68b44c605ad266d02f9da0a101c9a516cd12c1dc45517544e774718adca",
      "text": "话说回来，冻芝士和重芝士，两种都\n很有魅力喵。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:2b940b500286a3cd1bc8919bc1568763a8b3c06bb9cde20c3a17192423e399df",
      "text": "制作人君更喜欢哪一种喵？",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:50eb9780a61d477295a0ed2f1193ad6636cf9b3a2719e43dc87eb57af8afa554",
      "text": "我选冻芝士蛋糕！",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000021:choice_short:000": {
      "source_hash": "sha256:1adf20a1f9b6681b3caca0063a410f14d9ef0f9d609e9a04f5d65e3e08d3d19c",
      "text": "我选重芝士蛋糕！",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000024:phone_message:000": {
      "source_hash": "sha256:78800c36681299e039ec88c9a0da37c4ed86dfbcb740731ef2418efdfd55960e",
      "text": "哦哦，跟吾辈一样喵！\n制作人君也一定会喜欢的是也。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000029:phone_message:000": {
      "source_hash": "sha256:f6a34fbbd694c95d6563772c2bb8f748c0bd7700e7a927c547a36770bd7fa7f9",
      "text": "喵喵！真不愧是制作人君，\n经典款绝不放过喵。",
      "status": "draft"
    },
    "story-text:v1:017kir_403_2_4_017_03_09_b:2_4_017_03_09_b:cmd-000033:phone_message:000": {
      "source_hash": "sha256:664adc1bc6e71cb509b62c9267bd1814d53d79118e5b0d4b0828a9d544a6c35f",
      "text": "敬请期待喵♪",
      "status": "draft"
    }
  }
}
