    "story-text:v1:1_x_018shm_1_8_018_01:1_8_018_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:dfed212f38f3c97e91d40a80fea583d675e46f1408d6c62307cfcf6c73398670",
      "text": "是●●●●プロデューサー酱吗？\n我太想祝贺你了，忍不住就打了电话。",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_8_018_01:1_8_018_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:8b976bbafba7519fd7be4433aa657ca94c9b7f5c0bda5c6f959cdb1201ae61b7",
      "text": "生日快乐呀，\n●●●●プロデューサー酱♪",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_8_018_01:1_8_018_01:cmd-000018:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_8_018_01:1_8_018_01:cmd-000021:phone_message:000": {
      "source_hash": "sha256:483f37c675b158d29a98496c0ddc1ce744ec9a0dae37c871ff8b0930e12e3757",
      "text": "呵呵，不用客气。\n等工作结束了我会顺路去趟事务所的。",
      "status": "draft"
    },
    "story-text:v1:1_x_018shm_1_8_018_01:1_8_018_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:08c8495eaa44a7adcbd660d042bf835ec00119cacdc4d5c18a847b4d6b9e6c64",
      "text": "到时候再让我好好为你庆祝吧。\n那么，待会儿见啦。",
      "status": "draft"
    }
  }
