{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_048mom_1_7_048_01",
  "source_raw_hash": "sha256:6b35e9fc7e08f9c20e0cd130dd8b160d4a0de228156cbf466c2e2517feed2c49",
  "entries": {
    "story-text:v1:1_x_048mom_1_7_048_01:1_7_048_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:f54dcbf4a1a398c3a8142a655aa66fe0e40a0c7de93d044eeeb10316ef31176f",
      "text": "百百人先生，今天也是您的生日吧！\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_7_048_01:1_7_048_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:1889e16e95992be81e98bfb1a40e31cd3bffbdb05e39129ebe149eea23a0060c",
      "text": "哎，生日？\n……这样啊，原来今天是我的生日啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_7_048_01:1_7_048_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:43412b6d23a79c63f48475e677fd56d6db607decce7a30f3d43e204137e682c4",
      "text": "●●●●●●●●●●P酱，\n你还记得呀。",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_7_048_01:1_7_048_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:0e36469314411727c0df8c575a63e402271e84f7ae2f0607d55f337d4d445403",
      "text": "而且，刚一碰面就马上为我庆祝了……\n我收到了一份好棒的礼物呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_7_048_01:1_7_048_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:8b08ef0e983fd15551964aa341cdc484b463ee8d3c468066aef653197c382095",
      "text": "我超级开心的。\n谢谢你，●●●●●●●●●●P酱。",
      "status": "draft"
    }
  }
}
