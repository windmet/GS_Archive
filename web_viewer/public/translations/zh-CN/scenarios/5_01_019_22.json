{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_019_22",
  "source_raw_hash": "sha256:826921ab44cb376ca6e23ed459117872ea16244d8e1decbd57a9f8af83aea948",
  "entries": {
    "story-text:v1:5_01_019_22:5_01_019_22_a:cmd-000013:dialogue:000": {
      "source_hash": "sha256:26b6197a70dc67505e295e9910b21dcd81eaa4060b342d3b7de2fa836dea7ebe",
      "text": "这是……情人节巧克力吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:f93b508de266683bec5047f01cf9fc6e63fb42699ae9676d09021874d291d6b2",
      "text": "没想到您居然也为我准备了……我真是完全没有料到。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:1f73f4a87543d79b5b57bb58132d04781d90ebdd8f7689524a1a23ef7e60bbce",
      "text": "非常感谢您的这份心意， ●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:b8cca4219c25a8e808fdf3b81073c430c588c72ce0e0308adeabc5f2bb6f0b09",
      "text": "我感到非常开心。既然收到了这份巧克力，",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:fddc20552594d50c42a33274dc520a1d67d026be1d4f6ad4918ea2a43e72bdf1",
      "text": "我一定会成长为一名出色的偶像给您看。今后也请您多多关照了。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000012:dialogue:000": {
      "source_hash": "sha256:be15b31f0018d32ef48da4148a5722ae839988a3882e413a4ad863d827bf823b",
      "text": "送给我的巧克力吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000019:dialogue:000": {
      "source_hash": "sha256:e3c43ccc8fbbb98132a3588c2b7b710cb47f6c3d9002da4ab0898dd8ba831aa5",
      "text": "是您在百忙之中特意为我准备的吧。非常感谢。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:215e46995b5f4198d2ef935a8ddef2d1b47928763f09843c6d9da15fb63f904c",
      "text": "●●●●プロデューサー的这份体贴心意让我非常开心。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000026:choice_short:000": {
      "source_hash": "sha256:6cdc89e07fbba1795cacffa2f1c30ad4c6d2574643a4cfdd35a9d5d4e21f9a6d",
      "text": "你能喜欢，我也很开心！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000027:choice_short:000": {
      "source_hash": "sha256:3a407b371fdf898bf5fff80bfb41a15a9caf88221c065cd82fa590dcfe75cd3e",
      "text": "因为九郎先生平时一直都很努力嘛！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:fe3c288b29011e6ad9c0688627a37dd577d3ee0d768dfc5c653678a8955bc4eb",
      "text": "好的。我可以先吃一颗吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000034:choice_short:000": {
      "source_hash": "sha256:53fae0cff8a0a6b334d61e0732b130b8cc6bbf732024190aa56032d525947abf",
      "text": "请用！",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000045:dialogue:000": {
      "source_hash": "sha256:55afd68a0579335b707f6e8fcf94a733c1a92879c21685dd8479b7d7791b65dc",
      "text": "那么，虽然有些心急，我就先尝一颗了。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000058:dialogue:000": {
      "source_hash": "sha256:0946744923600d0e4075d33ee6f2f5996bdb7a2ed7d4ca4b948d100cc53da266",
      "text": "入口即化，非常美味呢。还有……不，没什么。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000064:dialogue:000": {
      "source_hash": "sha256:ad658214a0788ea6b930ec342ae9d5fff19b91adce166140759bf5a894b76a0a",
      "text": "多谢款待。多亏了您的巧克力，上场前的紧张感缓和了许多。",
      "status": "draft"
    },
    "story-text:v1:5_01_019_22:5_01_019_22_b:cmd-000069:dialogue:000": {
      "source_hash": "sha256:07ff6e7cd9e257851498cb475d05c0da7a203eac9b7cc31b8acd8ead87b461b6",
      "text": "差不多到时间了呢。我们做准备去演播室吧。",
      "status": "draft"
    }
  }
}
