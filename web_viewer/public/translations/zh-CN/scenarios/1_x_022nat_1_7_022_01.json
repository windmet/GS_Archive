{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_022nat_1_7_022_01",
  "source_raw_hash": "sha256:f10f2e50ca49680e08a57603274e5e450cc273fc8c6eb573215b848fb4a0b55c",
  "entries": {
    "story-text:v1:1_x_022nat_1_7_022_01:1_7_022_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:c8bcc3fb20628a6525400592aff904f66ca2ef7a0ba36b48cca7bfc073538bdf",
      "text": "夏来先生，今天也是您的生日呢。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_7_022_01:1_7_022_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:e2804c0961ef9863742063b962d4b9ee78b7e1bef2bb502003adb395c005649c",
      "text": "啊……●●●●プロデューサー，\n我的生日，你还记着啊……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_7_022_01:1_7_022_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:6dfe8a825ca7dda29b1df166ec739bebaf1447c5b75ec8f6b771c3f588e3f5fd",
      "text": "那个……谢、谢谢……\n好、高兴……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_7_022_01:1_7_022_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:7df5d7a854067c77f094ed4bf41e9424f752128e3d2cf46c0404aa449f934075",
      "text": "这种时候，该说什么好，\n虽然我不是很清楚，但是……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_1_7_022_01:1_7_022_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:1d00d68db77f0e0112e7683b869d4a1996c177ab75228c3ed4d29e3e5122abf7",
      "text": "以后我也……会加油的，所以……\n请多指教，呢。",
      "status": "draft"
    }
  }
}
