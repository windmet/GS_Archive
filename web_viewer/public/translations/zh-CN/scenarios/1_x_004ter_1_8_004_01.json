{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_004ter_1_8_004_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_004ter_1_8_004_01:1_8_004_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:95ce757f0354d0efa9a2de709676d284b73f54fa91b9c2845744aaaffbfebd35",
      "text": "喂，●●●●プロデューサー。\n现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_8_004_01:1_8_004_01:cmd-000014:dialogue:000": {
      "source_hash": "sha256:9850f08a0165366bfc330d8feb5e32697a9b5185e027cac4b0f97488723d7dd7",
      "text": "今天是●●●●プロデューサー的生日对吧。\n祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_8_004_01:1_8_004_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:bda97ced4acb215872cc02b13d9cb296fed1c06edb061788e7daaffcf4bdb940",
      "text": "谢谢您，辉先生！\n能被您记在心上，我很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_8_004_01:1_8_004_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:65da25a042dd0c6efdc2b6483922477d6a59acfba76926f7164e41262c7f1517",
      "text": "不客气。\n嘿嘿，能为你庆祝生日，我也很开心啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_004ter_1_8_004_01:1_8_004_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:b00bdfea130055bf1b5254ac55405be4e7462b7c2fb0ffa91a452e735c3ec97a",
      "text": "今天可是你诞生的重要日子。\n好好度过这美好的一天吧！",
      "status": "draft"
    }
  }
}
