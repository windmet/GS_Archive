{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_045sor_1_7_045_01",
  "source_raw_hash": "sha256:78ba14de99cc0a108c5d0818720dbf527724b89637647eb4400a7c15a2552d72",
  "entries": {
    "story-text:v1:1_x_045sor_1_7_045_01:1_7_045_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:55f1a07a7445dd9edb30d0b853c9b3dee4f509fe26adaa45e245f8664aa4c33d",
      "text": "●●●●プロデューサー，辛苦啦～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_7_045_01:1_7_045_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b2ae90ab33a79b19aacc50e9e5e81c811d061a24eb504f72200e87047a0f754a",
      "text": "辛苦了，想乐先生。\n今天也是您的生日吧。祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_7_045_01:1_7_045_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:476335cdcc763562fcc962ec3c3c0b07a5fa211d67266d0d5ff35bd8f2f4a18a",
      "text": "听闻庆贺语，心中微讶异。\n我完全没料到你还会给我庆祝生日呢～",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_7_045_01:1_7_045_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:bbb293f21c2cf913ca1d5cada5dc2469286780e18a09e2352e80f9ca7c011dbc",
      "text": "谢谢你还记得哦～，\n●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_x_045sor_1_7_045_01:1_7_045_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:965a9be0dc8dd85848fc2dc798409dbf40a51685036a48d029e5b3cd9a979298",
      "text": "今后我也会按自己的步调努力的，请多关照咯～",
      "status": "draft"
    }
  }
}
