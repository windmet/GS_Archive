{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_037jir_2_1_8_037_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_037jir_2_1_8_037_02:1_8_037_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:370149ead608e7058a0b95de372950babdb10ee5e85f775ebe7041c87cced240",
      "text": "啊——……●●●●プロデューサー酱。\n大半夜打扰你真不好意思啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_2_1_8_037_02:1_8_037_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:87c49bb7204a2a194863964cab8c3ad7ad16992018f55f5bdc1c2388f92d467a",
      "text": "那个，●●●●プロデューサー酱，\n今天是你生日对吧？我就想跟你说句生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_2_1_8_037_02:1_8_037_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:2f657ab7d4289b8a72cd4a729f0729df7a210f064ccac63d354c49dd8da4b08d",
      "text": "恭喜啦。还有，一直以来都谢谢你啦。\n我很感谢你哦。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_2_1_8_037_02:1_8_037_02:cmd-000020:choice_short:000": {
      "source_hash": "sha256:0f1170f22c9e7d89e514a61c7d8707bb90e9f5ef269a17ab9db216c7c76ae46c",
      "text": "太高兴了！",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_2_1_8_037_02:1_8_037_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:900aaae96b4259b8105d19513a4fafae9401f592a976fadc968d483c3cab3996",
      "text": "哈哈，总觉得怪难为情的。\n大叔我不太习惯这种场面嘛。",
      "status": "draft"
    },
    "story-text:v1:1_x_037jir_2_1_8_037_02:1_8_037_02:cmd-000025:phone_message:000": {
      "source_hash": "sha256:d3204ff3d84c70fe55e01ef9a643d72a6b11c8b3485c115b58e66ee3154f07b5",
      "text": "哎不过，能像这样把祝福\n传达给你真是太好啦。",
      "status": "draft"
    }
  }
}
