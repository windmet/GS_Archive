{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_049eis_2_1_8_049_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_049eis_2_1_8_049_02:1_8_049_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:0d361d67d437739c17493350f8e8e5ca0b88ca7a6ecfec472df5c3a8fe673368",
      "text": "早上好，●●●●プロデューサー。\n今天是你生日吧。恭喜。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_2_1_8_049_02:1_8_049_02:cmd-000012:choice_short:000": {
      "source_hash": "sha256:42ccdb247ca887c1f4279c535933ad9b6b5a8b10a7a92d1c133ba0546c376d51",
      "text": "非常\n感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_2_1_8_049_02:1_8_049_02:cmd-000015:phone_message:000": {
      "source_hash": "sha256:10a7292839a329e97d751b9bb8568a57f2f82e0d92d30543854c8fd60fb40226",
      "text": "我现在正要去工作，\n还不知道几点能结束。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_2_1_8_049_02:1_8_049_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:50481ccefdea5d8fa6ab13a9ae4e8a822d55092a34140a0c66cd1742e192ef6d",
      "text": "所以，趁着早上先给你打个电话。",
      "status": "draft"
    },
    "story-text:v1:1_x_049eis_2_1_8_049_02:1_8_049_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:3c2a60d76f1ea488116c078eb3a20f89def37f89552bbde94d20015dc9d482de",
      "text": "如果时间合适，回程时我打算顺便去趟事务所。\n祝你度过充实的一天。",
      "status": "draft"
    }
  }
}
