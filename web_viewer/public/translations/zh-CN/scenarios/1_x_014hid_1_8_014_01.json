{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_014hid_1_8_014_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_014hid_1_8_014_01:1_8_014_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:2cb6167424a66e710b6baf8602bbaf4529179d3c3d5c0b2ca0cbf862bf02eeda",
      "text": "●●●●プロデューサー，生日快乐！\n能像这样为你庆祝生日，我很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_8_014_01:1_8_014_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:0bae488c9dd515d70e86542c4cf3263f2149f9054f08b7d0518b64b5a1f29f9d",
      "text": "非常感谢！\n能收到您的祝福，我也很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_8_014_01:1_8_014_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:63d4ae5195e831dda344460baa23c7b02da8b0e551b77878d763cb571d5cde7e",
      "text": "……啊，对了。我买了做松饼的材料，\n让我请你吃吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_8_014_01:1_8_014_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:42d7014c72e34cf6b6213586f6ded37eb66f161f4b31ded1460745ffb217397a",
      "text": "我平时经常在家里做，对味道还是挺有自信的。",
      "status": "draft"
    },
    "story-text:v1:1_x_014hid_1_8_014_01:1_8_014_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:9c2a3f6ccaf8336b800f89cdf69c901757ffda592cf305e254b06192d02c42c7",
      "text": "我会为了●●●●プロデューサー\n拿出看家本领来做的！",
      "status": "draft"
    }
  }
}
