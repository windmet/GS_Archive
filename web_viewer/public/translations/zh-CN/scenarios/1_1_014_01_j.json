{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_014_01_j",
  "source_raw_hash": "sha256:80a5ba49b1a90b0aa25f0e70ceb447990d45bf635636cd8e444c673ec4ffe6ce",
  "entries": {
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000021:dialogue:000": {
      "source_hash": "sha256:6d537193f5d1a0bb13f436bad2fbf290bf3108252ce14688dacf26046e669cc0",
      "text": "（扮演女孩子这件事，也渐渐变得得心应手起来）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000025:dialogue:000": {
      "source_hash": "sha256:7933856c305332ca6ecc18e595b91a06f2364defa4f3e30845b31bc2ff328bcc",
      "text": "（有好多粉丝，开始支持\n作为偶像的秋月凉了）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000030:dialogue:000": {
      "source_hash": "sha256:ede346923c447233a4e4401913b0d3024f8eefbd51cb787ecb814eea220640c2",
      "text": "（一直支撑着我到今天……不，现在也依然在支持着我）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000040:dialogue:000": {
      "source_hash": "sha256:94dab2a2e9e0a8437c1449325b3b33d32184dd0a83124613bcaba8a7ed27320e",
      "text": "对那些粉丝们，我现在要把真相告诉大家。\n告诉大家我并不是女孩子。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000047:dialogue:000": {
      "source_hash": "sha256:8ad7cb663c900e89367cd5d0a55c8c79101ed81074a0412e9a8b0b9a630fd32a",
      "text": "（……虽然也有不安。但我已经决定了）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000053:dialogue:000": {
      "source_hash": "sha256:bcafbd1e007f69138e2724c11f08b939471f1d1059fa2e57fb9ce4e6eba8dae8",
      "text": "（不论被谁反对，被说什么，\n我也绝不放弃自己的梦想！）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000056:dialogue:000": {
      "source_hash": "sha256:98cdc427e53eac083dc61f1213a4d50f596a3dbd3768ef69745014e4cf3521cb",
      "text": "（我要把这样的自己，展现给梦子酱看！）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000064:dialogue:000": {
      "source_hash": "sha256:63edf572fd728b368ab68fe00f75a6a86dd9fa38fa43c2277b22292fbea0feb0",
      "text": "我要从女性偶像秋月凉……",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_j:cmd-000069:dialogue:000": {
      "source_hash": "sha256:7eb27a04f0c74aa782f88791732f43aaa95c8085d2ae1980354d786d3c818829",
      "text": "蜕变成男性偶像秋月凉给你们看！",
      "status": "draft"
    }
  }
}
