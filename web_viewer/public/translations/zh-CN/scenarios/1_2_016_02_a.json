{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_016_02_a",
  "source_raw_hash": "sha256:4652afc7771a38572f46a20db16bb1f423d0a71cb02b7c81636a32b51504f158",
  "entries": {
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:4d8ad83f6f14ff0500887cebf408c5501f576e595c2cc53a486af2c57f6ba031",
      "text": "独一无二的生日会",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:414676055bb70528a531c4b97648cd83c24097badb1b14b77951cc6c7ad14d54",
      "text": "课程结束后，诚司递给英雄、龙和制作人一个信封。那是天音为诚司准备的生日会邀请函。信上写着天音充满爱意的“要求”……",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000019:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000019:title:001": {
      "source_hash": "sha256:4d8ad83f6f14ff0500887cebf408c5501f576e595c2cc53a486af2c57f6ba031",
      "text": "独一无二的生日会",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:8fdf9ae63f32104ba2e793ecaa75471f63f213f71b03b68cbb48c7260c36ea8f",
      "text": "各位，今天的课程也辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:488bf00576a131e59bbd7982ac4d8fde7c75a22858b7dc04877a1ef4c4b288f2",
      "text": "辛苦了，制作人。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:c48219202902bb3bf07787d107ea54ea2a052384b96f916bfed8437eb5ebb471",
      "text": "今天这就结束了吧。那么，\n大家辛苦啦！明天也请多多关照！",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000059:dialogue:000": {
      "source_hash": "sha256:c145d893fc738d6358d86c517fafd939419f17d412106c323050df84defd9451",
      "text": "龙，稍等一下。还有英雄和\n制作人也是，可以耽误一下吗？我有话想跟你们说。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:a8130230addf206adee159bcad67e56e2863be173ac3109ed5adec8d38606c19",
      "text": "可以是可以，怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:97c0816b433173f246a17e40c5f4ad665837bde6bdd02c176c22d46e2bb542a3",
      "text": "谢谢。\n其实我想把这个给你们。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000083:dialogue:000": {
      "source_hash": "sha256:c04ca992dea478165f1f6644c9209891bdbb273f9e7288324588144bb6369d43",
      "text": "相当可爱的信封呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000089:dialogue:000": {
      "source_hash": "sha256:9e5eaa2928e398fe809fe2ecef5b9182f8bd339b3df13df001a5215eb2631761",
      "text": "确实，跟诚司先生平时的形象很不搭呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000095:dialogue:000": {
      "source_hash": "sha256:169800b5de3d9b116e31b02439bcd6cfe394afcaac09a041a92cc48874abba3b",
      "text": "因为这是天音给各位的邀请函啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_016sei_02_1_2_016_02:1_2_016_02_a:cmd-000102:dialogue:000": {
      "source_hash": "sha256:c2ff4baf01f1ee69a2cb4b754ad2ea12711cdc3e176ababd97edc4c57bba0342",
      "text": "听说今年由天音主办，\n要为我举办一场生日派对。",
      "status": "draft"
    }
  }
}
