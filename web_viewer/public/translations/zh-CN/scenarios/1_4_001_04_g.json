{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_04_g",
  "source_raw_hash": "sha256:48dbd521fece83d18c444d6f206fadfc7867c7058b8c48869107b7790d6ab22b",
  "entries": {
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000006:dialogue:000": {
      "source_hash": "sha256:ec82fea3cf02a92fd5a9006e83f86f1aac7331f3bc09736900487505b975657d",
      "text": "（如果能在这里把Legenders的魅力传达出去，\n说不定就能争取到上节目的机会！）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000008:dialogue:000": {
      "source_hash": "sha256:ae20d21247fba7d01bdc7c54014a71395ae24eda4e5f0e055bfadd1efcb2b859",
      "text": "好的，请允许我重新向您介绍！\n首先是Legenders的成员古论克里斯先生。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000010:dialogue:000": {
      "source_hash": "sha256:b1d73e4f96aa99151976203fafab68659aa8afd9502eb71b1bb24b4154794256",
      "text": "他在成为偶像之前，原本是……",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000012:choice_short:000": {
      "source_hash": "sha256:b76c05362666f2073985106da355fbf3d6034d36d6bb0ca4545fc3940522cda9",
      "text": "海洋学家",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000013:choice_short:000": {
      "source_hash": "sha256:79666eb5ecd7db7f225c379a149533ec6d417b5a23997fc8fc4f0e03ec125fcf",
      "text": "天文学家",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000015:dialogue:000": {
      "source_hash": "sha256:3819b29771b85c8276361d810c969216d5eec29fbd1a0a07f855414404bac30c",
      "text": "哦哦，是这样吗！那想必，\n海洋方面的知识一定很丰富吧！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000019:dialogue:000": {
      "source_hash": "sha256:7a7888a147d2aaad14c29913f82074e074f7e77895f0e48947eeca14273341b6",
      "text": "哦哦，是这样吗！那想必，\n宇宙方面的知识一定很丰富吧！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000021:dialogue:000": {
      "source_hash": "sha256:f6dee21901f829c834e1a689a90df0fd449d58f7d8b55bdac786fe1aca989210",
      "text": "（咦？真的是这样来着吗……）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000024:dialogue:000": {
      "source_hash": "sha256:fac3210a4ae63c3b1ee5a7aef4f79d71debc17d86d02062f0f06314d8cc7dbcd",
      "text": "那么，另外2个人呢？",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000026:dialogue:000": {
      "source_hash": "sha256:ed549fea9588cc7a09ad2bbeac402ab8db976e8e1e4e270c8a66b290d5911fde",
      "text": "接下来是北村想乐先生。\n他很擅长以某种形式来表达事物。",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000028:choice_short:000": {
      "source_hash": "sha256:831c1e443790f04beaf7451a0871c64bb347f490dcce245aa17e0d460cf9e64a",
      "text": "川柳",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000029:choice_short:000": {
      "source_hash": "sha256:d077ff031a21b3cf75c76c73b953690f6765031f127b226e3aea8b7aca0891c6",
      "text": "俳句",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000031:dialogue:000": {
      "source_hash": "sha256:8106c7c494d116e94f6bd45b1d74305d99fc0a0f4987d06a30cd5ca06dd8a31a",
      "text": "ほう，年纪轻轻真让人钦佩啊！\n下次真想让他即兴作上一句呢！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000035:dialogue:000": {
      "source_hash": "sha256:8106c7c494d116e94f6bd45b1d74305d99fc0a0f4987d06a30cd5ca06dd8a31a",
      "text": "ほう，年纪轻轻真让人钦佩啊！\n下次真想让他即兴作上一句呢！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000037:dialogue:000": {
      "source_hash": "sha256:f6dee21901f829c834e1a689a90df0fd449d58f7d8b55bdac786fe1aca989210",
      "text": "（咦？真的是这样来着吗……）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000040:dialogue:000": {
      "source_hash": "sha256:8cd8fdc94414c757b75a3261b2a0532f0cbe68c8be1b71fae95a5e8ad344fe62",
      "text": "……那么，剩下1个人的特征，\n能准确地告诉我吗？",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000042:dialogue:000": {
      "source_hash": "sha256:8eec06a7c3968aeb58a9d1515a477aa9853c8c833b841764563e5c578a63768f",
      "text": "好的！葛之叶雨彦先生的身高，居然有……",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000044:choice_short:000": {
      "source_hash": "sha256:f21529589e118dda4f44d9ce650a19d892d0292d16a9c0bec34bd4b02aac187a",
      "text": "191cm",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000045:choice_short:000": {
      "source_hash": "sha256:2e5d2e4282dc20e304e2be65f283fc03c69090893c1dd3bc556816cab785a473",
      "text": "199cm",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000047:dialogue:000": {
      "source_hash": "sha256:1eaca1a1e08a442965ed556bf6b58164e364c1ab6c0af1b0d701472525543dfa",
      "text": "那可真厉害！\n确实，当时我也觉得他个头相当高呢！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000051:dialogue:000": {
      "source_hash": "sha256:6539a9928a8a7a1907c6e40c17a0439d6b55f447e406302edfd15e8ecde42e14",
      "text": "那可真厉害！……不过，让人担心镜头能不能装得下啊！\n能再告诉我一次他们的魅力吗？",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000053:dialogue:000": {
      "source_hash": "sha256:81ff34426cab57470758929eecdd8feb18209159c2b9549f2078bd7aaa2c5c44",
      "text": "（看来是弄错了。好，重来一次……）",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000057:dialogue:000": {
      "source_hash": "sha256:0bb438adb883887eaa1d612b5cc9aaa4bd99d7ecb6e85a470511553edcda330e",
      "text": "原来如此……\n关于他们的事情，我稍微有点了解了！",
      "status": "reviewed"
    },
    "story-text:v1:1_4_001_04:1_4_001_04_g:cmd-000060:dialogue:000": {
      "source_hash": "sha256:d76319363291c3607762380d8e722a77d7a56a12ba9b92d78bd36876a37f2da4",
      "text": "非常感谢！那么最后，\n所谓Legenders这个组合的魅力就是……",
      "status": "reviewed"
    }
  }
}
