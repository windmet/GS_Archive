  "entries": {
    "story-text:v1:1_x_015ryu_1_8_015_01:1_8_015_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:3565da6230ca28043cdfb9c36788ddb0838d3307b9c811891757b79a65cd55bc",
      "text": "●●●●プロデューサー，\n生生日快东",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_8_015_01:1_8_015_01:cmd-000015:mobile_message:000": {
      "source_hash": "sha256:9c767d69262933f93e6bafee441f9f7f4ec39c17258082d868cda7fb350afb14",
      "text": "抱、抱歉！\n正想发出去，\n约翰就扑过来了！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_8_015_01:1_8_015_01:cmd-000017:mobile_message:000": {
      "source_hash": "sha256:b6a07712ece41743aa6958b424d6157d0fba31b8727759de3402a226d021c66b",
      "text": "重来一次，祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_8_015_01:1_8_015_01:cmd-000019:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_015ryu_1_8_015_01:1_8_015_01:cmd-000022:mobile_message:000": {
      "source_hash": "sha256:5eeb36cddb0ac450e9ab957be596e85299ef6e2ff41c29241f5dd5ae910c0573",
      "text": "不客气。\n这次好好发出来了，\n太好啦！",
      "status": "draft"
    }
  }
}
