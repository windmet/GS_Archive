{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_004_02_a",
  "source_raw_hash": "sha256:763bee3a57da1887cbbe3a10e3dd2373c0972cfcfbb7fe3d94a533eab96494f9",
  "entries": {
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:9bcc4f84c0d28efdca7989db163b82b4c19e6ce6c15f4ed324a057afdbb611d4",
      "text": "A special surprise for you！",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:68e909a2b97ba9b4ba0bac53b7aa8f8c37140a8c1394769264b9e568c9113330",
      "text": "在某档综艺脱口秀节目中，\n薰和翼收到了为即将过生日的辉\n准备惊喜企划的邀请。\n一无所知迎来生日当天的辉，\n收到的VTR内容是……？",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000015:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000015:title:001": {
      "source_hash": "sha256:9bcc4f84c0d28efdca7989db163b82b4c19e6ce6c15f4ed324a057afdbb611d4",
      "text": "A special surprise for you！",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000022:time_caption:000": {
      "source_hash": "sha256:afdc9f8ed8fc32d71a16e014b000758e6d7471c2ac16870110100f1c71e78eba",
      "text": "脱口秀节目开会当天……",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:6cf27d1485cae25fe8a3edef28d3ffd8983d2bd3be4c6de86ab2abdd381d031f",
      "text": "为什么这次碰头会，\n没有叫辉先生呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:b7b33ed60a2be07bc601de457029a93c9217236cc56b8d0360a0ce9fb7b88e4b",
      "text": "刚才明明还在一起开会的……\n薰先生怎么看？",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:cb5f19217b2775f8991c7ffb6f980fe0f4efd2e3b410f62b98dbdf016b6bbd10",
      "text": "工作人员和制作人马上就到了。\n到时候就明白了。",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000046:dialogue:000": {
      "source_hash": "sha256:92ba61cab6c9176dd1defe8406d7c32d8d4b8edeac8a98546af62851e24fd4d8",
      "text": "让二位久等了！",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000048:dialogue:000": {
      "source_hash": "sha256:7c4db2ebacc99c328ae11f935d3ed28532c238cb6b7a51dad0662bfdc484c810",
      "text": "那么，我们开始开会吧。\n其实，有个企划想请两位参加。",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:7c6c3b19b4bc269d55856b541eef17a22f47cfab322afc9044ee7996a8b29adb",
      "text": "录制当天正好是天道先生的生日。那时候，\n要不要给天道先生准备一个惊喜庆祝呢？",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:0807d556b1bcb0a260f53544440f48280f7a448b8bab9528188b607729278f4d",
      "text": "……啊。所以才只叫了我们两个啊。\n薰先生，要办吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:17f8c605e91b19ed64e92e830b5058b18854563c47aaea06f4fe243d0b6c8a35",
      "text": "我刚好也想找你商量\n辉先生的生日礼物呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000064:dialogue:000": {
      "source_hash": "sha256:a5ff43de1712f3f2e99bea1604c09779bcbdf7e7cac6965bfbd9e5993ce9f0b6",
      "text": "等等。在接下之前，我有些事情要确认。\n既然特意开会来谈，",
      "status": "draft"
    },
    "story-text:v1:1_2_004ter_02_1_2_004_02:1_2_004_02_a:cmd-000067:dialogue:000": {
      "source_hash": "sha256:b1b6349617a0ba27f0344915c72500fab2bff673b66e3de7609d3d8815256547",
      "text": "应该不只是单纯的庆祝吧？\n如果有企划书，请让我过目一下。",
      "status": "draft"
    }
  }
}
