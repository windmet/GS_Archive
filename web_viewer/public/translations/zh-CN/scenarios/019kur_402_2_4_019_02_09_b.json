{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "019kur_402_2_4_019_02_09_b",
  "source_raw_hash": "sha256:d7392df494beea118d015a454410c97165d1ff093078b8f60fa5d5e2e13dd286",
  "entries": {
    "story-text:v1:019kur_402_2_4_019_02_09_b:2_4_019_02_09_b:cmd-000007:phone_message:000": {
      "source_hash": "sha256:635795f820be0d7df62dbc0291e1e45475e7f36e0409c988c861c4ddd2a2a083",
      "text": "辛苦了。我是清澄。请问圆城寺先生和\n信玄先生今天在事务所吗？",
      "status": "draft"
    },
    "story-text:v1:019kur_402_2_4_019_02_09_b:2_4_019_02_09_b:cmd-000009:choice_short:000": {
      "source_hash": "sha256:3c223be933e06352d33202452bd874c1e94a92d382216fb675f35e636940551e",
      "text": "他们之后会过来的哦",
      "status": "draft"
    },
    "story-text:v1:019kur_402_2_4_019_02_09_b:2_4_019_02_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:9d587f97cd70df41b0fd1d94449365ce1652a9fee6517f6aac20863dbb48bbb2",
      "text": "谢谢您。虽然只是略表心意，\n但我准备了谢礼想送给两位。",
      "status": "draft"
    },
    "story-text:v1:019kur_402_2_4_019_02_09_b:2_4_019_02_09_b:cmd-000014:phone_message:000": {
      "source_hash": "sha256:e8edd8a0f81b8b0390fd58ddae251bd3e0e1482b915383f11ad640c2bde8e3d0",
      "text": "多亏了两位指导的训练，\n手臂的疲劳感得到了很大缓解。",
      "status": "draft"
    },
    "story-text:v1:019kur_402_2_4_019_02_09_b:2_4_019_02_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:a881cc83e358899ee4262abc62bce51e69f2e9d29d583c1104722641e532f386",
      "text": "听说下次还要分我一些抹茶味的蛋白粉。\n他们特意配合我的喜好挑选了呢。",
      "status": "draft"
    },
    "story-text:v1:019kur_402_2_4_019_02_09_b:2_4_019_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:0ba64590b81dadcf631994743878deafee2ded1707a0c6d58d1954d92580d406",
      "text": "那么，我现在就前往事务所。\n稍后见。",
      "status": "draft"
    }
  }
}
