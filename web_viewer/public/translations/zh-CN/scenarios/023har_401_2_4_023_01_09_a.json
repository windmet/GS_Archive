{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "023har_401_2_4_023_01_09_a",
  "source_raw_hash": "sha256:0fde9e1eff861b8a76b7a70572125da2a76be015f7ec3f8cd8203fd069f55fdf",
  "entries": {
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:5bd021124eedd2083c424c7799849f594190ffde50962d1386903013667bdaa2",
      "text": "喂，●●●●プロデューサー。\n现在学校刚好下课休息，能稍微聊聊吗？",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:3d84ede1c415918e6767334b3246a6950ab091359887924142e8d65336876e17",
      "text": "嗯，没问题哦",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:ae9826560a88e59e6fc8beb4f26259d9ad56fa5ed8107766a3de0769ad3c23ce",
      "text": "谢啦！\n刚才班上的同学跑来找我搭话了。",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:eb17bb84392d1c01abb041f90d0f1707085b3fce8d76243ad12c6caefa29530e",
      "text": "听说那家伙的朋友，\n去了前阵子的展示会。",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:43ff96a4efa628086d702436a349b271ae61a3717c19ed24a1c8ed8a334710ec",
      "text": "对方还告诉他，看了我们的演唱会之后\n就成了粉丝。",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:45706d5898d36b2345eb3e4f65c715693dfc10abdb74e016157d789819e63e6e",
      "text": "不仅来看了，\n还成了我们的粉丝，真是超级开心啊！",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:c6a4fbf15c687df6c4310e6c123257b99028f40902533622dcf7dcc9107fcde4",
      "text": "啊，听说他也迷上了Star☆Crisp，\n买了好大一堆呢！",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:0d973d62a70203bec2b42b211c888fbd21e1e88ef376b648cf61befec8814f23",
      "text": "工作大获成功呢",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:e44a2d877c0a79060fc10ecf87454529cc6a914da49a56a67c937455064962fb",
      "text": "哈哈，是啊。我也玩得很开心，\n还想再接这种工作啊。",
      "status": "draft"
    },
    "story-text:v1:023har_401_2_4_023_01_09_a:2_4_023_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:e5df9d0d082d744070b347adfba9948e0075dea3eba4b71cfe3d9af4cabffa70",
      "text": "……啊，上课预备铃响了。\n●●●●プロデューサー工作也要加油啊。先挂啦！",
      "status": "draft"
    }
  }
}
