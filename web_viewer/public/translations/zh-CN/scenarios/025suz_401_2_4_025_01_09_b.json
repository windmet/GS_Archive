{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "025suz_401_2_4_025_01_09_b",
  "source_raw_hash": "sha256:fa2bdf8e7a25dd5cf1cdcf02c8815c2355fa7eef8a4dc029c7b9525ffa4e3ba5",
  "entries": {
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:d883ebd929e188c477ba495f263c2f9f5ede157ff4f478ca4529951a9d31e6dc",
      "text": "●●●●プロデューサー，\n这次的服装，超级给力啊！",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:bfc4fff0c1a5b9e7cf8eb17086073e4fe19589cc1be60f0a33923ab40305ed71",
      "text": "小道具也很帅气。\n听说布景也比资料上看过的还要厉害呢。",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:0bc2011062eb8b3468fd65c3cc1d38aed512acf5a60ad2eb528b87496c6a91bb",
      "text": "那可真令人期待呢",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000011:choice_short:000": {
      "source_hash": "sha256:c98cf0e805b7399684a75be08bb29a205ca487f1b1f94e90366eb24943d7f189",
      "text": "感觉会比想象中\n还要专业逼真呢",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:3e3f9a1599517a03a3d04a863ba00566e702d017f9c91d486af3febd39bc5d5f",
      "text": "噢！用火药的角色，\n不正是最适合我的嘛！燃起来啦！",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:280957cf41e14ab345958a3a9016e07ebeac5ee520c0cfbca5865f40ce8979fb",
      "text": "噢！能做出那么厉害的东西，\n工作人员们真不是盖的！",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:f6bbde96ca7b55e9db194d96cfc21fd3ac3a24455e3cb3c36458baf3819711ff",
      "text": "马上就要拍摄了。\n我也得重新鼓足干劲才行了啊。",
      "status": "draft"
    },
    "story-text:v1:025suz_401_2_4_025_01_09_b:2_4_025_01_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:97953156a6bf18c18a3f7e835b27549784a5b2436f2a221dc09fa07274189dcd",
      "text": "为了不输给那么厉害的布景和服装，\n我要帅气地大显身手一把！Burning！！",
      "status": "draft"
    }
  }
}
