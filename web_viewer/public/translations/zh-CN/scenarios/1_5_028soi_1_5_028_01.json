{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_5_028soi_1_5_028_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000010:title:001": {
      "source_hash": "sha256:3b78846b763c17c9ae0e605722f1e4e5457c6e47e456c4e65b681c04a9c29ea5",
      "text": "广播节目客串出演的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:9beffbd146b882d16cc5c35e9938111eaf423486b88bfcbdd5904f7794b19c08",
      "text": "庄一郎先生，确定让您客串出演\n广播节目了！这是台本。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:f9f920c68bcc01df5917bb97ff47e41abdc2d260d7000f0a401a3ce9871244e0",
      "text": "非常感谢。是面向我们这一代人，\n介绍电影和电视剧的节目啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000027:dialogue:000": {
      "source_hash": "sha256:3d2e8ce84982804e775203de038d4102a9bab89936b28a0f912ca284770153e0",
      "text": "……哎呀？这次介绍的作品，\n是我读高中时很流行的电视剧呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:4bb3524b2c6e2537ade905b4ccf3f8e0e0ba24731598379dac9f3272814105db",
      "text": "真怀念啊。●●●●プロデューサー，\n您知道这部作品吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:de6007bdc1a68221a8b364f79e36f83144217fe7e75e6c72c023a21edf1e1cb3",
      "text": "当然知道。是以热血教师为主角的校园剧，\n后来还拍了电影呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:24b56321699782fba3a162171393c355896f3b5078541d64ef5ba053fa40d012",
      "text": "现在也偶尔会重播，\n作为人气经久不衰的名作非常有名！",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:f70cd946230001081ae8ce83e42508f885a81b8f49f78f431c3ce1470b338e44",
      "text": "电视剧版我看过，\n印象中确实非常有趣。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000052:dialogue:000": {
      "source_hash": "sha256:392f7e0fad827bf9c2b7b1d2318082b4320624d0ec68b4470c9704cc73ea5678",
      "text": "但细节已经记不太清了……\n不好意思，能麻烦您准备一份资料吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000056:dialogue:000": {
      "source_hash": "sha256:c066943ece0618c664d3ad86400e976ade35fc3d4a97762af1d52926d249422d",
      "text": "为了能把这部作品的魅力传达给大家，\n我想重新复习一遍。",
      "status": "draft"
    },
    "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000059:dialogue:000": {
      "source_hash": "sha256:5a985764b0659a1042cea95b13c83ad352c88bc4423be7e08a6c793eaa63f8a2",
      "text": "好的，我马上为您准备！",
      "status": "draft"
    }
  }
}
