  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000010:title:001": {
      "source_hash": "sha256:026629a4a0007614ae2cbbf67e51d833beb56f840ebd915923db5be412579d95",
      "text": "动作类不良少年电影的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000015:dialogue:000": {
      "source_hash": "sha256:518d747b7667a8094c8b9d0a1684a231a365228302faaec6d54d06be71ad6956",
      "text": "●●●●プロデューサー，能耽误会儿吗？\n我有件事想跟你商量。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:0f61cb004e3822d2fc7cc4ee4f9635c083feb81f8148d2378fd24677df34c433",
      "text": "好的，有什么事吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:c97153d1499b9b3f7add5642c05829aab87870c9fa46e72e79f741e32886f918",
      "text": "关于下次那部电影的工作，\n我希望能再多增加一些训练时间。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:45650721e20288d01fe694ee456f95212a313d0b32fb23c2e7bea997632d28c7",
      "text": "增加训练时间？\n应该已经预留了充足的时间才对……",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:64cd11bef5e53caffdc1706df9e7336ff376051c2ff05e15fd9c1eb51430aec4",
      "text": "动作戏很多对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:ab2f9a78440b6d7e11b926827b55a70e4903fb19c1c85a3c8174c11612b78e2d",
      "text": "特别是挚友之间碰撞冲突的那场戏，\n动作戏非常激烈。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:5b50f2ba143b9e274ee4f21f1ec088680eba951d70f5786e0022b03a5b8d9b2c",
      "text": "对方很习惯拍动作戏，\n所以我想再多加练习。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:6973d0b5618d1ecd562a171d932d0f9c182b89dc9b19baf0db0a93f733296a65",
      "text": "拜托了，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:f54e126432e1bafb57278d05181ce97329f08cbdf4f5b8981e924a04cdc1f15f",
      "text": "既然是出于这个考虑……我知道了，\n我会去调整日程增加训练课的。",
      "status": "draft"
    },
    "story-text:v1:1_5_038tak_1_5_038_03:1_5_038_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:e98f8b10cc44744098aeb4c59e7251580527d45abd77680a850e44c18f63ec1a",
      "text": "谢了，●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
