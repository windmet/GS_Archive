{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_035mco_2_1_2_035_22_t01",
  "source_raw_hash": "sha256:8a1b91bd313abcbc6f78f70be28bc007d18f668a54dbcc718b406f894b14981e",
  "entries": {
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000007:phone_message:000": {
      "source_hash": "sha256:ebe80cd30fe89c310ec5afffc26973299089a40a02b8dd91b6604a37deb58acc",
      "text": "喂，制作人。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000009:phone_message:000": {
      "source_hash": "sha256:a80c9fc818327f943e6d23616362e4f83d4eea8d7e5aa9a1fc574dbbc25f0535",
      "text": "现在方便占用你一点时间吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000011:choice_short:000": {
      "source_hash": "sha256:6675d6089c919cb09cc4d8d696a0193186f7cc82b9b1af0f491acfdc10f69909",
      "text": "嗯，没问题的",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:bb2feab697fa49f12b58c7a5caf011fc1ef74b740e3c2b292f4954568f5d8942",
      "text": "刚才的事谢谢你了。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:02a06af2e99fd404141f2101659df844d47bfcec0e3cb194d011bc0201658a6d",
      "text": "我听山下君和舞田君说了。\n你也为了调整日程等事宜奔波尽力了吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:e723a47b7540ed99dd818f198acb627117510777b1cea192166211057219f62e",
      "text": "多亏了你，让我度过了一个愉快的夜晚。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:91fb122148efb7d565deac0231dfca9b9ac98e477797f363c86a449767943f20",
      "text": "我也感到很尽兴",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000021:choice_short:000": {
      "source_hash": "sha256:bfd831870efd4d1c6b637b7059151fb86c31eef1bd1adfbf4ec836ffdf61324a",
      "text": "再次祝您\n生日快乐",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_2_035_22_t01:1_2_035_22_t01:cmd-000025:phone_message:000": {
      "source_hash": "sha256:1fa6bbb285cb656fd5e49a4eae26145385df0afa6f1dccec7d97e4fc12d6e750",
      "text": "嗯，谢谢你。\n那么我先失陪了。",
      "status": "draft"
    }
  }
}
