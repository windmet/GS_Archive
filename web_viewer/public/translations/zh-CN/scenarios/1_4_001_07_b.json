{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_4_001_07_b",
  "source_raw_hash": "sha256:b19ab8d3da300ebacee47b3a61898377c939a862df73c671d6366b594aa904b0",
  "entries": {
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000018:time_caption:000": {
      "source_hash": "sha256:7aac503eb03fe05bdd73623ef1f5c7785fe2cd542704d71f8087791dc7fdea59",
      "text": "唱片店",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000030:dialogue:000": {
      "source_hash": "sha256:607322bbc0188bc2268d1f7898134360d1df0aa31d55aef141593a6c51bd21fa",
      "text": "哇啊，这里就是唱片店！\n这是吉祥物的毛绒玩具吗？好可爱！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000040:dialogue:000": {
      "source_hash": "sha256:6de9e520fe84e8c5f2a5c58937640faf0cb38f187df4e36e5bb9a867609d3d96",
      "text": "货架整理得一目了然，\n宣传板的设计也很讲究啊……",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000046:dialogue:000": {
      "source_hash": "sha256:d381bec65e7f51bf0575fb78a2dd1a644c33ff2a074fa080e00c01444f3f8d5d",
      "text": "宣传板的内容也很棒哦。\n你看，像这个……",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:e6dc844ad437d3ec0d2ab782bc2fcf0cb340bd7a32768eb0558a25e40827f125",
      "text": "这位偶像的世界观非常积极明快。\n文案和设计都很好地体现了这一点。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:d839506df51783106681d81671f7f59da6c957809bab096a4f4c032b00c5d0dd",
      "text": "刚好也有试听用的CD呢。\n皮埃尔，有兴趣的话听听看？",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000078:dialogue:000": {
      "source_hash": "sha256:a8fd86d23e2ad8a21912cf51de4a6ff256c07739ed98f9c7e0cd3ef55152f106",
      "text": "嗯！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000090:dialogue:000": {
      "source_hash": "sha256:40b28768ad773575bfe21484329c0e62d9860f5f44449e2af5f9bd84d7a9bead",
      "text": "哇……这首歌，超级闪闪发亮！\n恭二也来听听看这个！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000118:dialogue:000": {
      "source_hash": "sha256:5d87bba868a946f08f9a4725ad36618785add0c18212b1e0dffa45aa4bb4110b",
      "text": "其他受瞩目的偶像是……嗯？\n那个板子是……",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000139:dialogue:000": {
      "source_hash": "sha256:aadd7541c9a984c560c93f325790a60a174c51ea91f74830508dd1702a275805",
      "text": "“店员推荐的新人偶像”？\n……咦，有我们Beit的名字。",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000146:dialogue:000": {
      "source_hash": "sha256:2851dcb5eba57e21f89bf9c6b6dae5f85964ddc5159a58c346dc90e3c2d00d36",
      "text": "好厉害！\n上面写了我们的事！",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000155:dialogue:000": {
      "source_hash": "sha256:b7d158fff4ded58c3bc80837fc973a48da587def9d3b424899f70c69f748d125",
      "text": "是前几天引起话题的视频啊。\n排版得很漂亮呢……",
      "status": "draft"
    },
    "story-text:v1:1_4_001_07:1_4_001_07_b:cmd-000163:dialogue:000": {
      "source_hash": "sha256:c86c0678622d6a401f751be466a61471ad57af5d4395421714aa50582e6b834c",
      "text": "居然有人对还是新人的我们这么关注。\n真让人高兴啊！",
      "status": "draft"
    }
  }
}
