  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000010:title:001": {
      "source_hash": "sha256:997f7f9d65a41c8526380d41f75d10b616dcaa3567573831dc695fca7ff5cda4",
      "text": "校园电视剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000015:dialogue:000": {
      "source_hash": "sha256:17d0df9286649d98128f8a28a759dbe614af83e56f87dd83fde7588460cdfa0b",
      "text": "辛苦了，●●●●プロデューサー！\n你是来看我的情况的吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:88594dfbd986ee395f936cc4e5af801481ca5331766d0c800c302bcdb4dc9507",
      "text": "辛苦了。嗯，听说凉先生正在为\n电视剧做角色塑造，所以带了慰劳品过来。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:859e3c0bb88d86b518f19537f842b69a65b6cab38ec89b2ee08b67e47a151d3f",
      "text": "非常感谢！哇，这个！\n是我演的那个角色经常喝的果汁！",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:4ba6d919270741a6b4a424376f070a0ed301152dd81ed97503c1ad069427182f",
      "text": "听到您之前提过，为了融入角色\n最近经常喝这个。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:bccb7a7af3bb0ad8d27b77a1d873d5e84b28ed946936d670e90f77dc9e837a81",
      "text": "嘿嘿嘿。原来你一直记在心上啊。\n我正好打算待会儿去买呢，太开心了。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:5ea7ed3de46c1938206112a61a4ecb57a87e96835b23930346bee40cedbb69d4",
      "text": "那我稍微休息一下，\n来尝尝这瓶果汁吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000048:dialogue:000": {
      "source_hash": "sha256:9c2141797e9d54c196579baa1e234421e19c508c992fb6518dc67c10f4136ec0",
      "text": "“呼哈——！活过来了——！\n果然还是喝果汁最棒了呢！”",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000051:dialogue:000": {
      "source_hash": "sha256:2923732449152fe2aeb6003053b1fc08569573b9df8146d79b3c33a9ea1a9301",
      "text": "呵呵，刚才那句是凉先生饰演的学生角色的口头禅吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000057:dialogue:000": {
      "source_hash": "sha256:81cb1f7f13feaede8a5d3061375fdfaef321e641f540ff9f7a150355174f436b",
      "text": "是的。那个，感觉怎么样？\n有展现出校园剧的那种清爽感吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_041ryo_1_5_041_02:1_5_041_02:cmd-000062:dialogue:000": {
      "source_hash": "sha256:4ca444ca74268fecde21ac3beea077691305d69e4be48b7554e2864d014b78ea",
      "text": "有的。让人更加期待正式开拍了呢。\n到开机之前，我们一起加油吧！",
      "status": "draft"
    }
  }
}
