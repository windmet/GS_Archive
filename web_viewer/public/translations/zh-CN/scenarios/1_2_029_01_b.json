{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_029_01_b",
  "source_raw_hash": "sha256:c2b2ed07bce59189edc8a5818f30ec742f6b6fba499b07b87c0d893138e7e18c",
  "entries": {
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000012:dialogue:000": {
      "source_hash": "sha256:2d6b143ca38e6dcb64a769bf0761a944835be4f8863123a830c38c9b7a2067d5",
      "text": "怎么了，阿斯兰先生！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000020:dialogue:000": {
      "source_hash": "sha256:fbb89e9927756546c3e6abf94b9b061e3f90d353e2109bd13882565ba5fbb873",
      "text": "噢噢……吾主，汝来了吗！\n汝之救援之手，吾由衷感激！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:d59f2882d9804ec8944de8a917570a2d67ad8c92944b9e19780afef3097c0cbe",
      "text": "你好——！",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:a2a07bec46f2c7e42be945dd5b1008388da97f7e1cecb6df9b46d00aa9cbeb75",
      "text": "你好！……等等，咦？阿斯兰先生，\n这个元气满满的孩子是怎么回事？",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000035:dialogue:000": {
      "source_hash": "sha256:85c7989be4e95e58b1dcb47a25ffac376de325c5519dc5fe3cbc9fe1d90f69b1",
      "text": "唔、嗯……恐是，迷途之子吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:d50869db32ca6e32bd9101f80f635a6d8b202e3c25a4cc41a005fd7ced2437fd",
      "text": "当吾为准备今宵之食粮，\n开启封印之门扉时，这幼小之人便在那里。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000044:dialogue:000": {
      "source_hash": "sha256:486f7c183e36c356047b30535d8bc236ee1e986dacd19bcf3805a89764234328",
      "text": "虽向守护者们之要塞派遣了使魔，\n却毫无反应……",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:afa36943a0b8d8b27dd3a304beff4caa0ff2363097d0e2dc9e9b485df47177a3",
      "text": "吾便思索着，唯有向主派遣使魔了。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000050:dialogue:000": {
      "source_hash": "sha256:4fe40fcdc68f29d2c63a18a20a57c3555b2cb1ef87a9c1f1ce965f86615a64cb",
      "text": "（守护者们的要塞……是派出所吗？\n这么说来，是打了电话的意思吧）",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000053:dialogue:000": {
      "source_hash": "sha256:7f7aea4e30414e70d00e87918b0dfb2986a445f4016b5ab4cae7e515ccee4213",
      "text": "原来如此，是这么回事啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_b:cmd-000057:dialogue:000": {
      "source_hash": "sha256:27449c57c27190cd14b2c345667136431007bb344a18cffe7c93cf023e8938ad",
      "text": "父母一定会很担心的，\n我们再联系一次派出所看看吧。",
      "status": "draft"
    }
  }
}
