{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_012_03_i",
  "source_raw_hash": "sha256:6eeeaebee62f8757b3db0812e9f3c6a460de34f377fd47f9f521b3e187c0a4fb",
  "entries": {
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000020:dialogue:000": {
      "source_hash": "sha256:eca7c150a93d76a933dbcd78bd2419323d2137484f6e806f504c0966d6e986a6",
      "text": "哎哎～……",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000035:dialogue:000": {
      "source_hash": "sha256:ab1a3fb7f9a11ef190cd733a17ff119bdb8cf3113ba159e72b14025d796f6318",
      "text": "What？Mr. 山下，怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000042:dialogue:000": {
      "source_hash": "sha256:9b8ef7d8a200abd3fcbcec70ce3076629d2cd63fd707139d100d4fabed8f86b2",
      "text": "啊，没有……\n稍微有点……怎么回事呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000056:dialogue:000": {
      "source_hash": "sha256:2e8c0740536d455d82d505a435175f7a0d5779d8fce7a65d987d75394dd49415",
      "text": "（走在前面的，又～是幸运之神吧？\n刚才明明才刚甩开的，不是开玩笑吧？）",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000074:dialogue:000": {
      "source_hash": "sha256:bd708fe35465dbc28159964425891f49e63f7008d4f7147dcac98ac2263d9ded",
      "text": "类。赶紧离开这里，快点走吧。\n不然的话，我的决心会动摇的！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000102:dialogue:000": {
      "source_hash": "sha256:f6edcae7d4151d26ac49392a37bffe42fa42f2c6e07c89511308b2e5d4740660",
      "text": "别这样……等等……",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000127:dialogue:000": {
      "source_hash": "sha256:fb0f34468c56967322751129a56fbc9168e906710dbe1614e3b3b184737af4da",
      "text": "（怎么又在啊！为什么会三番五次地出现？\n难道某种测试已经开始了吗！？）",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000145:dialogue:000": {
      "source_hash": "sha256:58002c6dce85f58ae675a96ec849a17dca96aa873a2321830be283c58bfa5811",
      "text": "喂喂，是贤君吗？\n……嗯，我马上就回那边去！",
      "status": "draft"
    },
    "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_i:cmd-000164:dialogue:000": {
      "source_hash": "sha256:dbb920434fd928544b95c05fc7b71349f894e08a1cb8a167148a460f29b7f20a",
      "text": "（在说什么啊！？下场比赛的赛马预测吗！？\n拜托了，不要再诱惑我了啦～～！）",
      "status": "draft"
    }
  }
}
