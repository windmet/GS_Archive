{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_034_23",
  "source_raw_hash": "sha256:c19f6a70bda1a52ef5abd6727b6dfe273a76008df844b9099f3718956204dce2",
  "entries": {
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:2301a51d567183061dd5dd8ef2df4791f52f14f564e9381f1e8c4d4ca9d1a3f9",
      "text": "●●●●プロデューサー，\n情人节快乐！",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:07d459acc25694298c8491aa97dc0b4dd69a4f758b04359a222eb9772ed7761a",
      "text": "送给制作人的礼物！\n这是花音亲手烤的饼干哦。当点心吃吧♪",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:e088c249e23242b5557ea5e08a969e41f3b4cb4d3cdf1c89fb0400601b84b7a5",
      "text": "因为是情人节，全家人一起做的哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000032:dialogue:000": {
      "source_hash": "sha256:ad094c31936f63bf2f60036f546a82c56d363825bb599d25c42ab27d9bab35db",
      "text": "非常感谢。\n真的超级可爱呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:706677333c8bcfbf52cc5d51db87df5e2fa72e75fc0bebbe6745b2b4e15b47ce",
      "text": "诶嘿嘿，是吧？",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:caab8e243d8e82846481d53280713f826cdc97feee5f39fb5400910492a3b0ed",
      "text": "啊，对了！\n制作人的这份可是特制的哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000049:dialogue:000": {
      "source_hash": "sha256:288819b50863c7896e7d8cb8568e1e742a4fe963a68c678b312d96ecbed48194",
      "text": "看呀，这块兔子先生饼干！\n知道特别在哪里吗～？",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000057:choice_short:000": {
      "source_hash": "sha256:f73f728bcb30ef437493938cf2f8009e29e3d99cb263e5a72cd8d315185bd50a",
      "text": "是耳朵上戴着的蝴蝶结呢",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000058:choice_short:000": {
      "source_hash": "sha256:3da9efe440ab4d5aec41934068ee3b48111eb0275566191fa34405e82b918205",
      "text": "用糖霜写了我名字的首字母呢",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000066:dialogue:000": {
      "source_hash": "sha256:21fc5252e1101be07a913a0fbcef0acdd415669f854e9da6b7ffb1550b4e4fdf",
      "text": "答对啦！\n真不愧是制作人♪",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000072:dialogue:000": {
      "source_hash": "sha256:373971699764d2e7e480edf3c64207063f5914ad920e6e0350157400de49a8a7",
      "text": "形状我也很努力做得超可爱，\n而且味道也是非常棒的哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_034_23:5_01_034_23_a:cmd-000079:dialogue:000": {
      "source_hash": "sha256:af4b5839b5dcc93899393114218191266bca3e13592b5d09fbe6fe859c2a0a50",
      "text": "花音尝了好多好多呢。\n制作人也要满怀期待哦♪",
      "status": "draft"
    }
  }
}
