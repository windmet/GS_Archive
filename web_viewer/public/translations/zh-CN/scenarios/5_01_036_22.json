{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_036_22",
  "source_raw_hash": "sha256:867382a909572f1c81305873a80a51c82d1f8a080b28e9847121db5df11c7778",
  "entries": {
    "story-text:v1:5_01_036_22:5_01_036_22_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:415d409a7eb2c446279a57d52087db4061359b4d5dc2b0f9e2056c527162d9a2",
      "text": "●●●●プロデューサー酱，这难道是\nValentine chocolate吗？Thanks a lot！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_a:cmd-000024:dialogue:000": {
      "source_hash": "sha256:6891c4b6659e769ecd2d204183507dc71cd6e637e9bb75bc34c8111ba5e26886",
      "text": "肚子正好饿了呢！\n我现在就来尝尝吧♪",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:c8fa142ca3fe50c76673b070b7f35b8657f91ff8776f31d64bb48ab864a72869",
      "text": "我开动啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_a:cmd-000038:dialogue:000": {
      "source_hash": "sha256:ab6546505042a74e97a900d26ac55ff2409214c6b677c975e69c529f8e5af4a2",
      "text": "……超级好吃哦，谢谢你。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:94beff2c037d09cd86cc153bac899017d3da93732c8f578b1e8648497e074255",
      "text": "White day我会准备绝妙的回礼的，\n好好期待着哦☆",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000009:time_caption:000": {
      "source_hash": "sha256:07456e7e52562e95ef289f5cc6f2bfebb985d1b0bcdb223938ccbee59eaba07e",
      "text": "Amazing！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:8ff7551042c1fb5b06ed2c0c9b853cbf63db17365fe904559f1f3d4ab98b6b49",
      "text": "●●●●プロデューサー酱，\n辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000021:dialogue:000": {
      "source_hash": "sha256:c2df8f1fd155b031e47760d2931a79cdd819c19b4568c985212694a856e3598d",
      "text": "哎呀？那是……\nValentine chocolate吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:a38e69d4d77ed3f0f24604383d26de9a2741e61be2e27234a767f9320a6deb7b",
      "text": "Wow！谢谢你！\n真的超级开心呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:ed39e162c16a02e7b828c6321fb6e27ea3b855fe6164d5f077ae613ea20c87d2",
      "text": "我整个人都跃跃欲试起来了！\n呐，我现在可以打开看看吗。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000034:choice_short:000": {
      "source_hash": "sha256:248dec2b3028b2662493dccf60ed61bf95f27a9223b533556ece277c9eb59779",
      "text": "当然可以。请尽管打开看看吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000035:choice_short:000": {
      "source_hash": "sha256:682dead94146320ae90c8e225836466633e663e3401d8ec9063d06c487eba424",
      "text": "好呀！要是能合你的口味就太好了",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:4fffa7dac987576b80bcdc56290bfdc51b7ec3054fb2440b1bc6c13350be20ba",
      "text": "Thanks！\n那么事不宜迟……",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000054:dialogue:000": {
      "source_hash": "sha256:5f63bb4262fd76ffb928af386a8e0b49d52745a9db8551a7bceb7398ebf450b0",
      "text": "Oh，amazing！\n看起来超级美味的巧克力呢♪",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000065:dialogue:000": {
      "source_hash": "sha256:b78cc6f5115d0a3c1005cb6ef483c6a0c98a10f7165365eb23038c87948f8901",
      "text": "那么，我开动啦。Umm……delicious！\n谢谢你，制作人酱。",
      "status": "draft"
    },
    "story-text:v1:5_01_036_22:5_01_036_22_b:cmd-000072:dialogue:000": {
      "source_hash": "sha256:c5690f14c5cd55bf8452f8f776697d56fd1e75256cd0d23bd879ba7748d748fc",
      "text": "这份谢礼就留到White day奉上吧。\n好好期待着哦。啊——……呜！",
      "status": "draft"
    }
  }
}
