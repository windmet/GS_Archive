{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_014_03_f",
  "source_raw_hash": "sha256:eab852634c64ba3f4e69977057c874bc1fd540df2a9257c4b46d0c864819c3e6",
  "entries": {
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000020:dialogue:000": {
      "source_hash": "sha256:bcf91aac2d36ba6ea21183a766ed4ab7e568ed1787ac44f6adc8bb6680029e2e",
      "text": "好的，非常感谢！\n那我问问看这个人吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000028:dialogue:000": {
      "source_hash": "sha256:f2d4b9e6e85367275b937c8175b2e40caf1d6d55e33ffae7bbebc31c6e378ac6",
      "text": "那个。不介意的话，就在附近有个可以休息的地方。\n要不要去那里慢慢歇一会儿？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000035:dialogue:000": {
      "source_hash": "sha256:614883c3b644bdfb4dcea076e8a9fee61acdd6f982e893afddd4faac33c398d6",
      "text": "有可以躺下的沙发，也有洗手间，\n各种准备都很……啊，奇怪？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000051:dialogue:000": {
      "source_hash": "sha256:d4fe452726c318d8056a3b00da2ee7a93f436203d6e55dee9d4273eb1c2f84d3",
      "text": "（完全没有反应……啊！\n难道说，是在怀疑我！？）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000055:dialogue:000": {
      "source_hash": "sha256:e2e98ff8ff9a2c5a9a21fee00ae7206e7969869978318abc97a9e4d9007b6d11",
      "text": "（确实，突然要把人带去哪里的话，\n怎么看都很可疑啊～～！）",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000067:dialogue:000": {
      "source_hash": "sha256:3ec2227ec58db8eabfa0ecebc0c4b5a55a56bce3768dd02921a246dfaa669a10",
      "text": "没、没事的，不是奇怪的地方！",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000072:dialogue:000": {
      "source_hash": "sha256:eb8d3e224741d24a357e8805471bbe869456ef782c2c29a60abb48993a739e83",
      "text": "是承蒙关照的、\n叫做315 Production的偶像事务所……！",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000080:dialogue:000": {
      "source_hash": "sha256:58ff07f9198ead35e7a4a896e9c0bb33b722955863bbc6d155cc7ca93b11d2d4",
      "text": "…我正好，就是要去那里的。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000085:dialogue:000": {
      "source_hash": "sha256:58b0e970a7154805b730c7b8b8c1de11e8ba344e7e958f428d8b770162b6c66a",
      "text": "诶？",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000089:dialogue:000": {
      "source_hash": "sha256:5171098c7f6ed205f9bc129ca10e3d3748a4ff4168c42fbe4e3b98bc25b3890a",
      "text": "…去参加今天举行的试镜。",
      "status": "draft"
    },
    "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_f:cmd-000094:dialogue:000": {
      "source_hash": "sha256:3e30faa80de01e9852eb3ab74c01218d43a418628c8b693aac39ccead8429b15",
      "text": "诶诶！？",
      "status": "draft"
    }
  }
}
