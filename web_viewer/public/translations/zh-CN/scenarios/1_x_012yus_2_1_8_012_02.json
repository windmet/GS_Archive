{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_012yus_2_1_8_012_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_012yus_2_1_8_012_02:1_8_012_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:48740f840c0712efd0baa1b98b3ea3ad22bba082433a4d3f0a5ee07c562370bd",
      "text": "到事务所还要好一阵子吧？享介都睡着了，\n监督，陪我聊聊天嘛！",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_2_1_8_012_02:1_8_012_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:d1c041064dd4db1b830384b7b209cf90bdb375f9e37a7804dc03b141974b6ce4",
      "text": "我刚好有件事想跟你说。\n●●●●●●●●●●监督，祝你生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_2_1_8_012_02:1_8_012_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:6cbef8aadcc0bc14e8d0b40b15f9047df023295730d6d4366dea31e3e8ab490d",
      "text": "谢谢您！悠介先生，\n原来您一直记在心上啊。",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_2_1_8_012_02:1_8_012_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:5fad6ddf64dcb03c238b5c4d814b3f1fd6151618e316781f2639b119fdf9f546",
      "text": "嘿嘿，你以为我忘了？我和享介商量了很久，\n琢磨着什么时机说出来能吓你一跳呢！",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_2_1_8_012_02:1_8_012_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:c12777d62c8b94f9d8dd1bcba27946c75fe69c1c818b2d1492ede1d2171042ec",
      "text": "等回到事务所，我们俩还要一起给你庆祝哦！\n敬请期待吧！",
      "status": "draft"
    }
  }
}
