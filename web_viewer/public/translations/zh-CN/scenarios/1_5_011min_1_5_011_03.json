  "scenario_id": "1_5_011min_1_5_011_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000011:title:001": {
      "source_hash": "sha256:ac64026efccf7463cbf4a4adbd00a573d7456fe1c93855760690ad0d212da946",
      "text": "在刑事剧中饰演咖啡店老板的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:11f33fb4f6b486549b11a59742b11a96d4856662e88be68995588090cc90d7ff",
      "text": "“欢迎光临。\n……哎呀，脸色看起来有些疲惫呢”",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:8aa31294781300c5eaae4f880e9e55d841610a9cd6292bdd40b812bda23debed",
      "text": "“是不是又太拼命了？\n有时候休息也是很重要的哦”",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:d05effb1756f522906507d86ee7184dc9baf6249436f0c125c3bcde8df5e196e",
      "text": "“这杯咖啡算我请的。\n请慢慢放松休息一下吧”",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000047:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000053:dialogue:000": {
      "source_hash": "sha256:5c817532244ae74fc6f44172ef5bd6f6b491460c26078d594c0565036d34f6d8",
      "text": "实先生，辛苦了！\n让人感受到了不由得想找您倾诉的包容力呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000058:dialogue:000": {
      "source_hash": "sha256:74dde70733537e4a29ce91c766c031a0fccfda993af33543b70c289360e30e3f",
      "text": "那就好。毕竟我的角色，\n是刑警们经常光顾的咖啡店老板嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000061:dialogue:000": {
      "source_hash": "sha256:bdab89a643127285a5d21bb7af868bbd7c94b9aed6c44ac577edf8b26b3ad6bb",
      "text": "我觉得这家咖啡店，对他们来说\n也是一个能让心灵歇息的港湾。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000064:dialogue:000": {
      "source_hash": "sha256:b0950914f206e062fd494f707b7d9f2d31e8e364e31e619044ed2a34b65f5248",
      "text": "呵呵，是啊。\n离下次录制还有点时间，您打算做什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000068:dialogue:000": {
      "source_hash": "sha256:c452a96484ce947f9ef17f3e8f795480575e25d945e877553e5da6d54ac0b25a",
      "text": "让我想想，去确认一下剧本吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000071:dialogue:000": {
      "source_hash": "sha256:ee7f0a4727fe1ff8581936227fc77c9da668ff9a6174cef7474a4ffc4e7ec15a",
      "text": "好的。\n快到出场时间了我再去叫您。",
      "status": "draft"
    },
    "story-text:v1:1_5_011min_1_5_011_03:1_5_011_03:cmd-000075:dialogue:000": {
      "source_hash": "sha256:c24bcb9a249cb0f148127c7c3d7d5912235047079a3b5aef563fca12aa51b4ed",
      "text": "谢谢。\n拜托你了，●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
