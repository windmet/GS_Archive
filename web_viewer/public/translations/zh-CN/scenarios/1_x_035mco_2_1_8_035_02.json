{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_035mco_2_1_8_035_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_035mco_2_1_8_035_02:1_8_035_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:c6294ffac42239c28880ec1f0e39f3c2c0698ee7c14736d0319d0d682f663543",
      "text": "辛苦了，●●●●プロデューサー。啊，\n不用着急。距离碰头会的时间还早。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_8_035_02:1_8_035_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:88cbebaf6bb944e03a6ba1fa6748ebec046aa4342b0c9adf68d813dc9690dbb2",
      "text": "今天是你的生日吧。在开始碰头会前，\n我特地来向你送上祝福。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_8_035_02:1_8_035_02:cmd-000026:dialogue:000": {
      "source_hash": "sha256:e3b7e8c7caa2c972489c367d8a4fa3863bd08898647caea2f97d2dea10d30632",
      "text": "生日快乐，制作人。\n衷心祝愿你更加展翅腾飞、身体健康。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_8_035_02:1_8_035_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:8bb0d017e8a82c75bcfd63378d4ff0fa881f734d6242af999afc91333fa98557",
      "text": "谢谢您，道夫先生。\n托您的福，感觉接下来的工作也能加把劲了！",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_2_1_8_035_02:1_8_035_02:cmd-000038:dialogue:000": {
      "source_hash": "sha256:b5e2f14b520f01bf67b20d712216ae6a7642f2e53ae7a90990743ea694a67c7b",
      "text": "在今天的工作中，也让我们彼此竭尽所能吧。\n祝你度过美好的一天。",
      "status": "draft"
    }
  }
}
