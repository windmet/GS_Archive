  "entries": {
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000010:title:001": {
      "source_hash": "sha256:fc24ee23f913f602575d646aaa298de605db406663b1dd141ad0ea0a4f3510b3",
      "text": "古典音乐节目担任嘉宾的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:7c9f412221da2bb7c26ec3ecb199b899fbea3e1bb34513f6663e9b22a0be9b5c",
      "text": "辛苦了，圭先生。\n录制很顺利呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:629c67af783d8144e0497258e28d4ea6ad43e0b3634323300ec82a8f1942a790",
      "text": "嗯，是啊。本来我还担心解说嘉宾这种工作\n我能不能胜任……",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:cbf5cefc8bc01237bee8e96d62d9319d7c471646748cb1880606b22803a49a7a",
      "text": "听了管弦乐团的现场演奏后，\n那份不安不知不觉就烟消云散了。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000029:dialogue:000": {
      "source_hash": "sha256:d2d9e515489b532da4ce112644342ae08f842fa5a2c863c63bd42cb7763ee31d",
      "text": "圭先生的点评非常棒哦。\n保持这个状态后半段也加油吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:11eb53b3f061fac7bf14e6a045c7737858e84a2921e15dae9d15f4f826f58ad6",
      "text": "那样发挥就可以了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000036:dialogue:000": {
      "source_hash": "sha256:c5406b7ffd4339f65a4481526450266c862c0b3b9ab824fce4118c53ddf36c8d",
      "text": "完美极了！请将圭先生最真实的感受\n直接说出来就好。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000041:dialogue:000": {
      "source_hash": "sha256:50c2ce0e41d78a3a307d02386a900a4c54c1444089cb4b3199e37a3fc538a5e3",
      "text": "谢谢你。我会那样做的。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000045:dialogue:000": {
      "source_hash": "sha256:db4ac4dfb039b339ab7399dffaf072603463c7cd077618ddb04107d3ae108231",
      "text": "休息时间差不多要结束了吧。\n后半段我也会加油的。",
      "status": "draft"
    },
    "story-text:v1:1_5_007kei_1_5_007_04:1_5_007_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:af78e6406206cae72f88b0c71910dddf6e6af6de7eed6ab2b3a2397e80661f82",
      "text": "好的，拜托您了！",
      "status": "draft"
    }
  }
}
