  "entries": {
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000010:title:001": {
      "source_hash": "sha256:4efeaaa5e9c72c883dcda095b44be18d7febafde3df829d5752e1157ed5dc584",
      "text": "时尚类应用广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:9a4446330b1f5326dd6c4014c657c9f7f4b61f48976bf6f5ed3160e976e992cb",
      "text": "夏来先生，收到了穿搭搭配应用的\n广告邀约！",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:7c080c81a50aa004ea346e198bcf6ede0f3d1c5e70220fb6760d92fd2c68b891",
      "text": "时尚、穿搭应用……\n……那个，是什么样的应用？",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:afdef0fe64d4a3cb1bc2f4a66a2124d39849f10d9b660b1f7c6810534671ede6",
      "text": "我们来实际用用看吧。\n就是这款应用。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:b0e39311a3edb9cd4858c40ce84984208e46dcb080f84a921abfa75466ad6563",
      "text": "挑选心仪的穿搭图片后，\n可以直接跳转去结账哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:7d3eaad6567afcb51ecd7087cd1403a410ddd4898c3da38813d7090a846d461c",
      "text": "……不仅可以按服装风格分类，\n还可以按预算和整体感觉来选呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:3c9e8f90c94bd5855e7d01908c1497b346165a5096623edbcdafe8c45d1b3867",
      "text": "不仅是喜欢穿搭的人，\n不擅长搭配的人用起来感觉也会很顺手……",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:7e39961f97e7784e0fc1187c50b476d9861db39212f080b014d3d0fd030c0cf3",
      "text": "啊……这件衣服，感觉很适合旬……\n这边的衣服也……不错。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000048:dialogue:000": {
      "source_hash": "sha256:5cdfd7de5de384d18299c4f5419283e2cd5b37736b08a73cd325c975844a8809",
      "text": "……●●●●プロデューサー，\n我能再看一会儿吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:abfdec3f4fa74ae1fc3ad2222c7b1a6768375c3292e28d8c6e7cebbab5b5c334",
      "text": "当然可以！\n想看多久都可以哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_022nat_1_5_022_03:1_5_022_03:cmd-000054:dialogue:000": {
      "source_hash": "sha256:608b03dd00dc905cf54d9984798b4de02c8557a50d3341d0ca5791a23ec3db34",
      "text": "……嗯，谢谢。",
      "status": "draft"
    }
  }
}
