{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "042dai_403_2_4_042_03_09_b",
  "source_raw_hash": "sha256:04e0821770abe94eec2dba70a2cbd94e4f5511798d1aff56b0fb593ab89824c2",
  "entries": {
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:1a5a03b02744938ee622514db1d742790b61b6e3757fa1388008bf503309c81f",
      "text": "●●●●●●●●●●老大，辛苦啦！\n忘年会直播的资料，俺刚才看完了！",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:75edb66d056285a2f60a1866b74fb18c175d89800989d9266555e780e03a28d7",
      "text": "上面不是写着在迷你环节里大家要一起玩游戏吗？",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:bf2cc4451ed7a5093c14d8c87206b0191c89cf89230ae27ef10e9e8c07232ad1",
      "text": "玩什么游戏，已经定下来了吗？",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:a7e50b2fbcd0f7580d8a05c7c9a3dbd1921c455ae2ebc21d11e446da92f2a2cd",
      "text": "要玩桌面游戏",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:75366ce36013c6406e8f4aed0d9b196dcfe4adb49c5c10a7fff2861f385f3efb",
      "text": "打算用扑克牌",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:162e5ea55651a476f79674cac8c76c45f817b5df4024cb7efca214f62be038ea",
      "text": "哦哦！\n这样的话大家肯定能玩得超起劲的！",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:e5059d476a9255590bac67e998fb38ad68913d1e368ee84b6f887cfbe966ccd8",
      "text": "虽然和格斗游戏又是完全不同的较量，\n不过为了能大显身手，俺也要好好加油！",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:a65f47d09b7eb0371f40e36c510da78aa404d76dea1418bf8abbd64355e770a2",
      "text": "直播前俺想特训一下，游戏详细内容\n定好了之后能告诉俺吗？",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:06bb78f986de9ce486bb21bf362dda58d44540595cd72307992a47dd44bcda00",
      "text": "因为这次直播的成员阵容，\n感觉都相当难对付啊。",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000025:choice_short:000": {
      "source_hash": "sha256:9c3e0eab7135bbf0124c363d162784a0708abfe045d94917138ffb36a58b21a3",
      "text": "当然可以！",
      "status": "draft"
    },
    "story-text:v1:042dai_403_2_4_042_03_09_b:2_4_042_03_09_b:cmd-000028:phone_message:000": {
      "source_hash": "sha256:35a013f1b864386ed0686fb5f5b0ea3ea12ca2590c3d9d2383339fe8cee8f3e6",
      "text": "太感谢啦，老大！\n玩什么游戏，俺现在就开始期待了！",
      "status": "draft"
    }
  }
}
