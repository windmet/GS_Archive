{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "040ren_306_2_3_040_06_09_a",
  "source_raw_hash": "sha256:6206c13894bb3f583a8809fc7bb1de09b297efd53b4d186950c1960c470424d5",
  "entries": {
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:a83af2b6d984cc9ecfc40f85cefb336ef6e79629222c3953bf3c3ee373a6d6bc",
      "text": "啧，活动才刚结束，\n拉面店那家伙就在那训练课训练课地吵死了。",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:477f4e490471efedcc8b437fa1816daa7754818c089b295df96615301e73be16",
      "text": "本大爷才不需要什么训练。\n我可是最强绝世大天才啊！",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:d131a197793559d9a26b1bea23b2784fda44bb5abcfd545b4178eede5c161137",
      "text": "前阵子的演出，也是本大爷最能把全场\n给点燃沸腾起来的。",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:6675d1427a0a257eb4b9fa6def646f2fbc96fd33307dea041d3ee1e3ab346087",
      "text": "是一场超级厉害的演出！",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:fccf3f4d15e97572914b7172eeb331a54788848cc5c499cb5ffe2d418c9e9bfc",
      "text": "哼。算你还识货。",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:0249e30eb671a4f6ca0b1a7e24d70938790c24fd80449803503a2e2def10dc04",
      "text": "喂，你这家伙。\n10秒之内给本大爷滚过来。",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:a956dafab4d5d8778298e6f951f559da04cf6ebfeef3cd07a4b715a33ab165b5",
      "text": "本大爷肚子饿了。\n赶紧给我弄饭来吃。",
      "status": "draft"
    },
    "story-text:v1:040ren_306_2_3_040_06_09_a:2_3_040_06_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:09ce3ac175132d361dd2ee91a9b51881f84d9de8c72a72b7e72b1331ceaeb3ef",
      "text": "吃了饭之后，\n本大爷也不是不能考虑去上上训练课。",
      "status": "draft"
    }
  }
}
