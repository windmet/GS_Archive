{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "045sor_401_2_4_045_01_09_a",
  "source_raw_hash": "sha256:4d5751e9e3909cd7a724230d804741754e032e6287740dda7d879476b1d92c21",
  "entries": {
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:3b7163242743555eaf8b64a38cb08e8abb7ff8fc69815bb44151f61480a6be58",
      "text": "喂喂，\n●●●●プロデューサー～？",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:e2a841776e9394a27ffef4d52cd55fdad6f766f42036b9112be1cde7c9c8782c",
      "text": "我是北村～。\n前阵子的工作辛苦啦～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:5a3305101a9e73dc7ee403b869610c88b020d04ab678f79aee21952e723f6bf6",
      "text": "客户那边的反响怎么样呀～？",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:e3918e106c48c3b44c4d72c9f8187f729eecadefd8be0ae5189c327eefe8372b",
      "text": "对方非常高兴",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:6dd2ebcf2366791b85c025d073f899f912ce0ca4a2dd4528edc03fe3a7f32601",
      "text": "进展很顺利哦",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:4fa28f8c53affc528dde106d22a96454668984297e0e0cecdabee4fb010a01f7",
      "text": "这样啊，对方能满意就比什么都强呢～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:8d2711ccd87bf40ecd40717dd5b86ab604c562fc51eca65a38f220689cafb65a",
      "text": "结果很不错，比什么都好呢～。\n我们大家的努力也算没白费呀～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:837726aa2fe7d98021ee14536e0d176207ffca2b58f713dd5f5a82795dabbb8f",
      "text": "说起来，我给雨彦先生和克里斯先生\n买了伴手礼哦～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000026:phone_message:000": {
      "source_hash": "sha256:4553e2b6181e723e23cb21de39c32cf7631922de6d78762a0bad57c83b04316d",
      "text": "虽然是画着小动物的马卡龙，我还在想会不会\n有点太可爱了～，但他们都很喜欢呢～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000028:phone_message:000": {
      "source_hash": "sha256:c406659709e246c7e1908524fe5118ea8a87f7cb2c96c7cd0c439f24456c8747",
      "text": "克里斯先生看到画着小猪的马卡龙时，\n居然开始聊起海豚的事，可把我吓了一跳呢～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000030:choice_short:000": {
      "source_hash": "sha256:effbfe17c1afe27e28cff4e79f4978730ba229952f1754ecfbdac9edf6715bb1",
      "text": "很有克里斯先生的风格呢",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000033:phone_message:000": {
      "source_hash": "sha256:6ace465ec6bcc5886cb86bebbd100f3926dafbb7100b9ff24eea38ffd2cb17ad",
      "text": "呵呵，确实是呢～。\n……啊，对了～。",
      "status": "draft"
    },
    "story-text:v1:045sor_401_2_4_045_01_09_a:2_4_045_01_09_a:cmd-000035:phone_message:000": {
      "source_hash": "sha256:76a555c835c6bbc7d641eb2b3cf08531b84059ea4668c650ed70e5c43cba5a32",
      "text": "●●●●プロデューサー，这次的工作也\n多谢您啦～。下次也请多关照呢～。",
      "status": "draft"
    }
  }
}
