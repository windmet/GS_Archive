{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_017_02_a",
  "source_raw_hash": "sha256:3a0288675877306bed08889e07d1ed82733f73eaf7b058998c94dd9bdf0558f1",
  "entries": {
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000000:title:000": {
      "source_hash": "sha256:661ccf74cd2582816f150ad2a08b0e4e8b42729f601c62422fcb48e32a40ed95",
      "text": "惊喜礼物",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:9e15f8953e2c2443c9d2216b9dcffcd03691179543dd2f006990ab8e87c7f954",
      "text": "某天录制的间隙，桐生去向前来录影的熟人师父打招呼，收到了提前给的生日礼物。在回忆着这一年的点滴回到休息室后，不知为何，九郎却让他坐在那里……",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000019:title:000": {
      "source_hash": "sha256:2b09bcd6e18d66980a219b2c252065efab172f9d4ca056860b35d17112afe537",
      "text": "第2话",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000019:title:001": {
      "source_hash": "sha256:661ccf74cd2582816f150ad2a08b0e4e8b42729f601c62422fcb48e32a40ed95",
      "text": "惊喜礼物",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:6e61b7b44959b6bab569cb95d5a75da74466eeb7d5086e745dec4de5103af7d9",
      "text": "各位辛苦了。离下次录制还有点时间，\n大家可以好好休息一下。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:875ea40400632be138a73bfddbb60c823f91ef4b525280e1dd861a2cdc2fc84f",
      "text": "谢谢你，●●●●プロデューサー酱。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:b4d6da9cc33d0c99600d5da7846a842883dfc6d4a6692a7f7fb17b2bc5bace75",
      "text": "既然收到了慰问的点心，\n回休息室后要不要喝杯茶呢？",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000053:dialogue:000": {
      "source_hash": "sha256:1d13fd8526c0733255e0d7b648a34417525becc7b81396d2b96aded45236225d",
      "text": "吾辈要稍微出去一趟。\n点心记得给我留一份喵！",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:67b071783e47ebad8ad128795e97b7e53a41e227b8cebf84c1414f2c2683f9e6",
      "text": "要是去买东西的话，我去就可以哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000061:dialogue:000": {
      "source_hash": "sha256:31a68ab73baa3ea2e73b733ecc32bfa131e79122b5824ad1cb85be12bddca849",
      "text": "是去熟人的休息室啦喵～。\n只是顺便打个招呼马上就回来喵。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:0122726ce7ee3c2a84316b95b94b4c4b5305da2d972573c41ef596a79c4f20b8",
      "text": "啊啊，是这么回事啊。\n路上小心。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:09ef70bc8737febf918009e6cbbc049c7d44c62a202d4cf592a9b93715559272",
      "text": "请在规定时间内回来哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000106:dialogue:000": {
      "source_hash": "sha256:7fb41a139c1ad259d36c7c3e4991981307c931e1789b8c40556ebadd7fbe1f9a",
      "text": "师父，辛苦了喵！",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000110:dialogue:000": {
      "source_hash": "sha256:217df76f54739cdecc99f558384098ab08a68842df2ec68fdc1896efa18e7344",
      "text": "哎呀……辛苦了。原来在同一个电视台啊。\n专程过来真是谢谢你了。",
      "status": "draft"
    },
    "story-text:v1:1_2_017kir_02_1_2_017_02:1_2_017_02_a:cmd-000116:dialogue:000": {
      "source_hash": "sha256:5ab97b339a050f5714db189cb153058ba2ecf1c9d71236c87c3982d757ece522",
      "text": "说起来，你是不是快过生日了。让我先祝贺你一下吧。\n生日快乐。",
      "status": "draft"
    }
  }
}
