{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30016_01_g",
  "source_raw_hash": "sha256:112cc1b404de830899f7e78e3facc3154e6ce9f1195db2f5d04c26e8781019ef",
  "entries": {
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000015:time_caption:000": {
      "source_hash": "sha256:f15646b13b9f99fca4055ea9f9c4e7c45f92d5400293db167ef0ac2ecf5690da",
      "text": "放学后……",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000035:dialogue:000": {
      "source_hash": "sha256:b86b398544cbebde2e2ddb811cffc57b451e5dd94e2cb5caaa857b4e8f88065e",
      "text": "（……真是的，\n把补习的日期记错了一天）",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000042:dialogue:000": {
      "source_hash": "sha256:2c4b9b58bb4c94ddd71a00205d085e57041e96d546bfbb9e6a3641ea4b6d9409",
      "text": "（现在的话，说不定能追上玄武。\n好想问问他那件事啊）",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000054:dialogue:000": {
      "source_hash": "sha256:70b16cf27307ccf9b5d5a4c97ab14ecbda5bf5ab3f260b878449b955a1b2dbb3",
      "text": "找到了。\n……嗯？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000079:dialogue:000": {
      "source_hash": "sha256:7273b01684cf06fc154b901164008830ebaf8bec29f38849c3947652701b01a5",
      "text": "（他在干什么呢？拿着相机对着那种草丛……）",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000103:dialogue:000": {
      "source_hash": "sha256:d1222c3aa7569237d83347c11496a1401f6ad0e462d506cce0729d005f97183b",
      "text": "玄武！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000107:dialogue:000": {
      "source_hash": "sha256:5f8cfbdf04c0f981fc156bae4b1359ec4f65ffc2a66e2a0bc99a1558f9fcd627",
      "text": "噢，是朱雀啊。你来得正好。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000118:dialogue:000": {
      "source_hash": "sha256:5c11c87b7172723b916b1c6d14c469263fd3515062662525a706f5d93d14b646",
      "text": "……嗯？出什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000125:dialogue:000": {
      "source_hash": "sha256:95295f9d8647b077fbb824390228a952a168d0e8257286b3dfed5060c9d67942",
      "text": "噢、噢。\n内个，我有件事想问你。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000131:dialogue:000": {
      "source_hash": "sha256:edd75d42bad236064e1b53c77650a3da3afe19e724b0cd34b4e8084f7a12add6",
      "text": "什么事？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000138:dialogue:000": {
      "source_hash": "sha256:04712cd5b870be80762d5eb809872a3776b39846e8e00f7c518d5290cd4b804c",
      "text": "玄武来这边之前待的地方，\n是个什么样的地方啊？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_g:cmd-000141:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    }
  }
}
