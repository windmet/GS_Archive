  "entries": {
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000010:title:001": {
      "source_hash": "sha256:80476e8fc539da6682e884453fb00703a530120918505e3647563174fe6fd8cf",
      "text": "滋补强壮剂广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000015:dialogue:000": {
      "source_hash": "sha256:95cd062379fc01e794917337e1117e7c867e15bec62e9fef9a74df1523ae385e",
      "text": "这是滋补强壮剂的样品。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:77dcb57d57e88d74492c3528987a578f19555b485e9722d6797a664c30f8cf15",
      "text": "哦，谢谢你，\n●●●●プロデューサー酱。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:f3fc8e0f8a1137b990d3b99fea99a95cab731b6ab53f851e1b24063ce8aedb7a",
      "text": "滋补强壮剂啊……\n真不知道受过它多少次照顾了。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:694841144e6623980867f4ed1d40ed5ea3d6871db38606101eb727bdd3b3f3f6",
      "text": "比如学生时代熬夜的时候，\n还有最近练习练得太猛的时候。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000028:dialogue:000": {
      "source_hash": "sha256:2113000e16b67247a58f8b7f81cbdfff8d878b7f18d477c5ce2db32dfb9ba93c",
      "text": "只要喝了这个，第二天的状态\n可就完全不一样了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:b101b0db2dce846b92c7ec44076bc07a6e5590aa5c86160b8c98f3eefde15d29",
      "text": "状态会不一样……\n喝了滋补强壮剂确实会精神百倍呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:775ce4810b34406f95ad22f862a70561f5553faad05ed8e03d7b0f92e3b11c67",
      "text": "我要是想更努力工作的时候，也喝一瓶试试看吧……",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:7dafcc8953b1393c79e1f48a1319c6874853a9a5d805e6ea310872904dc3a794",
      "text": "是啊。想再咬牙坚持一把的时候喝，\n应该挺不错的吧。不过呢，",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:af3433587ca761d0f029643e738fad98f34dd49b1438a084574574bc2ede58cb",
      "text": "热爱工作虽好，可不能拼得太过头哦？\n凡事适度才是最好的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:41abc568b3e4f7f3801a899ce220603f27f4d7f66afe0c83883b3fbdd150d0c0",
      "text": "啊，说得也是呢……\n那我就适度地加油努力吧！",
      "status": "draft"
    }
  }
}
