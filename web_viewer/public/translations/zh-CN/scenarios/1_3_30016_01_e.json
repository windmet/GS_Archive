{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30016_01_e",
  "source_raw_hash": "sha256:112cc1b404de830899f7e78e3facc3154e6ce9f1195db2f5d04c26e8781019ef",
  "entries": {
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000014:time_caption:000": {
      "source_hash": "sha256:6fb512a54279d51dca428e90d690e09db5bfeec4e1720dd5f175a852419d2b6e",
      "text": "几天后……",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000023:dialogue:000": {
      "source_hash": "sha256:045de37b1028b0a0b6df1cacbd39a7527805767c897033c1a6951afc2320667a",
      "text": "已经拍了这么多了啊。肉包，还有\n喵子……这张是学校的风景吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000029:dialogue:000": {
      "source_hash": "sha256:537f9c8a2bec9773dd4be56b1b7caa33077ea98234a8f81cb8d2204d80f5c574",
      "text": "噢。是平时一直看着的天台景色。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000035:dialogue:000": {
      "source_hash": "sha256:c248d98673bf277bde9a593de449e17a7b21098544336d4da5fbb8f5f022bb9c",
      "text": "虽然拍了各种各样的东西。\n但总觉得拍不出那种“就是这个！”的感觉。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000040:dialogue:000": {
      "source_hash": "sha256:6e8e0bffa3ef696b41cea99f2fd5d24063c36e4ba6cb227e2a47f35ba70d5342",
      "text": "时间还很充裕。在满意之前，\n请尽量多多尝试拍摄吧！",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000044:dialogue:000": {
      "source_hash": "sha256:ce402b41b28a325262dfd477170f5e725022a4ab4a8bab4bba59f13da7d70ca1",
      "text": "前几天我因为另一份工作和卷绪先生一起去\n拍照时，他也同样经历了一番摸索呢。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000056:dialogue:000": {
      "source_hash": "sha256:ce9246f861a083d985af834b5b5e00b0a891dd81c52ee2ea36386dc2c4ea6cdf",
      "text": "●●●●●●●●●●番长。朱雀。\n让你们久等了。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000060:dialogue:000": {
      "source_hash": "sha256:74bd8f6aad1090a4e39ccf2d79cfaa767662f318b401fd548fec7dedfc2a9f64",
      "text": "哦，玄武。比你之前说的时间要早嘛。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000064:dialogue:000": {
      "source_hash": "sha256:ccfd667c544091d353827162aea09e4f8a3488130ee94c57b709cbb5e931f25b",
      "text": "啊啊，事情比想象中处理得更顺利。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_e:cmd-000071:dialogue:000": {
      "source_hash": "sha256:42ba924c5a66abfaeca39eac268c71710b4117229ebf83dd3f6724b53fbe028b",
      "text": "还有些时间，请好好放松一下吧。\n……啊，负责人先生过来了呢。",
      "status": "draft"
    }
  }
}
