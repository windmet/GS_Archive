  "scenario_id": "1_5_010pie_1_5_010_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000010:title:001": {
      "source_hash": "sha256:94444c56327ff6250188b8c45ebccae6b2e0952fb5375a4c1bd518051f33f65f",
      "text": "音乐剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:ed3a54668873063bfc56264a54047b755b52dde9a8bafd5b248352a9d8bf040f",
      "text": "辛苦啦～！\n正式演出也请多关照！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000036:dialogue:000": {
      "source_hash": "sha256:9b7c6d586042ef17743b46979ba8d17f549af7f0d52a212fb8a0d8e9185897df",
      "text": "●●●●プロデューサー，\n彩排，非～常开心！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000039:dialogue:000": {
      "source_hash": "sha256:7166e2e52d12de463801ea53800d2df4ea1e2d949b25a5541507d49e2ec25800",
      "text": "呵呵，舞台上的皮埃尔先生，\n显得非常有活力呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:f6e6be474160e1d4685205660f228c5b9740114d839a2fc13ca7da0a05db9ff0",
      "text": "谢谢！但是，不止演戏的时候有活力，\n不是那样。我和大家在一起，好开心！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:034eda64ec513af52fdf04b81064a454993c6b2e35fee4752709a33ee0b3ce22",
      "text": "彩排结束之后，聊了天。\n我和大家都笑眯眯的。充满了笑容！",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000055:dialogue:000": {
      "source_hash": "sha256:bfe935f3b2f1866c24d09efc6c10c634f98509b6b3dbac621b12809b64a2c33a",
      "text": "皮埃尔先生……刚才去打招呼的时候，\n导演也这么说了哦……",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000058:dialogue:000": {
      "source_hash": "sha256:0250d8d01f90cfc9d16b5d1950baf5edec76f8c46f0569d4e7a5cbf3cc57cdbb",
      "text": "他说就算排练现场气氛紧绷，只要有皮埃尔先生在，\n空气就会变得柔和起来。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000061:dialogue:000": {
      "source_hash": "sha256:cac33a63bd66ec0da37b4b1860ff9fb3cab4fa3b525fccbb632f7b0e22d59f7a",
      "text": "我想是皮埃尔先生的笑容，\n让大家也都露出了微笑吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000067:dialogue:000": {
      "source_hash": "sha256:f548cb331fbc8504d0d9ba214269c0a0583b03428a14acbdd10011e12cc93a71",
      "text": "真的？大家都笑，好开心！\n我、也要变得更加笑眯眯的。",
      "status": "draft"
    },
    "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000071:dialogue:000": {
      "source_hash": "sha256:da45db4803b538fa2108504457be188c3eda27f0b4529dfb7a02b663bcb8e055",
      "text": "正式演出，也要让观众露出笑容！\n欸嘿，噢～！",
      "status": "draft"
    }
  }
}
