{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_001tom_1_8_001_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_001tom_1_8_001_01:1_8_001_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:998e4dc5af277bfc7c91d66ad55ece512c2f554ce0154d40f8da5950ec5ab7be",
      "text": "●●●●プロデューサー在……\n哦，在这呢。早啊！",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_8_001_01:1_8_001_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:9801ac267e5239be56e19788a436e39365fa96fca54b0e2f90f8fe484416e275",
      "text": "早上好，冬马先生。\n今天比平时还要早呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_8_001_01:1_8_001_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:9dc065de185213228b66f10bb64778a35940b8dc1d8facab8d81bca1cc154881",
      "text": "今天不是你的生日嘛？",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_8_001_01:1_8_001_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:d648de6400be8872e97018249c250693a62e442f39e0c0e6aa9d029ccbdf12b4",
      "text": "我还是想当面好好祝贺你一下。\n所以说……",
      "status": "draft"
    },
    "story-text:v1:1_x_001tom_1_8_001_01:1_8_001_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:15ee85cba1623aeb72d376052bf9b59997f85e4eab450e29c942b2b94221821b",
      "text": "●●●●プロデューサー，祝你生日快乐！\n今后也请多关照啦！",
      "status": "draft"
    }
  }
}
