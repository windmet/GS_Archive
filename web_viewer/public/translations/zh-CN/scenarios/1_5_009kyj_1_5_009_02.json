  "entries": {
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000010:title:001": {
      "source_hash": "sha256:1032370a88a6f8dcfc29af4d580e74fc3e90d8d64eb2d166bbc956d21edc60da",
      "text": "手机游戏广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:66fd8f4a5d164b4715a933ae22e9fb8580c97cda4c3f177405e663a386ca66e3",
      "text": "这里是……原来如此，不从这条路线走的话\n就无法继续前进了啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000021:dialogue:000": {
      "source_hash": "sha256:79ee9159a88d212cabb436819267e738ca84d4478fcd03f3fc17214a9fdb0e7a",
      "text": "辛苦了。\n恭二先生，您在做什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:c44b75e7d9023126f37ec4593fc33ef63ccea1fe9c4f7727c1cbcc215c9e5888",
      "text": "……嗯？是●●●●プロデューサー啊。\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000031:dialogue:000": {
      "source_hash": "sha256:4302fe46c8392204cc918c93ee24aa907db7da0c8ed12d91e2e7e2349dcd481a",
      "text": "下次不是要去拍手游的\n广告了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ab155f01799ac4df4275b37dd550343c353f6c7b646fd83ccce6f5d0b5007f84",
      "text": "是的，是一款RPG游戏呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000036:dialogue:000": {
      "source_hash": "sha256:e0ebbcc6618bfe614c02da3e14d469518a2cb91602208e1c1cba0ccada1b16ab",
      "text": "我想着在拍摄前先亲自玩玩看。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000040:dialogue:000": {
      "source_hash": "sha256:0e8492c1b1c6df0d100991229a064d587b6b4097fa92658d9e0588691a8b8b52",
      "text": "结果就彻底沉迷进去了。\n耐玩要素相当丰富啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000043:dialogue:000": {
      "source_hash": "sha256:ef093136dae732403106bd02184070c6613c7478c3729ed5e096aa8bb0e59432",
      "text": "我也看过资料了，\n是一款非常有趣的游戏呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000046:dialogue:000": {
      "source_hash": "sha256:8aff978e6c80f63e40ed53cb86ce076662ff6be7606a664e1ed89b747b0018d9",
      "text": "嗯，希望能让更多人去玩。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_02:1_5_009_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:90d946adb71557b14dd009e00596c22fec0997f6177b9597305ff95c8eee90a9",
      "text": "呵呵，为了能向更多人推广它，\n广告拍摄也要加油哦！",
      "status": "draft"
    }
  }
}
