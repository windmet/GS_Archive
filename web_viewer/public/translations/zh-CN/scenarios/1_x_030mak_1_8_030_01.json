  "entries": {
    "story-text:v1:1_x_030mak_1_8_030_01:1_8_030_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:822e37930145ff52591c2cfdf0d9c342ad2b5022d537234de327a83efd81ddd5",
      "text": "●●●●プロデューサー，\n辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_8_030_01:1_8_030_01:cmd-000015:mobile_message:000": {
      "source_hash": "sha256:b99f1140ab5ad2f82fd535a606beaa1829d7fd0be38e062952fa9cb211386d4e",
      "text": "祝您\n生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_8_030_01:1_8_030_01:cmd-000017:mobile_message:000": {
      "source_hash": "sha256:c3f62a1445ee5f8194d444a7a6fdfb255eefd737db0aa885a51db6eb6756d5ec",
      "text": "工作一结束，\n我就马上回事务所。\n请让我当面为您庆祝！",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_8_030_01:1_8_030_01:cmd-000019:choice_short:000": {
      "source_hash": "sha256:b6cb7a752d9f371065d5e0d433833fdb517cfb3af727713340901fe439946dfa",
      "text": "我会等您的",
      "status": "draft"
    },
    "story-text:v1:1_x_030mak_1_8_030_01:1_8_030_01:cmd-000021:mobile_message:000": {
      "source_hash": "sha256:65a6937227a7ee61c6aae1b6f420aab4801627dce761808d4ba86e25ff3539c6",
      "text": "我也会买几款\n推荐的蛋糕回去的，\n敬请期待哦！",
      "status": "draft"
    }
  }
}
