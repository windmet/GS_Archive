{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_011_22",
  "source_raw_hash": "sha256:9935a79225bba83cc31b6dd97bcf8b453bea033b784d8caf9c59ff192a44b787",
  "entries": {
    "story-text:v1:5_02_011_22:5_02_011_22_a:cmd-000015:dialogue:000": {
      "source_hash": "sha256:42918725b374eb9dce6b696a96dc7a3ecf13eed0df5a8e18309720400f7c3a09",
      "text": "●●●●プロデューサー，现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:03458ce73d814f37201159a18b133896e3b6b5d8576109ff597902408144ae89",
      "text": "白色情人节快乐！\n给，这是回礼哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_a:cmd-000029:dialogue:000": {
      "source_hash": "sha256:de3a8a190447e0dd579fd0409ddd130e114cb295f39acd6e3738fc973a0f0466",
      "text": "因为在情人节收到了那么棒的巧克力呢。\n我挑选了感觉你会喜欢的东西哦♪",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:9bbcfe8c9ad363e7662cd9373c0c9d63b7f94de1967cc781426ed394f2975b9a",
      "text": "礼物里面是什么呢……\n呵呵，拆开之后才能揭晓哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:0f2424e890e26c61ef1f3744a7ecb2b942aaf94093f835e188ec130c31c72f5c",
      "text": "我逛了好几家店挑出来的。\n要是能合你心意的话我会很高兴的。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:c5db83003b47e858e76caab19b473be973d42bb75de700a8d3678700e09a0647",
      "text": "●●●●プロデューサー，辛苦啦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:f330a59864b77919b6917a77a921f902a30c4c461dd95b4e36793d760aeace04",
      "text": "给，这是情人节的回礼哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:332f83a8e90b101ce690fb066aa28b34a4ca39297097fb1755b179507ec05728",
      "text": "遵守约定，我特地为你准备了珍藏的礼物哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000028:dialogue:000": {
      "source_hash": "sha256:1b2d31c72a656f02887c94a43a626387ac1ddb76ba1d53eedd1767acb6baef94",
      "text": "虽然不知道合不合你的喜好，\n但我以自己的方式拼命挑选了，",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000032:dialogue:000": {
      "source_hash": "sha256:7e4ace82ada7b6378d42b92109f3fa579bb8d0d6198a663252afba36935309db",
      "text": "要是能合你心意的话我会很高兴的。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000034:choice_short:000": {
      "source_hash": "sha256:20652153ead15d015ba20b940090ff510f5e2acbc866fbfc32adeb62349c188a",
      "text": "非常感谢。我很开心！",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000035:choice_short:000": {
      "source_hash": "sha256:5c8e6eb3cac0aa985674cf15813eead6fffe69ef5db6793ce8463f51e4c9ee33",
      "text": "我有预感你一定挑选了非常棒的东西呢",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000041:dialogue:000": {
      "source_hash": "sha256:cb8cc1e402a0a0d29d630bc4d86de66a5fe3aed4eb666549acc541d8830b113a",
      "text": "哈哈，你能这么想我很高兴哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000046:dialogue:000": {
      "source_hash": "sha256:81051f26e6709ca6f73341dab175e5b8b94b3e296c259798bc8252de3935af69",
      "text": "那个，等会儿有空吗？\n我想和你聊聊天，可以吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_011_22:5_02_011_22_b:cmd-000051:dialogue:000": {
      "source_hash": "sha256:0e616acb7af91d79d6d863cdaaefdca85a7b7ac045a4d39195f726f6c1e4a339",
      "text": "想着差不多该到歇口气的时候了吧，我准备了点心。\n一边吃一边聊吧。",
      "status": "draft"
    }
  }
}
