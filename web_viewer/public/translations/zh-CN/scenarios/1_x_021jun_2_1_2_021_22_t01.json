{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_021jun_2_1_2_021_22_t01",
  "source_raw_hash": "sha256:6d2c9653361adbe30512e9063d6ed412ae925d6cd12d94b08b4db50376ec1cf9",
  "entries": {
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000007:phone_message:000": {
      "source_hash": "sha256:8acb9f848db0ac911cb38240f9b54a8564706d008987b88cb65e2e8172281bf7",
      "text": "喂，制作人。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000009:phone_message:000": {
      "source_hash": "sha256:d23713b29cdca671fc28f1fa71556f8757b586ece3d6ae8df064b2e387967265",
      "text": "我打过来只是想好好向您道声谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000011:phone_message:000": {
      "source_hash": "sha256:575ec14f95b566cf70eadf4a16d0dc7dcc2537f3bb369d8dbf3bb7092a8e1090",
      "text": "今天承蒙您前来参加派对，\n非常感谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000013:choice_short:000": {
      "source_hash": "sha256:0b29821ce75e8f152b8b1f26f6d0e5c3fbc12b0056edfe5312f91509293be546",
      "text": "派对办得怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:d265a69b4e150c03b30a98623acf76487d471d1c9e6697ce18c36ae07da96c9e",
      "text": "……感觉还不坏。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:99c6429e40b10716c7154ffb372142b678c05c07c481a4cfd3083ba1b63d8720",
      "text": "也能充分感受到大家为了我而竭尽全力筹备的心意。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000020:phone_message:000": {
      "source_hash": "sha256:0c55516f1a07f1cd8f742daa4842f63532da394c85dc1a292ed793f6e76d23c0",
      "text": "虽然平时要是天天那么吵闹会很困扰，\n但偶尔来一次或许也不坏呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000022:phone_message:000": {
      "source_hash": "sha256:7616eb48d6b9c6dad0530d5c697c56c5f853fe1f3232500f7494feabfa7c2ce7",
      "text": "啊，刚才那句话请别告诉大家。\n感觉他们又会吵翻天的。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000024:phone_message:000": {
      "source_hash": "sha256:98c12ba644a7ae85bf2db1385020e17e2ff88c032762642d603e24b19c0d1f63",
      "text": "……我可能说得有点多了。\n今天真的非常感谢您。",
      "status": "draft"
    },
    "story-text:v1:1_x_021jun_2_1_2_021_22_t01:1_2_021_22_t01:cmd-000026:phone_message:000": {
      "source_hash": "sha256:dc14251db59c4047b564d4fd2c549e40a0ad2074f0f815903194d454383ae0c1",
      "text": "那么，改天见。祝您晚安。",
      "status": "draft"
    }
  }
}
