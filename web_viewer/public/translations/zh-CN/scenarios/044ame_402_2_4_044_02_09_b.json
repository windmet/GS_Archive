{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "044ame_402_2_4_044_02_09_b",
  "source_raw_hash": "sha256:2bb26eaa4881f0b4c401af6967947d6f0dc5f465a13fad31778d56c346365407",
  "entries": {
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:938b74bb73d2160dd7dbbf6e0292fae3d0b2e9d7a214a5ca0a39ebe95d8c1675",
      "text": "喂，●●●●プロデューサー？",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000008:choice_short:000": {
      "source_hash": "sha256:d853e51ffaf278558010de19c104ff91c4d2fd67c576eae390b80bbd5c229cab",
      "text": "辛苦了。\n怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000011:phone_message:000": {
      "source_hash": "sha256:644344c7eb353fd52d0d1516f077502b0ec1aad979edbee09ae734b0455678f7",
      "text": "嗯。\n我有件事想问问你。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:142b13d5bfd59c8b1af4575d94ef486a5906904c63e90444603ef87bc96433f0",
      "text": "我之前泡了融入符咒之力的红茶对吧。\n那个有效果吗？",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000015:choice_short:000": {
      "source_hash": "sha256:640dfec1dc1e8851e0ec4da94f4561c6812e433a0427b028e55a3cd085366397",
      "text": "是的，非常有效！\n恢复精神了",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:4f07659f7cf738824475ab0d461a60e43dc75dcdfda8c585faa4fc80e40c4844",
      "text": "这样啊。那太好了。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000020:choice_short:000": {
      "source_hash": "sha256:66b5613a78e10932b508980b1d3ea1e72d0b85a93295a551bb68286e7efd09a8",
      "text": "感谢您为我费心",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000023:phone_message:000": {
      "source_hash": "sha256:6fba302ada4afaaf957992c8f6156008576b8feeed6d6906158884cd1cc9aa2f",
      "text": "哎，小事一桩罢了。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000025:phone_message:000": {
      "source_hash": "sha256:9568b12ce19c1461b99034a2bc715c14d43784c4f171189c140748ce5ec8681d",
      "text": "只不过是给一直支持着我们的你，\n一点微不足道的报答。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_b:2_4_044_02_09_b:cmd-000027:phone_message:000": {
      "source_hash": "sha256:3eaf2276a47a6d0abe01a66a90b33e289ffdabba021ef04d442d5bbb118669d7",
      "text": "累了的时候尽管说。\n不介意的话我随时给你泡茶。",
      "status": "draft"
    }
  }
}
