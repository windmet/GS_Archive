{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_403_2_4_043_03_09_a",
  "source_raw_hash": "sha256:9a57cb018853a5f49306695d75b338cb4d0c992420db89ebefaecb088588a4c2",
  "entries": {
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:6740577f736ccb926275bf4c73d952eed982cfb7cc9f048cf775229a19045b08",
      "text": "……制作人，辛苦了。\n我现在正从男生宿舍往回走。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:3f2a156e3b1995ef008aff4d949c4c18da374cd69c87381175810a5e7359540c",
      "text": "……送牛奶给凉当慰劳品，他说要给我\n做炖菜，我就心怀感激地吃了。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:ea797345d5eaf6f69a1c5c9e1f29265c1a54106e47f9e7e41257235071f7a20c",
      "text": "……刚才大吾也在一起。\n我们三个人把一大锅都吃光了。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:716092cfa848fbc822801db2e76f551d82c208f8b6e0b397962d711850af6f42",
      "text": "……虽然天气这么冷，身上却暖洋洋的。\n甚至想多散散步再回去。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:0ba73ded68c0b665f72739ccd7139b4b25fb9468b78adab0769f4c0f7338dd80",
      "text": "请注意别感冒了哦",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000017:choice_short:000": {
      "source_hash": "sha256:4c6ac1daada9e86e5064c4a3c3d7204a38178bb0da4abb5656f3f2bbc647d3db",
      "text": "请小心别着凉了哦",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:74f1d72153ca48c0981627fc4a48590a8aabc4499c2afb46e67ad7d8a9a463b3",
      "text": "……嗯。说起来，家里应该还有蜂蜜。\n加进热牛奶里喝吧。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000024:phone_message:000": {
      "source_hash": "sha256:8824b28775f5261b26e2bf870d36a9ce872852611d6d092d9d0866d5b7a4cc99",
      "text": "……嗯，我知道。\n回去之后我打算温点牛奶喝。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:a7605d5b13a372a9db1510c9a127837fec9cf9d476b7578ab1ffee7241ff1e7e",
      "text": "……所以，就让我再多看一会儿\n星星再回家吧。",
      "status": "draft"
    },
    "story-text:v1:043kaz_403_2_4_043_03_09_a:2_4_043_03_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:f37602436af6c17387afca2e056b194098cda9e1dd2b8b633235a0439b8505ed",
      "text": "……晚安，●●●●プロデューサー。",
      "status": "draft"
    }
  }
}
