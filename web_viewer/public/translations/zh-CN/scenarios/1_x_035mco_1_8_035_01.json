{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_035mco_1_8_035_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_035mco_1_8_035_01:1_8_035_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:37e0e2c12fab37621ae90abbc91b31dfbf97dab67b0c094fcadc58e4b37499fa",
      "text": "●●●●プロデューサー，辛苦了。\n现在方便说话吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_8_035_01:1_8_035_01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:af5be277474936a487c69c26db722ecbbc0f289161467376978cfb31811ae72b",
      "text": "本来理应由我当面传达，\n但接下来马上有工作，便失礼用电话告知了。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_8_035_01:1_8_035_01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:5681fd80364db7c9aa2db1e825672c6b630e6cc364ca22737f096613160a27f9",
      "text": "祝你生日快乐。愿今天能成为属于\n●●●●プロデューサー的美好一天。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_8_035_01:1_8_035_01:cmd-000020:choice_short:000": {
      "source_hash": "sha256:21b2ba1811e66eef3e01a48e589b379c48c9efa25b3a8354c7e883e04351ba73",
      "text": "非常感谢",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_8_035_01:1_8_035_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:c6f86d4fcb65873a79215c19033149db8134c9ec0daf1867ddb014b5e9c63db4",
      "text": "那么，我先失陪了。\n请注意保重身体，工作加油。",
      "status": "draft"
    }
  }
}
