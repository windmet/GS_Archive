{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "006tsu_403_2_4_006_03_09_b",
  "source_raw_hash": "sha256:e2f13f213037410cc8d38cb56f99b1528f1df3620f4db4da8638f442bed49233",
  "entries": {
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:4d7904b68b9b83d16a09696037e81558fc1ed7c0e8928bfe867c7da19f320504",
      "text": "●●●●プロデューサー，辛苦了。\n情人节CM开始播出了呢。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:4cf91161592f86e9c528c232a29015b01703bc4ecb95bf61379d521d71b995c9",
      "text": "辉先生和薰先生都马上给了我感想哦。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:1ee446cd0a0f163d81d0cd2b4b214214a11661071747f2bd6a13da38b9509871",
      "text": "特别是辉先生，因为去年出演了CM，\n从拍摄前就很挂心我。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000012:phone_message:000": {
      "source_hash": "sha256:05fa149da1d5aa1c5bdb609eeea3b9e82a395ff4f2088c08ec4937654e573210",
      "text": "他们夸我很酷、\n很有魅力，说了类似这样的话。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000014:choice_short:000": {
      "source_hash": "sha256:6a6322fbc2de395e024eef1eb585135a165b0fa13e519df6c82e3fbab1f77146",
      "text": "我也觉得\n正如他们所说",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000015:choice_short:000": {
      "source_hash": "sha256:09a907568e8fe1c59391f1664c0a9e4fa93db5d617c1a6494adbd597df111230",
      "text": "今年的CM也\n大获成功了",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:468983c5d4ffe31bb4f7a4b187593e0bf4bdd2802740a9f787c82a15081003f8",
      "text": "啊哈哈，能被制作人\n这么说，真是太好了。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:644bbe5911f491ffc8806ac264c744d57fab2c8a1ee3f8f57da6d92389113d2f",
      "text": "虽然亲吻巧克力让人很害羞，\n但看成片的话，总觉得都不像我了。",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000023:choice_short:000": {
      "source_hash": "sha256:7e7e7895c2cbca2201a5f7f8b0e80fe27ac75d6ad740a80ab2e842116a1cd0c3",
      "text": "很帅气哦",
      "status": "draft"
    },
    "story-text:v1:006tsu_403_2_4_006_03_09_b:2_4_006_03_09_b:cmd-000026:phone_message:000": {
      "source_hash": "sha256:c788aa0c07e809f65a72b87ac2abdeb06525ec221cf884549b4942ef4a76400b",
      "text": "啊哈哈，谢谢你。\n下一份工作我也会加油的。",
      "status": "draft"
    }
  }
}
