{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "026gen_304_2_3_026_04_09_a",
  "source_raw_hash": "sha256:26390de539b3ff63c8aead3833b8005f7dcad8834031c8370d147abc7d865c6f",
  "entries": {
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:b1377d86e113d7a7e01bff1c25bbbf81df8ddd15d0d2fdff4ed4f6102a4ee881",
      "text": "深夜打扰了。今天一天也辛苦了。\n睡前想找你稍微聊几句。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:cac0ca3692738550f767059f17c0cd142f5cf9afc49afae933b76f1411d4ec6b",
      "text": "我和朱雀一起读了摩托车杂志的最新一期。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:1ab8bb0d77f0126fa37a4683867b9019aa547d9a08b990f78cf56c2275963c78",
      "text": "在我们出演的活动和电影的报道里，\n主编留了评语，让我感慨良多。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:9811befa4672dd2c6304931456e314789ae7264a76683e5fa2f71b6ba6fd3363",
      "text": "毕竟和主编他们约好了啊。\n虽说想早日独当一面，但切忌操之过急。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:314af4ef933d01e19714436b1f27c4e234f2001216fe79128a9608216623e3d1",
      "text": "日进月步，为了能一步一个脚印切实成长，\n今后我也会继续精进的。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:29fb86e98e3afc96731a677ec75f2e5118adcd1ab23ae8aaeabe35fb2090d356",
      "text": "好的，一起努力\n加油吧！",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:d7c2950199ee023e157deff331ca093e2f9d4507163bde3ef0e8754e5775dd75",
      "text": "嗯。有●●●●●●●●●●番长在，可就是百人力了。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:54aff47d61bfa446e17a321b978dc8bfd86926a0e88027ec2952ba5e8096e62d",
      "text": "……哎呀，这么晚打扰你了。",
      "status": "draft"
    },
    "story-text:v1:026gen_304_2_3_026_04_09_a:2_3_026_04_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:a28c852c945c869bc3e93551c3639707d6d139765894ca850c482581cdfcbc76",
      "text": "●●●●●●●●●●番长也好好休息吧。\n晚安。",
      "status": "draft"
    }
  }
}
