{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_043kaz_1_7_043_01",
  "source_raw_hash": "sha256:49f11978b442e5bd0889a0a535d446a1bb261be7f232fb47d253c5e6bee74f26",
  "entries": {
    "story-text:v1:1_x_043kaz_1_7_043_01:1_7_043_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:354810c5bd63288422fa03ed361e89ac0336cbd5516a69cb6a3f3bfbd1349154",
      "text": "●●●●プロデューサー，\n关于接下来的工作……",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_7_043_01:1_7_043_01:cmd-000013:dialogue:000": {
      "source_hash": "sha256:29c5a65613cd7d11e1523dd90ac73e8bacc51ff01b52ff550c868ff10d8750d5",
      "text": "一希先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_7_043_01:1_7_043_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:3d3e5493ce44acbdda78c537239ebb0d605ca99faecb10094d1410e9ed1ad2e9",
      "text": "……啊，抱歉。\n……稍微有点吃惊，没能反应过来。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_7_043_01:1_7_043_01:cmd-000024:dialogue:000": {
      "source_hash": "sha256:c1ad297a8de8728d915106c416648db7cf302b4c58ae5837cf2fdee0f1de20d2",
      "text": "……谢谢。我很开心。",
      "status": "draft"
    },
    "story-text:v1:1_x_043kaz_1_7_043_01:1_7_043_01:cmd-000029:dialogue:000": {
      "source_hash": "sha256:50557cd681d57e9d08f89d8c843d1c7b8eb14763e79935fee6e48fae9dbe5824",
      "text": "……在明年的生日里，为了能让你看到\n比现在更成熟的我，我会努力的。",
      "status": "draft"
    }
  }
}
