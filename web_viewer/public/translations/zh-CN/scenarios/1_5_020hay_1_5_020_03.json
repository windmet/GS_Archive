  "scenario_id": "1_5_020hay_1_5_020_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000010:title:001": {
      "source_hash": "sha256:c0d6117cbbc46e40aa9e4c47f6202a24bf48f93390eea9e218105f40a4d3e305",
      "text": "青春偶像剧的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:5a12d1c51e4b08ab972fda3bac2370934f00a61f91333e087bee3a6aa039ae6a",
      "text": "休息结束后就要继续刚才那场戏了呢。\n要先确认一下剧本吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000020:dialogue:000": {
      "source_hash": "sha256:187e7a272023b940a926809b9ce01ec541b8fc12d629d585cc0702021e124f83",
      "text": "没问题的。\n谢谢你，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:09e3c536284e5137b5cd49fc18c2b0951d2566cf7b12336fca7574c82a0cc9ff",
      "text": "感觉表情有些僵硬……\n是很紧张吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:5a70452586f404e0cc37fe54faedb91c8363b0b205195c3dfc46e21ee3498a0c",
      "text": "……嗯。毕竟下一场戏，可是演朋友的我要对\n主角敞开心扉表达心意的场景嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:1e8c8ed1b397af102a244bf0688c2838b6e581f2e64df91be1f6985db3c8cd78",
      "text": "我很喜欢这场戏。\n第一次读剧本的时候，我都感动得不行。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:6bd80ea0160ba1292ea401ed208b02e3defe702856d6d7685c4f04468ce75669",
      "text": "我也是按照自己的理解，一边琢磨着怎么才能\n把这份心意传达给对方，一边进行练习的。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:3a1956cb0a0c3e1a16cb61c9807b0ef7febc871c8b2c12f1e25a41955bc61811",
      "text": "正因如此，就变得有点担心\n自己能不能演好……嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000045:dialogue:000": {
      "source_hash": "sha256:1c29bcb8810b1b5fb7ad9e07407a6e622d7b81bf6bf691eb507283c273ca102d",
      "text": "排练时隼人先生的演技非常棒哦！\n如果是隼人先生的话，正式拍摄也一定能演好的。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000052:dialogue:000": {
      "source_hash": "sha256:9ce419493af82a8f1b5a36a9665d522c99466a6be94d4983e4ee7f08b45aa39b",
      "text": "……是吗，也是啊。\n谢谢你！●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_03:1_5_020_03:cmd-000061:dialogue:000": {
      "source_hash": "sha256:55e1e4696f0ff6bed92b366e81f234b4fe293dd40f09ff18a0353e86e70ead38",
      "text": "啊，好像差不多该去候场了。\n我会加油的，好好看着我哦！",
      "status": "draft"
    }
  }
}
