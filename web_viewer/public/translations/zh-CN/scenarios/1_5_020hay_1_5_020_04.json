  "entries": {
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000010:title:001": {
      "source_hash": "sha256:8f40f8c89788c7d2dd57df5ba325561819ce0fe4aa86b5e5e31fc28d92c3f2df",
      "text": "音乐广播节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000016:dialogue:000": {
      "source_hash": "sha256:2607f43fb6fe2816618265ea861c1501a62dbb4a7acd72acd65d36de084f49b8",
      "text": "诶？关于High×Joker吗？\n这个嘛……",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:e7e307fa95f1c9ab4b6c8b0b6803a2d3aab1e602c9ead21eed5f5fb3a800cd1b",
      "text": "High×Joker的大家全都是顶好的人，\n在一起相处超级开心的。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:3e5bc3903e774e325b82f822d5d3afe821f3479139f4cc011a788bbcd56d4742",
      "text": "虽然偶尔也会有摩擦……\n但我坚信只要和大家在一起，无论何处都能到达。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000038:time_caption:000": {
      "source_hash": "sha256:4f10f377623d30a2f8e6eef9924c2cd8b7962dcbd80ad5f1e46aca35a570d7f4",
      "text": "录制后……",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000047:dialogue:000": {
      "source_hash": "sha256:66ac97de727219ea5b3b82596838c69fba9a9286df78bec6aa151d79ecc0f845",
      "text": "隼人先生，辛苦了。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:5d50cc9bf60a9ea4174a75dc59455a01c48d62ba2a3729cb25cd5f3d57ce65cd",
      "text": "辛苦啦，●●●●プロデューサー。\n那个……刚才表现得怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000056:dialogue:000": {
      "source_hash": "sha256:1ea748e2f54116175758014a321b3093e31115f6400fda00eba668ec35e1e2bd",
      "text": "充分感受到隼人先生有多么\n珍视High×Joker了哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000062:dialogue:000": {
      "source_hash": "sha256:5f3cdadf0679857be51da93cd58124a2f8f102a8860c7f397b23651a29e4907c",
      "text": "是、是吗？\n特意用语言表达出来还怪不好意思的……",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000066:dialogue:000": {
      "source_hash": "sha256:e30470a686b71efdcea5c1157812c1d93c83c3e65584f4ea2e322b129d9e5b26",
      "text": "不过不好好说出来就传达不到呢。\n我真的非常感谢大家。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000074:dialogue:000": {
      "source_hash": "sha256:46737ec2110c8d660e032b8be356d838331981099361493d232040a2d3ce493b",
      "text": "啊，当然也很感谢●●●●プロデューサー哦！\n今后也请多多关照啦。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_04:1_5_020_04:cmd-000078:dialogue:000": {
      "source_hash": "sha256:6ae870696c175605aa72386add09842ae62e34afc7c427b5660b27dc09f6aea6",
      "text": "好的！我这边才是，请多关照。\n今后也一起加油吧！",
      "status": "draft"
    }
  }
}
