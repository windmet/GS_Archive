{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_002_03_g",
  "source_raw_hash": "sha256:11b4b9560f8164cf8d157d8ca267133ba8fbdb93f1b10125650284748d96d9a7",
  "entries": {
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000014:time_caption:000": {
      "source_hash": "sha256:a8ba5f63568d1a2ab1f0cbe6fd89097aadb0c318b65cba044ff7567676625767",
      "text": "之后……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e8c0015cdb4a261f2a6a47c9e17f7c528ceb2bc7819faa70a7afeb78c6c2deb0",
      "text": "呼……、哈……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000028:dialogue:000": {
      "source_hash": "sha256:028b6e82d6a71f80fea2b5dcc583f7c03ced3310b2ffcf8c0d96217b695c6ab7",
      "text": "哈啊……、啧……",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000037:dialogue:000": {
      "source_hash": "sha256:a98a9e9811f13bfca622fa9eb9ddaa1fbfda5232a6886b10847b2f0849eb3ef6",
      "text": "（脸稍微肿起来了吗。\n偶像的脸明明也是吃饭的本钱，天道那家伙……）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000067:dialogue:000": {
      "source_hash": "sha256:51c3f201e55031b1a31ca3e9c78410914d3f4f298aa8d85d9efd9c29cf5b9a1c",
      "text": "……好痛……哈啊……真是的。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000070:dialogue:000": {
      "source_hash": "sha256:e40d23352d0ea8ca3f85e08f325dcfe22c291f9c969fe74622333cdd856a7870",
      "text": "……喂，樱庭。你为什么\n非要做到这种地步去当偶像啊？",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000075:dialogue:000": {
      "source_hash": "sha256:fd0f5d8e85a4277e30a4f9038a0e009ef702ee88ac4488f3acad0a17acdad685",
      "text": "……与你无关。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000080:dialogue:000": {
      "source_hash": "sha256:d1324effa171856dbfcd85b210b862089749670d28fd61178d2197e4829550e6",
      "text": "……搞什么啊。\n莫名其妙的家伙！",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000092:dialogue:000": {
      "source_hash": "sha256:8d9ace7962b8bd2d85a4a7c974ee591967828156c037d1ab30900e68c2e13dae",
      "text": "（……没错。那家伙的话也好，任何人也好，都与我无关）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000096:dialogue:000": {
      "source_hash": "sha256:826f97b8795e35f6a6f6ceb0ea918b2ee1d06907b4c14810db90f5106330bf58",
      "text": "（我只要瞄准顶峰前进就行。\n……为了那个人）",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000128:dialogue:000": {
      "source_hash": "sha256:71e8ec48dbd1100f502d86180c3231a4b3b8e57b2a4d36672d845907f5cce7fb",
      "text": "很好听的歌声呢。\n谢谢你总是唱歌给我听，薰。",
      "status": "draft"
    },
    "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_g:cmd-000135:dialogue:000": {
      "source_hash": "sha256:751caa660ea8cef0cd2782cd2227bf4b49aad0c3532fcbcadb96171eafc39839",
      "text": "姐姐高兴的话，我也很开心哦。\n为了能唱得越来越好，我会加油的！",
      "status": "draft"
    }
  }
}
