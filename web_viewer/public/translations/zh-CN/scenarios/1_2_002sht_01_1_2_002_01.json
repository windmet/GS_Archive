      "text": "……啊！",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_e:cmd-000042:dialogue:000": {
      "source_hash": "sha256:a3c609b7380b272331bc496d27b931e5e1f100319623e5a238370460ec34573b",
      "text": "制作人，\n当然也最喜欢我了吧？",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_e:cmd-000049:dialogue:000": {
      "source_hash": "sha256:8966349c8a67193020fa27d3d36350d3572ddae1b9212dff40862a7fc5dbd403",
      "text": "要是被问到关于我的事情，\n要多讲一点哦♪",
      "status": "draft"
    },
    "story-text:v1:1_2_002sht_01_1_2_002_01:1_2_002_01_e:cmd-000053:dialogue:000": {
      "source_hash": "sha256:37a397a9ae31c33f0bba7a7c041f7861666f352107988264b9f7673400331f16",
      "text": "当然了，包在我身上！",
      "status": "draft"
    },
