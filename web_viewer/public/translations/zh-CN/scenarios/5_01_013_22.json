{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_013_22",
  "source_raw_hash": "sha256:2e6b10cbea70ec19557958819810f23f8ef442ff43edf44ebe452fb5e90a6763",
  "entries": {
    "story-text:v1:5_01_013_22:5_01_013_22_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:c81fcd168f1c6ce12d82ed3a8b38ca0edf18d58a4d92d6c8c560dd0e1d92e9dc",
      "text": "要送我情人节巧克力吗？哇啊……谢啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_a:cmd-000018:dialogue:000": {
      "source_hash": "sha256:85fa83c49d38ad9e38c86de605d415a0c6fa65ac913c09d59b2b94412132dc8f",
      "text": "我原本没想到能收到，真的好开心。",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:104fedcc040be382da4c040978d3671f7f94a014e8c271af43f7b738e9c6216e",
      "text": "收到●●●●●●●●●●监督送的巧克力，干劲全都涌上来啦！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:b31f9a70ed090378512b13703ab53a9d1657d460b5b113465a4b18c701fa9cc2",
      "text": "接下来的训练课我一定能好好加油了。",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:a981962121c0f4c229113819bb9bc30cc3afe88cf7da967f865e619b82043f0c",
      "text": "下个月我会回礼的，敬请期待哦。那我出发啦——！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000012:dialogue:000": {
      "source_hash": "sha256:38ab241362dcd84bef548ed7df26d2424db7d1caa9bfb6c829edef2c3b1bd6e1",
      "text": "那是情人节巧克力吗？是给我的吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000018:dialogue:000": {
      "source_hash": "sha256:32f728b1f3bd35efe9f21b6439120fc4e6d7cfce652954b3817aa5e675f2f85e",
      "text": "看起来好好吃啊。嘿嘿，谢啦，●●●●●●●●●●监督！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000023:dialogue:000": {
      "source_hash": "sha256:765dfdd5d92c35615a3b74f99f101c3778146f8e7982b89722cb45aac5ed7b9d",
      "text": "明明平时一直那么忙，却还是特意为我准备了呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000030:dialogue:000": {
      "source_hash": "sha256:76f04d12db90e9f718d782f3aa86bcf55bfb8380dece48d07dd9bdb33c4dd59a",
      "text": "该怎么说呢，真的特别开心。这份巧克力，我会好好珍惜着吃的！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:0e0fe514e7755f06d18111d40698ee747ad4dee5fa03d3f103085e4b4bf0b330",
      "text": "监督，下个月白色情人节的回礼，你就好好期待着吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000038:dialogue:000": {
      "source_hash": "sha256:f09845f1310ac4762359309eae20875735e7ef1f71815d4cb386d62321a3580e",
      "text": "我会送出一份只有我才送得出的礼物的。",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000040:choice_short:000": {
      "source_hash": "sha256:1461be5a793f1dfe90462521934d5c7010a6a68abdbc2a6a135fc511e4d549a5",
      "text": "好的，我很期待哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000041:choice_short:000": {
      "source_hash": "sha256:a61df16a0af60e6587abb2f69a7b30921e35d237802e2a49c61ef13094d75b0d",
      "text": "非常感谢！我会好好期待的",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000046:dialogue:000": {
      "source_hash": "sha256:958c84bc2485ef992503144089f60ee174d3871b071683586aa282290e10a920",
      "text": "好——我要构思一份最棒的礼物咯——！",
      "status": "draft"
    },
    "story-text:v1:5_01_013_22:5_01_013_22_b:cmd-000053:dialogue:000": {
      "source_hash": "sha256:958c84bc2485ef992503144089f60ee174d3871b071683586aa282290e10a920",
      "text": "好——我要构思一份最棒的礼物咯——！",
      "status": "draft"
    }
  }
}
