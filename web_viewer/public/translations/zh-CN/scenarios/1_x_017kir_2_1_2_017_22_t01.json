{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_017kir_2_1_2_017_22_t01",
  "source_raw_hash": "sha256:66fcca953948597919c5d682ceae1392a9eac0ab76ca6f3a90f58c230f97026d",
  "entries": {
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000007:phone_message:000": {
      "source_hash": "sha256:2154e7534238177942e88523d99727a7f1f21bd87ba22738e08fe4929504b284",
      "text": "制作人君！喂喂喵！\n现在方便讲话喵？",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000009:choice_short:000": {
      "source_hash": "sha256:7edf5d233a4a792e4c8509e182f3afe9cce956a6d4164b92911c8ac8eac82a73",
      "text": "嗯，方便的哦！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:396c72d1cf708ea187d15d4a5a2bff0b2e465df4a16a96502c6d374e48362d13",
      "text": "今天谢谢你办了那么开心的生日会喵！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:f575a04a774b489a5ce6406056df7f3549001fcfe43397ae2575d54ba0863e46",
      "text": "没想到会为我办得那么隆重喵！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:fe77cb88eebcf4e71e7a9d72b98147412a4dbf3132ab3d9e1dd6e2c261d606c1",
      "text": "好吃的蛋糕和生日礼物，\n全部都让我好开心喵。",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:6761c5d2acc77ff0d5569aa96bc6869b61613366e4930e3af2716382e00974fc",
      "text": "话说回来，你们是什么时候筹划了\n那样的秘密作战喵？",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000020:phone_message:000": {
      "source_hash": "sha256:12b84466339eab7909a3a935155d52ffd2e70d2a21cf286e9b2b95455de39bff",
      "text": "吾辈可是一点都没有察觉到喵。",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000022:choice_short:000": {
      "source_hash": "sha256:5c6a5b81ea8518a1eb3d52660f57c714d1503a58aea9278246421eb700498b2c",
      "text": "惊喜能够成功\n真是太好啦！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000025:phone_message:000": {
      "source_hash": "sha256:47a48fd77c31c6754f6fd096d864fc59fa07c02a3756f563cd831373229a6140",
      "text": "呜喵喵……在开心的情绪当中，\n还有那么一丁点的不甘心呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000027:phone_message:000": {
      "source_hash": "sha256:4ba323247526b75e0f171d2e4c8552d115407dd173dfabd30cd460cc2dfb8dcc",
      "text": "下次轮到吾辈让制作人君你们\n大吃一惊了喵！",
      "status": "draft"
    },
    "story-text:v1:1_x_017kir_2_1_2_017_22_t01:1_2_017_22_t01:cmd-000029:phone_message:000": {
      "source_hash": "sha256:4335968c81a37807f1fd56f7a68a0e7c628bf1c4a0aa24224d0f7e6ac6923fda",
      "text": "敬请期待♪\n那么，再见喵！",
      "status": "draft"
    }
  }
}
