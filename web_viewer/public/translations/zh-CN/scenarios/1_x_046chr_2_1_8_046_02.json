{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_046chr_2_1_8_046_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_046chr_2_1_8_046_02:1_8_046_02:cmd-000005:dialogue:000": {
      "source_hash": "sha256:2740a9fbfe2632fdd6ea8222aca8e9c7dd1fe9a7ba345685e6ba452c2a64cc79",
      "text": "语音留言……1条",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_2_1_8_046_02:1_8_046_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:0a355f4316eb158d3e2a1522d4f45cc4425ef2f84aa9edd7b6805e75e000cc35",
      "text": "早上好，●●●●プロデューサー。\n祝您生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_2_1_8_046_02:1_8_046_02:cmd-000018:phone_message:000": {
      "source_hash": "sha256:3f072027daeca39343c3828ba0b9c1bacd3a9c0d7c3bab0a8764f8b8a3abd05d",
      "text": "豪迈而壮美的涛声，隔着电话也能传达给\n您吗？我现在正在海边迎候日出。",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_2_1_8_046_02:1_8_046_02:cmd-000020:phone_message:000": {
      "source_hash": "sha256:14908859c9356aff33b5d3b99df94b146cae7e552c96afad77dbe6c7754bbdf8",
      "text": "那简直就像在为您送上祝福一般，\n是无比灿烂的光辉呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_2_1_8_046_02:1_8_046_02:cmd-000022:phone_message:000": {
      "source_hash": "sha256:5274e887810530d90dd708258e6014bda698adaadb4c3312519eb7560f7b302f",
      "text": "我拍了照片，等稍后见面的时候\n拿给您看吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_046chr_2_1_8_046_02:1_8_046_02:cmd-000024:phone_message:000": {
      "source_hash": "sha256:15c779e122a4f377a46fb4ed091dff6a74ebe279fd7f2582c8115e67204df328",
      "text": "那么，祝您度过美好的一年。",
      "status": "draft"
    }
  }
}
