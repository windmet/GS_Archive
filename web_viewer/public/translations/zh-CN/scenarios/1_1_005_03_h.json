{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_005_03_h",
  "source_raw_hash": "sha256:7d9aabc45b06754084efdfce09f2e175714e72a7fb74922a162bbc24aee0b64f",
  "entries": {
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000040:dialogue:000": {
      "source_hash": "sha256:9c8ba4d1d9efa3af83397908e39d926fd0932f067f3564365af1364593577402",
      "text": "哦，享介！还有……啊，对了……！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000045:dialogue:000": {
      "source_hash": "sha256:018566643edb3df6829cffffbb51b1fbdddf0750d9756b019c1ef3f4c58f7268",
      "text": "有客人说想见你，我带过来了。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000049:dialogue:000": {
      "source_hash": "sha256:875c1b411a861426e5b4020baa63a79f1bb70f62fedf30c2bec69806b2b978ee",
      "text": "你好，悠介先生。\n我是来继续之前的话题的。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000061:dialogue:000": {
      "source_hash": "sha256:ceb26328610639f7bf64e90add9a911689253abaf366adf3412b848414489755",
      "text": "啊，是那件事对吧。不好意思。\n让我先跟享介单独说两句！",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000069:dialogue:000": {
      "source_hash": "sha256:715ee97025bd539bdafe34f9960b1772fa328cff4c22b975e70559b42246e309",
      "text": "那个啊，享介。虽然有点突然。\n我们去当偶像怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000072:dialogue:000": {
      "source_hash": "sha256:02a6f418a249143fbb49558f31b1c742f7e84f247f02677ee9c571b0309e03df",
      "text": "哈……？",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000078:dialogue:000": {
      "source_hash": "sha256:6804fef0dcde4fa1e81a70b676e2863050a173daaf4c0f00d6789fc79c3eb103",
      "text": "前几天你不在的时候，这个人跟我说\n“感受到了成为偶像的天赋”。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000084:dialogue:000": {
      "source_hash": "sha256:73e198e4a5c05247795f353513e5db4cfe191046b2f45eeb61736ef4f1625454",
      "text": "我觉得好像挺有意思的，\n所以今天想听听享介的意见。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000091:dialogue:000": {
      "source_hash": "sha256:56d402c19caeb137b98c5a403ef9e3e0e95103c0de5dc4f1291d5040ef06c8af",
      "text": "不过，那个……抱歉！\n这种事明明应该更早跟你商量的。",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000095:dialogue:000": {
      "source_hash": "sha256:42ea843c133ca54fc8f3ad1f01d57ae25230b1db3f198e5e7285fb40b6199e9a",
      "text": "我把这个人这个时间要来的事给忘了……",
      "status": "draft"
    },
    "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_h:cmd-000110:dialogue:000": {
      "source_hash": "sha256:25c8c46d041218bf6ef36f422e288747405ae02da788271c17ae7d06eaf4de31",
      "text": "（……等等，你在说什么啊……）",
      "status": "draft"
    }
  }
}
