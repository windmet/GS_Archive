{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_008_03_g",
  "source_raw_hash": "sha256:8d16fd07c45f3250a779fa1c07845eb79a27c06491e4fb222e41e1312c0fcfb5",
  "entries": {
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000024:time_caption:000": {
      "source_hash": "sha256:7783277f4c4878f15e39a63c5df18807d611651ae8ea05dd4ea8afc05b94b633",
      "text": "旧冬美宅邸·钢琴房",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000030:dialogue:000": {
      "source_hash": "sha256:a6f8c0dd26e4ea6f32513c3c050ca9e860785ba6e5f93807db84a856dbe83267",
      "text": "妈妈，今天也教我弹钢琴吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000032:dialogue:000": {
      "source_hash": "sha256:c0c56782657870432c4b531c101fac1636c85ca0c631e747b27f1d00a5f44666",
      "text": "想听……旬弹钢琴……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:fe8977451500884291baedf4463ac1c354ef468b8accf4c5cc59914e0f59badb",
      "text": "好啦好啦。\n那旬就坐到妈妈身边来吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000050:dialogue:000": {
      "source_hash": "sha256:282deafe5a3392d3eb0022b9ae2d0b1e4eeb44a00bbb413c96daa50f0579df89",
      "text": "妈妈，我弹得好吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000052:dialogue:000": {
      "source_hash": "sha256:585a5bfeb0d7f2e73597397687a1957f00da44051c9f44f7abb04ce8aa80a050",
      "text": "呵呵，弹得非常好哦。妈妈能真切地感受到\n你觉得弹琴很开心的心情呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000054:dialogue:000": {
      "source_hash": "sha256:c466175277ef4370b630fa9727828a39ea2ab8a707eacbdb535f1dbd200b849b",
      "text": "我还能弹得更好哦。听听看！",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000065:dialogue:000": {
      "source_hash": "sha256:3c9bd4e0f09f9c01eedc55b5dc5e40946e1958461b37af4226b9ad935da924f8",
      "text": "……旬看起来，好开心。\n旬很喜欢钢琴呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000067:dialogue:000": {
      "source_hash": "sha256:710df96fee80a95472392401cc4757fff497cb2c9f5332e4dd5e95948ce5106c",
      "text": "嗯！\n钢琴和妈妈我都最喜欢了！",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_g:cmd-000084:dialogue:000": {
      "source_hash": "sha256:d695fc9c4a919a6b98de58b260722bcadca3deadced8ecf215534db043ce3007",
      "text": "（……那时候，每一天都很幸福。\n直到母亲去世的，那一天为止……）",
      "status": "draft"
    }
  }
}
