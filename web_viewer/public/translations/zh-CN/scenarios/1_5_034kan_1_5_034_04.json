  "scenario_id": "1_5_034kan_1_5_034_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000011:title:001": {
      "source_hash": "sha256:59a753cc8a927574b39fc2a2b9ae9bbef7069df180e4650a757ea39bbb9b75f8",
      "text": "出演书包CM的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:992840818f2240103cc55143a2774136c921dcad09e71b5fd24ae5371fd1f31c",
      "text": "“哇，好轻巧啊！\n明明这么轻却能装下这么——多东西，好厉害！”",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000022:dialogue:000": {
      "source_hash": "sha256:52c34af0b0b22c12a594568a4575e62096fa42e619f1062118670c3fb5f38029",
      "text": "“每一个都好可爱～\n种类太多了都不知道选哪个了！”",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000026:dialogue:000": {
      "source_hash": "sha256:4448e34e40f5f152cd632b054a6084ac7253e40847770a4574dfddcd9b4980d7",
      "text": "“呐，你会选哪一个书包呢？”",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000039:time_caption:000": {
      "source_hash": "sha256:b778da12e44b043eb3a21bef897722f6e5014accfaf2495bacec6def645c7bcf",
      "text": "拍摄后……",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000044:dialogue:000": {
      "source_hash": "sha256:a7df62449807a339b70aa5f80bcdd08d587d4fd31538fb85c1111247b2de2a95",
      "text": "辛苦了，花音君。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000046:dialogue:000": {
      "source_hash": "sha256:8b6716968d054692fea74d863462e174c2d8c12e65d0f376d3473857dbdb1061",
      "text": "导演也对花音君的演技赞不绝口呢！\n真让人期待正式播出啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000050:dialogue:000": {
      "source_hash": "sha256:0e76b576fee1838cf97da91c42843d2d03f6ae96d94ce52ffb93fe6d87cdb4d9",
      "text": "诶嘿嘿♪虽然拍摄用的是\n很可爱的书包……",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000052:dialogue:000": {
      "source_hash": "sha256:a269d8b301c089bc0e98c8a6a43aea0be281e6217fa21198effb7040136edd9e",
      "text": "但帅气的书包也还有好多好多呢。\n没想到种类有这么多，吓了一跳。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000055:dialogue:000": {
      "source_hash": "sha256:90c83f2e924e1909deb13b9d3592290a4d7ea7c5b415e11a45565f6cec5c8092",
      "text": "背上自己挑的书包，\n去上学肯定会更开心的吧♪",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000059:dialogue:000": {
      "source_hash": "sha256:03f5d8f1e8994c0d5ed95c03c6bbe94b6089e0e028ae236eaf3931368b10d845",
      "text": "呵呵，是啊。拍摄也顺利结束了，\n我们回休息室去吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_034kan_1_5_034_04:1_5_034_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:e1217e5f6a7b5683741a18759c2f6cc7ddf4fb690f85ebd4c198c80b65bcb391",
      "text": "好～的。……啊，对了。\n导演，各位工作人员，辛苦大家啦～！",
      "status": "draft"
    }
  }
}
