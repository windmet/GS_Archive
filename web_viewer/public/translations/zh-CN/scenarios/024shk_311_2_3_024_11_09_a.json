{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "024shk_311_2_3_024_11_09_a",
  "source_raw_hash": "sha256:e7ccbb8f6d09f3c130df8429cf0b2d566a193b14f4cee391f96eb439b818ab2f",
  "entries": {
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000007:phone_message:000": {
      "source_hash": "sha256:a1a7e5fccb35e9f7fb8a20b2cb0245faa9139c55e6d6dfdf53b188150071e43f",
      "text": "●●●●プロデューサー酱，辛苦啦！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000009:phone_message:000": {
      "source_hash": "sha256:84bc3da01239aff78aab93929af3c49170443bc48617fe1824fbae03fe9db16e",
      "text": "前阵子播出的歌唱节目，在同班同学之间\n大受欢迎哦！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000011:phone_message:000": {
      "source_hash": "sha256:8a55a889d35ea76dc5736b4ab55c54dbec9a4ba5857c2cae065c1e0ea5833c9a",
      "text": "连不认识的学长都跑来跟我说“太棒了！”呢♪",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000013:phone_message:000": {
      "source_hash": "sha256:f5963eb319e50c6c116ce22d5da0676516f9d0b8efe951e96bb4522fd86a6aec",
      "text": "还有High×Joker的大家也是！\n都夸我超帅气哦☆",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:10d95547ce769c655285e39f24df1abff867fe815ada02912f92eb193eaebe3b",
      "text": "我在这个组合里，作为偶像\n是不是越来越厉害了？对吧对吧！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:acfd91d0630b712134365f112af275966b530b271b23a3900de7daf5ba38cc19",
      "text": "呜～蠢蠢欲动起来了～！\n好想开演唱会！总之好想唱歌啊！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000019:choice_short:000": {
      "source_hash": "sha256:296607fcd1eb9606e3348d2abcfea0b5b86b0308240e59b8ecefbdcbb0642439",
      "text": "把这份热情倾注到\n工作中去吧！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:f507aebfc22843bab54c53c83bc576d80940ec3372a406188fdce1e1c99b6b3b",
      "text": "好咧！我这就大干一场给你看！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:204ab00978d5d3d1b627e2200cd4ef9bb867e82be3cf3d0d7f64a6690d9d07f3",
      "text": "啊，铃声响了。\n下课时间差不多快结束了，待会儿事务所见！",
      "status": "draft"
    },
    "story-text:v1:024shk_311_2_3_024_11_09_a:2_3_024_11_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:1711b84d9fe8bfa22cbe1b787992adb643e98ac0bfbd1f27c89c8ec48e26f0af",
      "text": "那么，●●●●プロデューサー酱。\n拜拜咻☆",
      "status": "draft"
    }
  }
}
