  "entries": {
    "story-text:v1:1_x_048mom_1_8_048_01:1_8_048_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:711b48223d66c22329fa13a04a303d6c623820a7ff5e6129c4c30f7d6a511c68",
      "text": "啊，是●●●●●●●●●●P酱！",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_8_048_01:1_8_048_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:9fa373d7befe945d57ab8cae6b71e30e7f5ab08ba5674b1fb914519bf4c570ba",
      "text": "今天是属于你的特别日子呢。\n祝你生日快乐♪",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_8_048_01:1_8_048_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:27f23150b330ea41d4afb6398491c51c3ac74b58bafaead242d8687185e86ff2",
      "text": "非常感谢！\n哎呀，您的头发翘起来了哦？",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_8_048_01:1_8_048_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:d0217d3f59e6207cf07e97eec0575179f1632ed08f4ddbd27dfd0245892d69c2",
      "text": "啊……因为我想快点见到●●●●●●●●●●P酱，\n一路急匆匆赶过来的……",
      "status": "draft"
    },
    "story-text:v1:1_x_048mom_1_8_048_01:1_8_048_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:0714b6b1d4c5966d564a6b6ffc6bd581941bbb6f2233bdd99cfdee133b912937",
      "text": "呵呵，今天请让我好好为你庆祝哦。",
      "status": "draft"
    }
  }
