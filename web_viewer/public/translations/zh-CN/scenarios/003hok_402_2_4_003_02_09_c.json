{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "003hok_402_2_4_003_02_09_c",
  "source_raw_hash": "sha256:0372321904e769418fc9f8296401c45152ab41e7cf512c422999be5c96c4ee5f",
  "entries": {
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000007:phone_message:000": {
      "source_hash": "sha256:06b93bf67cb024f9f7c864d0e6e94ada1d017ee754caf13ce9ea93b7a75f79f5",
      "text": "辛苦了，●●●●プロデューサー。\n午饭还没吃吧？",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000009:phone_message:000": {
      "source_hash": "sha256:7d59adeb840ecdc9b7d2d91f61fb46e319b4f9f787cb653dd3bd9e88f6e78e76",
      "text": "现在课程进入了休息时间，\n我们3个人就来了Tamagoya。",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000011:phone_message:000": {
      "source_hash": "sha256:afc5a15ae590c94e5f361077c462b7c4d2969bcc2109331c78d3c113691dde8f",
      "text": "不介意的话，我们也帮制作人买一份\n便当带回去吧。你意下如何？",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000014:choice_short:000": {
      "source_hash": "sha256:877031edc835f225a21c465a6ec8ea702a85b91e5479ebd0e6fb98d1afae3a26",
      "text": "请帮我带一份\n北斗先生推荐的！",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000015:choice_short:000": {
      "source_hash": "sha256:787bb424955925557e358c89fa4db643017851741114660c47cff03e97d27822",
      "text": "请帮我带一份\n每日特选便当！",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000018:phone_message:000": {
      "source_hash": "sha256:d433f1dbb3de15b304a16cf4ce12de073d96088cab842a36b2cccef28c069269",
      "text": "明白了。\n那我买我推荐的带回去吧。",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000023:phone_message:000": {
      "source_hash": "sha256:cb18b8d7a4a4fc5780799509b3e72fc8207cabd4078aaca9510d67d546740ffa",
      "text": "今天的每日特选是吧。\n会是怎样的搭配，敬请期待吧。",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000027:choice_short:000": {
      "source_hash": "sha256:1896787794005c32de333c7dc8eafb891fcb4d6bfab4675d1a66b5a8db5f98c8",
      "text": "北斗先生\n已经决定好要吃什么了吗？",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000030:phone_message:000": {
      "source_hash": "sha256:9acc2167e7cfb32cd502fdf0a55348991735716c3974fac7cfb2aa4ff4d68e37",
      "text": "嗯。为了能挺过下午的课程，\n我打算选一份顶饱扎实的呢。",
      "status": "draft"
    },
    "story-text:v1:003hok_402_2_4_003_02_09_c:2_4_003_02_09_c:cmd-000032:phone_message:000": {
      "source_hash": "sha256:14945abeaa449749bb5bc20b94cfb520c45b081b6b4ed20aa154bb2d28c9b5d3",
      "text": "那么买好便当之后，我就带过去。\n那就待会儿见。",
      "status": "draft"
    }
  }
}
