{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_038_22",
  "source_raw_hash": "sha256:bb855f5cda2e08a95b7cf7c1c6bc0fe2c96a8bd44d8c6fa483b015a7dcdc628f",
  "entries": {
    "story-text:v1:5_02_038_22:5_02_038_22_a:cmd-000014:dialogue:000": {
      "source_hash": "sha256:9dcd09e4d53eb24910ce9b97066b51e390042c032601f47bc5f81d50d517b6dc",
      "text": "●●●●プロデューサー，工作时打扰真抱歉。\n能借一步说话吗？",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:8333b3f60dc43deb7fd67a67219f3be19961a605c009e2534b40ed01590f5289",
      "text": "……刚好是休息的时候太好了。这个，是情人节的回礼。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:367307fa7bdad2567c6444d21f2985a03a075b9c6a3f1670536ab4b58a3d7adf",
      "text": "巧克力真的超好吃的。\n托你的福，我干劲越来越足了。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_a:cmd-000034:dialogue:000": {
      "source_hash": "sha256:2d0e10b50367d4dca10b589d8abfac0862db5525f1efb7d509cb976de5eb34e8",
      "text": "虽然不知道你喜不喜欢，\n但我照着自己的想法挑了一份。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:5d8cce85df08d79e9396b672dbc417601fc3bee0bcb654b70d425dcddea63561",
      "text": "你能喜欢就好了。\n那么，回头见。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000014:dialogue:000": {
      "source_hash": "sha256:263875576e87333db4449510a5f965c547741eb85da4552ec08609b5e9539ef6",
      "text": "●●●●プロデューサー，辛苦了。\n我刚才刚好正想着去见你。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000025:dialogue:000": {
      "source_hash": "sha256:e6aabb0cc1421acb593a4e6609cd711c1cbfcd50b93ef561474011959acc56d9",
      "text": "那个，啊……\n这个，收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000030:dialogue:000": {
      "source_hash": "sha256:4a0c18b029fa5ddfa8453fa3ccb61c036ff6747875dd4ebd06bc5bcb2bfc60c6",
      "text": "白色情人节的礼物。\n之前不是约好要给你回礼了嘛。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000039:dialogue:000": {
      "source_hash": "sha256:5fa47f6c585668a5bffd47cacccfde1fc481dd371f923ba37471871d0f7aa6f4",
      "text": "收到你的巧克力，我真的超高兴的。\n而且味道也特别棒。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000043:dialogue:000": {
      "source_hash": "sha256:65e83f579b8d2f8c18eb35df60b7cd1d23b6dcd3e6f850d8d9cbe2d8f32f59c3",
      "text": "所以……",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000044:choice_short:000": {
      "source_hash": "sha256:4c015bbaacb152b778e29035c283a77994a82402f37c979ab3efbb66163bc0be",
      "text": "心意我已经切实感受到了",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000045:choice_short:000": {
      "source_hash": "sha256:20652153ead15d015ba20b940090ff510f5e2acbc866fbfc32adeb62349c188a",
      "text": "非常感谢。好开心！",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000049:dialogue:000": {
      "source_hash": "sha256:b3b4b9b474aaf87daa7196e53a0cce8c4968322c9a223fb0bafbfef98f316908",
      "text": "……这样啊。\n真不愧是制作人啊。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000056:dialogue:000": {
      "source_hash": "sha256:fd624184783dc42678846afbbff8662fbf7d9068d665ed83eeccd64888e05165",
      "text": "……这样啊。\n你能高兴就好。",
      "status": "draft"
    },
    "story-text:v1:5_02_038_22:5_02_038_22_b:cmd-000064:dialogue:000": {
      "source_hash": "sha256:0963ad3fb4c4fee285f608525b5bdd221cc2819bf4e4a91762c02c75e4fc48c7",
      "text": "礼物我挑了感觉你应该会喜欢的，\n回头看看吧。",
      "status": "draft"
    }
  }
}
