{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_011_03_j",
  "source_raw_hash": "sha256:4246d48205b4aa8745c5feb48fb335b7fc14c430a56944412377b374ef336f64",
  "entries": {
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000028:dialogue:000": {
      "source_hash": "sha256:883cedad33f6f40f738d6676b441445cef306a99a330190e4acaacd0092004b9",
      "text": "花音也超级努力地练习过了哦！\n大家一起加油吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000037:dialogue:000": {
      "source_hash": "sha256:9742640acdcea03455e647dc23166c357b1406b80a8df589f66191d7647286f2",
      "text": "嗯。\n花音君你们肯定能合格的。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000042:dialogue:000": {
      "source_hash": "sha256:13848c12a99d75183783250054fb07b84d63103361fc01c91845dee035ccb164",
      "text": "我虽然也练习过了，但能不能做好呢……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000052:dialogue:000": {
      "source_hash": "sha256:1c823c2765a77d38b280896c24d031cf720ab948fb09eed2ae0514db0b2eefff",
      "text": "啊——真是的。\n你别畏畏缩缩的！给我打起精神来！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000056:dialogue:000": {
      "source_hash": "sha256:10e17465950c4d222e428ac02ec824276a690f2b3ec1f69bf63dfb0b11e3f94e",
      "text": "真是的，志狼君不要生气啦。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000059:dialogue:000": {
      "source_hash": "sha256:dd34c8290e09588253b604156900c385a572990a12b3ff9de64c9da427e71d74",
      "text": "怎、怎么了嘛……",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000080:dialogue:000": {
      "source_hash": "sha256:b6d33e3ce0662325428e61e8eef12df32cf98687ac322e656010d8d1c375c9c4",
      "text": "让各位久等了！\n时间已经到了，请往这边走。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000097:dialogue:000": {
      "source_hash": "sha256:12e3695c43db8839268359cd3df8995dd56474d7a45eaec04e64d4413f7e62be",
      "text": "好、好的。",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000120:dialogue:000": {
      "source_hash": "sha256:57f58bdd30964bfd102650416144858e232d462272f00efd1170ae027a662b82",
      "text": "（呜呜，好紧张……）",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000138:dialogue:000": {
      "source_hash": "sha256:8838042b67a1e6ffd384fdc9cb8ae4e384b25a1264796598e71071832722773b",
      "text": "合格的绝对是我！",
      "status": "draft"
    },
    "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_j:cmd-000150:dialogue:000": {
      "source_hash": "sha256:36f638e50d3ba9115a589660c1e23b7987bb4399f6964845a2d02c6d32d26bed",
      "text": "试镜要加油喽～♪",
      "status": "draft"
    }
  }
}
