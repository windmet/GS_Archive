{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "037jir_403_2_4_037_03_09_b",
  "source_raw_hash": "sha256:efe8934f4079e6b8880c582321318be3b95b4c52384d68d1256a3cc82c1211e3",
  "entries": {
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:c8a322c7ba2682e40adb574dbfbbbcb9dce218f947cc86c344814bf8aa57c895",
      "text": "啊，●●●●プロデューサー酱？\n你看明天的天气预报了吗？",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:844621733b40ca12994b1fdf3f4fdd70eab35f657c67503a72c197ae9673da9b",
      "text": "好像是个大晴天呢。\n说是非常适合户外活动的气候。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:9c63bfa6468fea5497e47ccf61ccccd59089fcce98417a40a4bbe042f854a639",
      "text": "在蓝天下一边享受美味的特色美食，\n真不愧是“青空吃饱饱美食节”啊。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:7ff1b18243883f3b88331ee665daada5d40058e8187a01375ba59f50befbc8f3",
      "text": "预计会有大量的到场客人",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:16b050ec531a7712bae582dca051d2a37d8c354b29594f2df3b9b077f5fd4f56",
      "text": "毕竟是国内最大规模的美食节嘛。\n大家都很期待呢。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:e8fdce59b184a2e888c76be7b2f18de2a2bc42a074af962d4f84bbd0c1192861",
      "text": "我们这帮大叔也得为了客人们好好努力才行。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:b7875f08ec4a6cec5d120d9b345cf97c48882b0f326b0e200eef4b14cf8923d9",
      "text": "剩下的就是，要能稍微尝到一点\n美味的佳肴就无可挑剔啦。",
      "status": "draft"
    },
    "story-text:v1:037jir_403_2_4_037_03_09_b:2_4_037_03_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:7a0ea1b325aebde2a1c384ee54e873ee508da307dff807df28fc273330445d83",
      "text": "那就这样，制作人酱，\n明天请多关照咯。",
      "status": "draft"
    }
  }
}
