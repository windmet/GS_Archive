{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_01_h",
  "source_raw_hash": "sha256:67113d22c8c13cca31c6e6c9e51fc03d9c4b3f7e557c02ce6d98ff5d5a5040ab",
  "entries": {
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000019:dialogue:000": {
      "source_hash": "sha256:06edd50ef7479a7e64dafd961bf3a7da0766c8bf94378a8c94dc1b1fe0b072f2",
      "text": "哇噢！？杂志散了一地。\n玄武，还有你们！上！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000022:dialogue:000": {
      "source_hash": "sha256:b5b20dbf03c04583c34840757f14deaaf5b7b782796ba7738947d3d5e6d6cf8f",
      "text": "噢！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000037:dialogue:000": {
      "source_hash": "sha256:1884c6728c2e720a11a3d28916be9bdff2fcede3360127403a48db2460fe12eb",
      "text": "喂——你没事吧！？\n这散得可真够厉害的……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000042:dialogue:000": {
      "source_hash": "sha256:d12205e50d2140679cafda48b5128fc769abab2eb0caff25126f52f6d795aa51",
      "text": "不好意思，好像是杂志太重了，\n塑料袋裂开了……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000048:dialogue:000": {
      "source_hash": "sha256:e45aa7f46955af736363b23f3d02307acaffea28f8394b278ad102bcbb0c50ee",
      "text": "那我们去那边的店里\n要个新袋子过来！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000056:dialogue:000": {
      "source_hash": "sha256:c6bbeef4e7c56f1526678203fd3c898489a3615d23f42c6ca41fb38c3aeaedc8",
      "text": "那些家伙……刚才明明还在说\n帮人算什么东西呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000065:dialogue:000": {
      "source_hash": "sha256:580cf597b4b4ebd1425faa807e1f7079962bc3be5c338a0a18c924cb5243b1e6",
      "text": "有些事只有去做了才能明白。\n……不对，现在不是闲聊的时候。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000078:dialogue:000": {
      "source_hash": "sha256:57ea39052bb10bd31c68389a8c6f7b7b748feaed86f592424be5357e0d3ed336",
      "text": "嗯，我们也来帮忙捡！\n嘿咻……嗯？这是……",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_h:cmd-000080:dialogue:000": {
      "source_hash": "sha256:17907f4b4c9c1581530d6425daf2941cd7d574e410efd993d85da5b0cf64f83d",
      "text": "怎么了，朱雀？",
      "status": "draft"
    }
  }
}
