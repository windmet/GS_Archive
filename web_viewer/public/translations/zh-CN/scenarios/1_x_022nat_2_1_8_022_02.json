{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_022nat_2_1_8_022_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_022nat_2_1_8_022_02:1_8_022_02:cmd-000011:dialogue:000": {
      "source_hash": "sha256:64e8b91e0eaace3b19531477752b5f423d20e08431f7cd8d0249dbee797eddc0",
      "text": "……生日快乐，\n●●●●プロデューサー……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_2_1_8_022_02:1_8_022_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:6846b9d9a1047aaa5c67f989238502a6a9fd95a85429ea3b9ce196f7b01100b7",
      "text": "今年……我有好好记住日子。所以，\n想着碰头会的时候一定要传达给你……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_2_1_8_022_02:1_8_022_02:cmd-000018:dialogue:000": {
      "source_hash": "sha256:51b75595d6af4c3eca1986c84cf09c7619858a2c6188bd686fe843616ed9327d",
      "text": "谢谢您，夏来先生！",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_2_1_8_022_02:1_8_022_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:755bbab39f2c0b9201e17029985b533fd1a14bf77a2f220c38cdb736797f8756",
      "text": "……没有。\n说感谢的应该是我，才对……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_2_1_8_022_02:1_8_022_02:cmd-000028:dialogue:000": {
      "source_hash": "sha256:c9d66b1bc2c24c0d51b51153595fb3f9d77bca61fa06ebe41fd9de6452e465dd",
      "text": "因为和●●●●プロデューサー在一起……\n旬露出开朗表情的次数也变多了……",
      "status": "draft"
    },
    "story-text:v1:1_x_022nat_2_1_8_022_02:1_8_022_02:cmd-000033:dialogue:000": {
      "source_hash": "sha256:34c8d2a942eefe6d30eb3559cdd329bdc870fed1c147957dfaf8f6b49a4c4fb3",
      "text": "……我也觉得，每天都比以前更开心了……所以。\n谢谢你，呢。●●●●プロデューサー……",
      "status": "draft"
    }
  }
}
