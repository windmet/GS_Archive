  "entries": {
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000010:title:001": {
      "source_hash": "sha256:d707b698bbaf9c7ac5ba34ab827a91a143f31bc62fe5731fe5c4085e10f75315",
      "text": "综艺节目中介绍最新家电的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:7d740735da7e274b872b5f6a7528bc658bec269be4cb449e9c5f26bb2d2ee141",
      "text": "恭二先生，马上就要开始录制了。\n准备好了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000018:dialogue:000": {
      "source_hash": "sha256:24f4da4b25f544bb1ca6df2bea31e6d579fd440de489d71c8605594b5d18b0dc",
      "text": "嗯。是在电视综艺节目的环节里，\n介绍最新的家电吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:b393a95f5c943bcfc2094a163752212b385006ba5f71bde2f62c0ed3f73aa49a",
      "text": "彩排的时候让我试用了各种各样的新品，\n果然还是挺让人兴奋的。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:e946006a2913632e1f2d35f62421dfb0aa6d531d8531383d49fd022e378a7f35",
      "text": "恭二先生很喜欢最新家电呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:96e5c592dc8f53b5676ac05f6d9195dd709d77a81a5a082aaeaaf76bc98fc7d5",
      "text": "嘛……是啊。\n有时间的话一定会去关注。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000033:dialogue:000": {
      "source_hash": "sha256:52b0f33e3078749970b3d59ed81906f40bd03c458ffd38bc521a486ee76bed63",
      "text": "去电器店的时候，\n最新家电专区也是必逛的。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:04196582d6cd6a77c25480da889a82ab45d4483b7104a2950b12afe0d9de28ed",
      "text": "●●●●プロデューサー要是想换新家电了\n也可以跟我说。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000039:dialogue:000": {
      "source_hash": "sha256:4fabe14624074a9ca0e0a2eb112c2e5f1005f3e6b5d7f1b374d9bccff39a7467",
      "text": "我想我应该能给你些建议。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:c5288dd5a5ec45e29b49c085761007344a4654a63f4412a853ca4ce83e958dfd",
      "text": "谢谢！\n到时候就拜托你啦。",
      "status": "draft"
    },
    "story-text:v1:1_5_009kyj_1_5_009_01:1_5_009_01:cmd-000047:dialogue:000": {
      "source_hash": "sha256:875e2c1486ef9897069605249c6fa6a10e007b65e2f2abe154c983025c148490",
      "text": "……好了，好像要开始录制了。\n那我去了。",
      "status": "draft"
    }
  }
}
