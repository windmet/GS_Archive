{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30009_01_j",
  "source_raw_hash": "sha256:0b7f774b23309d281397e2310fb183a676be8651b29082fe6f59cf20259a139f",
  "entries": {
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000019:time_caption:000": {
      "source_hash": "sha256:de032b14ad770092a08e64ee0b7359b1bdf150548e5d96e8eacb1487cc8ae481",
      "text": "次日……",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000032:dialogue:000": {
      "source_hash": "sha256:11890ad2e863a7149b97e9bd3296024bcbc5f6afeba988aa15175b091188c166",
      "text": "●●●●プロデューサー。\n怎么样……？",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000034:dialogue:000": {
      "source_hash": "sha256:c3151b8117beddb63f1969b34d4919711e3447f25ed5290dcf0c49d577f0bdf4",
      "text": "非常合适！显得非常帅气！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000038:dialogue:000": {
      "source_hash": "sha256:1ae938bd610f7db29cf88367bf71ad0e2217dfb394bc1f9f1a9068fc7252c92c",
      "text": "太好了！\n我还担心会不会看起来像过七五三的小孩一样呢！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000051:dialogue:000": {
      "source_hash": "sha256:fdae6349ec5463bb48f00fac8e72733a285f7498036df36aed3b74f014a41c7a",
      "text": "平时难得穿一次无尾礼服，\n总觉得怪紧张的。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000058:dialogue:000": {
      "source_hash": "sha256:b189c383f3a1df3bbd45fe0a353540db7578ac1f50bc27398356914ea0972c92",
      "text": "英雄穿起来也很合身哦。\n要有自信。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000083:dialogue:000": {
      "source_hash": "sha256:ba38d7e5b054b7f6da057c0b523ed235ab3cf943d23c3f1b94896d280e2e2cb6",
      "text": "让大家久等了。\n木村龙先生，请做好就位准备。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000087:dialogue:000": {
      "source_hash": "sha256:c8437da922b05a66a006272ae646cc70f57e96453c9e5b620e3abbd8e90368f7",
      "text": "是！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000105:dialogue:000": {
      "source_hash": "sha256:181ac237e36fab4f4d5b75afa3ba0117bd6ea7fa0702757a574c690a37b1fb37",
      "text": "那么，我先去了！",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000121:dialogue:000": {
      "source_hash": "sha256:723edacfdcce05098b0e1356858d5777de952fb1d2d0fbdc45194244d91cfccb",
      "text": "嗯，去加油吧。",
      "status": "draft"
    },
    "story-text:v1:1_3_30009_01:1_3_30009_01_j:cmd-000125:dialogue:000": {
      "source_hash": "sha256:f9624eee9ea973affff8d08409be2d48432a8b8883e35afb00b62a56ff9acd12",
      "text": "我们就在这里看着你呢！",
      "status": "draft"
    }
  }
}
