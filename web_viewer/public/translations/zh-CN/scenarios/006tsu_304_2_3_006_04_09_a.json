{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "006tsu_304_2_3_006_04_09_a",
  "source_raw_hash": "sha256:1e13e606d73eb4ccbcee5a0eb8ba91462acd19d9b951ec8441216a7db08ca388",
  "entries": {
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:d4ecbbecc40e014a8272185cf3f24b500d980912fda957cdd04b4622ed84b6fe",
      "text": "●●●●プロデューサー，辛苦了。\n刚才和家里人一起看电视剧了。",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:57256d4b390e3239fdf2969897fea085231192b12a613bbe60cdd277cd940e34",
      "text": "特别是妹妹和弟弟看得很认真……",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:84e4398f5e37785834f7244234b3664b62a60ed192e0856b9a85433db64695b6",
      "text": "他们对我说：“哥哥太帅了！”。",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:4d2de26a60ed4f51797fe01938dbd5537f955583cc0fbe66ecf0ad92f421d530",
      "text": "能被重要的家人这么夸奖，\n真的好开心啊。",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:347b18f90bd9ffcb50bc1b51434cefe72d389c6eb7067753619db96da7453349",
      "text": "感情真好呢",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:b73fbf655a052b17cc286ecd03ac3f4fd05136d38327a9b6217a0f2c029995ed",
      "text": "是啊，我经常照顾他们两个，\n自己也觉得我们关系很好。",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:8ee1742a08454c3f951f55c14cfe09e69250526cfaa1e08e76732077281f05aa",
      "text": "为了今后也能一直做个\n帅气的哥哥，我想继续加油。",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:581a043ac6997be527b7c0c25ee1088cd68ab693c1f707e851841194ee3a58bf",
      "text": "啊，不好意思。弟弟在叫我了……",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:d758ed778656fa5413212a83c9405b878301317c18e935f5f1420a56ed8d6d9c",
      "text": "下次，我也想听听●●●●プロデューサー对\n电视剧的感想。",
      "status": "draft"
    },
    "story-text:v1:006tsu_304_2_3_006_04_09_a:2_3_006_04_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:a0cdfcc906a6c50b93585b32df0575dedeea8447f6047e1f0f368791bb1f49ed",
      "text": "那么，明天起也请多多关照了。",
      "status": "draft"
    }
  }
}
