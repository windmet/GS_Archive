{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_02_003_23_5_02_003_23",
  "source_raw_hash": "sha256:3bf3d11a15a67b4fa8f3762ed8b99c69a47898431c4dc311e614f2c002bc96e7",
  "entries": {
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000014:dialogue:000": {
      "source_hash": "sha256:53becfb4b333d2294872cb39eff1a739d4cbe486002561269f26c0193b82c948",
      "text": "辛苦了，北斗先生。\n让您久等了。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000018:dialogue:000": {
      "source_hash": "sha256:7a559331d1a2eea11508dac9d3ddc532e9c085b57300e0efa594086a7aa14dd5",
      "text": "工作辛苦了，制作人。\n我也刚到不久哦。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000021:dialogue:000": {
      "source_hash": "sha256:9cf30634f698e08ad2d74f9ff236277105e10c97bf1a558613e2cb55fd53eae6",
      "text": "因为距离预约好的店铺还有一点路程，\n我开车载你过去吧。请往这边走。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000024:dialogue:000": {
      "source_hash": "sha256:f282e22ea03a2f818baf062f223207ea30067052d0fbca8328b30c2b9da3f5e8",
      "text": "好的！麻烦你了。\n很期待北斗先生推荐的店呢！",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000030:dialogue:000": {
      "source_hash": "sha256:c406b6032474093aac761602d70f88241be5bd3277e801ca8fa85807d65e4ab8",
      "text": "作为白色情人节的回礼，我准备了格外特别的东西哦。\n那个也请满怀期待吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000034:dialogue:000": {
      "source_hash": "sha256:f71321a6760c5604aac07e6d3935714a1d5e9398937be22a8c4a3782bb6905bf",
      "text": "居然连回礼都准备了吗。\n真的非常感谢！",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000039:dialogue:000": {
      "source_hash": "sha256:1775a849d73bd1a25191584e4fa17287dd09c94bfa2776fd81aec3d126233b1f",
      "text": "我还觉得这都远远不够呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000042:dialogue:000": {
      "source_hash": "sha256:0cf48a49ee1e80a7baafc1890259824cf263c36bbcde2231bce757913d175b84",
      "text": "毕竟在情人节收到了你送的\n那么美妙的巧克力呢。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000047:dialogue:000": {
      "source_hash": "sha256:6f1f0541342f8073b81a168dae81da9580b582b001a7518afec295f279ca0cd1",
      "text": "请上车吧。",
      "status": "draft"
    },
    "story-text:v1:5_02_003_23_5_02_003_23:5_02_003_23:cmd-000055:dialogue:000": {
      "source_hash": "sha256:c919de7fb61b398dbca34b290c73259b11df11a694abeaeebc2535872dd39479",
      "text": "那么我们就出发吧。\n今晚我一定会为你奉上一段美妙的时光。",
      "status": "draft"
    }
  }
}
