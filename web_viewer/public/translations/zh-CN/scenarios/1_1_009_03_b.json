{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_009_03_b",
  "source_raw_hash": "sha256:58e91dcdcec6ba4f758d31b67e7b46ff975d47d9b34a7bd0284319e4c5c42c0c",
  "entries": {
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000021:dialogue:000": {
      "source_hash": "sha256:8e01f024d6de5a8b00fc3d9079a18f2b29e78eb884579737a0b22da2e4d6c72b",
      "text": "没想到身边就有偶像粉丝啊。\n问问看果然是对的。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000027:dialogue:000": {
      "source_hash": "sha256:36de8f0300e29e1f974abbea3c0648c94b2189ff5e5873952a8ea1b998c6a272",
      "text": "是啊！\n多亏了那家伙的姐姐喜欢偶像！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000033:dialogue:000": {
      "source_hash": "sha256:0a4e04737c67257c0708b1cde9cbe9ba4411d4a55efcf9ccc1531bb6f0b58042",
      "text": "既然持有两份一模一样的东西，\n看来是相当狂热的粉丝吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000037:dialogue:000": {
      "source_hash": "sha256:95caaa7e19ddb6d0ab8cc4be2e5dd31eecab801e5ee70cb00e905ac246dc308e",
      "text": "说明这个偶像有这么大的魅力吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000045:dialogue:000": {
      "source_hash": "sha256:c3aeba3eb47e164fe66bc4b887d192a72389807f9ff8f2cee3c4af05c031dbb2",
      "text": "咕～真想快点看看有多厉害！\n学校能不能快点放学啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000052:dialogue:000": {
      "source_hash": "sha256:eb2c2d2b0f17bb1f75effe301ac2538ae7f9e8943b307383e9bbba6b70efc315",
      "text": "唱歌和跳舞也得好好看。试镜的时候，\n不是说我们可能也得表演吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000059:dialogue:000": {
      "source_hash": "sha256:b5aff382872c84f86cba0f12110ce02f5dc818465a6387196c064c19c9d36e5a",
      "text": "噢！看这个好好学习一下！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000065:dialogue:000": {
      "source_hash": "sha256:e467ed65a61d42fdb1915f1b0dca57d9d60dffcba057185232c38acc60c4c13b",
      "text": "嗯。粉骨碎身，\n大干一场吧，相棒！",
      "status": "draft"
    },
    "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_b:cmd-000069:dialogue:000": {
      "source_hash": "sha256:0522f5feb089c6d0ce8700a3a14d006211d88ef37bf2eed6509b13d9b6b2b377",
      "text": "噢——！",
      "status": "draft"
    }
  }
}
