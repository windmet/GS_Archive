  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000010:title:001": {
      "source_hash": "sha256:66698261ae33e331c1c7f85a3d6920aa6f9af58e6680234112f69c41c9b78a8b",
      "text": "音乐剧舞台的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000017:dialogue:000": {
      "source_hash": "sha256:d2121b9a89b081b8cdf37aa94f8d83e1e8603ebd5fcb259260e795f7fff42bb6",
      "text": "刚才那里，感情是不是再充沛一点比较好？\n但是也得注意别太夸张了……",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000021:dialogue:000": {
      "source_hash": "sha256:24903a7febb719927fa877470527de343773145fed89e8fb64da236c35a93783",
      "text": "卷绪先生，辛苦了。\n感觉怎么样？",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000027:dialogue:000": {
      "source_hash": "sha256:085a91b91dd0f91f6f55b9aa7b7467cb069a51c869ac780842b654e9ee2adb13",
      "text": "啊，●●●●プロデューサー，\n来得正好！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000032:dialogue:000": {
      "source_hash": "sha256:1043e107f9ca1d160a9c4e10547c7b6882dcdfd411cda58a9ec1a23e36dd1725",
      "text": "●●●●プロデューサー读过\n我要出演的音乐剧舞台的台本了吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000036:dialogue:000": {
      "source_hash": "sha256:2c6762f7148a811b5167dd4d65ae0aecc5412ad9207f825272e3463e98f458fb",
      "text": "当然读过了。\n风格很轻快，非常有趣呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000042:dialogue:000": {
      "source_hash": "sha256:ca718bc93078a98dd0d643d2150a902fd06657a0d292cfd3914f808f35d31ec6",
      "text": "这部作品，\n在我们这一代人里可是超人气的系列呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000046:dialogue:000": {
      "source_hash": "sha256:66d07b723413453f5ff795837b379e0abe73beb1584a84f8d8b4fcf804c39106",
      "text": "这次的音乐剧我有独唱部分，\n所以目前以声乐为主在练习，但是……",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000053:dialogue:000": {
      "source_hash": "sha256:8d6d9e4d928a5ec6f6a538a893c585df2aee806f249078de9430350f50d23b1d",
      "text": "总觉得唱不出预期的感觉。\n不介意的话，能陪我练习一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000058:dialogue:000": {
      "source_hash": "sha256:edd2a193205fe7c88be31c8d5d3b8d01056eabb77857ba1c3728372c1abb06e4",
      "text": "我就是为了这个来的。之后的日程\n完全空着，我们练个彻底吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000064:dialogue:000": {
      "source_hash": "sha256:47f69b99fca3391f69837ce9314d82be5bddccc9658a1bb3c887a9fcf8c39c7b",
      "text": "啊哈哈，太可靠了。那就拜托您啦！",
      "status": "draft"
    }
  }
}
