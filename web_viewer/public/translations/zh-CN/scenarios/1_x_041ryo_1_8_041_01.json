  "entries": {
    "story-text:v1:1_x_041ryo_1_8_041_01:1_8_041_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:f38baef2db748c9b1ef79fe7b57d70c4f2a0e6ab96131e4fdfc59e32b7cd37cd",
      "text": "●●●●プロデューサー，\n辛苦了！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_8_041_01:1_8_041_01:cmd-000011:mobile_message:000": {
      "source_hash": "sha256:6189954d5dac540f40954a1d204fcfb31042d334142639118c2aa55e7767b3ec",
      "text": "还有，祝您生日快乐<emoji>image_talk_emoji_16</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_8_041_01:1_8_041_01:cmd-000013:choice_short:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_8_041_01:1_8_041_01:cmd-000013:choice_detail:000": {
      "source_hash": "sha256:16c26a95bee16fdd4ee1eb09151327b152df7159e0c49fa0b77673e5f1901c48",
      "text": "非常感谢！\n能被您记在心上，\n我很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_8_041_01:1_8_041_01:cmd-000016:mobile_message:000": {
      "source_hash": "sha256:8f69ed0ab46145da24b41544ca2a60cffa559eac3b9495afae6516f261038f3a",
      "text": "毕竟是●●●●プロデューサー的\n生日嘛！\n我怎么可能会忘记呢<emoji>image_talk_emoji_05</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_x_041ryo_1_8_041_01:1_8_041_01:cmd-000018:mobile_message:000": {
      "source_hash": "sha256:ca6b5b16be9f9f42f4e210401b314330b65268ef5d8cb42b574036a19388b704",
      "text": "接下来马上有工作，\n等到了事务所请让我再正式\n为您庆祝！",
      "status": "draft"
    }
  }
}
