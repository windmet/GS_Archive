{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "044ame_402_2_4_044_02_09_a",
  "source_raw_hash": "sha256:2bb26eaa4881f0b4c401af6967947d6f0dc5f465a13fad31778d56c346365407",
  "entries": {
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:c364fc915599e4f0338ceb5fe158a7b2c1908704b2af3b02c9e2354cd65818ca",
      "text": "晚上好，制作人。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:e06072d13af089d67e836a1d207486e2879421a15a97963d0a872d0bfee89225",
      "text": "我忽然好奇起\n你这家伙在做些什么。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000010:choice_short:000": {
      "source_hash": "sha256:6b8958010997b3b2d906a32c15b4487d39dcf154e274bc97819ec992c81db49b",
      "text": "正准备要睡了",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000011:choice_short:000": {
      "source_hash": "sha256:c1b5b7242ed65b1f83e73c79e10b5687cd2dbe8da54c6c6b619fca3bdd8d3530",
      "text": "打算再做一会儿工作……",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:502706bdb7cc7ab8bbc818436f35cc44514c0cc50a5534bfd918955ffaf39824",
      "text": "这样啊。\n我也正好准备要睡了。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000018:phone_message:000": {
      "source_hash": "sha256:4f99c637021d3ca9657c140243eba9ceb50c8054eefbdaf8de3e64eb4f21bc84",
      "text": "这样啊。\n可别搞得太晚了啊。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:c9c8ae31358204d0936fd78efb1531f5b6931f74b39414c80de619de4f37a46f",
      "text": "今天长时间的拍摄辛苦了！",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:7ead916c93e6754f0e299046dfb41f43995a9077f89135a330d6a32332bcc3d3",
      "text": "谢谢啦。\n应该交出了一份好成果。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:708062999a9faa1b61e143c819716b0fd35ce8449540fa50c7af6b04143453cd",
      "text": "若里和牙崎的照片拍得也挺不错的。\n你就好好期待确认成片吧。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:fd5f8645ba8fb5e5d20515a10aaca7dc2a956e41b1f4819fa7afbe29628bc1e0",
      "text": "好啦，打扰你太久也不好。\n差不多该挂了。",
      "status": "draft"
    },
    "story-text:v1:044ame_402_2_4_044_02_09_a:2_4_044_02_09_a:cmd-000031:phone_message:000": {
      "source_hash": "sha256:4f6f17ab5a3c1b4839ad6a3c25790f3bae666a388237508d6fa067bf7a9b97d9",
      "text": "晚安，你这家伙。\n明天见啦。",
      "status": "draft"
    }
  }
}
