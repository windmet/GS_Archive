  "entries": {
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:b9be0ad9b1c583f0954e41ba88e0bef77aa553f881dcba87849f0892c7e66068",
      "text": "新的世界",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:d2cd5e5ce2ac65f70a373fa38e096478326c0e885895bbd7d9bd1255c7ca4523",
      "text": "悠介和享介被叫到事务所，\n听取关于新工作的说明。\n在那里他们得知W的歌曲《LEADING YOUR DREAM》\n竟然被选为了动画的主题曲。\n不仅如此，工作还不止这一项……？",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000014:title:000": {
      "source_hash": "sha256:6bd711a0c587f0c078d13f61396e0634340adf4afbcabad0ac20aea8f2b2a191",
      "text": "序幕",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000014:title:001": {
      "source_hash": "sha256:b9be0ad9b1c583f0954e41ba88e0bef77aa553f881dcba87849f0892c7e66068",
      "text": "新的世界",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000016:time_caption:000": {
      "source_hash": "sha256:346319a2c0da5a01cfc4482196d55973d6cf02cc82e3be8ebea8ab6349a41a42",
      "text": "苍井家·客厅",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000030:dialogue:000": {
      "source_hash": "sha256:b99371b17d327422866bf101fad860272efc92b8f36ec9ddc80ab32f05570599",
      "text": "早上好！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000036:dialogue:000": {
      "source_hash": "sha256:50bb27d2653309088766af6c9ada237fb8fc48a805391d3a007d9eaf5b6b93eb",
      "text": "早上好你们两个，早饭做好了哦。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000039:dialogue:000": {
      "source_hash": "sha256:b2fd9231c566a7aa13adae30e66bcb5b1293bfcf54b260d5d3e245be2b317600",
      "text": "嗯！谢谢妈！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000057:dialogue:000": {
      "source_hash": "sha256:228ad61017b26a24acf0cf89c2feb06bb514df366e605423c04779b159ded099",
      "text": "悠介。\n酱油递我一下～",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000066:dialogue:000": {
      "source_hash": "sha256:c0328aac26629e9cddd953af602f2cf4521ce9c2a281e2947517bc775f55b3d9",
      "text": "给，拿去！\n享介，酱汁也帮我拿一下。",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000070:dialogue:000": {
      "source_hash": "sha256:d20530987bf50b1507e2747d82acf1ee9aa521a31f3b2feaeac75d60324e1e59",
      "text": "呵呵呵。总觉得你们兴致勃勃的呢。\n有什么好事吗？",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000074:dialogue:000": {
      "source_hash": "sha256:83a609d49308e0dfeebd59469d4a6aa807d9538a80b8e38240c7a0c1676d8db5",
      "text": "嗯！其实……",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000082:dialogue:000": {
      "source_hash": "sha256:557c6f0773a573e4791d5435a9fceff2d69da4bdfd483eec97d3b7b649768eb5",
      "text": "今天有新工作的说明会哦！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000084:dialogue:000": {
      "source_hash": "sha256:5016c9ad338012bd108f927f4979a7e27f3d1f724a3683102bb4480080cfc940",
      "text": "哎呀，这样啊。\n要加油哦！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000095:dialogue:000": {
      "source_hash": "sha256:cdf8b73ade9714b3afe4d307a64577d94dc0a485fffe4dcdb9f30e2e3289a456",
      "text": "嗯！\n啊，差不多到时间了……我们出门啦——！",
      "status": "draft"
    },
    "story-text:v1:1_3_30004_01:1_3_30004_01_a:cmd-000098:dialogue:000": {
      "source_hash": "sha256:e39b863fd4bbf686fc11c2e3c39e7c0aa505711c2bd8381da57add299d674349",
      "text": "真的耶。\n多谢款待！我们出门了！",
      "status": "draft"
    }
  }
}
