  "scenario_id": "1_5_016sei_1_5_016_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000010:title:001": {
      "source_hash": "sha256:ac0148a71ea246e12a6d0bb647d3b6c2c903bbba0270cd7eb3cac305a0e385be",
      "text": "刑侦剧拍摄的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000014:dialogue:000": {
      "source_hash": "sha256:dfe0e495be48b3f29eb10b137dd0f7604313ad1cffc0851b77232295087b274f",
      "text": "下一场戏，是诚司先生的大段长台词呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:d84790f1ff006b97093d12a39a496d97662d43f450a6f33a248954c5dc60d84b",
      "text": "是啊，刚拿到剧本时吃了一惊，\n不过我会好好展现练习成果的。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:9c2eab17afa67d0156911383d8c0c3a22965970d4248505f0fa9a48955974016",
      "text": "听说这次的剧是刑侦题材，我还以为肯定是\n演刑警呢。这种角色很新鲜啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:904ad4063e34074db2a3a3b0f415ce8fb0c7e48c4096a6944e55ed565e8f8f71",
      "text": "演起来感觉如何？",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:3d5f013f5f258914458519e123310f85f194333fc0bf0a53069c873f9ee2a412",
      "text": "感觉发现了自己新的一面。\n看剧的人若是也能感受到这一点，那就太好了。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000035:dialogue:000": {
      "source_hash": "sha256:fda9d381db1de8ca74ba24ff80917aa7c78e1ee404b31d0a255d0d92fbf6b2ce",
      "text": "虽然鉴识结果之类的专业术语全是不习惯的词，\n背起来花了不少功夫就是了……",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:7a2c09116bff03b3915b52561309931253aa1636883a995a8f0ad8bf82e203e4",
      "text": "不过，在周围共演者的帮助下，\n拍摄进行得很顺利。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:b83d3ef8e835d860e3b947efd8c68739dd14561a25ca2b065d18cfcf2b7cd794",
      "text": "在这个片场不仅是演技，我还学到了\n很多其他方面的知识。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:86e5f661cf360836940571058a881235abf51bef66cb9cee326551715d83d9b0",
      "text": "这也多亏了为我接下这个工作的\n●●●●プロデューサー啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000052:dialogue:000": {
      "source_hash": "sha256:30d1bd640058842629c9cb446949bf1601007039aa858c53b19b0208722ecfab",
      "text": "好，那我出发了。\n就看着我一把过吧。",
      "status": "draft"
    }
  }
}
