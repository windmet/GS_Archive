{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_007_23",
  "source_raw_hash": "sha256:ed9ad57b606c63329d41a15ee64e4dc3ff13a0a64a33721b18f825a053ce969b",
  "entries": {
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000012:dialogue:000": {
      "source_hash": "sha256:b635a6ad54dd12c70eea4740040e76ee69a7f0a3ab4824471a688a8cc99361ba",
      "text": "……今天的录音，到这里就算结束了吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:b670923cbe84936250e63021f3f880dbf162d7f6825556724b93592659dfe95d",
      "text": "刚才收到的巧克力，\n我在休息的时候吃了哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:325fac165a3076c4ccbeb3e59411c666955f3d873ce1cb2bd652f200c7ee1ce5",
      "text": "总觉得一下子涌出了很多精神呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000021:dialogue:000": {
      "source_hash": "sha256:4b663d3edef4dfafb4c3e42b664c072d275d783d941119e834c4d572754d7fcf",
      "text": "那真是太好了！\n里面倾注了很多的热情哦。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000025:dialogue:000": {
      "source_hash": "sha256:784084af88a2a17a8c72e55024acd121b605670190ed6d6d43b83f5b1c68fd33",
      "text": "呵呵。果然，是这样呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000028:dialogue:000": {
      "source_hash": "sha256:e423d763d640a5d5d2925472fae4366a3127f9933d8cfe3aa07b1d0b6df77731",
      "text": "你的心意，通过巧克力\n好好地传达过来了。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:771a691490bbbcc13770f8fbc749716e98f15f1d9854214245d226a62215ad4e",
      "text": "谢谢你送给我这么棒的礼物。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:03b44fc2a363bf5bb9dcd967824d40558dd102cb3a221774d1b2ff034e84157b",
      "text": "托巧克力的福，今天的录音\n得以在最佳状态下圆满完成呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000039:dialogue:000": {
      "source_hash": "sha256:426c12b569d899427e15a327725d643ba027ec848928dd8199dd484f32b8f939",
      "text": "真期待听到完成后的音源啊！",
      "status": "draft"
    },
    "story-text:v1:5_01_007_23:5_01_007_23_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:a6f2d0bd30c3f9b9bf4b0eff5380fdcbebaaeed75c0e8ca7fbc03e2cc6a1070b",
      "text": "是啊。\n我也很期待呢。",
      "status": "draft"
    }
  }
}
