{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_03_c",
  "source_raw_hash": "sha256:27d6fd712d6da0a21ebc85c7da7cbfc60c70dcc860e81c985e52506717999639",
  "entries": {
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000026:dialogue:000": {
      "source_hash": "sha256:38e88102d3be5d4abf476bcbd3c559d20fdbbc46f07d2e5d4949dc61ede993a8",
      "text": "久等了。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000032:dialogue:000": {
      "source_hash": "sha256:8db12b7f307b2a53702f7e6bf7bf1799ec798630134bf24c3bbfab56ac3b17b6",
      "text": "哇，好啪噼可爱的甜点！\n红茶闻起来也很香～",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000037:dialogue:000": {
      "source_hash": "sha256:56457c505b3d76c39959a2b4049f91a95db9d35cda876f493b9b4c4172c6cbc2",
      "text": "啊……不过我没带多少钱……",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000053:dialogue:000": {
      "source_hash": "sha256:94c97ab2d7faacc9fa93a02ccd1e56fd5626b9cd1f1a8c7f6a859b76858b5d0e",
      "text": "请不用在意。\n这是我们的一点心意。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000059:dialogue:000": {
      "source_hash": "sha256:0e825bfb051b76473593601c7a581c68b72381cc450dbfcbbbf8002a81cf9d59",
      "text": "神谷先生的红茶和庄一郎先生的蛋糕\n都超级好吃的哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000076:dialogue:000": {
      "source_hash": "sha256:d481b167ac4a8370643a1e1b8d122cb10ef59e84f3fe5ec31baa2c4e02487e25",
      "text": "两位……谢谢你们。\n那我就开动啦！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000084:dialogue:000": {
      "source_hash": "sha256:6a969ee9744c942338c93fb95496a626008c98f92a7855a7653e87f4114c7323",
      "text": "……！\n这个蛋糕，超级好吃～！",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000099:dialogue:000": {
      "source_hash": "sha256:db01e5ed4e088a5980c4ccd293eaf1ab3be8d1c33a7ed3519595c4feab57d007",
      "text": "是吧？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000113:dialogue:000": {
      "source_hash": "sha256:e96152f750112c6983c1c6a47e41684a7906c60addf034cdefaa9496a5054f77",
      "text": "红茶也很香很好喝！\n跟蛋糕是绝配呢♪",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000123:dialogue:000": {
      "source_hash": "sha256:902a7d3b2a82a387206a5215f586c50d913e70cf1e10b7310fd6e595cf0d87d5",
      "text": "（刚才本来还有点消沉的……）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000128:dialogue:000": {
      "source_hash": "sha256:701d52e123c943c2abcfca861792935785c61ae8d2626ddf0cd49592c082f30c",
      "text": "（卯月君的温柔，红茶的温暖……\n还有蛋糕温和的甘甜，让人感到好幸福）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000132:dialogue:000": {
      "source_hash": "sha256:40393198d3c4f0d017ba5bdbf473c0d1a60ed87c79c23c7afcb60f4b2d549c65",
      "text": "（Cafe Parade啊……）",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_c:cmd-000156:dialogue:000": {
      "source_hash": "sha256:5c41b3c045bd91fd525b438962636f67213a2af17df90751b412f27d0f66ed3a",
      "text": "……咦？\n呐，那边摆着的是国外的照片吗？",
      "status": "draft"
    }
  }
}
