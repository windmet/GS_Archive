  "scenario_id": "1_5_001tom_1_5_001_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000010:title:001": {
      "source_hash": "sha256:8e494f2fb1e12f0f5b5c89d86a347fcec327352b0de4386516e5338adfedfe3b",
      "text": "大众向动画的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000016:dialogue:000": {
      "source_hash": "sha256:c1406ea6f56b99798342ee8eecbac578722e500c867cad568e8d5510fec5c3a5",
      "text": "动画电影的声优吗，真让人兴奋啊！\n而且是大人小孩都能看得很开心的那种电影吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000020:dialogue:000": {
      "source_hash": "sha256:7e3acc96caa732eb2661da8aa7f51bf9bcbd888db5f78132dd305e7aa50984ee",
      "text": "我一定要让所有来看的人都深受感动！！",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:0c53bf2bd5c54a7c8875a49be7c9b4f8ada9aef3db21fe2875acd6427cead830",
      "text": "气势很足呢，冬马先生。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:1876ec4780a2f9025354566cae8d10273e24cdf258bd28c6249d3ea16c194603",
      "text": "嗯，那当然！\n既然要做，就绝不能做得半吊子。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:1553371454d761a493bd5da8721bdf38377da574026fee26dc4aae433ae26e08",
      "text": "为此，现在唯有练习了。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000037:dialogue:000": {
      "source_hash": "sha256:9657ff2c58a8a0b00846f74970d40b227b25a99b1fdee5f331b34e7bfd1eeb22",
      "text": "话是这么说，做声优到底该练些什么啊？\n发声和咬字清晰度自不用说，不过……",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:a7e1185b23c55b2b0f9f7ace6dcfbf4bf16b25fb5cf5bda4289546fb8375e00c",
      "text": "重点是要用声音来演戏对吧。\n我说，能帮我安排一下声优课程吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:545d7036406b90920206a5422163367482723c89ae85c6f38985ba9b0162dc7c",
      "text": "嗯，当然可以！\n我这就去联系指导老师。",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000050:dialogue:000": {
      "source_hash": "sha256:b693575ba6c71d5ec4c726bdf089335c8d8d434d1b5b3cb54e6fe0832b9fb5b9",
      "text": "不愧是你，●●●●プロデューサー！\n那就拜托你调整课程时间表了！",
      "status": "draft"
    },
    "story-text:v1:1_5_001tom_1_5_001_01:1_5_001_01:cmd-000053:dialogue:000": {
      "source_hash": "sha256:c6e1d6177dee6f53b3be621f90ec72ca037d9d972985aec982980cd0a7be4fe9",
      "text": "好的，交给我吧！\n我马上就去安排。",
      "status": "draft"
    }
  }
}
