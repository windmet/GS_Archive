{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "034kan_402_2_4_034_02_09_b",
  "source_raw_hash": "sha256:178d35e90132aa047d1c1d70de014a9043a640f61e8b5b5f25ec9942e62bee80",
  "entries": {
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:d968098c133a1a0e6b084e2de6af1b5ca5e73fabf860e8da2d2a49c0714d7cfd",
      "text": "喂，制作人。\n今天的新娘子真漂亮呢。",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:1826eb2146a10fe3ddbd268e721d9510e2fb959f85b2867b42a98567b2a38016",
      "text": "看到闪闪发光的婚礼，\n花音一下子变得超级有精神哦♪",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:8fe88aabbc6b4a6089976451e92b809794bafdf5bf1db32c6014d736881bcb92",
      "text": "下次的工作里，花音也想办一场\n充满花音风格的可爱婚礼呢。",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:b44c097b2abb5626eaa45e140e5a126165cb546be6612fed24a49752d2d32808",
      "text": "花音君的话一定能做到的",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:bc7714aae5345c5a09eb73fdd369a560073a75c5bb56c69f869ca59b56ffb5bc",
      "text": "去做只有花音君才能做到的事吧！",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000017:phone_message:000": {
      "source_hash": "sha256:2f4bfc95b479c0d224c2f6fb59753efabe7aa3e65cab2cffba97e605b7cf91cd",
      "text": "诶嘿嘿，花音有花音自己的讲究嘛。\n我会加油的哦♪",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000019:phone_message:000": {
      "source_hash": "sha256:b048167eb547c91b9d9ee1441067bd5b030a45f90c97a3ef17a9caa57d713562",
      "text": "现在开始就超级期待拍摄了！\n因为是“天空婚礼”，要是大晴天就好了呢。",
      "status": "draft"
    },
    "story-text:v1:034kan_402_2_4_034_02_09_b:2_4_034_02_09_b:cmd-000021:phone_message:000": {
      "source_hash": "sha256:582ed307d6554d9545bc9827a5267b1dbc3e35def935545cbd746e5362c42e91",
      "text": "花音去做晴天娃娃咯！",
      "status": "draft"
    }
  }
}
