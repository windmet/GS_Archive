{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_034_02_c",
  "source_raw_hash": "sha256:b8e23591e9d78360aebaedf9cc585858a9a96475ec1db8302c325df195ff1381",
  "entries": {
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000018:time_caption:000": {
      "source_hash": "sha256:de032b14ad770092a08e64ee0b7359b1bdf150548e5d96e8eacb1487cc8ae481",
      "text": "次日……",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000029:dialogue:000": {
      "source_hash": "sha256:266f35a25a8bd4331deb31ac9151e3cbfa7d02661f057cb6ca10af88189b8ed8",
      "text": "今天的练习大家配合得真默契呢。\n制作人给了我们点心哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000041:dialogue:000": {
      "source_hash": "sha256:ea91c721cbbc1f2e2093299a056ab1c312a845e01c8c143835386216e06eaf15",
      "text": "好嘞，开吃开吃！\n我要这个大巧克力的。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000054:dialogue:000": {
      "source_hash": "sha256:f0b19d2736ab65a334dab9f29e15f36fd9f1a4e1d53f53e9f9af813faae6644c",
      "text": "……花音呢～现在有一本很想看的书。\n去那边自己看会儿书哦！",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000061:dialogue:000": {
      "source_hash": "sha256:cf63575b692013b21403070d9c8373ee4072ff94e61bc3b168234d7ac294ec85",
      "text": "诶！？哦、哦……？\n点心不吃了吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000068:dialogue:000": {
      "source_hash": "sha256:844eb2ba6545dd5ad4372fca94a4167b6a7b7bdf9cafec33735af1964ee27d24",
      "text": "等会儿吃！\n所以给花音留一份哦！",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000084:time_caption:000": {
      "source_hash": "sha256:903c1b425bacda171af5ab5569c41beb3b93c8235d860d6173f537404a33bb66",
      "text": "又过了一天……",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000100:dialogue:000": {
      "source_hash": "sha256:6144d9802d792148c26cab9fd70104e5a47871d559f8869dc08253ce6da99d30",
      "text": "拍摄辛苦了！\n休息之后就是采访。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000107:dialogue:000": {
      "source_hash": "sha256:5b1644e5a9522603fef696df6641dccccaa8eb12e64aeb59d4fed2d45ae1c017",
      "text": "噢！\n拍摄还挺轻松搞定的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000121:dialogue:000": {
      "source_hash": "sha256:f7d7d7a34ceca3ca17da134629cf9c111d4657604ea087e83d7fec0e09063716",
      "text": "我稍微有点紧张。……虽然每次都这样啦。\n花音君感觉怎么……",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000128:dialogue:000": {
      "source_hash": "sha256:b9467852c37c3ae2a693d5109897225d8fd8b17e1af713243203b2a11adfecbd",
      "text": "啊，那边有个穿得很可爱衣服的孩子。\n我去问问是在哪里买的衣服哦！",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000130:dialogue:000": {
      "source_hash": "sha256:c8cf383dc5dd47c9ccb28e0cfb641d4abed800d4ee0b8bce242467e0c2583c05",
      "text": "啊，嗯。",
      "status": "draft"
    },
    "story-text:v1:1_2_034kan_02_1_2_034_02:1_2_034_02_c:cmd-000141:dialogue:000": {
      "source_hash": "sha256:a656b7d2b2fb7d281eb4d23b4b57083477a17f3bcc69b50b84ec60e6070f6812",
      "text": "……",
      "status": "draft"
    }
  }
}
