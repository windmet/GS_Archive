{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "043kaz_305_2_3_043_05_09_a",
  "source_raw_hash": "sha256:de938977a713e8968e001ca5210d4646082702f39adac60dcc5c0d064f2e30e7",
  "entries": {
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:7218eb7c6a1d91486107544a0245c294f8562b79dee61f6efa436367e11056eb",
      "text": "……制作人。前几天拜托的追加资料，刚才\n我已经从贤那里拿到了。谢谢你的安排。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:58542d21206541b1c412a208ead592e6a351a217167f5bd5ccdc48509b191b53",
      "text": "……我打算立刻以这份资料为参考展开训练。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c281ac6335f6f0508a7a14e1710ff80e5ce035f017fee85401e373b746045b96",
      "text": "……体育新闻里也对这次的工作进行了报道。\n采访了各支队伍的干劲。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:374c76ae474e59a35fe6945c0e1b310b95554ced317e0b3cfd8ccfd4dc1f502d",
      "text": "……让我不由得心生肃穆。选手们现在也一定\n正在反复进行着高强度的训练吧。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:4772cf9d04736f47f8298a7d3e00e88e3f3203009bf8378cdebcc56fefd76cb1",
      "text": "……朝着梦想勇往直前的身姿，能给旁观的人\n带来勇气和希望。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000016:phone_message:000": {
      "source_hash": "sha256:1dbe8910ba9318ce5f5f6a3cdb8ee55b181487138fd155d5854aeb060f4a032a",
      "text": "……能够为他们加油助威，\n我由衷地感到高兴。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000018:choice_short:000": {
      "source_hash": "sha256:f6a4eb1ed36308252729c758fe1fafc34e52558dd73fe06728bf7e00ef85c885",
      "text": "很有意义呢！",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:f4362a6d3cf329e5fa9a09cf1b0d77e3b8cf1664c207775b59889404d636b308",
      "text": "……嗯。好好看着吧。\n……我会献上全力的现场表现的。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:b7a4e8198b2404de8cc92be217340fbf418e8a27eef3a96fd64b256bd25b0ce1",
      "text": "……为了鼓舞选手们的士气，\n我会把会场的气氛炒热起来的。",
      "status": "draft"
    },
    "story-text:v1:043kaz_305_2_3_043_05_09_a:2_3_043_05_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:d2f5e7c7addf3c3bfffe9c780bf986c94b7cee20e64aea5008c93c189c74d7b3",
      "text": "……谢谢你为我争取到这么棒的工作，制作人。\n那么，再见。",
      "status": "draft"
    }
  }
}
