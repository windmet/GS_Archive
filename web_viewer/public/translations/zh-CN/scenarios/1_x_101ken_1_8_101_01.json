  "entries": {
    "story-text:v1:1_x_101ken_1_8_101_01:1_8_101_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:c080f722f8c8533f9110adbcc75c1963ffe2dc08046f84cbcbfb6968e9b07865",
      "text": "请容我再次向您道贺，●●●●プロデューサー。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_101ken_1_8_101_01:1_8_101_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:e7e8266a78304c6acc523897738228ba5aeafedf9dbc31f8042cd8b7897ef1e8",
      "text": "非常感谢！",
      "status": "draft"
    },
    "story-text:v1:1_x_101ken_1_8_101_01:1_8_101_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:5f70b1237a4c30576844091296b2391fe1ab1e68e73daee71c1d7093396ef4b5",
      "text": "愿自今日起始的新的一年，对制作人而言\n会是无比精彩充实的日子。",
      "status": "draft"
    },
    "story-text:v1:1_x_101ken_1_8_101_01:1_8_101_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:b3c56df301173ed157f13c114377423c357a862cb6b2f0e2e122f6c44431400c",
      "text": "今后也让我们一起\n齐心协力让315 Pro更加蓬勃发展吧！",
      "status": "draft"
    }
  }
}
