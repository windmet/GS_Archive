{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_010_23",
  "source_raw_hash": "sha256:eeabe43198588c2573464d5c4053825bb41c7a8cbb2a7d4ba6624e09b8ee4651",
  "entries": {
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:694a758c40b7f0defa7245ea4aed7416f3e907cc995bb21bde31102a9ff56854",
      "text": "制作人，点心，想放这里。\n桌子，可以吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:c015305dab78b72dd4bd5aef615288f90ca366bafec9fa57ddaf796b35d905a9",
      "text": "好的，我已经收拾好了。请放吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000031:dialogue:000": {
      "source_hash": "sha256:bf8889c03d62db2a040b3d1b21313b85d9d47a291499a1ce4bddb0b686d60279",
      "text": "哇，谢谢！……嘿咻！",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:9a40edd0f305bbf2793bf9b2b91546063071be36a10ecf757b7f68b68a3c809a",
      "text": "好多点心啊。这是怎么了吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000043:dialogue:000": {
      "source_hash": "sha256:d1f079f3368ac152873a5c51c4123aa772e489a7f69dcc12794f944ad9acd4bb",
      "text": "今天，是情人节。\n所以，带给制作人了！",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:62ed16092a34135555dd009507a23293ee8a86fe40e93a2112917a1a5d382e6a",
      "text": "全都是，我最喜欢的点心！\n好吃，笑眯眯，好开心！",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000055:dialogue:000": {
      "source_hash": "sha256:8d08990f2828cbc6ee90128c60a6b79f3556937b06f10db95710c789583285c5",
      "text": "原来是这样啊，真高兴！\n请务必和我一起吃吧！",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000058:dialogue:000": {
      "source_hash": "sha256:7b26301106edb0d1558b7464cd7ed7b0b18cc9842645ca3faa4820a29aed9fce",
      "text": "我也一起？可以吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000060:dialogue:000": {
      "source_hash": "sha256:034ca5aa8054136ff14ba353e27a5f46e1572239c69d438cee6d3f226bc78257",
      "text": "是的。一起吃的话，会更加开心哦！",
      "status": "draft"
    },
    "story-text:v1:5_01_010_23:5_01_010_23_a:cmd-000068:dialogue:000": {
      "source_hash": "sha256:3441f02a724132c31213b52a91ef6fa939b6c4d9b56c9297bd3b8623f843e97a",
      "text": "真的吗？那，我也一起吃！\n嘿嘿。情人节，真开心呢！",
      "status": "draft"
    }
  }
}
