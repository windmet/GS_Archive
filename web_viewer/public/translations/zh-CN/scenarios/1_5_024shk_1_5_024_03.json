  "entries": {
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000010:title:001": {
      "source_hash": "sha256:f3926fa18e89c1b787d6223374858fef4d6b099a2001dd4a9b3d42802506eb6b",
      "text": "卡拉OK对决电视节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000017:dialogue:000": {
      "source_hash": "sha256:ebe68993ed8cb4ea181483f6071934494f7468c6d5318cf8dea752e5924887d0",
      "text": "今天是卡拉OK对决节目的收录呢。\nHyper燃起来啦！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000023:dialogue:000": {
      "source_hash": "sha256:8b754a56e121f46d5c454330cad76a894c9d2f843c7ff4eb8421f5020b077e09",
      "text": "●●●●プロデューサー酱！\n我可要大展身手啦～！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000027:dialogue:000": {
      "source_hash": "sha256:2a4426cf4fb000fcfdb42f165a655701a1c26635c4270a370e7abb8295f2a860",
      "text": "四季先生之前说过，唱卡拉OK时能精准拿下目标分数呢。\n真是厉害的特长！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:dc1e1a54c47f05ab96adc2983a7780c925ce77ea725117f340bcdef03c4ce767",
      "text": "哎呀～也没有那么厉害啦☆",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000038:dialogue:000": {
      "source_hash": "sha256:1f7e0ab4b1063df862c29e30bdd75fd22e240c67eadb89951aa554b2069bb284",
      "text": "为了今天，我还和隼人亲他们经常\n跑去卡拉OK练习呢。既然要比那就要拿下冠军！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000042:dialogue:000": {
      "source_hash": "sha256:9b4faf6820c27d593e43b490c9ad6b4bdc8a80facdf1e2063e2f89cd880da8d7",
      "text": "四季先生的话绝对能拿冠军的。\n请加油哦！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000057:time_caption:000": {
      "source_hash": "sha256:83b91878176a36430c39bc5426de2edd68820f09e7576494a38fc8f14e07694f",
      "text": "录制中",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000059:dialogue:000": {
      "source_hash": "sha256:cc169f1e33fd7c04c27a1ca21c31d889e6a07828d8c6eeaa5f378bf0404f6363",
      "text": "（接下来终于轮到四季先生上场了）",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000061:dialogue:000": {
      "source_hash": "sha256:69049f5ca7923debab2b79ddee93ed1e8049e1229091a6ee6ef8bef363aa30c0",
      "text": "（目前的最高分是97分。\n只要拿到98分以上，四季先生就能夺冠了……！）",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000071:dialogue:000": {
      "source_hash": "sha256:958fe1f6df7372956e9ee0e69a196d307797ccbc1ff77c569ee064ee5027d424",
      "text": "6号，伊濑谷四季！\n心情真的超级Mega嗨的！",
      "status": "draft"
    },
    "story-text:v1:1_5_024shk_1_5_024_03:1_5_024_03:cmd-000077:dialogue:000": {
      "source_hash": "sha256:5679b9b8d1637818db5284fe9762f4debb42eae8ac874222ce9c387b9205617f",
      "text": "我要直接拿下100分，\n绝——对不能眨眼错过哦！",
      "status": "draft"
    }
  }
}
