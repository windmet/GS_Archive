{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_01_d",
  "source_raw_hash": "sha256:2c369236be1af07d28e847ee252657c5321b4ec37bdfc39f2001f8fb0916c776",
  "entries": {
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000022:time_caption:000": {
      "source_hash": "sha256:65143ccc5f7429bbecd890a6120f9f6ce72bd41b65e590663ea5e4ded852b1e8",
      "text": "日本的酒店",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000030:dialogue:000": {
      "source_hash": "sha256:0161e65739645af0a8491946ab88cec8f10588308a6453be78d8f16eb5b9b2c4",
      "text": "（来到这个国家，已经是第3天了……）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000034:dialogue:000": {
      "source_hash": "sha256:d622963bde59c04eefc8bd485cbffb2ee39fd914c8bcae06fa7d1b02eb393325",
      "text": "（没有认识的人，语言和文化也不同。\n……好寂寞啊）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:e828d807ac7834743b41ea4dd35434a6c59f146a115e357b06c06ce8114139d4",
      "text": "（这个国家，好和平。\n怎样才能让我的国家也变成这样呢？）",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000059:dialogue:000": {
      "source_hash": "sha256:89b553c07f72e833301cc183cfc917315a3586f819a989ebd3f414939cc7fb56",
      "text": "皮埃尔大人。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000063:dialogue:000": {
      "source_hash": "sha256:8f37837666e2112ddcea67f4c8b820cc10702e4a12bcff573db06bad707b1593",
      "text": "咦？那朵花是……？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000069:dialogue:000": {
      "source_hash": "sha256:b66d29156043c7519c8f893b520e1f7bf9c9056df9d223d1bde7388057cd20b4",
      "text": "附近的商店街里有一家花店。\n我想着一定要献给皮埃尔大人……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000076:dialogue:000": {
      "source_hash": "sha256:fc0ddec8736807deb95f7668d17e55ebf3b51c340010ec18c18ba3d9e5133047",
      "text": "这样啊……是什么花呢？\n总觉得和城堡庭园里开的花很像……",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000080:dialogue:000": {
      "source_hash": "sha256:636cd7ef5af5993a40d0d81303387a338379d9086b2c91cbbae5e31b16a68454",
      "text": "那个，皮埃尔大人……\n如果可以的话，要不要外出走走？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000085:dialogue:000": {
      "source_hash": "sha256:5742e0ca30c67272f9157f4d2316cb2e8c939f8652fda060d2333057c47cabcf",
      "text": "诶，为什么？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000088:dialogue:000": {
      "source_hash": "sha256:66d4ca09cc3acabe1d14bf29fc1ea20f963b8a19637f21b5eeb227627998a8f1",
      "text": "一直闷在房间里对身体不好，\n而且目前也没有发现追兵的踪迹。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_d:cmd-000093:dialogue:000": {
      "source_hash": "sha256:b241a41c59200d80d2bb5d52004afe26f6e6822301bf59cf0443f0f9588eae48",
      "text": "当然，无论发生什么，\n我们都会全力保护您的安全！",
      "status": "draft"
    }
  }
}
