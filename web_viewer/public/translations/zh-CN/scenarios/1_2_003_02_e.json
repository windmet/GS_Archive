{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_003_02_e",
  "source_raw_hash": "sha256:c52450c46309346075970e448b33ea806c2df6f8860e4fcd89cd8ddee04f7f52",
  "entries": {
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000020:time_caption:000": {
      "source_hash": "sha256:d754b865bcb97c6ac4d1751a7324118e65611b0ee124791cbf4f7dff6d44926c",
      "text": "几小时后……",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000031:dialogue:000": {
      "source_hash": "sha256:569c671b5d3c980e037e5f732668fbbf34aaf74904961921070b86beb7ac04e9",
      "text": "把这个这样摆……好，大功告成！",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000043:dialogue:000": {
      "source_hash": "sha256:534427700ee4084fbd4d57a37bf8038ace6d8abd68abdc742fd3bc6dca025df1",
      "text": "哇，真不愧是冬马君。\n看起来超～美味♪",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000048:dialogue:000": {
      "source_hash": "sha256:090080b5174a2edb6ec0f47f7ee7a1d937f45bfa6c225914095504b501ee966b",
      "text": "像这样全摆出来真壮观呢。\n我也很有成就感哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000054:dialogue:000": {
      "source_hash": "sha256:3a13fee642c2aee4042afd5fca027bd8e546a8dd386a213a7b639a0a6058abfe",
      "text": "我送的生日礼物也\n好～好准备了，你就期待着吧。给！",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000060:dialogue:000": {
      "source_hash": "sha256:30431c8c30d643e0e9e5cba40399dab1044f73ab37ba2b270895b6717c916025",
      "text": "谢谢。到底是什么呢。",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000068:dialogue:000": {
      "source_hash": "sha256:f6e10c0f44c631128c74d1153a3a8d7636a98d9e010c7dc5c2254f4bdd8183e0",
      "text": "一定要一个人的时候才能打开看哦。\n等你的感想！",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000083:dialogue:000": {
      "source_hash": "sha256:2dff9e30705b49bf3e15b36e3f9f7d78ed36838c30e5df96ab67b1310958605c",
      "text": "制作人也送了慰劳品蛋糕哦。\n说今天因为工作来不了非常抱歉。",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000089:dialogue:000": {
      "source_hash": "sha256:b0ae08ae661132b5214459a8c7f5b29355252a05b9efdf187e7abc15f08b751c",
      "text": "太感谢了呢～那个待会儿也吃吧！\n那么，重新来一次……",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000115:dialogue:000": {
      "source_hash": "sha256:e720de7db057f848a4719eb2f137d69dbf23c66873979ee8cc86edd499be3887",
      "text": "生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_2_003hok_02_1_2_003_02:1_2_003_02_e:cmd-000127:dialogue:000": {
      "source_hash": "sha256:fd0bb429d23a2e94f62541e93ef17efbfcf6dd84ef6eb7747f8b7e3cff7cb82a",
      "text": "谢谢你们两个。\n对我来说，今天成了非常特别的一天。",
      "status": "draft"
    }
  }
}
