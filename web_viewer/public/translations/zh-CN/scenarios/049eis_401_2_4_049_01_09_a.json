{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "049eis_401_2_4_049_01_09_a",
  "source_raw_hash": "sha256:fd5eb0d3f49f12e6d299487081d963ac558142eaac132fb162c4111381ebb9a5",
  "entries": {
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:08a823661f4ab2c8f12c66d2f3d3ca40cf1f3fe0fb833dcc4db72072c8e9718a",
      "text": "喂。杂志的采访刚刚结束了。\n特此向你汇报。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000008:choice_short:000": {
      "source_hash": "sha256:813ebb9c33e9ba90438c68631a71f7303808e149372b699a4249856d6c3dc4b1",
      "text": "辛苦了。\n采访进展如何？",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000011:phone_message:000": {
      "source_hash": "sha256:9bb568988195a88b78dd393feedfb8c17cf78a0789dd6b011182645d82536016",
      "text": "对方问起了前阵子那部电视剧的事。\n那确实是一份令人印象深刻的工作。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000013:choice_short:000": {
      "source_hash": "sha256:894fc47b35dd661d8da6975f89b03b5a17619cf09ba3ce85042e5300753b6e32",
      "text": "因为非常引人注目呢",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000014:choice_short:000": {
      "source_hash": "sha256:2dd4d804d648dcc552c24775ca313e4d793547a0a66932a12b856ca6556ade12",
      "text": "毕竟是\n重要的角色呢",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:a67748b9fc18545970c719f83efb38c8facee20089cc596a73a0871d1b5117c2",
      "text": "采访记者给出的评价，\n也和你差不多。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:643755e2c6ebbc16fd1c48220be9900068a3ec0e9723f0b9572792a30e9f531d",
      "text": "的确。我的那个角色，\n确实处于一个能给观众留下深刻印象的位置。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000021:phone_message:000": {
      "source_hash": "sha256:9bbb895acad61fb840a8db899b0331702b0773c9bf8ee3148d2f83996deda371",
      "text": "化身为有别于自己的某个人物，\n果然很有趣。但与此同时也十分困难……",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000023:phone_message:000": {
      "source_hash": "sha256:cf3eb6994a3f1d67703fcec71ae451ee039469de512d69948119d97e2e6561f2",
      "text": "那份艰难，我原本以为在脑海中已有预想。\n然而这一次，我切身体会到了。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:689250cdc54bd359542b28e7cb12df0ec12434fd70473980300874dc55dbb9d7",
      "text": "……在我父母看来，\n现在的我恐怕还远未够格吧。",
      "status": "draft"
    },
    "story-text:v1:049eis_401_2_4_049_01_09_a:2_4_049_01_09_a:cmd-000027:phone_message:000": {
      "source_hash": "sha256:d5586e887b7184447fd682441aff20b13b52a7e6d99e0fc91b49797450442b29",
      "text": "抱歉，本打算只是简单汇报，却说长了。\n那么，明天起也拜托你了。",
      "status": "draft"
    }
  }
}
