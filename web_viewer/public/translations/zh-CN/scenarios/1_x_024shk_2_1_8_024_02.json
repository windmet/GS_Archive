{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_024shk_2_1_8_024_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:41bac569c3ae46525673b3cfceca6c361be2c6b13ac1f5223a268533b72b5292",
      "text": "啊，●●●●プロデューサー酱？\n这么晚打扰真抱歉！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:36da4d604f5bed78594bc0fc2562a85e68c7d07a294507945fdda7367cef4138",
      "text": "今天是●●●●プロデューサー酱的\n生日对吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000014:phone_message:000": {
      "source_hash": "sha256:61844b0ed65499be82ad85db0f0ecce272d41913c7210c5df5d62ed823e1e05d",
      "text": "因为是Mega Mega值得庆祝的日子，零点一到\n我就光速打电话过来了！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000016:phone_message:000": {
      "source_hash": "sha256:494548e96d8cc89bd48225786ce19b26c5b5ed660a6ec340757d2cd7652d177c",
      "text": "祝你生日快乐！耶——！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000018:choice_short:000": {
      "source_hash": "sha256:f7f6598ef49887c30e0ff97bb4e824e3f6cde580f4e901c38dcc6b10f316737a",
      "text": "能收到你的祝福，\n我非常高兴",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000021:phone_message:000": {
      "source_hash": "sha256:07405c1eacd123a18133c672b50e5911ef96ba60c829aa1a43c3f2998a423a0f",
      "text": "今天或许也会很忙，\n但也去吃点喜欢的东西，做点开心的事……",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_8_024_02:1_8_024_02:cmd-000023:phone_message:000": {
      "source_hash": "sha256:e7551640f266ab93143251e11e35ee4d421c75d5d7708f613061229280e18030",
      "text": "一定要度过真Mega开心的一天哦！\n约好啦！",
      "status": "draft"
    }
  }
}
