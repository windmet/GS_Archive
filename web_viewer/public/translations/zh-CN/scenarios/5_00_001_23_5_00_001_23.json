{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_00_001_23_5_00_001_23",
  "source_raw_hash": "sha256:c15ec5b19dd76d67089a24780bbc2dc347cf829437b20ebb36cd9b1a0bd2816d",
  "entries": {
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000000:title:000": {
      "source_hash": "sha256:fa3a92beeb0230b3f0fd0363e9c77f7f4578adfad2faf1075093cca1857f2bba",
      "text": "用手作年节料理焕然一新",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000016:phone_message:000": {
      "source_hash": "sha256:433b798320449c21232a62abdefc180896a08f929613aa7505c3ba270a05ae2c",
      "text": "●●●●プロデューサー。\n新年快乐。",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000019:phone_message:000": {
      "source_hash": "sha256:4ba03b97342ebe8e9608f41fe94df3b18cc85ff861b66a9d21a09b89d59ba08c",
      "text": "我正和翔太一起在冬马家，\n想向您致以新年的……",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000020:phone_message:000": {
      "source_hash": "sha256:2ff93c8f023d3ffd2a4f53238fd41ca3569dc065e4edb8da2c6625c5b5055020",
      "text": "喂喂～！新年快乐，\n制作人！过年过得开心吗～？",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000022:phone_message:000": {
      "source_hash": "sha256:467c1cb44f0d4ab1ecce876a921cdd11c915ee00f45d021458f7ecb91b11b1b6",
      "text": "我们吃了冬马君做的\n年节料理哦～！超级豪华的，准备起来肯定很不容易吧～",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000024:phone_message:000": {
      "source_hash": "sha256:77b6982e1ed238f9ee8f330825d58d73efdcf1a6b3f25168cff0846fc975330c",
      "text": "翔太你明明光顾着躺在那里，根本什么忙都没帮吧！",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000026:phone_message:000": {
      "source_hash": "sha256:ddf370b788bf4fc51ac6a389ed969983d3b6bc6bc454bfca3ec752180a2dda9d",
      "text": "可是，做饭这种事只要交给冬马君就万事大吉了嘛！",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000028:phone_message:000": {
      "source_hash": "sha256:74f23aca198d04382c4001f9d9ab59d5a82221296535bfc8aa13bfa9da67ee94",
      "text": "冬马做的年节料理真的很绝妙哦。\n甚至想让制作人哪天也来尝尝呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000030:phone_message:000": {
      "source_hash": "sha256:eefd48b70b593714de4144c97f05e8d9d6686c742f808fb341091403eea2c6e6",
      "text": "噢！我随时都能做，尽管交给我吧。\n……等等，我还没打招呼呢。",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000032:phone_message:000": {
      "source_hash": "sha256:8caadece17f1b7fc025600fc7721c7b2382e2e17893bd2df02360126442b4420",
      "text": "新年快乐！",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000034:choice_short:000": {
      "source_hash": "sha256:f41e1d5a53e9a491f648274fddf157b9253d048c0a750385cc58c143911b7b47",
      "text": "新年快乐",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000035:choice_short:000": {
      "source_hash": "sha256:82897636ef848d15633bd37c2dab9561925e995878363cafb84522a1b9c15500",
      "text": "今年也请多多关照！",
      "status": "draft"
    },
    "story-text:v1:5_00_001_23_5_00_001_23:5_00_001_23:cmd-000039:phone_message:000": {
      "source_hash": "sha256:e30497a3eabeafa7bc41151bc8e82ff0a4d3b87156dc31f4c1b1187494dccb28",
      "text": "我们今年也会勇往直前地冲下去。\n多关照啦，制作人！",
      "status": "draft"
    }
  }
}
