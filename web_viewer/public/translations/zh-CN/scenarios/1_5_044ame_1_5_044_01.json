  "scenario_id": "1_5_044ame_1_5_044_01",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000010:title:001": {
      "source_hash": "sha256:8d84ccbcf286a6bf79622ad54d01b87530f290ca0c419cc37d76c67e51277849",
      "text": "时尚杂志写真拍摄的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000017:dialogue:000": {
      "source_hash": "sha256:047a4d36e17ce7ca0edf8b3480793a4e0e2f54287a43faf19c12bbbb9e7e5e93",
      "text": "雨彦先生，今天是要为时尚杂志\n试穿服装。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:c69d65a9e041ddab18358e4182b2b3ad81ce01aff37cbf1c6320888bb6a9ac20",
      "text": "嗯，之前说过试穿之后\n还要开个简短的碰头会来着。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000022:dialogue:000": {
      "source_hash": "sha256:053331ca7c38b81d42efd272bb8937a78d919eefaf563d7ce227d25681ffa14d",
      "text": "我看过资料了，\n是个设计风格很沉稳的品牌。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:1fb1baf7aafa18398cd9ccd2c05fa0fb4d5317cc194d9586b460260962ab1c2f",
      "text": "应该也很方便换着搭配穿。\n只要衣服尺寸合适就好。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000032:dialogue:000": {
      "source_hash": "sha256:a93b4b018891eadfdf4fefaa7655ecd929bf6bfc560f0206ab9e83e2eb54be05",
      "text": "因为雨彦先生个子很高嘛。\n不过没问题的！",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d1e9195ff8cd7198052ab84a59fa38cc65af37660381a4843baf1636a77c3de7",
      "text": "对方说了，不仅尺寸合适，还特意准备了\n非常符合雨彦先生气质的服装。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000038:dialogue:000": {
      "source_hash": "sha256:93d37f7c660bdab43f9a65e20ab7990d6cfaeb453f0507300860cd8ca624eb06",
      "text": "他们非常期待哦。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000042:dialogue:000": {
      "source_hash": "sha256:34c50a42d1a6148c71e3944b43e2b7549281eefbc82b7e84b2056347aedeaf40",
      "text": "哈哈，那可真让人受宠若惊。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000046:dialogue:000": {
      "source_hash": "sha256:9528df91c007fdaad957abf2b3bfb49c88cc656745a94b0cbd6f0c4300c853fb",
      "text": "既然这么受期待，\n可就不能让人失望了啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000050:dialogue:000": {
      "source_hash": "sha256:b0f58b1346cd97327eafff820230594da6654d7e1c6f6493ccfb155fcc626565",
      "text": "为了让客户和●●●●プロデューサー都能\n感到满意，我会全力以赴的。",
      "status": "draft"
    }
  }
}
