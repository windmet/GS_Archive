{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "015ryu_306_2_3_015_06_09_a",
  "source_raw_hash": "sha256:96aa25cd706a670b278fbc7cde5c4c0e4cfe1cae1b10a2d87ec9d4bfe0070c57",
  "entries": {
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:1d7f3c469dd80e06800b827a22eff5bcd32a49a86ab447f568eba19794285679",
      "text": "喂喂，制作人！\n现在稍微方便聊两句吗？",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:109e0627b10ca87b14b236fb25f6fd5e4f2ba08cdadb779935247f1b742e05dc",
      "text": "前阵子的工作，辛苦啦！\n谢谢你把样刊也寄给我。",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:706ea3c8c7ef76934cf54f4d05ab64c4606b78d8ba98592a306f11ef1f59c931",
      "text": "我好好确认过自己的那一页了哦。\n虽然有点不好意思就是了……嘿嘿。",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000012:phone_message:000": {
      "source_hash": "sha256:e1d0d67aa2e370ee2a429beddcc6fb03d9aad88ac4edffc7252fd6735680cbc0",
      "text": "不过，拍得挺帅气的不是吗？\n专业人士的手笔真厉害啊。",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000014:phone_message:000": {
      "source_hash": "sha256:73e6b0ba67d499fc55306885a44f908c40ec80a1ea69bba6825b7723a22a7273",
      "text": "特别是接住摄影师先生时的那张照片！",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000015:choice_short:000": {
      "source_hash": "sha256:5a00f99d2dec04be87da2417ac01e6edb3f987adc3282a02a7578bae53f0f2a5",
      "text": "拍成了一张非常棒的\n好照片呢！",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000016:choice_short:000": {
      "source_hash": "sha256:11dc637b2f138317203faf03a4e9168e3582f4f50a4ac8831d5f1c6c55f86544",
      "text": "真是绝妙的一张呢！",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000020:phone_message:000": {
      "source_hash": "sha256:72c78ac749a3aa6c358801e6ef047ea82d35854e154d7f5b25748ff6edd46a86",
      "text": "是吧？果然你也这么觉得吧！",
      "status": "draft"
    },
    "story-text:v1:015ryu_306_2_3_015_06_09_a:2_3_015_06_09_a:cmd-000022:phone_message:000": {
      "source_hash": "sha256:a87623849233562ea8e37b6f9d3ae33d5c87b1ae22434379dd6f33653fdb0463",
      "text": "这次也多亏了制作人的建议\n帮了我大忙。谢谢啦，下次也拜托啦！",
      "status": "draft"
    }
  }
}
