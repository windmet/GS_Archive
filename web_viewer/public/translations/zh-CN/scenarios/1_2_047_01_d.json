{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_047_01_d",
  "source_raw_hash": "sha256:76d6e85695af13fcb8c6dbc4d6bde0b9bc2f0b36dcc489d0969434fb947b47ea",
  "entries": {
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000010:time_caption:000": {
      "source_hash": "sha256:8d6903fc720dce3f035864ae78cabbd584b180f4a1c4d1a8f1df51c5e1d3110b",
      "text": "活动当天……",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000018:dialogue:000": {
      "source_hash": "sha256:1e26c6f18be01ae7bff99d1267b4a0c3d76eba8c5db64421275219f574dd4d82",
      "text": "说是要实装新主线了。而且，\n之前限定的角色也会复刻！",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000020:dialogue:000": {
      "source_hash": "sha256:7b9b9bd5ac750343dda443daed3a0d850de2476778daab77fbc59a3a317ac099",
      "text": "PV也超级帅气呢。\n看得我心里一阵激动！",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000025:dialogue:000": {
      "source_hash": "sha256:e69d84c64eee7fcc70846a89bc5555139a255e1a2fb785ad11e9855440708a2d",
      "text": "是吧！活动关卡也要开始了，\n针对新敌人重新组一套卡组吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000033:dialogue:000": {
      "source_hash": "sha256:0a34595af7e24ee08c91691f418613de471810384c2fe5df89b5057fce204906",
      "text": "啊，不好意思，来电话了……\n我先离开一下。",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:42cab11bb0e38819e9a7e8e902604cf44cc1839743d340a391f8f88a5ceb701e",
      "text": "知道了。我就在这附近等。",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000053:dialogue:000": {
      "source_hash": "sha256:f1f439e4cb4fa579db2d9652dad71a6f0c6389c3b09135610537c6540df251b5",
      "text": "（在●●●●プロデューサー回来之前，\n看看卡组吧。嗯——为了应对下次活动的话……）",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000057:dialogue:000": {
      "source_hash": "sha256:db42ea094e0032e057c31978720a0e996209336a9fc0cfe577624e750b9db701",
      "text": "（现有卡牌之外，果然还是想要特攻角色啊。\n要是抽卡能抽出来就好了）",
      "status": "draft"
    },
    "story-text:v1:1_2_047shu_01_1_2_047_01:1_2_047_01_d:cmd-000073:dialogue:000": {
      "source_hash": "sha256:80d2accb08d29cda77f9f24d3863427dbc46cc9ad485684b9fb9f267f10447b0",
      "text": "……Hey, what's up？\nAre you on your own？",
      "status": "draft"
    }
  }
}
