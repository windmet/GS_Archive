{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_007_03_g",
  "source_raw_hash": "sha256:7d735317fc074598b4036684fdd9a2a0484908f4e2028dee4d886916839bb30c",
  "entries": {
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000034:dialogue:000": {
      "source_hash": "sha256:966de1b5cfa1e272665051ce8ab5e02c6843c5cb48865c7d3c45af6772c5e326",
      "text": "PASSION！！你们两个都合格了！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000039:dialogue:000": {
      "source_hash": "sha256:4db88d5f90f55c2a63359e86d4bc1f1dd6da56d0486e5fbc26c6d5c5d0e19566",
      "text": "我很期待你们偶像出道的\n那一天！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000054:dialogue:000": {
      "source_hash": "sha256:9ce12e7df174cebe84ef39ec934df71051d5b77591931c71cf28c7aead2edad7",
      "text": "哎！？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000065:dialogue:000": {
      "source_hash": "sha256:75e310da3dc7b2bfaca63869ee2953704960114b108656bbe191fc06567035e4",
      "text": "恭喜两位！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000075:dialogue:000": {
      "source_hash": "sha256:01a955a2f8031e634c557aa3d926735e552a05180aed567c9c04eca5b435fba6",
      "text": "那么，制作人君！贤！\n剩下的就拜托你们了！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000086:dialogue:000": {
      "source_hash": "sha256:554474fd0bcf2bfe062fc8966c856638d191d6e42e5346541d56a279e7d8ced6",
      "text": "好的，交给我们吧！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000093:dialogue:000": {
      "source_hash": "sha256:2c905f994ac54b241f8e491fbac55c77709dba33cfd9e9395a45867ab282a4ea",
      "text": "那么，关于今后的流程，\n就由我来向两位说明。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000106:dialogue:000": {
      "source_hash": "sha256:9af09c7c605d242f05da51bbe9c5705eaebfbb5437d34b23c014513f863bced0",
      "text": "……咦，好像有人来了。不好意思，\n●●●●プロデューサー，能麻烦您来做说明吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000110:dialogue:000": {
      "source_hash": "sha256:bd1c8293faff8253b25158cd4b0694d2907dde53e56a6a30321311bc95ef1333",
      "text": "包在我身上。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000131:dialogue:000": {
      "source_hash": "sha256:4b0a22637ecee016315b442e5cd8bb26fcd7f21b119a552fc44a485590ee653e",
      "text": "说合格了……不用展示实技考核吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000133:dialogue:000": {
      "source_hash": "sha256:de73581198ea992ac9732d946b963aff2523819ef99c7218c5d3aa165b47606b",
      "text": "是的。315 Pro单独举办的试镜\n有各种各样的形式。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000141:dialogue:000": {
      "source_hash": "sha256:ea05baa8e3fe9eb1d55c85502fd23a8592835c899d55c27b0c285072829117e2",
      "text": "像今天这样，\n社长一句话就合格的人也是有的。",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000148:dialogue:000": {
      "source_hash": "sha256:ffb5a02d2afc210fef44fedf3c405a9ce89bd1ec65110b30f9bf2a60f8166984",
      "text": "这样啊……呵呵，真不可思议的事务所。\n不过，今后感觉会很有趣呢！",
      "status": "draft"
    },
    "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_g:cmd-000156:dialogue:000": {
      "source_hash": "sha256:fc70edf80e64e4a4ddb53ac1dec2bd428e4510e0b6b93933fe4b3592217a645f",
      "text": "是啊。\n重申一下……今后请多关照。",
      "status": "draft"
    }
  }
}
