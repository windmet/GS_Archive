  "entries": {
    "story-text:v1:1_x_031sak_1_7_031_01:1_7_031_01:cmd-000011:dialogue:000": {
      "source_hash": "sha256:c99ea3531479420a3daf25ebbdba37686b2dea5e1640a454d6d6ebc505184ccf",
      "text": "咲先生的生日就是今天对吧。\n祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_1_7_031_01:1_7_031_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:41775b3eb2f562d4957d2580bcbed8fc4f785e0ff681187b375acf942d2a4fc6",
      "text": "哇——！超感谢——☆",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_1_7_031_01:1_7_031_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:34a0f74e03ab8fa4f96e51f7cf1631902129122a4c4c82503900adc7f066c99a",
      "text": "能收到●●●●プロデューサー的\n祝福，超级开心！",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_1_7_031_01:1_7_031_01:cmd-000025:dialogue:000": {
      "source_hash": "sha256:747d3409f8b0dcef4f42d483d5ac029b9520d7a4a0347efe7357a53f3eb1a6bc",
      "text": "特别的日子，变得更加更～加特别了。\n诶嘿嘿♪",
      "status": "draft"
    },
    "story-text:v1:1_x_031sak_1_7_031_01:1_7_031_01:cmd-000035:dialogue:000": {
      "source_hash": "sha256:f32c66b5d699413e6772975c56c766786e26044fd5d3f0e2a386bb303e8844bd",
      "text": "今天预感会是啪噗啪噗超快乐的一天☆\n生日要尽情享受个够——！",
      "status": "draft"
    }
