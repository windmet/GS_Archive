  "entries": {
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000010:title:001": {
      "source_hash": "sha256:66698261ae33e331c1c7f85a3d6920aa6f9af58e6680234112f69c41c9b78a8b",
      "text": "音乐剧舞台的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:ed58116b74e0077dd1477318487a312bf6b67386aaa482082e8d24c5e8621702",
      "text": "哈啊啊啊……累、累死了……\n已经站不起来了……",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:55acca94d88078eae92d964b31640adad39ce82693624e8556f2ff595dded25e",
      "text": "朱雀先生，辛苦了。\n请喝水！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:71ffb4b1659b815fcce7815dfd3351566380647a9c1080764d6b0299ad0f4fc9",
      "text": "太、太感谢了……\n……咕咚！哈啊，活过来了……",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000029:dialogue:000": {
      "source_hash": "sha256:6d08080230a086fbee5a1c8d366b55d36c8fa0444b6d7b9d18b68e8b438c93a1",
      "text": "之前就听说导演特别严格，\n没想到真的这么夸张。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:1c327a1fb922e1f99324a25930d852cd0137ebe4117bb03fce523fce7dd1387d",
      "text": "因为是著名的音乐剧舞台，\n所以对方可能也格外投入吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:d1437b76fd831b03b8792136cbcea96ab5a99d2176d025db3f6725159c5e6645",
      "text": "虽然会很不容易，但我相信\n朱雀先生一定能让演出大获成功的。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000043:dialogue:000": {
      "source_hash": "sha256:de14272b3a33341fdec3d181871cce67efee11d7435957394e7603932c317c49",
      "text": "那不是理所当然的吗？虽然确实很严格，\n但相对的，也让人觉得很有干劲。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:1721acddf52e11e99747d8d33f4cd57a4ec14d2ca0ec64c9751a4c183204c19e",
      "text": "总之，全力去干就对了！",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:448e292310033f2ccaeac0486aa2146fee87637091e14dbd566a76095c363eba",
      "text": "真可靠！\n我也全力支持您，一起加油吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_025suz_1_5_025_03:1_5_025_03:cmd-000054:dialogue:000": {
      "source_hash": "sha256:9f488af8653bfc495968b531dd7e02e6960d03467f645250a67bc7c9d9858e4c",
      "text": "哦！我一定会让它成为最棒的舞台的！",
      "status": "draft"
    }
  }
}
