{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_038tak_2_1_2_038_22_t01",
  "source_raw_hash": "sha256:90047499064a1f9d2879e9ca0d5d7987042f1bc8fa30275447be8e8e20ec8233",
  "entries": {
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000007:phone_message:000": {
      "source_hash": "sha256:02e935a8db1036a6eb393f18717666775ab6c08d40e79a661c58f61b680d0f06",
      "text": "制作人。辛苦了。\n现在方便吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000009:choice_short:000": {
      "source_hash": "sha256:6675d6089c919cb09cc4d8d696a0193186f7cc82b9b1af0f491acfdc10f69909",
      "text": "嗯，没问题的",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:c95ecf3a58aec820a8a4c7b8f27fd68c338d20578bb5825b8753a2a23d23b04a",
      "text": "我想对你今天为我开的生日派对\n道声谢。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:80cc197f3e7a6d642dd65ad874f9d5ea8138e3edcbb93756fb4fa10ae61beb07",
      "text": "圆城寺先生亲手做的大餐很美味，\n听说由你挑选的蛋糕也让我很高兴。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000016:phone_message:000": {
      "source_hash": "sha256:2247252e27cda8caf3ac4d39f3126de418ba166e9260a10add214e0d7eae4a87",
      "text": "当时你突然邀请我去散步，\n也是为了准备这个惊喜吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:d6406f642417abb3a8dc0d1f429344b705103808fc2670c897798586ab5f809f",
      "text": "没想到那个时候，圆城寺先生他们\n正在事务所里做着准备啊……",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000020:phone_message:000": {
      "source_hash": "sha256:efef7181ccf8feb247854480466b72b5e032c7859142a6d8fd43b7bb9c1e038c",
      "text": "这是一个令我难以忘怀的生日。……多谢了。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000022:choice_short:000": {
      "source_hash": "sha256:8190901341cd26dc0845f5133f1de607c48d6e5f422739e6aeec93c26babb585",
      "text": "明年也一起\n庆祝吧",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000025:phone_message:000": {
      "source_hash": "sha256:baf91ab63945f88a7e545953863c329f6afe187ef9a41f3f3fae90f9356d7f2b",
      "text": "好啊。\n还有，等到了你的生日，就轮到我来努力了。",
      "status": "draft"
    },
    "story-text:v1:1_x_038tak_2_1_2_038_22_t01:1_2_038_22_t01:cmd-000027:phone_message:000": {
      "source_hash": "sha256:cf8f7d21a406dafebfbe54d0e1f10493cf2ef4b757f3a0d9c91a6afd27cd5e13",
      "text": "虽然不知道能做到什么程度，\n但敬请期待吧。",
      "status": "draft"
    }
  }
}
