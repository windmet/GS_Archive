  "entries": {
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000010:title:001": {
      "source_hash": "sha256:1032370a88a6f8dcfc29af4d580e74fc3e90d8d64eb2d166bbc956d21edc60da",
      "text": "手机游戏广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000021:dialogue:000": {
      "source_hash": "sha256:2d9633f4bfe701297ca734f598ddbf667361a474f7f1c4f61cf55ade9ef993b9",
      "text": "唔——，总感觉连击连不上啊……\n……啊，这样做就行了！好嘞，通关！",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000028:dialogue:000": {
      "source_hash": "sha256:afd36260be7fa02848cdec38d5a4dd0fea94dab0fb92bf5af3c8144846b1c623",
      "text": "辛苦了。……哎？\n隼人先生，您在玩什么呢？",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000034:dialogue:000": {
      "source_hash": "sha256:d5e48963e625fbe213b8ab32fbe035126844177eb90151f5ce65e9a2a08f2d4b",
      "text": "●●●●プロデューサー，辛苦啦。\n是一款手机游戏哦。你看。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000036:dialogue:000": {
      "source_hash": "sha256:cd7e4adb0230fd10589d56a6f8caecdda0726c87a8c3d9cc60f672398f827c62",
      "text": "这是……隼人先生接下来要出演广告的那款\n游戏呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000041:dialogue:000": {
      "source_hash": "sha256:cca78370ea0fbf7524e0621f4c24f83e056a225196e4c53833928236c4a2c1b7",
      "text": "没错没错！虽然是益智消除游戏，\n但是超级有意思的。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000045:dialogue:000": {
      "source_hash": "sha256:54b7496b0e9ab7a99f657268dfb421a601bce07422ee9f783b3ace7de6ecfeea",
      "text": "只要有一点点空闲时间就能玩，\n所以我都在学校课间或者路上玩呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000049:dialogue:000": {
      "source_hash": "sha256:da96d63c4aede02df620a3b9911d884416579054f65eb554c275e03d71a36c6f",
      "text": "能出演这么好玩的手机游戏的广告，\n真高兴啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000054:dialogue:000": {
      "source_hash": "sha256:5b53903b5ff25c31cd1effea8c56d57c57942f6be6546875acab4f24f864f9a0",
      "text": "方便的话，●●●●プロデューサー也来试试看吧！",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000057:dialogue:000": {
      "source_hash": "sha256:44ccf2664dc20a8b00a80037c180e764af681a9a2090b96def5f2743cbefa739",
      "text": "好的！我这就去下载。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_01:1_5_020_01:cmd-000062:dialogue:000": {
      "source_hash": "sha256:09568fbef40a3eec439137018a0562a72a3254ceddef53ec98e0981911dae7cd",
      "text": "太棒了！要是有不懂的地方，\n尽管问我哦！",
      "status": "draft"
    }
  }
}
