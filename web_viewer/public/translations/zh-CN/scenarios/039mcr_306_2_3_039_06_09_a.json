{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "039mcr_306_2_3_039_06_09_a",
  "source_raw_hash": "sha256:72e07725b56b720626d4b2ab45eb0575ec016c908981553f6d65573084c4571b",
  "entries": {
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000006:phone_message:000": {
      "source_hash": "sha256:bd125bcb98921a3dd90e465cc84d73a37418fdc2e6dc2d7e86a26501a8699b2b",
      "text": "●●●●●●●●●●师父，辛苦啦！\n明天就是万圣节派对了呢。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000008:phone_message:000": {
      "source_hash": "sha256:b8daa9657f38ecbb6a470df72bb0df9b7c50755a69b2eccbe293c40002185f71",
      "text": "点心的准备和料理的预处理都万无一失了。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000010:phone_message:000": {
      "source_hash": "sha256:834eeb7ed1cfa4e6132e54eb4faba03a3c9a91a52a6ac5eaf77af35526a797c9",
      "text": "料理的最后收尾，诚司他们也预定好\n要过来帮忙了哦。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000012:choice_short:000": {
      "source_hash": "sha256:ebf83341295d1ad0a2a57298ec5a42f98634fbba984a856e530604043e2b5d7d",
      "text": "非常感谢\n明天就拜托了",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000015:phone_message:000": {
      "source_hash": "sha256:38bdcac784ed90df5d813051b7a9b1e54729bd756f53968d0db35154f334704d",
      "text": "好，包在我身上吧。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000017:phone_message:000": {
      "source_hash": "sha256:ee9a0a79f00be9b4419f060adca87d4b76e8e54d325df2d18033f991b0d2b9a7",
      "text": "对了，准备的间隙我试着做了个杰克南瓜灯的\n编织玩偶。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000019:phone_message:000": {
      "source_hash": "sha256:cc10aa165851254e6fa3d9a45055419301409c85a9c2bb08fcb980a2fc1bf3d5",
      "text": "不嫌弃的话，能收下当作万圣节的纪念吗？",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000021:choice_short:000": {
      "source_hash": "sha256:e86e89c1bd298f28839f93bf4b35881e3c6f0e7352ee2827dff36489fff4d035",
      "text": "当然可以\n我很开心",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000022:choice_short:000": {
      "source_hash": "sha256:7705a37297142eabca0b2b54b5b2b4fc3ca541399d4ff65363a51a9430aaeb1a",
      "text": "很期待会是什么样的玩偶",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000025:phone_message:000": {
      "source_hash": "sha256:77756f05e937a2dc957b977a5733f0c09d0e585d29f5a74608caa4f16018f895",
      "text": "哎呀，你能这么说我真高兴。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000029:phone_message:000": {
      "source_hash": "sha256:2da93c821d2db4b81c47a455bdd27d9255e686b5a83d27ac0330d692f284b894",
      "text": "哈哈，涟还说是诡异的南瓜呢。",
      "status": "draft"
    },
    "story-text:v1:039mcr_306_2_3_039_06_09_a:2_3_039_06_09_a:cmd-000034:phone_message:000": {
      "source_hash": "sha256:852408404d0ee8d148a0eba815be2c7d23cc3723ad84f63cda103ff93eb72828",
      "text": "师父要是能喜欢就好了。\n那我们明天现场见！",
      "status": "draft"
    }
  }
}
