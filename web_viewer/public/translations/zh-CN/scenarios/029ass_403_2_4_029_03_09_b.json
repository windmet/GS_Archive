{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "029ass_403_2_4_029_03_09_b",
  "source_raw_hash": "sha256:f1153a89af63100aa5ab2ee978943fe614837f53adaddb680510cb8d7c567c2f",
  "entries": {
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:1c0af8ca136c264353cff0c0f6081e93b653374b1f0ff6fe26f765984f971aed",
      "text": "哈哈哈哈，吾主啊！终于到了明日，\n从遥远彼方之地奉上的供品祭典！",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:55b2234697f95a64d7d357554b9a84879aa7408c043589da3c0ada458aba649f",
      "text": "在我披露精炼术的仪式上，\n定要让光之子民为之惊叹。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000010:phone_message:000": {
      "source_hash": "sha256:a2d8e9e015a87ecd1d56a55f7fca33c7ed3e064151061393cbbc643a10fc0b37",
      "text": "尽管在我伟大的黑暗魔力面前颤抖吧！",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000012:choice_short:000": {
      "source_hash": "sha256:ae28dad0861e976f591122da3b08d9c87d2b690aa1247cc7f047f52d0b049394",
      "text": "那当然了，\n请加油",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000013:choice_short:000": {
      "source_hash": "sha256:b4668b53ca32d7cb16e4702f44e5b9180fd34858b4bc39e1fbd7bdca8be04e40",
      "text": "很期待客人们的\n反应呢",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000016:phone_message:000": {
      "source_hash": "sha256:d6861c346415c0c7a4009945b63d011143bc5b320153bf00cc2c9f4d46e44b93",
      "text": "嗯，我立誓绝不辜负吾主的信赖。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000018:phone_message:000": {
      "source_hash": "sha256:dcd756f5fd5513fda706202cecd49ccff12bf3da662011130b80723098bbd440",
      "text": "为了魅惑光之子民，我已备好了至高的精炼术。\n为迎接明日，且温存魔力吧。",
      "status": "draft"
    },
    "story-text:v1:029ass_403_2_4_029_03_09_b:2_4_029_03_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:15261c2ee75840f20f65caec0fa6662238ddded5befc0a78f30f7cb1a62f4aa3",
      "text": "那么吾主啊，好好期待明日吧。",
      "status": "draft"
    }
  }
}
