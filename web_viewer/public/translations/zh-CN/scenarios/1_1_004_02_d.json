{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_004_02_d",
  "source_raw_hash": "sha256:ade874004a89fed7949507efee0fe64dc8a1fc60049d5ab7499b089ea4586ebf",
  "entries": {
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000017:dialogue:000": {
      "source_hash": "sha256:cad895184469f07bb6a597956377363faae0f193c8c50424aecc0e16bdc55e19",
      "text": "听说你要离开这个家了啊。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000020:dialogue:000": {
      "source_hash": "sha256:0edc00bee8e02dfd435f390c8a821dc5f3a325f4176e1654b9c6003206801f69",
      "text": "和大哥你没关系吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000022:dialogue:000": {
      "source_hash": "sha256:4ca7e5ceaf0ee7c2895ab691e8acb114889e28b85a515c75754c6d0fbe593c7c",
      "text": "考大学的事，还有和老头子的事，我都听说了。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000026:dialogue:000": {
      "source_hash": "sha256:9456e1bfccce4212c7107834d7480a1a2dfc50d8c749f3e103648d1ae90be3fd",
      "text": "所以，大哥也是来骂我的吗？\n说什么“鹰城家的耻辱，整个家族的败类”。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000028:dialogue:000": {
      "source_hash": "sha256:02e643c7cbb2f6272d620a63b59428725fce058f02d36ce4c9849bb9fdf7573a",
      "text": "……你就甘愿一直被贴着\n那样的标签吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000031:dialogue:000": {
      "source_hash": "sha256:3d906bb765107b00038390e2342c595a5f9e6ab99ede6e0eb5ea56e2685769a8",
      "text": "像这样逃走的话，\n到头来不过是个丧家之犬罢了。",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000035:dialogue:000": {
      "source_hash": "sha256:14f44e7020fa37f7c4552790094bb31ab3e662446bf35e41854fe00ca1cc8ba0",
      "text": "……我才不会当什么丧家之犬！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000039:dialogue:000": {
      "source_hash": "sha256:3aace0f109736f120d3511a931d14f2f5c5543df3757918c7b3fa27c8d67f86c",
      "text": "我和你不一样！",
      "status": "draft"
    },
    "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_d:cmd-000042:dialogue:000": {
      "source_hash": "sha256:34efd6db3394332a9ffe3bcc828568ea037d78b1b3d20fcb35b3e6b6ba0cd871",
      "text": "就算没有鹰城的名字，我也一样会成功给你看！",
      "status": "draft"
    }
  }
}
