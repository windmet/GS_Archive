{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_001_01_a",
  "source_raw_hash": "sha256:eaf3af6078add97a399b50279466b5c664fe4bf70eeb53783a4afbf34e9bbbba",
  "entries": {
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000000:title:000": {
      "source_hash": "sha256:7ec5c55e7961103b208375682e51af42d89ae4c2599f6bbff0756d993f5af866",
      "text": "值得依靠的成年人",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000000:synopsis:000": {
      "source_hash": "sha256:bf1f22a1e2853cd157f4fe46d9a624fb4a98144bf3a9be387477ff31e85b4fbb",
      "text": "节目录制结束后，冬马为了收拾行李回到了\n休息室。然而，冬马却在那里发现自己\n丢了东西。在制作人的协助下一同寻找时，\n冬马注意到了某种可能性。",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000010:title:000": {
      "source_hash": "sha256:7824b3a8948acd2c72636875e79b09adab6d8fca3c20b65cfcfd68e8d3eae4ba",
      "text": "第1话",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000010:title:001": {
      "source_hash": "sha256:7ec5c55e7961103b208375682e51af42d89ae4c2599f6bbff0756d993f5af866",
      "text": "值得依靠的成年人",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000012:time_caption:000": {
      "source_hash": "sha256:aa09216fbe1720584c8a3cdb13cfdf6b2493ed19f9d789f2446f25e399d3ecb0",
      "text": "冬马家中·厨房",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e0bda1ecbddecdff83f521f5b723ac67edb71b2734f43f1c287f15670e995f86",
      "text": "配菜准备成这样差不多了吧。\n接下来只要把肉处理好就行了。",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:7474f99bbf996c15dd466b1d84240d003e0b1196c0b5882fa62a3d0193368093",
      "text": "昨天的特卖真是太走运了！\n没想到能这么便宜买到这么好的肉。",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000035:dialogue:000": {
      "source_hash": "sha256:9aa4c84d3f731cae39cde907b255f3c0f88b8dbfe06e2569381a2bf41aad728f",
      "text": "把这肉泡进特制酱汁里腌好……\n这样就行了。",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000041:dialogue:000": {
      "source_hash": "sha256:80c23b494c5e3d0d023cb09e9b2f6bb83139ee039b62c7ff8bdcccb23e2ecdc0",
      "text": "到晚上应该就腌入味了。\n真期待做出来的成品啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000051:dialogue:000": {
      "source_hash": "sha256:4b767363101dcd5e4cfec5f4748b8eda6a73cd7b9c575c9b9c6ad6bb9f9be51d",
      "text": "（饭也准备好了，时间刚刚好）",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000062:dialogue:000": {
      "source_hash": "sha256:97ad49cca797f2fcc0a1a80c74e3833dc96365bbbf2a4a6b9860fc382df5db05",
      "text": "好，差不多该出发了。",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000066:dialogue:000": {
      "source_hash": "sha256:149fad5d35f822c7bb12dcb8cc8cd75414852b834da2027fabe946b04f8e5c86",
      "text": "今天是要录制综艺节目来着吧……",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000069:dialogue:000": {
      "source_hash": "sha256:dbeaf170cb79a75b3b18ea0ee763c4ee3877f016c12c52602ceeff6747bc9b32",
      "text": "去电视台和●●●●プロデューサー汇合，\n然后排练……",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000075:dialogue:000": {
      "source_hash": "sha256:790d361b57298583e7e3730952f15abe9029239b1ba0e780430fa54f4c1d8a0a",
      "text": "……好嘞！\n今天也干劲十足地冲吧！",
      "status": "draft"
    },
    "story-text:v1:1_2_001tom_01_1_2_001_01:1_2_001_01_a:cmd-000079:dialogue:000": {
      "source_hash": "sha256:dd92c5de6aacf86be1844d7c8a32483d00d28fa5fe98b6bb6abedfac3a144099",
      "text": "那，我出门了！",
      "status": "draft"
    }
  }
}
