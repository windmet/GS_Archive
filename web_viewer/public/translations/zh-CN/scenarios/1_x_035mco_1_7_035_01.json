{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_035mco_1_7_035_01",
  "source_raw_hash": "sha256:a1c05fdbb2a33c6285dc373ac005f330b68413bb4d1c27eb96f12702abb78feb",
  "entries": {
    "story-text:v1:1_x_035mco_1_7_035_01:1_7_035_01:cmd-000010:dialogue:000": {
      "source_hash": "sha256:ab66ba3e2408f312429425122c9b6abb8c1ec15dcda3c1858efbf8b2654deaf9",
      "text": "道夫先生，祝您生日快乐！",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_7_035_01:1_7_035_01:cmd-000015:dialogue:000": {
      "source_hash": "sha256:ad768660b6a41167f14db2583a2efdd42caa9438801d703a5454ffd4d38854c0",
      "text": "谢谢你，●●●●プロデューサー。\n感谢你的这份心意。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_7_035_01:1_7_035_01:cmd-000019:dialogue:000": {
      "source_hash": "sha256:4a2082c02cfeaed30f466ecd13ce785ac995ecd0bd02692efa0fec5e090fbd91",
      "text": "没想到到了我这个年纪，\n为我庆祝生日的人反而变多了。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_7_035_01:1_7_035_01:cmd-000023:dialogue:000": {
      "source_hash": "sha256:6042a23c6c00ab4a6c665e118f65c20937924e9335e03f8d604d704056e71e28",
      "text": "这都多亏了你。这份谢礼，我想通过在偶像工作中\n拓宽活动领域的方式来回报你。",
      "status": "draft"
    },
    "story-text:v1:1_x_035mco_1_7_035_01:1_7_035_01:cmd-000030:dialogue:000": {
      "source_hash": "sha256:8e0c2a62549e415e0c208df1e636adfc247ee40107292625707d4afb8e74ef45",
      "text": "今后这一年，\n为了能为你带来更多捷报，我会继续迈进的。",
      "status": "draft"
    }
  }
}
