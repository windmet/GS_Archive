  "entries": {
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000000:title:000": {
      "source_hash": "sha256:b3e1153118bbbbd3869b1d2a32e4394ffdd77df34d10a2a98c144a02a4b525e1",
      "text": "充满PASSION的1年！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000000:synopsis:000": {
      "source_hash": "sha256:34e73cd896f66dd802cdba9d0abbc85b94874a2227efaa28d45e9d9882865b4c",
      "text": "迎来了新年的315 Production。\n偶像们换上崭新的心情，\n与制作人互致问候。",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000014:dialogue:000": {
      "source_hash": "sha256:8caadece17f1b7fc025600fc7721c7b2382e2e17893bd2df02360126442b4420",
      "text": "新年快乐！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000023:dialogue:000": {
      "source_hash": "sha256:070bd9fda8e027e0a53fe543d45d0996077c59f752e896b16d1b7d12d70dcf5c",
      "text": "新年快乐！\n今年也请多多关照。",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000028:choice_short:000": {
      "source_hash": "sha256:ab11cfb33245ceec1b91f34b33b3fb44dce553a6967caeb4fcf9b7db9b9755ec",
      "text": "新年快乐！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000029:choice_short:000": {
      "source_hash": "sha256:ab741847666f7669c5dcdcf7883547dfec288784de8da99ea0a6a5b7a4853f12",
      "text": "今年也请多多关照！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000035:dialogue:000": {
      "source_hash": "sha256:d267ec218da128a03374cd8943c487dd91e646019c0963e966f5c2b65eeff69f",
      "text": "嗯！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000037:dialogue:000": {
      "source_hash": "sha256:cc26d75b9c59a7cebcb2a174194323ba134d5fb014e5e46ade2708537a503631",
      "text": "制作人君，年初就开工辛苦了！\n贤在年初过得还算悠闲吗？",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000049:dialogue:000": {
      "source_hash": "sha256:a5c1b0185dd55931f7809b8e407482916e44ee2664cebb56019a2cd7a8bc382e",
      "text": "是的。我去进行了新年的第一场钓鱼，\n还刷新了自己的最好纪录！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000056:dialogue:000": {
      "source_hash": "sha256:7341fdd55bcee165bfc755429e79908e3d50868232d7d59633e45db0eda749fb",
      "text": "哦哦，那可真是了不起的收获啊！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000058:dialogue:000": {
      "source_hash": "sha256:d837a716a258085f6ad586d03a09130d11cfc5fb6826d019d582686a2e995095",
      "text": "嗯。贤君，恭喜刷新纪录！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000068:dialogue:000": {
      "source_hash": "sha256:6593d98e0422ff222d6fa6f76afe331c9b863c4c7faa56b4a68232f7721ec990",
      "text": "好的！谢谢您。",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000075:dialogue:000": {
      "source_hash": "sha256:355693e91008b16adc73eaadd41daa7957ed9dcfcf261d1b2752df2137a3fc92",
      "text": "那么，差不多该开工了吧！\n今年也一起让315 Production更加热闹繁荣起来吧！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000077:dialogue:000": {
      "source_hash": "sha256:b2f05d2ebcfd03ee889d1305b6bcc3183ca09cba043fc80dcea405badc7d7bac",
      "text": "PASSION！！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000086:dialogue:000": {
      "source_hash": "sha256:5cc2b40a590f9ce1ae05e05f9d6fd1a38013b75a7386b9caeeacc5f6eca4de32",
      "text": "PASSION！",
      "status": "draft"
    },
    "story-text:v1:5_00_017_23_5_00_017_23:5_00_017_23:cmd-000091:choice_short:000": {
      "source_hash": "sha256:b2f05d2ebcfd03ee889d1305b6bcc3183ca09cba043fc80dcea405badc7d7bac",
      "text": "PASSION！！",
      "status": "draft"
    },
