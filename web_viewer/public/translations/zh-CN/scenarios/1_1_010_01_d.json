{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_010_01_d",
  "source_raw_hash": "sha256:4f55c9fe7c06915234d72aa37a11723b5b57555898c49c2b46ebe2868943a3d5",
  "entries": {
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000014:time_caption:000": {
      "source_hash": "sha256:076e81c5f9e1bc555babfd8d315221cee4991b5d11914c38b5454bc81cdbeb3d",
      "text": "Cafe Parade店内",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000019:dialogue:000": {
      "source_hash": "sha256:95645778092e84c64dd4e37bf8d7b0556e2b54f49a918daa99332b1b50325960",
      "text": "咖啡馆……？\n此处莫非是汝之领地？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000028:dialogue:000": {
      "source_hash": "sha256:3e860523237f4ee953196f35739a653a70a4482cbd33bc6e06d084955dd38073",
      "text": "是的。\n不过现在是非营业时间，所以没有客人。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000033:dialogue:000": {
      "source_hash": "sha256:26dad42f14271462c52dd788599b8d723ba887c7310d160600dd6fc978429949",
      "text": "我是店主神谷。\n啊，来，坐这儿吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000048:dialogue:000": {
      "source_hash": "sha256:f9dd5748cd0306b9187f3637d89677d91c18e513f5f2e7c6882cf8407ab97320",
      "text": "外面很冷吧。\n来杯热红茶如何？",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000053:dialogue:000": {
      "source_hash": "sha256:3a51e5ad383b9ee8592930e03f88abafca8f31c7c98eadb36312de8b3e93f529",
      "text": "唔……确实湿透了。\n此番便承蒙汝之好意了。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000058:dialogue:000": {
      "source_hash": "sha256:009a8ba318f0e6b0fb5130751d697bb501c23b7a39e77135f51b9db12b12b47d",
      "text": "那么，我这就去泡。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000063:dialogue:000": {
      "source_hash": "sha256:1bd61319504f2d87e3d8d0cec65ee151727be02e12a98a23af50842c6a53c370",
      "text": "承蒙诸多照料。\n伟大的堕天使撒旦亦深表感激。",
      "status": "draft"
    },
    "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_d:cmd-000071:dialogue:000": {
      "source_hash": "sha256:f0cc134a06e7fd6a74f06b5482681ace8e670f302a37a4c04a56bc54f53db31e",
      "text": "不客气。\n我马上就回来，请稍等片刻。",
      "status": "draft"
    }
  }
}
