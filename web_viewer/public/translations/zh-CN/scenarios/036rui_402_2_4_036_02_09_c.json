  "scenario_id": "036rui_402_2_4_036_02_09_c",
  "source_raw_hash": "sha256:fc7f47959cf0aaf1b1841c996f5cacea8c4f21e8e085c0ec04368d0e743dca6b",
  "entries": {
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000007:phone_message:000": {
      "source_hash": "sha256:2cbc8133ac73c6c435374f2ff53111df58976a6d0fa4913cd7b2b7c6c1486e14",
      "text": "Good morning，●●●●プロデューサー酱！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000008:phone_message:000": {
      "source_hash": "sha256:c2c963e1f5bd9cbd00ef14b867ccbbdbf778366892533c4da5a2f1255a3dc6cf",
      "text": "网球场这边天气很好，\n是绝佳的training日子哦。",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000010:phone_message:000": {
      "source_hash": "sha256:02d208c5db4fa106db405f511d465661e452026e6627d3f7e8802c9e3fb9e5ab",
      "text": "准备活动做完之后就要对战了。\nMr. 天道和北斗正在定对战组合呢。",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000013:choice_short:000": {
      "source_hash": "sha256:b61f6e607594700baa71d8c429a26927f37ea2cb843c0c4caf43bcaf13dfc075",
      "text": "谢谢你的联络！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000014:choice_short:000": {
      "source_hash": "sha256:a6493c76a7ecb845636ed6d473f1b43a2e8024d2ef41e8d7ed26a857358f2f2f",
      "text": "打球时请多加小心哦！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000018:phone_message:000": {
      "source_hash": "sha256:452346ecdc90fefe3d27738cab38aab9cddfe047b55ae68cf9d8ae26e9509148",
      "text": "我也会转告他们俩的。他们现在好像正因为\n要跟谁打而exciting着呢！",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000020:phone_message:000": {
      "source_hash": "sha256:77bacf460ff5218342dacf6ff2c8d6c002fe2a7d3210d052232d65da9847f358",
      "text": "能听到北斗他们的说话声吗？",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000022:choice_short:000": {
      "source_hash": "sha256:95cbb381bd5d712d87e07615b2ea3cb39cd1926c03f5ff2dbf568cbf61657a6f",
      "text": "能隐约听到一点",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000025:phone_message:000": {
      "source_hash": "sha256:7dfa8c0b0bc2460a1fdae4216da009547d06d3fb4ecf3cb5e729d3ce399e6c09",
      "text": "难得来一次，我把他们俩play的身姿拍下来吧。\n制作人酱也想看对吧？",
      "status": "draft"
    },
    "story-text:v1:036rui_402_2_4_036_02_09_c:2_4_036_02_09_c:cmd-000027:phone_message:000": {
      "source_hash": "sha256:07f15c2ba04638fc170c6c95bb36bca369d3d9216ecf8613ece58d75dbafe2ce",
      "text": "那么，马上要开始tennis了我就先挂啦！\nHave a nice day！",
      "status": "draft"
    }
  }
}
