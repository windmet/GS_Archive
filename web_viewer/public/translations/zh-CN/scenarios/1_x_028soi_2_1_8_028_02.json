{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_028soi_2_1_8_028_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_028soi_2_1_8_028_02:1_8_028_02:cmd-000013:dialogue:000": {
      "source_hash": "sha256:2c367be1296e77ba836c575b33f6fe030a0a04f6fde065c77eae142fa1e9dcc3",
      "text": "●●●●プロデューサー，辛苦了。\n您已经到事务所了呀。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_8_028_02:1_8_028_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:ba823ad82f3e78a73e0a9831eea31874244ea9e9eb5a34883c191ce6f89c6d9d",
      "text": "祝您生日快乐。正好是午饭时间，\n我做了饭后甜点带过来。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_8_028_02:1_8_028_02:cmd-000023:dialogue:000": {
      "source_hash": "sha256:5b7d1a6910290ec60fa1cdf9edaf02f71d0aa1c138a14f4699dfe106409957f0",
      "text": "可以的话，请当作生日纪念\n尝尝看吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_8_028_02:1_8_028_02:cmd-000030:dialogue:000": {
      "source_hash": "sha256:2e8cfcda7fe9daa0d1609ee71761e521731f331dbf81cc119b2ee84007e9acb8",
      "text": "谢谢您，太高兴了！\n我会好好享用的。",
      "status": "draft"
    },
    "story-text:v1:1_x_028soi_2_1_8_028_02:1_8_028_02:cmd-000035:dialogue:000": {
      "source_hash": "sha256:30dab489cc178f17a1e934876b42d739da701e8d80fd207024cfe6e19c43da1e",
      "text": "不客气。\n那么，我们先开始碰头会吧。",
      "status": "draft"
    }
  }
}
