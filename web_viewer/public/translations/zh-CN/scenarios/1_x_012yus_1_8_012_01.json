{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_012yus_1_8_012_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_012yus_1_8_012_01:1_8_012_01:cmd-000009:mobile_message:000": {
      "source_hash": "sha256:62d728d2a5d9b62c383f1af4f6adc3979a1c098bab77097136672bf879d74196",
      "text": "●●●●●●●●●●监督，\n生日快乐——！",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_8_012_01:1_8_012_01:cmd-000011:choice_short:000": {
      "source_hash": "sha256:4a2013bbd5f4ad3800b616a7bf6cf3c5c47b6e2fdf9afb84e46dd5c3dc91574a",
      "text": "和享介先生同时\n收到，吓了一跳呢",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_8_012_01:1_8_012_01:cmd-000013:mobile_message:000": {
      "source_hash": "sha256:06a56fafbb19658b45ef9219ec38ca46b64ed77578163f5934cd4278570ca0a4",
      "text": "我们商量好要和享介同时发的<emoji>image_talk_emoji_35</emoji>",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_8_012_01:1_8_012_01:cmd-000015:mobile_message:000": {
      "source_hash": "sha256:81d6a8cfec5fb222da36cfe13f03b25f489b0cad5261251b41e8c570f4edb0c0",
      "text": "其实本来想零点一到\n就马上发出去的，\n但我一不小心睡着了。",
      "status": "draft"
    },
    "story-text:v1:1_x_012yus_1_8_012_01:1_8_012_01:cmd-000017:mobile_message:000": {
      "source_hash": "sha256:5f570062c5f3fe1d655cf9c56122444751d986d29aa98332d75fa2622f07e28f",
      "text": "不过，能送上祝福\n真是太好啦！\n那待会儿见啦！",
      "status": "draft"
    }
  }
}
