{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "049eis_403_2_4_049_03_09_b",
  "source_raw_hash": "sha256:527da887da705df814ff3b26dee06c82222b034889c216704ae7302f152f0275",
  "entries": {
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000006:phone_message:000": {
      "source_hash": "sha256:016ca0d3d726dd209f6cf86d2e3dc0c07187244b861f8e182044e21dca8e5886",
      "text": "是我。我是特地为了道谢才联系你的。\n刚才收到了你送来的慰劳品。",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000008:phone_message:000": {
      "source_hash": "sha256:2b3854062e42ceea649570b41e047b263dec4794e467e04fa6e83762803bb2de",
      "text": "演出前能补充糖分帮了大忙。\n秋山他们也很开心。",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000010:choice_short:000": {
      "source_hash": "sha256:d4045c9f0bcf5bc928fe564cc65c652320cb7569c9290d93992945656d743c64",
      "text": "算不上什么值得\n特意道谢的事……",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000013:phone_message:000": {
      "source_hash": "sha256:a64b9336bf4ae0a47065609cab0aa96eaa3a8dec6ad012d5680a1f112ae49156",
      "text": "是因为圣诞节的缘故，\n才特意为我们费心了吧。",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000015:phone_message:000": {
      "source_hash": "sha256:22faf273b4b3a78d55bd03f4eac75ee30a714a9f49bbfefe0884a9ec1dbac188",
      "text": "毕竟里面装着的是姜饼呢。",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000017:choice_short:000": {
      "source_hash": "sha256:d1fd5839b4df1cbfa2ffb99ca5848d791c1b66e8646b435a853abcc7d035607b",
      "text": "您喜欢吗？",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000020:phone_message:000": {
      "source_hash": "sha256:8b6054129a235035796fffe4a2b094a76808fd47b472a708612ed1fad654a678",
      "text": "……撇开我的个人喜好不谈，\n确实感受到了浓郁的圣诞氛围。",
      "status": "draft"
    },
    "story-text:v1:049eis_403_2_4_049_03_09_b:2_4_049_03_09_b:cmd-000022:phone_message:000": {
      "source_hash": "sha256:8f6906a46ff2d3fee8bce8f9939bf0a101206b76b73c87692840ac0f0b48de4a",
      "text": "谢谢你。那我准备上场了。",
      "status": "draft"
    }
  }
}
