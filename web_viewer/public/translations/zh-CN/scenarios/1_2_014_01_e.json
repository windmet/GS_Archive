{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_014_01_e",
  "source_raw_hash": "sha256:19fa9482794bcad9f9e9b58a94e0f579e3a4587671bd2e6cec274cc435125060",
  "entries": {
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000019:dialogue:000": {
      "source_hash": "sha256:d2043256021f02eeb81a354743a8c48e6b2efb3d37ef0d7e6935a1194769c235",
      "text": "松饼真美味呢！",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000025:dialogue:000": {
      "source_hash": "sha256:419a9e94a1c3bbe564dfa20556c197e4ba3249ed81bcfe49f241ef457b9f93ef",
      "text": "就是说啊。工作也很顺利，\n今天真是好事连连的一天啊。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000031:dialogue:000": {
      "source_hash": "sha256:2e8a6220f9d169a49c3f4b14383fabac82d1d00aac265dd7480b8e58031ac04f",
      "text": "……啊，对了。\n能稍微等我一下吗？",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000058:dialogue:000": {
      "source_hash": "sha256:0d019fd5363c1f3928328aa99c6168f7f20365b07beb6457a386761b744970d3",
      "text": "拍得挺不错的嘛。把这个这样弄一下……\n好，更新完毕。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000060:dialogue:000": {
      "source_hash": "sha256:fd5428807876749623837c86b2e2e4a24b9419c5d59134d40c17cac68a64f8eb",
      "text": "更新，是指什么？",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000066:dialogue:000": {
      "source_hash": "sha256:52666df53e50962e20896a5bd6b49c5e0e58755c312e0e40cf4617801b56a01b",
      "text": "是LINK的头像啦。\n换成刚才去的松饼店的招牌了。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000072:dialogue:000": {
      "source_hash": "sha256:b6d8061faf58d194d051263340ac08fbbe8047f430abc8f78d42e1af1342d3cf",
      "text": "看到这张照片，\n那些家伙肯定更想来了吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000074:dialogue:000": {
      "source_hash": "sha256:8a404888f340449d6a529fff7b925460e7d4f75811e47c2d5c083e20df70a2d6",
      "text": "是说弟弟们吧！\n下次务必带他们来一次哦。",
      "status": "draft"
    },
    "story-text:v1:1_2_014hid_01_1_2_014_01:1_2_014_01_e:cmd-000083:dialogue:000": {
      "source_hash": "sha256:4efa596e4cdac14e355fa11c099da0a6516981f1d5710a8b13e8f356d155a504",
      "text": "嗯！……哦，马上就发消息过来了。\n回家之后，看来要被缠着要这要那了。",
      "status": "draft"
    }
  }
}
