  "entries": {
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000010:title:001": {
      "source_hash": "sha256:a53f0b24bc648bb68c8a5a68cc40f0e27aba9b0c5cb43a82d046c7ac564f7b51",
      "text": "面包促销广告的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000016:dialogue:000": {
      "source_hash": "sha256:046f0b6c4c64658c29e816c5334c78caa02f35fbdd4591f50c6182b52daed4a2",
      "text": "隼人先生，面包促销广告的工作定下来了！\n这是相关资料。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000020:dialogue:000": {
      "source_hash": "sha256:4397244449111e4e1afdebd6e0a16da8ce2ae3198b563882c2acfcc7ddbbdd78",
      "text": "谢谢，●●●●プロデューサー。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:3d08186bed51b4f6489839a85e97521c57de1bfe23436da8737ecd9da05fec00",
      "text": "嘿，集齐印花贴纸就能换餐具啊。\n而且样式也能自己挑选呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:59fcf39357d2f75e26d180f3ab6f16059f6a426966c0c63c2eb24ffd478677f9",
      "text": "然后这份资料上列出的，\n就是参与活动的指定面包一览表。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000034:dialogue:000": {
      "source_hash": "sha256:a224493626d85e3f3f313ec5f2b8d46a83988e7dd016a08744ebc3872b1c188f",
      "text": "红豆面包、果酱面包、奶油面包……\n甜面包几乎全都在里面呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000042:dialogue:000": {
      "source_hash": "sha256:34379393dac00ef1b1c10dd0c0a074d0508a4a58aa3fdf0c9a2f70000fffb25e",
      "text": "甜面包以外也有很多种类啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000049:dialogue:000": {
      "source_hash": "sha256:272ac9d14a14598287610d06eb716a2a1256896e43488f79dd3f2d9a40a24b44",
      "text": "啊，居然还有甜甜圈和特辣咖喱面包！",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000053:dialogue:000": {
      "source_hash": "sha256:538bc6de91695067b33d404e986a2daa27dc28a2e09ba2eb66b611de39cf2c42",
      "text": "我平时经常吃果酱面包，\n我也来集集看吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000056:dialogue:000": {
      "source_hash": "sha256:8afa8e3fcc86b24e171c2fea4b53f2d5aca4307345fa0ff75b0dca0b79092cb7",
      "text": "那我也买了面包的话，就把贴纸送给您吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_020hay_1_5_020_02:1_5_020_02:cmd-000064:dialogue:000": {
      "source_hash": "sha256:690c8adee118226aa8fe019afc62a8a387159f32e6d405d82a3f8a079515a55b",
      "text": "太好了，谢谢！●●●●プロデューサー！\n啊，拍摄我当然也会好好加油的。敬请期待吧！",
      "status": "draft"
    }
  }
}
