{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_010_01_b",
  "source_raw_hash": "sha256:016e6b1870696be9fbea3525e4006d357cb3c58f0d19af137167087f55810116",
  "entries": {
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000010:time_caption:000": {
      "source_hash": "sha256:6eca5bbb1fa78d35aa198d3e81e0dba68b9083054421ede6d539e7ce9a5b7d45",
      "text": "试镜会场",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000015:dialogue:000": {
      "source_hash": "sha256:81e3d67e41885ef6735b9d53439f933bfd077e749d0273fecbc6a7efb86959ff",
      "text": "终于到试镜当天了呢……\n皮埃尔先生，状态如何？",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000020:dialogue:000": {
      "source_hash": "sha256:4a56aeb4365593cb0021fb31fa7127299f140c0ef9da223bc69b00143fe3338e",
      "text": "没问题！面试的练习，做了好多好多！\n恭二、实，都有帮我练习！",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000024:dialogue:000": {
      "source_hash": "sha256:a0c87ca8eb72f072b4ea9cbfe4dfc7ea8a170f6e48de57cb9f105ddf145bfd6c",
      "text": "“我叫皮埃尔！\n隶属于315 Production！”",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000029:dialogue:000": {
      "source_hash": "sha256:a66adf833ecc6e1032a4475f76cc109822e0c5c3e329343573c98b02300b6434",
      "text": "“试镜，我会加油的！\n请多关——照！”",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000034:dialogue:000": {
      "source_hash": "sha256:e7fe36acb77efe9098b629d69598b872c107e3c9987db8e6eae2792b5412459f",
      "text": "……怎么样，●●●●プロデューサー？",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000037:dialogue:000": {
      "source_hash": "sha256:4cbd3992a3a1ee5ad48f5812d6615e2b6928b14b4588429aba286d5d16c929ea",
      "text": "充满元气，非常有皮埃尔先生的风格，很棒哦！",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000040:dialogue:000": {
      "source_hash": "sha256:ee9825a28bc43f2e6189d0853185e8e59f5cdef1643a6c681d60d111d8e35ef1",
      "text": "别忘了保持笑容，好好加油去吧！",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000048:dialogue:000": {
      "source_hash": "sha256:b8f0d7c340095fc4741c168f3a7ece5d8fcf4c2e21e8c85fd3ff362553c8870d",
      "text": "嗯！笑容，很重要，我知道！\n笑容是闪闪发光的幸福魔法！",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000058:dialogue:000": {
      "source_hash": "sha256:b66d19be79d77002db4fd34023237454797adba7592dfb854c1dc1900717910b",
      "text": "……啊，叫到我名字了！\n我出发了，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_2_010pie_01_1_2_010_01:1_2_010_01_b:cmd-000060:dialogue:000": {
      "source_hash": "sha256:40080583766ea198270ffa605fccd42e15b6bbdeb7d1f11b3ac57e1b92a5b2e0",
      "text": "好的，路上小心！",
      "status": "draft"
    }
  }
}
