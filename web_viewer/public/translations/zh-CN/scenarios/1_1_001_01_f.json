{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_001_01_f",
  "source_raw_hash": "sha256:121e0477e9e7518bd81297dda22d87acd0eddcaa7b3983cb575f847b9e0e6467",
  "entries": {
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000022:dialogue:000": {
      "source_hash": "sha256:728488f50fc92fc1211c2a52fea2ae0c41246232fab501353dabf274be0e2ec3",
      "text": "黑酱是谁啊？",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000033:dialogue:000": {
      "source_hash": "sha256:c2994321c1624051beca71fab9970690e5d3a66d056cedcc98247e6a03ff7646",
      "text": "是指黑井社长哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000036:dialogue:000": {
      "source_hash": "sha256:3cbf71d2eaf61610d9837c5fa520c9570903bfe90a63f8571e6ac9bc92c5fb96",
      "text": "我是伊集院北斗。直到最近为止都在当模特，\n后来被黑井社长发掘来当偶像了。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000040:dialogue:000": {
      "source_hash": "sha256:28d15c9b34ed6730763327255ebc55cd964ad9aefac6222c58d17870c8a62757",
      "text": "请多关照咯☆",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000046:dialogue:000": {
      "source_hash": "sha256:2704edf4257bcd374b746b83a3a14e63a8ce015afe762d35feff5aaa1a0de096",
      "text": "啊、啊啊。你好。\n我是天濑冬马。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000052:dialogue:000": {
      "source_hash": "sha256:7c50ef278b0121419e603016eb883a4ba5e6bcbd572f69ff395f0b1791827739",
      "text": "昨天在歌手大赛拿到优胜的时候，\n被那个大叔……被黑井社长搭话了。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000065:dialogue:000": {
      "source_hash": "sha256:795613ca450dc0d6b1e4c5e93e2e0e3f60d8b40efa77ad5f8380d0a3852e2180",
      "text": "哎——！在比赛里拿了优胜吗？\n小哥好厉害啊！",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000075:dialogue:000": {
      "source_hash": "sha256:5ef8a73bb6c416c5f0264da90c6ec3defb94192473e5d36895495bcc7ab24fa6",
      "text": "不愧是大事务所961 Pro主办的比赛呢，\n听说竞争率相当高哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_f:cmd-000081:dialogue:000": {
      "source_hash": "sha256:55dc94fd7826724bb1434e55547ca6c79fae1e7d6af56ef110fb2dcc61afbdff",
      "text": "能在那里拿到优胜，\n说明是个相当有实力的人……吧。",
      "status": "draft"
    }
  }
}
