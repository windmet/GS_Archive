  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000010:title:001": {
      "source_hash": "sha256:1391e5fe66b5070dc20c4d373a71fd927a9df2e3160a50b622f9197c8c94685e",
      "text": "在电视节目中与其他偶像对谈的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000015:dialogue:000": {
      "source_hash": "sha256:429b39a346754cbe51c582cfac8267b19659a2e400552d5079b89793d73d5714",
      "text": "今天是作为电视节目的嘉宾，和其它事务所的\n偶像们进行对谈。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:0b4de7624cee3ed43de304f61763b702573992d48e41cba43537ba3157840145",
      "text": "跟我同龄的偶像对吧。\n同事务所的人倒是经常聊……",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000024:dialogue:000": {
      "source_hash": "sha256:5bbacebc4ef2b4ea0ac05e571ebd5768bd9a008800b15a7925f43104ff06b786",
      "text": "要不是有这种机会，平时基本上没机会\n和别家事务所的人痛痛快快聊天吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:9ea3df483ab5c5d1b197190bbcca7921e3d616b35854285f683083cd46b05481",
      "text": "呵呵，确实是呢。\n谈话主题似乎要通过抽签决定。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:f0af8720f08fc97ee23e554c0d3983fc10ca3e145f7c54fe92049a4d9ebe923a",
      "text": "谈话主题啊……\n说起来，听说里面还有隐藏主题？",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000033:dialogue:000": {
      "source_hash": "sha256:249cd9f3f648c1cf2e2e916a3320ea2b98b4fce3bd2eab7e322d458da6ba0417",
      "text": "是的，据说有几个\n没有写在台本上的主题。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000039:dialogue:000": {
      "source_hash": "sha256:0197786ed089c7afb3e356d46e9f45def3252cc0025893122b72c2acf907c3ec",
      "text": "嘛，有点这种环节也不坏。\n光是照本宣科念台本也没什么意思。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000042:dialogue:000": {
      "source_hash": "sha256:fff55409452a8f6c2942f009b4ebe7581838db280af8b2a1273dd51730bb8ffd",
      "text": "谁会抽到那个，我倒有点期待起来了。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000050:dialogue:000": {
      "source_hash": "sha256:9ea5bd715572883602a6f2980e24f037c926cde23f99bc3ec74ed03ff163095a",
      "text": "……嗯，工作人员好像在叫我了。\n那我去了。",
      "status": "draft"
    },
    "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000053:dialogue:000": {
      "source_hash": "sha256:33df04ef51d2b4f9b7422be4209f9232c40bc9361d89cae8940f8aa54bd9a65a",
      "text": "路上顺风，秀先生。\n录制请加油哦！",
      "status": "draft"
    }
  }
}
