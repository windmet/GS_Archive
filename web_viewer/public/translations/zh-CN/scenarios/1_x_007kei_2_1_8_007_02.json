{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_007kei_2_1_8_007_02",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_007kei_2_1_8_007_02:1_8_007_02:cmd-000010:phone_message:000": {
      "source_hash": "sha256:c9549c8aed8c461db208ddf0b6f7f103f3a6657875fe953c2b2bd41749a51d01",
      "text": "早上好，●●●●プロデューサー。\n现在方便稍微聊聊吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_2_1_8_007_02:1_8_007_02:cmd-000012:phone_message:000": {
      "source_hash": "sha256:71b01ba5afd0a7c8119b608221bb17097b932a73f4cd258cb41a9614fad91e59",
      "text": "祝你生日快乐。我想起正好是今天，\n就给你打了电话。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_2_1_8_007_02:1_8_007_02:cmd-000014:choice_short:000": {
      "source_hash": "sha256:85bee706705f6ffbc3047718a03fc0d9781093b1d02537e3601d2b66cbb72f30",
      "text": "能被您记在心上，\n我很高兴！",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_2_1_8_007_02:1_8_007_02:cmd-000017:phone_message:000": {
      "source_hash": "sha256:d917a585e78001de16e846ede13a85e8d1cae91754d6482122c896e262856704",
      "text": "今天的事务所里，肯定到处都充满了\n大家送给你的祝福声吧。",
      "status": "draft"
    },
    "story-text:v1:1_x_007kei_2_1_8_007_02:1_8_007_02:cmd-000019:phone_message:000": {
      "source_hash": "sha256:7cd81095f4ea2a34e3e19efa17274db13e2eab76faa07bc760efcfad0bc3954c",
      "text": "我如果也能成为那份温暖声音中的一员，\n就很开心了呢。那就回见啦。",
      "status": "draft"
    }
  }
}
