{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_3_30016_01_k",
  "source_raw_hash": "sha256:112cc1b404de830899f7e78e3facc3154e6ce9f1195db2f5d04c26e8781019ef",
  "entries": {
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000027:dialogue:000": {
      "source_hash": "sha256:25272b69ccaceb83122d4075a55b5f2a704e98371d17bd2eea7fa4db71f277df",
      "text": "要寄的照片就选这张，和这张吧。\n……呵，大家都是一副好面孔啊。",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000044:dialogue:000": {
      "source_hash": "sha256:a9ebdd282d2907c69df4c4ac46b5eb1f4856810c597b43899921a451b9629016",
      "text": "“好久不见。您那边可还好吗？”",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000046:dialogue:000": {
      "source_hash": "sha256:e1d158c53042d690eec2a746cac7ac55f2c9e38aa2bea9318d9314230b2c1d10",
      "text": "“我这边一切如常。\n学业和工作都挺顺利的。请不必挂心”",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000054:dialogue:000": {
      "source_hash": "sha256:8a09c70e67443a846e5f9c95a23e49953f20a0953933baa8c7492f103cf63101",
      "text": "“另外，这次也随信附上照片”",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000056:dialogue:000": {
      "source_hash": "sha256:19ee5a6d10b420ed2898aa7f0991d510594336bb2d59a2c0ab19137e8979956f",
      "text": "“是工作时拍的。\n就当是汇报近况，请收下吧”",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000063:dialogue:000": {
      "source_hash": "sha256:bb26b9cdafa7275ace449443de172979c5f6bd32ad341491fdfdd8a17b5de53b",
      "text": "“这是我现在从事偶像工作的事务所，还有\n受其照顾的番长”",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000074:dialogue:000": {
      "source_hash": "sha256:872fca43100a0a95da68d7f7d907e97eecd92bcf0203bcc7d269d6d448986ec4",
      "text": "“然后，这位是我多次跟您提起过的\n我的搭档红井朱雀”",
      "status": "draft"
    },
    "story-text:v1:1_3_30016_01:1_3_30016_01_k:cmd-000088:dialogue:000": {
      "source_hash": "sha256:989323a4038109d69fd9b5e5958874e09c308f8ac919081710dc8623cfb74577",
      "text": "“以后有什么事再联系您。回见”",
      "status": "draft"
    }
  }
}
