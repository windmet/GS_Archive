  "scenario_id": "1_5_014hid_1_5_014_04",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000011:title:001": {
      "source_hash": "sha256:8e411d95923b7c1f296452beaf23d4be5704192fc7797d2ef69655177b416179",
      "text": "在旅游节目中一边与人交流一边漫步街头的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000018:dialogue:000": {
      "source_hash": "sha256:8c4ca8dffe26f2cc1950a1407a8a3522effba8feeb5cb306fe02bd523467a69f",
      "text": "那个，●●●●プロデューサー。我刚才听录制时搭话的当地人说啊……",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000020:dialogue:000": {
      "source_hash": "sha256:15369767e2bd3c3c77b8d9bbc0f33b1c937388519aff45e08b20aa7c4ba152a1",
      "text": "有什么在意的事吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000023:dialogue:000": {
      "source_hash": "sha256:739da019c56adc364aaa3fa93297782e4f97ff8c34de9368539b552bca417486",
      "text": "这附近好像有座很适合越野跑的山呢！",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000025:dialogue:000": {
      "source_hash": "sha256:6bd092dbb469f4e33fe10afff987bdc59e87aeeafd5479861e1aa89190fd7610",
      "text": "休息时看您和当地人聊得那么起劲，\n原来就是在聊那件事啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000030:dialogue:000": {
      "source_hash": "sha256:c42144c263bcd561163a423f867c887d52bf6fe720c71289d9c17d41c651f5e7",
      "text": "因为四面环山，我就猜会不会有呢。\n今天的录制，应该不会拖到很晚吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000034:dialogue:000": {
      "source_hash": "sha256:be576dc008d60466dfdb073cdcdfa774e2f6f6bf2741ea10dca6932bba62b03d",
      "text": "是的。只要录制时间不超时，\n预计傍晚就能结束。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000040:dialogue:000": {
      "source_hash": "sha256:ca7eadc73438f9c1779c6e2641d9488b4f50e73bd216923017dfa3764a9a04ed",
      "text": "那个啊，要是时间充裕的话，\n能顺道过去看一眼吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000048:dialogue:000": {
      "source_hash": "sha256:c2558173004c8c49a7e231d381784dc27eaa853a5a7d6b78dfab326798d72b4d",
      "text": "当然，今天只是去确认一下是个什么样的地方！\n工作我也会好好完成的……能陪我一起去吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000051:dialogue:000": {
      "source_hash": "sha256:d417992c09260dfeeae55aa9d696ac657a0d3a32bb2a97a09b6dfa2718a4fc06",
      "text": "没问题哦。\n请务必让我陪同。",
      "status": "draft"
    },
    "story-text:v1:1_5_014hid_1_5_014_04:1_5_014_04:cmd-000056:dialogue:000": {
      "source_hash": "sha256:eb0ccea5a1193a5a129b3bced644bf3c550b7478ebe694e9e0426299a1454581",
      "text": "噢！谢谢你，●●●●プロデューサー！",
      "status": "draft"
    }
  }
}
