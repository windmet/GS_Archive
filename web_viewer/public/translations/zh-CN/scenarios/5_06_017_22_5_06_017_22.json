  "scenario_id": "5_06_017_22_5_06_017_22",
  "source_raw_hash": "sha256:0f4d013a2fcf42fb0e428288f979264ef7c1ffba178f20b031fa2c08f53a5899",
  "entries": {
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000000:title:000": {
      "source_hash": "sha256:4489ad74956c6948fb8edb603b826e4e15f7c5ac32f2b964a78da83c3045a434",
      "text": "拔节成长（First Growth）",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000000:synopsis:000": {
      "source_hash": "sha256:128b3bb9304447098f1b4bbc1bb56cf707060803dc9a098e2b19247715e7282b",
      "text": "为庆祝315 Production的纪念日，\n决定举办特别演唱会。\n为了打造充满PASSION的最棒舞台，\n偶像们齐心协力制作新曲、服装以及舞台演出。",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000115:dialogue:000": {
      "source_hash": "sha256:c443cdd10a3c532a713c7d07b5ef419809c0edaaa3ec28b57aa2a4fd39f4a186",
      "text": "看起来所有人都换好衣服了啊。嘿嘿，接下来\n就是要向大家展示一起做出的那个了！",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000126:dialogue:000": {
      "source_hash": "sha256:616ab4d78399fc02b590ec16741a387eb4d6095d78a103a68614157185f4adeb",
      "text": "好的！真期待粉丝们的反应。\n他们一定会开心的，对吧？",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000137:dialogue:000": {
      "source_hash": "sha256:c7c1775a50652a6130aa2c07dbe5eb627526fcfc2a7344ee288038b62f856fed",
      "text": "冷静点。马上就能知道结果了。\n…你们两个直到最后一刻，都不要松懈啊。",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000146:dialogue:000": {
      "source_hash": "sha256:849307e7b94ddc57124ba4ec30ffd50d2fe8533fdcc4f26aa979fcd61f612c79",
      "text": "啊啊，我知道啦！\n那么制作人，我们上场了！",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000155:dialogue:000": {
      "source_hash": "sha256:54d8e175900b8f4f0e924937da3069bebc67690688ec52edf992cef61112acf1",
      "text": "315 Pro的各位，准备好了吧！出阵！",
      "status": "draft"
    },
    "story-text:v1:5_06_017_22_5_06_017_22:5_06_017_22:cmd-000186:dialogue:000": {
      "source_hash": "sha256:0522f5feb089c6d0ce8700a3a14d006211d88ef37bf2eed6509b13d9b6b2b377",
      "text": "哦——！",
      "status": "draft"
    }
  }
}
