{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_024shk_2_1_2_024_22_t01",
  "source_raw_hash": "sha256:058e03efbb6163e3c8d6ccc111a5c07c4a61d1a8967b077ceb410cc3045a28cd",
  "entries": {
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000008:phone_message:000": {
      "source_hash": "sha256:8c79b9b802761f8ae873d5977fea126cf435d0759950d8cf402205a470bafa70",
      "text": "●●●●プロデューサー酱！\n超闪耀的蛋糕，多谢啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000010:phone_message:000": {
      "source_hash": "sha256:781726f57a889b561c9e41b90a8cc6f0cff0d84c2e06b2a7d4e9c9c1bd9d0c77",
      "text": "明明超级忙，还专门为了我\n去排长队买蛋糕了对吧？",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000012:phone_message:000": {
      "source_hash": "sha256:a7813b7a011f871ce4d63c1902a683c929c17c368a4ffa5eddce78e08f03830c",
      "text": "听说这件事的时候，我真的开心死啦！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000014:choice_short:000": {
      "source_hash": "sha256:7f8c601fe93952dcd972facbaf5191726747892627caed5176b88d8f2d8860c2",
      "text": "因为想为四季先生庆祝嘛",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000015:choice_short:000": {
      "source_hash": "sha256:6813bc10a2557a9e85f0728579e958c1f345982aa1584f08523add13495cb18b",
      "text": "您能喜欢\n真是太好了",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000018:phone_message:000": {
      "source_hash": "sha256:9f52483cd797fd1e6b4e847a4a5549c13ef09125acba923437cd68347f4e9d74",
      "text": "被你这么一说，\n我都要超级Mega开心了～！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000022:phone_message:000": {
      "source_hash": "sha256:9e59cce760e52da546f94bc9cb7b037e742e24560ad4470fd005f30b5868c6b5",
      "text": "蛋糕真的Mega美味哦。\n多谢款待啦！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000026:phone_message:000": {
      "source_hash": "sha256:690b03917f97829eab42868917d592fda52952d960f6607e5b6cfd37e48b1260",
      "text": "大家为我开的派对，\n也是华丽闪耀到最高境界啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000028:phone_message:000": {
      "source_hash": "sha256:8b439bb0bf7159e2cdb04ec31194ce3cc3f8dc9219175ef00006ddb6526d0712",
      "text": "晚点我也会把视频发给\n●●●●プロデューサー酱的！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000030:phone_message:000": {
      "source_hash": "sha256:fb687d3375127b8009fcc3f5c7586dd04d5720d6cf955d3a1a1666a2a51333ac",
      "text": "今天的我，\n绝对是全世界最Mega Mega幸福的人啦。",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000032:phone_message:000": {
      "source_hash": "sha256:334ff1cfbbd3e12ccfbf148e63b92c5484f39eb82aac56efcf0e14070785c094",
      "text": "等到了前辈们的生日，\n我也想让大家感受到幸福！",
      "status": "draft"
    },
    "story-text:v1:1_x_024shk_2_1_2_024_22_t01:1_2_024_22_t01:cmd-000034:phone_message:000": {
      "source_hash": "sha256:2abe01f161425076cae9198b3d89263dd859fd295d5c89fa681f98bb25ab0217",
      "text": "当然，我也打算让●●●●プロデューサー酱变得幸福，敬请期待哦～☆",
      "status": "draft"
    }
  }
}
