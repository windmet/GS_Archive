{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_016_03_g",
  "source_raw_hash": "sha256:45e1695765d3f05eb4bc8d5c282918f8670c96907c811ced6d1685d4a4d239f2",
  "entries": {
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000014:dialogue:000": {
      "source_hash": "sha256:794aae86dea006a860360ec0bb554c2fa247e289753580102a3d178692ed4d3c",
      "text": "……我说，锐心。\n爷爷临终前曾经说过吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000019:dialogue:000": {
      "source_hash": "sha256:21337d370366f33509e82493197ba28919ec245d17e339e1b971e38d399804f1",
      "text": "无论你成为一个犯下怎样错误的孩子，他都深爱着你。\n希望你不要为了别人，而是为了自己活下去。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000023:dialogue:000": {
      "source_hash": "sha256:e49600a0bb0e7d8c391d81bc17682f774852199dc1c760d51ca392d39686c165",
      "text": "我也求求你。\n差不多该原谅自己了吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000026:dialogue:000": {
      "source_hash": "sha256:395e1e0587dd4b9f9651c99d8688715f896c700b3636d0c7194d15a0e800904d",
      "text": "…………",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000029:dialogue:000": {
      "source_hash": "sha256:bf30e675a474e3059fecbbd542636b60a7c1af92103707bbe9d9362cc3ed5b25",
      "text": "……为什么在哭呢？",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000035:dialogue:000": {
      "source_hash": "sha256:a9e161495405afc79ec7cca586cc7351aa22a2bbae360ffb8495bcfd073aa251",
      "text": "……我不知道。已经什么都……",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000041:dialogue:000": {
      "source_hash": "sha256:793f321eea6d74ed0d29fd092a323d4a26ed8b8fda8bdc7c8df70c7f1db87f8d",
      "text": "我连自己的事……都弄不明白了……",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000044:dialogue:000": {
      "source_hash": "sha256:30e80e811f6b5b505f5a99deb8d24ba7dc1a292a5c75758bce61aac95c0e1317",
      "text": "锐心……\n无论长到多大，在面对自己的时候都很笨拙呢。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000047:dialogue:000": {
      "source_hash": "sha256:60e20872de502231326a6405a2eccfd237303fbde8ec2f426e0139376db52351",
      "text": "那些眼泪啊，是你的心\n在说“想要获得幸福”哦。",
      "status": "draft"
    },
    "story-text:v1:1_1_016cfi_03_1_1_016_03:1_1_016_03_g:cmd-000050:dialogue:000": {
      "source_hash": "sha256:7f447f42b0d0765f3101f6e6ee1b9bb366b9478141c09534d74c6bbc9f8c5ad9",
      "text": "……请好好珍惜那份眼泪吧。",
      "status": "draft"
    }
  }
}
