{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_x_027yuk_1_8_027_01",
  "source_raw_hash": "sha256:932cc9780790b1beca93977fb1add93b1bf97a72fc2b326e2280526e1387e97b",
  "entries": {
    "story-text:v1:1_x_027yuk_1_8_027_01:1_8_027_01:cmd-000014:phone_message:000": {
      "source_hash": "sha256:b3fd8c32cb2cf8499b68745cb850ccba9760f74bb89f8a973df082b346f54f3c",
      "text": "……啊，是●●●●プロデューサー吗？\n太好了，打通了。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_8_027_01:1_8_027_01:cmd-000016:choice_short:000": {
      "source_hash": "sha256:3ae563d401510c89e64ef36e736fa333ed63c370ef668eb12d0e60ea4630db61",
      "text": "发生什么事了吗？",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_8_027_01:1_8_027_01:cmd-000019:phone_message:000": {
      "source_hash": "sha256:c91ee8432a65ecd2368cf0a38979b5de3b7daf1f2f5390914f22a69d09c08616",
      "text": "我本想去事务所，\n抄近路却迷路了呢。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_8_027_01:1_8_027_01:cmd-000021:phone_message:000": {
      "source_hash": "sha256:78e4b00c94d473dbde4ed0ef14c8e9a5a826ec4a199fc73331e197ba45c7d54d",
      "text": "不知道什么时候才能到事务所，\n所以想先跟你说一声。生日快乐。",
      "status": "draft"
    },
    "story-text:v1:1_x_027yuk_1_8_027_01:1_8_027_01:cmd-000023:phone_message:000": {
      "source_hash": "sha256:295e2d4627c181936750503e10edfe59cf2a48641ba804436fa5f1396f542cbe",
      "text": "……啊，看来走到了认识的路上了呢。\n那就待会儿见。",
      "status": "draft"
    }
  }
}
