  "scenario_id": "1_5_012yus_1_5_012_02",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000010:title:001": {
      "source_hash": "sha256:bbe39f404c0fb9b06cf9fc6e7629769476d75220d140453c68664bad5ceabc4d",
      "text": "在电视整蛊节目中担任整蛊人的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000017:dialogue:000": {
      "source_hash": "sha256:fdcdd24ff9fcc5a0e56c150d07a6590f85abdfd8359d209f24aa5a9012bf29c3",
      "text": "哈～～～\n太紧张了心跳砰砰直跳啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000019:dialogue:000": {
      "source_hash": "sha256:b0252bd74d0faf99d24a35ebccbe54f55edf196386e50242d750d810cf5ce7c5",
      "text": "毕竟是第一次在整蛊节目里担任整蛊人嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000024:dialogue:000": {
      "source_hash": "sha256:495b5b29d412595ec62ce4d028f23ff6e07bbb682a07e5802dcba432e70bfdb5",
      "text": "那种不能穿帮的紧张感\n真不是盖的呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000029:dialogue:000": {
      "source_hash": "sha256:f9db8cee0bc5c2671bc9ffc1a2961a68a05f4db0adda03115b769a5ad04c3bab",
      "text": "是我潜入正在睡觉的享介房间里，\n用火箭筒一样的礼花筒叫醒他对吧？",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000032:dialogue:000": {
      "source_hash": "sha256:e98b83b3bbba7176c6b8a92c53104e576eda00867cc4586460ec9dd88d0a2fad",
      "text": "是的！这个整蛊的关键，在于如何不弄出一点声音\n潜入房间呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000037:dialogue:000": {
      "source_hash": "sha256:da98b95d2bfb8015a04bbb6c990fdd0e19dfc2466749e62f104dc79375a51bb4",
      "text": "光是想象一下就觉得很有意思啦。\n潜入的时候我搞不好会笑出来呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000041:dialogue:000": {
      "source_hash": "sha256:90ae101571516ea2b000bb3aef4d4bc2f6b1848b84a8bef8a883f190745d6d4d",
      "text": "而且偏偏在这种时候，搞不好会触发双胞胎的心灵感应奇迹\n导致穿帮呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000045:dialogue:000": {
      "source_hash": "sha256:41c6d029f50a3d9a58b333a8c8eb84f49105bc6f7f198a004c04092c4c241d3d",
      "text": "果然对象是享介先生的话，\n整蛊会很难下手吗？",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000050:dialogue:000": {
      "source_hash": "sha256:daf4b833a225d562367582f0d817aed98c18c15e1c9cec16c8c5bf5071882262",
      "text": "才没有！不如说过瘾极了！\n和紧张程度一样，兴奋感也拉满了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_012yus_1_5_012_02:1_5_012_02:cmd-000055:dialogue:000": {
      "source_hash": "sha256:76b95504ae89a53c78571bf5b4127ddcc032bba9beb1aef8ee0356c5bb7bb0e9",
      "text": "我一定会吓享介一大跳，把节目做得超级有趣的，\n●●●●●●●●●●监督也好好期待着吧！",
      "status": "draft"
    }
  }
}
