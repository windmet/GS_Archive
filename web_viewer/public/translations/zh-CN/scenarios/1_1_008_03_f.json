{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_1_008_03_f",
  "source_raw_hash": "sha256:8d16fd07c45f3250a779fa1c07845eb79a27c06491e4fb222e41e1312c0fcfb5",
  "entries": {
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000026:dialogue:000": {
      "source_hash": "sha256:5a3bfa4018612c9611ee0b015b05432f7bcd4fcf43b908bc8bd5edaac3404293",
      "text": "（手机……\n刚才在活动室用完，就直接落在那了吗）",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000036:dialogue:000": {
      "source_hash": "sha256:5af461406b58165f0027178eda497b6dc75e3b06c79085b71362cc277c2a41a3",
      "text": "我把东西落在活动室了，回去拿一下。\n夏来你先回去吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000041:dialogue:000": {
      "source_hash": "sha256:839336a65fa72bbc2acc95f15dc1940ca9eacda7256a1194051d860f475fd823",
      "text": "旬……我也，一起去……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000045:dialogue:000": {
      "source_hash": "sha256:e936a3c1dafd144ace5bb7fc304dbdf69680b8b0eabc71c1d8ed9621237a19b9",
      "text": "我一个人去就行了。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000052:dialogue:000": {
      "source_hash": "sha256:a45cb8b9d92f8850732e553b9b384bc355cbc86439f5057caf02fa57196e3d7c",
      "text": "可是……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000059:dialogue:000": {
      "source_hash": "sha256:9c42557e03c1ca1e1e952b67dd5178f34cbbde56c2e52d74b9f7e684e4908488",
      "text": "都说了没关系啦。难道说……\n你还在介意那么久以前的事吗？",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000064:dialogue:000": {
      "source_hash": "sha256:d209d8730e2357f0903504f8cceba449964f98442c5b2d167a149bd99c7e3d17",
      "text": "叫你快点忘掉啦。\n……那就，明天见。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000074:dialogue:000": {
      "source_hash": "sha256:bb86b2a20b9b4bee4d4ef4961130df686c9dc45bec18cc9cf90d6f6f918f188f",
      "text": "旬……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000092:dialogue:000": {
      "source_hash": "sha256:cf6f104f32b8de169549e9763e92331080c359e45759c4f677bea17ca1332b2a",
      "text": "真是的。夏来也太担心我了吧。",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000117:dialogue:000": {
      "source_hash": "sha256:c5a005f9198f6b87aefe08a13f36ace3afb2c39f2bddb61ff6aaa49077c80ad4",
      "text": "我也觉得，社团活动……很开心。\n比赛……虽然很紧张，但我想加油啊……",
      "status": "draft"
    },
    "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_f:cmd-000134:dialogue:000": {
      "source_hash": "sha256:1f6093b960d63c71469b7af2182a9b5c578deafd473d264b5be9c373448c6325",
      "text": "……就算努力了又怎样。\n根本不会有人……在乎我的事……",
      "status": "draft"
    }
  }
}
