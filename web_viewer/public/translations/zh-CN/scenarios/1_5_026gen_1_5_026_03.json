  "scenario_id": "1_5_026gen_1_5_026_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000010:title:001": {
      "source_hash": "sha256:d64fee80c57d704a560b92af539338cdc5f54f7cad101dbc2196c11bff1fb000",
      "text": "时尚杂志模特的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000021:dialogue:000": {
      "source_hash": "sha256:128f7f98a6cd6f4bc838fa160cd9711a9ad4bfbafec6dc1855731a9619a7f82a",
      "text": "下一个姿势，应该这样……不，是这样吗？\n还是说……",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000026:dialogue:000": {
      "source_hash": "sha256:298f6ecac159fb6ac68632775a26334019166f0f872a5ff874612a8ad6171ccd",
      "text": "辛苦了，玄武先生。\n我带了慰问品来，请用吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000030:dialogue:000": {
      "source_hash": "sha256:e30d2ba39aa788ef75dbd04c3873b9cbf9a46a0ac405042de7778ad1a466abe3",
      "text": "……啊，●●●●●●●●●●番长。\n多谢了。正好，休息一下吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000032:dialogue:000": {
      "source_hash": "sha256:87782ee78bdab138e6c222b2b3bd84a5f2abd6e4b2208f6f8d6bc8eeb387afe6",
      "text": "您刚才好像在烦恼什么……\n不嫌弃的话，我可以和您一起商量！",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000036:dialogue:000": {
      "source_hash": "sha256:14c43047b7c414a3ed40eaf96afca6e3342eea1d4d7f5e6e32422ac26862e8a7",
      "text": "可以吗？\n老实说，我正陷入瓶颈呢，帮大忙了。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000040:dialogue:000": {
      "source_hash": "sha256:7fa26751086575db5cc93f8dbcf9fd3c90b00d0ada5263e098a55729cfe84cd7",
      "text": "能被选为热门杂志的模特虽然很荣幸，\n但摆什么姿势得全靠自己来想。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000044:dialogue:000": {
      "source_hash": "sha256:883777ab7661c5bd446469319f0e3ea3df2fd3f0cb8046907b679e5fb395dce0",
      "text": "尽管考虑了很多，\n却拿不准究竟做得对不对。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000047:dialogue:000": {
      "source_hash": "sha256:3d6ea782317b1ad9e35223333e25c99dbd3c52c41c060760ed53f56a5d7b2c3b",
      "text": "既然这样，那就让我们两个人一起来研究姿势吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:a8e154fd0744a06a84765761d75971f2a88028d62fdbcbf942188020c1f12e97",
      "text": "那敢情好。\n有●●●●●●●●●●番长在，可抵百人之力！",
      "status": "draft"
    },
    "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000057:dialogue:000": {
      "source_hash": "sha256:9a37203b649f3d42b59fd17fcb5ae30b92a3759bcf4d8abdba9154b310047c30",
      "text": "勇往迈进，不必客气。\n有不妥当的地方，尽管指出来！",
      "status": "draft"
    }
  }
}
