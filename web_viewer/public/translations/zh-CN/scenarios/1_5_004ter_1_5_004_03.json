  "scenario_id": "1_5_004ter_1_5_004_03",
  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000011:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000011:title:001": {
      "source_hash": "sha256:9b8bf775c5462880b078e21c89beeabf39f2c480f42821a5979f97b2c982cc9a",
      "text": "问答节目的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000016:dialogue:000": {
      "source_hash": "sha256:839815832bb8794aa654d3399cccdd9df31fc125b5d87cf2de5d8bbd3b36dfc5",
      "text": "辛苦了，辉先生。\n休息过后就是后半场了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000019:dialogue:000": {
      "source_hash": "sha256:79018dd6d9f883a2d70b8feb9d5e3135890f54770bab42521ac10e4a2dd91102",
      "text": "综合成绩排在前列呢！\n真厉害！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000022:dialogue:000": {
      "source_hash": "sha256:802972659a22bc331e22401293e479f922fa428ff253e78280a6e05cb77d9567",
      "text": "因为我买了参考书，\n刷了很多题嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000025:dialogue:000": {
      "source_hash": "sha256:0b716313d3831cb764a16186292fa32b503f856db646bd0cc4fb089a6e629364",
      "text": "樱庭和翼也因为有空，\n陪着我一起做参考书上的题了。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000031:dialogue:000": {
      "source_hash": "sha256:9349f0c034aa399eb7dd59b89cc0bca0d8ba557826b4cbaf6b50e3f86a5bdc3f",
      "text": "不过，抢答真是苦战了一番啊。\n周围人按下的速度太快了。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000034:dialogue:000": {
      "source_hash": "sha256:ca6db0f18a93a0122704685bd3397a34743b76b2d0db9a99aa84e434f40a4128",
      "text": "确实很多人在读题途中\n就按下抢答键了呢。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000037:dialogue:000": {
      "source_hash": "sha256:8f666ef71b7e6a5d0cab56fc727715c1d66294f72c2acaa0096e663c941d2346",
      "text": "就是说啊。我本来觉得自己练习过了，\n看来还得多下工夫才行啊。",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000041:dialogue:000": {
      "source_hash": "sha256:60ee82183d32a8a3f9215f4091c08408394fd4b309096a52129230aa0994779a",
      "text": "诀窍差不多已经抓住了，\n后半场的抢答我绝对不会输！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000048:dialogue:000": {
      "source_hash": "sha256:42be367e22e6ca671f71ef4cec2dcbbf308cc7cf4aeef4f9eeb672b28c496dc3",
      "text": "再多追赶上去，目标果然还是冠军对吧。\n看着我吧，●●●●プロデューサー！",
      "status": "draft"
    },
    "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000051:dialogue:000": {
      "source_hash": "sha256:686debdfa83b4dbb7bc6c20c4e316e7e8ea4380dc81a40f91444b84188f7272c",
      "text": "好的！我会为您加油的，辉先生！",
      "status": "draft"
    }
  }
}
