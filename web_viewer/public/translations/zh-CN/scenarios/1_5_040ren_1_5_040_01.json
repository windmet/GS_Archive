  "source_raw_hash": "sha256:65592b1ef6033340c69326e77ecd9f3222edaf5c771a2a43ed3057f566491ef1",
  "entries": {
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000000:title:000": {
      "source_hash": "sha256:c391997b55a2964fa0fc166f4cc2e2a84ff43baeb6237ada6e314982654dd101",
      "text": "工作中",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000000:synopsis:000": {
      "source_hash": "sha256:b5d3e8fa043af75a87dd4faef01ce8885090903c7489ecb33e70005fc16c71c5",
      "text": "【剧情梗概】",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000010:title:000": {
      "source_hash": "sha256:33d8451285d4e5f69626e1f5771ddc007ba751ec655f29067561078d2496c78f",
      "text": "工作",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000010:title:001": {
      "source_hash": "sha256:dc609c32b6e194dc54ddf302c316fae1393b7fd19bb9ed8d66f2cbd2c31cf0a1",
      "text": "在电视节目中介绍大份料理的工作",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000012:dialogue:000": {
      "source_hash": "sha256:194e444d2355791dc04628a746551497ab823c995eb4f02ee7f849d1aa58baad",
      "text": "马上就要录制了，涟先生不知什么时候\n不见了人影！得赶紧去找找……！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000026:dialogue:000": {
      "source_hash": "sha256:dfb216d1877e7370826de1455cab58b134052c9bbd3aa637c227131819757af8",
      "text": "啊？喂，猫咪。\n敢挡在本大爷面前，胆子挺肥的嘛。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000031:dialogue:000": {
      "source_hash": "sha256:0a84c2c2f5c7412db30c891a8615f9566b806cbd145132afafd141838ddbc0fc",
      "text": "拿这个打发你就足够了吧。\n喂，跳一个给本大爷看看！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000040:dialogue:000": {
      "source_hash": "sha256:165e34fa8ffa27e81b0509080aad26715574eee8799cbf73b1c018e23d60e145",
      "text": "哼，跳得挺不错的嘛。\n那接下来这个怎么样！",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000050:dialogue:000": {
      "source_hash": "sha256:e14d2ecd7431adacc8ca091d3762b5c8e5a6a8c7d9841c7b6c969011ee16f185",
      "text": "涟先～生！终于找到你了！\n录制前要是找不到你可就难办了。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000055:dialogue:000": {
      "source_hash": "sha256:b5605030f6d41c96f328a656fc41f392a9988797a0f7e850ff34a3f915ba4f31",
      "text": "本大爷才不管什么录制，\n你难不难办关本大爷屁事。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000057:dialogue:000": {
      "source_hash": "sha256:d5a9dd6395ad5f797b9090a3e0083bf4cc7c517c8c22cf3f766ac04e901332f4",
      "text": "怎么不关你的事！\n马上就要开始录制了，快回去吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000062:dialogue:000": {
      "source_hash": "sha256:461c089c8b43b07a929009ed5045005aff77050f7cdb0a845d3ee9a5ed91d718",
      "text": "啊？\n说起来，你提过录制的时候有饭吃吧。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000066:dialogue:000": {
      "source_hash": "sha256:df158b985c11fd9c01ce775daa22c2ac301bf0b22f6b440c186f7747e885c591",
      "text": "是的，介绍完店里的大份菜单之后，\n要请您亲自品尝。",
      "status": "draft"
    },
    "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000071:dialogue:000": {
      "source_hash": "sha256:3ca5f417ca6362b106b3dd794f8f3beac55915f25ccb92dfcf79d3e9f47f4dea",
      "text": "哼，还不赖嘛。店里的饭菜，\n本大爷全都会吃光的，给我做好觉悟吧！库哈哈！",
      "status": "draft"
    }
  }
}
