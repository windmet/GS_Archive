{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "5_01_018_23",
  "source_raw_hash": "sha256:6b8360e6bbee0bcc83b099cfca1f94e7bfb5a4e771418a4260608ec744135ff1",
  "entries": {
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000016:dialogue:000": {
      "source_hash": "sha256:10fc9473bde73eef9d5c5d21044ce71670da325b99197b643029b8f712be7bae",
      "text": "久等啦，制作人酱。\n能稍微把手掌伸出来给我看一下吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000019:dialogue:000": {
      "source_hash": "sha256:f9b6acbed3b203be60ea33f89bbb513789b5135e3fa5043b2acdf0444776e04b",
      "text": "……？是这样吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000023:dialogue:000": {
      "source_hash": "sha256:3f3fa07538c3313148135ce86bc6911df581bd3b2f24a13d40948bcd9005993e",
      "text": "这是我送你的情人节礼物哦。\n来，请拿好。",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000027:dialogue:000": {
      "source_hash": "sha256:fbbb9d76cb8cc8ad3c359bc45a930b6735d7a9e95ff19b1286866f743cdfcd97",
      "text": "这是……电视上引发热议的机场限定商品！\n真的可以给我吗？",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000033:dialogue:000": {
      "source_hash": "sha256:b1f685e17bd723eede7e6fa358b0cf2f6cb20a1b6c21cea09e807f2b3d8617d2",
      "text": "当然啦。我就是为了送你才买的呀。\n不用客气尽管收下吧。",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000037:dialogue:000": {
      "source_hash": "sha256:c40d33895f63e240a33caf79f2610544d5a81bc3c4b787f707839e1eaf67b900",
      "text": "能顺利交到你手上真是太好了。",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000042:dialogue:000": {
      "source_hash": "sha256:948d0e2d88863b017991e247698ae0ee4d3653061de7e24b212294576121e0b4",
      "text": "从听到正好能因为工作来机场的时候起，\n我就决定要送你这个了呢。",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000047:dialogue:000": {
      "source_hash": "sha256:b6f4e0aa7c2a4f175aa6a2aa4495d7ba78f833b8c6d9c88162aa6b054047e542",
      "text": "非常感谢，我会好好珍惜的！",
      "status": "draft"
    },
    "story-text:v1:5_01_018_23:5_01_018_23_a:cmd-000053:dialogue:000": {
      "source_hash": "sha256:8495ef5ac86c782b26d1a81f9307ad54740ec040ce06b00f6b079b9aee921873",
      "text": "嗯。如果能被你好好珍惜的话，\n不光是我，那件东西也会很高兴的哦。",
      "status": "draft"
    }
  }
}
