{
  "schema_version": 1,
  "locale": "zh-CN",
  "scenario_id": "1_2_005_01_c",
  "source_raw_hash": "sha256:f317a4313c8391be3ec272b19453fb539e31117b2ebbfd6b86b02c7ab13dfd03",
  "entries": {
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000011:dialogue:000": {
      "source_hash": "sha256:aa22146ec4f18a54f1a5cbce594b9284b167a204fde45c346c7b3b5345412819",
      "text": "（嗯……？薰先生的声音……\n是在和谁通电话吗）",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000021:dialogue:000": {
      "source_hash": "sha256:f6f19b1d8b35dbc7b13e9f27e1d21f1adbc3e125089e68c6d2afc6c4338b98f1",
      "text": "……嗯。没问题。\n变更事项由我来转达吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000029:dialogue:000": {
      "source_hash": "sha256:15185bf2bef618f91f4d86442598df58ae3ee28b883bc1a8241a7624376ebab9",
      "text": "……好，我知道了。\n晚点再联系。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000050:dialogue:000": {
      "source_hash": "sha256:b23fd3c84e5462abe6fb459206eee98b0532830077da40c788a015d8477d304d",
      "text": "……嗯？醒了吗。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000053:dialogue:000": {
      "source_hash": "sha256:e64e125808a96dde2a19fb68ef0dd77d824da3f5aeff111f2ea379579381713a",
      "text": "早上好。\n那个，刚才的电话是？",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000059:dialogue:000": {
      "source_hash": "sha256:4b09281819ec84074727b1395e561adf4c1ee48cfdba61368f414d8bb9db6f8c",
      "text": "是山村君。我替你接下了带给你的口信。\n我记了备忘，稍后过目一下吧。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000062:dialogue:000": {
      "source_hash": "sha256:0f4ec8a590a2ee1299a64b809e7557a9b37ad91d5be9a546f1501ee1a6dbc59b",
      "text": "这么照顾我……真的太感谢了。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000066:dialogue:000": {
      "source_hash": "sha256:5256d61bdd99f526cb3fb87abb0cdfd59af4e60c70494c067b6b427883127c56",
      "text": "无所谓。比起这个，身体感觉怎么样。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000068:dialogue:000": {
      "source_hash": "sha256:561be8083e0906a1b3629717ae7a4c1c935eef9a90cdbfae1178318cb8e3be3d",
      "text": "很好！稍微小憩了30分钟左右，\n感觉神清气爽多了。",
      "status": "draft"
    },
    "story-text:v1:1_2_005kao_01_1_2_005_01:1_2_005_01_c:cmd-000075:dialogue:000": {
      "source_hash": "sha256:ceb104f7573ab6c8a472a1d8b50c1140ea813544bcf18c16334dd5b9d8724483",
      "text": "看来确实如此。气色变好了。\n虽然谈不上充足，但能好好休息一下比什么都强。",
      "status": "draft"
    }
  }
}
