      "text": "尚未见过的景色",
      "source_hash": "sha256:b8d9899cd62cd7cf6ebd52e1ad0d50755b43fe4947c1bf96e87b4eca93d7d07b",
      "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_a:cmd-000000:title:000"
    },
    {
      "source": "理想と現実の狭間で",
      "text": "在理想与现实的夹缝中",
      "source_hash": "sha256:9920d3743be9664afe19a18a9c32ee1dac34a5fd5381c6b18f5dc40c83770da3",
      "unit_id": "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_a:cmd-000000:title:000"
    },
    {
      "source": "終わりの音、始まりの音",
      "text": "终结之音，启始之音",
      "source_hash": "sha256:dd2d19f8f9419ebde5d91506467b3bd945f6f34cbedb1f08ef60e760a08039cf",
      "unit_id": "story-text:v1:1_1_003alt_01_1_1_003_01:1_1_003_01_a:cmd-000000:title:000"
    },
    {
      "source": "動き始める旋律",
      "text": "开始律动的旋律",
      "source_hash": "sha256:ce8003f308cccab75f21a86101fa3c75e69705c02095f450bdc4b0c4dffbbd38",
      "unit_id": "story-text:v1:1_1_003alt_02_1_1_003_02:1_1_003_02_a:cmd-000000:title:000"
    },
    {
      "source": "命の音色を求めて",
      "text": "追寻生命的音色",
      "source_hash": "sha256:4fccffb8779505cf38ba733d956e61bfe1e282272ffb678f921a1a9c9994de2e",
      "unit_id": "story-text:v1:1_1_003alt_03_1_1_003_03:1_1_003_03_a:cmd-000000:title:000"
    },
    {
      "source": "二つの鼓動が重なって",
      "text": "两颗心跳重叠交融",
      "source_hash": "sha256:f4c2e25358706f2031f2aefbd76e15963af01e3407f08e86b9af3c457eebfcd4",
      "unit_id": "story-text:v1:1_1_003alt_04_1_1_003_04:1_1_003_04_a:cmd-000000:title:000"
    },
    {
      "source": "カエルの王子の見る夢は…",
      "text": "青蛙王子的梦…",
      "source_hash": "sha256:5e8fdd114b8429d1efcca33694e26c64e6e45672b9dda76c409dab2b5c76dec8",
      "unit_id": "story-text:v1:1_1_004bei_01_1_1_004_01:1_1_004_01_a:cmd-000000:title:000"
    },
    {
      "source": "3人で、目指せ世界平和！",
      "text": "3个人一起，目标是世界和平！",
      "source_hash": "sha256:0250252de60e2f846b933ec76c3134b43e093e2510349df59f99616f9a67cae6",
      "unit_id": "story-text:v1:1_1_004bei_02_1_1_004_02:1_1_004_02_a:cmd-000000:title:000"
    },
    {
      "source": "渡辺みのりの前日譚",
      "text": "渡边实的前传",
      "source_hash": "sha256:4eff6c8eea03b06b21331ecbd46c29e4b820488c3d466bd39977154698f78425",
      "unit_id": "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_a:cmd-000000:title:000"
    },
    {
      "source": "蒼の戸惑い",
      "text": "苍之迷惘",
      "source_hash": "sha256:41e37849c779847161833e50a4d0c49e8d8ba14f9cd8b89155948f5c11d4a575",
      "unit_id": "story-text:v1:1_1_005w00_01_1_1_005_01:1_1_005_01_a:cmd-000000:title:000"
    },
    {
      "source": "示された道",
      "text": "昭示的前路",
      "source_hash": "sha256:3003942f4d279ffcac6e9157ec4b44d516fe06a1a8b9817096c20f28590f3a27",
      "unit_id": "story-text:v1:1_1_005w00_02_1_1_005_02:1_1_005_02_a:cmd-000000:title:000"
    },
    {
      "source": "すれ違う思い",
      "text": "错位的思绪",
      "source_hash": "sha256:406ecc34db1f17de3b5112d67246f0ecac5c3a2955b7e347d46bd5b4cac126da",
      "unit_id": "story-text:v1:1_1_005w00_03_1_1_005_03:1_1_005_03_a:cmd-000000:title:000"
    },
    {
      "source": "スタート地点に立つ",
      "text": "站在起点",
      "source_hash": "sha256:c28b3b25a16ac317df601943f9ee10292c12a7e57b8041e674d76ece986c58d8",
      "unit_id": "story-text:v1:1_1_006fra_01_1_1_006_01:1_1_006_01_a:cmd-000000:title:000"
    },
    {
      "source": "偶然の再会",
      "text": "偶然的再会",
      "source_hash": "sha256:89631e76c9d2d5b44b984e2a1a44fa3f38a97b32f2e3fedba68f1e51b5db2ba5",
      "unit_id": "story-text:v1:1_1_006fra_02_1_1_006_02:1_1_006_02_a:cmd-000000:title:000"
    },
    {
      "source": "いざ、アイドルのオーディションへ",
      "text": "奔向偶像试镜",
      "source_hash": "sha256:4d5725641799cd957410e87da1b2175689a65a003f1ef9085f7c8389fb34bc19",
      "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000000:title:000"
    },
    {
      "source": "決意の夜",
      "text": "决意之夜",
      "source_hash": "sha256:b13cfb4e25c42cd664c86854e3c00b8899970389342c9081118e4b118a84298b",
      "unit_id": "story-text:v1:1_1_006fra_04_1_1_006_04:1_1_006_04_a:cmd-000000:title:000"
    },
    {
      "source": "それぞれの始まり",
      "text": "各自的开端",
      "source_hash": "sha256:dae069f5408db1881b617a8719e91608c60e74070cf37e26b0724a2d7d122d66",
      "unit_id": "story-text:v1:1_1_007sai_01_1_1_007_01:1_1_007_01_a:cmd-000000:title:000"
    },
    {
      "source": "ずっと探していたもの",
      "text": "一直在寻找的东西",
      "source_hash": "sha256:83bd651f3de0647f2cabf6ee3c6b58d46f5e0839795cf55d37e3693bd690ffb7",
      "unit_id": "story-text:v1:1_1_007sai_02_1_1_007_02:1_1_007_02_a:cmd-000000:title:000"
    },
    {
      "source": "目指す先にあるもの",
      "text": "目标所在的前方",
      "source_hash": "sha256:b73c518a7a6f663bc41898fdca0e9be253f34f8ea86ee4af0737414a73734fc7",
      "unit_id": "story-text:v1:1_1_007sai_03_1_1_007_03:1_1_007_03_a:cmd-000000:title:000"
    },
    {
      "source": "青春しようぜ！",
      "text": "来挥洒青春吧！",
      "source_hash": "sha256:2da3b8c99758470d862bf99dc85b6433b0dec3cfc6af58782997576d9a5dbd42",
      "unit_id": "story-text:v1:1_1_008hig_01_1_1_008_01:1_1_008_01_a:cmd-000000:title:000"
    },
    {
      "source": "動き出した軽音部",
      "text": "开始运转的轻音部",
      "source_hash": "sha256:6074c82b2713d2ee331aebca2eedd4e70d8a9e1255f49598a2175b62c69ae884",
      "unit_id": "story-text:v1:1_1_008hig_02_1_1_008_02:1_1_008_02_a:cmd-000000:title:000"
    },
    {
      "source": "一生懸命の理由",
      "text": "拼尽全力的理由",
      "source_hash": "sha256:8902b61c95b06607883b6cef1cac707314853320fd7b665a6a37828d22fd676c",
      "unit_id": "story-text:v1:1_1_008hig_03_1_1_008_03:1_1_008_03_a:cmd-000000:title:000"
    },
    {
      "source": "困ってるヤツはみすごせねぇ！",
      "text": "绝不能对有困难的家伙坐视不管！",
      "source_hash": "sha256:f67df9cd002cfd6f5a6e7079967a627b9ea1f92c021daf3b9674683755e0b1e7",
      "unit_id": "story-text:v1:1_1_009shi_01_1_1_009_01:1_1_009_01_a:cmd-000000:title:000"
    },
    {
      "source": "オレらがアイドル！？",
      "text": "我们是偶像！？",
      "source_hash": "sha256:4da4aea3735c213df11b476365135b12a9651038d8060d48d716a04d110d8557",
      "unit_id": "story-text:v1:1_1_009shi_02_1_1_009_02:1_1_009_02_a:cmd-000000:title:000"
    },
    {
      "source": "熱き出会い！",
      "text": "炽热的相遇！",
      "source_hash": "sha256:9be00984f585bbcd0cf2e01bb6eae3fc815ebec7800ee48dcc69f48fa6618ebb",
      "unit_id": "story-text:v1:1_1_009shi_03_1_1_009_03:1_1_009_03_a:cmd-000000:title:000"
    },
    {
      "source": "行くぜぇ、オーディション！",
      "text": "上啊，试镜！",
      "source_hash": "sha256:6130f9ebf1b02313a1bc41b324c3089f75784a6c7cf00c0fa0f9495471d6502a",
      "unit_id": "story-text:v1:1_1_009shi_04_1_1_009_04:1_1_009_04_a:cmd-000000:title:000"
    },
    {
      "source": "やまない雨はない",
      "text": "没有不停的雨",
      "source_hash": "sha256:2e16b41756a9285f9c642eba568b5f9704fcfa6445c1ed1934b0838a8d279d5f",
      "unit_id": "story-text:v1:1_1_010caf_01_1_1_010_01:1_1_010_01_a:cmd-000000:title:000"
    },
    {
      "source": "幸せのすがた",
      "text": "幸福的姿态",
      "source_hash": "sha256:8e9aeff1f6f4049de6dfa9b0849bb27f39599ed227e67483d66e55764244bb54",
      "unit_id": "story-text:v1:1_1_010caf_02_1_1_010_02:1_1_010_02_a:cmd-000000:title:000"
    },
    {
      "source": "あたたかな出会い",
      "text": "温暖的相遇",
      "source_hash": "sha256:e6077d460a50702fd87b27a7e70ed9ef7587ed5d54191e444775350cdd4bffcb",
      "unit_id": "story-text:v1:1_1_010caf_03_1_1_010_03:1_1_010_03_a:cmd-000000:title:000"
    },
    {
      "source": "きらめく小さな原石たち",
      "text": "闪耀的小小原石们",
      "source_hash": "sha256:d41fdc60812fabafb8190b0754a2b579505c64e2a96144a02375f77fb814c0ba",
      "unit_id": "story-text:v1:1_1_011mof_01_1_1_011_01:1_1_011_01_a:cmd-000000:title:000"
    },
    {
      "source": "羽ばたく小さなチャレンジャーたち",
      "text": "展翅高飞的小小挑战者们",
      "source_hash": "sha256:56c6fd4f0c3071c5fbbfaa7d8efccd372539c9cff5ab747985a2a92130839c36",
      "unit_id": "story-text:v1:1_1_011mof_02_1_1_011_02:1_1_011_02_a:cmd-000000:title:000"
    },
    {
      "source": "輝く小さな光たち",
      "text": "闪耀的小小光芒们",
      "source_hash": "sha256:775bfb39ff5a0441f26c8519f80ab532fd3849c7f227b2ef2810d94c13ae42e0",
      "unit_id": "story-text:v1:1_1_011mof_03_1_1_011_03:1_1_011_03_a:cmd-000000:title:000"
    },
    {
      "source": "次のステージ",
      "text": "下一个舞台",
      "source_hash": "sha256:5958e802d61a4400a0c52fde005ddfc30f23411f932a170fb0265ebfde2a112e",
      "unit_id": "story-text:v1:1_1_012sem_01_1_1_012_01:1_1_012_01_a:cmd-000000:title:000"
    },
    {
      "source": "合縁奇縁",
      "text": "合缘奇缘",
      "source_hash": "sha256:c82fd3bcc6efa46fed31eb0c616c57a231acf0bb96e1805fb87b3fc51a491db5",
      "unit_id": "story-text:v1:1_1_012sem_02_1_1_012_02:1_1_012_02_a:cmd-000000:title:000"
    },
    {
      "source": "再会したDREAM",
      "text": "重逢的DREAM",
      "source_hash": "sha256:a88dc8cd9db1efb003cbe293116b612a79f36887b536d465e6d24307232c932b",
      "unit_id": "story-text:v1:1_1_012sem_03_1_1_012_03:1_1_012_03_a:cmd-000000:title:000"
    },
    {
      "source": "転がり出てきた315の目",
      "text": "掷出的315点",
      "source_hash": "sha256:720d326a0cceaae8227d355f40764fc98a45069a6ccfceae89241fed58be343c",
      "unit_id": "story-text:v1:1_1_012sem_04_1_1_012_04:1_1_012_04_a:cmd-000000:title:000"
    },
    {
      "source": "漢たちの闘う理由",
      "text": "汉子们的战斗理由",
      "source_hash": "sha256:737811db70a015a367074274ca52c88a644739f5f9a9c13c914c0fb7b820387b",
      "unit_id": "story-text:v1:1_1_013the_01_1_1_013_01:1_1_013_01_a:cmd-000000:title:000"
    },
    {
      "source": "新しい闘いのステージへ",
      "text": "迈向全新战斗的舞台",
      "source_hash": "sha256:2da76e833bf3616fab23ed4b0730ca1de6c3c0875d2b8966269a88c922936584",
      "unit_id": "story-text:v1:1_1_013the_02_1_1_013_02:1_1_013_02_a:cmd-000000:title:000"
    },
    {
      "source": "忘却の過去",
      "text": "遗忘的过去",
      "source_hash": "sha256:8035a4be3fe365598a101e59b382b8f272c8e7a9260d3dc974c01026aea0daab",
      "unit_id": "story-text:v1:1_1_013the_03_1_1_013_03:1_1_013_03_a:cmd-000000:title:000"
    },
    {
      "source": "それぞれの分岐点",
      "text": "各自的分歧点",
      "source_hash": "sha256:dc9c5be11dd10f3ea9ccd341540acf50cead6d0b7d92978ddd7b2f4697fc2d49",
      "unit_id": "story-text:v1:1_1_014fla_01_1_1_014_01:1_1_014_01_a:cmd-000000:title:000"
    },
    {
      "source": "もう一度動き出す物語",
      "text": "重新转动的故事",
      "source_hash": "sha256:e4c01317e8d7a521f09daf7da735feafb8d1e5e50fcc182d6c94d62618e79c46",
      "unit_id": "story-text:v1:1_1_014fla_02_1_1_014_02:1_1_014_02_a:cmd-000000:title:000"
    },
    {
      "source": "偶然も重なれば必然",
      "text": "巧合交织即必然",
      "source_hash": "sha256:553d5d600ea3ba720adbedc3191e2108e9c3667a6bf6831a4f82bc37b09dbc9f",
      "unit_id": "story-text:v1:1_1_014fla_03_1_1_014_03:1_1_014_03_a:cmd-000000:title:000"
    },
    {
      "source": "ありのままの自分を",
      "text": "展现真实的自我",
      "source_hash": "sha256:7aafa21288994e48db480926589b0e59d2aac0f5297c1c3d4eb03341bf5fdd26",
      "unit_id": "story-text:v1:1_1_015leg_01_1_1_015_01:1_1_015_01_a:cmd-000000:title:000"
    },
    {
      "source": "いざ、アイドルという大海へ",
      "text": "启航，驶向名为偶像的汪洋",
      "source_hash": "sha256:8bf2460743361b38e603347657ffc9cc0cad555d02a6aa33b2f7f152f3766629",
      "unit_id": "story-text:v1:1_1_015leg_02_1_1_015_02:1_1_015_02_a:cmd-000000:title:000"
    },
    {
      "source": "掃除屋の誇りにかけて",
      "text": "赌上清扫屋的尊严",
      "source_hash": "sha256:53cbcd1415aa4d8decde431d33c82d3af5614fe226298af2f2bd833a3586fea5",
      "unit_id": "story-text:v1:1_1_015leg_03_1_1_015_03:1_1_015_03_a:cmd-000000:title:000"
    },
    {
      "source": "進みだした三本の針",
      "text": "开始转动的三根指针",
      "source_hash": "sha256:94f081bc2dd1e97a577092aa50cce669be0ff8460791aa84ea76d54eb022ed1e",
      "unit_id": "story-text:v1:1_1_015leg_04_1_1_015_04:1_1_015_04_a:cmd-000000:title:000"
    },
    {
      "source": "世界を変えるために",
      "text": "为了改变世界",
      "source_hash": "sha256:003c676e2a2d7c57799cccfd90a5d8bb3a30a0b37936330e8b607a01c91e1520",
      "unit_id": "story-text:v1:1_1_016cfi_01_1_1_016_01:1_1_016_01_a:cmd-000000:title:000"
    },
    {
      "source": "新たな夢の開演",
      "text": "新梦想开演",
      "source_hash": "sha256:e26d45b17879569fe05d3c4706ccceec909eda28b67b5c7facc3579051762916",
      "unit_id": "story-text:v1:1_4_001_00:1_4_001_00_a:cmd-000000:title:000"
    },
    {
      "source": "新たなる三つの輝きと共に！",
      "text": "与崭新的三道光芒一同！",
      "source_hash": "sha256:4f36418148a51328db0391690c15d518106a0ad0bc5812a3b317355e6e935f2a",
      "unit_id": "story-text:v1:1_4_001_01:1_4_001_01_a:cmd-000000:title:000"
    },
    {
      "source": "初めての仕事",
      "text": "第一次工作",
      "source_hash": "sha256:853ab75db1aa9ca0bab7149e58931d08d9b5147e1891df42476286653a77ab77",
      "unit_id": "story-text:v1:1_4_001_02:1_4_001_02_a:cmd-000000:title:000"
    },
    {
      "source": "好きに真っすぐ！",
      "text": "笔直奔向所爱！",
      "source_hash": "sha256:f7ae441463d049a37403364f1446cfd5dac7cda5599fd4a20f65167f0c379540",
      "unit_id": "story-text:v1:1_4_001_03:1_4_001_03_a:cmd-000000:title:000"
    },
    {
      "source": "自分らしく、自分たちらしく",
      "text": "像自己，像我们自己",
      "source_hash": "sha256:6ce89806573cb24de3f996803fe878444be7e26477427c571a2e074482365b77",
      "unit_id": "story-text:v1:1_4_001_04:1_4_001_04_a:cmd-000000:title:000"
    },
    {
      "source": "トリニティ・アタック！！！",
      "text": "三位一体冲锋！！！",
      "source_hash": "sha256:9c67e11954dfa74ae7e384b569daf374c71a3547aa7361a22f14f81bfd92f788",
      "unit_id": "story-text:v1:1_4_001_05:1_4_001_05_a:cmd-000000:title:000"
    },
    {
      "source": "3人一緒にえいえい、おー！",
      "text": "三人一起，嘿——嘿——哦！",
      "source_hash": "sha256:272650ba424179d7145b3dadee2a454d33286000660ba93c38dc8199803e8b35",
      "unit_id": "story-text:v1:1_4_001_07:1_4_001_07_a:cmd-000000:title:000"
    },
    {
      "source": "出来ることは、諦めないこと",
      "text": "能做的事，就是绝不轻言放弃",
      "source_hash": "sha256:280f16b759b617c893a8f51317ee795f77fe176f343e908549922fb721d82982",
      "unit_id": "story-text:v1:1_4_001_08:1_4_001_08_a:cmd-000000:title:000"
    },
    {
      "source": "熱く冷静に燃え上がる男たち",
      "text": "炽热而冷静燃烧的男儿们",
      "source_hash": "sha256:d519c569d2b5bb0ab48ab57449795439d7bb61fe58c284439890d170cfb4d52a",
      "unit_id": "story-text:v1:1_4_001_09:1_4_001_09_a:cmd-000000:title:000"
    },
    {
      "source": "過去と未来を照らす星",
      "text": "照亮过去与未来的繁星",
      "source_hash": "sha256:5b3c50f43da19ed6afccf1fa2c7e28698998671da671a34a5751845978fc7f75",
      "unit_id": "story-text:v1:1_4_001_10:1_4_001_10_a:cmd-000000:title:000"
    },
    {
      "source": "黒い影",
      "text": "黑影",
      "source_hash": "sha256:e2f8c280c6831976f523502274a16ecba33a98216bbeaede18ee8a1da3e4c76a",
      "unit_id": "story-text:v1:1_4_002_00:1_4_002_00_a:cmd-000000:title:000"
    },
    {
      "source": "始動、『男極ッ！アイドルリーグ』",
      "text": "始动，“男极！偶像联赛”",
      "source_hash": "sha256:d42ebc0681aba0211eefef91186f36befcf0dc75c9d1d25efe8ab1d2be857af7",
      "unit_id": "story-text:v1:1_4_002_01:1_4_002_01_a:cmd-000000:title:000"
    },
    {
      "source": "目指せ、Jupiterイチのモテ男！",
      "text": "目标是Jupiter第一的万人迷！",
      "source_hash": "sha256:822d8b5e7f03a03461a896adf145e0dcfc718c8dbff4056ee53ad2158ed5d9dc",
      "unit_id": "story-text:v1:1_4_002_02:1_4_002_02_a:cmd-000000:title:000"
    },
    {
      "source": "希望のVICTORY",
      "text": "希望的VICTORY",
      "source_hash": "sha256:fa01898a2146aab8856566a71ff6fa3b2459143bde0079b352a97419ebd844e4",
      "unit_id": "story-text:v1:1_4_002_03:1_4_002_03_a:cmd-000000:title:000"
    },
    {
      "source": "シング・ア・ソング・フォー",
      "text": "Sing a song for",
      "source_hash": "sha256:4d1b26bd5c92a44ccc73a2f6710c888e04b746174483db6b045d7f64679e05d4",
      "unit_id": "story-text:v1:1_4_002_04:1_4_002_04_a:cmd-000000:title:000"
    },
    {
      "source": "時をこえる邂逅",
      "text": "跨越时空的邂逅",
      "source_hash": "sha256:62e41aaa392468150a87f4fb1a762831433ecf88b977c83c554c737bb7a26c74",
      "unit_id": "story-text:v1:1_4_002_05:1_4_002_05_a:cmd-000000:title:000"
    },
    {
      "source": "弱気も強気も一緒に行こう！",
      "text": "软弱与逞强都要同行！",
      "source_hash": "sha256:214fdcccde98d0a62775f2877532a682dd0c57a52cd14611dc528e8ff823d3ea",
      "unit_id": "story-text:v1:1_4_002_06:1_4_002_06_a:cmd-000000:title:000"
    },
    {
      "source": "驚け、轟け、都築圭！",
      "text": "惊叹吧，轰鸣吧，都筑圭！",
      "source_hash": "sha256:87d8ec8f2041182d2e99687966e020e406e1545363995c5453b128e7766498a0",
      "unit_id": "story-text:v1:1_4_002_07:1_4_002_07_a:cmd-000000:title:000"
    },
    {
      "source": "不運もラッキー！",
      "text": "厄运也是幸运！",
      "source_hash": "sha256:3aab900f87083af6090ac47214011cd8a1d82ffb4eacbe60c1790dbf58616830",
      "unit_id": "story-text:v1:1_4_002_08:1_4_002_08_a:cmd-000000:title:000"
    },
    {
      "source": "あやしい男極、あやしいライブ",
      "text": "可疑的男极，可疑的LIVE",
      "source_hash": "sha256:f33eb7b03c77f1cfbd72959ecc6fdc0e817ebcae36d273fcc7c02c4943a684cf",
      "unit_id": "story-text:v1:1_4_002_09:1_4_002_09_a:cmd-000000:title:000"
    },
    {
      "source": "俺たちが、『男極〇〇〇〇』だ！！",
      "text": "我们就是“男极〇〇〇〇”！！",
      "source_hash": "sha256:ea7981daf14509f8a21abdf9c1a1630f1ef6b98838327916825c25c8fe70150a",
      "unit_id": "story-text:v1:1_4_002_10:1_4_002_10_a:cmd-000000:title:000"
    }
  ],
