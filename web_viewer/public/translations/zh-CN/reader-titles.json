  "titles": [
    {
      "source": "新たな夢の開演",
      "text": "新梦想开演",
      "source_hash": "sha256:e26d45b17879569fe05d3c4706ccceec909eda28b67b5c7facc3579051762916",
      "unit_id": "story-text:v1:1_4_001_00:1_4_001_00_a:cmd-000000:title:000"
    },
    {
      "source": "新たなる三つの輝きと共に！",
      "text": "与崭新的三道光芒一同！",
      "source_hash": "sha256:4f36418148a51328db0391690c15d518106a0ad0bc5812a3b317355e6e935f2a",
      "unit_id": "story-text:v1:1_4_001_01:1_4_001_01_a:cmd-000000:title:000"
    },
    {
      "source": "初めての仕事",
      "text": "第一次工作",
      "source_hash": "sha256:853ab75db1aa9ca0bab7149e58931d08d9b5147e1891df42476286653a77ab77",
      "unit_id": "story-text:v1:1_4_001_02:1_4_001_02_a:cmd-000000:title:000"
    },
    {
      "source": "好きに真っすぐ！",
      "text": "笔直奔向所爱！",
      "source_hash": "sha256:f7ae441463d049a37403364f1446cfd5dac7cda5599fd4a20f65167f0c379540",
      "unit_id": "story-text:v1:1_4_001_03:1_4_001_03_a:cmd-000000:title:000"
    },
    {
      "source": "自分らしく、自分たちらしく",
      "text": "像自己，像我们自己",
      "source_hash": "sha256:6ce89806573cb24de3f996803fe878444be7e26477427c571a2e074482365b77",
      "unit_id": "story-text:v1:1_4_001_04:1_4_001_04_a:cmd-000000:title:000"
    },
    {
      "source": "トリニティ・アタック！！！",
      "text": "三位一体冲锋！！！",
      "source_hash": "sha256:9c67e11954dfa74ae7e384b569daf374c71a3547aa7361a22f14f81bfd92f788",
      "unit_id": "story-text:v1:1_4_001_05:1_4_001_05_a:cmd-000000:title:000"
    }
