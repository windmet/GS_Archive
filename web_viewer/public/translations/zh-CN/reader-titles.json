      "text": "蔓延的狂热，潜藏的阴影",
      "source_hash": "sha256:fea4231a2d742d6f1cb722e75bf8816337ed121892035112249e6282e21dd11b",
      "unit_id": "story-text:v1:1_1_001jup_03_1_1_001_03:1_1_001_03_a:cmd-000000:title:000"
    },
