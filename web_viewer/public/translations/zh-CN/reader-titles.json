{
  "schema_version": 2,
  "locale": "zh-CN",
  "titles": [
    {
      "source": "はじまりの前の、はじまり",
      "text": "开始之前的、开始",
      "source_hash": "sha256:c26f6b3ac1fbe22ded38c30b51cbbfb9a39c8cf5fc6f50412b075df098b45d51",
      "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_a:cmd-000000:title:000"
    },
    {
      "source": "始動、Jupiter！",
      "text": "始动，Jupiter！",
      "source_hash": "sha256:434a364b006243be2eb1389a3bc31328e357b161e4fef296163bf7a2ca61e80e",
      "unit_id": "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_a:cmd-000000:title:000"
    },
    {
      "source": "広がる熱、潜む影",
      "text": "蔓延的狂热，潜藏的阴影",
      "source_hash": "sha256:fea4231a2d742d6f1cb722e75bf8816337ed121892035112249e6282e21dd11b",
      "unit_id": "story-text:v1:1_1_001jup_03_1_1_001_03:1_1_001_03_a:cmd-000000:title:000"
    },
    {
      "source": "正義のヒーロー",
      "text": "正义的英雄",
      "source_hash": "sha256:db6eaf0a12efcd4ee3f52a00e144cc52d499ec97bbcad0e816fbdfeba70c0591",
      "unit_id": "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_a:cmd-000000:title:000"
    },
    {
