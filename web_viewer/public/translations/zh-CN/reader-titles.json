{
  "schema_version": 1,
  "locale": "zh-CN",
  "titles": [
    {
      "source": "新たな夢の開演",
      "text": "新梦想开演",
      "source_hash": "sha256:e26d45b17879569fe05d3c4706ccceec909eda28b67b5c7facc3579051762916",
      "unit_id": "story-text:v1:1_4_001_00:1_4_001_00_a:cmd-000000:title:000"
    },
    {
      "source": "新たなる三つの輝きと共に！",
      "text": "与崭新的三道光芒一同！",
      "source_hash": "sha256:4f36418148a51328db0391690c15d518106a0ad0bc5812a3b317355e6e935f2a",
      "unit_id": "story-text:v1:1_4_001_01:1_4_001_01_a:cmd-000000:title:000"
    },
    {
      "source": "初めての仕事",
      "text": "第一次工作",
      "source_hash": "sha256:853ab75db1aa9ca0bab7149e58931d08d9b5147e1891df42476286653a77ab77",
      "unit_id": "story-text:v1:1_4_001_02:1_4_001_02_a:cmd-000000:title:000"
    },
    {
      "source": "好きに真っすぐ！",
      "text": "笔直奔向所爱！",
      "source_hash": "sha256:f7ae441463d049a37403364f1446cfd5dac7cda5599fd4a20f65167f0c379540",
      "unit_id": "story-text:v1:1_4_001_03:1_4_001_03_a:cmd-000000:title:000"
    },
    {
      "source": "自分らしく、自分たちらしく",
      "text": "像自己，像我们自己",
      "source_hash": "sha256:6ce89806573cb24de3f996803fe878444be7e26477427c571a2e074482365b77",
      "unit_id": "story-text:v1:1_4_001_04:1_4_001_04_a:cmd-000000:title:000"
    },
    {
      "source": "トリニティ・アタック！！！",
      "text": "三位一体冲锋！！！",
      "source_hash": "sha256:9c67e11954dfa74ae7e384b569daf374c71a3547aa7361a22f14f81bfd92f788",
      "unit_id": "story-text:v1:1_4_001_05:1_4_001_05_a:cmd-000000:title:000"
    },
    {
      "source": "3人一緒にえいえい、おー！",
      "text": "三人一起，嘿——嘿——哦！",
      "source_hash": "sha256:272650ba424179d7145b3dadee2a454d33286000660ba93c38dc8199803e8b35",
      "unit_id": "story-text:v1:1_4_001_07:1_4_001_07_a:cmd-000000:title:000"
    },
    {
      "source": "出来ることは、諦めないこと",
      "text": "能做的事，就是绝不轻言放弃",
      "source_hash": "sha256:280f16b759b617c893a8f51317ee795f77fe176f343e908549922fb721d82982",
      "unit_id": "story-text:v1:1_4_001_08:1_4_001_08_a:cmd-000000:title:000"
    },
    {
      "source": "熱く冷静に燃え上がる男たち",
      "text": "炽热而冷静燃烧的男儿们",
      "source_hash": "sha256:d519c569d2b5bb0ab48ab57449795439d7bb61fe58c284439890d170cfb4d52a",
      "unit_id": "story-text:v1:1_4_001_09:1_4_001_09_a:cmd-000000:title:000"
    },
    {
      "source": "過去と未来を照らす星",
      "text": "照亮过去与未来的繁星",
      "source_hash": "sha256:5b3c50f43da19ed6afccf1fa2c7e28698998671da671a34a5751845978fc7f75",
      "unit_id": "story-text:v1:1_4_001_10:1_4_001_10_a:cmd-000000:title:000"
    },
    {
      "source": "黒い影",
      "text": "黑影",
      "source_hash": "sha256:e2f8c280c6831976f523502274a16ecba33a98216bbeaede18ee8a1da3e4c76a",
      "unit_id": "story-text:v1:1_4_002_00:1_4_002_00_a:cmd-000000:title:000"
    },
    {
      "source": "始動、『男極ッ！アイドルリーグ』",
      "text": "始动，“男极ッ！偶像联盟”",
      "source_hash": "sha256:d42ebc0681aba0211eefef91186f36befcf0dc75c9d1d25efe8ab1d2be857af7",
      "unit_id": "story-text:v1:1_4_002_01:1_4_002_01_a:cmd-000000:title:000"
    }
  ],
