  "titles": [
    {
      "source": "はじまりの前の、はじまり",
      "text": "开始之前的、开始",
      "source_hash": "sha256:c26f6b3ac1fbe22ded38c30b51cbbfb9a39c8cf5fc6f50412b075df098b45d51",
      "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_a:cmd-000000:title:000"
    },
