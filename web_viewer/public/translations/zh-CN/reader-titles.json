      "unit_id": "story-text:v1:1_x_028soi_2_1_2_028_12:1_2_028_12_a:cmd-000000:title:000"
    },
    {
      "source": "小さき者の来襲",
      "text": "幼小之人的来袭",
      "source_hash": "sha256:aa9df107c1e647b54e7bae9f7c1661b96e456a42d42a1af893a04ce25971f647",
      "unit_id": "story-text:v1:1_2_029ass_01_1_2_029_01:1_2_029_01_a:cmd-000000:title:000"
    },
