    { "step_id": 4, "type": "adv", "state": { "bg": null, "spines": [], "talk_mode": false, "phone_mode": false, "text_disabled": false }, "dialogue": { "speaker": "？？？", "source_text": "これは長い台詞の表示を確認するための文章です。", "speaker_identity": { "kind": "unknown", "entity_type": null, "entity_id": null, "source_name": "？？？" }, "text_ref": { "unit_id": "story-text:v1:localization_stress:localization_stress:cmd-000004:dialogue:000", "source_hash": "sha256:5c0901c54a440e56543df2ea07578dbcff34d31ba531c05618ba2d21d3780902" } } },
    { "step_id": 5, "type": "adv", "state": { "bg": null, "spines": [], "talk_mode": false, "phone_mode": false, "text_disabled": false }, "dialogue": { "speaker": "<P>", "source_text": "（選択肢を確認しよう。）", "speaker_identity": { "kind": "producer", "entity_type": null, "entity_id": null, "source_name": "<P>" }, "text_ref": { "unit_id": "story-text:v1:localization_stress:localization_stress:cmd-000005:dialogue:000", "source_hash": "sha256:0ce344050234ddaeaa8d00b6437aa2cebb023e4e2ba4365307b47238bdd76223" } } },
    { "step_id": 6, "type": "talk", "state": { "bg": null, "spines": [], "talk_mode": true, "phone_mode": false, "text_disabled": false }, "dialogue": { "speaker": "都築 圭", "source_text": "メッセージ表示の確認です。", "speaker_identity": { "kind": "idol", "entity_type": "idol", "entity_id": "007kei", "source_name": "都築 圭" }, "text_ref": { "unit_id": "story-text:v1:localization_stress:localization_stress:cmd-000006:mobile_message:000", "source_hash": "sha256:71b2c3ce75729e9716dd9b9c2c57b24f2ec7d198efdadfcd8590532b29b44dca" } } },
