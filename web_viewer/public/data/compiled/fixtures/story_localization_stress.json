    { "step_id": 2, "type": "synopsis", "state": { "bg": null, "spines": [], "talk_mode": false, "phone_mode": false, "text_disabled": false }, "dialogue": { "speaker": "ローカライズ負荷試験", "source_text": "表示層だけを切り替え、演出状態を保持する検証用シナリオ。", "text_ref": { "unit_id": "story-text:v1:localization_stress:localization_stress:cmd-000002:synopsis:000", "source_hash": "sha256:2b97ea93f4094f39a030c06f93a3d543b9e0098eb12b21cccdbb8b5742200673" } } },
