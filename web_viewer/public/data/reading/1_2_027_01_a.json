      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "プチガトーも出したいところだけど、\nこれから食事が待っているからね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
