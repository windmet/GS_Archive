    {
      "kind": "dialogue",
      "source_text": "こちらこそ、来てくれてありがとう。\n今度の開店に合わせた限定メニューの意見を、",
      "text_ref": {
        "unit_id": "story-text:v1:1_2_027yuk_01_1_2_027_01:1_2_027_01_a:cmd-000029:dialogue:000",
        "source": {
