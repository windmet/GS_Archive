        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "にしても、恋愛の相談がきた時は焦ったぜ。\nどうにもああいうのは苦手でよぉ……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
