      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんとか答えたけど、あれでよかったのか……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
