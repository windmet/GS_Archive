        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ですが……みんながいる場所には、\nいつも『アイドル』という存在や歌がありました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "014hid"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "014hid",
        "presence": "offstage",
        "reason": "actor-not-on-stage",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 24
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
