    {
      "kind": "dialogue",
      "source_text": "握野英雄です。少し前まで警察官をしていました。\nアイドルを志望した理由は……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000074:dialogue:000",
        "source": {
