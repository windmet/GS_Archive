    {
      "kind": "dialogue",
      "source_text": "……私はこれまで、様々な理由で居場所を\n失くした子供たちを目の当たりにしてきました。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000091:dialogue:000",
        "source": {
          "scenario_id": "1_1_006fra_03_1_1_006_03",
          "part_id": "1_1_006_03_a",
          "file": "assets/resources/scenariodata/1_1_006fra_03/scenario_1_1_006_03_a.json",
