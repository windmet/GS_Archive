      "kind": "dialogue",
      "source_text": "アイドルなら、自分の言葉が届いて、\nもっと子供たちに寄り添えるかもしれない。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000117:dialogue:000",
        "source": {
