    {
      "kind": "dialogue",
      "source_text": "私は子供たちの心の支えになるため、\nアイドルの道に進みたいんです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000124:dialogue:000",
