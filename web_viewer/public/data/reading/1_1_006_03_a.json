    {
      "kind": "dialogue",
      "source_text": "では、順番に簡単な自己紹介と、\n志望動機をお願いします。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
