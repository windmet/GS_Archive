        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その子たちは心を固く閉ざしていて、\n警察官である私の言葉は届きませんでした。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000094:dialogue:000",
        "source": {
