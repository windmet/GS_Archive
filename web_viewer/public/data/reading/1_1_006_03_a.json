      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルなら、自分の言葉が届いて、\nもっと子供たちに寄り添えるかもしれない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "014hid"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "014hid",
        "presence": "unknown",
        "reason": "transitional-stage-appearance",
