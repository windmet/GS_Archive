    {
      "kind": "dialogue",
      "source_text": "では、順番に簡単な自己紹介と、\n志望動機をお願いします。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000055:dialogue:000",
        "source": {
