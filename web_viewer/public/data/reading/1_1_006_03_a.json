        "stepId": 16
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference",
        "transitional-stage-appearance"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_1_006_03_a:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_1_006_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……私はこれまで、様々な理由で居場所を\n失くした子供たちを目の当たりにしてきました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "014hid"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "014hid",
        "presence": "offstage",
        "reason": "actor-not-on-stage",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 21
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_1_006_03_a:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_1_006_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その子たちは心を固く閉ざしていて、\n警察官である私の言葉は届きませんでした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "014hid"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "014hid",
        "presence": "offstage",
        "reason": "actor-not-on-stage",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 22
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_1_006_03_a:step-22:text",
        "step_id": 22,
        "step_index": 21,
