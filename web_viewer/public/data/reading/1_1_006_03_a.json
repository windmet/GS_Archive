    {
      "kind": "dialogue",
      "source_text": "握野英雄です。少し前まで警察官をしていました。\nアイドルを志望した理由は……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "014hid"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "014hid",
        "presence": "unknown",
        "reason": "transitional-stage-appearance",
        "source": "stage-snapshot",
