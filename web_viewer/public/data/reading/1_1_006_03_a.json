    {
      "kind": "dialogue",
      "source_text": "ですが……みんながいる場所には、\nいつも『アイドル』という存在や歌がありました。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_006fra_03_1_1_006_03:1_1_006_03_a:cmd-000099:dialogue:000",
        "source": {
