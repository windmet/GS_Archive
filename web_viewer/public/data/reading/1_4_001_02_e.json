          "end_step_index": 45,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "各自、\n練習の進捗を報告してくれ",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-34:text",
        "step_id": 34,
        "step_index": 33,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺はベーゴマやってます。\nもうかなり回せますよ",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-35:text",
        "step_id": 35,
        "step_index": 34,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 34
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "二人は？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-37:text",
        "step_id": 37,
        "step_index": 36,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 36
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ヨーヨー。\nスーパーレベルは\n出来るようになったよー",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-38:text",
        "step_id": 38,
        "step_index": 37,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 37
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "けん玉の練習をしている。\n上級者クラスの技は\n一通り身につけた",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-39:text",
        "step_id": 39,
        "step_index": 38,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
