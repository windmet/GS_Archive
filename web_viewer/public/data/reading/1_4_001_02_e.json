          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 27
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "数日後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
