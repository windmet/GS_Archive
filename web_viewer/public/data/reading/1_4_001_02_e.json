          "end_step_index": 45,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "改めて話し合おう。\nあの店に、大勢の子供を呼び込む方法についてだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちはアイドルだが駆け出しだ。\n名前を出しても、大した宣伝にはならないだろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なら、あの店の特性を活かしたイベントや、\n企画が必要だと考えている。……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すまない、俺ばかり話しているな。\n百々人、秀、お前たちの意見はどうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうだなぁ、テーマがおもちゃだし、\n僕は最年少くんのアイデアが聞きたいな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アマミネくん、どう思う？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "んー……俺、スマホのゲームは好きですけど、\nああいうおもちゃはよく分からないんで。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "大人なら懐かしいのかな。\nけど、今回は子供を集めたいんだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-17:text",
        "step_id": 17,
        "step_index": 16,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よく分からない昔のおもちゃでイベントしても、\n興味はひけない気がするし……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……あ。\nそれ、いいヒントかも。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お店に子供が来ないのって、\n『よく分からないから』なんじゃない？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こうやって遊ぶんだよーって教えながら\n一緒に遊んだら、楽しいかもしれないね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルが遊び方を教えてくれる、\n『おもちゃ大会イベント』ですね！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "しかしそのためには、私たちも\nおもちゃについて勉強する必要がありますね……。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_e:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_001_02_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_e.json",
          "start_step_index": 0,
          "end_step_index": 45,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちなら余裕だよ。おもちゃでも何でも、\nすぐにプロ並みになってみせるから。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_e:step-28:text",
        "step_id": 28,
        "step_index": 27,
        "source_part_id": "1_4_001_02_e",
