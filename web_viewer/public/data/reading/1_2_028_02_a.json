      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それなら、みなさんが作ったケーキを\n食べてみたいです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
