      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ケーキか。想像していなかったな。みんなも聞いたら\n驚きそうだ。わかった、俺から伝えておくよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
