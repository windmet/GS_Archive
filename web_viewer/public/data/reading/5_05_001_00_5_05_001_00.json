    {
      "kind": "dialogue",
      "source_text": "このゲームの日本語版テーマ曲を、俺たちが？",
      "text_ref": {
        "unit_id": "story-text:v1:5_05_001_00_5_05_001_00:5_05_001_00:cmd-000037:dialogue:000",
        "source": {
