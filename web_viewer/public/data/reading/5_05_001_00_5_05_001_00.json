    {
      "kind": "dialogue",
      "source_text": "『チャクラム』って名前自体は聞いたことあるけど、\nどんな武器なんだろう……？",
      "text_ref": {
        "unit_id": "story-text:v1:5_05_001_00_5_05_001_00:5_05_001_00:cmd-000088:dialogue:000",
