        "command_start": 37,
        "command_end": 37
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。大型ゲームイベントで歌っていただきます！\nちなみにテーマ曲の振り付けには、",
      "text_ref": {
        "unit_id": "story-text:v1:5_05_001_00_5_05_001_00:5_05_001_00:cmd-000041:dialogue:000",
        "source": {
