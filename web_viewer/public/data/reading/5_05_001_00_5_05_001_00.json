          "command_index": 41,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:382ee877211a0299b7bc871a5d66620580c1412dc2d8d1b43e287141bb16b673"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "5_05_001_00_5_05_001_00:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "5_05_001_00",
        "source_file": "assets/resources/scenariodata/5_05_001_00/scenario_5_05_001_00.json",
        "command_start": 41,
        "command_end": 41
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ゲームの世界観をイメージした\n殺陣が入っているそうですよ。",
      "text_ref": {
        "unit_id": "story-text:v1:5_05_001_00_5_05_001_00:5_05_001_00:cmd-000046:dialogue:000",
        "source": {
