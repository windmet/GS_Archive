    {
      "kind": "dialogue",
      "source_text": "そうだな。もう一度、\n確認でもしとくか…。\n何かしてないと落ち着かない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
