    {
      "kind": "dialogue",
      "source_text": "確認、する！　料理、OK。\nお花も…キレイ♪\nみのり、喜ぶと思う？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
