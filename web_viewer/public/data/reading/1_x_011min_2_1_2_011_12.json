        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まあ……それなりには。花を\nずっと取り扱っていたみのりさん\nに、渡すものでしたし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
