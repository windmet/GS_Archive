    {
      "kind": "dialogue",
      "source_text": "ああ、きっと喜んでくれるよ。\n何なら嬉し泣きするかも……\nって、さすがにそれは無いか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "performance": {
        "entityType": "idol",
