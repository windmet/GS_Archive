      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "2人がこのアレンジメントを\n作ってくれたなんて、感激だよ。\n練習も頑張ってくれたんだろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
