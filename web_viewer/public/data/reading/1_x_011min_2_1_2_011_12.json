        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みのり、嬉しくて泣く？\nその時は、ボクのハンカチ、\n貸す。だから、大丈夫！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
