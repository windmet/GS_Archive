        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "例えだったんだけど……、\nまぁ、いいか。みのりさんが\n来たら、たくさん喜ばせような。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "performance": {
        "entityType": "idol",
