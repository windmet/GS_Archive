    {
      "kind": "dialogue",
      "source_text": "…いい引きじゃん。気に入ったキャラで選ぶのもあり\nだけど、初めはバランスよく属性を選ぶ方が有利。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
