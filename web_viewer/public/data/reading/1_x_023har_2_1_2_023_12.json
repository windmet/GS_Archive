        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん……。白猫は、ミルク風味。\n黒猫は……ビターチョコの味。\nあと…茶トラ、白ブチも……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
      },
      "performance": {
        "entityType": "idol",
