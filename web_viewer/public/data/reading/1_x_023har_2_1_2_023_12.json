        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "くぅ～、サマになるっす！\nハルナっち、もうちょい腕上げて\n視線コッチ貰えるっすか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
