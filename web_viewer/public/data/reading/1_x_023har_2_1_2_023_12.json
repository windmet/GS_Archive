        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うわああ、全部うまそう！\nナツキ、今度そのドーナツ屋に\n案内してくれよ。全部買う！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "023har"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "023har",
        "presence": "visible",
