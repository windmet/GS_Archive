        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……ん？　オレが貰ったのは\n三毛猫のドーナツだったよな。\nバリエーションがあるのか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "performance": {
        "entityType": "idol",
