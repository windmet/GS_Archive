    {
      "kind": "dialogue",
      "source_text": "あの猫のドーナツって\nほんとにナツキらしいよな。\nうまいし可愛かったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "performance": {
        "entityType": "idol",
