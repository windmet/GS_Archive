        "step_index": 27,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん……お店で見かけて……\nこれしかないな、って思った…。\n白猫も、黒猫も、可愛くて……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "022nat"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "022nat",
        "presence": "visible",
