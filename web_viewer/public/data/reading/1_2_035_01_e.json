    {
      "kind": "dialogue",
      "source_text": "……他にも数学への好意的な反応が多数あった。\n嬉しい成果だ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
