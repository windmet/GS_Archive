      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「この動画で見た数学用語がテストに出てきて、\nいい点を取ることができました！」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "performance": {
        "entityType": "idol",
