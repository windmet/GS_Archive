    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー。君の助力があったからこそ\n彼らに勉学への意欲を芽生えさせることができた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
