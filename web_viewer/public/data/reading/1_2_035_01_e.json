    {
      "kind": "dialogue",
      "source_text": "「数学に苦手意識があったけど、\nこの動画のおかげで少しマシになりました！」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
