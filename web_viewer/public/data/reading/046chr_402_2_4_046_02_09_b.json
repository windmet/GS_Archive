    {
      "kind": "dialogue",
      "source_text": "衣装の形に近い姿をしている魚をリストアップし、\nその生態を参考にしようと思っているのですが。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
        "entityType": "idol",
