    {
      "kind": "dialogue",
      "source_text": "今回の演目は16世紀のスペインを舞台にした、\nピカレスク小説が元になっています。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
