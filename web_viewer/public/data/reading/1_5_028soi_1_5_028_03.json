        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、奇遇ですね。\n私も同じ理由でこちらに参りました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
