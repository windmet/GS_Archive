        "step_index": 10,
        "source_part_id": "1_4_002_09_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お世話になった会社やスタッフさんにも、\nなんて言ったらいいんですか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "男極スタッフたち"
      },
      "performance": {
