        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_002_09_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……そんな終わり方、納得できません。男極KINGを\n目指して頑張ってきたアイドルたちが悲しみますよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "男極スタッフたち"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
        "reason": "unresolved-performance-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
