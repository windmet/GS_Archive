        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いいや、駄目だ、今すぐに終わらせるっ！\n知識部門でも、ライバル共のほうが活躍したら？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
