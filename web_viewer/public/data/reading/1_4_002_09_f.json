    {
      "kind": "dialogue",
      "source_text": "関係各所については、心配しなくていい。\nすでに何社かに伝えたが、逆に謝罪を受けたぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
