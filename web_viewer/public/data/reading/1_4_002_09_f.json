        "step_index": 5,
        "source_part_id": "1_4_002_09_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "大会で活躍したTOP5の事務所に、男極賞を与える。\n男極リーグは、KING無しで終了とする！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アイドル業界の大物"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
        "reason": "unresolved-performance-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
