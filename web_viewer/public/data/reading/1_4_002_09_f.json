    {
      "kind": "dialogue",
      "source_text": "アイドル全員が素晴らしく、\n男極KINGを決めることができない。そのため……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アイドル業界の大物"
      },
