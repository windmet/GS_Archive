        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "自分たちの協力が足りなかったせいで、\n不備不足が多い大会になってすまなかった、とな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
