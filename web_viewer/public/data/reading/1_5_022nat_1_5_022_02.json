    {
      "kind": "dialogue",
      "source_text": "夏来さん、もう間もなく撮影が始まりますが、\n準備は大丈夫ですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000016:dialogue:000",
        "source": {
