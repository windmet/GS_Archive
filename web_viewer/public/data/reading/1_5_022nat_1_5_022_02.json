        "command_end": 16
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……うん。台本、ちゃんと覚えた。\n準備もできてる……けど……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_022nat_1_5_022_02:1_5_022_02:cmd-000022:dialogue:000",
        "source": {
