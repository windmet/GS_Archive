    {
      "kind": "dialogue",
      "source_text": "あ、待って。\nこのうさぎさんの飾り、\nもう少しで完成するから……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
