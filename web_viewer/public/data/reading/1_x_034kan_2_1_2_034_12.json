    {
      "kind": "dialogue",
      "source_text": "ったく、しょうがねーなー！\nオレも手伝ってやるから、\nのりとハサミ貸せ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
