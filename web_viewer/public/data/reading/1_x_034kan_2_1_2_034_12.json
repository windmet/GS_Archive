        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "かのんくんが来るまで\nまだ時間があるから、\n急がなくても大丈夫だよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
