        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "どの動画も初めは1000回前後の再生数でしたが、\n口コミで徐々に伸びてきているんですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
