          "target_step_index": 75
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうなれるように、\nみんなで頑張ろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
