        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "可能性としてないとは\n言いませんが、\n気が早すぎです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "冬美 旬"
