      "source_text": "だな！オレたちの曲を、\nもっといろんな人に\n聞いてもらおうぜ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
