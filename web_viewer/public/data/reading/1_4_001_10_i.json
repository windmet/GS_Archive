        "step_index": 23,
        "source_part_id": "1_4_001_10_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_i.json",
          "start_step_index": 0,
          "end_step_index": 79,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "会場どころか世界中を盛り上げるっす！\nみんな、中継カメラのとこまで競争っすよーーっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_i:step-27:text",
