          "target_step_index": 76
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もっとたくさんの人に、\nHigh×Jokerの、\n曲を知ってほしいから。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
      },
