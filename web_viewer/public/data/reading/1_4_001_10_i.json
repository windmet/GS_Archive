        "step_index": 26,
        "source_part_id": "1_4_001_10_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_i.json",
          "start_step_index": 0,
          "end_step_index": 79,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みんなはしゃぎすぎて、ペース配分忘れてるな。\nまだライブの途中だっていうのに……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "冬美 旬"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_i:step-30:text",
        "step_id": 30,
        "step_index": 29,
        "source_part_id": "1_4_001_10_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_i.json",
          "start_step_index": 0,
          "end_step_index": 79,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……でも、ジュンも楽しそう。\nほら……ハヤトたちが呼んでる。行こう？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
      },
      "inline_translation": null,
      "has_voice": true,
