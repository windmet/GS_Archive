  "rows": [
    {
      "kind": "dialogue",
      "source_text": "トップバッターの315プロダクションです！\nみんな、よろしくねー！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
