          "end_step_index": 24,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あはは……こいつなりのファンサービスなんで、\n許してください、お客さん！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
