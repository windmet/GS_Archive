          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…おれたちの力で、あなたの心を動かしてみせる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "全力で飛ばしていくけぇ、ついてきんさーいっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……あれ？　悪くないじゃん。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "観客A"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_10_g:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんか、わりと好きな音楽かも。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "観客B"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_10_g:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "漣くーん！　頑張ってー！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "観客C"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_10_g:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ！？　誰だテメェ！\nオレ様に指図すんじゃねぇ！！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こ、こら、漣！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-17:text",
        "step_id": 17,
        "step_index": 16,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "観客にケンカ売るな。あの人は、\nオマエみたいなのを応援してくれてるんだぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ンなもんいらねー。\nザコはザコらしく、ただオレ様を称えてろ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_g:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_001_10_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_10_g.json",
          "start_step_index": 0,
          "end_step_index": 24,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "余計なこと言いやがったら、\nそのツラ覚えてぶっ飛ばすからな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
