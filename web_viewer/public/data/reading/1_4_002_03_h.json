          "end_step_index": 37,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……やっと来た。遅いよ、享介！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_002_03_h",
