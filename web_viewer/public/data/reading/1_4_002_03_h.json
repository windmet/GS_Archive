        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おまえが速すぎるんだよ！\n……それじゃ、やろっか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……すみません！　W、1周走り忘れてました！\nこれから走り直しまーす！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なあ。オレの考えをよんで、ここに戻ったのか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ううん。自分が戻りたいって思ったから来たんだ。\nでも……悠介がいて、安心した。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんだよ、それ。\nホント、放っておけない弟だな～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……あーあ。カッコつけて宣誓までしたのに、\nきっと最下位だぜ。ダサイよなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-28:text",
        "step_id": 28,
        "step_index": 27,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 27
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "315プロのみんなは、ダサイなんて思わないよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-29:text",
        "step_id": 29,
        "step_index": 28,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "神速一魂の2人なんて、\n俺が戻るって言ったら感激してたぜ。……でも。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-30:text",
        "step_id": 30,
        "step_index": 29,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……やっぱり、負けるのは悔しいよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-34:text",
        "step_id": 34,
        "step_index": 33,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_h.json",
          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まあな。戦うからには負けたくない。\n勝負で勝つのは好きだし、気持ちいいし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_h:step-37:text",
        "step_id": 37,
        "step_index": 36,
        "source_part_id": "1_4_002_03_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
