          "start_step_index": 0,
          "end_step_index": 37,
          "target_step_index": 36
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……だけどさ。オレ、好きなものは他にもあるんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
