    {
      "kind": "dialogue",
      "source_text": "気候が安定していて、\nとても過ごしやすいところだったよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_027yuk_1_5_027_02:1_5_027_02:cmd-000032:dialogue:000",
