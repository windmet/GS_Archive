        "command_start": 14,
        "command_end": 14
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "クイズの舞台が、行ったことのある国だったからね。\n問題も簡単なものが多かったし、たまたまさ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_027yuk_1_5_027_02:1_5_027_02:cmd-000019:dialogue:000",
        "source": {
          "scenario_id": "1_5_027yuk_1_5_027_02",
