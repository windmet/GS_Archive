    {
      "kind": "dialogue",
      "source_text": "俺が行った街は気さくな人が多くてね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
