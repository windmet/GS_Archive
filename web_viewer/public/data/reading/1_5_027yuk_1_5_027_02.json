          "command_index": 14,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:dff8d8796989ac8061bebd0c3a4c47c2795acba3627aec507ab61577b1b9e4db"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_027yuk_1_5_027_02:step-5:text",
