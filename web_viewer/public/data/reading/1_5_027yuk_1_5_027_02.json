        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "クイズの舞台が、行ったことのある国だったからね。\n問題も簡単なものが多かったし、たまたまさ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "027yuk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "027yuk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
