    {
      "kind": "dialogue",
      "source_text": "そういえば幸広さんは、高校を卒業したあと、\n各国を回っていたんですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_027yuk_1_5_027_02:1_5_027_02:cmd-000023:dialogue:000",
