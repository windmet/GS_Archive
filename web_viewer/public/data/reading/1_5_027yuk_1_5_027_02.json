    {
      "kind": "dialogue",
      "source_text": "リハーサル中の幸広さん、すごかったです！\n仮の問題でしたが、いくつも当てていましたよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_027yuk_1_5_027_02:1_5_027_02:cmd-000014:dialogue:000",
        "source": {
          "scenario_id": "1_5_027yuk_1_5_027_02",
