    {
      "kind": "dialogue",
      "source_text": "リハーサル中の幸広さん、すごかったです！\n仮の問題でしたが、いくつも当てていましたよね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
