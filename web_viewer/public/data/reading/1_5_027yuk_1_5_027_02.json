    {
      "kind": "dialogue",
      "source_text": "ご飯をご馳走になったり、知り合ったその日に\n家に泊めてもらったりした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
