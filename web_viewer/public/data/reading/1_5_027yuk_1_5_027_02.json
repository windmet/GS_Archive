        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今回のクイズの舞台は、どんな国でしたか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
