    {
      "kind": "dialogue",
      "source_text": "翔真さん、お待たせしました。\nこちらが今回出演する恋愛ドラマの台本です。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_03:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ありがとう、●●●●プロデューサーちゃん。\nアタシの役は商社マンだったわね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
