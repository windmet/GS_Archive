    {
      "kind": "dialogue",
      "source_text": "俺のオリジナルカラー！？\nうわぁ……バリエーション多い。うーん……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000027:dialogue:000",
