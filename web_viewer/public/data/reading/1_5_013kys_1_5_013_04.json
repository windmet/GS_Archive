    {
      "kind": "dialogue",
      "source_text": "俺のオリジナルカラー！？\nうわぁ……バリエーション多い。うーん……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
