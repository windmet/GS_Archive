    {
      "kind": "dialogue",
      "source_text": "CMでは享介さんオリジナルカラーを用意して\nいただけるそうで、こちらがカラーサンプルです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
