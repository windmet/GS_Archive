    {
      "kind": "dialogue",
      "source_text": "CMでは享介さんオリジナルカラーを用意して\nいただけるそうで、こちらがカラーサンプルです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_013kys_1_5_013_04:1_5_013_04:cmd-000021:dialogue:000",
