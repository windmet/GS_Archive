    {
      "kind": "dialogue",
      "source_text": "シューロクなんざ知らねェし、\nオマエが困ろうがオレ様には関係ねェ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000055:dialogue:000",
        "source": {
