    {
      "kind": "dialogue",
      "source_text": "フン、いい飛びっぷりじゃねェか。\nなら、次はこれでどうだ！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000040:dialogue:000",
