    {
      "kind": "dialogue",
      "source_text": "あァ？\nそーいや、シューロクで飯が食えるって言ってたな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "performance": {
        "entityType": "idol",
