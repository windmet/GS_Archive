    {
      "kind": "dialogue",
      "source_text": "これから収録があるのに、いつの間にか漣さんが\nいなくなってしまった！　早く探さないと……！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
