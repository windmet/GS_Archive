    {
      "kind": "dialogue",
      "source_text": "あァ？　おい、ネコ。\nオレ様の前に立つとはいい度胸じゃねェか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "040ren"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "040ren",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
