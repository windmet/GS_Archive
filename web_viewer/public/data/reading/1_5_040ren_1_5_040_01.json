    {
      "kind": "dialogue",
      "source_text": "はい、お店の大盛りメニューを紹介したあと、\n実際に食べていただきます。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
