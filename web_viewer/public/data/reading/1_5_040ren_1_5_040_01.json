    {
      "kind": "dialogue",
      "source_text": "漣さ～ん！　やっと見つけましたよ！\n収録前にいなくなられたら困ります。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000050:dialogue:000",
        "source": {
