      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "関係あります！\nそろそろ収録が始まるので戻りますよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000057:dialogue:000",
        "source": {
