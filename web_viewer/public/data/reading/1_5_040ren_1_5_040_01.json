    {
      "kind": "dialogue",
      "source_text": "お前にはコイツで十分だろ。\nおら、飛んでみやがれ！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_040ren_1_5_040_01:1_5_040_01:cmd-000031:dialogue:000",
