      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "特に、水嶋さんが考えるカラフルなイメージを\n表現するには、色数の多さが役立ったようです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
