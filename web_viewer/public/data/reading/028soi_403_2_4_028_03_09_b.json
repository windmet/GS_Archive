      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "巻緒さんや水嶋さんも一緒に\nデザイン案を描いていたんですが、",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
