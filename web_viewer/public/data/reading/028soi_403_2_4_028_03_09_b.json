    {
      "kind": "dialogue",
      "source_text": "実は、あのケーキのデザインを考える際に、\nコラボレーション文具のマーカーを使用したんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
