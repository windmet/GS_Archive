          "end_step_index": 47,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今日はありがとうございました！\n大成功でした！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "店員A"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_07_i:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……こちらこそ、今日はいい経験が出来ました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちも期待に応えられるよう、もっと頑張ります。\nなんで……これからも応援、よろしくお願いします。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "その日の帰り道……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_07_i:step-12:caption",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちの事をたくさん知ってもらえたし、\n来てくれた人みんなに笑顔を届けられたし……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "またひとつ、世界を平和にできたって気がするよ。\n頑張った甲斐があったね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうっすね……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（小さな一歩かもしれない。だが……\n今の俺は、自分の力で道を切り拓いてる）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（このままアイドルとして、もっと成長して……\nこの三人で、夢を掴んでみせる！）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ピエールさん、先ほどから静かですが、\n大丈夫……あ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_07_i:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ん……むにゃむにゃ……\nみんな、笑顔。楽しかった……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-27:text",
        "step_id": 27,
        "step_index": 26,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……気持ちよさそうに寝てるな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-29:text",
        "step_id": 29,
        "step_index": 28,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ピエールも頑張ってたからね。\nこのまま寝かせてあげよう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_i:step-30:text",
        "step_id": 30,
        "step_index": 29,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、あの……みのりさんのファンです！\nこれからも応援しています！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ファンの人"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_07_i:step-40:text",
        "step_id": 40,
        "step_index": 39,
        "source_part_id": "1_4_001_07_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_i.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 39
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（叔父さんが、たくさんの人が\n夢中になる、『アイドル』……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
