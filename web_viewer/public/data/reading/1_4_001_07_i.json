        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（俺自身も、そんな存在に、\n少しは近づけているのかな……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
