  "rows": [
    {
      "kind": "caption",
      "source_text": "閉店後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
