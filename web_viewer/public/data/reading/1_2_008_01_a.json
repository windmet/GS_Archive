    {
      "kind": "dialogue",
      "source_text": "事務所で競馬を見ていて、\nよかったと思っている。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
