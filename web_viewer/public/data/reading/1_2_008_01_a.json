      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "麗さんが音楽以外であんなに熱中する姿が\n珍しくてつい声をかけてしまいました。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
