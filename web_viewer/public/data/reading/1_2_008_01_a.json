      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい！　楽しみにしています。それにしても、\n人が多いですね。熱気に圧倒されそうです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
