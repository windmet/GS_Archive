        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "魅力を上げればキリがない。間近で馬を見ることで、\nその素晴らしさを少しでも感じてもらいたい。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
