        "source_part_id": "1_2_008_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。駆ける時の力強い脚の運び、\n躍動感のある筋肉の動き……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
