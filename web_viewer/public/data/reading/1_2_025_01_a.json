    {
      "kind": "dialogue",
      "source_text": "おはよう、●●●●プロデューサーさんよぉっ！\n今日も気持ちのいい朝だな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
