    {
      "kind": "dialogue",
      "source_text": "えっ！　鋭心、俺たちのライブ見てくれてるの！？\nありがと、メッチャ嬉しいよ！　……じゃなくて！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
