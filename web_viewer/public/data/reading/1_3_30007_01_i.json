        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "本当？　よかった……。髪型は、\nスザクから借りたヘアワックスのおかげだよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
