    {
      "kind": "dialogue",
      "source_text": "大丈夫だぜ、隼人さんよぉっ！\nその恰好も髪型も、バッチリ決まってるぜ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
