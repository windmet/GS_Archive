        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "これから本番だよ！？　気になって当然じゃん！\nみんなにカッコいいとこ見せたいし！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
