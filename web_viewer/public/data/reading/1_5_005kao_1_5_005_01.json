      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "行かれたことのある場所はありますか？\n観光名所についてアンケートがあるそうです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_01:1_5_005_01:cmd-000023:dialogue:000",
        "source": {
