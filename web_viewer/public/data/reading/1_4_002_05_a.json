    {
      "kind": "dialogue",
      "source_text": "男極『シンクロ部門』では、視聴者の方が送って\n下さった思い出の手紙を元に作られた曲を歌います。",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_002_05:1_4_002_05_a:cmd-000084:dialogue:000",
        "source": {
          "scenario_id": "1_4_002_05",
