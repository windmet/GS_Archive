          "end_step_index": 40,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いいか？　持ち方はこう、構えはこう。\nそして回す時は……思いっきりだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わぁ……！　かわいい！\nおにいちゃん、絵かいてくれて、ありがとう！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "女の子"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_i:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……ううん。どーいたしまして。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちくしょー！　この兄ちゃんめっちゃ強いぞ！\nきっと悪の大ボスだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "男の子"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_i:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ほう、よく見破ったな。\nその通り、俺はこの大会のボスだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "倒せた者には特別なプレゼントをやるぞ。\nさあ、次に挑戦してくるのは誰だ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（大盛り上がりだ……！\nイベントは大成功ですね！）",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_i:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "おもちゃ大会終了後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_i:step-31:caption",
        "step_id": 31,
        "step_index": 30,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お前さんたち、今日は本当にありがとう。\n楽しそうな子供たちが、あんなに沢山……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_i:step-33:text",
        "step_id": 33,
        "step_index": 32,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 32
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……今日までやめずに続けてきて、\n良かったと思えたよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_i:step-34:text",
        "step_id": 34,
        "step_index": 33,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "礼には及びません。俺たちにとっても\n有意義な時間を過ごすことが出来ました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-35:text",
        "step_id": 35,
        "step_index": 34,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 34
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうだね。\nお仕事なのに、すごく楽しんじゃった。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-36:text",
        "step_id": 36,
        "step_index": 35,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 35
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……俺も。初めての仕事が\nじーちゃんの店で、良かったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_i:step-37:text",
        "step_id": 37,
        "step_index": 36,
        "source_part_id": "1_4_001_02_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_i.json",
          "start_step_index": 0,
          "end_step_index": 40,
          "target_step_index": 36
        }
      },
      "option": null
    },
    {
      "kind": "narration",
      "source_text": "皆さん、今日はありがとうございました！",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
