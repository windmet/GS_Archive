          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ギガサンキューって……\nそんな英語、存在しませんよ……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
