    {
      "kind": "dialogue",
      "source_text": "はは、ライブの間に降られなかったのは\n俺たちの強運のおかげってところか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
