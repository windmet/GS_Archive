        "step_id": 1,
        "step_index": 0,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うーん……全体曲に沿った演出かー。\nどういうのがいいかなー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "045sor"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "045sor",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 4
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_008_22_5_06_008_22:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "的が絞られてるからな。やりやすいかと思ったん\nだが、テーマから受けるイメージはそれぞれ違う。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_008_22_5_06_008_22:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まずはそれを纏めた方が良さそうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_008_22_5_06_008_22:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
