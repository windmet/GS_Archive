    {
      "kind": "dialogue",
      "source_text": "でもでも、かわいいも色々あるからなぁ。\n何カワにしちゃおっかな。悩む～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
