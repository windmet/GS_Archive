        "step_index": 8,
        "source_part_id": "1_2_031_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "当たりです！\n依頼の内容は、ワンピースのデザインです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
