    {
      "kind": "dialogue",
      "source_text": "アパレルブランド！　ってことはもしかして……\n咲ちゃん、ついにデザイナーデビュー！？　なんて♪",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "performance": {
        "entityType": "idol",
