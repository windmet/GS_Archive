    {
      "kind": "dialogue",
      "source_text": "えっ！　ホントに！？\nびっくりだけど、すっごく嬉しいっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
