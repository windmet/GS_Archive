    {
      "kind": "dialogue",
      "source_text": "任せて！　あたしらしく、着る人がみーんな\nパピッとかわいくなっちゃう服を考えるから♪",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
