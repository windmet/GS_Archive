    {
      "kind": "dialogue",
      "source_text": "打ち合わせの時におすすめのカフェを話したら、\nそこにも行くことになったんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
