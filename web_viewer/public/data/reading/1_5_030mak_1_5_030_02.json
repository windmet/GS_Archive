    {
      "kind": "dialogue",
      "source_text": "今回初めて行くお店の中にも、\nケーキが美味しいところがあるらしくて……！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
