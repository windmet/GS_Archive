      "kind": "dialogue",
      "source_text": "アイドルの皆さんはもちろん、プロデューサーさんの\n熱意も、ライブの成功に繋がりましたね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山村 賢"
      },
      "performance": {
        "entityType": null,
