      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おはようございます、プロデューサーさん。\n先日のライブ、お疲れさまでした！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山村 賢"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
