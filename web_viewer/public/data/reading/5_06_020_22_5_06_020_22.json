      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "しかし！　このライブは決してゴールではない、\n我々の挑戦はまだまだ続いていく！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "齋藤社長"
      },
      "performance": {
