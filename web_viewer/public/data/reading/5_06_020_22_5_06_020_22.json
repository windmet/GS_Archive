    {
      "kind": "dialogue",
      "source_text": "はい！　準備を始めてから本番まで、\n皆さんの心が一つになっていくのを感じました。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
