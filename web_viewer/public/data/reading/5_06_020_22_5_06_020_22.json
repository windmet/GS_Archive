    {
      "kind": "dialogue",
      "source_text": "この成功は、みんなのパッションが一つに\nなったからこそ得られたものだ！",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_020_22_5_06_020_22:5_06_020_22:cmd-000081:dialogue:000",
        "source": {
