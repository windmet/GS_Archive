      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みんな、ご苦労だった！　315プロダクションの\n主催ライブは、大成功で幕を閉じた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "齋藤社長"
      },
