        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "unresolved-performance-actor"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_020_22_5_06_020_22:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
