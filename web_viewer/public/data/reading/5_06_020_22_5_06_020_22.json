        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この成功は、みんなのパッションが一つに\nなったからこそ得られたものだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "齋藤社長"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
