    {
      "kind": "dialogue",
      "source_text": "はい！　準備を始めてから本番まで、\n皆さんの心が一つになっていくのを感じました。",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_020_22_5_06_020_22:5_06_020_22:cmd-000108:dialogue:000",
