      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。\n私は茶の湯を通して多くの人々と交流を図ります。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "019kur"
