    {
      "kind": "dialogue",
      "source_text": "（以前、プロデューサーさんに教えて頂いた\nアイドル活動から、今の私ができること……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
