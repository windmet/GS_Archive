        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "茶道家が茶を点てても驚きは少ないと思います。\nですが、アイドルならどうでしょうか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "019kur"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "019kur",
        "presence": "unknown",
        "reason": "transitional-stage-appearance",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
