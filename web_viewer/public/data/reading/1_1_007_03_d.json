        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "普段は歌って踊っているアイドルが、茶を点て\n侘び寂びを伝える。その印象は強く残ると思います。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
