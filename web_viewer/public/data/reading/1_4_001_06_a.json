    {
      "kind": "dialogue",
      "source_text": "アーッハッハッハ！　実に素晴らしい！\nこの者に、サタンの祝福を与えん！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
