      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、よかったですね。それで、\nファンレターにはなんて書いてあったんです？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
