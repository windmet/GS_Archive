        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うむ。闇の者として歌い、踊る、\n我の姿に勇気をもらった、救われた……とのことだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
