      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いざ、封印を解かん！\nふむ……何々……なんと！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
