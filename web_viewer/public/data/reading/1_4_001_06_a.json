    {
      "kind": "dialogue",
      "source_text": "プロデューサーさん、お疲れ様。俺たち宛てに\nファンレターが届いたって聞いたから早速来たよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
