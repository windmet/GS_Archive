    {
      "kind": "dialogue",
      "source_text": "わぁ……これ、全部あたしたちへの\nお手紙なんだよね！　えへへ、嬉しいなぁ～♪",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
