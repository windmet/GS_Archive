        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "貴殿が色々と相談に乗ってくれたことも、\n感謝している。改めて礼を言わせてくれ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
