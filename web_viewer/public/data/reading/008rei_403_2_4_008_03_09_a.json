      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ずっと練習してきたトリックを成功させた瞬間の、\nあの高揚感が胸に焼き付いて離れない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
