      "kind": "dialogue",
      "source_text": "これからも、新しい挑戦をする機会があれば、\n今回のことを思い出し、全力を尽くそう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
