        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "きっと選手たちも、こうした感動を胸に、\n挑戦を続けているのだろうな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
