    {
      "kind": "dialogue",
      "source_text": "言われなくても、気合いなら十分だよ。\n僕がいれば、今日のライブも大成功間違いなし！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
