      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それに、みんなで準備してきた衣装や曲を\nやっと披露できると思うと、心が躍るよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
