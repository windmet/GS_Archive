      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "朝から燃えてるね～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "002sht"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "002sht",
        "presence": "visible",
