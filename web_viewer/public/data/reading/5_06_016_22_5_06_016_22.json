        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん、ライブの演出とか、それ以外の企画もね！\nファンのみんな、どんな顔するかな～♪",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
