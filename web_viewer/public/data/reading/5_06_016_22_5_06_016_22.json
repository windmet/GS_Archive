    {
      "kind": "dialogue",
      "source_text": "……この日のために、みんなで準備してきたんだ。\n全員で力を合わせれば、必ず最高の時間になる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
