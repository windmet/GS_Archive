        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よし……いよいよ本番当日だな！\n翔太、北斗、気合い入れていくぞ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
