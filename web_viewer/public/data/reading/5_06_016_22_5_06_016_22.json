        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みんなでエンジェルちゃん、エンジェルくんたちを\n楽しませよう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
