    {
      "kind": "dialogue",
      "source_text": "C.FIRSTやみんなで作った曲だな。\nそれぞれ、今日に向けて挑戦をしてきたんだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
