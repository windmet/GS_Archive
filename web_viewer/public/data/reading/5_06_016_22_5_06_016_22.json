      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "どれも、315プロのアイドル全員で作り上げてきた\n大切なものだから、しっかり届けよう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
