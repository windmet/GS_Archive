      "kind": "dialogue",
      "source_text": "ステージ上では他のキャストとも踊る。誰かと\nぶつかるようなことがあってはならない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
