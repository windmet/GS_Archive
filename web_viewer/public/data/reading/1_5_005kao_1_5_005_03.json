    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー、もう少し練習を\nしたいんだが、レッスンスタジオは空いてるか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000032:dialogue:000",
