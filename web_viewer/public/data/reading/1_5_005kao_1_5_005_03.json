    {
      "kind": "dialogue",
      "source_text": "ああ、もうそんな時間だったか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
