    {
      "kind": "dialogue",
      "source_text": "共演者にはミュージカル経験者が多い。\n足を引っ張るわけにはいかないからな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000029:dialogue:000",
        "source": {
