    {
      "kind": "dialogue",
      "source_text": "ええ。ここが空いていますので、\n使っていただいて大丈夫ですよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000034:dialogue:000",
        "source": {
