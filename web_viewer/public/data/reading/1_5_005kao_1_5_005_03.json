        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ。ここが空いていますので、\n使っていただいて大丈夫ですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
