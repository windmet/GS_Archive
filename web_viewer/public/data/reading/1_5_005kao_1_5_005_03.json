      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "トレーナーの方から歌も演技も\n仕上がってきていると褒められていましたね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000025:dialogue:000",
        "source": {
