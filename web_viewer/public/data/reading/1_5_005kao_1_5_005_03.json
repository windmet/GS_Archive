    {
      "kind": "dialogue",
      "source_text": "共演者にはミュージカル経験者が多い。\n足を引っ張るわけにはいかないからな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "performance": {
        "entityType": "idol",
