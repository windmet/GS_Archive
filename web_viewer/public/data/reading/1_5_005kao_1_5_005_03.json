    {
      "kind": "dialogue",
      "source_text": "お疲れさまです、薫さん。\nそろそろレッスン終了の時間ですよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_03:1_5_005_03:cmd-000018:dialogue:000",
        "source": {
