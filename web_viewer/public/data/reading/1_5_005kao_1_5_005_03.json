    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー、もう少し練習を\nしたいんだが、レッスンスタジオは空いてるか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "005kao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "005kao",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_005kao_1_5_005_03:step-12:text",
