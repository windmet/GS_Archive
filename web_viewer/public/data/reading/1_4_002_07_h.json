          "end_step_index": 34,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "神楽さん、ドッキリ終了です！\nこのままネタばらしをお願いします。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "イヤホンの声"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_07_h:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "も、もう終わりなのか！？\nわたしはまだ一度も、都築さんを……！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_h:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_h:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……今、説明します。\n実は、今日ここに集まったのは……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_h:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふうん、『ドッキリ部門』だったんだね。\n全然気づかなかったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_h:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すみませんでした……。\nですが、これほど成功しないとは。不甲斐ない……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_h:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "麗さん、今回のテーマは『相手を驚かせること』\nではなく、『相手と絆を保てるか』ですから……。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_07_h:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうかもしれないが……わたしはこの件で、\nより都築さんという人が分からなくなった……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_h:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ひとまず二人とも、今日はお疲れさまでした。\n帰宅されたら、ゆっくり休んでくださいね！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_07_h:step-24:text",
        "step_id": 24,
        "step_index": 23,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "315プロダクションの皆さん、お疲れ様でしたー！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "イヤホンの声"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_07_h:step-26:text",
        "step_id": 26,
        "step_index": 25,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 25
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……男極『ドッキリ部門』、\nなんとか俺たちだけで終えられたな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "男極スタッフたち"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_07_h:step-31:text",
        "step_id": 31,
        "step_index": 30,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。今日も主催者が捕まらなくて、\nやはり男極は続けられないのかと思ったが……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "男極スタッフたち"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_07_h:step-33:text",
        "step_id": 33,
        "step_index": 32,
        "source_part_id": "1_4_002_07_h",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_h.json",
          "start_step_index": 0,
          "end_step_index": 34,
          "target_step_index": 32
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "大丈夫、俺たちだけでも何とかなる！\n大会終了まで頑張ろうぜ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "男極スタッフたち"
      },
      "inline_translation": null,
      "has_voice": false,
