  "rows": [
    {
      "kind": "dialogue",
      "source_text": "（姉様はあんなに褒めてくれたのに……！）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
