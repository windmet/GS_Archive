        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その方が一体感も出るだろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_003_22_5_06_003_22:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おおっそいつぁいいな！　これでバッチリ\n盛り上げられそうだぜ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "025suz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "025suz",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_003_22_5_06_003_22:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だが、この楽曲は315プロ全員で歌うものだからな。\nもっと幅広い要素を盛り込んだほうがいい。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_003_22_5_06_003_22:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それならよぉ、彩のみんなに相談するのはどうだ？\nさっき打ち合わせで事務所に来てたよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "025suz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "025suz",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 14
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_003_22_5_06_003_22:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "衆力功あり。あの3人なら俺たちとは違った視点の\nアイデアが出てきそうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
