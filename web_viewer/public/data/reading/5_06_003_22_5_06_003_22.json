        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うおおおお……！　もっとだ！\n浮かべ、ファンをぶち上げられるアイデア！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "025suz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "025suz",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
