      "source_text": "まさか、こんなにも有名な作品に出演できるなんて\n思わなかった。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000015:dialogue:000",
