    {
      "kind": "dialogue",
      "source_text": "あの日わたしが抱いた感動を\n観客に伝えられるように。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
