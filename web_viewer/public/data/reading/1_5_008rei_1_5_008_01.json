    {
      "kind": "dialogue",
      "source_text": "ああ、わたし自身も幼い頃に\n何度か見たことのある作品だ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
