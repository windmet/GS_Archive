    {
      "kind": "dialogue",
      "source_text": "知らない人はいないんじゃないかっていうぐらい\n有名なミュージカルですからね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_01:1_5_008_01:cmd-000018:dialogue:000",
