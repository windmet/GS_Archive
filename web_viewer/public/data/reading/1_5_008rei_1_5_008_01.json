        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "知らない人はいないんじゃないかっていうぐらい\n有名なミュージカルですからね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
