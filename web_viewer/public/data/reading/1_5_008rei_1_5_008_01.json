    {
      "kind": "dialogue",
      "source_text": "出演できることを光栄に思う。\nわたしも、最善を尽くそう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
