    {
      "kind": "dialogue",
      "source_text": "素晴らしいです、麗さん！\n私にできることがあればお手伝いをさせてください。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
