      "kind": "dialogue",
      "source_text": "自然が豊かで、\n景色がとても綺麗な場所なんだってー。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000037:dialogue:000",
