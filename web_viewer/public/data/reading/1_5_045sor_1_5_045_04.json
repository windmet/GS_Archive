          "command_index": 16,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:a91c6fdc71ec53ecd9811a9788e0c37ae5b0ef4f7d3e0e4c5ecd886e33741b0e"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "045sor",
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "045sor"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "045sor",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
