        "command_start": 23,
        "command_end": 23
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ううん。いつか行きたいなって思ってたけど、\nなかなか機会がなくてねー。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000028:dialogue:000",
        "source": {
