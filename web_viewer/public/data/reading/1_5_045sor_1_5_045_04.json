          "command_index": 21,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:6edc7536802b19ec8082168836e4cb1ac3f599e07dfc8554fa90bb45ac62c4e5"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
