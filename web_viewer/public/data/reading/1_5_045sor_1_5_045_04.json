    {
      "kind": "dialogue",
      "source_text": "だから仕事の話を聞いた時から、\n楽しみにしてたんだー。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000032:dialogue:000",
