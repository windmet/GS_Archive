        "command_start": 21,
        "command_end": 21
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "想楽さんはよく一人旅をされるんですよね？\n今回のロケ地には行ったことありますか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000023:dialogue:000",
        "source": {
