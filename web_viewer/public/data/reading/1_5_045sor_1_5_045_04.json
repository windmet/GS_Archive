        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさんも、\nきっと気に入るんじゃないかなー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "045sor"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "045sor",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
