    {
      "kind": "dialogue",
      "source_text": "いざゆかん心が躍る旅の道。\nもうすぐ収録現場に到着するねー。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_045sor_1_5_045_04:1_5_045_04:cmd-000016:dialogue:000",
        "source": {
          "scenario_id": "1_5_045sor_1_5_045_04",
