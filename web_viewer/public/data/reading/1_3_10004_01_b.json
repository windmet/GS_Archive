        "step_index": 23,
        "source_part_id": "1_3_10004_01_b",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ですが、『社会人同士のカップル』というテーマは、\n私よりも雨彦のほうが似合いそうですね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
