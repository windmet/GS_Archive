    {
      "kind": "dialogue",
      "source_text": "皆さんには商業施設内の各エリアが割り振られ、\nそこで動画を撮影するのですが……。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
