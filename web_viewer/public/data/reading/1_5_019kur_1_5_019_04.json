      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "少し苦戦しているように見えましたが、\n私に何かお手伝いできることはありませんか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
