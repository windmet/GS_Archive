      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "九郎さん、お疲れさまです。\n差し入れを持ってきたので、少し休憩しませんか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
