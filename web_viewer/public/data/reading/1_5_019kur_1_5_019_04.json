        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ですが、今はできなくとも\nできるようになるまで精進するのみ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
