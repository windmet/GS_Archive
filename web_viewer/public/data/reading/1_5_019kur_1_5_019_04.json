    {
      "kind": "dialogue",
      "source_text": "「貴様、何を言っているっ！？　我は決して……」\nうう、力み過ぎて噛んでしまいました……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
