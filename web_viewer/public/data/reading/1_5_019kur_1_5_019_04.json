    {
      "kind": "dialogue",
      "source_text": "「貴様、何を言っているっ！？　我は決して……」\nうう、力み過ぎて噛んでしまいました……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_04:1_5_019_04:cmd-000032:dialogue:000",
