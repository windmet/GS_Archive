      "source_text": "●●●●プロデューサーさん……。\nそうですね、ありがとうございます。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
