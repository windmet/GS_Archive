    {
      "kind": "dialogue",
      "source_text": "クライアントが是非、一希さんを\nイメージキャラクターにと仰っていたんですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
