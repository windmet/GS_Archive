        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こちらこそありがとうございます。……ところで、\n俺たちにオファーした理由を聞いてもいいですか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
