        "step_index": 6,
        "source_part_id": "1_3_30009_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。皆さんは元公務員という異色の経歴をお持ち\nですよね。そのイメージと皆さんのお人柄があり、",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "編集者"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
        "reason": "unresolved-performance-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "unresolved-performance-actor"
      ],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_3_30009_01_c:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_3_30009_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "私共の雑誌の誌上アンケートでも度々、\n頼りがいのある彼氏として名前が挙がっていました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "編集者"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
        "reason": "unresolved-performance-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "unresolved-performance-actor"
      ],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_3_30009_01_c:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_3_30009_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そこで、そんな皆さんの頼りがいにスポットを当てて\n特集が出来たらと思い、お声がけした次第です。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "編集者"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
        "reason": "unresolved-performance-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "unresolved-performance-actor"
      ],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
