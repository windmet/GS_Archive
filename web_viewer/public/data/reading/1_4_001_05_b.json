          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……俺たちのステージも中止か。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_05_b:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_05_b",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_b.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "観客を危険な目にあわせられないからな。\nこればかりは仕方ない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
