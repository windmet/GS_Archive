      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "土砂降りっスね……。\n朝はあんな青空だったのに。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
