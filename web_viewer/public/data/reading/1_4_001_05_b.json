          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "inline_translation": null,
      "has_voice": true,
