          "end_step_index": 30,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "主催者側からも正式に連絡がありました。\n本日のイベントは中止だそうです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_05_b:step-11:text",
