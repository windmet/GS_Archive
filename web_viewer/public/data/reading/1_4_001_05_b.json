          "end_step_index": 30,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もしかして泣いてんのか？\nくはは！　ダセー。ザコだな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
