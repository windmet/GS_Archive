          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "チッ……オイコラ、チビ！\nつまんねー顔してんじゃねーよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
