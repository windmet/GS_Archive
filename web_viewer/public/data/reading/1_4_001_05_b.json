          "end_step_index": 30,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はーっはっはっは！\n噂に違わず元気な若人たちだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "初老の男"
      },
      "inline_translation": null,
