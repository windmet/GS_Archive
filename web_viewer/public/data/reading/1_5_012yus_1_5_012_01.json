      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "さすが新スポーツブランド、力が入ってるって感じ！\n普通にオレも欲しいなー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "performance": {
        "entityType": "idol",
