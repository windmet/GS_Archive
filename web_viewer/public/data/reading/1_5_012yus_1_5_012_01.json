    {
      "kind": "dialogue",
      "source_text": "悠介さん、お疲れさまです。\n今、お時間大丈夫ですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
