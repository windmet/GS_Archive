      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、そちらのサンプルはスポンサーさんから\n悠介さんへ頂いたものですから、使ってください。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
