      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わっ！　このインナー、すっげー触り心地いい！\n通気性もめっちゃ良さそうだし……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "performance": {
        "entityType": "idol",
