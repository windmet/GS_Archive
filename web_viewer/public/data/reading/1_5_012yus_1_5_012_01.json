    {
      "kind": "dialogue",
      "source_text": "今度の……って、衣料メーカーのCMで使うやつ？\n楽しみにしてたんだー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "012yus"
      },
      "visual": {
