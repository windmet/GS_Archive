    {
      "kind": "dialogue",
      "source_text": "そろそろいいかな？\n今日の動画配信のタイトルを\n変更しておきますね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
