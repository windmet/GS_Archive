        "step_id": 15,
        "step_index": 14,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "全く、すっかり驚かされたぜ。\nサプライズで生配信なんて\n緊張したんだぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "014hid"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "014hid",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 17
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
