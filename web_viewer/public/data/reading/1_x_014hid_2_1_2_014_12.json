    {
      "kind": "dialogue",
      "source_text": "ペットボトルを開けた瞬間、\n炭酸がすごい勢いで噴き出した\nのには慌てましたが……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
