        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ケーキは死守したけどな。正直、\nあれが一番ビックリしたぜ。\n視聴者も盛り上がってたよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
