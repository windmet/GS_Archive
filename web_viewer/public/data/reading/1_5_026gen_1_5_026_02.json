    {
      "kind": "dialogue",
      "source_text": "生物、物理、歴史、大衆小説まで……。\nこれだけ集めるのは大変だっただろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
