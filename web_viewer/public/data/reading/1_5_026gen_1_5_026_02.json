    {
      "kind": "dialogue",
      "source_text": "危ねぇっ！　……ふう、危機一髪だったな。\n転ばなくてよかったぜ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_02:1_5_026_02:cmd-000023:dialogue:000",
