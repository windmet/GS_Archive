    {
      "kind": "dialogue",
      "source_text": "げ、玄武さん……。\nよかったら、この本を……わわっ！？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_02:1_5_026_02:cmd-000013:dialogue:000",
