    {
      "kind": "dialogue",
      "source_text": "す、すみません、手を貸していただいて……。\nありがとうございます。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_02:1_5_026_02:cmd-000025:dialogue:000",
