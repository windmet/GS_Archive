        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こっ……この演出は、なんと素晴らしいあいであ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "猫柳 キリオ"
