      "kind": "dialogue",
      "source_text": "ええ。舞台に立つ日が、\n今から楽しみで仕方ないわね。",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_004_22_5_06_004_22:5_06_004_22:cmd-000117:dialogue:000",
