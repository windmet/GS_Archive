        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ。舞台に立つ日が、\n今から楽しみで仕方ないわね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
