  "rows": [
    {
      "kind": "dialogue",
      "source_text": "……ねえ、●●●●プロデューサーさん。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-3:text",
        "step_id": 3,
