          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 2
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちは、アイドルとして、人として、\nまだまだ未熟者かもしれないけれど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "どうかこれからも、\n成長を手助けしてくれると嬉しい。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "プロデューサーさんがいれば、\nきっと、どんなことでも乗り越えていけるから。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ、もちろんです。\nこれからも、一緒に頑張っていきましょう！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_06_j:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "数日後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_06_j:step-15:caption",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "懐かしいな、この手紙。\nまさか本当に出てくるとは。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（……『親にとって、子供はいつまでも子供』か）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（それはきっと、逆も同じなんだろう。\n子供にとって、親は代わりのない存在だ）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（だからこそ俺は、こんなにも自分のことを\n分かってほしいと感じているんだろうな……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「もっと俺を理解してほしいのに」……ん？\nこの続き、空白になっているな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（どうせ分かってもらえないと、\n途中で投げだしたんだろうか……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-27:text",
        "step_id": 27,
        "step_index": 26,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……よし。今の俺が続きを書いてみるか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-29:text",
        "step_id": 29,
        "step_index": 28,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「もっと俺を理解してほしい……\nいや、いつかは理解してもらいます！」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-31:text",
        "step_id": 31,
        "step_index": 30,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「あなた達に認めてもらえるくらい、\nもっと大きく成長して……」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_j:step-33:text",
        "step_id": 33,
        "step_index": 32,
        "source_part_id": "1_4_001_06_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_j.json",
          "start_step_index": 0,
          "end_step_index": 36,
          "target_step_index": 32
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（……そうだ。いつか来る、その時の為に。\n俺はここで、たくさん成長してみせるよ）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
