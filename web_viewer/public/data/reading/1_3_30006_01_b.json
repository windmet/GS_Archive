        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、ステージだけじゃなくて、撮影セットの裏側を\n映してみるのも面白いかもしれないです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
