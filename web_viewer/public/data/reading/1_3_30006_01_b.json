    {
      "kind": "dialogue",
      "source_text": "改めての確認となりますが、衣裳部屋と\nMV撮影時のスタジオでいいでしょうか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
