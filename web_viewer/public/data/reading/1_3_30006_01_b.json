      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ほう、いい案だな。俺はやってみても\nいいんじゃないかと思うが、みんなはどうだい？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
