        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "道流さんの料理、私も楽しみです。\n他にも何か必要なものがあれば言ってくださいね！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
