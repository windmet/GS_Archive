    {
      "kind": "dialogue",
      "source_text": "内臓はすべて取り除いてありますので、ご安心を。\n海の幸の魅力を、存分にお楽しみください。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
        "entityType": "idol",
