        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちなみにつぶ貝の唾液腺には、テトラミンという\n毒素が含まれていることがありますが……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
