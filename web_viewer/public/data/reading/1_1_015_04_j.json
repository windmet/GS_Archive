    {
      "kind": "dialogue",
      "source_text": "地中海風パエリアに、タイの洋風煮付け。つぶ貝の\nアヒージョに、カツオのカルパッチョになります。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
