        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "やはり、君のプロデュースには間違いがないな。\n年が明けても変わらず、君の働きに感謝している。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "performance": {
        "entityType": "idol",
