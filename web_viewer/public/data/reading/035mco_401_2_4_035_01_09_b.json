    {
      "kind": "dialogue",
      "source_text": "こちらこそ。円滑な仕事は\n互いの信頼関係あってこそだろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
