        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それじゃ、僕たちの意見がまとまり次第、\n他のユニットに話を聞きに行こっか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
