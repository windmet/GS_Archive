        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "へぇ、事務所のみんなで曲を作るんだ。……前から\n試したかったこと、取り入れられるかな……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "047shu"
      },
      "visual": {
