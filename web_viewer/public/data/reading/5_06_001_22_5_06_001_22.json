        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（僕も、いいアイデアを思い付けたら、\nぴぃちゃんに言ってみようかな……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "048mom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "048mom",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
