        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "秀、ずいぶん考え込んでいるな。\n俺に手伝えることがあれば言ってくれ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "049eis"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "049eis",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_001_22_5_06_001_22:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ありがとうございます。っていっても、\n今は色々浮かびすぎて、頼める状態じゃないんで……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
