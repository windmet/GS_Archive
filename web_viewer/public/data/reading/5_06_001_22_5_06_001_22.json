    {
      "kind": "dialogue",
      "source_text": "秀、ずいぶん考え込んでいるな。\n俺に手伝えることがあれば言ってくれ。",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_001_22_5_06_001_22:5_06_001_22:cmd-000067:dialogue:000",
