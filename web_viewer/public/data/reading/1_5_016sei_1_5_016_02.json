    {
      "kind": "dialogue",
      "source_text": "誠司さん、準備は大丈夫ですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_016sei_1_5_016_02:1_5_016_02:cmd-000014:dialogue:000",
