    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさん！　それがクールな\n先輩って役がどうしてもイメージ掴めなくてさ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
