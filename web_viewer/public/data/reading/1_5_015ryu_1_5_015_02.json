        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "何か悩み事ですか？\nもし良ければ相談に乗りますよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
