      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なるほど……。それなら身近な人から\nイメージを見つけてみるのはどうですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
