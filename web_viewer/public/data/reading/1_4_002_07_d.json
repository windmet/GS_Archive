        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あっ、いえ。\n手紙の内容について、少し考えていました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
