      "kind": "dialogue",
      "source_text": "（麗さん、落ち着いて。頑張ってください！）",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
