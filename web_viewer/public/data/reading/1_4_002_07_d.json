          "end_step_index": 18,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（メンバーにいくらイタズラされても、\n絆を保てるかどうかを競い合う……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
