        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルとして、このエンジェルちゃんに\n届ける一番いいメッセージはどんな言葉かなって。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
