    {
      "kind": "dialogue",
      "source_text": "それで北斗は、何か考えてることはあるのか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
