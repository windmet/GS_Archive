    {
      "kind": "dialogue",
      "source_text": "すごい……なんで今まで見てこなかったんだろ。\nこれ見たら、今後他の作品を見る目も変わりますよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
