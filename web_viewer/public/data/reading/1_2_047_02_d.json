        "step_index": 5,
        "source_part_id": "1_2_047_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺も見始める前は、先輩たちに失敗させたんじゃないか\nってドキドキしました。で、その演出っていうのは……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
