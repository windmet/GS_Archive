        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "えー。アマミネくんに感想言うの、怖いなぁ。\n何か間違ったこと言っちゃうかもしれないし……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "performance": {
        "entityType": "idol",
