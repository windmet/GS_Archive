        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_047_02_d:step-9:text",
