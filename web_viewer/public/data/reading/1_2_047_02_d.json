        "step_index": 21,
        "source_part_id": "1_2_047_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いや、感想に間違いとかないですよ。\n俺、百々人先輩に、思ったまま話をしてほしいです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
