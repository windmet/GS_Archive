        "step_index": 8,
        "source_part_id": "1_2_047_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すまない、俺ばかり話しているな。\n百々人、秀、お前たちの意見はどうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "performance": {
        "entityType": "idol",
