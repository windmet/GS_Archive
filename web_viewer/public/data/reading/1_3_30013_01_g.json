    {
      "kind": "dialogue",
      "source_text": "そしてその旅に、ケーキを愛する\n巻緒さんがいてくれたら、心強いと思いまして。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
