        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "了解した。それにしても、今回改めて勉強してみて、\nニュース用語の多さには驚かされた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
