      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "英雄さんと誠司さんは、どうでした？\n学生時代にニュースとか新聞とか見てましたか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
