    {
      "kind": "dialogue",
      "source_text": "意識してニュースを見るようにもなったし……。\n学生時代の自分が知ったら、びっくりするだろうな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
