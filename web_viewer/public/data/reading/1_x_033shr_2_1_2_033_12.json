    {
      "kind": "synopsis",
      "source_text": "もうすぐ誕生日を迎える志狼。きっと自分\nの誕生日会が計画されているのだろうと\n直央たちの動向をこっそり探るが、全く\nその気配は無い。至っていつも通りの\nみんなの様子に志狼は肩を落とすが……。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
