        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "サプライズが無事に成功して\n本当にほっとしたよ。\nしろうくん、楽しんでくれた？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "performance": {
        "entityType": "idol",
