        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "しろうくん、もしかして\nお誕生日パーティのこと\n気がついてるのかな……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 4
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_033shr_2_1_2_033_12:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "パーティを開くことは\n気付いていそうだけど、\n内容まではきっとバレてないよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "032nao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "032nao",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_033shr_2_1_2_033_12:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "じゃあ、しろうくんが\n想像してるより、もーっと\nすごいパーティにしようね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_033shr_2_1_2_033_12:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん、そうだね。\nとびきり『ビッグ』な\nパーティにしよう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "032nao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "032nao",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_033shr_2_1_2_033_12:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふっ♪\nしろうくんにぴったりな\n『ビッグ』なパーティ、だね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
