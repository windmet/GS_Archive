        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "しろうくんにそう言ってもらえる\nなんて……嬉しいな。\n頑張ったかいがあったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "performance": {
