        "step_id": 8,
        "step_index": 7,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あーあ、あんなにいっぱい\n探ってたのに、パーティのこと\nぜんっぜん気付かなかったぜー！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "033shr"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "033shr",
        "presence": "visible",
