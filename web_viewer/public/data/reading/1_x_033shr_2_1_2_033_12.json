        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なお、おまえ。かのんの時より\nさらに知らないフリが\n上手くなったんじゃね？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "033shr"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "033shr",
        "presence": "visible",
