        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "正直、メールの量に驚きました。\nみんな、それぞれ悩みを抱えているんですね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
