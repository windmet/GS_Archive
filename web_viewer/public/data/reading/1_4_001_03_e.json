          "end_step_index": 57,
          "target_step_index": 2
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それ、こないだのライブ動画っすか？　……って、\nえええ！？　再生数、メガ伸びてるじゃないっすか！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
