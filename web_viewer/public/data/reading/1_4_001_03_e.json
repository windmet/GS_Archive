          "end_step_index": 57,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "優雅というか、オレらと一気に方向性変わったな。\nでも、ナツキっぽいし、いいか！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "inline_translation": null,
