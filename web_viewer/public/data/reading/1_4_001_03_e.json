          "start_step_index": 0,
          "end_step_index": 57,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "う、えっと……。\nじゃあ、『バイオリンで一曲』……とか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
      },
      "inline_translation": null,
      "has_voice": true,
