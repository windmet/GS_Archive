    {
      "kind": "dialogue",
      "source_text": "お、伸びてる伸びてる……。\n●●●●プロデューサーも見てよ、これ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
