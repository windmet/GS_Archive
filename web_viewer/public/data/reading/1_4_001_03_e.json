      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "広島にいるジイさんたちが、\nワシの動画に気づいたらしくてのぉ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
