        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_01:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "パーソナリティーの方が翔真さんの\n知り合いだったなんて、こんな偶然あるんですね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_01:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ほんとよ。芸名だけじゃなくて\n雰囲気も変わってたから、全然気づかなかった。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_01:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そういえば、あの方も翔真さんが\nアイドルになっていたことに驚いていましたね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_01:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "事前撮影のために、着ていたこの衣装も\n違和感ないって驚いてたじゃない？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_01:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "このネタで、ちょいとからかってやろうかしら♪",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_01:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": null,
