    {
      "kind": "dialogue",
      "source_text": "さっきのラジオ番組の打ち合わせ、驚いちゃったわ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
