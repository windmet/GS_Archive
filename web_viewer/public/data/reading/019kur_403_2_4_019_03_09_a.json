        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "着慣れなかった服装も、段々と馴染んできて……。\n今は、自分でも気に入っています。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
