        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "オレのバランス感覚の良さは、よく知ってんだろ。\nよっと……ほら、大丈夫だったじゃん！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
