      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "気を抜くなよ、悠介！\nちゃんと前を見ろって。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
