          "start_step_index": 0,
          "end_step_index": 29,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はいはい。それじゃ、次は俺の番だな。\nよっ……。よし、クリアっと。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
