      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "見ろよ、享介！　2位ともうこんなに差がついてる。\nオレたち、ぶっちぎりでトップだぜ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
