        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（……うん。足の調子は大丈夫そうだ。\nこのまま悠介のペースに合わせれば……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
