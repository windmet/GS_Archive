          "start_step_index": 0,
          "end_step_index": 29,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今度の競技は……。1つのボールを、\n2人でドリブルしていけばいいのか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
