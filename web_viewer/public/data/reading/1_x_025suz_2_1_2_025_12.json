    {
      "kind": "dialogue",
      "source_text": "番長さんに呼び出しも頼んだ\nことだし、そろそろ朱雀が\n事務所に到着する頃合いか。",
      "text_ref": {
        "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000030:dialogue:000",
