    {
      "kind": "dialogue",
      "source_text": "味が変わるっていうより、\n生地がふかふかになるんだ。\nあれもなかなかよかったぜ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000079:dialogue:000",
