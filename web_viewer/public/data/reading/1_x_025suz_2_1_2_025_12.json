    {
      "kind": "dialogue",
      "source_text": "理想のパンケーキを作るまでに、\nいろんなレシピを試したぜ。\n例えば豆腐を入れたり……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000062:dialogue:000",
        "source": {
