        "source_part_id": "1_5_026_01",
        "source_file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
        "command_start": 29,
        "command_end": 29
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうだな、どれもよかったが……。\nこの眼鏡は特に気に入ってるぜ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000034:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
          "part_id": "1_5_026_01",
          "file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
          "command_index": 34,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:e5de51f9fc10a2a0d59194d9ca0edd6533f2215559c11d0b28a47011bcba2cfd"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "026gen",
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
