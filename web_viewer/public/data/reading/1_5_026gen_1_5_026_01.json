        "step_index": 8,
        "source_part_id": "1_5_026_01",
        "source_file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
        "command_start": 34,
        "command_end": 34
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "フレームが軽くて付け心地がよかった。\n形もいつもかけているモンと同じだしな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000038:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
