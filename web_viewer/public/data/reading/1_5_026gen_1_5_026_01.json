          "file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
          "command_index": 18,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:890e6dffcf078f39516ead5845dc11edabfd97a24fce4eb469fe59d779afae7f"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "026gen",
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
