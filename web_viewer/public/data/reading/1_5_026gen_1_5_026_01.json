    {
      "kind": "dialogue",
      "source_text": "はは、そうかい。見慣れてるってのもあると思うが、\nそう言われるのは悪い気がしねぇ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000045:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
