        "command_start": 25,
        "command_end": 25
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい！　撮影では様々な種類の眼鏡をかけますが、\n玄武さんが気に入ったものはありましたか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000029:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
          "part_id": "1_5_026_01",
          "file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
          "command_index": 29,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:0978bc78f68a7531851904ebb24bfd4acfee5e3e2632425f24a2563ee7070bb6"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
