          "command_index": 25,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:6bfbdcf271c76f93481f43df790455123b1aca279d669c819a1d06f82b229ccc"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "026gen",
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
