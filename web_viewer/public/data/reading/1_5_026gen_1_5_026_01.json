        "command_start": 18,
        "command_end": 18
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "しかも有名ブランドのCMだ。ヘマは許されねぇ。\n緊褌一番、最後まで気を引き締めていくぜ！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000025:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
