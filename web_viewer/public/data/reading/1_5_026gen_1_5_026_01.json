        "source_hash": "sha256:16369d74e55002ec3170c1163cc682fd773b0be9206d3f39ca29483cc42b164d"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "026gen",
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
