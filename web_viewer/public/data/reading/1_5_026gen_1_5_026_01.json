          "field_ordinal": 0
        },
        "source_hash": "sha256:fe130def6414e320e2c5dccd3840a40d298ebf11eba22d013dd4d6d7c27b7b09"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "026gen",
        "sourceName": "黒野 玄武"
      },
      "performance": {
