        "command_end": 38
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "どの眼鏡も似合っていましたが、\nその形の眼鏡もとても似合っていますよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000041:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
