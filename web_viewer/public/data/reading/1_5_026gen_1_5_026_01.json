    {
      "kind": "dialogue",
      "source_text": "玄武さん、リハーサルお疲れさまでした！\n監督もイメージ通りだとおっしゃっていましたよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000014:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
          "part_id": "1_5_026_01",
          "file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
          "command_index": 14,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:f0fb065b85d36bffb5616c666a97cdd874ea8f4dad379189333d1358de46d5fc"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_026gen_1_5_026_01:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_5_026_01",
        "source_file": "assets/resources/scenariodata/1_5_026gen/scenario_1_5_026_01.json",
        "command_start": 14,
        "command_end": 14
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そいつはよかった。\nCMはイメージが何より大事だからな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_01:1_5_026_01:cmd-000018:dialogue:000",
        "source": {
          "scenario_id": "1_5_026gen_1_5_026_01",
