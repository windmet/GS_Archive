      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "白米以外にもお赤飯、五目御飯……\nそれに大盛りサイズまで！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
        "entityType": "idol",
