    {
      "kind": "dialogue",
      "source_text": "ここの商品はどれも炊き立てと同じくらい\nおいしいんですよね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
