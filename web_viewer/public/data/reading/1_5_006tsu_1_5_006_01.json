    {
      "kind": "dialogue",
      "source_text": "今度っていうとご飯パックの……ということは、\n●●●●プロデューサー、すごいです！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
