    {
      "kind": "dialogue",
      "source_text": "今日のCM撮影に備えて、いただいたサンプルで\nお菓子を作ってみたんです！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
