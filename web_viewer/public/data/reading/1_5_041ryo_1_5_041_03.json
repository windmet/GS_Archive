      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "パッケージに書いてあったんですけど\n色々アレンジもできるみたいなんですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
