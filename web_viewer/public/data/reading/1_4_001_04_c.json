          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "撮影後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_c:step-14:caption",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさん、どうしたのー？\nなんだか嬉しそうだけどー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_c:step-17:text",
        "step_id": 17,
        "step_index": 16,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "実は『お掃除解決隊』のメンバーに急遽、\n欠員が出たとのことで……",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_c:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ピンチヒッターを選ぶオーディションを、\n明日開催するそうなんです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_c:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そこで……もしよければ3人も参加しないかと、\nご連絡がありました！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_c:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "オーディション……それは、願ってもない話だな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_c:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "明日っていうのは急だけど、\nそれでも、断る理由はないよねー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_c:step-24:text",
        "step_id": 24,
        "step_index": 23,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お断りなど、するはずがありません！\nこれは315プロダクションにとって……何より、",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_c:step-25:text",
        "step_id": 25,
