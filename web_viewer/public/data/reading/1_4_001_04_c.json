          "end_step_index": 25,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "我々Legendersにとって、大きなチャンスです！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
