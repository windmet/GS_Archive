    {
      "kind": "dialogue",
      "source_text": "（撮影は順調だ。皆さん、お仕事にも\n少しずつ慣れたみたいで……おっと、電話が）",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_c:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_c.json",
          "start_step_index": 0,
          "end_step_index": 25,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……はい、本当ですか！　ありがとうございます！\n……早速、皆さんにお伝えしないと！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_c:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_001_04_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
