    {
      "kind": "dialogue",
      "source_text": "しかしこちら側が思いを込めれば\n相手に伝わるはずだ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000033:dialogue:000",
