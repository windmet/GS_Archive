      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルとしての歌も、ヴァイオリニストとしての\n演奏も上辺だけでは伝わらない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
