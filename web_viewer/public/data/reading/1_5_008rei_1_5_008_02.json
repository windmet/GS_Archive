          "command_index": 16,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:850a34dc01885dedd7b6f9b595fdc5bc2bc6e372d2f80a51bb86751088e30fad"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "008rei",
        "sourceName": "神楽 麗"
      },
      "performance": {
