    {
      "kind": "dialogue",
      "source_text": "自分が使ったことのあるメーカーとの仕事……\nそれも、イメージキャラクターに選ばれるとは。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000016:dialogue:000",
        "source": {
          "scenario_id": "1_5_008rei_1_5_008_02",
          "part_id": "1_5_008_02",
