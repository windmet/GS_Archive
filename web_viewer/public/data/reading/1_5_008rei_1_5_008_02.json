      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それは頼もしいです。\n使用した素直な感想が求められると思いますから。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000022:dialogue:000",
        "source": {
          "scenario_id": "1_5_008rei_1_5_008_02",
