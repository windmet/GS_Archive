    {
      "kind": "dialogue",
      "source_text": "自分が使ったことのあるメーカーとの仕事……\nそれも、イメージキャラクターに選ばれるとは。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
