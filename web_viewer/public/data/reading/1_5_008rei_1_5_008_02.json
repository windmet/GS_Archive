      "source_text": "しかしこちら側が思いを込めれば\n相手に伝わるはずだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
