        "command_start": 16,
        "command_end": 16
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "PRする商品も試したが、気に入った。\n多くの人に使ってもらえるよう、努めたい。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000020:dialogue:000",
        "source": {
          "scenario_id": "1_5_008rei_1_5_008_02",
          "part_id": "1_5_008_02",
          "file": "assets/resources/scenariodata/1_5_008rei/scenario_1_5_008_02.json",
          "command_index": 20,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:fb780af49e4eb0bde66a98e2c9ba56e1db78aef0d5f9bb76763d6d4c6aa1fbe4"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "008rei",
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
