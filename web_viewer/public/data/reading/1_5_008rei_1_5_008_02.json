    {
      "kind": "dialogue",
      "source_text": "上辺だけの言葉では説得力がないからな。\nそれは音楽と同じことだ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_02:1_5_008_02:cmd-000026:dialogue:000",
        "source": {
          "scenario_id": "1_5_008rei_1_5_008_02",
