    {
      "kind": "dialogue",
      "source_text": "動画を見返した時に、ライブ当日のわくわくした\n気持ちを思い出せるようなものがいいですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_011_22_5_06_011_22:5_06_011_22:cmd-000079:dialogue:000",
