      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん。撮る内容は俺たちが決めて良いそうだけど、\n何かやってみたいことはあるかい？",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_011_22_5_06_011_22:5_06_011_22:cmd-000064:dialogue:000",
        "source": {
