    {
      "kind": "dialogue",
      "source_text": "順番に回っていると時間がかかりますし、\n私たち5人で手分けして訪ねるのはどうでしょう？",
      "text_ref": {
        "unit_id": "story-text:v1:5_06_011_22_5_06_011_22:5_06_011_22:cmd-000129:dialogue:000",
        "source": {
