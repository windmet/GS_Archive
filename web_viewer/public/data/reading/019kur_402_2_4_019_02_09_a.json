    },
    {
      "kind": "dialogue",
      "source_text": "そう言っていただけると嬉しいです。\n練習に励んだ甲斐がありました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
