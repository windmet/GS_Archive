        "step_id": 37,
        "step_index": 36,
        "source_part_id": "1_4_002_09_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_09_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 36
        }
      },
      "option": {
        "choice_id": null,
        "option_id": null,
        "source_label": "phone_select1",
        "target_step_id": 38,
        "target_step_index": 37,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "そっか。遅くまで俺たちのために、ありがとね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_09_j:step-38:text",
        "step_id": 38,
        "step_index": 37,
        "source_part_id": "1_4_002_09_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_09_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 37
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そんで、そのライブなんだけど……。\n今、俺の周りに出たいっていう人が集まってるのよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_09_j:step-39:text",
        "step_id": 39,
        "step_index": 38,
        "source_part_id": "1_4_002_09_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_09_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 38
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちょっと待っててね。……はい、みんなー。\n電話の向こうにプロデューサーちゃんがいますよー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_09_j:step-40:text",
        "step_id": 40,
