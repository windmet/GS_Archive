          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 39
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ライブに出たいって人、返事してー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "inline_translation": null,
