        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
