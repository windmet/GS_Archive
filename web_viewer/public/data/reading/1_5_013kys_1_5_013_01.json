    {
      "kind": "dialogue",
      "source_text": "でも、どうしてホラー映画を見ることに\nなったんですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
