        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんでだったかな……。\n確か苦手を克服しようみたいな話だった気がする。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "013kys"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "013kys",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_013kys_1_5_013_01:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺も苦手なにんじんが入った料理を\n食べるはずだったんだけどさ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "013kys"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "013kys",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
