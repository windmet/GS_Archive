        "command_start": 29,
        "command_end": 29
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まぁ基本的なルールを知ってれば\nスポーツって楽しく見られるんだけどな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000033:dialogue:000",
        "source": {
          "scenario_id": "1_5_001tom_1_5_001_04",
