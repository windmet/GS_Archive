        "command_start": 25,
        "command_end": 25
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そう、そうなんだよ！\n絶対今までより楽しく見られる！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_001tom_1_5_001_04:1_5_001_04:cmd-000029:dialogue:000",
        "source": {
          "scenario_id": "1_5_001tom_1_5_001_04",
