        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まあ、そういうのがあってもいいかもね。\n台本をただなぞるだけじゃ、面白くないし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
