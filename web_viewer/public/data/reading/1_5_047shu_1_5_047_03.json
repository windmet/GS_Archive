      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、そうですね。\nトークテーマはくじで決めるそうです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000026:dialogue:000",
        "source": {
