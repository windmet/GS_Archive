        "command_start": 15,
        "command_end": 15
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺と同年代のアイドルだっけ。\n同じ事務所のヤツとは話すけど……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000019:dialogue:000",
        "source": {
