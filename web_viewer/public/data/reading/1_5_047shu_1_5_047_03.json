      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい、台本に書かれていないテーマが\nいくつかあるそうです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000033:dialogue:000",
