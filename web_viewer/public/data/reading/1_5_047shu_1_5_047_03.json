        },
        "source_hash": "sha256:5bbacebc4ef2b4ea0ac05e571ebd5768bd9a008800b15a7925f43104ff06b786"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "047shu",
        "sourceName": "天峰 秀"
      },
