    {
      "kind": "dialogue",
      "source_text": "本日はテレビ番組のゲストで、他の事務所の\nアイドルの方々と対談していただきます。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000015:dialogue:000",
        "source": {
          "scenario_id": "1_5_047shu_1_5_047_03",
