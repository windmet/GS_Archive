      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "他の事務所のヤツとがっつり話すのは、\nこういう機会じゃないとなかなかないよな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_047shu_1_5_047_03:1_5_047_03:cmd-000024:dialogue:000",
        "source": {
