        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "顔も覚えてねぇ。言ってなかったかもしれねぇが、\n俺は施設で育ったんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
