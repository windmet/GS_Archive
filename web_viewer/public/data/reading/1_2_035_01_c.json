    {
      "kind": "dialogue",
      "source_text": "そのため、インターネット上にある\n塾講師が上げた動画などを見て研究してきたのだが。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "performance": {
