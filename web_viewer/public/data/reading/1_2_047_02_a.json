        "step_index": 10,
        "source_part_id": "1_2_047_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ……天峰！　お前、今日が誕生日なんだろ？\nだから、みんなでプレゼント渡そうと思って……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "クラスメイトたち"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
        "reason": "unresolved-performance-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
