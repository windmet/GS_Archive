        "step_index": 7,
        "source_part_id": "1_2_047_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "プレゼントですか、ありがとうございます。\n……でも、なんで直接渡しに来ないんだろ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "047shu"
      },
      "visual": {
