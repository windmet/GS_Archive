        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "天峰って、気安く近寄れないオーラがあるからなぁ。\nほら、あの子たちも、声かけるタイミング伺ってるぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "先輩"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
