    {
      "kind": "dialogue",
      "source_text": "天峰、会議お疲れさん。それと誕生日おめでとう！\nこれ、俺のクラスの女子たちから預かってきた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "先輩"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
