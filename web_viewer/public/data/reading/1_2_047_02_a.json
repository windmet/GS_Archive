    {
      "kind": "dialogue",
      "source_text": "C.FIRSTの3人で、誕生日パーティするんだ。\n剣羽高の生徒会長、鋭心先輩の家に呼ばれてる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
