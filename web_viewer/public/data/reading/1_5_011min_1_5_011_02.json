        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あはは、ありがとう。\n●●●●プロデューサー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
