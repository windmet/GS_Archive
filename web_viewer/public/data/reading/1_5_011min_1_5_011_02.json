      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "011min",
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
