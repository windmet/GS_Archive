        },
        "source_hash": "sha256:d0262b1c707a8e7c74e092188ef653a82930c7108aa53046fce8e3961bf6612e"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "011min",
        "sourceName": "渡辺 みのり"
      },
      "performance": {
