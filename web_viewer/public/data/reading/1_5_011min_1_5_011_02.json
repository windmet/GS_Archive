        "command_start": 43,
        "command_end": 43
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "好きなことに熱くなれるのは素敵だと思います！\nその方向で一度、先方と相談してみましょう！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000045:dialogue:000",
        "source": {
          "scenario_id": "1_5_011min_1_5_011_02",
          "part_id": "1_5_011_02",
          "file": "assets/resources/scenariodata/1_5_011min/scenario_1_5_011_02.json",
          "command_index": 45,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
