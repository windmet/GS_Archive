      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ってごめん、つい熱くなっちゃった。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_011min_1_5_011_02:1_5_011_02:cmd-000043:dialogue:000",
        "source": {
          "scenario_id": "1_5_011min_1_5_011_02",
