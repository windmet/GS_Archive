        "step_index": 1,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よお、●●●●●●●●●●番長さん。\nちょっといいか？　話したいことがあってよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "実は、風の噂でLegendersがお掃除解決隊の\nオーディションを受けるって話を聞いてな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あの番組、意外と役に立つ情報が多いんだ。\nそれで俺も、よくチェックしてるんだが……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "特に、衣服のクリーニングに関する情報は\n毎回見逃せねえ。この前もな……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……っと、いけねえ。洗濯の話もいいが、\n今日は他に、伝えなきゃいけないことがあったんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "choice",
      "source_text": "もしかして\n玄武さんも応援を？",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-10:option-0",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 9
        }
      },
      "option": {
        "choice_id": null,
        "option_id": null,
        "source_label": "phone_select2",
        "target_step_id": 11,
        "target_step_index": 10,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "も、ってことは……ひょっとして、\n俺の他にも応援の電話をしたやつがいるのか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……ハハッ、なるほど。\n荘一郎アニさんも電話してたんだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんつうか、いいな。ウチの事務所は。\n本当に、熱い仲間が揃ってやがる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それじゃ、そろそろ切るぜ。合格したら、\n絶対に見るからよ。応援してるぜ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "オーディション会場",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-20:caption",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "やあやあ、よく来てくれたね！　ええっと、\n『Legenders』か……ふむふむ、なるほど。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "番組P"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それじゃあ早速質問していこうか。まずは君！　\nプロフィールには『元掃除屋』と書いてあるね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "番組P"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。今回の番組でも、\nその経験を活かせると思います。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-24:text",
        "step_id": 24,
        "step_index": 23,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アヤカシ清掃社というところに所属してまして。\nこの建物にも、前に清掃依頼で来たことが。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんと、あの知る人ぞ知る清掃会社にいたのか。\nなるほど。葛之葉クン、なかなかのやり手と見た！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "番組P"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-26:text",
        "step_id": 26,
        "step_index": 25,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 25
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それじゃ次は、隣の君！\n何か、掃除にまつわるエピソードはあるかい？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "番組P"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-29:text",
        "step_id": 29,
        "step_index": 28,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい、そうですね……掃除に関しては、\n人並みには気を配っているつもりです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-30:text",
        "step_id": 30,
        "step_index": 29,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふむふむ、人並みと。\nそれじゃ、隣の君は？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "番組P"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-31:text",
        "step_id": 31,
        "step_index": 30,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "僕も似たようなものですー。でも、\n普段から雨彦さんに色々教えてもらってましてー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-33:text",
        "step_id": 33,
        "step_index": 32,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 32
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "葛之葉クンの掃除テクニックは、かなりのもの\nみたいだね！　なるほど、詳しく話そうじゃないか！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "番組P"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_04_e:step-34:text",
        "step_id": 34,
        "step_index": 33,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうですね……例えば先日の放送で取り上げていた、\n汚れの種類についてですが……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_04_e:step-36:text",
        "step_id": 36,
        "step_index": 35,
        "source_part_id": "1_4_001_04_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_04_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 35
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うんうん、バッチリ分かったよ！\nそれじゃ、オーディションは以上！　ありがとうね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
