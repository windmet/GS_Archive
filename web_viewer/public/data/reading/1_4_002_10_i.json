          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だから、こう名乗るよ。\n俺たちは……男極FIVE！　みんな、出動だ！！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
