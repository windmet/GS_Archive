          "end_step_index": 34,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（そうとも。男極が、私たちに教えてくれた）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "inline_translation": null,
      "has_voice": true,
