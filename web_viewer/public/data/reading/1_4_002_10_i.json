      "kind": "dialogue",
      "source_text": "（アイドルの世界には、自分が何歳だろうと\n熱くなれる、面白いモンが転がってるってね）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "inline_translation": null,
