          "end_step_index": 34,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "道夫たち"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
