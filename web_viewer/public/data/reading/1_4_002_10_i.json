    {
      "kind": "dialogue",
      "source_text": "……確かに俺たちは、男極KINGでもなんでもない。\nでも、男極リーグのお陰で、成長したアイドルだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
