    {
      "kind": "dialogue",
      "source_text": "マキオが産声をあげし日がひと月後まで迫っている\nというのに、未だ事態は混迷したままか……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "029ass"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "029ass",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_030_02_a:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_2_030_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "やっぱり、もう一度本人に聞いてみようよ！\n何か悩んでるなら、力になりたいし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "031sak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "031sak",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
