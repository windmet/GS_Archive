      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "プロデューサーさんは、巻緒から\n何か聞いてないかな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
