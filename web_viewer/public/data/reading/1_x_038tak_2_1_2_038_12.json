        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "これからじゃんじゃん\nからあげを揚げるぞ！\n漣も手伝ってくれ。",
      "text_ref": null,
