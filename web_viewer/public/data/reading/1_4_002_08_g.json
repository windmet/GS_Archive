        "option_id": null,
        "source_label": "phone_select2",
        "target_step_id": 34,
        "target_step_index": 33,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "わかった！　……ん？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
