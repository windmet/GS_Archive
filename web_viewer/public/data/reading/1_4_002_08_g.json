        "option_id": null,
        "source_label": "phone_select1",
        "target_step_id": 32,
        "target_step_index": 31,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "え？　トイレとか、\n赤い屋根の建物が見えるよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_08_g:step-32:text",
        "step_id": 32,
        "step_index": 31,
        "source_part_id": "1_4_002_08_g",
        "source_file": null,
        "command_start": null,
