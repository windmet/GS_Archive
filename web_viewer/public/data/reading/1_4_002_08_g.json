        "playback": {
          "file": "episodes/1_4_002_08_g.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "choice",
      "source_text": "周りにどんなものが\nありますか？",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
