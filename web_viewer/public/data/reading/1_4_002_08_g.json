        "playback": {
          "file": "episodes/1_4_002_08_g.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 31
        }
      },
      "option": null
    },
    {
      "kind": "choice",
      "source_text": "赤い建物に向かって\n進んでみてください！",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
