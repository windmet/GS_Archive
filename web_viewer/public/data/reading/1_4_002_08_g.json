        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_08_g.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あっ、あの人だかり……お客さんたちだ！\nよかった、やっと合流できた！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
