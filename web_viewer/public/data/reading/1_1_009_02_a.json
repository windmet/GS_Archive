        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "たまにはいいさ。それにしても意外だったぜ。\nあの連中がああいう店を知っていたとは。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
