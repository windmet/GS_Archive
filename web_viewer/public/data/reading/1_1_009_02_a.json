    {
      "kind": "dialogue",
      "source_text": "ヘヘッ、玄武、\n今日はオレに付き合ってくれて、ありがとよっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
