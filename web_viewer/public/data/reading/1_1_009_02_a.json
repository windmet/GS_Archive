      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、いちゃもんつけられた時にゃ、\nどうなることかと思ったけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
