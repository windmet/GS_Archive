          "end_step_index": 43,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（……そうだ。自分にも、まだまだ\nみんなの力になれることがあるはずだ！）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_a:step-41:text",
        "step_id": 41,
        "step_index": 40,
        "source_part_id": "1_4_002_10_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_a.json",
          "start_step_index": 0,
          "end_step_index": 43,
          "target_step_index": 40
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさん！\nその衣装のお直し、自分に任せてくれないか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_a:step-43:text",
        "step_id": 43,
        "step_index": 42,
        "source_part_id": "1_4_002_10_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
