          "start_step_index": 0,
          "end_step_index": 43,
          "target_step_index": 42
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それと……お直しだけでなく、\n少し手を加えてもいいだろうか？　例えば……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
