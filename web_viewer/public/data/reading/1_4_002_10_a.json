    {
      "kind": "synopsis",
      "source_text": "元・男極リーグの主催者が開催する、\n大型ライブに出演することになった5人。\n相手側の妨害を想定し、\n各自がとった『対策』とは……。そして、\nライブ当日、いよいよ決戦の時を迎える。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
