        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……。まずは、俺からいいかな？\n当日の移動について、ひとつ提案があるんだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
