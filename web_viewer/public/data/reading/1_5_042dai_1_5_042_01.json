      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わかってますよ。大吾さんはいつでも\nどんな仕事でも一生懸命ですからね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000030:dialogue:000",
