      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "しかもワシの好きな格闘ゲーム！\nいつも以上にやる気がみなぎるってもんじゃ！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000022:dialogue:000",
        "source": {
