      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、もちろんどんな仕事もやる気満々じゃけぇ、\nそこは誤解せんでくれ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_01:1_5_042_01:cmd-000028:dialogue:000",
