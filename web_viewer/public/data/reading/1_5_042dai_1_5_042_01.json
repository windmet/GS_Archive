        "kind": "idol",
        "entityType": "idol",
        "entityId": "042dai",
        "sourceName": "兜 大吾"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "042dai"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "042dai",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
