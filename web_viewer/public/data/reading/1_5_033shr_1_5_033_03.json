    {
      "kind": "dialogue",
      "source_text": "いろんな職業が体験できるテーマパークなんだよな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_033shr_1_5_033_03:1_5_033_03:cmd-000020:dialogue:000",
