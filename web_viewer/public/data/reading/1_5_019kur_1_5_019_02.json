        "command_start": 27,
        "command_end": 27
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まさに湯治をするにはうってつけの温泉でしょう。\n……今の説明、いかがでしたでしょうか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000035:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
