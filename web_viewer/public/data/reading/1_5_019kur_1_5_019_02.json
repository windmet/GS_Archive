        "command_start": 16,
        "command_end": 16
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "心得ております。本日紹介する場所は、\n知る人ぞ知る絶景スポットです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000019:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
