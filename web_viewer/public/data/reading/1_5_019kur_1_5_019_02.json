      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "夕日が湖に沈む姿は圧巻の一言で、\n見る者の目を奪うほど美しく……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000024:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
