        "command_start": 14,
        "command_end": 14
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "九郎さんにはロケ地に行き、日本の美しい景色と\n温泉を紹介していただきます。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000016:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
          "part_id": "1_5_019_02",
          "file": "assets/resources/scenariodata/1_5_019kur/scenario_1_5_019_02.json",
          "command_index": 16,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:77fcd4daeb4d6402678bed724622ad2f47f82002118e31b19acab269e787f32b"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
