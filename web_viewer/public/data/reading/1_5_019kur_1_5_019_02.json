        "command_start": 35,
        "command_end": 35
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "とてもわかりやすくて、よかったです！\n実際に行ってみたくなるような紹介でした。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000037:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
          "part_id": "1_5_019_02",
          "file": "assets/resources/scenariodata/1_5_019kur/scenario_1_5_019_02.json",
          "command_index": 37,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:96fa8f54f4ad5fb4801277e257214a5178050ee93c22f231a3772475096f7740"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [],
