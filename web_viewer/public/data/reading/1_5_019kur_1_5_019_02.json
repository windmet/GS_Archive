    {
      "kind": "dialogue",
      "source_text": "今日のお仕事は、情報バラエティ番組の\n収録になります。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000014:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
          "part_id": "1_5_019_02",
          "file": "assets/resources/scenariodata/1_5_019kur/scenario_1_5_019_02.json",
          "command_index": 14,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:8a43988a90448ef4a581e2d0bcb7959f9518de26d2c02c42b5da3a46dd910d11"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
