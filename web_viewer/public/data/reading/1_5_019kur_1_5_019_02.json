        "command_start": 37,
        "command_end": 37
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、よかったです。本番では\nその場で感じたことも交えて伝えたいと思います。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000042:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
          "part_id": "1_5_019_02",
          "file": "assets/resources/scenariodata/1_5_019kur/scenario_1_5_019_02.json",
          "command_index": 42,
          "field_kind": "dialogue",
