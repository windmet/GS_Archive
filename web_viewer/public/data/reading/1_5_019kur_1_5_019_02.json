      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "温泉につきましても、源泉には様々な効能があり\nかつ自然豊かな場所にあります。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_02:1_5_019_02:cmd-000027:dialogue:000",
        "source": {
          "scenario_id": "1_5_019kur_1_5_019_02",
