        },
        "source_hash": "sha256:84721b179ded058df76dd9c4397ffff4af073003e949685d2c790b792d1e7da6"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "019kur",
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "019kur"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "019kur",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
