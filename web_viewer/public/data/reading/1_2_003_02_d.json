    {
      "kind": "dialogue",
      "source_text": "了解。冬馬の作ってるそれは……ブーケサラダだね。\nそういうのも作るなんて、意外だな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
