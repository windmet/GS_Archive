      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あはは、北斗君って変わってるな～。\nあ、この揚げ物おいしー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
