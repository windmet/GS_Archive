    {
      "kind": "dialogue",
      "source_text": "冬馬君、今日のために色々調べてくれたんだよね～？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
