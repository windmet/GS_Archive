      "kind": "dialogue",
      "source_text": "最高ランクを目指して、先生たちと一緒に挑戦\nしたところが褒められとったのも、嬉しくてのぉ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
