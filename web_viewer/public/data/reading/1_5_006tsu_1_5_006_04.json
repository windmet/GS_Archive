    {
      "kind": "dialogue",
      "source_text": "はい。モノトーンがテーマなので、\n衣装もシンプルなものが多いですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_006tsu_1_5_006_04:1_5_006_04:cmd-000023:dialogue:000",
