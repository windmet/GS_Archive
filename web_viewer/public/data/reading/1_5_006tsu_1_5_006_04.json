    {
      "kind": "dialogue",
      "source_text": "翼さん、今度のお仕事の資料が届きましたので\nお渡ししますね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
