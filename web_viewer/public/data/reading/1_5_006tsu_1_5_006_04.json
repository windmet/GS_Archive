    {
      "kind": "dialogue",
      "source_text": "翼さん、今度のお仕事の資料が届きましたので\nお渡ししますね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_006tsu_1_5_006_04:1_5_006_04:cmd-000015:dialogue:000",
        "source": {
