    {
      "kind": "dialogue",
      "source_text": "ありがとうございます。\nこれ、衣装のイメージですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_006tsu_1_5_006_04:1_5_006_04:cmd-000021:dialogue:000",
