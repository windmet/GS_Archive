        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ファッション誌を見たみんなに、\nこの服が欲しいと思ってもらえるよう頑張ります！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "006tsu"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "006tsu",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_006tsu_1_5_006_04:step-11:text",
