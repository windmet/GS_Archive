    {
      "kind": "dialogue",
      "source_text": "ありがとうございます。とっても心強いです。\nまずはこの洋服のブランドのこと調べてみますね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
