        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ありがとうございます。\nこれ、衣装のイメージですか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "006tsu"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "006tsu",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
