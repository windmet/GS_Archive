      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_006tsu_1_5_006_04:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。モノトーンがテーマなので、\n衣装もシンプルなものが多いですね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
