    {
      "kind": "dialogue",
      "source_text": "「えっ……旅先の兄さんから手紙？\n久しぶりだな、嬉しいな！」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
