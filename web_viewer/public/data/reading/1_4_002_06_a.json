    {
      "kind": "dialogue",
      "source_text": "あっ、そっか～。歩き方とか走り方も気をつけなきゃ\nダメだよね。それじゃ、うーんと……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_002_06:1_4_002_06_a:cmd-000084:dialogue:000",
        "source": {
          "scenario_id": "1_4_002_06",
