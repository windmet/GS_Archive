    {
      "kind": "dialogue",
      "source_text": "ええ。他の参加ユニットも、\nみなさんと同じ台本と役を、当日番組で演じます。",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_002_06:1_4_002_06_a:cmd-000102:dialogue:000",
        "source": {
          "scenario_id": "1_4_002_06",
          "part_id": "1_4_002_06_a",
