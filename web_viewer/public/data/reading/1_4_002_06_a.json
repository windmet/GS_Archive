        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_a:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "かのんくん。ボクたちの役は『昔の王子様』だから、\nもうすこし動き方も意識したら、もっとよくなるよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "032nao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "032nao",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 15
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_a:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あっ、そっか～。歩き方とか走り方も気をつけなきゃ\nダメだよね。それじゃ、うーんと……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 16
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_a:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なあ、●●●●プロデューサー。\n今度の演技部門って、みんな同じ台本なんだよな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "033shr"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "033shr",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 19
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_a:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ。他の参加ユニットも、\nみなさんと同じ台本と役を、当日番組で演じます。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 20
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_06_a:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "全員同じ条件で、衣装やヘアメイクも無し。\n純粋な演技力だけで戦ってほしいそうです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 21
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_06_a:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ぷう～。かのん、王子様の衣装が着たかったなぁー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 24
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_a:step-24:text",
        "step_id": 24,
        "step_index": 23,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "キュートな王子様の衣装を用意してくれたら、\nもっともーっと頑張れたのにな～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 25
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_a:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_002_06_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ。衣装がなくても\n王子様に見えるように頑張ろうね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "032nao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "032nao",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 26
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
