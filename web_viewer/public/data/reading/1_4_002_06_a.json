    {
      "kind": "dialogue",
      "source_text": "「えっ……旅先の兄さんから手紙？\n久しぶりだな、嬉しいな！」",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_002_06:1_4_002_06_a:cmd-000039:dialogue:000",
        "source": {
