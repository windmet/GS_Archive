      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。収録時間が押さなければ\n夕方で終わりの予定です。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
