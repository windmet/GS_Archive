      "kind": "dialogue",
      "source_text": "山に囲まれてるからもしかしてと思ってさ。\n今日の収録、そんなに遅くならなかったよな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
