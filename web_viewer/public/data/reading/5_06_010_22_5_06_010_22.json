    {
      "kind": "dialogue",
      "source_text": "我々の案がまとまったら、明日の合同練習で\nプロデューサーや皆に話をしてみよう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
