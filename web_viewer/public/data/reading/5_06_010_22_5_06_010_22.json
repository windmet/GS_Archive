    {
      "kind": "dialogue",
      "source_text": "元気出して、ミスターやました！\n今回のliveは、何事もchallengeが大切だよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "舞田 類"
      },
      "performance": {
