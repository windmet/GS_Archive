    {
      "kind": "dialogue",
      "source_text": "今度のliveに向けて、みんなで\ncountdown企画をやるのはどうだい？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "舞田 類"
      },
