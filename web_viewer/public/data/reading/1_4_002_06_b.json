          "start_step_index": 0,
          "end_step_index": 17,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なあなあ、しゅうたちが行ってる高校って、\nどんなとこなんだ？　教えてくれよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
