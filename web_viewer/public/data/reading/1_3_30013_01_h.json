    {
      "kind": "dialogue",
      "source_text": "ほう、これは……なかなかの逸品だ。\nソーイチローは新たなる精製術を会得したようだな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
