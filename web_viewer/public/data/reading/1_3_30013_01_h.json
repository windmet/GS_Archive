    {
      "kind": "dialogue",
      "source_text": "うん！　ケーキがもっと素敵に見えるような、\nとっておきの舞台を用意しないとね♪",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "performance": {
