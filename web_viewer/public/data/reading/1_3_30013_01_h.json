    {
      "kind": "dialogue",
      "source_text": "うむ！　では早速、円卓会議を再開するとしよう！\n彼の試練まで、残された刻はわずかだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
