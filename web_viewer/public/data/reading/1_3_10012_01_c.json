    },
    {
      "kind": "dialogue",
      "source_text": "「舞田はマスコミとか、もっと\n華々しい業界に行くと思ってた！」って。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "舞田 類"
      },
      "performance": {
        "entityType": "idol",
