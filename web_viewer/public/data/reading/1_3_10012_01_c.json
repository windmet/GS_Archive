        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ん～、マスコミも楽しそうだけど。\nやっぱり人生って、安定も大事だったりするよね？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "舞田 類"
      },
