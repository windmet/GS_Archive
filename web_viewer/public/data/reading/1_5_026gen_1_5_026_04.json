        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、男と男の約束だ。\nそれじゃ、また本番でな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_026gen_1_5_026_04:step-11:text",
