    {
      "kind": "dialogue",
      "source_text": "……いや、さすがにここじゃできねぇ。\n撮影現場は遊び場所じゃねぇからな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
