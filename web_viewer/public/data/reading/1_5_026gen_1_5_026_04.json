      "kind": "dialogue",
      "source_text": "いろいろあったが……。\n今となっちゃいい思い出だ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
