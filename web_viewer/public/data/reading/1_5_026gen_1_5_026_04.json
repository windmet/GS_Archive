    {
      "kind": "dialogue",
      "source_text": "今度、外で一緒にやろう。\nその方が思いっきり体動かせるだろ？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000027:dialogue:000",
