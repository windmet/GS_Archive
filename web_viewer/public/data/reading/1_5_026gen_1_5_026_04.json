    {
      "kind": "dialogue",
      "source_text": "……いや、さすがにここじゃできねぇ。\n撮影現場は遊び場所じゃねぇからな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_04:1_5_026_04:cmd-000023:dialogue:000",
