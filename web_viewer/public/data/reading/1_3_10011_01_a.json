    {
      "kind": "dialogue",
      "source_text": "俺たちは遊びに来てるんじゃない。\nおまえたちを倒すためにここに来たんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
