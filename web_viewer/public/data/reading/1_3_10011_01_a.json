    {
      "kind": "dialogue",
      "source_text": "俺たちは遊びに来てるんじゃない。\nおまえたちを倒すためにここに来たんだ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_10011_01:1_3_10011_01_a:cmd-000032:dialogue:000",
        "source": {
