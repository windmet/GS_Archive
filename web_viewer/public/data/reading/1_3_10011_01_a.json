    {
      "kind": "dialogue",
      "source_text": "……ここはロックの祭典だ。お前らみたいな\n生ぬるいアイドル風情に何ができる？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "バンドマン"
      },
