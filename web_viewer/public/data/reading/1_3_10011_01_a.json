    {
      "kind": "dialogue",
      "source_text": "恥をかく前にさっさと家に帰りな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "バンドマン"
      },
      "performance": {
