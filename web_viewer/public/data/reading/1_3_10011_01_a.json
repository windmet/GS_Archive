        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はっ、威勢だけはいいじゃねぇか。\nやれるもんならやってみろ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "バンドマン"
      },
      "performance": {
        "entityType": null,
