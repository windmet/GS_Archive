    {
      "kind": "dialogue",
      "source_text": "よし、まずはココアで牛乳を使って消費しましょう。\nお代わりし放題ですよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
