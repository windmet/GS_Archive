        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "これまで行った国で美しかった場所の話に\nなったんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
