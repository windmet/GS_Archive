    {
      "kind": "dialogue",
      "source_text": "バスで移動をしている時に、\n隣り合わせになった旅行者と親しくなってね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
