    {
      "kind": "dialogue",
      "source_text": "お腹を空かせて来て欲しいと頼んでいるからね。\n胃に優しいノンカフェインにさせてもらったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
