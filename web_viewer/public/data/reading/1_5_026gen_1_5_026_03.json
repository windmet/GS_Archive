    {
      "kind": "dialogue",
      "source_text": "……ああ、●●●●●●●●●●番長さん。\nありがとよ。ちょうどいい、休憩にするか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
