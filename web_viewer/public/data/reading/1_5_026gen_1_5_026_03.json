      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "何やら悩んでいるように見えましたが……。\n私でよければ相談に乗ります！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
