    {
      "kind": "dialogue",
      "source_text": "人気雑誌のモデルに選ばれたのは光栄だが、\n自分でポーズを考えなくちゃならねぇ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_026gen_1_5_026_03:1_5_026_03:cmd-000040:dialogue:000",
