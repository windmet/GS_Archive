    {
      "kind": "dialogue",
      "source_text": "人気雑誌のモデルに選ばれたのは光栄だが、\n自分でポーズを考えなくちゃならねぇ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
