      "kind": "dialogue",
      "source_text": "いろいろ考えてはいるが、\nちゃんとできているのか判断がつかなくてな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
