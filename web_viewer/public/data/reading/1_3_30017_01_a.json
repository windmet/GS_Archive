        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "音ゲーコーナーは賑やかじゃからのぉ。あそこに\nワシらの曲が流れると思うと、ワクワクするわ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
