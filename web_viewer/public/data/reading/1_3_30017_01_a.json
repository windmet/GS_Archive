    {
      "kind": "dialogue",
      "source_text": "ほう。PR動画の出演だけじゃのうて、ゲーム内にも\n『With...STORY』が収録されるんか。すごいのぉ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
