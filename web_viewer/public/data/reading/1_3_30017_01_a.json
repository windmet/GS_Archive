    {
      "kind": "dialogue",
      "source_text": "ありがとうございます！　……新作音楽ゲームの\nお仕事、内容はPR動画への出演ですか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
