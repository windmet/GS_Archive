    {
      "kind": "dialogue",
      "source_text": "って秀たちから相談を受けたのはいいけど……\nどう、みんな？　何か浮かんだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
