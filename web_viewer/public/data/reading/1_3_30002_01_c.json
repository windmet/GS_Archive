    {
      "kind": "dialogue",
      "source_text": "ええ～、どうかなぁ。俺もいいトシだし、\n成長期なんてとっくに過ぎてるからなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
