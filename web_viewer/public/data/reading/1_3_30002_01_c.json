        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いや、山下くんはレッスンによって、\n確実に成長している。自信を持って大丈夫だ。",
      "text_ref": null,
