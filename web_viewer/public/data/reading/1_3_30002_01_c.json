        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もー、手伝ってよ。先生もアイドルになって\nちょっとは体力ついたんじゃないの？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卒業生の女子"
      },
      "performance": {
        "entityType": null,
