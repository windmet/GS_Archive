      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あのゲームならではの魅力を、みんなに伝えないと。\nそしたらきっと、笑顔になれる人も増えるよね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
