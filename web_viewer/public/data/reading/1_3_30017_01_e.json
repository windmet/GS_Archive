      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "先生の言う通りじゃな。今日遊んだ中に、\n協力してスコアを伸ばすゲームはなかったけぇのぉー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
      },
      "performance": {
