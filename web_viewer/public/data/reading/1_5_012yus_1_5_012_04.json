      "kind": "dialogue",
      "source_text": "リテイクが出たのも、悠介さんならもっとできると\n思われたからこそですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_012yus_1_5_012_04:1_5_012_04:cmd-000076:dialogue:000",
