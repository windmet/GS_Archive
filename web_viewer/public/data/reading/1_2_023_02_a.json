        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ハルナっちの誕生日、メガアゲアゲにしたいっすよね！\nどんなお祝いがいいっすかねー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
