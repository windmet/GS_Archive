        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちょうどハルナは追試でいないし、\n今の内にちょっと相談しようか！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
