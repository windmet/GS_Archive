        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そういえば、もうそんな時期か。\nそれで、お2人は何か考えてるんですか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "冬美 旬"
