        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "合宿のおかげでキレが戻ってきた",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
