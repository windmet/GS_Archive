      "kind": "dialogue",
      "source_text": "みんな頼もしい限りだ。\nもちろん、自分もバッチリだ",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
