          "end_step_index": 46,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アァ！？　誰がオマエの力なんか……！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
