  "rows": [
    {
      "kind": "dialogue",
      "source_text": "俺も手を貸す。\n一緒にプロデューサーを引っ張り上げるぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
