      "source_text": "あんなじじいにまけるわけねえ",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
