          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 42
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "どうか、見守っててください！",
      "text_ref": null,
      "speaker": {
