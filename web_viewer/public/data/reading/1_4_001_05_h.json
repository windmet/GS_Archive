      "kind": "dialogue",
      "source_text": "明日はついに雷皇との決戦だ！\n二人ともコンディションはどうだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
