          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "クソッ、余計な体力使っちまった……。\nおい、ノロマの下僕！　とっとと帰って飯にすんぞ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
