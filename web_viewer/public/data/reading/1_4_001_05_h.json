          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 41
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "師匠、明日の試合で自分たちは\nベストを尽くすッス！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
