    {
      "kind": "dialogue",
      "source_text": "ああ、これならうちに全巻ありますよ。\nグッズや設定資料も持ってます。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
