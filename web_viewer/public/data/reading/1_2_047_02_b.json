    {
      "kind": "dialogue",
      "source_text": "その漫画に関する情報を集めていた。\nこの作品なんだが、秀は知っているか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
