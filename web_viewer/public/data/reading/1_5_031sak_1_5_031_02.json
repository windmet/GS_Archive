    {
      "kind": "dialogue",
      "source_text": "わあ！　この学校で映画の撮影をするんだね。\n台本もバッチリ覚えてきたよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
