        "step_index": 5,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すっごく面白かったー！\nあたしが演じる役の登場シーンを読んだ時にね……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "performance": {
        "entityType": "idol",
