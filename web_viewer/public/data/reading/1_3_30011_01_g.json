        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あんたたちのその勉強熱心さなら、きっとたくさんの\n人たちに伝統工芸の良さを、伝えてくれるってな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "職人1"
      },
      "performance": {
        "entityType": null,
