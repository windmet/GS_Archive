      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルのライブをして、展示会に人を呼ぼうって\n聞いた時は驚いた。だが、話してみてわかったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "職人1"
      },
      "performance": {
        "entityType": null,
