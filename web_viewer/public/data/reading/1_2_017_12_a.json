    {
      "kind": "dialogue",
      "source_text": "猫柳さん、本日の誕生会を\n随分喜んでくれていましたね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_x_017kir_2_1_2_017_12:1_2_017_12_a:cmd-000022:dialogue:000",
