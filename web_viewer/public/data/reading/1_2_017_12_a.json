    {
      "kind": "dialogue",
      "source_text": "そうだねぇ。あの期待に応えるためにも、\n万全な状態にしておかないと。",
      "text_ref": {
        "unit_id": "story-text:v1:1_x_017kir_2_1_2_017_12:1_2_017_12_a:cmd-000028:dialogue:000",
