    {
      "kind": "dialogue",
      "source_text": "もし、アタシたちが同級生の友達だったら、\nどんなふうに一緒に遊んでたと思う？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
