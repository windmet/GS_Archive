    {
      "kind": "dialogue",
      "source_text": "おおっ、特撮ヒーローの変身ベルトが\nタイムスリップの道具になるのか！　面白そうだな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "performance": {
