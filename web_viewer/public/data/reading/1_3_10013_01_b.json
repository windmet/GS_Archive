    {
      "kind": "dialogue",
      "source_text": "今の自分に悩みを抱える3人が、\n過去にタイムスリップするとありますね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
        "entityType": "idol",
