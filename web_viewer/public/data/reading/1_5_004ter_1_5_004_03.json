    {
      "kind": "dialogue",
      "source_text": "桜庭や翼も時間があるからって\n参考書を解くの付き合ってくれたんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "performance": {
