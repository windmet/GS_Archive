      "kind": "dialogue",
      "source_text": "そうなんだよ。練習してきたつもりだったけど、\nもっと頑張らねぇといけないみたいだな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000037:dialogue:000",
