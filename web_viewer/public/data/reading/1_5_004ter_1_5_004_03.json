    {
      "kind": "dialogue",
      "source_text": "総合成績で上位に入っていますね！\nさすがです！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000019:dialogue:000",
