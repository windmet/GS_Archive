    {
      "kind": "dialogue",
      "source_text": "お疲れさまです、輝さん。\n休憩を挟んで後半戦ですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000016:dialogue:000",
