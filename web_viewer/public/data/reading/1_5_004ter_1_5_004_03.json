    {
      "kind": "dialogue",
      "source_text": "参考書を買ってきて、\nたくさん問題を解いたからな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000022:dialogue:000",
        "source": {
