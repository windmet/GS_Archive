    {
      "kind": "dialogue",
      "source_text": "だけど、早押しには苦戦したぜ。\n周りの押す速度が速いんだよなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "performance": {
        "entityType": "idol",
