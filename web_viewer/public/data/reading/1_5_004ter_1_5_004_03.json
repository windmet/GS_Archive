    {
      "kind": "dialogue",
      "source_text": "確かに問題文を読み上げている途中で\n押している方が多かったですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000034:dialogue:000",
