    {
      "kind": "dialogue",
      "source_text": "桜庭や翼も時間があるからって\n参考書を解くの付き合ってくれたんだ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_03:1_5_004_03:cmd-000025:dialogue:000",
        "source": {
