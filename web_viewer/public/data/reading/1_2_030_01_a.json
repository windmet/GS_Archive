    {
      "kind": "dialogue",
      "source_text": "えっ、いいんですか。俺もプロデューサーさんと\n話したいなって思っていたところです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
