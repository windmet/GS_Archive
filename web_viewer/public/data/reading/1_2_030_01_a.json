      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "プロデューサーさんも、事務所に戻るなら\n一緒にどうでしょう？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "030mak"
      },
