        "step_index": 7,
        "source_part_id": "1_2_030_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この後は、事務所に寄っていこうと思っていました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
