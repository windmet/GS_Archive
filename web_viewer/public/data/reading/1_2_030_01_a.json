    {
      "kind": "dialogue",
      "source_text": "本日のお仕事は以上となります。\nこのまま帰宅予定なら、駅まで一緒に行きませんか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
