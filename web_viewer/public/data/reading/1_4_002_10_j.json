        "option_id": null,
        "source_label": "phone_select1",
        "target_step_id": 52,
        "target_step_index": 51,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "あはは、それがね。『男極FIVE』って、ヒーローの\n名前みたいだねって、みんなで盛り上がっちゃって。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_j:step-52:text",
        "step_id": 52,
        "step_index": 51,
        "source_part_id": "1_4_002_10_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 51
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "自分たちに、あだ名っていうか、\n二つ名みたいなものをつけたんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_j:step-53:text",
        "step_id": 53,
        "step_index": 52,
        "source_part_id": "1_4_002_10_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 52
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺が男極レッドで、次郎が男極キャット。\nそれから、男極マッスルミシンに……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_j:step-54:text",
        "step_id": 54,
        "step_index": 53,
        "source_part_id": "1_4_002_10_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 53
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あと……あっ、来た来た！\n男極クリーンに、男極クリーンメガネ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_j:step-55:text",
        "step_id": 55,
        "step_index": 54,
        "source_part_id": "1_4_002_10_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 54
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "男極FIVE、全員集合！　ってことで。\n道端でたまってると悪いし、先に中で待ってるね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_j:step-56:text",
        "step_id": 56,
        "step_index": 55,
        "source_part_id": "1_4_002_10_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 55
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おとりをしてくれてた時のこととか、\n詳しい話が聞けるのを楽しみにしてるから！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
