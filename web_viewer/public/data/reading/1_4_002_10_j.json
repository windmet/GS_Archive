  "rows": [
    {
      "kind": "dialogue",
      "source_text": "（今回こそ、気が済むまでライバルを辱め、\n大金をかけた我々のステージを披露して……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アイドル業界の大物"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
