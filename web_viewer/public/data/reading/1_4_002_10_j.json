        "source_part_id": "1_4_002_10_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 41
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もしもし、●●●●プロデューサー？\n打ち上げ会場の前に着いたよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
