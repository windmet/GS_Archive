          "end_step_index": 61,
          "target_step_index": 49
        }
      },
      "option": null
    },
    {
      "kind": "choice",
      "source_text": "男極レッドとは……？",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
