          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 48
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今いるのは、男極レッドと男極キャット。それから……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_j:step-50:text",
        "step_id": 50,
