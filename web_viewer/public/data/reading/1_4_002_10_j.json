          "file": "episodes/1_4_002_10_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "ライブ終了後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
