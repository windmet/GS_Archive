      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いい機会だ。俺の話を聞いちゃくれないか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 17
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
