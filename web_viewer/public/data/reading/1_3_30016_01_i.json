        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "気を揉ませちまってたんだな。悪い。確かに、\n家族のことを詳しく話したことがなかった。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
