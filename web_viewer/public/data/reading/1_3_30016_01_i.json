        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そのおかげで、お前に会えた。そんで、番長さんに\n会って、アイドルなんてもんをやらしてもらってる。",
      "text_ref": null,
      "speaker": {
