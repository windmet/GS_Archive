        "step_index": 22,
        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……まぁ、いろんなことがあって、\nあっちにはいられなくなっちまったけどよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
