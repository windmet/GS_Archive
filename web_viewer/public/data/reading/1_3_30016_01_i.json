        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ここは、中華街か。\nこないだ一緒に行った店もある。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "025suz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "025suz",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30016_01_i:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "人が写りこまねぇ写真を撮りたかったんだが、\nタイミングが難しくてよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30016_01_i:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "タイミング……。じゃあ、おまえが言ってた\n「難しい」ってのはもしかして。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "025suz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "025suz",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30016_01_i:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。公園も中華街も、人通りが多くてな。\n思ったような写真が撮れなかったんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "026gen"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "026gen",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30016_01_i:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_3_30016_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そ、そういうことだったのか……！　オレは、\nてっきり、家族の写真が撮れねぇからだと……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "025suz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "025suz",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
