      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "パリやニューヨークで、たくさんの個性的な\nモデルに出会ったと言っていたな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
