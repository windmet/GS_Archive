      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "世界中で活躍をしているらしくて、\n色々と面白い話を聞かせてもらったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
