      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "彼らがひとたびランウェイを歩くと、\nもう目を離せなくなってしまうんだそうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
