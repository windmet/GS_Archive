    {
      "kind": "dialogue",
      "source_text": "はい。今回の撮影は屋外で行うので、\n晴れてよかったですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_038tak_1_5_038_01:1_5_038_01:cmd-000018:dialogue:000",
        "source": {
