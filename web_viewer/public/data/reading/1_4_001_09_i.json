          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "最初は圧倒されたがよぉ、\n今日のリハーサルはバッチリ終わったな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "このまま明日のステージも成功させれば、\n世の悪人を正すって夢にも大きく近づくはずだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。……懐かしいぜ、●●●●プロデューサーさん\nにスカウトされたあの日がよぉ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あの時は、アイドルってもんが\n正直よく分かってなかったよなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうだな、あの日朱雀が言った言葉、\n今でも覚えてるぜ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この世から悪をなくすため、アイドルになる！\n……あれにはさすがに驚いたな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だが同時に、お前ならやれるんじゃねぇかって\n感じたんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……俺たちは明日、あのデカいステージに立って\n観客を盛り上げ、世界中の悪人共にメンチを切る。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "きっと、震え上がって悪事をやめるだろう。\n有言実行……さすが朱雀、俺が認めた相棒だけある。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "黒野 玄武"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "玄武……！！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_09_i.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ここまで来られたのは、オレの力だけじゃねえ。\nおまえがいてくれたからだぜっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_09_i:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_09_i",
