      "anchor": {
        "row_id": "1_4_001_09_i:step-2:caption",
        "step_id": 2,
        "step_index": 1,
        "source_part_id": "1_4_001_09_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
