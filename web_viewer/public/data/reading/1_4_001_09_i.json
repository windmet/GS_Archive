  "rows": [
    {
      "kind": "caption",
      "source_text": "神速一魂の部屋",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
