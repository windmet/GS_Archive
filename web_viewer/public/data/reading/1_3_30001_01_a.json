    {
      "kind": "dialogue",
      "source_text": "お二人の、笑顔あふれる未来を願って……\n俺たちからのパスポートです、受け取ってください！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
