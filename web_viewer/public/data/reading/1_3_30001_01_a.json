    {
      "kind": "dialogue",
      "source_text": "……当時、まだまだ子供だった私たちには、\n仲間以外にわかり合える人なんていませんでした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
