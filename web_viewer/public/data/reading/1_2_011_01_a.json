      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "とても素敵だと思います！\nみのりさん、すごいですね……！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
