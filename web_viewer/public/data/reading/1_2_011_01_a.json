    {
      "kind": "dialogue",
      "source_text": "『希望』……。誕生日に贈る\nフラワーアレンジメントにはピッタリですね！",
      "text_ref": {
        "unit_id": "story-text:v1:1_2_011min_01_1_2_011_01:1_2_011_01_a:cmd-000032:dialogue:000",
