    {
      "kind": "dialogue",
      "source_text": "そうだね、今の時期ならアネモネかな……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
