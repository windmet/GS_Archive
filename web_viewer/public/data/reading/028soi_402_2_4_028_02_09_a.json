    {
      "kind": "dialogue",
      "source_text": "スケジュールを調整していただいたり、撮影中も\n気にかけてくださって、ありがとうございました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
