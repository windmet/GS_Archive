      "kind": "dialogue",
      "source_text": "配信作品ということで、視聴者の中には\nコアなドラマ好きの方も多いと伺いました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
