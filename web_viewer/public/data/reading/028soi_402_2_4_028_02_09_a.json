    {
      "kind": "dialogue",
      "source_text": "アクションシーンもあり、なかなか難易度の高い\n撮影でしたが……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
