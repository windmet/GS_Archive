          "end_step_index": 30,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "衣装は現地で渡されるらしいし、\n必要なものは……揃ってるよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_c:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_02_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_c.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "大丈夫だ。\nいつも通り、俺なら完璧にやれる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_c:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_02_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_c.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…………。\nでも、一応『俺ルール』はやっておくか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_c:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_001_02_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_c.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "秀、今日は大事な日なんか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秀の祖父"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_c:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_02_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_c.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "！　爺ちゃん。\n……まあね、分かるの？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_c:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_001_02_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_c.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "分かるさ。秀は、大事な日はいつも\n靴を右から履きたがるから。頑張ってな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秀の祖父"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_c:step-17:text",
        "step_id": 17,
        "step_index": 16,
        "source_part_id": "1_4_001_02_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_c.json",
          "start_step_index": 0,
          "end_step_index": 30,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……ん、アリガト。\n行ってきます。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_c:step-18:text",
