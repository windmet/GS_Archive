          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "昨日、皆さんにお仕事の依頼が届きました。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
