          "end_step_index": 30,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（そう、今日は大事な一日だ。なんせ……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
