    {
      "kind": "dialogue",
      "source_text": "髪のセットはこれでいいか。\nいや、もう少し、こっちにクセをつけて……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_c:step-5:text",
