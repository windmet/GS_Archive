          "target_step_index": 25
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "依頼してくださったのは、\nとあるおもちゃ屋を経営されている男性で……",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
