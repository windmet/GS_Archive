        "step_id": 34,
        "step_index": 33,
        "source_part_id": "1_4_002_10_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たち双子コーデの掃除屋が、\nその凝っちまった頭と心を解きほぐそう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
