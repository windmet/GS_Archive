    {
      "kind": "dialogue",
      "source_text": "ほう、なかなかいいな。\nこれを使えば、高所の掃除も……ん？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
