    {
      "kind": "dialogue",
      "source_text": "……葛之葉君。世の中には、\n『双子コーデ』というものが存在するらしい。",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_002_10:1_4_002_10_f:cmd-000090:dialogue:000",
        "source": {
          "scenario_id": "1_4_002_10",
