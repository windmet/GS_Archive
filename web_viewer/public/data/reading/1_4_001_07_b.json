          "end_step_index": 30,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まだまだ新人の俺たちに、こんなに注目\nしてくれる人もいるんだね。嬉しいなぁ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
