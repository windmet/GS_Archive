    {
      "kind": "dialogue",
      "source_text": "ダイビングのグラビアとインタビューの\nお仕事をいただけるとは、光栄です！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
