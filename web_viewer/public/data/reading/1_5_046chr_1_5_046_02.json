      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ！　一人でも多くの方に、\n海の魅力を知っていただきたいです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000030:dialogue:000",
        "source": {
          "scenario_id": "1_5_046chr_1_5_046_02",
