    {
      "kind": "dialogue",
      "source_text": "インタビューもページ数をいただけるとのことで、\nこちらを用意してきました！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000036:dialogue:000",
