      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、クリスさんは海の魅力を伝えるために\nアイドルになりましたからね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000025:dialogue:000",
        "source": {
