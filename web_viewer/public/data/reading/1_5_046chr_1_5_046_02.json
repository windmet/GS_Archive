    {
      "kind": "dialogue",
      "source_text": "この広大な海を見てください、\n●●●●プロデューサーさん。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000017:dialogue:000",
        "source": {
