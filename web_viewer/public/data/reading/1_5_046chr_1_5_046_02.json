      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ダイビングのグラビアとインタビューの\nお仕事をいただけるとは、光栄です！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000021:dialogue:000",
        "source": {
