    {
      "kind": "dialogue",
      "source_text": "こ、この紙束の山は……！？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000039:dialogue:000",
