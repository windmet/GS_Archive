      "kind": "dialogue",
      "source_text": "今回のインタビューのテーマを押さえつつ、\n海の資料をまとめてきました！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_02:1_5_046_02:cmd-000044:dialogue:000",
        "source": {
          "scenario_id": "1_5_046chr_1_5_046_02",
