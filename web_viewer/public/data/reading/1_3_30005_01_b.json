        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "君が飲んでいるのは梅酒ではないだろう。\n全く、今日はいつも以上によく喋るな……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
