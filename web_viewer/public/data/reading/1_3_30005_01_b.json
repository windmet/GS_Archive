    {
      "kind": "dialogue",
      "source_text": "へへ、なんか嬉しいな。\n仕事の流れとはいえ、みんなで酒が飲めるなんてさ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "performance": {
        "entityType": "idol",
