    {
      "kind": "dialogue",
      "source_text": "北斗さんは御曹司の役なんですよね。\n役作り、難しかったですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_03:1_5_003_03:cmd-000017:dialogue:000",
        "source": {
