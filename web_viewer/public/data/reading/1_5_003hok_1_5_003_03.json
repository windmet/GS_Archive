    {
      "kind": "dialogue",
      "source_text": "北斗さんは御曹司の役なんですよね。\n役作り、難しかったですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
