    {
      "kind": "dialogue",
      "source_text": "俺とは真逆の性格な役ですからね。\n難しいと言えば難しいですが、楽しかったですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
