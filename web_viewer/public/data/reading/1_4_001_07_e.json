          "end_step_index": 44,
          "target_step_index": 42
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "オレも聞きに行きますね。\nそれじゃ、失礼します。●●●●プロデューサー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
