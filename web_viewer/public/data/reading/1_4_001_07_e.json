        "option_id": null,
        "source_label": "phone_01",
        "target_step_id": 39,
        "target_step_index": 38,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "そうですね、例えば……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_e:step-39:text",
        "step_id": 39,
        "step_index": 38,
        "source_part_id": "1_4_001_07_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 38
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "行き先によって、アナウンスの内容に\nアレンジを加えたりしていました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_e:step-40:text",
        "step_id": 40,
        "step_index": 39,
        "source_part_id": "1_4_001_07_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 39
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その土地の名産品や観光スポットについて話すと、\n乗客の皆さんも喜んでくれるそうで……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_e:step-41:text",
        "step_id": 41,
        "step_index": 40,
        "source_part_id": "1_4_001_07_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 40
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なので、そういうことも意識して\n練習していました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_e:step-42:text",
        "step_id": 42,
        "step_index": 41,
        "source_part_id": "1_4_001_07_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_e.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 41
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "Beitの店内放送が、\nどんな内容になるのか楽しみです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_e:step-43:text",
        "step_id": 43,
        "step_index": 42,
        "source_part_id": "1_4_001_07_e",
        "source_file": null,
