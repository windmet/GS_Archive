          "target_step_index": 2
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（我ながら、子供とは正直なものだな……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "inline_translation": null,
      "has_voice": true,
