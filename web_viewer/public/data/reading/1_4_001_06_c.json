          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（可愛いものが好きってことを認めてほしくて、\nでも、うまく伝える自信がなくて）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
