      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（棲家を離れてばかりの両親に、\n「もっとそばにいてほしい」と綴った記憶がある）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "inline_translation": null,
