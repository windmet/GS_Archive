          "end_step_index": 26,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（……懐かしいなぁ、この手紙）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
