          "end_step_index": 26,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（いろいろ悩んで、手紙にしたんだよね。\n結局、それも渡せなかったんだけど……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
