        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よかったら、今度みんなで\nやってみようか。\nルールはボクが教えるよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
