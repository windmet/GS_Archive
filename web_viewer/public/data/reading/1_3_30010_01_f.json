      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お話って、さっき僕が口にした、\n今回PRする時計のイメージについてですかー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
