        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "実は、雨彦さんと別れた後、\nこんなことがありまして……。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
