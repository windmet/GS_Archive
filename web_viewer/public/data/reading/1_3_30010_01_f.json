    {
      "kind": "dialogue",
      "source_text": "ああ、俺も驚いたぜ。……ところで、\n北村も古論も、どうして残ってたんだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
