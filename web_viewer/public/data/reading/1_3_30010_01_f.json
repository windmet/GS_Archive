    {
      "kind": "dialogue",
      "source_text": "よかった、ここの会議室が空いてました。\nでは早速、先ほどのお話を続けましょう！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "担当者"
