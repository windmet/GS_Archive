        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。お見送りするつもりだったのに、すみません。\nですが、もっと詳しく聞かせてもらえませんか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "担当者"
      },
      "performance": {
