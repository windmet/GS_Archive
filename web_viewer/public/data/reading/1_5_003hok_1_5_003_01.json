    {
      "kind": "dialogue",
      "source_text": "モデルをやっていた時の写真やデビュー当時の\n写真も出るみたいで。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000020:dialogue:000",
