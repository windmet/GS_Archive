    {
      "kind": "dialogue",
      "source_text": "トークテーマが「過去の自分へ」だなんて\n面白いですよね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
