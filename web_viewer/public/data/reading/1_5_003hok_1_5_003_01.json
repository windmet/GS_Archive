    {
      "kind": "dialogue",
      "source_text": "今はもうなかなか見られない写真ですし\n貴重ですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000023:dialogue:000",
