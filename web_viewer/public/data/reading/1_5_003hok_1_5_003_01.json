        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もう番組内でお話しすることは\n決めてあるんですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
