        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_003hok_1_5_003_01:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": null,
