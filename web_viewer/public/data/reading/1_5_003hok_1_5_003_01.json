    {
      "kind": "dialogue",
      "source_text": "トークテーマが「過去の自分へ」だなんて\n面白いですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_01:1_5_003_01:cmd-000017:dialogue:000",
        "source": {
