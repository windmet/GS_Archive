        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うーん……初心者でもそれなりに作れる料理……。\n……カレー、とか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
