        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_2_001_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふふ、それはありがたいな。\nじゃあ、俺たち二人で作れるものと言えば……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
