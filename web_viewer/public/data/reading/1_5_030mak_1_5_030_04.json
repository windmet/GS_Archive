    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさんは、俺が出演する\nミュージカル舞台の台本を読みましたか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000032:dialogue:000",
        "source": {
