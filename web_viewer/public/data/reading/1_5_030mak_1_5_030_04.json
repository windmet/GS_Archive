    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさんは、俺が出演する\nミュージカル舞台の台本を読みましたか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "030mak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "030mak",
        "presence": "visible",
