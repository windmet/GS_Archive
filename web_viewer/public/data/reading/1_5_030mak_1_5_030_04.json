          "command_index": 53,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:8d6d9e4d928a5ec6f6a538a893c585df2aee806f249078de9430350f50d23b1d"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "030mak",
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "030mak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "030mak",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
