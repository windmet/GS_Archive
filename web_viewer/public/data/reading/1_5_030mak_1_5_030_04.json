        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そのつもりで来ました。このあとの予定は\n大丈夫なので、とことんやりましょう！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
