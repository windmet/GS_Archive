        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この作品って、\n俺たちの世代に大人気のシリーズですよね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
