        "command_end": 46
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なかなかイメージ通りに歌えなくて。\nよかったら、レッスンに付き合ってもらえませんか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000053:dialogue:000",
        "source": {
