    {
      "kind": "dialogue",
      "source_text": "今回のミュージカルは、俺のソロパートがあるので\nボーカルを中心にレッスンをしているんですが……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
