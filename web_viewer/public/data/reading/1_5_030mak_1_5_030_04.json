        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "巻緒さん、お疲れさまです。\n調子はどうですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
