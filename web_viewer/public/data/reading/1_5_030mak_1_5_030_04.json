        "command_end": 32
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もちろん読みましたよ。\n明るい作風で、とても面白かったです！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000036:dialogue:000",
        "source": {
