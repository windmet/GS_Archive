      },
      "visual": {
        "entityType": "idol",
        "entityId": "030mak",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_030mak_1_5_030_04:step-11:text",
        "step_id": 11,
        "step_index": 10,
