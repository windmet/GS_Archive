          "command_index": 46,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:66d07b723413453f5ff795837b379e0abe73beb1584a84f8d8b4fcf804c39106"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "030mak",
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "030mak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "030mak",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_030mak_1_5_030_04:step-11:text",
        "step_id": 11,
