      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この作品って、\n俺たちの世代に大人気のシリーズですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_04:1_5_030_04:cmd-000042:dialogue:000",
        "source": {
