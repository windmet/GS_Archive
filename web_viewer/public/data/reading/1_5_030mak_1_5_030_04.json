      },
      "diagnostics": [
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_030mak_1_5_030_04:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_5_030_04",
        "source_file": "assets/resources/scenariodata/1_5_030mak/scenario_1_5_030_04.json",
        "command_start": 53,
        "command_end": 53
      },
      "option": null
    },
    {
