    {
      "kind": "dialogue",
      "source_text": "先生の……手伝いがあるから、遅れて来るって……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
