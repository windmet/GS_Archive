      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ジュンっちに秘密の話っすか？\nもしかして、赤点取っちゃったとか……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
