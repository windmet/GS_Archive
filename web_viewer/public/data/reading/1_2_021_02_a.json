      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうなんだ。……あ！　それなら今のうちに\n話したいことがあるんだけど、いいかな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
