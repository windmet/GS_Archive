    {
      "kind": "dialogue",
      "source_text": "すっごい嬉しいよ！　この日のために腕立ても\n走り込みも十分してきたんだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
