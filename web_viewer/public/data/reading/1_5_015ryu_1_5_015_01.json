    {
      "kind": "dialogue",
      "source_text": "まさか俺がレスキュー活動の再現ドラマに\n出演できるなんてな！　嬉しいよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
