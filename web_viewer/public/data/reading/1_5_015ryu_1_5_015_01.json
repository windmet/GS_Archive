      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "レスキュー活動はこんなにもかっこよくて、\n重要な仕事なんだってさ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
