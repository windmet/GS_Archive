        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_015ryu_1_5_015_01:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "たとえドラマでも真剣に取り組めば\n視聴者にもレスキュー活動の大切さが伝わるだろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
