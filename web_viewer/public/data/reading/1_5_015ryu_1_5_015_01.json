      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "このお仕事を頂いた時から、これは龍さんに\nお願いしようと思っていましたから。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
