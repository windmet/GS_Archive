    {
      "kind": "dialogue",
      "source_text": "次のシーン、誠司さんの長台詞ですね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
