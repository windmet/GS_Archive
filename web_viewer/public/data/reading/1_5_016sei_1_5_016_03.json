    {
      "kind": "dialogue",
      "source_text": "ああ、台本をもらった時は驚いたが、\n練習の成果を披露してくる。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_016sei_1_5_016_03:1_5_016_03:cmd-000019:dialogue:000",
