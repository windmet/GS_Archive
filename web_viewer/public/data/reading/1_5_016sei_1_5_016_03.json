        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "これも話を持ってきてくれた\n●●●●プロデューサーさんのおかげだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "016sei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "016sei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
