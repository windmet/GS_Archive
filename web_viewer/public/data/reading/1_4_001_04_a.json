        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい！　次は、『お掃除解決隊』のコーナーです！\nこのコーナーでは……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
