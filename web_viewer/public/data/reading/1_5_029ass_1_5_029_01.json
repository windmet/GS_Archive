    {
      "kind": "dialogue",
      "source_text": "最高位の詠唱士を目指す、快然たる物語……。\n我が演じるのは主人公の永遠の好敵手！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
