      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今はサタンも、無論その眷属たる我も、\nあの極秘計画を喜ばしく思っている。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
