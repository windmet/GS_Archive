      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "我が闇の中で産声を上げしこの日に、\nこれほどの宴が催されようとは……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
