    {
      "kind": "dialogue",
      "source_text": "主も協力者だとサキが言っていたな。その功績を\n称えるべく、我は念話機を手にしたのだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
