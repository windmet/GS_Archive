        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この記憶に刻まれた衝撃と喜び、\n必ずや我の手で同胞たちにも味わわせねば。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
        "entityType": "idol",
