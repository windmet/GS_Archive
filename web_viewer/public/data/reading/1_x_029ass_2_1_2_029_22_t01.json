      },
      "visual": {
        "entityType": "idol",
        "entityId": "029ass",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
