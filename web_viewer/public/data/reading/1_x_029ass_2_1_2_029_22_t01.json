        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うむ……我は決めたぞ、主よ！　同胞たちの誕生\nせし日には、我が強力な魔術を披露すると！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
