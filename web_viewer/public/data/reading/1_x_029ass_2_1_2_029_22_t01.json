      "kind": "dialogue",
      "source_text": "禁断の精製術を解き放ち、極上の供物を囲み\n至高の宴を催さん！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
