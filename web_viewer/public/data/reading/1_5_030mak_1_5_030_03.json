    {
      "kind": "dialogue",
      "source_text": "サキちゃんと一緒にお店に行ったんですが、\nいろんな種類があって選べなくて……！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000027:dialogue:000",
