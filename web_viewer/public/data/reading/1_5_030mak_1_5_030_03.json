        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_030mak_1_5_030_03:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
