        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それぞれ別のアイスを買って、シェアしました。\nどっちのアイスも美味しかったなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
