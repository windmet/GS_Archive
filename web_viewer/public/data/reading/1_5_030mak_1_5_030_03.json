    {
      "kind": "dialogue",
      "source_text": "わあ、有名なチェーン店のCMだ……。\nここのアイスって美味しいですよね！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000022:dialogue:000",
        "source": {
