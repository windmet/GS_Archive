    {
      "kind": "dialogue",
      "source_text": "わあ、有名なチェーン店のCMだ……。\nここのアイスって美味しいですよね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
