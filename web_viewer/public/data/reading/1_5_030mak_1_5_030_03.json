    {
      "kind": "dialogue",
      "source_text": "ふふ、巻緒さんと咲さんは仲良しですね。\n今回のCMは新作アイスの宣伝になります。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
