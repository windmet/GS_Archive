    {
      "kind": "dialogue",
      "source_text": "巻緒さん、アイスクリームのCMが決まりました！\nこちらが資料になります。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_030mak_1_5_030_03:1_5_030_03:cmd-000016:dialogue:000",
        "source": {
