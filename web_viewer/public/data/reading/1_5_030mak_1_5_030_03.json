    {
      "kind": "dialogue",
      "source_text": "巻緒さん、アイスクリームのCMが決まりました！\nこちらが資料になります。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
