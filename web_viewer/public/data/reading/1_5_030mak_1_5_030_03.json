    {
      "kind": "dialogue",
      "source_text": "サキちゃんと一緒にお店に行ったんですが、\nいろんな種類があって選べなくて……！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
