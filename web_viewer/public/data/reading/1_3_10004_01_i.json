        "step_index": 15,
        "source_part_id": "1_3_10004_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "母と妹です。二人の買い物に付き合うこともあるので\n今回は彼女たちから得た知識が活きたのでしょう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
        "entityType": "idol",
