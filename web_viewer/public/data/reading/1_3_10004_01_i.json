      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お前さん、自分の格好には無頓着そうだが、\n女物となるとガラリと趣味が変わるんだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 15
