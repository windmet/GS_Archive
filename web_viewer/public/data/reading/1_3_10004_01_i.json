        "step_index": 14,
        "source_part_id": "1_3_10004_01_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん、すごくセンスいいねー。\nていうか、身近にいる女性って誰のことー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "045sor"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "045sor",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 16
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_10004_01_i:step-16:text",
