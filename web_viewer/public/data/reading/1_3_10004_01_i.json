        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええー。学んでこれだけ変わるなら、\n自分のファッションにも興味を持ったらいいのにー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
