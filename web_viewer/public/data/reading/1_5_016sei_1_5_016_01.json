        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "焼き肉以外にも使い道はあるんだ。\nまあ、とりあえず食べてみてくれ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "016sei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "016sei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
