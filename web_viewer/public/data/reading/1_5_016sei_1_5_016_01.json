    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさん、ちょうどよかった！\nＣＭ用の料理を作ったんだ。試食してくれないか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
