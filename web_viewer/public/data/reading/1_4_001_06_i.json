        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「それでもまだ時々は心配してしまうかも」と、\n笑ってもいましたが……きっと大丈夫でしょう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
