    {
      "kind": "dialogue",
      "source_text": "初めは「娘がアイドルに夢中だなんて心配だ」と、\nご両親は思っていたそうですが……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_001_06:1_4_001_06_i:cmd-000062:dialogue:000",
        "source": {
