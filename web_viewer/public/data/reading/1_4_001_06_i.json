      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい！　帰って行くお客さん、みんな笑顔で……。\n俺も嬉しくなりました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
