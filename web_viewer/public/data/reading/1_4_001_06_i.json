      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ご両親の言葉に、ファンの方は\n自分はもうハタチなのにと呆れていましたが、",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
