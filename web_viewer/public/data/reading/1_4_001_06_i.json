        "step_index": 5,
        "source_part_id": "1_4_001_06_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "またたくさんのお客さんと会えるように、\nみんなで頑張っていきましょうね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "030mak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "030mak",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_i:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_06_i",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そういえば今日、ご両親と来られていた\nファンの方から、嬉しい話を聞きましたよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
