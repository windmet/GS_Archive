        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "録画映像って、昨日のレッスン動画ですか？\nキレイに撮れてたと思うけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "013kys"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "013kys",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30006_01_f:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_3_30006_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。画質については申し分なかった。\nだが、今回はそこではない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "005kao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "005kao",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30006_01_f:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_3_30006_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まず、画角が長時間変わらない。\nこれなら三脚で固定していても同じだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "005kao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "005kao",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30006_01_f:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_3_30006_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もう一つ。カメラからメンバーが遠い。我々の\n顔を見せたほうがファンは喜ぶんじゃないのか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "005kao"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "005kao",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30006_01_f:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_3_30006_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あっ……確かにそうかもしれないです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
