    {
      "kind": "dialogue",
      "source_text": "今日集まってもらったのは、先に伝えている\n通り録画映像について気になる点があったからだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
