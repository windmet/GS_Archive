          "file": "episodes/1_4_001_05_a.json",
          "start_step_index": 0,
          "end_step_index": 28,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "どういうことだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_05_a:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_001_05_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_a.json",
          "start_step_index": 0,
          "end_step_index": 28,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "『Victory Rush!』の主催者は、私たちが参加を\n目指す、JIFのスポンサーの一人なんです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_05_a:step-26:text",
        "step_id": 26,
        "step_index": 25,
        "source_part_id": "1_4_001_05_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_a.json",
          "start_step_index": 0,
          "end_step_index": 28,
          "target_step_index": 25
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "じゃあ……いい仕事をすれば、\nJIFへの推薦がもらえるかもってことッスか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_05_a:step-27:text",
        "step_id": 27,
        "step_index": 26,
        "source_part_id": "1_4_001_05_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_a.json",
          "start_step_index": 0,
          "end_step_index": 28,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ！　ですから、必ず成功させましょう！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
