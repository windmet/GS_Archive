      },
      "speaker": {
        "kind": "unknown",
        "entityType": "idol",
        "entityId": "047shu",
        "sourceName": "？？？"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_00_a:step-14:text",
        "step_id": 14,
        "step_index": 13,
