    {
      "kind": "dialogue",
      "source_text": "……なに？　プロデューサー。\nアンタ、もう感動してんの？",
      "text_ref": {
        "unit_id": "story-text:v1:1_4_001_00:1_4_001_00_a:cmd-000042:dialogue:000",
        "source": {
          "scenario_id": "1_4_001_00",
          "part_id": "1_4_001_00_a",
