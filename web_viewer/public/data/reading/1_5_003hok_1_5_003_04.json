    {
      "kind": "dialogue",
      "source_text": "例えどれだけ本人に似合う服でも\nその人が気に入らなければ意味はないですからね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_003hok_1_5_003_04:1_5_003_04:cmd-000030:dialogue:000",
