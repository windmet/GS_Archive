    {
      "kind": "caption",
      "source_text": "High×Jokerのライブ",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
