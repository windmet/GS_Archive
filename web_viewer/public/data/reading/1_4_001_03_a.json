          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "やっぱライブはサイコーっす！\nみんなテンションメガアツで楽しいっす！！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちデビューしたばっかりなのに、\nこんなに人が来てくれるなんて……ホント……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こんなところで泣かないでください。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "冬美 旬"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "盛り上がってきたトコで、MCタイムでっす！\nというわけで、ナツキ、頼んだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "キャー、夏来くーん！\n（今日もミステリアス……！）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "観客"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_03_a:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……えっと、今日のトークテーマは、\n『憧れのミュージシャン』だって……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "榊 夏来"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "憧れ、憧れ……いっぱいいるから、\nひとりに絞るのは難しいっすね～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "たしかに……クラシックかポップスか、\nジャンルごとに分けて考えたいかな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "冬美 旬"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-24:text",
        "step_id": 24,
        "step_index": 23,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はいはい！　俺、『ARROW・B』が好き！\n特にギタリストのスミス、すっげー憧れ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-27:text",
        "step_id": 27,
        "step_index": 26,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ARROW・Bって言ったら、僕たちが生まれる前から\n活動しているロックバンドですよね？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "冬美 旬"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-30:text",
        "step_id": 30,
        "step_index": 29,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今もまだまだ現役なんだよな。\n今度、来日公演するとかで話題になってたし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_03_a:step-31:text",
        "step_id": 31,
        "step_index": 30,
        "source_part_id": "1_4_001_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_03_a.json",
          "start_step_index": 0,
          "end_step_index": 33,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そう！　でも俺、チケット争奪戦に負けて……。\nうう、スミスの生ギター聞きたかった……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
