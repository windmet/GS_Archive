    {
      "kind": "dialogue",
      "source_text": "「そんなに上手くいかないなら、少し休んだら？\n今のお前、全然楽しそうに見えない」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
