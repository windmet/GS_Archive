        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うーん、今のところはもっと強く言った方が\nいいすっかね……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "024shk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "024shk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_024shk_1_5_024_04:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お疲れさまです。差し入れを持ってきましたが……。\n難しい顔をされて、どうされました？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_024shk_1_5_024_04:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、●●●●プロデューサーちゃん。今度出演する\n青春バンド映画の役の演じ方なんすけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "024shk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "024shk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_024shk_1_5_024_04:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "オレもバンドやってるから最初はヨユーって\n思ってたんっすけど……なんつーか……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "024shk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "024shk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_024shk_1_5_024_04:step-11:text",
        "step_id": 11,
        "step_index": 10,
