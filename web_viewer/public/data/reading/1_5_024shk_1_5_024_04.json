        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それっす！　どうやって演じればいいのか\nメガメガ迷うんっすよ～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "024shk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "024shk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_024shk_1_5_024_04:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": null,
