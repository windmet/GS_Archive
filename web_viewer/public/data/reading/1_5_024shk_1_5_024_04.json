        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「本番まで時間がないことくらい、わかってるよ。\nだけど、このままやっても……」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "024shk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "024shk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_024shk_1_5_024_04:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
