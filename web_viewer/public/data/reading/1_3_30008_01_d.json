    {
      "kind": "dialogue",
      "source_text": "俺のところにも似たものがありますよ！\n「ライブ以外で歌っている姿がみたい」だそうです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
