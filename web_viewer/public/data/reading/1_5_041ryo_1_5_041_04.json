      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "フワフワして、キラキラして、ワクワクする\n夢のようなミュージカル……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
