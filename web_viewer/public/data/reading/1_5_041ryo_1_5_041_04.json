    {
      "kind": "dialogue",
      "source_text": "ありがとうございます、\n●●●●プロデューサーさん。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
