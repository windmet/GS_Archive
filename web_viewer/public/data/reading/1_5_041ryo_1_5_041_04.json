      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "会場にいるお客さん全員を満足させられるように\n僕、しっかり演じてきますね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
