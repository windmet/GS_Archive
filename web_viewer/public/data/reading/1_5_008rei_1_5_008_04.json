    {
      "kind": "dialogue",
      "source_text": "今日は動物番組の、犬のしつけ企画の収録だな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_04:1_5_008_04:cmd-000016:dialogue:000",
        "source": {
