    {
      "kind": "dialogue",
      "source_text": "麗さん、嬉しそうですね。犬を飼っていますし、\n動物とふれ合うのが楽しみですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
