    {
      "kind": "dialogue",
      "source_text": "そういえば、麗さんの家にも大型犬がいましたよね。\nええと、確か……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_04:1_5_008_04:cmd-000022:dialogue:000",
