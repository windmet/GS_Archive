      "kind": "dialogue",
      "source_text": "ああ、楽しみだ。\n犬とふれ合うのは好きだからな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_04:1_5_008_04:cmd-000036:dialogue:000",
        "source": {
