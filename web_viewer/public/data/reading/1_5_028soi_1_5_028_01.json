    {
      "kind": "dialogue",
      "source_text": "ありがとうございます。私たちの世代に向けた、\n映画やテレビドラマを紹介する番組ですか。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_028soi_1_5_028_01:1_5_028_01:cmd-000020:dialogue:000",
