        "command_start": 22,
        "command_end": 22
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それに、どのみち天気が回復しないと\n撮影の再開は出来ないんだしさ。気長に待つさね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000025:dialogue:000",
        "source": {
