      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "配役を聞いた時以上に、\n翔真さんととても相性の良い役だと思いました。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000033:dialogue:000",
        "source": {
