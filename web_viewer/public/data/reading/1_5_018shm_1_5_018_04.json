    {
      "kind": "dialogue",
      "source_text": "ねえ、●●●●プロデューサーちゃん。\nアタシの役の感想を聞かせてちょうだいな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000031:dialogue:000",
