          "command_index": 17,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:25369270d3ef7abac6d5c5b721e91393ed7547cbd18055514f18f207f01cf957"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_018shm_1_5_018_04:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_5_018_04",
        "source_file": "assets/resources/scenariodata/1_5_018shm/scenario_1_5_018_04.json",
        "command_start": 17,
        "command_end": 17
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アタシの衣装、ヴィラン役ってことで凝ってるでしょ。\n装飾も多いし、時間がかかって当然。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000022:dialogue:000",
        "source": {
          "scenario_id": "1_5_018shm_1_5_018_04",
          "part_id": "1_5_018_04",
          "file": "assets/resources/scenariodata/1_5_018shm/scenario_1_5_018_04.json",
          "command_index": 22,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:de49245352d795f8cea5dee4cd42b8b13fdefcfddb33a93904e140389e59e328"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "018shm",
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
