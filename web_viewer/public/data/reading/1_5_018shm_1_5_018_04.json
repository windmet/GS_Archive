    {
      "kind": "dialogue",
      "source_text": "いい画が撮れたって監督が喜んでいたけど。\n急に天候が崩れるなんて思ってもみなかったわ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000015:dialogue:000",
        "source": {
          "scenario_id": "1_5_018shm_1_5_018_04",
          "part_id": "1_5_018_04",
          "file": "assets/resources/scenariodata/1_5_018shm/scenario_1_5_018_04.json",
          "command_index": 15,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:90aabffa9ae0f5c1e69addad00ca8618781bb2571d571ee69ac12da741a6fb0a"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "018shm",
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
