        "command_start": 33,
        "command_end": 33
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "嬉しいことを言ってくれるじゃないの。この役を\n当たり役と言わせてみせようって気に更になったわ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000037:dialogue:000",
        "source": {
