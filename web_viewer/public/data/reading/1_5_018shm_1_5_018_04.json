        "command_start": 15,
        "command_end": 15
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "衣装が乾くまでもう少しかかるそうです。\nスタッフさんたちも急いでくれているようなのですが…",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_04:1_5_018_04:cmd-000017:dialogue:000",
        "source": {
          "scenario_id": "1_5_018shm_1_5_018_04",
