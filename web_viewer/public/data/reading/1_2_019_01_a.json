    {
      "kind": "dialogue",
      "source_text": "アイドルになり、茶の湯を広めるという\n私の選択は間違っていません。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
