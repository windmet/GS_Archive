        "step_index": 4,
        "source_part_id": "1_2_019_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わかりました。ですが日程によっては\nアイドルの仕事があるため参加できません。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "019kur"
