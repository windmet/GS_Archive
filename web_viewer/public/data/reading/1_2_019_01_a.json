    {
      "kind": "dialogue",
      "source_text": "近々お祖父様の知り合いがパーティを開くそうです。\n九郎さんも参加するようにとお祖父様からの伝言です。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九郎の兄"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
