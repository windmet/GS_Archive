      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "バランスがいいよな。\nあと、見てるとピエールらしさを感じるって言うか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
