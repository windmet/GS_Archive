      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "やふー！　アリガト。恭二の、お花もステキ、だね！\n絶対、みのり、喜ぶ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
