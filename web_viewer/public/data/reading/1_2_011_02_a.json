    {
      "kind": "dialogue",
      "source_text": "大きなお花、目立つように、小さいお花も一緒。\nどう、キレイ？　みのり、喜ぶ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
