        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ARROW・Bのライブまで\nあと一週間だぜ",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
