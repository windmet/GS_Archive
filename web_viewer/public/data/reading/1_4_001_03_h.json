          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ハヤトっち、慣れない服だと\n余計に緊張するんじゃ\nないっすか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "inline_translation": null,
