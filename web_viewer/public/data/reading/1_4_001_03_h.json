      "kind": "dialogue",
      "source_text": "ここはいつも通りが\nハナマル大正解っしょ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
      },
      "inline_translation": null,
