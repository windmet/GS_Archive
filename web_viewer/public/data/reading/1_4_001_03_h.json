      "kind": "dialogue",
      "source_text": "とうとうスミスに会えるんだ！\nどうしよう\n何着ていけばいい！？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
