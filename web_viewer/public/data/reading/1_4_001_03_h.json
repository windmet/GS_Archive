          "end_step_index": 41,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "High×Jokerのみんなも、\nスミスとの動画でさらに活躍が広まるといいな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
      "inline_translation": null,
      "has_voice": true,
