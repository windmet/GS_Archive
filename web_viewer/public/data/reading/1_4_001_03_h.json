          "end_step_index": 41,
          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "着物！？\n着方わかんないよー！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
      "inline_translation": null,
