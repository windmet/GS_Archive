          "end_step_index": 41,
          "target_step_index": 31
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちなみにオレはいつもの服に\nとっておきをコーデするっす！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊瀬谷 四季"
