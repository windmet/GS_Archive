          "end_step_index": 41,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ありがとうございます。\n彼らにも伝えておきますね！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
