      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "踏み入ると、心浮き立つ施設かな。\nあちこち見に行きたくなるよねー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
