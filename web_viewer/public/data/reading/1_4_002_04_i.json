          "end_step_index": 18,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ありがとうございました！　もうすぐ70歳になるとは\n思えない、素晴らしい歌声でしたね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "司会"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_04_i:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だろぉ！？　老体に鞭打った甲斐があったぜ！\n見てくれたみんなも、ありがとなぁ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "おじいさん"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_04_i:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おじいさん、すっごくアイドルしてますね！\n笑顔がキラキラ輝いています。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_i:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だな……。俺たちもあんな風に、\n60、70になってもキラキラしていたいよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_i:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、そうだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_i:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おっ……なんだよ、珍しく素直だな。\nてっきりおまえは嫌がるかと思ったぜ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_i:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルとして常に輝いていなければ、\n僕の目的も果たせないだろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_i:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "60、70になってまで、君たちとキラキラ\nしている必要も……無いわけではない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_i:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_002_04_i",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_i.json",
          "start_step_index": 0,
          "end_step_index": 18,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（それが、僕の笑顔と、ファンの笑顔と……。\n姉さんの笑顔にも、繋がるのなら）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
