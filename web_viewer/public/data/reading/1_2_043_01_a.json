        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…ああ、近場だからな。それに、軽装でも\n登れるここなら、明日の仕事にも影響は……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
        "entityType": "idol",
