    {
      "kind": "dialogue",
      "source_text": "気遣ってくださって、ありがとうございます。\n一希さんは、この山にはよく来られるんですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
