        "command_start": 17,
        "command_end": 17
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、衣装合わせのあとは\n軽い打ち合わせがあると言っていたな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000019:dialogue:000",
        "source": {
