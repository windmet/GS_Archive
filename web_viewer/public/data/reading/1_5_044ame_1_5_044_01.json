          "field_ordinal": 0
        },
        "source_hash": "sha256:047a4d36e17ce7ca0edf8b3480793a4e0e2f54287a43faf19c12bbbb9e7e5e93"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
