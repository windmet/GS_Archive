    {
      "kind": "dialogue",
      "source_text": "ああ、衣装合わせのあとは\n軽い打ち合わせがあると言っていたな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
