    {
      "kind": "dialogue",
      "source_text": "資料に目を通したが、\n落ち着いたデザインのブランドだ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000022:dialogue:000",
        "source": {
