    {
      "kind": "dialogue",
      "source_text": "雨彦さん、本日はファッション雑誌の\n衣装合わせになります。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000017:dialogue:000",
        "source": {
