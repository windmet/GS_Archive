      "source_text": "着回しもしやすいだろう。\n服のサイズが合えばいいんだがな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_044ame_1_5_044_01:1_5_044_01:cmd-000028:dialogue:000",
