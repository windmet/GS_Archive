      "kind": "dialogue",
      "source_text": "華村さんにもまだ硬いと言われ\nましたが、必要な礼儀です。\n書かないわけにはいきません。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
