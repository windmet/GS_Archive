        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今朝届いた動画には、\n驚かされたでにゃんす！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "猫柳 キリオ"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "017kir"
      },
      "visual": {
