        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "招待状だけじゃなく、\nさぷらいずがあるなんて思っても\nいなかったでにゃんすよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "猫柳 キリオ"
      },
      "performance": {
        "entityType": "idol",
