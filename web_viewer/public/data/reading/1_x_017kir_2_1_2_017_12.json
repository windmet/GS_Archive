    {
      "kind": "dialogue",
      "source_text": "招待状、ありがとうでにゃんす！\n中身を書いたのはくろークンで\nにゃんすか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
