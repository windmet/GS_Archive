      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "きっと喜んでくれるよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "018shm"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "018shm",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
