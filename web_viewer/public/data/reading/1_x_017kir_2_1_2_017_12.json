    {
      "kind": "dialogue",
      "source_text": "時候の挨拶でにゃんす。それで、\nすぐにくろークンが書いたって、\nわかったでにゃんすよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
