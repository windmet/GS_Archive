        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "猫柳さん、本日の誕生会を\n随分喜んでくれていましたね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "019kur"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "019kur",
