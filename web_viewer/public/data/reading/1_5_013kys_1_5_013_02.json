    {
      "kind": "dialogue",
      "source_text": "享介さん、お菓子のCMのお仕事が決まりましたよ！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
