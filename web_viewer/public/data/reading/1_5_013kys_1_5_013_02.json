        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こちらがそのCMの資料です。\n少しユニークなCMになりそうですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
