        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この前、お菓子選挙やってたよね。一位を取った\nお菓子が新商品を出すって話だったけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "013kys"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "013kys",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_013kys_1_5_013_02:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お菓子がいつもより1.5倍増量だって！\n●●●●●●●●●●監督、これすごくない？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "013kys"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "013kys",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_013kys_1_5_013_02:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すごいですよね！\n選挙一位を記念して期間限定で販売するそうです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
