        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "とてもおいしそうなレポートでした！\nそれに見てください。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 17
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
