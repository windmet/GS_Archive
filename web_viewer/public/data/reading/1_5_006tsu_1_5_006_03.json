    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー、\nオレのレポート、どうでしたか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
        "entityType": "idol",
