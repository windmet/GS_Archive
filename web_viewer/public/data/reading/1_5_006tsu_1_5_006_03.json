      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "翼さんがレポートしたお店に、\nどんどん人が集まって列ができているみたいですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 18
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
