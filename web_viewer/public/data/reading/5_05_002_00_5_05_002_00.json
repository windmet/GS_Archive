    {
      "kind": "dialogue",
      "source_text": "そんなこと言いなさんな。星占いってのは、文字通り\n星の位置から人の運勢や吉兆を読み解くもんだが……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
