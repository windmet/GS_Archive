          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああっ、●●●●プロデューサーさんの\nパソコンにこぼしてしまった。大変だ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_f:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_002_07_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
