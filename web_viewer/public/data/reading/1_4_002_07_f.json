          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そんなに大変なの？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_f:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_002_07_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_f.json",
          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "え、ええ。\nパソコンに水がかかると、故障の原因になります。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_f:step-23:text",
        "step_id": 23,
        "step_index": 22,
        "source_part_id": "1_4_002_07_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_f.json",
          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "動かなくなったり、データが消えたりするんです。\nですから、大変なんです！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_f:step-24:text",
        "step_id": 24,
        "step_index": 23,
        "source_part_id": "1_4_002_07_f",
