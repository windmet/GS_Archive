          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（渾身のドッキリだったのだが……。\nい、いや、まだ始まったばかりだ！）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
