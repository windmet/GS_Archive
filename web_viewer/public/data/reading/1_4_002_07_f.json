          "start_step_index": 0,
          "end_step_index": 26,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "都築さん、コーヒーをどうぞ。\n少し休憩を挟んで……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_f:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_002_07_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
