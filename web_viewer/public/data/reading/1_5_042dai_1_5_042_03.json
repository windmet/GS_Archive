        "command_start": 15,
        "command_end": 15
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうですね、店構えも年季が入っているお店が\n多そうですし、色々エピソードがありそうですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_03:1_5_042_03:cmd-000017:dialogue:000",
        "source": {
          "scenario_id": "1_5_042dai_1_5_042_03",
