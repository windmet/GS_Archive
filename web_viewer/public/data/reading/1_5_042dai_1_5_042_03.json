          "field_ordinal": 0
        },
        "source_hash": "sha256:85f51c964376d70d42e61abb053cd1dbf91cdecaded596d1674303df282bf53b"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "042dai",
        "sourceName": "兜 大吾"
      },
      "performance": {
