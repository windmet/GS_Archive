      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それからお店に通い始めて、しばらくして\nバイトとして働くようになったんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
