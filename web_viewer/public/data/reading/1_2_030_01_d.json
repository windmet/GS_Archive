    {
      "kind": "dialogue",
      "source_text": "荘一郎さんのケーキを食べた時は衝撃的でした。\n全部おいしくて、その日のケーキは全て食べました！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
