    {
      "kind": "dialogue",
      "source_text": "なるほど、Cafe Paradeとの出会いは\n荘一郎さんのケーキがきっかけだったんですね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
