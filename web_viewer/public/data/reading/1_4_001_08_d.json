    {
      "kind": "dialogue",
      "source_text": "ぜひ！　F-LAGSの音楽番組収録が\n終わったら、みんなでウチに来てください！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
