          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 35
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "最高に美味い打ち上げラーメンを\nご馳走するッスよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
