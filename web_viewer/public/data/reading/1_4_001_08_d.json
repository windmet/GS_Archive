          "end_step_index": 38,
          "target_step_index": 23
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●●●●●●●師匠、お疲れ様ッス。\n今って時間、大丈夫ッスか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-28:text",
        "step_id": 28,
        "step_index": 27,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 27
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "実は今日、THE 虎牙道のファンだって\nお客さんが、自分の店に来たんスよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-29:text",
        "step_id": 29,
        "step_index": 28,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 28
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルやり始めてから、\nそういうお客さん、結構増えてるんス！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-30:text",
        "step_id": 30,
        "step_index": 29,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 29
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ファンから自分の話を聞くのって、\nまだ慣れなくて照れくさいッスけどね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-31:text",
        "step_id": 31,
        "step_index": 30,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 30
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でも、すごく嬉しい気持ちもあるんスよ！\nデビューしてよかったなって。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-32:text",
        "step_id": 32,
        "step_index": 31,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 31
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、それと。自分が店にいない時も、ファンの\n方が来てくれるって、おやっさんに聞いて……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-33:text",
        "step_id": 33,
        "step_index": 32,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 32
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なので、そんな時でもファンに喜んでもらえる\nよう、期間限定の新メニューを考案中なんス！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_08_d:step-34:text",
        "step_id": 34,
        "step_index": 33,
        "source_part_id": "1_4_001_08_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_08_d.json",
          "start_step_index": 0,
          "end_step_index": 38,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "choice",
      "source_text": "私も食べてみたいです",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
