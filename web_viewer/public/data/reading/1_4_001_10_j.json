        "playback": {
          "file": "episodes/1_4_001_10_j.json",
          "start_step_index": 0,
          "end_step_index": 62,
          "target_step_index": 56
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "メンゴクのこと、もし何かわかったら教えてね。\nそれじゃ、また明日からもよろしくね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
