          "end_step_index": 62,
          "target_step_index": 54
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そういえば、控室でほくとくんたちが\n手紙を見つけたって言ってたっけ……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_j:step-56:text",
        "step_id": 56,
        "step_index": 55,
        "source_part_id": "1_4_001_10_j",
        "source_file": null,
        "command_start": null,
