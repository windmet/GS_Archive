          "end_step_index": 62,
          "target_step_index": 53
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でも、言うだけ言ってどこかに行っちゃったもんな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_10_j:step-55:text",
        "step_id": 55,
        "step_index": 54,
        "source_part_id": "1_4_001_10_j",
        "source_file": null,
        "command_start": null,
