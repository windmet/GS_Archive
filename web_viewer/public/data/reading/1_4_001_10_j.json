      "kind": "dialogue",
      "source_text": "話しかけてきたアイドルも、\nただならぬオーラって感じだったし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
