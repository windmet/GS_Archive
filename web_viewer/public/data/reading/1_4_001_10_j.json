          "file": "episodes/1_4_001_10_j.json",
          "start_step_index": 0,
          "end_step_index": 62,
          "target_step_index": 55
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それと何か関係が……って、今監督と電話中だった！\nごめん！　ともかく今日はお疲れさま！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
