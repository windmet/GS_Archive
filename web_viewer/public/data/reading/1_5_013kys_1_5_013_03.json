    {
      "kind": "dialogue",
      "source_text": "●●●●●●●●●●監督、俺の演技どうだった？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
        "entityType": "idol",
