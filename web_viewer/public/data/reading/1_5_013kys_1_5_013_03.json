      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "周りは有名な役者の人が多いから\n読み合わせの時に、役作りについて色々聞いたんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
