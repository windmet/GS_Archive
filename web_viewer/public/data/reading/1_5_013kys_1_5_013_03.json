        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「元の場所に戻せ……。もう一度言う。\n元の場所に戻すんだ！」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
