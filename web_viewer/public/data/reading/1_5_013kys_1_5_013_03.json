      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "親切な人ばっかで、参考になる話を\nたくさん聞かせてもらったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
