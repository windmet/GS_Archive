        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「落ち着けって。そんなものをこの小さな宇宙船に\n解き放ったらどうなるかわかるだろ？」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
      },
      "performance": {
