    },
    {
      "kind": "dialogue",
      "source_text": "へへ、ありがと。●●●●●●●●●●監督に\n言われるとすごいうれしいよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 享介"
