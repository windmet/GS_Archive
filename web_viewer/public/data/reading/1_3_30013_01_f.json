        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その経験が今に繋がってると思っている。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "027yuk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "027yuk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30013_01_f:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_3_30013_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ええ。神谷が旅を通して得た縁で、私はパティシエ\nとしてCafe Paradeに来ることができました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30013_01_f:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_3_30013_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。だから、東雲も実際に経験したらいい。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "027yuk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "027yuk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30013_01_f:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_3_30013_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "私もあの時の神谷と同じように旅を……\nということでしょうか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
