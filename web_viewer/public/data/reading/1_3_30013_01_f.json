    {
      "kind": "dialogue",
      "source_text": "参考になるかわからないけど……。\n俺も色んな国を旅して、たくさんのことを学んだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
