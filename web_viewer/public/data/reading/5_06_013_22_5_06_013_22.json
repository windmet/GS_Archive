        "step_index": 3,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん、僕もそう思うよ。\nまだ余韻が残ってるみたいだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "007kei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "007kei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_013_22_5_06_013_22:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みんなの歌声が一つに合わさって、\nどこまでも響いていくようなあの感覚……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "007kei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "007kei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_013_22_5_06_013_22:step-6:text",
