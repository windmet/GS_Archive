    {
      "kind": "dialogue",
      "source_text": "合同練習……すごくよかったですね、都築さん。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
