        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "とはいえ、本番まで油断はできません。さらに\nよい歌となるよう、練習を重ねていきましょう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
