    {
      "kind": "dialogue",
      "source_text": "パフォーマンスが違う……。\nたしかに滋養強壮剤を飲むと元気が出ますよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_037jir_1_5_037_04:1_5_037_04:cmd-000030:dialogue:000",
