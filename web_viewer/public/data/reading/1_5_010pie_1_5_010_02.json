    {
      "kind": "dialogue",
      "source_text": "ファンタジーアニメで、精霊の役。台本読んで、\n心ぽかぽかした。お話、とっても素敵！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
