      "source_text": "●●●●プロデューサーさんも、\n手伝ってくれた。だから、大丈夫！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
