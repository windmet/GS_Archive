        "source_file": "assets/resources/scenariodata/1_5_010pie/scenario_1_5_010_02.json",
        "command_start": 17,
        "command_end": 17
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん！　準備、バッチリ。\nボク、今日の収録、楽しみしてた。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000022:dialogue:000",
        "source": {
          "scenario_id": "1_5_010pie_1_5_010_02",
