    {
      "kind": "dialogue",
      "source_text": "もう間もなく収録が始まります。\nピエールさん、準備はいいですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_010pie_1_5_010_02:1_5_010_02:cmd-000017:dialogue:000",
        "source": {
          "scenario_id": "1_5_010pie_1_5_010_02",
