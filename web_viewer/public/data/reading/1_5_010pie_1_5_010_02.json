    {
      "kind": "dialogue",
      "source_text": "もう間もなく収録が始まります。\nピエールさん、準備はいいですか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
