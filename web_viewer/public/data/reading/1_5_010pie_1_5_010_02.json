      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でも、声だけで演技するの大変。\n恭二とみのりが、練習、手伝ってくれた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
