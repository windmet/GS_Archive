          "field_ordinal": 0
        },
        "source_hash": "sha256:c2ef432027a92c112d4fdbef14ec91d060c68fe9349e870984b0bc11fe2f0f73"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "010pie",
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
