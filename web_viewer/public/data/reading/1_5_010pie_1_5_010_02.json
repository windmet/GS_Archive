          "command_index": 17,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:27618b94634a0d7068464c77274b0c932af31867f060f7a95cf14c925ba6c9d7"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [],
