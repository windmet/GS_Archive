        "step_index": 8,
        "source_part_id": "1_3_30018_01_g",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「おはよう」の一言だって、大きな前進だろ。\n上手く話そうとしても、できなかったりするし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30018_01_g:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_3_30018_01_g",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうだねー。「おはよう」って\n言ってもらえるのって、結構嬉しいもんね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "002sht"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "002sht",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 14
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30018_01_g:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_3_30018_01_g",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "案外、それがきっかけで\n会話できるようになるかもしれないし！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "002sht"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "002sht",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 15
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30018_01_g:step-15:text",
