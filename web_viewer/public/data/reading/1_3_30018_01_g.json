        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "unresolved-performance-actor"
      ],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_3_30018_01_g:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_3_30018_01_g",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なるほどな……。うーん、\nとりあえず挨拶から始めてみるってのはどうだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30018_01_g:step-9:text",
