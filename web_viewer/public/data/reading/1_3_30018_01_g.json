    {
      "kind": "dialogue",
      "source_text": "では早速、メールの紹介。「好きな女の子に、上手く\n話しかけられなくて困ってます」とのことですが……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "パーソナリティ"
      },
      "performance": {
        "entityType": null,
