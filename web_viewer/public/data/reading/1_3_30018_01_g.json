        "step_index": 14,
        "source_part_id": "1_3_30018_01_g",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん、俺もそう思うよ。あと、アドバイスを\nするなら……笑顔を忘れずに、ってところかな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "003hok"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "003hok",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 19
