        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それが相手の、君に対する印象になるからね。\nいつも笑顔の人って、素敵だよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
