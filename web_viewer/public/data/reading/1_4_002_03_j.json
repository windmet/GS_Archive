          "end_step_index": 61,
          "target_step_index": 55
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちょっとは兄貴として、\nカッコイイとこ見せられてたらいいな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
