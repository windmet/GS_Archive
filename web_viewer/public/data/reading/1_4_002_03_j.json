      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こんな時間にごめん、●●●●●●●●●●監督！\nもう寝てた？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
