    },
    {
      "kind": "dialogue",
      "source_text": "あ、起きてた？　よかった！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_j:step-51:text",
