          "file": "episodes/1_4_002_03_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 54
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "普段、あいつには、\nいろいろ心配かけっぱなしだけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
