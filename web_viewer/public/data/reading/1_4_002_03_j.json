        "target_step_id": 55,
        "target_step_index": 54,
        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "ありがと。\n今日は享介と走れて、本当に嬉しかったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
