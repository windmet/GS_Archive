        "source_part_id": "1_4_002_03_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 50
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……っと、いっけねー。あんま大きい声出したら、\n享介が起きちゃうから気をつけないと。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_03_j:step-52:text",
        "step_id": 52,
        "step_index": 51,
        "source_part_id": "1_4_002_03_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_03_j.json",
          "start_step_index": 0,
          "end_step_index": 61,
          "target_step_index": 51
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なんだか眠れなくて。\nちょっとだけ、今日の運動会の話させてくれる？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
