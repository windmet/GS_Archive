          "end_step_index": 61,
          "target_step_index": 56
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ふわあ……。あれ、なんか眠くなってきちゃった。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
