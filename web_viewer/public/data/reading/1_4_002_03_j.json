          "end_step_index": 61,
          "target_step_index": 52
        }
      },
      "option": null
    },
    {
      "kind": "choice",
      "source_text": "もちろんです",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
