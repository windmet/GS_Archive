        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "一日中走り回って、歌って……。\nエネルギー使い切ったのかなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
