      "source_text": "●●●●プロデューサーさんに会えなかったから、\n事務所に届けに行ったら……なんと！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
