          "start_step_index": 0,
          "end_step_index": 39,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうですね。本番まで、まだ時間はあります。\n抜かりなく、出来る事は準備していきましょう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_f:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_001_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_f.json",
          "start_step_index": 0,
          "end_step_index": 39,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うーん……。\n他にも準備できること、ないかなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_f:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_f.json",
          "start_step_index": 0,
          "end_step_index": 39,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……そうだ！　今度みんなで、\nおもてなしを受けに行くのはどうですか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_f:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_001_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_f.json",
          "start_step_index": 0,
          "end_step_index": 39,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "最近、新しく見つけたカフェがあるんです。\n今日みたいに、何か新しい発見があるかも！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_06_f:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_001_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_06_f.json",
          "start_step_index": 0,
          "end_step_index": 39,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なるほど。おもてなしされる側の気持ちを\n再確認するのはいいかもしれませんね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
