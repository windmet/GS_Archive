      "kind": "dialogue",
      "source_text": "それじゃ、今度の休みに行きましょう！\nおもてなしもケーキも素晴らしいお店なんですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
