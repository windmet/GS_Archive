          "end_step_index": 39,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "教えてもらったクラシック、素敵だったよね♪\n今日のレッスンも、新しい発見がいっぱいあったな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
