          "end_step_index": 39,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。お二人のアドバイスで、\n当日流すBGMも決まって良かったです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "inline_translation": null,
      "has_voice": true,
