          "end_step_index": 39,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うむ！　それにマキオが勧める店だ。\nきっと素晴らしい導きがあるに違いない！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "inline_translation": null,
      "has_voice": true,
