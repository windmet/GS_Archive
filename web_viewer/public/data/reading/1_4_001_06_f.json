      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "Altessimoが参加してくれたおかげで、\n感謝祭がどんどんいい形になってきたね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "inline_translation": null,
