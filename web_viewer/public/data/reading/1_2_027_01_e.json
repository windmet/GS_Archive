    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさんが聞き上手だから、\n時間が過ぎるのが早く感じるな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
