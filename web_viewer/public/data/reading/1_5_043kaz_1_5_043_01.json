    {
      "kind": "dialogue",
      "source_text": "…さっき、ナレーションで紹介した場所なんだが。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "043kaz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "043kaz",
        "presence": "visible",
