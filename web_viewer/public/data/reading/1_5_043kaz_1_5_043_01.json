        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…プロデューサーのオススメの本があったら\n教えてくれ。ぜひともあの森で読んでみたい。",
      "text_ref": null,
      "speaker": {
