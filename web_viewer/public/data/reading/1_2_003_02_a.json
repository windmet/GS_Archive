    {
      "kind": "dialogue",
      "source_text": "あ！　冬馬君がオシャレなレシピ本読んでる。\nいつ作るの？　僕のぶんもよろしくね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "002sht"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "002sht",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
