        "step_id": 17,
        "step_index": 16,
        "source_part_id": "1_2_003_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あはは、だよねー。北斗君のことだから、\n朝昼晩デートの予定で埋まってるんじゃない？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
