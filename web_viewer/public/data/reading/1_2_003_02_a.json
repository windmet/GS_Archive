      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "誕生日の上にバレンタインだし、\nとっくに予約が入ってるかもしんねぇな……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 17
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
