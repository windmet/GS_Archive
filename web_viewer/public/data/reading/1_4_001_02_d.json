          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いやぁ……まさか、\n本当に来てくれるとは思わんかったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_d:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あんた達みたいにキラキラした\n若い子がいるってテレビで知ってなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_d:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルっていうんかね。君らに宣伝してもらえば、\nこの店もまた賑わうんじゃないかと思ったんよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_d:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こちらこそ、ご依頼ありがとうございます！\n早速、お店についてお話を聞かせてください。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_d:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（ふーん、随分レトロな店だな……うちの\n爺ちゃんも、こういうおもちゃで遊んでたのかな）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_d:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（……●●●●●●●●●●ぴぃちゃんの声、\n落ち着く。ずっと聞いていたい）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_d:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（確かに、今の時代には珍しい品揃えだ。\nここを再起させるには……）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_d:step-21:text",
        "step_id": 21,
        "step_index": 20,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……そういうわけで、もう一度、\n昔のように子供たちで賑わう店を見てみたくてなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_d:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "無茶な話かもしれんが、\n力を貸してもらえんだろうか……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "老店主"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_d:step-26:text",
        "step_id": 26,
        "step_index": 25,
        "source_part_id": "1_4_001_02_d",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_d.json",
          "start_step_index": 0,
          "end_step_index": 27,
          "target_step_index": 25
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "任せてください。\n俺たちは今日、あなたの力になるために来たんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
