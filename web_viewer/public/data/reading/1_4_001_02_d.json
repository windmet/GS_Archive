  "rows": [
    {
      "kind": "caption",
      "source_text": "古びたおもちゃ屋",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
