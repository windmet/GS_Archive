      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "仕事で疲れた恋人の心を、\n優しい言葉と行動で包み込めるのでは、と。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "046chr"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "046chr",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
