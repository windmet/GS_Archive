      "kind": "dialogue",
      "source_text": "これで全員、恋人の設定が決まったねー。\nあとは担当するエリアのことだけどー……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
