        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そろそろ出るぞ。\n時間はいくらあってもいい。\nプロデューサーを呼びに行こう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
