    {
      "kind": "dialogue",
      "source_text": "天道の地元からとんぼ返りして\n今日も収録か……昨日から\nハードスケジュールだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
