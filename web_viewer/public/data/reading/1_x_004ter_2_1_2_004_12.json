    {
      "kind": "dialogue",
      "source_text": "はい。\n輝さんに喜んでもらえるように\n素敵なケーキを作りましょうね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "performance": {
