    {
      "kind": "dialogue",
      "source_text": "どうでしょうか、プロデューサーさん。\n野点の良さは味わってもらえていますか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
