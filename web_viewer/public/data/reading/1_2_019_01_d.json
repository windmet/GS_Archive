      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こうして外の景色を眺めながらお茶を楽しめるのは、\nとても素晴らしい事ですね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
