      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "主人公がここで食事をしとる時に、恋人から\n電話がかかってくるシーンはドキドキしたぞ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "042dai"
      },
      "visual": {
        "entityType": "idol",
