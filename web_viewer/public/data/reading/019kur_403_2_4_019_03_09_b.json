    {
      "kind": "dialogue",
      "source_text": "先ほど受け取ったテーマソングの歌詞を、\n確認していたところなのですが……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
