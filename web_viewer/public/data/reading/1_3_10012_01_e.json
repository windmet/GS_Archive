        "step_index": 7,
        "source_part_id": "1_3_10012_01_e",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たち全員、少し前まで\n教師をやってたんですけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "037jir"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "037jir",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
