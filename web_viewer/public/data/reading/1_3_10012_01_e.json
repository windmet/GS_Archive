        "step_index": 8,
        "source_part_id": "1_3_10012_01_e",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もし俺たちを見て、アイドルって素敵、アイドルに\nなりたい！　……なんて、思ってくれる子がいたら。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
