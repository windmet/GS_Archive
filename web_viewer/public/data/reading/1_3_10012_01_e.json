        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルって、いつもニコニコ楽しそうに見えて、\nアレ、裏では想像以上にひいひい言ってるんですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
