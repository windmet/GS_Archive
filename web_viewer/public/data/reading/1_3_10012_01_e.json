    {
      "kind": "dialogue",
      "source_text": "いろんな『楽しい』と手を繋いだら、\n世界ってどんどんKIRAKIRAになっていくから！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
