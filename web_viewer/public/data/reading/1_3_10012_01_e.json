      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……その『楽しい』を手に入れるために、\n意外と努力が必要だったりするしねぇ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
