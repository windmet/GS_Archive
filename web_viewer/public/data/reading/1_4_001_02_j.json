  "rows": [
    {
      "kind": "caption",
      "source_text": "おもちゃ大会から数日後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
