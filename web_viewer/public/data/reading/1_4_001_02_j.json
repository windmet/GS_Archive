          "end_step_index": 14,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●●●●●●●ぴぃちゃん、見て見て。\n僕たち、地元の広報誌に載ってるよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "歴史あるおもちゃ屋に輝きを取り戻した\nアイドル業界の新旋風！　……か。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルって聞いて、想像してたような\n派手な仕事じゃなかったけど。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……凄く楽しかったし、やって良かった。\nみんなも、いい経験になったんじゃない？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 7
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そういえば、遊び疲れた女児に\n絵のプレゼントが大人気だったな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "感謝する、百々人。\nあの子たちが笑顔になれたのは、お前のおかげだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……もう、僕のことはいいってば。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_02_j:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "皆さん、初仕事お疲れさまでした！\nさて、これからについてなんですが……",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_j:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "実は、315プロダクションが一丸となって\n掴みたい大きな仕事があります。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_02_j:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_001_02_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_02_j.json",
          "start_step_index": 0,
          "end_step_index": 14,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……『JAPAN IDOL FES』について、\nお話をさせてください！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
