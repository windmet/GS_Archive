    {
      "kind": "dialogue",
      "source_text": "これは水が出るライター。\nこっちは、座ると音が鳴るクッションだねー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
