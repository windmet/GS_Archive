    {
      "kind": "dialogue",
      "source_text": "今回のロケの出発点はこの街か。\nここからバスを乗り継いで目的地を目指すんだね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "027yuk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "027yuk",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
