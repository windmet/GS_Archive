    {
      "kind": "dialogue",
      "source_text": "うん？　どうしたんだい、\n●●●●プロデューサーさん？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
