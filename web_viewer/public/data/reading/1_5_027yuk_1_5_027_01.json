        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "きっとみなさんも喜びますよ。\nあ、Cafe Paradeといえば……。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
