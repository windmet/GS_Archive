    {
      "kind": "dialogue",
      "source_text": "メンバーのみなさんが、\n幸広さんが迷子にならないか心配していました。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
