      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すみません。\n先程から私のペースに付き合わせてしまって。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
