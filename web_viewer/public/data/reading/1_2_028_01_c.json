      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はっ、はい。紅茶の茶葉が生地に入っていて、\n食感が特徴的です。ほら、香りも素敵ですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
