    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさん。\nそちらのスイーツのお味はいかがですか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
