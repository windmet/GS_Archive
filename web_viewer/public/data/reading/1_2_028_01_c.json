      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "では次に、こちらも試してもらえませんか……\nおっと。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
