      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もちろんです。\nでは、一緒に相談していきましょうか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
