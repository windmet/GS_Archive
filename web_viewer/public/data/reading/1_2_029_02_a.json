    {
      "kind": "dialogue",
      "source_text": "それじゃあ早速、アスランのサプライズ\n誕生日パーティの相談を進めようか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
