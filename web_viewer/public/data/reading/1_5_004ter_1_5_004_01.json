    {
      "kind": "dialogue",
      "source_text": "さっとお湯に溶かせば、うまいコーヒーが飲める上に\n目も覚める！　サイコーだろ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
