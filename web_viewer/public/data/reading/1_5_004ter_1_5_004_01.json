      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "朝専用ってだけあって、あっさりとした\nいい味わい！　なんつって。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000035:dialogue:000",
        "source": {
