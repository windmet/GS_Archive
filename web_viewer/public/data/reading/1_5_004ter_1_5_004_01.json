        "command_start": 35,
        "command_end": 35
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こういうのって朝あんまり時間がとれない時に\nいいよな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000039:dialogue:000",
        "source": {
          "scenario_id": "1_5_004ter_1_5_004_01",
