        "source_hash": "sha256:543531826d84f623d4c706dc3fc83b0476cae79223700e2c3df2c8d071bb70f5"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "004ter",
        "sourceName": "天道 輝"
