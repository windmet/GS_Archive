    {
      "kind": "dialogue",
      "source_text": "それじゃ……ん、キレのある味でうまい！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000028:dialogue:000",
        "source": {
