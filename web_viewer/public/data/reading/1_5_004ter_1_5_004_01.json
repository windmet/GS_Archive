    {
      "kind": "dialogue",
      "source_text": "特に寝坊なんてしたら、\nコーヒーを淹れてる時間なんてとれないし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
