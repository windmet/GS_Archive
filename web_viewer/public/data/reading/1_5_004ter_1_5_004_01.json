          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:b24e2fb505595dfdf235f4385920451b79bc277856e4871ef3d2d8a6cd47e88e"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
