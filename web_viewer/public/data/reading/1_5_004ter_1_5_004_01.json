    {
      "kind": "dialogue",
      "source_text": "今回オファーをいただいたCMで使う\nインスタントコーヒーのサンプルです。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000016:dialogue:000",
        "source": {
