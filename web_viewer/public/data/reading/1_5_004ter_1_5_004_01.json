          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:efdf4e89f79d62d00117512db5ddd4c6983ebe485ea4b2a675a2477015563760"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
