        "command_start": 39,
        "command_end": 39
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "特に寝坊なんてしたら、\nコーヒーを淹れてる時間なんてとれないし。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000043:dialogue:000",
        "source": {
          "scenario_id": "1_5_004ter_1_5_004_01",
