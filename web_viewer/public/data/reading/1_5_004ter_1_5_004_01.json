      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あっという間にお湯に溶けましたね。\n輝さん、どうぞ飲んでみてください。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000022:dialogue:000",
        "source": {
