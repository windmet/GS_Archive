        "command_start": 43,
        "command_end": 43
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "さっとお湯に溶かせば、うまいコーヒーが飲める上に\n目も覚める！　サイコーだろ！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000049:dialogue:000",
        "source": {
          "scenario_id": "1_5_004ter_1_5_004_01",
          "part_id": "1_5_004_01",
          "file": "assets/resources/scenariodata/1_5_004ter/scenario_1_5_004_01.json",
          "command_index": 49,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:af0177f476cb8e3d94cf4718a958c030c218171b44aa83b31f7c528ae10a08ee"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "004ter",
        "sourceName": "天道 輝"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "004ter"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "004ter",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_004ter_1_5_004_01:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_5_004_01",
