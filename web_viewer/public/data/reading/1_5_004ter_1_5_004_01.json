          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:934e67e8858f7a74791f2aeab6bc2dbc5df58ef682c71bab1c39d64a6adbb53e"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "004ter",
        "sourceName": "天道 輝"
      },
      "performance": {
