        "command_start": 49,
        "command_end": 49
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "確かに、手軽においしいコーヒーが飲めたら\n朝から気合いも入りそうですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_004ter_1_5_004_01:1_5_004_01:cmd-000053:dialogue:000",
        "source": {
          "scenario_id": "1_5_004ter_1_5_004_01",
          "part_id": "1_5_004_01",
          "file": "assets/resources/scenariodata/1_5_004ter/scenario_1_5_004_01.json",
          "command_index": 53,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:64cb5c5ea2bce417d78d43d5df048b200fb6e9c921410a24f553a666eaba5009"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_004ter_1_5_004_01:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": "1_5_004_01",
        "source_file": "assets/resources/scenariodata/1_5_004ter/scenario_1_5_004_01.json",
        "command_start": 53,
        "command_end": 53
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ！　コーヒー飲んで頭もすっきりしたことだし、\nもう少し仕事について確認してもいいか？",
