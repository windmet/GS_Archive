        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "中でも人気なのは練りきりでして、\n私もお茶菓子としていただいたことがあります。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "019kur"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "019kur",
        "presence": "visible",
