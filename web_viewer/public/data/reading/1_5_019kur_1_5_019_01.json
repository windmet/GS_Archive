    {
      "kind": "dialogue",
      "source_text": "こちらは今年で創業80年になる\n老舗の和菓子屋です。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000016:dialogue:000",
        "source": {
