    {
      "kind": "dialogue",
      "source_text": "九郎さん、お疲れさまです。\nとても興味を惹かれるリポートでした！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
