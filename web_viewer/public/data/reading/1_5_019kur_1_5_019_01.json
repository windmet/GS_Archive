    {
      "kind": "dialogue",
      "source_text": "本日は新作の練りきりを\nリポートしていきたいと思います。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_019kur_1_5_019_01:1_5_019_01:cmd-000022:dialogue:000",
