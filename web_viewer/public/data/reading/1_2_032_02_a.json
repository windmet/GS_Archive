        "step_index": 10,
        "source_part_id": "1_2_032_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まあオレは、誕生日パーティーぐらいで\nイッキイチユー？　したりしないけどな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "performance": {
        "entityType": "idol",
