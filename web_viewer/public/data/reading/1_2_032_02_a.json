        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だから、なおくんにも喜んでほしいんだ。\nもちろん、しろうくんのお誕生日会もするよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
