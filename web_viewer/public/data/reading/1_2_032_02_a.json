        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_032_02_a:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_2_032_02_a",
