    {
      "kind": "dialogue",
      "source_text": "もうすぐ、なおくんのお誕生日だね。\n今年はどうしよっか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
