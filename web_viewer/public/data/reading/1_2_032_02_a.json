        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "んあ？　どうするって？\nあ、誕生日会をやるってことか！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "033shr"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "033shr",
        "presence": "visible",
