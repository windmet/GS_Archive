        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "とーぜんだよ！　かのん、お誕生日パーティー\nしてもらって、すっごくうれしかったもん。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "034kan"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "034kan",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
