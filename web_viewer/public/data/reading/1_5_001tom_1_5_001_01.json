    {
      "kind": "dialogue",
      "source_text": "そのためにも、今は練習あるのみだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
