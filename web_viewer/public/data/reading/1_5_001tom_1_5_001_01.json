    {
      "kind": "dialogue",
      "source_text": "アニメ映画の声優か、ワクワクするな！\nしかも大人も子供も楽しめるタイプの映画だろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
