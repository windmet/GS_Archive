        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「そんなことないよ。素晴らしいものは、\n素晴らしい。王子だって、理解してくれるはずだ」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
