      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ひと口食べれば、あら不思議！\nぽわわ～んと幸せな気持ちになるでにゃんす。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
