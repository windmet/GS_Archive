      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "和風の味わいで、口に運ぶたび、\nどれもが『忘れられない味』になるでしょう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
        "entityType": "idol",
