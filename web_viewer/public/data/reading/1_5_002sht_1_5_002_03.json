    {
      "kind": "dialogue",
      "source_text": "いよいよ本番か～。今まで取材してたみんなと\n一緒に踊れるなんて楽しみだなぁ～！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000016:dialogue:000",
        "source": {
          "scenario_id": "1_5_002sht_1_5_002_03",
