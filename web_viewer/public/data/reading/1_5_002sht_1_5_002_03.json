      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "初めて取材した日はさ、みんな一生懸命だったけど\nどこかまとまりがなかったんだよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000024:dialogue:000",
        "source": {
