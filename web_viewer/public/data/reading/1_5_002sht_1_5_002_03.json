          "file": "assets/resources/scenariodata/1_5_002sht/scenario_1_5_002_03.json",
          "command_index": 16,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:5fd3a7289e8a1cfad627bae1e09d4cb7265e6db42f1360a9940950cc8c5da9af"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "002sht",
        "sourceName": "御手洗 翔太"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "002sht"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "002sht",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
