        "command_start": 16,
        "command_end": 16
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ダンス好きの翔太さんにはぴったりの企画ですよね。\nダンス大会を目指す高校ダンス部に密着なんて。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000020:dialogue:000",
        "source": {
