      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でも、練習を続けていくうちに先輩も後輩も\n関係なくうちとけはじめてさ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_002sht_1_5_002_03:1_5_002_03:cmd-000027:dialogue:000",
        "source": {
