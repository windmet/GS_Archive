    {
      "kind": "dialogue",
      "source_text": "オススメのお店を発表し合ったり。その話をした\nおかげで、緊張せずに撮影に挑めました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
