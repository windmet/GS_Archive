    {
      "kind": "dialogue",
      "source_text": "撮影前に確認しとこうと思って、漫画アプリ見てた。\nどれも面白いから、つい夢中になっちゃうんだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
