    {
      "kind": "dialogue",
      "source_text": "特にこの漫画とか、予想外の展開が続くから、\n読むのが止められなくてさ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
