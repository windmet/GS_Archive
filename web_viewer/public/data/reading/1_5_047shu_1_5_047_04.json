    {
      "kind": "dialogue",
      "source_text": "こっちの新作漫画も、キャラが個性的だし、\nもっと人気が出てもいい気がする。……あ、そっか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
