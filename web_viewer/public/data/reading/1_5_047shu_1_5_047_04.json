        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺がCMに出れば、みんながこのアプリを知って、\nそうなれば当然、この漫画を読む人も増えるか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
