        "command_start": 19,
        "command_end": 19
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、問題ないよ。日の光は苦手だけど、\n仕事ともなればそうも言ってられないからね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000025:dialogue:000",
        "source": {
