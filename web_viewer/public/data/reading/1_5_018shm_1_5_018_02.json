      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今日のロケは港町の隠れたグルメ探しなので、\nこの日差しの中、かなり歩きます。…大丈夫ですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000019:dialogue:000",
        "source": {
          "scenario_id": "1_5_018shm_1_5_018_02",
          "part_id": "1_5_018_02",
          "file": "assets/resources/scenariodata/1_5_018shm/scenario_1_5_018_02.json",
          "command_index": 19,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:f1e1c3adb14f69cac27bbba4f0899926727020a3a0bf247df613fa892baf5e75"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
