    {
      "kind": "dialogue",
      "source_text": "だから、気にしないでおくれ。スポットライトが\n当たる仕事の方がいいのは確かだけどね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000035:dialogue:000",
