        "command_end": 25
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "大抵の仕事はこなしてみせる。そう言って、\nこの仕事を引き受けたのはアタシじゃないか。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_018shm_1_5_018_02:1_5_018_02:cmd-000029:dialogue:000",
        "source": {
