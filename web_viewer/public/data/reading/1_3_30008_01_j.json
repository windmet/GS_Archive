      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わかります。みなさんが歌っているところを\n見たおかげか、指示通り元気に歌えました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
