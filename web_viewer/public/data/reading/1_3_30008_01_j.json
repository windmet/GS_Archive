    {
      "kind": "dialogue",
      "source_text": "何だか、一緒に歌ってるみたいで楽しかったです！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
