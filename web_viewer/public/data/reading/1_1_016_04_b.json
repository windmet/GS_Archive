        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "有名生徒会長で『最強』って呼ばれる鋭心先輩と、\n『賞キラー』の百々人先輩について話したんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "047shu"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "047shu",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
