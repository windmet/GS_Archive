      "kind": "dialogue",
      "source_text": "……賞キラーが持ってるのは、中途半端な賞だけ。\nキミやマユミくんに並べるほど、凄い人じゃないよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
