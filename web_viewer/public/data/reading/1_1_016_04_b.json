    {
      "kind": "dialogue",
      "source_text": "僕やマユミくんをアイドルにって紹介してくれたのは、\nアマミネくんだったって、ホント？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "花園 百々人"
