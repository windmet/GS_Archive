        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、はい。プロデューサーにスカウトされた後、\n一緒に組みたい人はいるかって聞かれたので……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天峰 秀"
      },
      "performance": {
