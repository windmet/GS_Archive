        "step_index": 14,
        "source_part_id": "1_3_30017_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まずは楽しんでみるとええ！\nそれじゃ、涼。対戦よろしく頼む！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
