        "step_index": 8,
        "source_part_id": "1_3_30017_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…今日一日で全てに触れるのは、難しそうだ。\nやはり筐体の数が多いものが、人気なんだろうな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "043kaz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "043kaz",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30017_01_c:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_3_30017_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ずらっと並んでると、圧倒されちゃいますよね。\n……あ、このゲームは動画で見たことあるやつだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "041ryo"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "041ryo",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30017_01_c:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_3_30017_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おお、ほうか！　これは二人プレイの対戦形式\nらしいのぉ。最初はこれで遊んでみるとするか！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "042dai"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "042dai",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 14
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30017_01_c:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_3_30017_01_c",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うん！　でも、プレイするのは初めてなんだよね。\n上手くできるかな……？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "041ryo"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "041ryo",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 15
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
