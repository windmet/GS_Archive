        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…勉強のために、一通り触れてみる予定\nだったんだが種類が豊富で……まだ迷っている。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "043kaz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "043kaz",
        "presence": "unknown",
