        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "昔から、よくやってたもんな～。\nで、どうやったらなおくらい強くなれるんだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
