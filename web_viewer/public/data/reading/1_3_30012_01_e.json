    {
      "kind": "dialogue",
      "source_text": "今日は、なおくんが大活躍する日だね～。\nなおくん、すっごく将棋強いんだよ～！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "performance": {
