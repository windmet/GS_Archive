    {
      "kind": "dialogue",
      "source_text": "皆様から事前にいただいた内容を読み上げますね。\nまず、一つ目ですが……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "司会"
      },
      "performance": {
        "entityType": null,
