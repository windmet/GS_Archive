        "source_part_id": "1_3_10007_01_j",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "一人では無理でも、同じ夢を見ている人となら、\nいろいろなことを乗り越えられるよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "都築 圭"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "007kei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "007kei",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 19
