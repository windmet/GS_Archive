          "end_step_index": 41,
          "target_step_index": 39
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "えーっと……コホンッ！　では、次の問題です！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
