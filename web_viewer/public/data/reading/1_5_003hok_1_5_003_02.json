      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "CMの概要としてはその車で女性とデートを\nしている風なシチュエーション、ということですね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
