    {
      "kind": "dialogue",
      "source_text": "ただ、一人芝居になってしまうじゃないですか。\n違和感を抱かせないようにしないといけなくて。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
