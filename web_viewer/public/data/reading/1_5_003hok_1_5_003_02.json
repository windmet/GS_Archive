    {
      "kind": "dialogue",
      "source_text": "俺とデートしているのはCMを見ている\nプリンセスですからね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
