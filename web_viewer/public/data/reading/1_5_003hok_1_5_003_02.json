    {
      "kind": "dialogue",
      "source_text": "そう。でも実際に女性キャストはいないんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
