    {
      "kind": "dialogue",
      "source_text": "ジュンは中学の時、\n『神童・冬美旬』って呼ばれてたんだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
