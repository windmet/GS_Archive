    {
      "kind": "dialogue",
      "source_text": "アイドルになってからの経験は、どれも思い出深い\nけれど……特に感謝祭はひときわそうかもしれない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
