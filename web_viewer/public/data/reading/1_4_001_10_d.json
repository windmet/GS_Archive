        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あのとき以上にパワフルになった\nCafe Paradeのステージ、今日は見せちゃおうねっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "031sak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "031sak",
