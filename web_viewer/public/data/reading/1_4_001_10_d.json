      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ファンの応援か……たしかに、\nファンがいなけりゃこんなトコまで来れなかったぜ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "紅井 朱雀"
      },
      "performance": {
