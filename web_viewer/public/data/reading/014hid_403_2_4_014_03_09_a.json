    {
      "kind": "dialogue",
      "source_text": "家族からも、いい写真だって言ってもらったぜ。\n和風のデザインが、爺さんたちにも好評だ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
