  "rows": [
    {
      "kind": "dialogue",
      "source_text": "しろうくん、かのんくん。\n残念だけど、もらったお仕事は一生懸命やろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
