          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー……。\nそうだよな。オレ、弱気になってた！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
