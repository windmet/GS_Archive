          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こっちには、すっげー数の仲間がいるんだ。\nこれくらい、なんてことねーぜっ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "inline_translation": null,
