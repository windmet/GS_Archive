      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あんまりレッスン期間がないから、\n本番うまくいかないかもしれないけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "inline_translation": null,
      "has_voice": true,
