          "end_step_index": 35,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "315プロダクションのみんなが、\n大会のためにここまで頑張ってきたんだから。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_f:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もふもふえんも、315プロと、\nファンのみんなのために頑張ろう！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "岡村 直央"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_f:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "narration",
      "source_text": "なお……。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_06_f:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうだよね。だって、「もふもふえんのお芝居が\n楽しみです！」ってメッセージをくれた人もいたよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_f:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もし出ないって聞いたら、がっかりしちゃう！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "姫野 かのん"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_f:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でもさ……。うまくできなくて\nがっかりされたらどうするんだよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "橘 志狼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_06_f:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 11
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そんな時は、次も、\n315プロダクションのみんなで頑張りましょう。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_06_f:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_002_06_f",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_06_f.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "全員でなら、どんな事があっても乗り越えられます！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_06_f:step-16:text",
