    {
      "kind": "dialogue",
      "source_text": "今回の賞品は春名さんに事前に答えていただいた\nアンケートで決めたそうです。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
