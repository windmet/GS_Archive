    {
      "kind": "dialogue",
      "source_text": "ああ！　いろんなアトラクションにチャレンジして\n賞品をゲットするなんて、すげー楽しそうだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "performance": {
        "entityType": "idol",
