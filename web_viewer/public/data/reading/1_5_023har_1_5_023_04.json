      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "クジで決めるから、直前まで何のアトラクションを\nやるかわからないってのも面白いよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "若里 春名"
      },
      "performance": {
        "entityType": "idol",
