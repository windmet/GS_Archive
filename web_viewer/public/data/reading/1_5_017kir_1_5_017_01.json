    {
      "kind": "dialogue",
      "source_text": "ふっふっふ……。何を隠そう、ワガハイは\n寄席の後のらーめんが大好物でにゃんす！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "猫柳 キリオ"
      },
      "performance": {
        "entityType": "idol",
