      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ワガハイも気になっていたでにゃんすが、\nなかなか行く機会がなかったぞなもし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "猫柳 キリオ"
      },
