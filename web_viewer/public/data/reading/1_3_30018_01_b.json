      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "演じなきゃって思って、つい体に力が入ってたかも。\nさすが北斗君！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
