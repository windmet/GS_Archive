      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アドバイスする側が固くなると、相手も緊張するから\nね。相手の背中を押してあげる感じでやってみたら？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
