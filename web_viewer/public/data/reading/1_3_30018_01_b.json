      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "翔太は、もっと自然体を意識した方がいいかもね。\n演技するよりも、その方が相手の心に届くと思うよ☆",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
