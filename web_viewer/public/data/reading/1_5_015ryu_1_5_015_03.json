    {
      "kind": "dialogue",
      "source_text": "今日は老舗和食店の職人さんを\n紹介するんだよな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
