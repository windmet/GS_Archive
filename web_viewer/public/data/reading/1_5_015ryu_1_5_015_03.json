    {
      "kind": "dialogue",
      "source_text": "今日は老舗和食店の職人さんを\n紹介するんだよな！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_015ryu_1_5_015_03:1_5_015_03:cmd-000017:dialogue:000",
        "source": {
