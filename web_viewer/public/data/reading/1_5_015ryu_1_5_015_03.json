        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今回の仕事で、職人さんが積んできた\n経歴とかについてもインタビューするんだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "015ryu"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "015ryu",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_015ryu_1_5_015_03:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "少し緊張するけど……人生の先輩でもあるから\n色んな話を聞いてみようと思うんだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "015ryu"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "015ryu",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_015ryu_1_5_015_03:step-12:text",
        "step_id": 12,
