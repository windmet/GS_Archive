    {
      "kind": "dialogue",
      "source_text": "あけましておめでとうございます。\n皆さん、お正月はゆっくり休めましたか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "5_00_006_23_5_00_006_23:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺は、姉貴と弟と初売りに行ったんだけど、\n人混みでもみくちゃにされて大変だったよ……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "015ryu"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "015ryu",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
