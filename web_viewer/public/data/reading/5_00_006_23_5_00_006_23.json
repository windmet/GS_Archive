    {
      "kind": "dialogue",
      "source_text": "おはよう、プロデューサー。あけましておめでとう！\n今日から仕事始めだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
