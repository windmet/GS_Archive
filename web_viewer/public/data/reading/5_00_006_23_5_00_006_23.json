        "step_index": 11,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "初詣では、FRAMEの仕事についても\n祈願しておいたぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "016sei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "016sei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_00_006_23_5_00_006_23:step-13:text",
        "step_id": 13,
        "step_index": 12,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ありがとうございます！\nよーし、今年もアイドル頑張るぞー！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
        "entityType": "idol",
