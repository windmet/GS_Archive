    {
      "kind": "dialogue",
      "source_text": "うまいは、電子レンジとこれで作れる。\nまさにこの商品のコンセプト通りじゃ！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_04:1_5_042_04:cmd-000030:dialogue:000",
