    {
      "kind": "dialogue",
      "source_text": "はぁ～～～。\n緊張しすぎて心臓がバクバクしてきたぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
      },
