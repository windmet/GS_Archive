      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "展示会を見てからここに来たという方は、\nどれくらいいらっしゃるのでしょうか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "清澄 九郎"
      },
      "performance": {
