    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサーさん、\nリハーサル、とっても、楽しかった！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
