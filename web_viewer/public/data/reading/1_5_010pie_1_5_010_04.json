    {
      "kind": "dialogue",
      "source_text": "リハーサル終わったあと、お話した。\nボクもみんなも、ニコニコ。笑顔、いっぱいだった！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
