    {
      "kind": "dialogue",
      "source_text": "ありがとう！　でも、演技の時だけイキイキ、\nちがう。ボク、みんなと一緒にいる、楽しい！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000047:dialogue:000",
