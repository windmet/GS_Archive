    {
      "kind": "dialogue",
      "source_text": "ふふ、舞台上のピエールさん、\nとてもイキイキしていました！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_010pie_1_5_010_04:1_5_010_04:cmd-000039:dialogue:000",
