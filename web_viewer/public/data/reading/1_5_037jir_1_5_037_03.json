        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あはは、自分で猫じゃらしを持ってくるなんて\n器用だねえ。いいよ、おいで。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "037jir"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "037jir",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_037jir_1_5_037_03:step-10:text",
