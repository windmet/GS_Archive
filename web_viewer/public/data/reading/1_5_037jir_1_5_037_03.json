        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そっちの子は……ん？\n猫じゃらしで遊んでほしいの？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "037jir"
