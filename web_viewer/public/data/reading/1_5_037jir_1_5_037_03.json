        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すごいですね、次郎さん！\n猫たちにすっかり懐かれています。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
