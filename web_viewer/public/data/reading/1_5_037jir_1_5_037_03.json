    {
      "kind": "dialogue",
      "source_text": "おっ、毛並みが整ってるねえ。\nこうやって撫でられるのが好きなんだ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
