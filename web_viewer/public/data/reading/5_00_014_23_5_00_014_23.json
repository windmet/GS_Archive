      "kind": "dialogue",
      "source_text": "…その後、本屋にも付き合ってもらったんだ。\nおかげで欲しい本が買えた。…2人ともありがとう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
