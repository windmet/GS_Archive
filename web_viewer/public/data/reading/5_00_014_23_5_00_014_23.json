    {
      "kind": "dialogue",
      "source_text": "おう！　ここに来る前に3人でお参りしてきたぞ！\nおみくじを引いて、今年一年を占ってきた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
      },
      "performance": {
