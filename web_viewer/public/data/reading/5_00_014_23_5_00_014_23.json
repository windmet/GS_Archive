        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みんな、いい結果でしたよ！\n今年一年もみんなで頑張ろう、って思う内容でした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
