      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こちらこそ！　一希さんにオススメしてもらった本、\n読み終わったら感想聞いてくださいね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
