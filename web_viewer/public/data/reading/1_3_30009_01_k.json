    {
      "kind": "dialogue",
      "source_text": "はは、確かにそれは少々気恥ずかしいが\n応援してもらえるのは、ありがたいことだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
