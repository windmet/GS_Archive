        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あっ、カメラマンさんを受け止めた時の写真ですね。\nありがとうございます！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "木村 龍"
      },
      "performance": {
