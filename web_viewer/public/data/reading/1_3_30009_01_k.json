    {
      "kind": "dialogue",
      "source_text": "だが、みんな良い顔をしてる。\n特に龍のこの写真なんて、頼もしくていいな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "信玄 誠司"
      },
