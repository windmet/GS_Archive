    {
      "kind": "dialogue",
      "source_text": "俺の家族も買ったみたいで……リビングに\nこれが置いてあって、ちょっと恥ずかしかったです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
