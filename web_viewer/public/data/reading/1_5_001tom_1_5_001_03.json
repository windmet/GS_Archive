      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だから、みんながうまそうに食ってる時の\n表情を参考にしようと思ってんだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
