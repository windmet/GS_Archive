    {
      "kind": "dialogue",
      "source_text": "それならバリエーションも増やせると思うし。\nいい考えだろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
