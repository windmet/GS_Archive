      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "CMでも、チョコレートを食べた時の表情を\nいくつか撮るって言ってたよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
