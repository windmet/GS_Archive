    {
      "kind": "dialogue",
      "source_text": "今度のCMで宣伝するチョコレートが事務所に\n届いていましたが、冬馬さんは食べましたか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_001tom_1_5_001_03:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、食べたぜ！　箱一杯に送ってくれるなんて\n嬉しいよな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "visible",
