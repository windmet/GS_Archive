        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "何気ない雑談も、役作りのひとつになっている\nように思います。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
