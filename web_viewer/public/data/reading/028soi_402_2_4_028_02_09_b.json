    {
      "kind": "dialogue",
      "source_text": "特に眉見さんとは、掛け合いの練習をしたり、\n雑談をしたりすることも多いですね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
