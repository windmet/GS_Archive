    {
      "kind": "dialogue",
      "source_text": "今回のドラマでは、私たち2人がテンポよく\n会話をしなければならない場面もありますから。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
