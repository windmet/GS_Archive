    {
      "kind": "dialogue",
      "source_text": "演者もスタッフさんも熱心な方々ばかりなので、\n相談や準備も丁寧です。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
