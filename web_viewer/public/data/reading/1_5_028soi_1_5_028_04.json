    {
      "kind": "dialogue",
      "source_text": "本日はこの近くで行われる、\n世界各国のお菓子の祭典にお邪魔します。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
