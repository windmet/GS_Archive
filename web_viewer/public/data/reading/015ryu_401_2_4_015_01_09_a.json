    {
      "kind": "dialogue",
      "source_text": "俺だけじゃ食べられないし、今度事務所へ\n持っていこうと思うんだけど、どうかな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
