    {
      "kind": "dialogue",
      "source_text": "よかった！　いつも通る道が工事中だったんだけど、\n迂回した先で、こんなラッキーに巡り合えたんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
