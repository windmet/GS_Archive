    {
      "kind": "dialogue",
      "source_text": "あ、ラッキーといえば芸術祭の時もそうだよな。\n転んで絵具をこぼしちゃったのは不運だけど……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
