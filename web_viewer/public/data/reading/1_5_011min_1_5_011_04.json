    {
      "kind": "dialogue",
      "source_text": "あ、みのりさん。\n挨拶回りをしていたので、大丈夫ですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
