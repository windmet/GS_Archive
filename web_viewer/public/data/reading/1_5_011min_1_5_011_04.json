      "kind": "dialogue",
      "source_text": "今回のCMは花のいい香りがする\n入浴剤だったからね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000027:dialogue:000",
        "source": {
