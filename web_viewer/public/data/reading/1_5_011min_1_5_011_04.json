    {
      "kind": "dialogue",
      "source_text": "CM撮影、お疲れさまでした！\n収録後はスタッフさんと盛り上がっていましたね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_011min_1_5_011_04:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今回のCMは花のいい香りがする\n入浴剤だったからね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_011min_1_5_011_04:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "リラックス用のカモミールにラベンダー、\nそれに甘い香りが広がる撫子。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_011min_1_5_011_04:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "スタッフさんとどれが一番いいかとか、新しく種類を\n増やすならどんな花がいいかで盛り上がってね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_011min_1_5_011_04:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": null,
