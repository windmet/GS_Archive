    {
      "kind": "dialogue",
      "source_text": "いつも仕事で忙しそうだから、\n入浴剤を入れたお風呂にゆっくり浸かって休んでね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
