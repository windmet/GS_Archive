    {
      "kind": "dialogue",
      "source_text": "CM撮影、お疲れさまでした！\n収録後はスタッフさんと盛り上がっていましたね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000024:dialogue:000",
        "source": {
