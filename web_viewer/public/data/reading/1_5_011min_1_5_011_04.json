    {
      "kind": "dialogue",
      "source_text": "あ、みのりさん。\n挨拶回りをしていたので、大丈夫ですよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_011min_1_5_011_04:1_5_011_04:cmd-000020:dialogue:000",
