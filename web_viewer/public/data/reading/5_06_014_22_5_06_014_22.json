        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "Wの2人からも、スタジオの予約が詰まってるから\n一緒にレッスンしようって誘いが来てたな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
