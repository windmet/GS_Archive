    {
      "kind": "dialogue",
      "source_text": "事務所の予定表、レッスンの予定でびっしり\n埋まってたな！　みんな追い込みをかけてるのか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "performance": {
