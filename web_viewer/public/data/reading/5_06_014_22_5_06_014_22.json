    {
      "kind": "dialogue",
      "source_text": "全員が同じライブに向けて練習してるせいか、\n事務所の中も熱気であふれてる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "038tak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "038tak",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_06_014_22_5_06_014_22:step-5:text",
