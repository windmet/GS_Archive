        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ。大切な節目でもあるし、気合いが入るよな。\n自分もどんどん本番が楽しみになってきた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "performance": {
        "entityType": "idol",
