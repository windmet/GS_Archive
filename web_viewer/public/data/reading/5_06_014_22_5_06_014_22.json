    {
      "kind": "dialogue",
      "source_text": "何のライブだろうが最強はオレ様だ！\nくはは！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "performance": {
