          "end_step_index": 41,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その服、かわいいっすね。すげー似合ってますよ！\n服っつーか、あんたがかわいい……っつーか……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "inline_translation": null,
