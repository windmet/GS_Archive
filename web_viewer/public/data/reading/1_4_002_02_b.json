      "kind": "dialogue",
      "source_text": "こういうのはあいつの得意分野だろうが、\n俺はあいつにも負けたくねーんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
