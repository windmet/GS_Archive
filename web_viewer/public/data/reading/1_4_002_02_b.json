          "start_step_index": 0,
          "end_step_index": 41,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "数十分後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
