    {
      "kind": "dialogue",
      "source_text": "ああ。あ、ちなみに北斗には聞かなくていいからな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
