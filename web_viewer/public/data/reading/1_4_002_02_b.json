    {
      "kind": "dialogue",
      "source_text": "Beitの三人に『とっておきのファンサービス』を\n聞いてきてほしいんだ。明日会うんだろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "inline_translation": null,
