          "end_step_index": 41,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（ん。風呂のおかげで喉の調子がいいし、最初\nダメだったあの台詞も、もう一回試してみるか！）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
