      "kind": "dialogue",
      "source_text": "だから、家でいろいろと自主練してるんだが…。\n正直、あんま自信がねぇ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
