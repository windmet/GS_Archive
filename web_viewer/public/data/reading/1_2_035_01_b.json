    {
      "kind": "dialogue",
      "source_text": "いずれも授業に興味を持って貰うために\n行ったのだが、あまり効果は得られなかったな……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "performance": {
