        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_2_035_01_b",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それは、誰かに強制されるよりも身に付くはずだ。\n……うむ。いい着眼点だな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "035mco"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "035mco",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
