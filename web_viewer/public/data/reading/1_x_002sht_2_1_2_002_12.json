    {
      "kind": "dialogue",
      "source_text": "事務所を飯で埋め尽くす気か！？\n確かに、おまえならぺろっと\nたいらげそうだけどよ……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
