        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おまえにはいつもアレコレ\n作ってやってんだろ……。\nまあ、美味かったならよかった。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
