      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今日はいっぱい面白いものが\n撮れちゃったな～。\nあ、北斗君にも動画送るね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
