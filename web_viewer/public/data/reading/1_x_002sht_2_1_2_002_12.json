      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ケーキを崩さないように\nかなり気を遣ってたよね。\nふふ、あれは職人の顔だったな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
