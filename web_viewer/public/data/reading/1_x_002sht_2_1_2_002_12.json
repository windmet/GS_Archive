        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "和洋中、色んなジャンルを\n網羅できたね。\n翔太の喜ぶ顔が目に浮かぶよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "003hok"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "003hok",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_002sht_2_1_2_002_12:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、間違いないぜ。\n今度ラジオで感想を言うらしいが\nこれなら心配いらねえ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_002sht_2_1_2_002_12:step-8:text",
