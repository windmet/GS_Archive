    {
      "kind": "synopsis",
      "source_text": "自分の誕生日にはごちそうが食べたいと\n冬馬と北斗にリクエストする翔太。\n期待を膨らませている様子の翔太のために、\n事務所のキッチンを借りて2人が特別に\n用意したものとは……。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
