      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "冬馬君がものすっごく真剣な顔で\nケーキにロウソク立ててるとこ\nなんて、もう最高！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "御手洗 翔太"
      },
      "performance": {
