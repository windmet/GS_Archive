        "step_index": 0,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お疲れさま。冬馬の方は順調？\n俺は行きつけのお店から、\nアラカルトを受け取ってきたよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "伊集院 北斗"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "003hok"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "003hok",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 4
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_002sht_2_1_2_002_12:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おう。こっちも後は盛り付けで\n大体終わりだ。朝早くから\n作り始めたのにギリギリだぜ……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_002sht_2_1_2_002_12:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "けど、どれも自信作だ。\nこんだけ用意すれば\nあいつも満足するだろ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "001tom"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "001tom",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
