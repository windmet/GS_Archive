        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あのような調理方法があったとは……。\nふふ、勉強になりました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
