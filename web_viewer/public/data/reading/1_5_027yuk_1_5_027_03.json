    {
      "kind": "dialogue",
      "source_text": "幸広さんは執事役で、密かに恋心を寄せる\nお嬢様のために紅茶を淹れます。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
