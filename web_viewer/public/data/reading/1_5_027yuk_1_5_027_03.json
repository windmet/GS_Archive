        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_5_027yuk_1_5_027_03:step-17:text",
        "step_id": 17,
        "step_index": 16,
        "source_part_id": null,
