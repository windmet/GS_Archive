        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そしてCMのコンセプトは\n『最高の一杯と、最高のひと時をあなたに』。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 16
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_5_027yuk_1_5_027_03:step-16:text",
        "step_id": 16,
        "step_index": 15,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "素敵なコンセプトだね。俺も紅茶を淹れる時は、\n最高のおもてなしをしたいと考えているよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "027yuk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "027yuk",
        "presence": "visible",
