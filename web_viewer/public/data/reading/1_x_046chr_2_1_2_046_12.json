        "step_id": 16,
        "step_index": 15,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "喜んでもらえて何よりだ。\nあれはプロデューサーと\n北村と相談して、注文したんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
