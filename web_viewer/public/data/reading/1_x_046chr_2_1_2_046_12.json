        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "雨彦さん、お待たせー。\nクリスさんの誕生日会の\n準備始めるー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "045sor"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "045sor",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 4
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_046chr_2_1_2_046_12:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、そうだな。\n古論なら、時間通りか、\n早めに来るだろうしな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_046chr_2_1_2_046_12:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その前に、俺はケーキを\n引き取ってくる。俺の用事も\nすぐに終わらせてくる。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_x_046chr_2_1_2_046_12:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よろしくねー。\nテーブルのセッティングとかは、\n終わらせておくからー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "045sor"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "045sor",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
