    {
      "kind": "synopsis",
      "source_text": "誕生日当日、クリスはいつも通り朝から海に\n潜り、その美しさに触れていた。家族や\nLegendersのメンバーから祝いのメッセージ\nが届き、朝日を受けた海面のように輝かしい\n特別な1日が始まる。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 1
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
