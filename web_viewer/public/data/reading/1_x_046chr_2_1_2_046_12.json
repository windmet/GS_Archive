        "step_index": 11,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "朝焼けの、照らす水面弾む声。\nクリスさんにとっていい誕生日\nになったなら、よかったよー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
        "entityType": "idol",
