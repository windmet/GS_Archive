        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "皆さんとゆっくりお話が\n出来ましたし、\nとても楽しい時間でした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
        "entityType": "idol",
