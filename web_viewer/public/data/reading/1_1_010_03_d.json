    {
      "kind": "dialogue",
      "source_text": "男性のダイナーは、\nまるで小さなサーカスのようでした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
