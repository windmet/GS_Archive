        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺も。神谷さんが旅をしていた頃の\n話、聞きたいです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
