      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "とある国を旅していた時に、追いはぎに遭って、\n一文無しになってしまったことがあったんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
