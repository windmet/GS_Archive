        "step_index": 16,
        "source_part_id": "1_1_010_03_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "まさに、人生最大のピンチを迎えていたところ。\n男性が現れ、倒れている俺に、こう声をかけたんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "027yuk"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "027yuk",
        "presence": "offstage",
        "reason": "actor-not-on-stage",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 18
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_1_010_03_d:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_1_010_03_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "「Hey boy！\nオレ様のダイナーで食ってけ。天国行けるぜ！」",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
