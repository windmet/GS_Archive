      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その旅の中での出会いが、\nこの店を作るきっかけになったんですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神谷 幸広"
      },
      "performance": {
