    {
      "kind": "dialogue",
      "source_text": "私が担当するのは、\n『ドキドキ☆無人島生活！』ですか……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "performance": {
        "entityType": "idol",
