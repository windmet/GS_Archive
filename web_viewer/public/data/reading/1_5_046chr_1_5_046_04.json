    {
      "kind": "dialogue",
      "source_text": "私が担当するのは、\n『ドキドキ☆無人島生活！』ですか……。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000027:dialogue:000",
