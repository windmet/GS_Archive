    {
      "kind": "dialogue",
      "source_text": "クリスさん、TV番組の仕事が決まりました。\nこちらが番組の企画書になります。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000018:dialogue:000",
        "source": {
