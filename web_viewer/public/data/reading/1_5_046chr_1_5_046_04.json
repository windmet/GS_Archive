    {
      "kind": "dialogue",
      "source_text": "クリスさん、TV番組の仕事が決まりました。\nこちらが番組の企画書になります。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
