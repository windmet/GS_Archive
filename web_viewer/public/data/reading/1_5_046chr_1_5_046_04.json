    {
      "kind": "dialogue",
      "source_text": "なるほど、三日間無人島で生活するんですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000031:dialogue:000",
