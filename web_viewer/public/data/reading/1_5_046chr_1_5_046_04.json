      "kind": "dialogue",
      "source_text": "はい。だからお任せください。\n必ずや無人島ロケを成功させてみせます。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000054:dialogue:000",
        "source": {
