        "command_start": 18,
        "command_end": 18
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "様々なコーナーのあるバラエティー番組ですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_046chr_1_5_046_04:1_5_046_04:cmd-000022:dialogue:000",
        "source": {
