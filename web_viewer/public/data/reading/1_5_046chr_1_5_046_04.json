      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "過酷なロケになることは間違いないです。\n大丈夫でしょうか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
