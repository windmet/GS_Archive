        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それもあるんだろうけど、\nあの3人はバンドのリーダーだったり、",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
