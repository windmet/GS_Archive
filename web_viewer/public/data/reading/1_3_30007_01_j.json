        "source_part_id": "1_3_30007_01_j",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ははっ。それじゃ俺が混じったら、\nもっと驚くだろうね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_30007_01:1_3_30007_01_j:cmd-000075:dialogue:000",
