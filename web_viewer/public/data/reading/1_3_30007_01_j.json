    {
      "kind": "dialogue",
      "source_text": "一番近いのが、鋭心くんか。\n2つ違いなら、それこそ話題が合うんじゃない？",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_30007_01:1_3_30007_01_j:cmd-000056:dialogue:000",
        "source": {
          "scenario_id": "1_3_30007_01",
          "part_id": "1_3_30007_01_j",
          "file": "assets/resources/scenariodata/1_3_30007_01/scenario_1_3_30007_01_j.json",
