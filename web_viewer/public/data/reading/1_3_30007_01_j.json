        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_3_30007_01_j",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ははっ。それじゃ俺が混じったら、\nもっと驚くだろうね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
