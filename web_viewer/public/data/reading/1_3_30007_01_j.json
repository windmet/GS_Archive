        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺、思ったんですけど……龍さんとみのりさんって、\n仲いいですよね。今も楽しそうに話してたし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋山 隼人"
      },
      "performance": {
        "entityType": "idol",
