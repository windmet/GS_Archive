  "rows": [
    {
      "kind": "dialogue",
      "source_text": "あの3人、仲良くなってきたなぁ。\n同年代だし、やっぱり息が合うのかな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
