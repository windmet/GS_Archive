    {
      "kind": "dialogue",
      "source_text": "……ははっ。3人も、俺たちと\n同じようなこと考えてたんだね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_30007_01:1_3_30007_01_j:cmd-000140:dialogue:000",
        "source": {
