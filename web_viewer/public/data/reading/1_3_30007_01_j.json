    {
      "kind": "dialogue",
      "source_text": "今、流行ってることとか、\n俺が学生だった頃と全然違って、驚きました。",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_30007_01:1_3_30007_01_j:cmd-000066:dialogue:000",
