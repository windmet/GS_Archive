        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いや、そうでもないんです。\n2学年の差は大きかったですよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_30007_01:1_3_30007_01_j:cmd-000059:dialogue:000",
        "source": {
