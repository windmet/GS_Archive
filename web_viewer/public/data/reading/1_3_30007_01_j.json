    {
      "kind": "dialogue",
      "source_text": "おっと、もうそんな時間か！\nゴメン、ついつい話し込んじゃってたよ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_3_30007_01:1_3_30007_01_j:cmd-000099:dialogue:000",
