        "step_index": 8,
        "source_part_id": "1_3_30007_01_j",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "渡辺さん、木村さん。俺たちの準備は終わりました。\n本番いけそうでしょうか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "眉見 鋭心"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "049eis"
