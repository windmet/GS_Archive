      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "unknown",
        "reason": "medium-policy-unavailable",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 3
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
