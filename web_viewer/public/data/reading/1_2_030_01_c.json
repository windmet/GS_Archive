      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "友達らしい友達が出来る前に、その街を\n離れていったので、入れなかったというか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
