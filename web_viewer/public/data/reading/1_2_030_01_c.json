      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "別れには慣れませんけど、転勤生活も\nそこまで悪くないと思っているんですよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
