      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "無人島でサバイバル生活とか、\n面白そうだと思わないか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_02:1_5_014_02:cmd-000028:dialogue:000",
        "source": {
