          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:8cbf793bc4d8befe8708b3eec10dd7fdfde38933a8ce522afa9d51a3f834e157"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "014hid",
        "sourceName": "握野 英雄"
