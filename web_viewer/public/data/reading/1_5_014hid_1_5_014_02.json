          "command_index": 23,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:de15b32c7a7d649668e6a76fb6b09e4971c1cd35a677a28080941bb15a90097b"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "014hid",
        "sourceName": "握野 英雄"
