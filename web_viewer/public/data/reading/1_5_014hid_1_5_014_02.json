        "command_start": 28,
        "command_end": 28
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あはは……英雄さんなら本当に楽しめそうですね。\nちなみに一人か誰かと一緒か、どっちがいいですか？",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_02:1_5_014_02:cmd-000033:dialogue:000",
