      "kind": "dialogue",
      "source_text": "やっぱり、同じユニットのお二人なんですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_02:1_5_014_02:cmd-000042:dialogue:000",
