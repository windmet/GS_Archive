        "command_start": 33,
        "command_end": 33
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "うーん……一人でも悪くないが、\nどうせなら信玄と龍も一緒がいいな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_02:1_5_014_02:cmd-000039:dialogue:000",
