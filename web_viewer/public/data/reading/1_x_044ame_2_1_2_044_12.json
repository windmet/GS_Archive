        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "味だけじゃなくて、\n店の雰囲気も良かった。\nいい所をありがとな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "044ame"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "044ame",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 18
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
