        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "本当、そういうところだよー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "performance": {
