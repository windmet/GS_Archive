    {
      "kind": "synopsis",
      "source_text": "とある日の打ち合わせ前。クリスは想楽と\nプロデューサーに、雨彦の誕生日に何か\nしないかと相談する。どんなことをしたい\nのか尋ねる想楽に、クリスはささやかな\nパーティを提案するのだった。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 1
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_x_044ame_2_1_2_044_12:step-1:text",
