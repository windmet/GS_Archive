        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_007_02_a:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_2_007_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だが、わたしはこういったイベントに\nあまり馴染みがない。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "008rei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "008rei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_007_02_a:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_2_007_02_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "家族に誕生日を祝われることはあるが、それ以外の人\nのお祝いとなると、何をすべきか悩んでしまってな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "008rei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "008rei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
