      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だが、確かにそのほうが、確実に\n喜んでもらえるお祝いができそうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
