        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "年に一度の誕生日だ。同じユニットのメンバー\nとして、何かお祝いをしたいと思っている。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽 麗"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "008rei"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "008rei",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
