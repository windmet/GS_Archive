      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "それも考えたが、直接聞いてしまっては\nサプライズではなくなってしまうと思って……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
