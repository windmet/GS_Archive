    {
      "kind": "dialogue",
      "source_text": "楽しそうに歌いますね。\n見ている私も、思わず笑顔になります。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
