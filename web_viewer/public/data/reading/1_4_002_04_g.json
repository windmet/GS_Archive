          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 34
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "さっきのオレ、\nちょっと熱くなってたかもしれないです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
