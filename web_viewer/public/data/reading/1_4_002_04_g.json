          "end_step_index": 44,
          "target_step_index": 35
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だから、もし薫さんに、\n何か嫌な思いをさせてたらって思うと……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
