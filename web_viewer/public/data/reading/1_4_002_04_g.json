          "end_step_index": 44,
          "target_step_index": 40
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "じいさんのレッスンは終わってる頃だろうけど、桜庭\nのことだし、居残りレッスンしてるんじゃないか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "inline_translation": null,
