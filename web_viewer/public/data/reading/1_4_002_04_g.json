          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 33
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あの……薫さんの様子って、どうでしょうか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
