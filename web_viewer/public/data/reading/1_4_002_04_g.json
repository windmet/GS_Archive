          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "薫さん？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
