          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だが、あの頃の笑い方までは思い出せそうにないな。\n……10年以上経っているんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_g:step-22:text",
        "step_id": 22,
        "step_index": 21,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 21
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すみません。ちょっと電話に出てきますね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_04_g:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もしもし、柏木です。早めに仕事が終わったので、\n今からレッスンスタジオに戻りますね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
