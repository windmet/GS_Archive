          "end_step_index": 44,
          "target_step_index": 41
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "翼と●●●●プロデューサーだけだと、\nあいつの相手は大変だろ？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "inline_translation": null,
      "has_voice": true,
