          "end_step_index": 44,
          "target_step_index": 38
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よお、●●●●プロデューサー。その……俺も、\n偶然早く仕事が終わったから、翼と合流してさ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
