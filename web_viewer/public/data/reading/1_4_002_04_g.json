    {
      "kind": "dialogue",
      "source_text": "本当ですか？　よかった……。あっ、そうだ。\n今、輝さんと一緒なんです。電話、代わりますね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "柏木 翼"
      },
      "inline_translation": null,
