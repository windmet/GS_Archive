        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 15
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……いや、これは確かめようもないな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_g:step-17:text",
        "step_id": 17,
        "step_index": 16,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 16
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー。\n僕の笑顔は、誰かの笑顔を作るんだろうか？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_04_g:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい！　今までも、\nたくさんの笑顔を作ってきたじゃないですか。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_04_g:step-19:text",
        "step_id": 19,
        "step_index": 18,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 18
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "きっと、これからもそうですよ。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_04_g:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そうか……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
