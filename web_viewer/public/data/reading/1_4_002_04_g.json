          "end_step_index": 44,
          "target_step_index": 42
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "だから、俺もレッスンスタジオに戻るよ。\nってことで、またあとでな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
