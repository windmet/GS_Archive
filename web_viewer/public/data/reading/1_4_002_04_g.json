        "step_index": 14,
        "source_part_id": "1_4_002_04_g",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_04_g.json",
          "start_step_index": 0,
          "end_step_index": 44,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なあ。\n僕が楽しそうにしていれば、姉さんも……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
