        "resolution": "resolved"
      }
    },
    {
      "kind": "dialogue",
      "source_text": "あはは、そう言うと思ってた。\nそれじゃお互いに、二次会を思いっきり楽しもう！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
