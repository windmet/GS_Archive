          "end_step_index": 31,
          "target_step_index": 20
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "先に行ってるから、\n片付けが終わったらみんなで来てくれる？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
