        }
      },
      "option": null
    },
    {
      "kind": "caption",
      "source_text": "数十分後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
