          "end_step_index": 31,
          "target_step_index": 27
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "あ、お店に着いた。\n先に入って、席で待ってるね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
