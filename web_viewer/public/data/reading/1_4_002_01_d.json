      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "●●●●プロデューサー、\n二次会のお店が見つかったよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
