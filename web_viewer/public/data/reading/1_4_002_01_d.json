      }
    },
    {
      "kind": "dialogue",
      "source_text": "もしかして、挑戦状のこと？\nもちろん思うところはあるけど……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_01_d:step-25:text",
        "step_id": 25,
        "step_index": 24,
        "source_part_id": "1_4_002_01_d",
