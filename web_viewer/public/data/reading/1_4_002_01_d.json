          "end_step_index": 31,
          "target_step_index": 24
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そんな事より、今は\n●●●●プロデューサーを労うことが大事だよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
