          "command_index": 16,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:dc75037930e72aa95a3b90984cac8fbbc33b251022d9a67b8e058765e2bb954d"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "041ryo",
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "041ryo"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "041ryo",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "entry-settled-actor-difference"
