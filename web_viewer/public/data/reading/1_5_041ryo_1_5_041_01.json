          "command_index": 25,
          "field_kind": "dialogue",
          "field_ordinal": 0
        },
        "source_hash": "sha256:9100984fc3a3512e61ba2dcd74a71df65105f91e3fe58ae74e236cc23dcf7741"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
