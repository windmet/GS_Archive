        "command_start": 16,
        "command_end": 16
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……あ、すみません。仕事なのにはしゃいじゃって。\n落ち着かないといけませんよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000022:dialogue:000",
