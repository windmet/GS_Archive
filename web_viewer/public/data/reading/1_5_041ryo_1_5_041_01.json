        "command_start": 25,
        "command_end": 25
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わかりました！　リポートでこの遊園地の楽しさを\nたくさん伝えられるよう、頑張ります！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000032:dialogue:000",
        "source": {
