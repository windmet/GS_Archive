      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そのままで大丈夫です。今回のリポートのお仕事は、\n普段の涼さんの姿が求められていますから！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000025:dialogue:000",
        "source": {
          "scenario_id": "1_5_041ryo_1_5_041_01",
