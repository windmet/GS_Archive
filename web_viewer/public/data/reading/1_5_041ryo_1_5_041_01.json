      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よろしくお願いします。では早速、番組のサイトに\n載せるオフショットの撮影に行きましょうか。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_041ryo_1_5_041_01:1_5_041_01:cmd-000036:dialogue:000",
        "source": {
