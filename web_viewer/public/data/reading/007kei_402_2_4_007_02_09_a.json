        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "写真の向こうから、屋敷で鳴っていた風音や\nお化け役のみんなの声が聞こえてきそうだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
