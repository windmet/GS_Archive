    {
      "kind": "dialogue",
      "source_text": "こうして実際にポスターになると、\n本当にお化けが実在しているみたいだね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
