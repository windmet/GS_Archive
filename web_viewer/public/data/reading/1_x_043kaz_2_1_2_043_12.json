        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いいんですか？\nありがとうございます。\n楽しみにしてますね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "秋月 涼"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "041ryo"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "041ryo",
