        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "気付いてくれたのか！\n二人の力作じゃけぇのぉ！\nあちこちにこだわったんじゃ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "兜 大吾"
      },
      "performance": {
