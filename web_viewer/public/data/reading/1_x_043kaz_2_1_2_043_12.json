    {
      "kind": "synopsis",
      "source_text": "とある休日、涼と大吾に「一日付き合って\nほしい」と誘われた一希。どこへ行くのか\n知らされないまま、待ち合わせ場所に着くと\n涼と大吾から「一希さん限定のツアー」を\n開催すると伝えられるのだった。",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
