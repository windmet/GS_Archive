        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "気付いてもらえて嬉しいわ！\n自分でも気に入ったけぇ、\n大事にしまってるんじゃ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
