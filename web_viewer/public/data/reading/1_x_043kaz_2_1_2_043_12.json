        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…あの旅のしおりには、\n様々な小説のモチーフが、\n散りばめられていたな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
