        "step_id": 12,
        "step_index": 11,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…苦手なものは、無理しなくて\nいい。おれの為に挑戦してくれた\n気持ちが嬉しいよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "043kaz"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "043kaz",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 13
      },
      "diagnostics": [
