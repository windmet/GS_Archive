    {
      "kind": "dialogue",
      "source_text": "…この仕事はおれの趣味が生かせそうだな。\n●●●●プロデューサー、ありがとう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "九十九 一希"
      },
      "performance": {
