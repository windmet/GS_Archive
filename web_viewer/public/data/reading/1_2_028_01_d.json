    {
      "kind": "dialogue",
      "source_text": "そして、いつか荘一郎さんが世界一の洋菓子を\n作ったら、私にも食べさせてくださいね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
