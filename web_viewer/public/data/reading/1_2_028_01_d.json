      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 4
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "私には、たくさんの人々を\n笑顔にする力が身につくでしょう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その力は、夢を叶えるために\n必要な力だと思うんです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 6
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-6:text",
        "step_id": 6,
        "step_index": 5,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "世界一の洋菓子ともなれば、きっと、\n世界中の人々を笑顔にする力があるでしょうから。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……それにしても。両親に夢を認められず、\n実家から逃げ出した時は思い悩んでいましたが。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "神谷に……Cafe Paradeという居場所に夢を守られ。\n今では315プロで、さらに夢へ近づこうとしている。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "私が前へ進めたのは、あなたや\n仲間たちという大きな存在があったからですね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "028soi"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "028soi",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_2_028_01_d:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_2_028_01_d",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "荘一郎さんの夢のために、これからも、\n私に出来る事であれば何でもサポートします！",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "not-applicable",
        "reason": "non-idol-dialogue",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
