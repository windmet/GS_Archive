      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こうして洋菓子を研究しながら、\nあなたとアイドルとして成長していけば、",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
        "entityType": "idol",
