      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30005_01_a:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_3_30005_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "仕事はくれるし、お酒はご馳走してくれるし。\n太っ腹な担当者さんだよなぁ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "004ter"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "004ter",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30005_01_a:step-8:text",
        "step_id": 8,
        "step_index": 7,
        "source_part_id": "1_3_30005_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "クライアントからの厚意だ。\nたまにはこういう機会もいいだろう。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
      "performance": {
        "entityType": "idol",
