        "source_part_id": "1_3_30005_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい！　でも、ラッキーでしたよね。JIFで身体が\n温まっているうちに、また新しい仕事が決まって。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
