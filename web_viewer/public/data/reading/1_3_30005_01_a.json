        "source_part_id": "1_3_30005_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おまけに、打ち合わせ場所で\nそのまま飲むってのも新鮮だぜ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天道 輝"
      },
      "performance": {
        "entityType": "idol",
