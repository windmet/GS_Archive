    {
      "kind": "dialogue",
      "source_text": "英雄さん。今日はなんだかいつも以上に\nやる気に満ち溢れていますね！",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_014hid_1_5_014_01:1_5_014_01:cmd-000015:dialogue:000",
