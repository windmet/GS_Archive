    {
      "kind": "dialogue",
      "source_text": "緊張ともまた違うドキドキ……ワクワク？\nそれが心地良くもあるんだよな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
      "performance": {
