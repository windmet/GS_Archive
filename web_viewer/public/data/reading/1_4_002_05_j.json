    {
      "kind": "dialogue",
      "source_text": "見事、手紙に込められた想いに寄り添った、\n素晴らしいステージを披露してくれました！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "司会"
      },
      "performance": {
