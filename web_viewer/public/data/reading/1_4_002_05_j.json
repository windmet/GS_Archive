    {
      "kind": "dialogue",
      "source_text": "ワガハイたちの芸は、先人が切り拓いてくれた\n道があったからこそ、作られたものでにゃんす。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "猫柳 キリオ"
      },
