        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "受け継いできたものを、今のアタシたちが\n最高の形で届けられたのなら嬉しいわ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
      "performance": {
