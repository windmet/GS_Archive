    {
      "kind": "dialogue",
      "source_text": "オレの休場が発表されたら、病院の周りに\n記者が来るかも。だから、明日のお見舞いはなしな！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "蒼井 悠介"
