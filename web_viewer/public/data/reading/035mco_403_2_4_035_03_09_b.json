      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ダンスの合間に、一緒に踊ってくれている\n視聴者に向け、呼びかけをするのだと言っていた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
      "performance": {
        "entityType": "idol",
