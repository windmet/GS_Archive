    {
      "kind": "dialogue",
      "source_text": "しかし、橘君からは、学ぶことが多い。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "硲 道夫"
      },
