    {
      "kind": "dialogue",
      "source_text": "商業施設に、劇場、そしてマンション……\nこの企業が手掛けた建物を巡るのか。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000024:dialogue:000",
        "source": {
