    {
      "kind": "dialogue",
      "source_text": "これが今度のCM撮影の資料です。\nこの企業はマンション建設で有名ですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000016:dialogue:000",
        "source": {
