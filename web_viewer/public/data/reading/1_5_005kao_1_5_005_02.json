    {
      "kind": "dialogue",
      "source_text": "はい。「オフの日、あなたはどこに出かける」と\nいうテーマですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_005kao_1_5_005_02:1_5_005_02:cmd-000026:dialogue:000",
