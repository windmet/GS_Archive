    {
      "kind": "dialogue",
      "source_text": "商業施設に、劇場、そしてマンション……\nこの企業が手掛けた建物を巡るのか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫"
      },
