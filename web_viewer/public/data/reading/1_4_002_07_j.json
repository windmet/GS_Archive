  "rows": [
    {
      "kind": "caption",
      "source_text": "数日後……",
      "text_ref": null,
      "speaker": {
        "kind": "none",
        "entityType": null,
        "entityId": null,
        "sourceName": ""
      },
      "inline_translation": null,
