          "end_step_index": 46,
          "target_step_index": 1
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すごいね、麗さん。\nそんなにたくさんの紙束を持ち歩いていたの？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "圭（テレビの音声）"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "己が持つ、才に溺れず努力せし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（天然で強いのに、努力まで出来ちゃうんだから。\nAltessimoって、敵でも味方でも怖い存在だよねー）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 8
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おはようさん。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おはようございます、想楽。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-15:text",
        "step_id": 15,
        "step_index": 14,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 14
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "雨彦さん、クリスさん。おはよー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-18:text",
        "step_id": 18,
        "step_index": 17,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 17
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（そうだ。僕も二人の事をからかってみようかなー）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-20:text",
        "step_id": 20,
        "step_index": 19,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 19
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "わー、大変だー。●●●●プロデューサーさんの\n机の上に、大金が積まれてるー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-27:text",
        "step_id": 27,
        "step_index": 26,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 26
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よくないお金のにおいがするねー。\n二人とも、どうしようかー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-28:text",
        "step_id": 28,
        "step_index": 27,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 27
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ほう、事務所の裏金か何かか？\n騒ぎになる前に、俺たちでさっさと片づけておくか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-32:text",
        "step_id": 32,
        "step_index": 31,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 31
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "というわけで、北村。\nコンビニでバイク雑誌でも買ってきてくれ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-33:text",
        "step_id": 33,
        "step_index": 32,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 32
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "雨彦、そういったことはよくないのでは？　幸い、\n我々の事務所には元警察官の握野さんもいます。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-36:text",
        "step_id": 36,
        "step_index": 35,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 35
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もしプロデューサーさんが悪事を働いたなら、握野\nさんを通じて自首されるよう、お願いすべきです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "古論 クリス"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-37:text",
        "step_id": 37,
        "step_index": 36,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 36
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "…………。\nもっと素直に驚いたり、困ったりしてくれないー？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-40:text",
        "step_id": 40,
        "step_index": 39,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 39
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "（本当この事務所って、天然だったり\n面倒だったり。変わった人が多いよねー）",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-42:text",
        "step_id": 42,
        "step_index": 41,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 41
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "動かなくなったり、データが消えたりするんです。\nですから、大変なんです！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "麗（テレビの音声）"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_07_j:step-45:text",
        "step_id": 45,
        "step_index": 44,
        "source_part_id": "1_4_002_07_j",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_07_j.json",
          "start_step_index": 0,
          "end_step_index": 46,
          "target_step_index": 44
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……麗くんにも、\nこの時の苦労話を聞きたいなー。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "北村 想楽"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
