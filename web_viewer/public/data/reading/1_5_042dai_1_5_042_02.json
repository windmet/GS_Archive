        "command_start": 17,
        "command_end": 17
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "私も読ませてもらいましたが、コミカルな\n人情時代劇でおもしろそうな作品ですよね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000019:dialogue:000",
        "source": {
