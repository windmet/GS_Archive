        },
        "source_hash": "sha256:ad081d1871b8c3f90fd7059b21a594995a2bfcc14284bbd395604222f82d37b3"
      },
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
        "sourceName": "<P>"
