          "field_ordinal": 0
        },
        "source_hash": "sha256:899f31d3268b951d729d5069c5740a851493797b3ad46486b5e70eaeb8d7baed"
      },
      "speaker": {
        "kind": "idol",
        "entityType": "idol",
        "entityId": "042dai",
        "sourceName": "兜 大吾"
      },
      "performance": {
        "entityType": "idol",
