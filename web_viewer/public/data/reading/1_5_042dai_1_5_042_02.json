      },
      "visual": {
        "entityType": "idol",
        "entityId": "042dai",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 5
      },
      "diagnostics": [],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
