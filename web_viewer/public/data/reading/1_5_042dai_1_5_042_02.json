      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ワシの役は商人の息子で、\n登場人物をつなぐ大切な役じゃ。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_042dai_1_5_042_02:1_5_042_02:cmd-000031:dialogue:000",
        "source": {
