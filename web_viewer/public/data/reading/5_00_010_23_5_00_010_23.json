        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お招きいただきありがとうございます。\nどれもとても美味しそうですね。",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
