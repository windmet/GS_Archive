      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "さて早速だが、アイドルたちに\n新年の抱負を書いてもらおうと思う！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
