    {
      "kind": "dialogue",
      "source_text": "うむ、良い挨拶だ！　引き続き、その情熱を胸に、\nアイドルたちのプロデュースを頼んだぞ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
