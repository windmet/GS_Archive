      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "彼らとはなかなかじっくり話す機会がないからな。\n新年の抱負から熱いパッションを感じたい！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "齋藤社長"
