        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "新郎友人の渡辺みのりです。まずは、\n新郎新婦のお二人、ご結婚おめでとうございます。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
