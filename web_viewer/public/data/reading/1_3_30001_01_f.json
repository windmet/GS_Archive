        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "私と新郎は、10代の頃からの付き合いです。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 9
      },
      "diagnostics": [
        "compatibility-stage-evidence"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30001_01_f:step-9:text",
        "step_id": 9,
        "step_index": 8,
        "source_part_id": "1_3_30001_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "当時、まだまだ子供だった私たちには、\n仲間以外にわかり合える人なんていませんでした。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 10
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30001_01_f:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_3_30001_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でも、仲間がいてくれたから、楽しい事も辛い事も、\nがむしゃらに乗り越えることが出来ました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30001_01_f:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_3_30001_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "その後、新郎には生涯一緒にいたいと思える人との\n出会いがあり、家族ができて……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 12
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30001_01_f:step-12:text",
        "step_id": 12,
        "step_index": 11,
        "source_part_id": "1_3_30001_01_f",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "自分もまたアイドルになり、Beitという、\n家族のように大切な存在と出会えました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
