    {
      "kind": "dialogue",
      "source_text": "それでは、ご列席のお客様にスピーチを頂きます。\n新郎友人代表の渡辺様です、拍手でお迎えください！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "司会"
      },
      "performance": {
