    {
      "kind": "dialogue",
      "source_text": "なんだよ、それ……。あんたらのバンドが作った曲は\nすげーいいもんばっかなんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
