    {
      "kind": "dialogue",
      "source_text": "実は……最近、大手のレーベルに所属するバンドに\n圧力をかけられてね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "知り合いのバンドマン"
