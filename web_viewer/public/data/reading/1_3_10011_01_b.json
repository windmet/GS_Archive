      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "お久しぶりッス！　最後に会ったのは、\n俺たちが961プロダクションにいたころッスよね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "天ヶ瀬 冬馬"
