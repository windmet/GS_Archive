        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺たちのバンドがホームとして活動してる\nライブハウスが使えなくなったんだ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "知り合いのバンドマン"
      },
      "performance": {
