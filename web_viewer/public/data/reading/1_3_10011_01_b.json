        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もうそんな前になるのか。懐かしいなぁ。\n冬馬くんたちがアイドルを続けていて嬉しいよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "知り合いのバンドマン"
      },
      "performance": {
        "entityType": null,
        "entityId": null
      },
      "visual": {
        "entityType": null,
        "entityId": null,
        "presence": "unknown",
