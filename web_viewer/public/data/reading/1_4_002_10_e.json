      "kind": "dialogue",
      "source_text": "悪いが我々は、他のスタッフとは違って、\n315プロダクションが大嫌いだからな……！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "取り巻き2"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
