          "end_step_index": 35,
          "target_step_index": 2
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "こ、これは……！\nまさかこの場で、猫を持ち出すなんて！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "スタッフA"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_10_e:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_002_10_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_e.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "上からの指示に背くわけには……でも、猫はかわいい！\n猫の姿にリラックスして、本音がこぼれてしまう……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "スタッフB"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_10_e:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_002_10_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_e.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……俺たちも、本当は、\n共に男極を支えてくれた315プロを応援したいんだ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "元・男極スタッフA"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_10_e:step-10:text",
        "step_id": 10,
        "step_index": 9,
        "source_part_id": "1_4_002_10_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_e.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 9
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "腹をくくりました。\n皆さんを楽屋に案内します！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "元・男極スタッフB"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_002_10_e:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": "1_4_002_10_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_002_10_e.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 10
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "次々とスタッフを懐柔するとは、\n猫の力ってのは偉大だな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_002_10_e:step-14:text",
        "step_id": 14,
        "step_index": 13,
        "source_part_id": "1_4_002_10_e",
        "source_file": null,
        "command_start": null,
        "command_end": null,
