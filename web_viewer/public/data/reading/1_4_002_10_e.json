          "file": "episodes/1_4_002_10_e.json",
          "start_step_index": 0,
          "end_step_index": 35,
          "target_step_index": 13
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "楽屋は、あの角を曲がったところだね！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
