          "end_step_index": 35,
          "target_step_index": 22
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ちょっと待ったー！",
      "text_ref": null,
      "speaker": {
        "kind": "unknown",
        "entityType": null,
        "entityId": null,
        "sourceName": "？？？"
