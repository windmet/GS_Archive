      "kind": "dialogue",
      "source_text": "くっ……楽屋はすぐそこなのに。\n一体、どうしたら……。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
