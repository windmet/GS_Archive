      "kind": "dialogue",
      "source_text": "……俺たちの出番のようだな、硲サン。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "葛之葉 雨彦"
