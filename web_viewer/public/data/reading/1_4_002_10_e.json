        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "よくここまで辿りついたな、315プロダクション。\nだが、ここから先は絶対に通さない！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "取り巻き1"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
