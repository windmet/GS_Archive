  "rows": [
    {
      "kind": "dialogue",
      "source_text": "ほーら、かわいい猫の写真ですよ～。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "山下 次郎"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
