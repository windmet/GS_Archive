      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "これを見ている天道でも察しているだろう。\n僕たちはこれから天道の誕生日ケーキを作る。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "桜庭 薫（VTR）"
      },
      "performance": {
