      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "二人はそもそも、『アイドル』って\n一体なんなのか、わかるかな？",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
