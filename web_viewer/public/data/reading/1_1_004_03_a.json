        "step_index": 12,
        "source_part_id": "1_1_004_03_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "自分のスタイルを突き詰めるために、\nあえてメジャーにはいかないインディーズアイドル。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
