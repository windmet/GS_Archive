      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "例えば、地元を盛り上げようと、\n活動の本拠地を決めているローカルアイドル。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
