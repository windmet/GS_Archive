        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はーい！　アイドルは、キラキラ。\nテレビで、歌う、踊る！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "010pie"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "010pie",
        "presence": "visible",
