        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "自宅にいながらファンと交流する、\nネットアイドルなんていうのもあるね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
