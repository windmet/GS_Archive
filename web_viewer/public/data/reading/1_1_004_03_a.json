        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "……。正直、あんまりピンとこないっす。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "鷹城 恭二"
      },
      "performance": {
