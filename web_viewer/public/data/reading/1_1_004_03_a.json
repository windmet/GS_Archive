    {
      "kind": "dialogue",
      "source_text": "さて。アイドルには、どうすればなれるのか！\nっていう話だけど……その前に。",
      "text_ref": {
        "unit_id": "story-text:v1:1_1_004bei_03_1_1_004_03:1_1_004_03_a:cmd-000043:dialogue:000",
