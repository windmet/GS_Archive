          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 39
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "綺麗に飾られていたし、注目も集めていたぞ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽麗"
      },
