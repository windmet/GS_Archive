          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 37
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今日、CDショップに行ったのだが、\nそこでBeitの展示を見かけた。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_4_001_07_c:step-39:text",
        "step_id": 39,
        "step_index": 38,
        "source_part_id": "1_4_001_07_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_07_c.json",
          "start_step_index": 0,
          "end_step_index": 47,
          "target_step_index": 38
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "この間のブログに載っていたのは、\nあの店の写真だったんだな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
