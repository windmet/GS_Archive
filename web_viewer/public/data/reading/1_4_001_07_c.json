        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "もしもし。わたしだ、神楽だ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "神楽麗"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
