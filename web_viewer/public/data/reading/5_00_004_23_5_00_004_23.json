    {
      "kind": "dialogue",
      "source_text": "年始の挨拶が済んでから、俺の家で一緒にお雑煮を\n食べたんだ。福笑いもやったんだよ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "渡辺 みのり"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "011min"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "011min",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 11
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "5_00_004_23_5_00_004_23:step-11:text",
        "step_id": 11,
        "step_index": 10,
        "source_part_id": null,
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "おもち、美味しかった！\n恭二のおもち、こーんな伸びた！　面白かったよ！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "010pie"
