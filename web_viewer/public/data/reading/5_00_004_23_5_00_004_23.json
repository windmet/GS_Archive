    {
      "kind": "dialogue",
      "source_text": "うん！　商店街のみんな、挨拶した！\nスマイルいっぱい、楽しかった！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "ピエール"
      },
      "performance": {
