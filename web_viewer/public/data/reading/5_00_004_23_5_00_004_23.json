    {
      "kind": "dialogue",
      "source_text": "はい、よろしくお願いします！\n皆さん、お正月休みは楽しめましたか？",
      "text_ref": null,
      "speaker": {
        "kind": "producer",
        "entityType": null,
        "entityId": null,
