  "rows": [
    {
      "kind": "dialogue",
      "source_text": "今回のオファーが、あの伝説の総合格闘家\n雷皇からだったなんて、驚きッス。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
