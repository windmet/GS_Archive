        "step_index": 5,
        "source_part_id": "1_4_001_05_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_c.json",
          "start_step_index": 0,
          "end_step_index": 32,
          "target_step_index": 5
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "心苦しい限りだ。何らかの形で、\n今回の埋め合わせができればと思うのだが……",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "雷皇"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_05_c:step-7:text",
