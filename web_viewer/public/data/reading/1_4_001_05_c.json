          "start_step_index": 0,
          "end_step_index": 32,
          "target_step_index": 12
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "雷皇さん、スポンサーとして、\n自分たちをJIFに推薦してください！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "円城寺 道流"
      },
      "inline_translation": null,
      "has_voice": true,
