          "file": "episodes/1_4_001_05_c.json",
          "start_step_index": 0,
          "end_step_index": 32,
          "target_step_index": 6
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "なら、俺たちをJIFに推薦してくれ。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "大河 タケル"
      },
      "inline_translation": null,
