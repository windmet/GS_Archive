        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルはもちろん、\nプロデューサーちゃんも気を付けないと。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "華村 翔真"
      },
