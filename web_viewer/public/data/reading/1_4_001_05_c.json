          "end_step_index": 32,
          "target_step_index": 2
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "俺は今、格闘界を盛り上げるため\n様々な事業を運営している。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "雷皇"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_05_c:step-4:text",
        "step_id": 4,
        "step_index": 3,
        "source_part_id": "1_4_001_05_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_c.json",
          "start_step_index": 0,
          "end_step_index": 32,
          "target_step_index": 3
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "今日のイベントもその一環。そこに、\n元格闘家のアイドルなんてぴったりだと思ってな。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "雷皇"
      },
      "inline_translation": null,
      "has_voice": false,
      "anchor": {
        "row_id": "1_4_001_05_c:step-5:text",
        "step_id": 5,
        "step_index": 4,
        "source_part_id": "1_4_001_05_c",
        "source_file": null,
        "command_start": null,
        "command_end": null,
        "playback": {
          "file": "episodes/1_4_001_05_c.json",
          "start_step_index": 0,
          "end_step_index": 32,
          "target_step_index": 4
        }
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "でも、中止じゃねーか。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "牙崎 漣"
      },
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
