      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "すごいですね！\nこんなにたくさんの人たちが……！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
