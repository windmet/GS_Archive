        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "アイドルとしてもパティシエとしても、\nこんなに嬉しいことはありません。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
