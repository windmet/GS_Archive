      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "はい。これだけ多くの人が『Candy Pop Monster』を\n楽しみにしてくれていたということですね。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
