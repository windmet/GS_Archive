    {
      "kind": "dialogue",
      "source_text": "本日、私たち主演の映画『Monster of the Cake shop』\nが公開されました。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "東雲 荘一郎"
      },
      "performance": {
