        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "そして、公開記念のコラボケーキショップ……\n『Candy Pop Monster』も、今日から開店です！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "卯月 巻緒"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "030mak"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "030mak",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 7
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30013_01_a:step-7:text",
        "step_id": 7,
        "step_index": 6,
        "source_part_id": "1_3_30013_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "我が同胞団による、供物の数々……\n光の民たちよ、とくと堪能するがよい！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "アスラン=BBⅡ世"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "029ass"
      },
      "visual": {
        "entityType": "idol",
        "entityId": "029ass",
        "presence": "visible",
        "reason": "matching-visible-stage-actor",
        "source": "stage-snapshot",
        "snapshot": "entry",
        "stepId": 8
      },
      "diagnostics": [
        "compatibility-stage-evidence",
        "entry-settled-actor-difference"
      ],
      "inline_translation": null,
      "has_voice": true,
      "anchor": {
        "row_id": "1_3_30013_01_a:step-8:text",
