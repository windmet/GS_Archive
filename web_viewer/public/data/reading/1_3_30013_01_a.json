        "step_index": 7,
        "source_part_id": "1_3_30013_01_a",
        "source_file": null,
        "command_start": null,
        "command_end": null
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "みんな、来てくれてありがっとー☆\n順番に案内するから、慌てないでね～！",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "水嶋 咲"
      },
      "performance": {
        "entityType": "idol",
        "entityId": "031sak"
      },
      "visual": {
        "entityType": "idol",
