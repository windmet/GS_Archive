      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "いや、この役だけじゃねえ。俺がすること\n全部がみんなの記憶に残るようにしたい。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
