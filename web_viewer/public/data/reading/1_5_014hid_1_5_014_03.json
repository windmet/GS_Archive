    {
      "kind": "dialogue",
      "source_text": "俺が交通安全のPRキャラクターをやることで、\nみんなの交通意識が改善するなら嬉しいし。",
      "text_ref": null,
      "speaker": {
        "kind": "named",
        "entityType": null,
        "entityId": null,
        "sourceName": "握野 英雄"
      },
