    {
      "kind": "dialogue",
      "source_text": "麗さん、何を確認しているんですか？\nああ、今日レポートするメニューですね。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000017:dialogue:000",
        "source": {
