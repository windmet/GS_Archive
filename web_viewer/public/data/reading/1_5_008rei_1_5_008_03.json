        "command_start": 17,
        "command_end": 17
      },
      "option": null
    },
    {
      "kind": "dialogue",
      "source_text": "ああ、事前にどのような物を食べるのか確認して\nおこうと思ってな。",
      "text_ref": {
        "unit_id": "story-text:v1:1_5_008rei_1_5_008_03:1_5_008_03:cmd-000021:dialogue:000",
        "source": {
