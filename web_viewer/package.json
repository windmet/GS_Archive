{
  "name": "sidem-story-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "smoke": "vite build --configLoader native",
    "verify:archive-sources": "python ../data_pipeline/verify_archive_source_contract.py && node scripts/verify-archive-js-source-config.mjs",
    "report:archive-baseline": "node scripts/report-current-archive-baseline.mjs",
    "verify:archive-baseline": "node scripts/verify-current-archive-baseline.mjs",
    "verify:archive-baseline:source-only": "node scripts/verify-current-archive-baseline.mjs --source-only",
    "verify:authoritative-story-publications": "node scripts/verify-authoritative-story-publications.mjs",
    "verify:external-story-resources": "node scripts/verify-external-story-resources.mjs",
    "verify:external-story-resource-ui": "node scripts/verify-external-story-resource-ui.mjs",
    "generate:tracked-binary-inventory": "node scripts/generate-tracked-binary-inventory.mjs",
    "verify:tracked-binary-inventory": "node scripts/verify-tracked-binary-inventory.mjs",
    "generate:publication-manifest": "node scripts/generate-publication-manifest.mjs",
    "verify:publication-ledger": "node scripts/verify-publication-ledger.mjs",
    "chibi:scan": "node scripts/scan-live-chibi-compatibility.mjs",
    "audit:raw-character": "python ../data_pipeline/audit_raw_character_resources.py",
    "character:candidate": "python ../data_pipeline/extract_raw_character_image_candidate.py",
    "character:promotion-publish": "node scripts/publish-raw-character-image.mjs",
    "character:promotion-publish-batch": "node scripts/publish-raw-character-image-batch.mjs",
    "character:promotion-publish-group": "node scripts/publish-raw-character-image-group.mjs",
    "character:promotion-rollback": "node scripts/rollback-raw-character-image.mjs",
    "character:promotion-rollback-batch": "node scripts/rollback-raw-character-image-batch.mjs",
    "chibi:audio": "python scripts/prepare-live-chibi-audio.py",
    "verify:live-chibi-audio": "python scripts/verify-live-chibi-audio.py",
    "chibi:backmonitor": "python scripts/prepare-live-chibi-backmonitor.py",
    "chibi:image-layers": "python scripts/prepare-live-chibi-image-layers.py",
    "chibi:stage-backgrounds": "python scripts/prepare-live-chibi-stage-backgrounds.py",
    "chibi:object-layers": "python scripts/prepare-live-chibi-object-layers.py",
    "chibi:stage-effects": "python scripts/prepare-live-chibi-stage-effects.py",
    "audit:live-chibi-costume-boundary": "python scripts/audit-live-chibi-costume-boundary.py",
    "audit:live-chibi-semantic-sources": "python scripts/audit-live-chibi-semantic-sources.py",
    "manifest": "node scripts/generate-archive-manifest.mjs",
    "story:presentation": "node scripts/generate-story-presentation-index.mjs",
    "story:migration-candidate": "python scripts/compile-story-migration-candidate.py",
    "story:migration-publish": "python scripts/publish-story-migration-candidate.py",
    "story:authoritative-candidate": "node scripts/compile-authoritative-story-candidate.mjs",
    "story:authoritative-native": "python scripts/compile-story-migration-candidate.py --output-contract authoritative",
    "story:authoritative-collection": "node scripts/build-authoritative-story-collection.mjs",
    "story:authoritative-publish": "node scripts/publish-authoritative-story-collection.mjs",
    "story:authoritative-rollback": "node scripts/rollback-authoritative-story-collection.mjs",
    "story:raw-promotion-candidate": "node scripts/build-raw-story-promotion.mjs",
    "story:raw-promotion-publish": "node scripts/publish-raw-story-promotion.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "verify:event-story": "node scripts/verify-event-story-navigation.mjs",
    "verify:home": "node scripts/verify-archive-home.mjs",
    "verify:idol-communication": "node scripts/verify-idol-communication-index.mjs",
    "verify:idol-story-interface": "node scripts/verify-idol-story-interface.mjs",
    "verify:routes": "node scripts/verify-archive-routes.mjs",
    "verify:release-soak": "node scripts/verify-release-soak-recorder.mjs",
    "verify:seasonal": "node scripts/verify-seasonal-campaign-index.mjs",
    "verify:story-presentation": "node scripts/verify-story-presentation.mjs",
    "verify:story-collections": "node scripts/verify-story-collections.mjs",
    "verify:story-playback-range": "node scripts/verify-story-playback-range.mjs",
    "verify:story-audio": "node scripts/verify-story-audio-session.mjs",
    "verify:story-schema": "node scripts/verify-authoritative-story-schema.mjs && node scripts/verify-authoritative-runtime-shapes.mjs",
    "verify:story-runtime-shapes": "node scripts/verify-authoritative-runtime-shapes.mjs",
    "verify:story-authoritative-publish": "node scripts/verify-authoritative-story-publish.mjs",
    "verify:story-raw-promotion": "node scripts/verify-raw-story-promotion.mjs",
    "verify:story-localization": "node scripts/verify-story-localization-runtime.mjs && node scripts/verify-story-localization-stress.mjs && node scripts/verify-structured-bilingual-ui.mjs",
    "verify:story-translations": "node scripts/verify-story-translations.mjs && node scripts/report-story-translation-migration.mjs && node scripts/verify-entity-translations.mjs",
    "verify:story-text": "python scripts/verify-story-text-evidence.py",
    "verify:compiled-migration": "node scripts/verify-compiled-scenario-migration.mjs && python scripts/verify-story-migration-candidate.py && python scripts/verify-story-migration-publish.py",
    "verify:raw-character-candidate": "node scripts/verify-raw-character-image-candidate.mjs",
    "verify:raw-character-promotion": "node scripts/verify-raw-character-image-promotion.mjs",
    "verify:episode-artifacts": "node scripts/verify-episode-artifacts.mjs",
    "verify:voice-cues": "node scripts/verify-compiled-voice-cues.mjs",
    "verify:spine-blink": "node scripts/verify-spine-blink-cover.mjs && node scripts/verify-spine-blink-slots.mjs",
    "verify:spine-fade": "node scripts/verify-spine-atomic-fade.mjs",
    "verify:spine-motion": "node scripts/verify-spine-motion-state.mjs",
    "verify:silhouette": "node scripts/verify-silhouette-fallback-contract.mjs",
    "verify:work-story": "node scripts/verify-work-story-index.mjs",
    "preview": "vite preview --configLoader native",
    "start": "node server.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@pixi-spine/runtime-3.8": "^4.0.6",
    "pixi.js": "^7.4.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "vite": "^6.0.0"
  }
}
