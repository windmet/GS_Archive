[
  {
    "rid": "T000012",
    "document_id": "1_1_001_01_a",
    "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_a:cmd-000045:dialogue:000",
    "source_hash": "sha256:5173c13f51307490b1d935ad580a131f03b6757c887f3f191a59ff7609bd1f44",
    "source": "んなわけねーだろ。\n俺を誰だと思ってんだ？",
    "before": "怎么可能。\n你以为本大爷是谁啊？",
    "after": "怎么可能。\n你以为我是谁啊？",
    "reason": "Voice: 冬馬 says 俺; 本大爷 is reserved for オレ様"
  },
  {
    "rid": "T000036",
    "document_id": "1_1_001_01_c",
    "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_c:cmd-000061:dialogue:000",
    "source_hash": "sha256:a2030ff72614589c157e06989aa9be73041dcec23cdabbbce50f18ee4567484d",
    "source": "悪いけど、そういうの興味ねーんだ。\n今回参加したのも、ほとんどノリみたいなもんで……",
    "before": "不好意思，我对这种事没兴趣。\n这次会参加，也差不多只是顺水推舟而已……",
    "after": "不好意思，我对这种事没兴趣。\n这次会参加，也差不多只是一时兴起而已……",
    "reason": "ノリ: on a whim"
  },
  {
    "rid": "T000047",
    "document_id": "1_1_001_01_d",
    "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_d:cmd-000073:dialogue:000",
    "source_hash": "sha256:b969cc2748df2d70cd53225e02ef0aa9de69ad895336dff0bd9657604ba2e2ab",
    "source": "よろしい！　明日、このメモに書かれている\nスタジオに来たまえ……それでは、アデュー！",
    "before": "很好！明天，到这张便条上写着的\n演播室来吧……那么，再会（Adieu）！",
    "after": "很好！明天，到这张便条上写着的\n演播室来吧……那么，Adieu！",
    "reason": "No translator gloss in dialogue"
  },
  {
    "rid": "T000069",
    "document_id": "1_1_001_01_g",
    "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_g:cmd-000026:dialogue:000",
    "source_hash": "sha256:4777a15814acd27ca6b17a06ecac769204bdace058117b09b2590b04fe0d4fe4",
    "source": "ふーん。じゃあ歌、上手なんだ？",
    "before": "哼——。那么说来，你唱歌很厉害咯？",
    "after": "嗯——。那么说来，你唱歌很厉害咯？",
    "reason": "ふーん is not contempt"
  },
  {
    "rid": "T000312",
    "document_id": "1_1_001_03_g",
    "unit_id": "story-text:v1:1_1_001jup_03_1_1_001_03:1_1_001_03_g:cmd-000159:dialogue:000",
    "source_hash": "sha256:b705242da4423b1f5150c342941ff731e96c9b6811598b0cc263ffc413e0d293",
    "source": "ふーん……。",
    "before": "哼——……",
    "after": "嗯——……",
    "reason": "ふーん is not contempt"
  },
  {
    "rid": "T000090",
    "document_id": "1_1_001_01_h",
    "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_h:cmd-000136:dialogue:000",
    "source_hash": "sha256:91f265742fe78bba46e7a6619d348c9a540a88d842a80eb5fe44d8248e42fb24",
    "source": "はいはーい、僕の番だね。\n……まあ、見ててよ♪",
    "before": "好——的，轮到我了呢。\n……哼哼，看好了哦♪",
    "after": "好——的，轮到我了呢。\n……嘛，看好了哦♪",
    "reason": "Source: まあ; 哼哼 added"
  },
  {
    "rid": "T000103",
    "document_id": "1_1_001_01_j",
    "unit_id": "story-text:v1:1_1_001jup_01_1_1_001_01:1_1_001_01_j:cmd-000055:dialogue:000",
    "source_hash": "sha256:6d5262ff55567b3eae7a90e981be34dcc6916c9e619a4aee76f65569079e3b16",
    "source": "うわー、北斗君がウィンクしただけで、\nスタッフさんがざわついてる。",
    "before": "哇——，北斗君只是眨了个眼，\n工作人员们就骚动起来了。",
    "after": "哇——，北斗君只是抛了个媚眼，\n工作人员们就骚动起来了。",
    "reason": "ウィンク"
  },
  {
    "rid": "T000193",
    "document_id": "1_1_001_02_f",
    "unit_id": "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_f:cmd-000102:dialogue:000",
    "source_hash": "sha256:24dbeb974d2afa08f2c150231af251379b5c208ddcfb62af19ddb8b7a79ecac3",
    "source": "シャキッとしろよ、翔太！　北斗もチャラチャラ\nしてねーで、今日の仕事の確認するぞ。",
    "before": "给我振作点啊，翔太！北斗你也别在那轻佻地搭讪，\n赶紧确认今天的工作了。",
    "after": "给我振作点啊，翔太！北斗你也别吊儿郎当的，\n赶紧确认今天的工作了。",
    "reason": "チャラチャラ; 搭讪 added"
  },
  {
    "rid": "T000224",
    "document_id": "1_1_001_02_i",
    "unit_id": "story-text:v1:1_1_001jup_02_1_1_001_02:1_1_001_02_i:cmd-000061:dialogue:000",
    "source_hash": "sha256:a56de6ba849e03c77a8bf73f621e7eee5a5cc2e67cbe0a5f99381718d810c141",
    "source": "すごく話題になってるんだって、実感してるよ。",
    "before": "我切身体会到了引起了极大的反响呢。",
    "after": "我切身感受到大家都在热议我们呢。",
    "reason": "Wording"
  },
  {
    "rid": "T000287",
    "document_id": "1_1_001_03_e",
    "unit_id": "story-text:v1:1_1_001jup_03_1_1_001_03:1_1_001_03_e:cmd-000114:dialogue:000",
    "source_hash": "sha256:2506b6962303fa59460b0b8b77938a23f3c71c44c6bf50adbe90641af82114a8",
    "source": "（自分のプライベートな時間まで注いでいるのか。\n……アイドルなんて、子供の遊びに）",
    "before": "（连自己的私人时间都倾注进去了吗。\n……偶像这种东西，不过是小孩子的游戏罢了）",
    "after": "（连自己的私人时间都倾注进去了吗。\n……为了偶像这种小孩子的游戏）",
    "reason": "Unfinished source line stays unfinished"
  },
  {
    "rid": "T000300",
    "document_id": "1_1_001_03_g",
    "unit_id": "story-text:v1:1_1_001jup_03_1_1_001_03:1_1_001_03_g:cmd-000044:dialogue:000",
    "source_hash": "sha256:264c44d9d72e96ec764107fc85a857bd903501490c294c11c6265fa2b8093517",
    "source": "チャオ☆　遅かったね、冬馬。\n一番乗りは俺がもらっておいたよ。",
    "before": "嗨☆冬马，你太慢了哦。\n头筹就由我收下了。",
    "after": "Ciao☆冬马，你太慢了哦。\n头筹就由我收下了。",
    "reason": "北斗 signature チャオ"
  },
  {
    "rid": "T000304",
    "document_id": "1_1_001_03_g",
    "unit_id": "story-text:v1:1_1_001jup_03_1_1_001_03:1_1_001_03_g:cmd-000075:dialogue:000",
    "source_hash": "sha256:23983026e08a2e2eb62194cd7a5d3f34c57703f39d69ecdf4aef952a43599f08",
    "source": "冬馬の驚く顔が見られたから、\n俺の予想は大当たり☆　だね。",
    "before": "既然看到了冬马惊讶的表情，\n看来我的预感大获全胜☆了呢。",
    "after": "既然看到了冬马惊讶的表情，\n看来我的预感完全命中☆了呢。",
    "reason": "大当たり: guessed right"
  },
  {
    "rid": "T000400",
    "document_id": "1_1_002_01_e",
    "unit_id": "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_e:cmd-000050:dialogue:000",
    "source_hash": "sha256:5c43a5f1731f955036e5443b7b432856b2c74ba9bbbcf74a2d53452e2c6653b0",
    "source": "はい……ご、合格！？\n本当ですか、ありがとうございます！",
    "before": "是的……通、合格了！？\n真的吗，非常感谢！",
    "after": "是的……合、合格了！？\n真的吗，非常感谢！",
    "reason": "Stutter repeats the real first syllable"
  },
  {
    "rid": "T000437",
    "document_id": "1_1_002_01_i",
    "unit_id": "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_i:cmd-000019:dialogue:000",
    "source_hash": "sha256:c601caec7c826976b7704f02fc11eef79ffb9e48ffa478b70526e2af5a6ee410",
    "source": "誰かを笑顔にしたいって気持ちは変わらないんだ。\nきっと、これからもずっとな。",
    "before": "但想让大家展露笑容的心情是没有变的。\n想必今后也一直都不会变。",
    "after": "但想让别人展露笑容的心情是没有变的。\n想必今后也一直都不会变。",
    "reason": "誰か: someone"
  },
  {
    "rid": "T000439",
    "document_id": "1_1_002_01_i",
    "unit_id": "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_i:cmd-000029:dialogue:000",
    "source_hash": "sha256:78248f6491e25ee4dafb560e4cdd95be90b576c195c6a1fecc9ab2fdcc39c5c3",
    "source": "って……威勢だけになったらカッコ悪いよな。\nへへっ、明日からも頑張らないと！",
    "before": "哎呀……光长威风可就太逊了。\n嘿嘿，明天开始也得继续加油才行！",
    "after": "哎呀……光有气势可就太逊了。\n嘿嘿，明天开始也得继续加油才行！",
    "reason": "Wording"
  },
  {
    "rid": "T000454",
    "document_id": "1_1_002_01_j",
    "unit_id": "story-text:v1:1_1_002dra_01_1_1_002_01:1_1_002_01_j:cmd-000044:dialogue:000",
    "source_hash": "sha256:d4e047159adb4a8a05729c732e875602a5925fb295123b60e9792f56e1d23afd",
    "source": "一番星を……。\n……すぅ。……すぅ。",
    "before": "成为启明星……\n……呼。……呼。",
    "after": "那颗最先亮起的星……\n……呼。……呼。",
    "reason": "一番星 is the first evening star; 成为 added"
  },
  {
    "rid": "T000476",
    "document_id": "1_1_002_02_b",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_b:cmd-000087:dialogue:000",
    "source_hash": "sha256:81a71523c10f893ea8d4895f5c0a6259818fa4174b86956fe981632573a51984",
    "source": "……ザー……ダーは見ていなかったのか！",
    "before": "……沙……雷达没在看吗！",
    "after": "……沙沙……达都没看吗！",
    "reason": "Radio static cuts レーダー"
  },
  {
    "rid": "T000544",
    "document_id": "1_1_002_02_i",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_i:cmd-000034:dialogue:000",
    "source_hash": "sha256:201138b170f20c6ab015ed4d681f6d0775b092411ad6917f9dd4cc04df45de4d",
    "source": "ウェザーレーダーは見ていなかったのか！",
    "before": "气象雷达没在看吗！",
    "after": "没看气象雷达吗！",
    "reason": "Wording"
  },
  {
    "rid": "T000477",
    "document_id": "1_1_002_02_b",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_b:cmd-000090:dialogue:000",
    "source_hash": "sha256:2535c8ef7477e4521c89d59b40cd8606ed961769e568fa5106a5561765756e5b",
    "source": "……何してる！！　そこを代われ！！",
    "before": "……在干什么！！换人！！",
    "after": "……你在干什么！！换我来！！",
    "reason": "Captain takes over the controls"
  },
  {
    "rid": "T000545",
    "document_id": "1_1_002_02_i",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_i:cmd-000035:dialogue:000",
    "source_hash": "sha256:9552dc1ee0117daeac09e1fc5e634a15badb0370adaa0c0664e0edaca0d1ca9f",
    "source": "何してる！！　そこを代われ！！",
    "before": "在干什么！！换人！！",
    "after": "你在干什么！！换我来！！",
    "reason": "Captain takes over the controls"
  },
  {
    "rid": "T000491",
    "document_id": "1_1_002_02_d",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_d:cmd-000041:dialogue:000",
    "source_hash": "sha256:27800f670348ae4a49ba97eb2a4241a56c1eeb38c0ee1a508c1a2fb1a10b2b66",
    "source": "あ、店員さん。\nすみません、追加でナポリタンもお願いします。",
    "before": "啊，请问。\n不好意思，麻烦再加一份意式那不勒斯面。",
    "after": "啊，服务员。\n不好意思，麻烦再加一份意式那不勒斯面。",
    "reason": "店員さん dropped"
  },
  {
    "rid": "T000491",
    "document_id": "1_1_002_02_d",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_d:cmd-000041:dialogue:000",
    "source_hash": "sha256:27800f670348ae4a49ba97eb2a4241a56c1eeb38c0ee1a508c1a2fb1a10b2b66",
    "source": "あ、店員さん。\nすみません、追加でナポリタンもお願いします。",
    "before": "啊，服务员。\n不好意思，麻烦再加一份意式那不勒斯面。",
    "after": "啊，服务员。\n不好意思，麻烦再加一份拿坡里意面。",
    "reason": "ナポリタン, one name"
  },
  {
    "rid": "T000492",
    "document_id": "1_1_002_02_d",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_d:cmd-000047:dialogue:000",
    "source_hash": "sha256:5025b9cf7d0c35cc92258954c68a6ce9ee6ba1783c3232c46f2808b16a1dca9d",
    "source": "（……えっ！　更にナポリタンまで！？）",
    "before": "（……诶！居然还要再加一份那不勒斯面！？）",
    "after": "（……诶！居然还要再加一份拿坡里意面！？）",
    "reason": "ナポリタン, one name"
  },
  {
    "rid": "T000503",
    "document_id": "1_1_002_02_e",
    "unit_id": "story-text:v1:1_1_002dra_02_1_1_002_02:1_1_002_02_e:cmd-000031:dialogue:000",
    "source_hash": "sha256:d2cbaca1a845d14071f2e04e9cf5091472507b8246d05040d55fc10c7fe5114b",
    "source": "アイドルの、プロデューサーさん……。\nあ、オレは柏木翼です。よろしくお願いします。",
    "before": "偶像的，制作人先生……\n啊，我是柏木翼。请多关照。",
    "after": "偶像的，制作人……\n啊，我是柏木翼。请多关照。",
    "reason": "プロデューサーさん → 制作人 as in reviewed B001"
  },
  {
    "rid": "T000583",
    "document_id": "1_1_002_03_a",
    "unit_id": "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_a:cmd-000151:dialogue:000",
    "source_hash": "sha256:f7a811c2b160fc8803dc70f3a1a4ef076468992b9985edb7284aabe6d8533195",
    "source": "よかったぁ……。\nこちらこそ、よろしくお願いします！",
    "before": "太好了……\n我们这边才是，请多关照！",
    "after": "太好了……\n我才要请您多关照！",
    "reason": "翼 speaks for himself"
  },
  {
    "rid": "T000598",
    "document_id": "1_1_002_03_c",
    "unit_id": "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_c:cmd-000027:dialogue:000",
    "source_hash": "sha256:d1e224636d53220184d2374419d553db3daa7aa71dfa25a9ae48f23d2944e61c",
    "source": "さっき志望動機を聞かれた時も、\n「金を稼ぐため、以上」ってツンケンしてたし。",
    "before": "刚才被问到应聘动机时也是，\n冷冰冰地回了句“为了挣钱，没了”。",
    "after": "刚才被问到应聘动机时也是，\n冷冰冰地回了句“为了挣钱，就这样”。",
    "reason": "以上"
  },
  {
    "rid": "T000605",
    "document_id": "1_1_002_03_c",
    "unit_id": "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_c:cmd-000091:dialogue:000",
    "source_hash": "sha256:7e45ee77bac10e58266d2289d4396e524235de0cdc17d5240f9e509699b88e96",
    "source": "トップに立つ覚悟がないなら、出て行ったらどうだ。",
    "before": "没有站在顶峰的觉悟的话，不如滚出去如何。",
    "after": "没有站在顶峰的觉悟的话，那就出去如何。",
    "reason": "Register: 出て行ったらどうだ"
  },
  {
    "rid": "T000690",
    "document_id": "1_1_002_03_j",
    "unit_id": "story-text:v1:1_1_002dra_03_1_1_002_03:1_1_002_03_j:cmd-000033:dialogue:000",
    "source_hash": "sha256:a39b77040549e124ba50242e10b835fc4f5fce0e5fd6fab9681cfd9d86f1d595",
    "source": "そうでしたか。\n早とちりしてしまったようで、すみません。",
    "before": "这样啊。\n看来是我自作主张了，不好意思。",
    "after": "这样啊。\n看来是我想多了，不好意思。",
    "reason": "早とちり"
  },
  {
    "rid": "T000728",
    "document_id": "1_1_003_01_c",
    "unit_id": "story-text:v1:1_1_003alt_01_1_1_003_01:1_1_003_01_c:cmd-000034:dialogue:000",
    "source_hash": "sha256:482d87133e913c66233cfb5c28f2e40dc7eab1b3588a6bf4f20a1ce7eb250879",
    "source": "（どうしても、演奏中に余計なことを考えてしまう。\nわたしの音に、雑音が混じってしまう）",
    "before": "（不知为何，在演奏中总会胡思乱想。\n我的音乐中，混入了杂音）",
    "after": "（演奏时总是忍不住去想多余的事。\n我的音乐中，混入了杂音）",
    "reason": "どうしても ≠ 不知为何"
  },
  {
    "rid": "T000732",
    "document_id": "1_1_003_01_c",
    "unit_id": "story-text:v1:1_1_003alt_01_1_1_003_01:1_1_003_01_c:cmd-000057:dialogue:000",
    "source_hash": "sha256:fa58af4f0361da4ef749bac0a00d6a1b0f2295a1d5c686590a1d817bd54d2cdc",
    "source": "ザワザワ……",
    "before": "（窃窃私语……）",
    "after": "窸窸窣窣……",
    "reason": "Crowd noise, not inner thought"
  },
  {
    "rid": "T000734",
    "document_id": "1_1_003_01_c",
