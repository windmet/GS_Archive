[
  {
    "rid": "T000110",
    "document_id": "5_01_032_22_b",
    "unit_id": "story-text:v1:5_01_032_22:5_01_032_22_b:cmd-000039:choice_short:000",
    "source_hash": "sha256:d61ef14d33c2180041359a378773a623442fbdf296d30b3d56db9d39053022cc",
    "source": "気に入ってもらえて嬉しいです！",
    "before": "你能喜欢我就很高兴了！",
    "after": "你能喜欢，我很高兴！",
    "reason": "补逗号，避免把“喜欢礼物”误读为“喜欢我”。"
  },
  {
    "rid": "T000221",
    "document_id": "5_01_040_22_a",
    "unit_id": "story-text:v1:5_01_040_22:5_01_040_22_a:cmd-000030:dialogue:000",
    "source_hash": "sha256:37061f3b9a631185567a07a926dfb6f44269acb5093d98b6676368511d2be073",
    "source": "あァ？　たったこれっぽっちしか用意してねぇとか、\nマジで言ってんのかよ。",
    "before": "啊啊？只准备了这么一点点，\n你小子是认真的吗。",
    "after": "啊啊？只准备了这么一点点，\n你是认真的吗？",
    "reason": "原文没有“小子”，不为制作人添加性别化称呼。"
  },
  {
    "rid": "T000224",
    "document_id": "5_01_040_22_a",
    "unit_id": "story-text:v1:5_01_040_22:5_01_040_22_a:cmd-000046:dialogue:000",
    "source_hash": "sha256:6f2a95556e0cb150758d22a505f8a46072e45c38908b100058750a5ee73c9459",
    "source": "遅れたらショーチしねえぞ！\nくはは！",
    "before": "敢迟到的话本大爷可饶不了你！\n库哈哈！",
    "after": "敢迟到的话可饶不了你！\n库哈哈！",
    "reason": "原文没有オレ様，不为句子添加角色自称。"
  },
  {
    "rid": "T000226",
    "document_id": "5_01_040_22_b",
    "unit_id": "story-text:v1:5_01_040_22:5_01_040_22_b:cmd-000019:dialogue:000",
    "source_hash": "sha256:0e56a803c8b606f8d850632e4e7a01d75e331c2bcfb9de04897e77394be245aa",
    "source": "オマエがどーしてもってんなら、もらってやる。\n感謝しやがれ！",
    "before": "既然你小子无论如何都要求着给我，本大爷就收下了。\n好好感恩戴德吧！",
    "after": "既然你非要给，那我就收下了。\n好好感恩戴德吧！",
    "reason": "去掉原文没有的“小子”、求着给与本大爷，保留傲慢语气。"
  },
  {
    "rid": "T000231",
    "document_id": "5_01_040_22_b",
    "unit_id": "story-text:v1:5_01_040_22:5_01_040_22_b:cmd-000051:dialogue:000",
    "source_hash": "sha256:789b52bea137791edc64279165ed0a69f161d5439604e3e312805cac97c96384",
    "source": "わけわかんねーこと言ってねぇで、\nもっとチョコよこしやがれ！",
    "before": "少在那说些听不懂的蠢话，\n赶紧再多给本大爷拿点巧克力过来！",
    "after": "少在那儿说些莫名其妙的话，\n再多拿点巧克力过来！",
    "reason": "保留粗鲁命令，不另加本大爷自称和“蠢”字辱骂。"
  },
  {
    "rid": "T000233",
    "document_id": "5_01_040_22_b",
    "unit_id": "story-text:v1:5_01_040_22:5_01_040_22_b:cmd-000063:dialogue:000",
    "source_hash": "sha256:4a366695a518573ad8b5192331cdc95521220a45eba5989d843dacd32c57fcd2",
    "source": "あァ？　これしか用意してねえのかよ。",
    "before": "啊啊？你小子就准备了这么点吗。",
    "after": "啊啊？你就准备了这么点吗。",
    "reason": "去掉原文没有的“小子”。"
  },
  {
    "rid": "T000336",
    "document_id": "5_01_047_22_b",
    "unit_id": "story-text:v1:5_01_047_22:5_01_047_22_b:cmd-000033:choice_short:000",
    "source_hash": "sha256:8f2663fba3ad6ac75c31bba378b28235d6213740b265f4eccb1243606be517c5",
    "source": "喜んでもらえて嬉しいです！",
    "before": "你能喜欢我就很高兴了！",
    "after": "你能开心，我也很高兴！",
    "reason": "还原喜ぶ的情绪含义，并避免“喜欢我”的歧义。"
  }
]
