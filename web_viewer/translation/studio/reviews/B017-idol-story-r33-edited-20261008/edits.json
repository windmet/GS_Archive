[
  {
    "rid": "T000008",
    "document_id": "1_2_046_02_e",
    "unit_id": "story-text:v1:1_2_046chr_02_1_2_046_02:1_2_046_02_e:cmd-000106:dialogue:000",
    "source_hash": "sha256:e25c8ab6fd7ceccb7e0382658a5e08c44b6d91a1a7744ca0ed211d12ce69ee2d",
    "source": "喜んでもらえて、僕たちも嬉しいよー。\nプロデューサーさん、あれ渡してもらえる？",
    "before": "你能开心，我们也觉得很高兴哦～\n制作人先生，能把那个交给他吗？",
    "after": "你能开心，我们也觉得很高兴哦～\n制作人，能把那个交给他吗？",
    "reason": "プロデューサーさん → 制作人"
  },
  {
    "rid": "T000165",
    "document_id": "1_2_047_02_e",
    "unit_id": "story-text:v1:1_2_047shu_02_1_2_047_02:1_2_047_02_e:cmd-000185:dialogue:000",
    "source_hash": "sha256:633a896f62cf07ae6a8ecbd880cda6ecfd1619f65840e72a01c137f599933baa",
    "source": "「新着・更新はありません」",
    "before": "“没有新通知・更新”",
    "after": "“暂无新消息、更新”",
    "reason": "日文中点"
  },
  {
    "rid": "T000330",
    "document_id": "1_x_025suz_2_1_2_025_12",
    "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000021:dialogue:000",
    "source_hash": "sha256:bbb7fcca47603b3ca0c942214c14c89eaa172731a1506f92525c5cb1186374aa",
    "source": "英雄アニさんのおかげで、\n満足のいくパンケーキも\n作れるようになった。",
    "before": "多亏了英雄大哥，\n我总算能做出\n让人满意的薄烤饼了。",
    "after": "多亏了英雄大哥，\n我总算能做出\n让人满意的松饼了。",
    "reason": "パンケーキ统一为松饼"
  },
  {
    "rid": "T000331",
    "document_id": "1_x_025suz_2_1_2_025_12",
    "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000026:dialogue:000",
    "source_hash": "sha256:5b4bd374ebf4214ff4fab0f6137e39c8667a8ece6dea5e0ccc0c2a17f9c6e94a",
    "source": "画竜点睛。\nあとは朱雀が来たら\n出来立てを振舞うだけだ。",
    "before": "画龙点睛。\n剩下就等朱雀过来，\n端出刚出炉的热饼招待他就行了。",
    "after": "画龙点睛。\n剩下就等朱雀过来，\n端出刚出炉的松饼招待他就行了。",
    "reason": "パンケーキ统一为松饼"
  },
  {
    "rid": "T000334",
    "document_id": "1_x_025suz_2_1_2_025_12",
    "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000053:dialogue:000",
    "source_hash": "sha256:5a20efb6337b035583f907a41bd084ad3803c11d04f272db7f72ade9ea99be73",
    "source": "今日のために、パンケーキを作る\n練習をずっとしてたなんてよぉ。\n大変だったんじゃねぇか？",
    "before": "为了今天，你居然一直都在\n练习做薄烤饼啊。\n这也太不容易了吧？",
    "after": "为了今天，你居然一直都在\n练习做松饼啊。\n这也太不容易了吧？",
    "reason": "パンケーキ统一为松饼"
  },
  {
    "rid": "T000335",
    "document_id": "1_x_025suz_2_1_2_025_12",
    "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000062:dialogue:000",
    "source_hash": "sha256:e524b7bd9b1d95e55cdb71cabbfe856ce94d056cf43a0d0418682dcd9b43d398",
    "source": "理想のパンケーキを作るまでに、\nいろんなレシピを試したぜ。\n例えば豆腐を入れたり……。",
    "before": "在做出理想的薄烤饼之前，\n我试过各种食谱呢。\n比如加点豆腐之类的……",
    "after": "在做出理想的松饼之前，\n我试过各种食谱呢。\n比如加点豆腐之类的……",
    "reason": "パンケーキ统一为松饼"
  },
  {
    "rid": "T000336",
    "document_id": "1_x_025suz_2_1_2_025_12",
    "unit_id": "story-text:v1:1_x_025suz_2_1_2_025_12:1_2_025_12:cmd-000071:dialogue:000",
    "source_hash": "sha256:3f0e3a244f4481713f88aff329f32a6e4c069fb02c8d239b372aa9f3018def47",
    "source": "豆腐！？　パンケーキにか？\nぜんぜん想像がつかねぇぜ、\nどんな味になるんだ……！？",
    "before": "豆腐！？加进薄烤饼里吗？\n完全想象不出来啊，\n到底会是什么味道……！？",
    "after": "豆腐！？加进松饼里吗？\n完全想象不出来啊，\n到底会是什么味道……！？",
    "reason": "パンケーキ统一为松饼"
  }
]
