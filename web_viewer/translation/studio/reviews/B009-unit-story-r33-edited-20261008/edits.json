[
  {
    "rid": "T000006",
    "document_id": "1_1_011_01_i",
    "unit_id": "story-text:v1:1_1_011mof_01_1_1_011_01:1_1_011_01_i:cmd-000038:dialogue:000",
    "source_hash": "sha256:a6f1d40476e3d6b2c8611fb7b8ca34f849adcfd14e7255063e7a3c0593c22ce6",
