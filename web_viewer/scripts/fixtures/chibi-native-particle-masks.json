  "nativePrograms": {
    "add": {
      "shaderSha256": "9fe2a37916c472b9642942abc2bcc84e260b3e7c8081233dc3533fd49344f0a8",
      "fragmentTail": "\nvec4 u_xlat0;\nmediump vec4 u_xlat16_0;\nvec2 u_xlat1;\nmediump vec4 u_xlat16_1;\nbvec3 u_xlatb1;\nmediump float u_xlat16_2;\nvec2 u_xlat3;\nfloat u_xlat9;\nfloat u_xlat13;\nvoid main()\n{\n    u_xlat16_0 = vs_COLOR0 + vs_COLOR0;\n    u_xlat16_0 = u_xlat16_0 * _TintColor;\n    u_xlat16_1 = texture2D(_MainTex, vs_TEXCOORD0.xy);\n    u_xlat0 = u_xlat16_0 * u_xlat16_1;\n    u_xlat16_2 = u_xlat0.w;\n#ifdef UNITY_ADRENO_ES3\n    u_xlat16_2 = min(max(u_xlat16_2, 0.0), 1.0);\n#else\n    u_xlat16_2 = clamp(u_xlat16_2, 0.0, 1.0);\n#endif\n#ifdef UNITY_ADRENO_ES3\n    u_xlatb1.x = !!(0.0<_Enabled);\n#else\n    u_xlatb1.x = 0.0<_Enabled;\n#endif\n    if(u_xlatb1.x){\n        u_xlatb1.xyz = notEqual(vec4(0.0, 0.0, 0.0, 0.0), vec4(_ClampHoriz, _ClampVert, _UseAlphaChannel, _ClampHoriz)).xyz;\n        u_xlat13 = (-_ClampBorder) + 1.0;\n        u_xlat3.xy = max(vs_TEXCOORD2.xy, vec2(_ClampBorder));\n        u_xlat3.xy = min(vec2(u_xlat13), u_xlat3.xy);\n        u_xlat1.x = (u_xlatb1.x) ? u_xlat3.x : vs_TEXCOORD2.x;\n        u_xlat1.y = (u_xlatb1.y) ? u_xlat3.y : vs_TEXCOORD2.y;\n        if(u_xlatb1.z){\n            u_xlat9 = texture2D(_AlphaTex, u_xlat1.xy).w;\n        } else {\n            u_xlat9 = texture2D(_AlphaTex, u_xlat1.xy).x;\n        }\n    } else {\n        u_xlat9 = 1.0;\n    }\n    u_xlat0.w = u_xlat9 * u_xlat16_2;\n    gl_FragColor = u_xlat0;\n    return;\n}"
    },
    "normal": {
      "shaderSha256": "4f4d3e70877cbd2ab6c6234e9f68ad6cd90ffe5e25c9a7965d22eccbc68aad75",
      "fragmentTail": "\nvec4 u_xlat0;\nmediump vec4 u_xlat16_0;\nvec2 u_xlat1;\nbvec3 u_xlatb1;\nvec2 u_xlat2;\nfloat u_xlat7;\nfloat u_xlat10;\nvoid main()\n{\n    u_xlat16_0 = texture2D(_MainTex, vs_TEXCOORD1.xy);\n    u_xlat0 = u_xlat16_0 * vs_COLOR0;\n#ifdef UNITY_ADRENO_ES3\n    u_xlatb1.x = !!(0.0<_Enabled);\n#else\n    u_xlatb1.x = 0.0<_Enabled;\n#endif\n    if(u_xlatb1.x){\n        u_xlatb1.xyz = notEqual(vec4(0.0, 0.0, 0.0, 0.0), vec4(_ClampHoriz, _ClampVert, _UseAlphaChannel, _ClampHoriz)).xyz;\n        u_xlat10 = (-_ClampBorder) + 1.0;\n        u_xlat2.xy = max(vs_TEXCOORD2.xy, vec2(_ClampBorder));\n        u_xlat2.xy = min(vec2(u_xlat10), u_xlat2.xy);\n        u_xlat1.x = (u_xlatb1.x) ? u_xlat2.x : vs_TEXCOORD2.x;\n        u_xlat1.y = (u_xlatb1.y) ? u_xlat2.y : vs_TEXCOORD2.y;\n        if(u_xlatb1.z){\n            u_xlat7 = texture2D(_AlphaTex, u_xlat1.xy).w;\n        } else {\n            u_xlat7 = texture2D(_AlphaTex, u_xlat1.xy).x;\n        }\n    } else {\n        u_xlat7 = 1.0;\n    }\n    u_xlat0.w = u_xlat0.w * u_xlat7;\n    gl_FragColor = u_xlat0;\n    return;\n}"
    }
